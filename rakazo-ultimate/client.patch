+import { describe, expect, it } from "vitest";
+import { splitFileName } from "./file-name";
+
+describe("splitFileName", () => {
+  it("lifts the extension out of the name, uppercased, as the card shows the format", () => {
+    expect(splitFileName("Minis-体验升级方案.md")).toEqual({
+      title: "Minis-体验升级方案",
+      extension: "MD",
+    });
+    expect(splitFileName("刚被活挖神骨_全本200章.zip")).toEqual({
+      title: "刚被活挖神骨_全本200章",
+      extension: "ZIP",
+    });
+    expect(splitFileName("blue-footed-booby.html")).toEqual({
+      title: "blue-footed-booby",
+      extension: "HTML",
+    });
+  });
+
+  it("keeps a name that has no extension whole", () => {
+    expect(splitFileName("会议记录")).toEqual({ title: "会议记录" });
+    expect(splitFileName("README")).toEqual({ title: "README" });
+    expect(splitFileName("archive.")).toEqual({ title: "archive." });
+  });
+
+  it("does not read a dot in the middle of a name as a format", () => {
+    // A date, a version and a hidden file are names, not "11", "2" and "GITIGNORE".
+    expect(splitFileName("2026.11 计划")).toEqual({ title: "2026.11 计划" });
+    expect(splitFileName("v1.2")).toEqual({ title: "v1.2" });
+    expect(splitFileName(".gitignore")).toEqual({ title: ".gitignore" });
+  });
+
+  it("takes the last dot for a name with several", () => {
+    expect(splitFileName("backup.tar.gz")).toEqual({ title: "backup.tar", extension: "GZ" });
+  });
+
+  it("accepts a short format that starts with a digit, as 7z does", () => {
+    expect(splitFileName("photos.7z")).toEqual({ title: "photos", extension: "7Z" });
+  });
+});
