+
+/**
+ * A question set — a quiz paper or a form — answered a page at a time. Every pick stays on the
+ * phone until the last page's submit, which sends the whole sheet to the bot as one message so it
+ * can mark the answers or act on them.
+ */
+function ChoiceSetCard({
+  block,
+  botId,
+  groupId,
+  questions,
+  readOnly,
+  tokens,
+  width,
+  onSubmitted,
+  accessibilityActions,
+  onAccessibilityAction,
+}: {
+  block: ChoiceBlock;
+  botId: string;
+  groupId?: string;
+  questions: ChoiceQuestion[];
+  readOnly: boolean;
+  tokens: ReturnType<typeof useMobileTokens>;
+  width: number;
+  onSubmitted?: () => void;
+  accessibilityActions?: ViewProps["accessibilityActions"];
+  onAccessibilityAction?: ViewProps["onAccessibilityAction"];
+}) {
+  const { t } = useLingui();
+  // The saved sheet, or what was just sent: a delivered card reads back what was chosen.
+  const [picks, setPicks] = useState<Record<number, string[]>>(() =>
+    picksFromAnswers(questions, block.answers),
+  );
+  const [page, setPage] = useState(0);
+  const [sending, setSending] = useState(false);
+  const [sent, setSent] = useState(block.submitted === true);
+  const [failure, setFailure] = useState<string | null>(null);
+  const question = questions[page];
+  const answered = questions.filter((entry, index) => (picks[index]?.length ?? 0) > 0).length;
+  const last = page === questions.length - 1;
+  const locked = readOnly || sent;
+
+  function pick(optionId: string) {
+    if (locked || sending || !question) return;
+    const multiple = question.multiple === true || block.multiple === true;
+    setFailure(null);
+    setPicks((current) => {
+      const chosen = current[page] ?? [];
+      const next = multiple
+        ? chosen.includes(optionId)
+          ? chosen.filter((id) => id !== optionId)
+          : [...chosen, optionId]
+        : [optionId];
+      return { ...current, [page]: next };
+    });
+    hapticSelection();
+  }
+
+  async function send() {
+    if (locked || sending) return;
+    setSending(true);
+    setFailure(null);
+    try {
+      const answers: ChoiceAnswer[] = questions.map((entry, index) => ({
+        ...(entry.id ? { questionId: entry.id } : {}),
+        question: entry.question,
+        optionIds: picks[index] ?? [],
+      }));
+      await rpc("threads/send", {
+        ...(groupId ? { groupId } : { botId }),
+        clientNonce: newClientId(),
+        text: answerSheetText(block.question, questions, answers),
+      });
+      hapticSuccess();
+      setSent(true);
+      onSubmitted?.();
+    } catch (reason) {
+      hapticError();
+      setFailure(errorText(reason, t`Please try again.`));
+    } finally {
+      setSending(false);
+    }
+  }
+
+  if (!question) return null;
+  const chosen = picks[page] ?? [];
+  return (
+    <View
+      testID="choice-card"
+      style={[styles.card, { width, backgroundColor: native.fill }]}
+    >
+      <View style={styles.setHeader}>
+        <View style={styles.setStep}>
+          <Text
+            accessibilityRole="header"
+            accessibilityActions={accessibilityActions}
+            onAccessibilityAction={onAccessibilityAction}
+            style={[styles.setCount, { color: tokens.mutedForeground }]}
+          >
+            {`${page + 1} / ${questions.length}`}
+          </Text>
+          <Text
+            numberOfLines={1}
+            style={[styles.setTitle, { color: tokens.mutedForeground }]}
+          >
+            {block.question}
+          </Text>
+        </View>
+        <View style={[styles.track, { backgroundColor: native.fillPressed }]}>
+          <View
+            style={[
+              styles.fill,
+              {
+                backgroundColor: tokens.foreground,
+                width: `${Math.round((answered / questions.length) * 100)}%`,
+              },
+            ]}
+          />
+        </View>
+      </View>
+      <View style={{ gap: 4 }}>
+        <Text
+          accessibilityLabel={`${page + 1} / ${questions.length} ${question.question}`}
+          style={[styles.stepQuestion, { color: tokens.foreground }]}
+        >
+          {question.question}
+        </Text>
+        {question.subtitle ? (
+          <Text style={[styles.stepSubtitle, { color: tokens.mutedForeground }]}>
+            {question.subtitle}
+          </Text>
+        ) : null}
+        {question.multiple === true || block.multiple === true ? (
+          <Text style={[styles.prompt, { color: tokens.mutedForeground }]}>可多选，选好再点提交</Text>
+        ) : null}
+      </View>
+      <View style={styles.options}>
+        {question.options.map((option) => {
+          const picked = chosen.includes(option.id);
+          return (
+            <Pressable
+              key={option.id}
+              accessibilityRole="button"
