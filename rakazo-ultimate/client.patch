index 000000000..1f2fd7d5b
--- /dev/null
+++ b/apps/mobile/components/inbox/unread-jump-pill.tsx
@@ -0,0 +1,67 @@
+import { fontWeight, typeScale } from "@rakazo/ui-tokens";
+import { Pressable, StyleSheet, Text } from "react-native";
+import type { JumpDirection } from "../../lib/inbox/offscreen-unreads";
+import { useMobileTokens } from "../../lib/native/native";
+import { GlassSurface } from "../native/glass-surface";
+import { NativeSymbol } from "../native/native-symbol";
+
+export const UNREAD_JUMP_PILL_HEIGHT = 38;
+
+/** An unread-blue glass capsule with a label and a directional chevron after it. */
+export function UnreadJumpPill({
+  direction,
+  label,
+  accessibilityLabel,
+  onPress,
+}: {
+  direction: JumpDirection;
+  label: string;
+  accessibilityLabel: string;
+  onPress: () => void;
+}) {
+  const tokens = useMobileTokens();
+  // White on the tinted glass in both themes, like the user bubble's text.
+  const onFill = tokens.chatUserForeground;
+  return (
+    <Pressable
+      accessibilityRole="button"
+      accessibilityLabel={accessibilityLabel}
+      onPress={onPress}
+      style={({ pressed }) => ({ opacity: pressed ? 0.7 : 1 })}
+    >
+      <GlassSurface
+        tint={tokens.unread}
+        style={styles.pill}
+        fallbackStyle={{
+          backgroundColor: tokens.unread,
+          boxShadow: "0 2px 6px rgba(0, 0, 0, 0.22)",
+        }}
+      >
+        <Text style={[styles.label, { color: onFill }]}>{label}</Text>
+        <NativeSymbol
+          ios={direction === "above" ? "chevron.up" : "chevron.down"}
+          android={direction === "above" ? "chevron-up" : "chevron-down"}
+          size={16}
+          weight="semibold"
+          color={onFill}
+        />
+      </GlassSurface>
+    </Pressable>
+  );
+}
+
+const styles = StyleSheet.create({
+  pill: {
+    flexDirection: "row",
+    alignItems: "center",
+    gap: 6,
+    height: UNREAD_JUMP_PILL_HEIGHT,
+    borderRadius: UNREAD_JUMP_PILL_HEIGHT / 2,
+    paddingStart: 14,
+    paddingEnd: 12,
+  },
+  label: {
+    ...typeScale.secondary,
+    fontWeight: fontWeight.medium,
+  },
+});
diff --git a/apps/mobile/components/integrations-styles.ts b/apps/mobile/components/integrations-styles.ts
index e3d293705..c14c6fb63 100644
--- a/apps/mobile/components/integrations-styles.ts
+++ b/apps/mobile/components/integrations-styles.ts
@@ -107,5 +107,77 @@ export function createIntegrationsStyles() {
     toolsBody: { gap: 8, paddingTop: 4 },
     toolName: { color: native.label, fontSize: 14 },
     addCustom: { alignSelf: "flex-end", padding: 12 },
+    // 「连接应用」: a plain page, so a row is a line of type and an icon rather than a card.
+    appRow: {
+      minHeight: 60,
