+): Promise<number | undefined> {
+  const { plan, groupTarget, botTarget, reroutedToGroup, attachments } = payload;
+  const target = groupTarget ? { groupId: groupTarget } : { botId: botTarget! };
+  if (!plan.shouldSend) {
