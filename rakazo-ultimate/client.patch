diff --git a/packages/ui-web/src/lumen-manifest.ts b/packages/ui-web/src/lumen-manifest.ts
new file mode 100644
index 000000000..49f55c0d4
--- /dev/null
+++ b/packages/ui-web/src/lumen-manifest.ts
@@ -0,0 +1,164 @@
+import type { LumenManifest, LumenManifestSurface } from "@rakazo/core";
+import { lumenManifestPicture, lumenManifestUrl, parseLumenManifest } from "@rakazo/core";
+
+/**
+ * The same avatar manifest the phone reads: a JSON file the server hosts at
+ * `/lumen-avatars/manifest.json`. The browser reads it once (per session, and again after the
+ * cached copy is old), then every avatar that the file names shows its finished picture; a bot it
+ * does not name keeps the drawn body.
+ */
+
+const CACHE_KEY = "rakazo.lumen-manifest";
+const REFRESH_AFTER_MS = 10 * 60 * 1000;
+const FETCH_TIMEOUT_MS = 8_000;
+
+type Cached = { at: number; url: string; body: unknown };
+
+let manifest: LumenManifest | null = null;
+let loadedAt = 0;
+let inFlight: Promise<void> | null = null;
+let started = false;
+const listeners = new Set<() => void>();
+
+function emit() {
+  for (const listener of listeners) listener();
+}
+
+function serverBase(): string {
+  return window.location.origin;
+}
+
+/** The web app's theme is the `dark` class the token layer puts on the document. */
+function isDark(): boolean {
+  try {
+    return document.documentElement.classList.contains("dark");
+  } catch {
+    return true;
+  }
+}
+
+function readCache(): Cached | null {
+  try {
+    const raw = window.sessionStorage.getItem(CACHE_KEY);
+    if (!raw) return null;
+    const parsed = JSON.parse(raw) as Partial<Cached>;
+    if (typeof parsed.url !== "string" || typeof parsed.at !== "number") return null;
+    return { at: parsed.at, url: parsed.url, body: parsed.body };
+  } catch {
+    return null;
+  }
+}
+
+function writeCache(cached: Cached) {
+  try {
+    window.sessionStorage.setItem(CACHE_KEY, JSON.stringify(cached));
+  } catch {
+    // A full or blocked session store only costs the next load one fetch.
+  }
+}
+
+function publish(next: LumenManifest) {
+  manifest = next;
+  emit();
+}
+
+function refresh() {
+  if (inFlight) return inFlight;
+  let url: string;
+  try {
+    url = lumenManifestUrl(serverBase());
+  } catch {
+    return Promise.resolve();
+  }
+  const controller = new AbortController();
+  const timer = setTimeout(() => controller.abort(), FETCH_TIMEOUT_MS);
+  inFlight = fetch(url, { headers: { Accept: "application/json" }, signal: controller.signal })
+    .then(async (response) => {
+      if (!response.ok) return;
+      const body: unknown = await response.json();
+      const parsed = parseLumenManifest(body, url);
+      if (!parsed) return;
+      loadedAt = Date.now();
+      writeCache({ at: loadedAt, url, body });
+      if (parsed.version !== manifest?.version || parsed.baseUrl !== manifest?.baseUrl) {
+        publish(parsed);
+      }
+    })
+    .catch(() => {
+      // Offline or a bad file: keep the pictures already shown.
+    })
+    .finally(() => {
+      clearTimeout(timer);
+      inFlight = null;
+    });
+  return inFlight;
+}
+
+function start() {
+  if (started) return;
+  started = true;
+  const cached = readCache();
+  if (cached) {
+    const parsed = parseLumenManifest(cached.body, cached.url);
+    if (parsed) {
+      manifest = parsed;
+      loadedAt = cached.at;
+    }
+  }
+  void refresh();
+}
+
+export function subscribeLumenManifest(listener: () => void): () => void {
+  start();
+  listeners.add(listener);
+  return () => listeners.delete(listener);
+}
+
+export function lumenManifestSnapshot(): LumenManifest | null {
+  return manifest;
+}
+
+export function ensureLumenManifest(): void {
+  start();
+  if (Date.now() - loadedAt > REFRESH_AFTER_MS) void refresh();
+}
+
+/** The browser's own "reduce motion": the manifest then shows the still picture. */
+export function prefersReducedMotion(): boolean {
+  try {
+    return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
+  } catch {
+    return false;
+  }
+}
+
+export type WebLumenPicture = {
+  uri: string;
+  /** The size the finished art fixes for this surface (the hero's 136 pt), or null. */
+  size: number | null;
+  drawMainStar: boolean;
+};
+
+/**
+ * The picture a bot shows, with the browser's surface rule: large avatars get the full ignition,
+ * small ones the list loop, and the chief's list row the full ignition too. Sizes stay the DOM
+ * element's own, so a web layout keeps its measurements.
+ */
+export function lumenManifestPictureFor(input: {
+  identity?: string;
+  name?: string;
+  size: number;
+  surface?: LumenManifestSurface;
+}): WebLumenPicture | null {
+  if (!manifest) return null;
+  const picture = lumenManifestPicture(manifest, {
+    identity: input.identity,
+    name: input.name,
+    surface: input.surface ?? "default",
+    size: input.size,
+    dark: isDark(),
+    reducedMotion: prefersReducedMotion(),
+  });
+  if (!picture || picture.uris.length === 0) return null;
+  return { uri: picture.uris[0]!, size: picture.size, drawMainStar: picture.drawMainStar };
+}
