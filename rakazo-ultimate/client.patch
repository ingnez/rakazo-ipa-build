+
+/**
+ * The computer's own page: what it is, whose it is, who is holding it, what it is showing, and
+ * how full its disk is. The state a person would otherwise have to infer from an error line.
+ */
+export function ComputerDetailsSheet({
+  open,
+  computer,
+  updating,
+  cleaningUp,
+  onClose,
+  onCleanUp,
+  onUpdate,
+}: {
+  open: boolean;
+  computer: ComputerStatus | null;
+  /** An update or recovery is queued for this computer. */
