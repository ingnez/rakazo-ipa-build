+    out.append("  faces: readonly (readonly [number, string, number])[];")
+    out.append("}")
+    out.append("")
+    out.append("/** The official clip table, converted to the player's units. */")
+    out.append("export const MOTION_CLIPS: Readonly<Record<string, MotionClipData>> = {")
+
+    for name, clip in clips.items():
+        tracks = clip.get("tracks") or {}
+        blinks = [
+            round(key["t"], 6)
+            for key in tracks.get("expression", [])
+            if isinstance(key["v"], str) and key["v"] == "blink"
+        ]
+        faces = [
+            (round(key["t"], 6), key["v"], 1 if key.get("cut") else 0)
+            for key in tracks.get("expression", [])
+            if isinstance(key["v"], str) and key["v"] != "blink"
+        ]
+        work = clip.get("workArea") or {}
+        work_area = (
+            f"[{work['start']:.6g},{work['end']:.6g}]"
+            if work.get("start") is not None and work.get("end") is not None
+            else "null"
+        )
+        out.append(f"  {name}: {{")
+        out.append(f"    duration: {clip['duration']:.6g},")
+        out.append(f'    body: "{clip.get("body") or "sphere"}",')
+        out.append(f"    squashAnchor: {clip.get('squashAnchor', -1)},")
+        out.append(f"    workArea: {work_area},")
+        block = []
