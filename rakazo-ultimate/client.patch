@@ -0,0 +1,62 @@
+import { plural } from "@lingui/core/macro";
+import { useLingui } from "@lingui/react/macro";
+import { cn } from "@rakazo/ui-web";
+import type { ArtifactTarget } from "../../lib/artifact-open";
+import { ArtifactImage } from "./message-cards";
+
+export type RowImage = {
+  artifactId: string;
+  name: string;
+  target: ArtifactTarget;
+};
+
+/**
+ * Consecutive pictures in one message, as a short row. Up to three tiles; the last shows +N when
+ * more remain. Each tile opens its own preview (our existing ArtifactImage dialog).
+ */
+export function MessageImageRow({
+  images,
+  align,
+}: {
+  images: RowImage[];
+  align: "start" | "end";
+}) {
+  const { t } = useLingui();
+  const shown = images.slice(0, 3);
+  const rest = images.length - 2;
+  return (
+    <div
+      className={cn(
+        "flex max-w-full gap-2",
+        align === "end" ? "justify-end" : "justify-start",
+        shown.length > 2 ? "w-[32.5rem]" : shown.length > 1 ? "w-[21.5rem]" : undefined,
+      )}
+      role="group"
+      aria-label={t`${plural(images.length, { one: "# picture", other: "# pictures" })}`}
+    >
+      {shown.map((image, position) => {
+        const counts = images.length > 3 && position === shown.length - 1;
+        return (
+          <div
+            key={`${image.artifactId}-${position}`}
+            className="relative min-w-0 shrink basis-[10.5rem]"
+          >
+            <ArtifactImage
+              target={image.target}
+              artifactId={image.artifactId}
+              name={counts ? "" : image.name}
+            />
+            {counts ? (
+              <span
+                className="pointer-events-none absolute inset-0 flex items-center justify-center rounded-2xl bg-black/50 text-heading1 font-medium text-white tabular-nums"
+                aria-hidden
+              >
+                {`+${rest}`}
+              </span>
+            ) : null}
+          </div>
+        );
+      })}
+    </div>
+  );
+}
