@@ -0,0 +1,178 @@
+import { describe, expect, it } from "vitest";
+import { AVATAR_CLIP_POOLS, AVATAR_REST_POSE, avatarClip, avatarClipPose, avatarEase } from "./avatar-clips.js";
+import { BABYGROK_BODIES } from "./babygrok-geometry.js";
+import {
+  MOTION_CLIPS,
+  MOTION_FACES,
+  MOTION_SHAPE_SCALES,
+  MOTION_STATES,
+  motionClipPool,
+  motionFace,
+  motionFaceEyes,
+  motionShapeScale,
+  motionStateFace,
+  motionStateHold,
+  motionStateMorph,
+} from "./bot-motion-clips.js";
+
+describe("Rakazo's own motion clips", () => {
+  it("carries hand-written clips whose keys run forward inside their own duration", () => {
+    expect(Object.keys(MOTION_CLIPS).length).toBeGreaterThanOrEqual(20);
+    for (const [name, clip] of Object.entries(MOTION_CLIPS)) {
+      for (const track of [clip.position, clip.rotation, clip.zoom, clip.squash, clip.lids]) {
+        let last = -1;
+        for (const [time] of track ?? []) {
+          expect(time, name).toBeGreaterThan(last);
+          expect(time, name).toBeLessThanOrEqual(clip.duration);
+          last = time;
+        }
+      }
+    }
+  });
+
+  it("plays every clip in a pool, and every state names clips that exist", () => {
+    for (const [state, rule] of Object.entries(MOTION_STATES)) {
+      for (const name of [...rule.clips, ...(rule.compactClips ?? [])])
+        expect(MOTION_CLIPS[name], `${state} → ${name}`).toBeDefined();
+    }
+    // Idle rotates through the resting clips, the gentle look aside most often.
+    expect(motionClipPool("idle")).toContain("Idle_B");
+    expect(motionClipPool("idle", true)).toEqual(["Idle_B"]);
+    expect(motionClipPool("working")).toHaveLength(6);
+  });
+
+  it("starts and ends a clip at rest, so clips chain without a jump", () => {
+    const done = MOTION_CLIPS.Done_A!;
+    const early = avatarClipPose(avatarClip("Done_A"), 0);
+    const atEnd = avatarClipPose(avatarClip("Done_A"), done.duration);
+    expect(early.y).toBeCloseTo(0);
+    expect(atEnd.y).toBeCloseTo(0);
+    const mid = avatarClipPose(avatarClip("Done_A"), 0.6);
+    expect(Math.abs(mid.y)).toBeGreaterThan(0);
+  });
+
+  it("rests at zoom 1 and leans in when the work asks for a closer look", () => {
+    const pose = avatarClipPose(avatarClip("Idle_B"), 0);
+    expect(pose.zoom).toBeCloseTo(1, 5);
+    const closer = avatarClipPose(avatarClip("Working_D"), 1.0);
+    expect(closer.zoom).toBeGreaterThan(1);
+  });
+
+  it("unwraps rotations stored beyond a full turn, so no frame jumps", () => {
+    for (const name of Object.keys(MOTION_CLIPS)) {
+      const clip = avatarClip(name);
+      let previous = avatarClipPose(clip, 0);
+      for (let t = 0.02; t <= clip.duration; t += 0.02) {
+        const pose = avatarClipPose(clip, t);
+        const step = Math.max(
+          Math.abs(pose.pitch - previous.pitch),
+          Math.abs(pose.yaw - previous.yaw),
+          Math.abs(pose.roll - previous.roll),
+        );
+        expect(step, `${name} at ${t.toFixed(2)}s`).toBeLessThan(120);
+        previous = pose;
+      }
+    }
+  });
+
+  it("keeps the overshooting ease a landing is built on", () => {
+    // Done_A's landing uses a spring-like curve whose y leaves 0..1; a clamped ease would flatten it.
+    const overshoot = Math.max(
+      ...Array.from({ length: 60 }, (_, step) => avatarEase([0.3, 1.4, 0.5, 1], step / 60)),
+    );
+    expect(overshoot).toBeGreaterThan(1);
+  });
+
+  it("resolves an expression through its aliases to one of the nine faces", () => {
+    expect(motionFace("thinking")).toBe("sad");
+    expect(motionFace("smile")).toBe("happy");
+    expect(motionFace("squint")).toBe("squinted");
+    expect(motionFace("inspect")).toBe("inspecting");
+    expect(motionFace("angry")).toBe("squinted");
+    expect(motionFace("blink")).toBe("neutral");
+    expect(motionFace("nonsense")).toBe("neutral");
+    expect(Object.keys(MOTION_FACES)).toHaveLength(9);
+    for (const face of Object.keys(MOTION_FACES))
+      expect(motionFaceEyes(face), face).toBeDefined();
+  });
+
+  it("blinks where a clip says blink, and squashes where it says squash", () => {
+    const blinks = avatarClip("Idle_B").blinks ?? [];
+    expect(blinks).toEqual([0.6, 3.6]);
+    // Just after the written blink time the lids are shut.
+    expect(avatarClipPose(avatarClip("Idle_B"), 0.64).lid).toBeGreaterThan(0.2);
+    // Done_A squeezes as it crouches and as it lands, never past the spec's 8%.
+    const done = avatarClip("Done_A");
+    let widest = 0;
+    let flattest = 1;
+    for (let t = 0; t <= done.duration; t += 0.01) {
+      const pose = avatarClipPose(done, t);
+      widest = Math.max(widest, pose.squashX);
+      flattest = Math.min(flattest, pose.squashY);
+    }
+    expect(widest).toBeGreaterThan(1.03);
+    expect(widest).toBeLessThanOrEqual(1.09);
+    expect(flattest).toBeLessThan(0.97);
+    expect(flattest).toBeGreaterThanOrEqual(0.91);
+  });
+
+  it("wears a state's face over whatever face its clip asks for", () => {
+    expect(motionStateFace("sleeping")).toBe("sleepy");
+    expect(motionStateFace("waking")).toBe("surprised");
+    expect(motionStateFace("finished")).toBe("happy");
+    expect(motionStateFace("idle")).toBeNull();
+    expect(motionStateMorph("searching")).toBe("radar");
+    expect(motionStateMorph("thinking")).toBe("thinking");
+    expect(motionStateHold("blocked")).toBe(90);
+    expect(motionStateFace("unknown-state")).toBeNull();
+  });
+
+  it("keeps the resting pose's face when a clip has no face track", () => {
+    expect(avatarClipPose(avatarClip("Rotation_B"), 1).face).toBe(AVATAR_REST_POSE.face);
+  });
+
+  it("zooms every body to the size the others read at", () => {
+    // A triangle is smaller than a blob at the same reach; the zoom is normalised by area so it
+    // does not read as a shrunken chip in the picker.
+    for (const key of Object.keys(MOTION_SHAPE_SCALES)) {
+      const body = BABYGROK_BODIES[key as keyof typeof BABYGROK_BODIES];
+      if (!body) continue;
+      const scale = motionShapeScale(key);
+      expect(scale, key).toBeGreaterThanOrEqual(0.86);
+      expect(scale, key).toBeLessThanOrEqual(1.22);
+    }
+    // Drawn areas now match within a few percent, whichever body it is.
+    const area = (ring: readonly number[]) => {
+      let sum = 0;
+      const count = ring.length / 2;
+      for (let index = 0; index < count; index += 1) {
+        const next = (index + 1) % count;
+        sum += ring[index * 2]! * ring[next * 2 + 1]! - ring[next * 2]! * ring[index * 2 + 1]!;
+      }
+      return Math.abs(sum) / 2;
+    };
+    const drawn = (key: string) => {
+      const body = BABYGROK_BODIES[key as keyof typeof BABYGROK_BODIES]!;
+      return area(body.ring) * motionShapeScale(key) ** 2;
+    };
+    const wedge = drawn("wedge");
+    const blob = drawn("blob");
+    expect(wedge / blob).toBeGreaterThan(0.55);
+    expect(wedge / blob).toBeLessThan(1.15);
+    expect(motionShapeScale("nope")).toBe(1);
+  });
+
+  it("keeps the resting pools small and the working pool the official six", () => {
+    // The resting pool is the official idle set's own gentle clip (`Idle_B`). The louder two are
+    // left out on purpose: they are authored for one bot on one screen, and played at rest on every
+    // row of an inbox they swing a dozen bodies about instead of letting them breathe.
+    expect(AVATAR_CLIP_POOLS.idle.length).toBeGreaterThan(0);
+    for (const name of AVATAR_CLIP_POOLS.idle)
+      expect(motionClipPool("idle"), name).toContain(name);
+    expect(AVATAR_CLIP_POOLS.compactIdle).toEqual(motionClipPool("idle", true));
+    expect(AVATAR_CLIP_POOLS.working).toEqual(motionClipPool("working"));
+    // Every pool name is a clip the player can find.
+    for (const pool of Object.values(AVATAR_CLIP_POOLS))
+      for (const name of pool) expect(avatarClip(name).duration, name).toBeGreaterThan(0);
+  });
+});
diff --git a/packages/core/src/bot-motion-clips.ts b/packages/core/src/bot-motion-clips.ts
new file mode 100644
index 000000000..9f4991ac9
--- /dev/null
+++ b/packages/core/src/bot-motion-clips.ts
@@ -0,0 +1,226 @@
+import { babygrokVisualScale } from "./babygrok-geometry.js";
+import { avatarClip, avatarClipPose } from "./avatar-clips.js";
+import {
+  MOTION_BODY_GRADIENTS,
+  MOTION_BODY_SOLIDS,
+  MOTION_CLIPS,
+  MOTION_FACE_ALIASES,
+  MOTION_FACES,
+  MOTION_GRADIENT_ANGLE,
+  MOTION_MORPH_DURATIONS,
+  MOTION_MORPHS,
+  MOTION_MORPH_NAMES,
+  MOTION_SHAPE_SCALE_OVERRIDE,
+  MOTION_SHAPE_SCALES,
+  MOTION_STATES,
+} from "./bot-motion-clips-data.js";
+import type { AvatarPose } from "./avatar-clips.js";
+
+/**
+ * Rakazo's avatar motion, from its own avatar spec (`avatar-spec.ts`).
+ *
+ * The hand-written clips and the state table live in the spec; this is the layer that answers the questions the renderer asks — which clips a
+ * state plays, which face an expression means, and what an expression does to the eyes.
+ */
+
+export {
+  MOTION_CLIPS,
+  MOTION_BODY_GRADIENTS,
+  MOTION_BODY_SOLIDS,
+  MOTION_FACE_ALIASES,
+  MOTION_FACES,
+  MOTION_GRADIENT_ANGLE,
+  MOTION_MORPH_DURATIONS,
+  MOTION_MORPHS,
+  MOTION_MORPH_NAMES,
+  MOTION_SHAPE_SCALE_OVERRIDE,
+  MOTION_SHAPE_SCALES,
+  MOTION_STATES,
+};
+
+/** The states the app's own clock can ask for, on top of idle/working/thinking. */
+export type MotionState =
+  | "idle"
+  | "listening"
+  | "thinking"
+  | "streaming"
+  | "searching"
+  | "working"
+  | "blocked"
+  | "finished"
+  | "failed"
+  | "sleeping"
+  | "waking"
+  | "celebrate"
+  | "orbit"
+  | "radar"
+  | "progress"
+  | "dictating"
+  | "sending"
+  | "receiving"
+  | "uploading"
+  | "writing"
+  | "alerting"
+  | "bouncing"
+  | "powering-down";
+
+/** The clip pool a state plays, straight from the spec's state table (weights included). */
+export function motionClipPool(state: string, compact = false): readonly string[] {
+  const rule = MOTION_STATES[state];
+  if (!rule) return MOTION_STATES.idle?.clips ?? [];
+  if (compact && rule.compactClips?.length) return rule.compactClips;
+  return rule.clips;
+}
+
+/** The face a state forces on every clip it plays, if it forces one. */
+export function motionStateFace(state: string): string | null {
+  const face = MOTION_STATES[state]?.face;
+  return face ? motionFace(face) : null;
+}
+
+/** The morph effect a state lays over its clip, if it lays one. */
+export function motionStateMorph(state: string): string | null {
+  return MOTION_STATES[state]?.morph ?? null;
+}
+
+/** How many seconds a state holds before moving on to `next`, when it does. */
+export function motionStateHold(state: string): number {
+  return MOTION_STATES[state]?.holdSeconds ?? 0;
+}
+
+/**
+ * A face name as the renderer knows it: the spec's aliases (e.g. `smile` is `happy`) resolve to the nine canonical faces; `blink` is not a face at
+ * all, it is the eyelids shutting, so it keeps the face that is already on.
+ */
+export function motionFace(expression: string | null | undefined): string {
+  if (!expression || expression === "blink") return "neutral";
+  const canonical = MOTION_FACE_ALIASES[expression] ?? expression;
+  return MOTION_FACES[canonical] ? canonical : "neutral";
+}
+
+/**
+ * What a face does to the eye drawing.
+ *
+ * The eyes themselves are drawn by the stroke renderer (a capsule that arches when pleased, and
+ * thins as the lid closes); a face picks how arched it is (`mood`) and how open the lid is
+ * (`open`, 1 fully open). The spec's eyelid curves in `MOTION_FACES` are what these two numbers come from: a vertical lid (`p0`/`p2` apart)
+ * is an open eye, a lid that closes on itself (`p0` and `p2` level) is a squint, and an arc
+ * (`isArc`) is the pleased eye.
+ */
+export const MOTION_FACE_EYES: Readonly<Record<string, { mood: number; open: number }>> = {
+  neutral: { mood: 0, open: 1 },
+  happy: { mood: 1, open: 1 },
+  surprised: { mood: 0, open: 1.12 },
+  inspecting: { mood: 0, open: 0.74 },
+  sad: { mood: 0, open: 0.62 },
+  sleepy: { mood: 0, open: 0.42 },
+  squinted: { mood: 0.34, open: 0.78 },
+  calm: { mood: 0, open: 0.3 },
+  confused: { mood: 0.18, open: 0.86 },
+};
+
+/** The eye knobs a face asks for. */
+export function motionFaceEyes(face: string): { mood: number; open: number } {
+  "worklet";
+  return MOTION_FACE_EYES[face] ?? MOTION_FACE_EYES.neutral!;
+}
+
+/**
+ * The lid curve a face names, flattened into numbers a worklet can carry: the spec's own
+ * quadratics. `arc` is 1 for a pleased arc.
+ */
+export function motionFaceSpec(face: string): {
+  p0x: number;
+  p0y: number;
+  p1x: number;
+  p1y: number;
+  p2x: number;
+  p2y: number;
+  arc: number;
+} {
+  "worklet";
+  const spec = MOTION_FACES[face] ?? MOTION_FACES.neutral!;
+  return {
+    p0x: spec.p0[0],
+    p0y: spec.p0[1],
+    p1x: spec.p1[0],
+    p1y: spec.p1[1],
+    p2x: spec.p2[0],
+    p2y: spec.p2[1],
+    arc: spec.isArc ? 1 : 0,
+  };
+}
+
+/**
+ * The interaction constants (press scale, springs, sizes). They are generic UI timings; they were
+ * first tuned against a reference app and are due to be re-tuned on their own. Kept together
+ * so a caller reaching for "the 340 ms mark arrival" cannot quietly invent a different value.
+ */
+export const MOTION_NAMED = {
+  /** A press shrinks a control to 97%; the release springs back on a RELEASE spring. */
+  PRESSED_SCALE: 0.97,
+  PRESSED_SEND_OPACITY: 0.7,
+  PRESS_IN: { duration: 90 },
+  HOVER_FADE: { duration: 120 },
+  RELEASE: { damping: 16, stiffness: 340, mass: 0.6 },
+  GRAB_SPRING: { duration: 300, dampingRatio: 1 },
+  TURN_SPRING: { damping: 24, mass: 1, stiffness: 220, overshootClamping: true },
+  PAN_SLOP: 10,
+  HEAD_SIZE: 168,
+  MARK_SIZE: 176,
+  GROUP_RADIUS: 10,
+  PIN_RADIUS: 8,
+  DOT_SIZE: 6,
+  SEGMENT_WIDTH: 8,
+  SLOT_SIZE: 52,
+  SLOT_GAP: 4,
+  SEND_RING_SCALE: 0.7,
+  SEND_RING_OPACITY: 0.5,
+  SEND_PROGRESS_WIDTH: 20,
+  EYE_TRAVEL_UNITS: 16,
+  MARK_ARRIVAL_MS: 340,
+  MARK_ARRIVAL_DAMPING_RATIO: 0.82,
+} as const;
+
+/**
+ * A body colour as its flat swatch, in the given appearance: black is pure
+ * black on the light page and pure white on the dark one, which is why the first dot of its
+ * palette stays visible in either theme.
+ */
+export function motionBodySolid(color: string, dark: boolean): string {
+  const upper = color.toUpperCase();
+  for (const solid of Object.values(MOTION_BODY_SOLIDS)) {
+    if (!solid) continue;
+    if (solid.light?.toUpperCase() === upper || solid.dark?.toUpperCase() === upper) {
+      return dark ? (solid.dark ?? color) : (solid.light ?? color);
+    }
+  }
+  return color;
+}
+
+/** A body's zoom for its own shape: normalised by area so every body reads the same size (see
+ * `BABYGROK_VISUAL_SCALES`). */
+export function motionShapeScale(key: string): number {
+  // The spec's override table is empty; the area normalisation decides.
+  void MOTION_SHAPE_SCALE_OVERRIDE;
+  return babygrokVisualScale(key);
+}
+
+/** The four gradient stops a body wears, by its stored color, in the given appearance. */
+export function motionBodyGradient(
+  color: string,
+  dark: boolean,
+): { from: string; to: string } | null {
+  const name = Object.keys(MOTION_BODY_SOLIDS).find(
+    (key) => MOTION_BODY_SOLIDS[key]?.light === color.toUpperCase() || MOTION_BODY_SOLIDS[key]?.dark === color.toUpperCase(),
+  );
+  if (!name) return null;
+  const gradient = MOTION_BODY_GRADIENTS[name];
+  if (!gradient) return null;
+  return dark ? { from: gradient.darkFrom, to: gradient.darkTo } : { from: gradient.lightFrom, to: gradient.lightTo };
+}
+
+/** A clip's pose, by name, for callers that only hold the name. */
+export function motionClipPoseAt(name: string, seconds: number): AvatarPose {
+  return avatarClipPose(avatarClip(name), seconds);
+}
