+import { describe, expect, it } from "vitest";
+import { scrollPoint } from "./computer-input.js";
+
+describe("scrollPoint", () => {
+  it("keeps the point a scroll was made at, in whole screen pixels", () => {
+    expect(scrollPoint({ direction: "down", amount: 2, x: 600.4, y: 420 })).toEqual({
+      x: 600,
+      y: 420,
+    });
+  });
+
+  it("drops a missing, partial or invalid point, so the wheel turns where the pointer is", () => {
+    expect(scrollPoint({ direction: "down" })).toEqual({});
+    expect(scrollPoint({ x: 600 })).toEqual({});
+    expect(scrollPoint({ x: "left", y: 420 })).toEqual({});
+    expect(scrollPoint({ x: -5, y: 420 })).toEqual({});
+    expect(scrollPoint({ x: Number.POSITIVE_INFINITY, y: 420 })).toEqual({});
+  });
+
+  it.each([
+    ["null", null],
+    ["an empty string", ""],
+    ["a blank string", " "],
+    ["a boolean", true],
+    ["an empty array", []],
+  ])("does not read %s as a point at the top-left corner", (_label, bad) => {
+    expect(scrollPoint({ x: bad, y: bad })).toEqual({});
+    expect(scrollPoint({ x: 10, y: bad })).toEqual({});
+  });
+
+  it("still accepts a coordinate sent as a numeric string", () => {
+    expect(scrollPoint({ x: "12.4", y: "0" })).toEqual({ x: 12, y: 0 });
+  });
+});
diff --git a/apps/api/src/computers/computer-provider-config.ts b/apps/api/src/computers/computer-provider-config.ts
new file mode 100644
index 000000000..fd6aa1b3a
--- /dev/null
+++ b/apps/api/src/computers/computer-provider-config.ts
@@ -0,0 +1,390 @@
+import { ORPCError } from "@orpc/server";
+import type { SandboxProvider, SecretStore } from "@rakazo/adapter-kit";
+import type {
+  ResolveHostname,
+  SecretCleanup,
+  SecretCleanupDeps,
+  StoredComputerSettings,
+} from "@rakazo/adapters";
+import {
+  assertSafeWebUrl,
+  COMPUTER_PROVIDER_SECRET_KIND,
+  cleanUpUnsavedSecret,
+  computerProviderDescriptor,
+  computerProviderDescriptors,
+  computerSettingsForProvider,
+  DEPLOYMENT_COMPUTER_PROVIDER_RECORD,
+  finishSecretCleanup,
+  loadComputerProviderSelection,
+  loadAccountComputerSettings as loadSavedAccountComputerSettings,
+  recordSecretCleanup,
+  refreshComputerProvider,
+  savedSecretIn,
+} from "@rakazo/adapters";
+import type { Actor, ComputerProviderSettings, ComputerProviderUpdate } from "@rakazo/contracts";
+import { ClientError } from "@rakazo/core";
+import type { PrismaClient } from "@rakazo/db";
+import { Prisma, runAsSystem, withTransactionRetry } from "@rakazo/db";
+import { getLogger } from "@rakazo/logging";
+import { requireAdmin } from "../auth/admins.js";
+import type { RouterDeps } from "../router.js";
+
+export interface ComputerProviderConfigDeps {
+  prisma: PrismaClient;
+  secrets: Pick<SecretStore, "put" | "load" | "delete" | "isRemote">;
+  jobs: SecretCleanupDeps["jobs"];
+  sandbox: SandboxProvider;
+  env: Pick<RouterDeps["env"], "sandboxProvider" | "adminEmails" | "computerSettingsEnabled">;
+  resolveHostname?: ResolveHostname;
+  /** Test seam: confirm the desktop answers before saving. */
+  verifyConnection?: (settings: StoredComputerSettings, signal: AbortSignal) => Promise<void>;
+}
+
+const VERIFY_TIMEOUT_MS = 20_000;
+
+function view(
+  provider: string,
+  saved: StoredComputerSettings | null,
+  defaultProvider: string,
+  account = false,
+  enabled = true,
+): ComputerProviderSettings {
+  if (!enabled) provider = "default";
+  const values: Record<string, string> = {};
+  const savedSecrets: Record<string, boolean> = {};
+  if (saved && saved.provider === provider) {
+    for (const field of computerProviderDescriptor(provider).fields) {
+      if (field.kind === "secret") savedSecrets[field.key] = Boolean(saved.values[field.key]);
+      else values[field.key] = saved.values[field.key] ?? "";
+    }
+  }
+  return {
+    provider,
+    defaultProvider,
+    values,
+    savedSecrets,
+    providers: enabled ? computerProviderDescriptors(account) : [],
+  };
+}
+
+async function checkedSettings(
+  deps: ComputerProviderConfigDeps,
+  actor: Actor,
+  input: ComputerProviderUpdate,
+  previous: StoredComputerSettings | null,
+  account = false,
+): Promise<StoredComputerSettings> {
+  if (!computerProviderDescriptors().some((provider) => provider.id === input.provider))
+    throw new ClientError("BAD_REQUEST", "Unknown computer provider");
+  try {
+    const descriptor = computerProviderDescriptor(input.provider);
+    if (account && !descriptor.capabilities.perAccount)
+      throw new Error("Provider does not support account settings");
+    const values = { ...input.values };
+    const saved = computerSettingsForProvider(previous, input.provider)?.values ?? {};
+    const destinationChanged = descriptor.fields.some(
+      (field) => field.kind === "url" && (values[field.key] ?? "") !== (saved[field.key] ?? ""),
+    );
+    for (const field of descriptor.fields) {
+      if (
+        field.kind === "secret" &&
+        !values[field.key] &&
+        !destinationChanged &&
+        (!field.destination || values[field.destination] === saved[field.destination])
+      )
+        values[field.key] = saved[field.key] ?? "";
+    }
+    descriptor.verify(values);
+    const signal = AbortSignal.timeout(VERIFY_TIMEOUT_MS);
+    for (const field of descriptor.fields) {
+      if (field.kind === "url" && values[field.key])
+        await assertSafeWebUrl(values[field.key]!, deps.resolveHostname, signal);
+    }
+    // Only the connection being left stays, for computers still on it; older ones are dropped.
+    const connections: Record<string, Record<string, string>> | undefined =
+      !account && previous ? { [previous.provider]: previous.values } : undefined;
+    if (connections) delete connections[input.provider];
+    const settings = {
+      provider: input.provider,
+      values,
+      ...(connections && Object.keys(connections).length ? { connections } : {}),
+    };
+    if (deps.verifyConnection) await deps.verifyConnection(settings, signal);
+    else await descriptor.verifyConnection?.(values, signal);
+    return settings;
+  } catch (error) {
+    // Provider failures and schema errors can contain credentials: log only the error's class.
+    getLogger().warn("computer_provider.verify_failed", {
+      provider: input.provider,
+      scope: account ? "account" : "deployment",
+      "user.id": actor.userId,
+      "error.name": error instanceof Error ? error.name : typeof error,
+    });
+    throw new ORPCError("BAD_REQUEST", { message: "Could not verify computer settings" });
+  }
+}
+
+function encrypt(
+  deps: ComputerProviderConfigDeps,
+  actor: Actor,
+  settings: StoredComputerSettings,
+  recordId?: string,
+) {
+  return deps.secrets.put(
+    JSON.stringify(settings),
+    {
+      operationId: "computer-provider-config",
+      traceId: "computer-provider-config",
+      spaceId: actor.spaceId,
+      userId: actor.userId,
+      signal: new AbortController().signal,
+    },
+    recordId ? { recordId } : undefined,
+  );
+}
+
+export async function getComputerProviderSettings(
+  deps: ComputerProviderConfigDeps,
+  actor: Actor,
+): Promise<ComputerProviderSettings> {
+  await requireAdmin(deps, actor.userId);
+  const selection = await loadComputerProviderSelection(deps.prisma, deps.secrets);
+  return view(
+    selection.provider,
+    selection.settings,
+    deps.env.sandboxProvider,
+    false,
+    deploymentCanChoose(deps),
+  );
+}
+
+export async function updateComputerProviderSettings(
+  deps: ComputerProviderConfigDeps,
+  actor: Actor,
+  input: ComputerProviderUpdate,
+): Promise<ComputerProviderSettings> {
+  await requireAdmin(deps, actor.userId);
+  if (input.provider !== "default" && !deploymentCanChoose(deps))
+    throw new ORPCError("BAD_REQUEST", { message: "This deployment cannot use computer settings" });
+  const existing = await loadComputerProviderSelection(deps.prisma, deps.secrets);
+  if (input.provider === "default") {
+    // Going back removes the saved keys; computers still on them restart on the default.
+    const removed = await runAsSystem("an admin keeps computers on the deployment provider", () =>
+      deps.prisma.$transaction(async (tx) => {
+        const current = await tx.deploymentSettings.findUnique({
+          where: { id: "default" },
+          select: { computerProviderCipher: true },
+        });
+        await tx.deploymentSettings.upsert({
+          where: { id: "default" },
+          create: { id: "default", computerProvider: null, computerProviderCipher: null },
+          update: { computerProvider: null, computerProviderCipher: null },
+        });
+        const dropped = current?.computerProviderCipher;
+        if (!dropped) return undefined;
+        const cleanup = deploymentSecret(dropped);
+        await recordSecretCleanup(deps, tx, cleanup);
+        return cleanup;
+      }),
+    );
+    if (removed) await finishSecretCleanup(deps, removed);
+    await refreshComputerProvider(deps.sandbox);
+    return view("default", null, deps.env.sandboxProvider, false, deploymentCanChoose(deps));
+  }
+  // Blank secrets keep the saved ones, so an admin never has to see them again.
+  const settings = await checkedSettings(deps, actor, input, existing.settings);
+  // Owned by the deployment row, not a user or space, so no account deletion removes it.
+  const stored = await encrypt(deps, actor, settings, DEPLOYMENT_COMPUTER_PROVIDER_RECORD);
+  let replaced: SecretCleanup | undefined;
+  try {
+    // Read what this save replaces in the same transaction, so concurrent saves each remove theirs.
+    replaced = await withTransactionRetry(() =>
+      runAsSystem("an admin configures computers", () =>
+        deps.prisma.$transaction(
+          async (tx) => {
+            const current = await tx.deploymentSettings.findUnique({
+              where: { id: "default" },
+              select: { computerProviderCipher: true },
+            });
+            await tx.deploymentSettings.upsert({
+              where: { id: "default" },
+              create: {
+                id: "default",
+                computerProvider: input.provider,
+                computerProviderCipher: stored.ciphertext,
+              },
+              update: {
+                computerProvider: input.provider,
+                computerProviderCipher: stored.ciphertext,
+              },
+            });
+            await savedSecretIn(deps, tx, stored.ciphertext);
+            const previous = current?.computerProviderCipher;
+            if (!previous || previous === stored.ciphertext) return undefined;
+            const cleanup = deploymentSecret(previous);
+            await recordSecretCleanup(deps, tx, cleanup);
+            return cleanup;
+          },
+          { isolationLevel: Prisma.TransactionIsolationLevel.Serializable },
+        ),
+      ),
+    );
+  } catch (error) {
+    await cleanUpUnsavedSecret(deps, deploymentSecret(stored.ciphertext));
+    throw error;
+  }
+  if (replaced) await finishSecretCleanup(deps, replaced);
+  await refreshComputerProvider(deps.sandbox);
+  return view(input.provider, settings, deps.env.sandboxProvider);
+}
+
+/** Where computers run while an account keeps the deployment default. */
+async function deploymentProvider(deps: ComputerProviderConfigDeps) {
+  // Only a saved connection that still reads counts; otherwise computers use the environment's.
+  const selection = await loadComputerProviderSelection(deps.prisma, deps.secrets);
+  if (!routesBySettings(deps.env.sandboxProvider) || selection.provider === "default")
+    return deps.env.sandboxProvider;
+  return selection.provider;
+}
+
+/** Account computer settings. */
+export async function getAccountComputerSettings(
+  deps: ComputerProviderConfigDeps,
+  actor: Actor,
+): Promise<ComputerProviderSettings> {
+  const [saved, defaultProvider] = await Promise.all([
+    loadSavedAccountComputerSettings(deps.prisma, deps.secrets, actor.userId),
+    deploymentProvider(deps),
+  ]);
+  return view(
+    saved?.provider ?? "default",
+    saved,
+    defaultProvider,
+    true,
+    // An account with saved keys still sees the form, so it can go back to the default.
+    Boolean(deps.env.computerSettingsEnabled) &&
+      (accountCanChoose(defaultProvider) || Boolean(saved)),
+  );
+}
+
+export async function updateAccountComputerSettings(
+  deps: ComputerProviderConfigDeps,
+  actor: Actor,
+  input: ComputerProviderUpdate,
+): Promise<ComputerProviderSettings> {
+  // Those deployments run every computer on their own provider, never one chosen in Settings,
+  // and one without computers has none for an account's private computers to fall back on.
+  // Going back to the default stays open, so an account can always remove its saved keys.
+  if (
+    input.provider !== "default" &&
+    (!deps.env.computerSettingsEnabled || !accountCanChoose(await deploymentProvider(deps)))
+  )
+    throw new ORPCError("BAD_REQUEST", {
+      message: "This deployment cannot use account computer settings",
+    });
+  const mine = { userId: actor.userId, spaceId: null, kind: COMPUTER_PROVIDER_SECRET_KIND };
+  let saved: StoredComputerSettings | null = null;
+  let replaced: SecretCleanup[] = [];
+  if (input.provider === "default") {
+    // The account's computers move to the deployment's desktop the next time they start.
+    replaced = await runAsSystem("an account goes back to the deployment's computers", () =>
+      deps.prisma.$transaction(async (tx) => {
+        const rows = await tx.secret.findMany({
+          where: mine,
+          select: { id: true, ciphertext: true },
+        });
+        await tx.secret.deleteMany({ where: { id: { in: rows.map((row) => row.id) } } });
+        return recordRowCleanups(deps, tx, rows);
+      }),
+    );
+  } else {
+    const previous = await loadSavedAccountComputerSettings(
+      deps.prisma,
+      deps.secrets,
+      actor.userId,
+    );
+    saved = await checkedSettings(deps, actor, input, previous, true);
+    const stored = await encrypt(deps, actor, saved);
+    try {
+      replaced = await withTransactionRetry(() =>
+        runAsSystem("an account saves computer settings", () =>
+          deps.prisma.$transaction(
+            async (tx) => {
+              // Account-level, so it outlives any one space and only its owner can read it.
+              const secret = await tx.secret.create({
+                data: { ...mine, id: stored.id, ciphertext: stored.ciphertext },
+              });
+              const rows = await tx.secret.findMany({
+                where: { ...mine, id: { not: secret.id } },
+                select: { id: true, ciphertext: true },
+              });
+              await tx.secret.deleteMany({ where: { id: { in: rows.map((row) => row.id) } } });
+              return recordRowCleanups(deps, tx, rows);
+            },
+            { isolationLevel: Prisma.TransactionIsolationLevel.Serializable },
+          ),
+        ),
+      );
+    } catch (error) {
+      await cleanUpUnsavedSecret(deps, rowSecret(stored));
+      throw error;
+    }
+  }
+  // A remote secret store keeps every saved value until it is deleted there too.
+  await Promise.all(replaced.map((cleanup) => finishSecretCleanup(deps, cleanup)));
+  await refreshComputerProvider(deps.sandbox);
+  return view(
+    saved?.provider ?? "default",
+    saved,
+    await deploymentProvider(deps),
+    true,
+    Boolean(deps.env.computerSettingsEnabled),
+  );
+}
+
+function deploymentSecret(ref: string): SecretCleanup {
+  return {
+    kind: "deployment_computer_provider",
+    recordId: DEPLOYMENT_COMPUTER_PROVIDER_RECORD,
+    ref,
+  };
+}
+
+function rowSecret(row: { id: string; ciphertext: string }): SecretCleanup {
+  return { kind: "secret_row", recordId: row.id, ref: row.ciphertext };
+}
+
+/** In the transaction that deletes the rows, so their store entries are removed even after a crash. */
+async function recordRowCleanups(
+  deps: ComputerProviderConfigDeps,
+  tx: Prisma.TransactionClient,
+  rows: { id: string; ciphertext: string }[],
+): Promise<SecretCleanup[]> {
+  const cleanups = rows.map(rowSecret);
+  for (const cleanup of cleanups) await recordSecretCleanup(deps, tx, cleanup);
+  return cleanups;
+}
+
+function deploymentCanChoose(deps: ComputerProviderConfigDeps) {
+  return Boolean(deps.env.computerSettingsEnabled) && routesBySettings(deps.env.sandboxProvider);
+}
+
+/** Whether computers on this deployment can run where Settings says. */
+function routesBySettings(envProvider: string) {
+  return envProvider !== "desktop" && envProvider !== "fake";
+}
+
+function accountCanChoose(deploymentProvider: string) {
+  return (
+    routesBySettings(deploymentProvider) && deploymentProvider !== "none" && !!deploymentProvider
+  );
+}
+
+/** Where the deployment's computers run once an admin's choice in Settings applies. */
+export function effectiveSandboxProvider(
+  settings: { computerProvider?: string | null; computerProviderCipher?: string | null } | null,
+  envProvider: string,
+) {
+  if (!routesBySettings(envProvider)) return envProvider;
+  return (settings?.computerProviderCipher && settings.computerProvider) || envProvider;
+}
diff --git a/apps/api/src/computers/home-retention.ts b/apps/api/src/computers/home-retention.ts
new file mode 100644
index 000000000..a30c04740
--- /dev/null
+++ b/apps/api/src/computers/home-retention.ts
@@ -0,0 +1,369 @@
+import type { TransactionalEmailProvider } from "@rakazo/adapter-kit";
+import { sandboxKindsWhere } from "@rakazo/adapters";
+import type { HomeDeletionReason } from "@rakazo/auth";
+import { emailLocale, homeDeletionEmail } from "@rakazo/auth";
+import type { PrismaClient } from "@rakazo/db";
+import {
+  assertLeaseHeld,
+  hasModelAccess,
+  LeaseHeldError,
+  needsBillingPortal,
+  Prisma,
+  runAsSystem,
+  withLease,
+} from "@rakazo/db";
+import { getLogger } from "@rakazo/logging";
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+const PLAN_ENDED_DAYS = 30;
+const UNUSED_DAYS = 90;
+const WARNING_DAYS = 7;
+const LEASE_MS = 2 * 60 * 1000;
+const BATCH = 500;
+/** Cleared only while nothing runs on it; a failed start leaves `error`, which nothing moves on. */
+const IDLE_STATES = ["stopped", "suspended", "error"];
+const NO_CREDITS = { mode: null, balanceMicros: 0n, byokFreeUntil: null };
+
+type Account = {
+  billing: {
+    status: string | null;
+    paidAt: Date | null;
+    endedAt: Date | null;
+    currentPeriodEndsAt: Date | null;
+    updatedAt: Date;
+  } | null;
+  modelCredits: {
+    mode: string | null;
+    balanceMicros: bigint;
+    byokFreeUntil: Date | null;
+    /** The latest purchase or grant only. */
+    lots: Array<{ createdAt: Date }>;
+  } | null;
+};
+type Due = { at: Date; reason: HomeDeletionReason };
+type Db = PrismaClient | Prisma.TransactionClient;
+type Warning = { organizationId: string; reason: HomeDeletionReason; ids: string[] };
+
+/**
+ * When a computer's saved home becomes due for deletion: 30 days after a paid plan ended, or
+ * 90 days unused without one (a trial that never paid counts as none). Use since then moves it
+ * later, and so does buying credits, even ones spent before the next sweep. Null while the
+ * organization can run bots (a plan, credits or a free period) or owes a payment.
+ */
+export function homeDeletionDue(account: Account, lastUsedAt: Date, now = new Date()): Due | null {
+  if (planIsLive(account, now)) return null;
+  const { billing, modelCredits } = account;
+  const credited = modelCredits?.lots[0]?.createdAt;
+  const since = credited ? latest(credited, lastUsedAt) : lastUsedAt;
+  if (billing?.paidAt) {
+    const ended = billing.endedAt ?? billing.currentPeriodEndsAt ?? billing.updatedAt;
+    return { at: addDays(latest(ended, since), PLAN_ENDED_DAYS), reason: "plan-ended" };
+  }
+  return { at: addDays(since, UNUSED_DAYS), reason: "unused" };
+}
+
+function planIsLive({ billing, modelCredits }: Account, now: Date) {
+  const status = billing?.status ?? null;
+  return needsBillingPortal(status) || hasModelAccess(modelCredits ?? NO_CREDITS, status, now);
+}
+
+const candidate = {
+  homeStorageId: { not: null },
+  // These work in a copy on a host the user or the server runs; the stored home only backs it up.
+  kind: { notIn: sandboxKindsWhere((capabilities) => capabilities.storedHomeIsBackup) },
+} satisfies Prisma.ComputerWhereInput;
+
+interface HomeRetentionDeps {
+  prisma: PrismaClient;
+  email: TransactionalEmailProvider;
+  appUrl: string;
+  onError: (error: unknown) => void;
+}
+
+/**
+ * Deletes stored homes that are past retention, emailing each organization's owner a week
+ * first. Every API instance may run it: a lease keeps each email to one process, and eligibility
+ * is read again right before each email and inside the deletion's transaction, so resubscribing
+ * or using a bot in the meantime cancels it.
+ *
+ * Deleting clears the computer's pointer to its stored home, its kept versions and the key that
+ * decrypts them; the worker's storage sweep then removes the unowned objects. The computer row and its provider
+ * reference stay, so a provider that keeps its own disk resumes it; any other computer, or one
+ * whose provider copy has expired, starts empty next time. Computers whose stored
+ * home is only a backup are skipped: they work in a copy on a host. Aborting stops it
+ * between emails and deletions; the next sweep picks up the rest.
+ */
+export function homeRetentionSweep(
+  deps: HomeRetentionDeps,
+): (signal: AbortSignal) => Promise<void> {
+  return (signal) =>
+    runAsSystem("delete saved homes past retention", async () => {
+      const { prisma } = deps;
+      await prisma.homeDeletionNotice.deleteMany({
+        where: { computer: { NOT: candidate } },
+      });
+      const warnings = new Map<string, Warning>();
+      let cursor: string | undefined;
+      while (!signal.aborted) {
+        const now = new Date();
+        const computers = await dueDates(prisma, {}, now, cursor);
+        for (const { id, organizationId, notice, due } of computers) {
+          // The deletion keeps the date the email gave, unless something since moved it later.
+          if (notice?.warnedAt && notice.deleteAfter && due && due.at <= notice.deleteAfter) {
+            if (notice.deleteAfter <= now && !signal.aborted)
+              await removeHome(prisma, id).catch(deps.onError);
+            continue;
+          }
+          const warnable = due && due.at.getTime() <= now.getTime() + WARNING_DAYS * DAY_MS;
+          if (notice && (notice.warnedAt || !warnable))
+            await prisma.homeDeletionNotice.deleteMany({ where: { computerId: id } });
+          if (!warnable) continue;
+          const key = `${organizationId}:${due.reason}`;
+          const group = warnings.get(key) ?? { organizationId, reason: due.reason, ids: [] };
+          group.ids.push(id);
+          warnings.set(key, group);
+        }
+        if (computers.length < BATCH) break;
+        cursor = computers.at(-1)?.id;
+      }
+      // One at a time: a burst would trip the email provider's rate limit.
+      for (const group of warnings.values()) {
+        if (signal.aborted) return;
+        await warn(deps, group).catch(deps.onError);
+      }
+    });
+}
+
+/**
+ * Each matching computer with a stored home and the date it is due for deletion now. A computer
+ * that is running or starting counts as used now.
+ */
+async function dueDates(db: Db, where: Prisma.ComputerWhereInput, now: Date, cursor?: string) {
+  const computers = await db.computer.findMany({
+    // Paging by id, not a Prisma cursor: a computer cleared on this page no longer matches, and a
+    // cursor's skip would then pass over the next one.
+    where: { AND: [where, candidate, cursor ? { id: { gt: cursor } } : {}] },
+    select: {
+      id: true,
+      state: true,
+      space: {
+        select: {
+          organizationId: true,
+          organization: {
+            select: {
+              billing: {
+                select: {
+                  status: true,
+                  paidAt: true,
+                  endedAt: true,
+                  currentPeriodEndsAt: true,
+                  updatedAt: true,
+                },
+              },
+              modelCredits: {
+                select: {
+                  mode: true,
+                  balanceMicros: true,
+                  byokFreeUntil: true,
+                  lots: { select: { createdAt: true }, orderBy: { createdAt: "desc" }, take: 1 },
+                },
+              },
+            },
+          },
+        },
+      },
+      homeDeletionNotice: { select: { warnedAt: true, deleteAfter: true } },
+    },
+    orderBy: { id: "asc" },
+    take: BATCH,
+  });
+  // Only computers that could be due need their history read.
+  const used = await lastUsed(
+    db,
+    computers
+      .filter(
+        (computer) =>
+          IDLE_STATES.includes(computer.state) && !planIsLive(computer.space.organization, now),
+      )
+      .map((computer) => computer.id),
+  );
+  return computers.map((computer) => {
+    const usedAt = used.get(computer.id);
+    return {
+      id: computer.id,
+      organizationId: computer.space.organizationId,
+      notice: computer.homeDeletionNotice,
+      due: usedAt ? homeDeletionDue(computer.space.organization, usedAt, now) : null,
+    };
+  });
+}
+
+/**
+ * The latest of each computer's creation, its last save, its bots' latest runs, and its latest
+ * running stretch.
+ * Each lookup reads one index entry, so the cost does not grow with run history.
+ */
+async function lastUsed(db: Db, ids: string[]) {
+  if (!ids.length) return new Map<string, Date>();
+  const rows = await db.$queryRaw<Array<{ id: string; at: Date }>>`
+    SELECT c.id, GREATEST(
+      c."createdAt",
+      c."homeRevisionAt",
+      (SELECT max((SELECT max(r."createdAt") FROM runs r WHERE r."botId" = b.id))
+        FROM bots b WHERE b."computerId" = c.id),
+      (SELECT GREATEST(s."startedAt", s."endedAt", s."lastSeenAt") FROM computer_runs s
+        WHERE s."computerId" = c.id ORDER BY s."startedAt" DESC LIMIT 1)
+    ) AS at
+    FROM computers c WHERE c.id IN (${Prisma.join(ids)})`;
+  return new Map(rows.map((row) => [row.id, row.at]));
+}
+
+/**
+ * The date a warning sent at `sentAt` names, and when deletion may start: once that date has
+ * ended in every time zone.
+ */
+export function deletionDates(sentAt: Date) {
+  const shown = new Date(addDays(sentAt, WARNING_DAYS).setUTCHours(0, 0, 0, 0));
+  return { shown, deleteAfter: addDays(shown, 2) };
+}
+
+/**
+ * Emails the organization's first owner, the one who can pay, once for all its computers still
+ * due for the same reason. One process emails an organization at a time; another skips it until
+ * the next sweep. A crash after sending and before recording it sends again once the lease
+ * lapses, so nothing is deleted unwarned.
+ */
+async function warn(deps: HomeRetentionDeps, group: Warning) {
+  const { prisma } = deps;
+  await prisma.homeDeletionNotice.createMany({
+    data: group.ids.map((computerId) => ({ computerId })),
+    skipDuplicates: true,
+  });
+  await withLease(
+    prisma,
+    `home-deletion-notice:${group.organizationId}`,
+    { ttlMs: LEASE_MS },
+    async (lease) => {
+      const underLease = <R>(write: (tx: Prisma.TransactionClient) => Promise<R>) =>
+        prisma.$transaction(async (tx) => {
+          await assertLeaseHeld(tx, lease);
+          return write(tx);
+        });
+      // Read again now that the lease holds them: a plan or use since the scan cancels.
+      const sentAt = new Date();
+      const { shown, deleteAfter } = deletionDates(sentAt);
+      const due: string[] = [];
+      for (let cursor: string | undefined; ; ) {
+        const page = await dueDates(
+          prisma,
+          { id: { in: group.ids }, homeDeletionNotice: { warnedAt: null } },
+          sentAt,
+          cursor,
+        );
+        for (const computer of page)
+          if (computer.due?.reason === group.reason && computer.due.at <= deleteAfter)
+            due.push(computer.id);
+        if (page.length < BATCH) break;
+        cursor = page.at(-1)?.id;
+      }
+      await underLease((tx) =>
+        tx.homeDeletionNotice.deleteMany({
+          where: { computerId: { in: group.ids, notIn: due }, warnedAt: null },
+        }),
+      );
+      const owner = due.length
+        ? await prisma.member.findFirst({
+            where: { organizationId: group.organizationId, role: { contains: "owner" } },
+            orderBy: { createdAt: "asc" },
+            select: { user: { select: { email: true, name: true, locale: true } } },
+          })
+        : null;
+      const user = owner?.user;
+      if (!user) {
+        if (due.length)
+          getLogger().warn("home.retention.no_recipient", {
+            "organization.id": group.organizationId,
+            "home.retention.reason": group.reason,
+            "home.retention.computers": due.length,
+          });
+        return;
+      }
+      lease.signal.throwIfAborted();
+      await deps.email.send(
+        await homeDeletionEmail(user, shown, group.reason, deps.appUrl, emailLocale(user.locale)),
+      );
+      await underLease((tx) =>
+        tx.homeDeletionNotice.updateMany({
+          where: { computerId: { in: due }, warnedAt: null },
+          data: { warnedAt: sentAt, deleteAfter },
+        }),
+      );
+    },
+  ).catch((error: unknown) => {
+    // Another process is emailing this organization; the next sweep finds what it leaves.
+    if (!(error instanceof LeaseHeldError)) throw error;
+  });
+}
+
+/**
+ * Clears the computer's stored home in one transaction that locks the computer and its notice
+ * and reads eligibility again, so a start, a run or a plan that lands first cancels it. It also
+ * locks the organization's billing and credit rows, and the organization row itself, which a new
+ * billing or credit account's foreign key check waits on, so a payment either lands before the
+ * read or waits for the deletion to commit.
+ */
+async function removeHome(prisma: PrismaClient, computerId: string) {
+  const removed = await prisma.$transaction(async (tx) => {
+    const [locked] = await tx.$queryRaw<Array<{ organizationId: string }>>`
+      SELECT s."organizationId" FROM computers c
+      JOIN home_deletion_notices n ON n."computerId" = c.id
+      JOIN spaces s ON s.id = c."spaceId"
+      WHERE c.id = ${computerId} FOR UPDATE OF c, n`;
+    if (!locked) return false;
+    const { organizationId } = locked;
+    await tx.$queryRaw`SELECT id FROM organization WHERE id = ${organizationId} FOR UPDATE`;
+    await tx.$queryRaw`
+      SELECT "organizationId" FROM billing_accounts WHERE "organizationId" = ${organizationId}
+      FOR SHARE`;
+    await tx.$queryRaw`
+      SELECT "organizationId" FROM model_credit_accounts
+      WHERE "organizationId" = ${organizationId} FOR SHARE`;
+    const now = new Date();
+    const [computer] = await dueDates(
+      tx,
+      { id: computerId, state: { in: IDLE_STATES }, maintenanceId: null },
+      now,
+    );
+    const notice = computer?.notice;
+    if (
+      !computer?.due ||
+      !notice?.warnedAt ||
+      !notice.deleteAfter ||
+      notice.deleteAfter > now ||
+      computer.due.at > notice.deleteAfter
+    )
+      return false;
+    await tx.computer.update({
+      where: { id: computerId },
+      data: {
+        homeStorageId: null,
+        homeStorageKey: null,
+        homeStorageRevision: null,
+        homeRevision: "empty",
+        homeRevisionAt: null,
+      },
+    });
+    await tx.computerHomeVersion.deleteMany({ where: { computerId } });
+    await tx.homeDeletionNotice.delete({ where: { computerId } });
+    return true;
+  });
+  if (removed) getLogger().info("home.retention.deleted", { "computer.id": computerId });
+}
+
+function addDays(date: Date, days: number) {
+  return new Date(date.getTime() + days * DAY_MS);
+}
+
+function latest(a: Date, b: Date) {
+  return a > b ? a : b;
+}
