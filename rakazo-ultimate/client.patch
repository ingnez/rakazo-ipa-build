+import { ph, t } from "@lingui/core/macro";
+import type {
+  UsageBotBreakdown,
+  UsageDeskBreakdown,
+  UsageDetailCall,
+  UsageDetailWindow,
+  UsageModelBreakdown,
+} from "@rakazo/contracts";
+import { USAGE_DETAIL_DEFAULT_WINDOW, USAGE_DETAIL_WINDOWS } from "@rakazo/contracts";
+import { useQuery } from "@tanstack/react-query";
+import { useFocusEffect } from "expo-router";
+import { useCallback, useState } from "react";
+import {
+  ActivityIndicator,
+  Pressable,
+  RefreshControl,
+  ScrollView,
+  StyleSheet,
+  Text,
+  View,
+} from "react-native";
+import { SafeAreaView } from "react-native-safe-area-context";
+import { NativeSegmentedControl } from "../../components/native-segmented-control";
+import { Chevron } from "../../components/row-accessories";
+import { SettingsGroup, SettingsLabel, useStackedSettings } from "../../components/settings-group";
+import { mobileTokens } from "../../lib/appearance";
+import { useDateLocale } from "../../lib/i18n";
+import { native, useMobileTokens, useThemedStyles } from "../../lib/native";
+import { accountRpcQuery, queryClient } from "../../lib/query";
+import { useSideInsets } from "../../lib/side-insets";
+import type { UsageTag, UsageTagKey } from "../../lib/usage-display";
+import {
+  formatCompactTokens,
+  formatCount,
+  formatElapsed,
+  formatExactTokens,
+  formatPercent,
+  formatWindowRange,
+  modelLabel,
+  thinkingLabel,
+  usageTags,
+} from "../../lib/usage-display";
+import { errorText } from "../../lib/user-error";
+
+/**
+ * What the Bot has spent over one rolling window, told apart by who it was working for: the front
+ * desk that answers the person, the back office that does the work handed to it, and the routines,
+ * reports and context tidying that are neither. The window is chosen at the top, and every figure
+ * below it covers that window alone.
+ */
+
+/** The count of recent calls the page asks for; the totals above cover the whole window. */
+const RECENT_CALLS = 50;
+
+/** The three sides of the split, in the order the page reads them. */
+const DESK_GROUPS = ["front_desk", "backoffice", "other"] as const;
+
+/** The words a window is offered under, shortest first. */
+const WINDOW_LABELS: Record<UsageDetailWindow, () => string> = {
+  "1h": () => t`1 小时`,
+  "6h": () => t`6 小时`,
+  "24h": () => t`24 小时`,
+  "7d": () => t`7 天`,
+  "30d": () => t`30 天`,
+};
+
+const DESK_LABELS: Record<(typeof DESK_GROUPS)[number], () => string> = {
+  front_desk: () => t`前台模型（对话 / 语音）`,
+  backoffice: () => t`后台模型（执行任务）`,
+  other: () => t`其他（汇报 / 定时 / 整理）`,
+};
+
+const DESK_FOOTERS: Record<(typeof DESK_GROUPS)[number], () => string> = {
+  front_desk: () => t`回答你、接你电话用的模型。`,
+  backoffice: () => t`接手你交出去的活、在后台干活的模型。`,
+  other: () => t`定时任务、后台回话和上下文整理用掉的量。`,
+};
+
+export default function UsageScreen() {
+  const locale = useDateLocale();
+  const sideInsets = useSideInsets();
+  const stacked = useStackedSettings();
+  const tokens = useMobileTokens();
+  const styles = useThemedStyles(createStyles);
+  const [window, setWindow] = useState<UsageDetailWindow>(USAGE_DETAIL_DEFAULT_WINDOW);
+  const [openCall, setOpenCall] = useState<string | null>(null);
+  const [refreshing, setRefreshing] = useState(false);
+
+  const read = accountRpcQuery("usage/details", { window, limit: RECENT_CALLS });
+  const { data, error: failure, isLoading, refetch } = useQuery(read, queryClient);
+  const error = failure ? errorText(failure, t`读取用量失败`) : null;
+  const details = data?.summary ? data : null;
+
+  // The window keeps moving, and calls keep arriving, so a visit reads it again.
+  useFocusEffect(
+    useCallback(() => {
+      void refetch();
+    }, [refetch]),
+  );
+
+  async function refresh() {
+    setRefreshing(true);
+    await refetch();
+    setRefreshing(false);
+  }
+
+  const number = new Intl.NumberFormat(locale);
+  const timeOf = (iso: string) => {
+    const date = new Date(iso);
+    if (Number.isNaN(date.getTime())) return "";
+    const stamp = new Intl.DateTimeFormat(locale, {
+      ...(date.toDateString() === new Date().toDateString()
+        ? { hour: "2-digit", minute: "2-digit", second: "2-digit" }
+        : { month: "2-digit", day: "2-digit", hour: "2-digit", minute: "2-digit" }),
+      hour12: false,
+    });
+    return stamp.format(date);
+  };
+
+  const tagLabels: Record<UsageTagKey, string> = {
+    front_desk: t`前台`,
+    backoffice: t`后台`,
+    routine: t`定时`,
+    voice: t`语音`,
+    compaction: t`压缩`,
+    other_desk: t`其他`,
+    retry: t`重试`,
+    failed: t`失败`,
+  };
+  const toneOf = (tone: UsageTag["tone"]) =>
+    tone === "danger"
+      ? tokens.destructive
+      : tone === "warning"
+        ? tokens.warning
+        : native.secondaryLabel;
+
+  /** One figure with its name under it, in the two-column grid a card of numbers is read from. */
+  const chart = (cells: { label: string; value: string }[]) => (
+    <View style={styles.grid}>
+      {cells.map((cell) => (
+        <View key={cell.label} style={styles.cell}>
+          <Text numberOfLines={1} style={styles.cellValue}>
+            {cell.value}
+          </Text>
+          <Text numberOfLines={1} style={styles.cellLabel}>
+            {cell.label}
+          </Text>
+        </View>
+      ))}
+    </View>
+  );
+
+  /** One model's share of a desk: what it spent, how it cached and how fast it answered. */
+  const modelRow = (model: UsageModelBreakdown) => (
+    <View key={`${model.provider}:${model.model}`} style={styles.modelRow}>
+      <View style={styles.modelHeading}>
+        <Text numberOfLines={1} style={styles.modelName}>
+          {modelLabel(model.model)}
+        </Text>
+        <Text style={styles.modelTotal}>{formatCompactTokens(model.totalTokens)}</Text>
+      </View>
+      <Text style={styles.modelMeta}>
+        {t`${ph({ calls: formatCount(model.calls) })} 次调用 · 思考 ${ph({ thinking: formatCompactTokens(model.reasoningTokens) })} · 缓存 ${ph({ cache: formatPercent(model.cacheHitRate) })}`}
+      </Text>
+      <Text style={styles.modelMeta}>
+        {t`首字 ${ph({ first: formatElapsed(model.avgFirstResponseMs) })} · 总耗时 ${ph({ duration: formatElapsed(model.avgDurationMs) })}`}
+      </Text>
+    </View>
+  );
+
+  /** One bot's window, with how its calls split between the two desks. */
+  const botRow = (bot: UsageBotBreakdown) => (
+    <View key={bot.botId} style={styles.modelRow}>
+      <View style={styles.modelHeading}>
+        <Text numberOfLines={1} style={styles.modelName}>
+          {bot.botName ?? t`未命名 Bot`}
+        </Text>
+        <Text style={styles.modelTotal}>{formatCompactTokens(bot.totalTokens)}</Text>
+      </View>
+      <Text style={styles.modelMeta}>
+        {t`${ph({ calls: formatCount(bot.calls) })} 次调用 · 前台 ${ph({ front: formatCount(bot.frontDeskCalls) })} · 后台 ${ph({ back: formatCount(bot.backofficeCalls) })} · 缓存 ${ph({ cache: formatPercent(bot.cacheHitRate) })}`}
+      </Text>
+      <Text style={styles.modelMeta}>
+        {t`首字 ${ph({ first: formatElapsed(bot.avgFirstResponseMs) })} · 总耗时 ${ph({ duration: formatElapsed(bot.avgDurationMs) })}`}
+      </Text>
+    </View>
+  );
+
+  /** One recorded call: what it was and what it cost, opening into its own exact figures. */
+  const callRow = (call: UsageDetailCall) => {
+    const open = openCall === call.id;
+    const tags = usageTags(call);
+    const thinking = thinkingLabel(call.thinkingLevel);
+    const exact = [
+      { label: t`输入`, value: formatExactTokens(call.inputTokens) },
+      { label: t`输出`, value: formatExactTokens(call.outputTokens) },
+      { label: t`思考`, value: formatExactTokens(call.reasoningTokens) },
+      { label: t`缓存读`, value: formatExactTokens(call.cacheReadTokens) },
+      { label: t`缓存写`, value: formatExactTokens(call.cacheWriteTokens) },
+      { label: t`总计`, value: formatExactTokens(call.totalTokens) },
+    ];
+    return (
+      <View key={call.id}>
+        <Pressable
+          accessibilityHint={open ? t`收起这条调用的细项` : t`展开这条调用的细项`}
+          accessibilityLabel={`${call.botName ?? t`未命名 Bot`} · ${modelLabel(call.model)}`}
+          accessibilityRole="button"
+          accessibilityState={{ expanded: open }}
+          onPress={() => setOpenCall(open ? null : call.id)}
+          style={({ pressed }) => [styles.callRow, pressed && styles.pressed]}
+        >
+          <View style={styles.callHeading}>
+            <Text numberOfLines={1} style={styles.callTitle}>
+              {call.botName ?? t`未命名 Bot`} · {modelLabel(call.model)}
+            </Text>
+            <Text style={styles.callTime}>{timeOf(call.createdAt)}</Text>
+            <Chevron expanded={open} />
+          </View>
+          <View style={styles.tagLine}>
+            {tags.map((tag) => (
+              <Text key={tag.key} style={[styles.tag, { color: toneOf(tag.tone) }]}>
+                {tagLabels[tag.key]}
+              </Text>
+            ))}
+            {thinking ? <Text style={styles.tag}>{t`思考 ${ph({ level: thinking })}`}</Text> : null}
+          </View>
+          <Text style={styles.callMeta}>
+            {t`总 ${ph({ total: formatCompactTokens(call.totalTokens) })} · 思考 ${ph({ thinking: formatCompactTokens(call.reasoningTokens) })} · 缓存 ${ph({ cache: formatPercent(cacheRateOf(call)) })}`}
+          </Text>
+          <Text style={styles.callMeta}>
+            {t`排队 ${ph({ queue: formatElapsed(call.queueWaitMs) })} · 首字 ${ph({ first: formatElapsed(call.firstResponseMs) })} · 总耗时 ${ph({ duration: formatElapsed(call.durationMs) })}`}
+          </Text>
+        </Pressable>
+        {open ? (
+          <View style={styles.callDetail}>
+            {exact.map((pair) => (
+              <View key={pair.label} style={styles.detailRow}>
+                <Text style={styles.detailLabel}>{pair.label}</Text>
+                <Text style={styles.detailValue}>{pair.value}</Text>
+              </View>
+            ))}
+            <View style={styles.detailRow}>
+              <Text style={styles.detailLabel}>{t`运行状态`}</Text>
+              <Text style={styles.detailValue}>{statusLabel(call.status)}</Text>
+            </View>
+            <View style={styles.detailRow}>
+              <Text style={styles.detailLabel}>{t`发起方式`}</Text>
+              <Text style={styles.detailValue}>{triggerLabel(call.trigger)}</Text>
+            </View>
+            {call.error ? (
+              <Text accessibilityRole="alert" style={styles.detailError}>
+                {call.error}
+              </Text>
+            ) : null}
+          </View>
+        ) : null}
+      </View>
+    );
+  };
+
+  return (
+    <SafeAreaView edges={["bottom"]} style={styles.screen}>
+      <ScrollView
+        style={sideInsets}
+        contentContainerStyle={[styles.content, stacked && styles.compactContent]}
+        contentInsetAdjustmentBehavior="automatic"
+        refreshControl={<RefreshControl refreshing={refreshing} onRefresh={refresh} />}
+      >
+        <View accessibilityLabel={t`时间范围`} style={styles.section}>
+          <SettingsLabel>{t`时间范围`}</SettingsLabel>
+          <NativeSegmentedControl
+            accessibilityLabel={t`时间范围`}
+            onChange={(next) => {
+              setOpenCall(null);
+              setWindow(next);
+            }}
+            options={USAGE_DETAIL_WINDOWS.map((value) => ({
+              value,
+              label: WINDOW_LABELS[value](),
+            }))}
+            value={window}
+          />
+        </View>
+
+        {error ? (
+          <Text accessibilityRole="alert" style={styles.error}>
+            {error}
+          </Text>
+        ) : null}
+
+        {isLoading && !details ? (
+          <View style={styles.loading}>
+            <ActivityIndicator />
+          </View>
+        ) : null}
+
+        {details ? (
+          <>
+            <SettingsGroup
+              label={t`总览`}
+              footer={
+                formatWindowRange(
+                  details.window,
+                  details.since,
+                  details.until,
+                  locale,
+                ) || undefined
+              }
+            >
+              {chart([
+                { label: t`运行次数`, value: formatCount(details.summary.runs) },
+                { label: t`调用次数`, value: formatCount(details.summary.calls) },
+                { label: t`总 Token`, value: formatCompactTokens(details.summary.totalTokens) },
+                {
+                  label: t`思考 Token`,
+                  value: formatCompactTokens(details.summary.reasoningTokens),
+                },
+                { label: t`输入 Token`, value: formatCompactTokens(details.summary.inputTokens) },
+                { label: t`输出 Token`, value: formatCompactTokens(details.summary.outputTokens) },
+                { label: t`缓存命中率`, value: formatPercent(details.summary.cacheHitRate) },
+                {
+                  label: t`缓存已省`,
+                  value: formatCompactTokens(details.summary.cacheReadTokens),
+                },
+              ])}
+            </SettingsGroup>
+
+            {DESK_GROUPS.map((group) => {
+              const desk: UsageDeskBreakdown =
+                group === "front_desk"
+                  ? details.byDesk.frontDesk
+                  : group === "backoffice"
+                    ? details.byDesk.backoffice
+                    : details.byDesk.other;
+              if (!desk.calls && !desk.runs) return null;
+              return (
+                <SettingsGroup
+                  key={group}
+                  label={DESK_LABELS[group]()}
+                  footer={DESK_FOOTERS[group]()}
+                >
+                  {chart([
+                    { label: t`调用次数`, value: formatCount(desk.calls) },
+                    { label: t`运行次数`, value: formatCount(desk.runs) },
+                    { label: t`总 Token`, value: formatCompactTokens(desk.totalTokens) },
+                    { label: t`缓存命中率`, value: formatPercent(desk.cacheHitRate) },
+                    { label: t`平均首字`, value: formatElapsed(desk.avgFirstResponseMs) },
+                    { label: t`平均总耗时`, value: formatElapsed(desk.avgDurationMs) },
+                  ])}
+                  {desk.models.map((model) => modelRow(model))}
+                </SettingsGroup>
+              );
+            })}
+
+            {details.byBot.length ? (
+              <SettingsGroup
+                label={t`按 Bot 统计`}
+                footer={t`这个时间段里每个 Bot 自己花掉的调用与 Token。`}
+              >
+                {details.byBot.map((bot) => botRow(bot))}
+              </SettingsGroup>
+            ) : null}
+
+            {details.records.length ? (
+              <SettingsGroup
+                label={t`最近调用`}
+                footer={t`最近 ${ph({ count: number.format(RECENT_CALLS) })} 次调用，点一条看它自己的细项。`}
+              >
+                {details.records.map((call) => callRow(call))}
+              </SettingsGroup>
+            ) : null}
+
+            {!details.summary.calls ? (
+              <Text style={styles.empty}>{t`这个时间段还没有产生用量。`}</Text>
+            ) : null}
+          </>
+        ) : null}
+      </ScrollView>
+    </SafeAreaView>
+  );
+}
+
+/** The share of one call's prompt that came from the cache, on the same rule the server uses. */
+function cacheRateOf(call: UsageDetailCall): number | null {
+  const prompt = call.inputTokens + call.cacheReadTokens;
+  if (prompt <= 0) return null;
+  return call.cacheReadTokens / prompt;
+}
+
+/** A run's own word for who started it, in the words the page is read in. */
+function triggerLabel(trigger: string | null): string {
+  switch (trigger) {
+    case "user":
+      return t`你发来的消息`;
+    case "call_end":
+      return t`通话结束`;
+    case "routine":
+      return t`定时任务`;
+    case "backoffice":
+      return t`后台接手`;
+    case "follow_up":
+      return t`追问`;
+    case "reaction":
+      return t`表情回应`;
+    case "messaging":
+      return t`聊天应用`;
+    case "webhook":
+      return t`网页钩子`;
+    case "skill":
+      return t`技能`;
+    default:
+      return trigger ?? t`未记录`;
+  }
+}
+
+function statusLabel(status: string | null): string {
+  switch (status) {
+    case "completed":
+      return t`已完成`;
+    case "failed":
+    case "error":
+      return t`失败`;
+    case "running":
+      return t`进行中`;
+    case "canceled":
+      return t`已取消`;
+    default:
+      return status ?? t`未记录`;
+  }
+}
