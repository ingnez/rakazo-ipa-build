@@ -0,0 +1,252 @@
+import type { PhoneConnectorKind, PhoneConnectorState, PhoneDeviceMethod } from "@rakazo/contracts";
+import { currentApiBase } from "./api";
+import {
+  anyPhoneConnectorOn,
+  forgetPhoneDeviceCredential,
+  loadPhoneConnectorState,
+  loadPhoneDeviceCredential,
+  phoneConnectorForMethod,
+  phoneConnectorsNative,
+  phoneDeviceErrorMessage,
+  runPhoneDeviceMethod,
+} from "./phone-connectors";
+import { openRealtimeSocket } from "./realtime-socket";
+
+/**
+ * The phone's socket to the server: the only way a bot's tool reaches this handset.
+ *
+ * The phone dials out, says nothing it was not asked, and answers one request at a time with the
+ * device socket's own frames. It stays open only while a switch is on; signing out or a revoke
+ * closes it and the next launch pairs again.
+ */
+export type PhoneSocketStatus = "off" | "connecting" | "connected" | "unavailable";
+
+export type PhoneSocketDeps = {
+  /** The server's address right now. */
+  apiBase(): string;
+  credential(): Promise<{ token: string } | null>;
+  /** The five switches, read fresh for every request. */
+  state(): Promise<PhoneConnectorState>;
+  permissionOf(
+    kind: PhoneConnectorKind,
+  ): Promise<"granted" | "denied" | "undetermined" | "unavailable">;
+  openSocket: typeof openRealtimeSocket;
+  /** Retry waits, in milliseconds; the first is used for the first failure. */
+  retryMs?: { min: number; max: number };
+  setTimer?: (run: () => void, ms: number) => unknown;
+  clearTimer?: (handle: unknown) => void;
+  onStatus?: (status: PhoneSocketStatus) => void;
+  onRevoked?: () => void;
+};
+
+type ServerMessage =
+  | { type: "request"; id: string; request: { method: string; [key: string]: unknown } }
+  | { type: "cancel"; id: string }
+  | { type: "revoked"; reason?: string };
+
+/** The socket's address for a server: the same host, the device path, over the same security. */
+export function phoneSocketUrl(apiBase: string): string {
+  const url = new URL("/api/devices/connect", apiBase);
+  url.protocol = url.protocol === "https:" ? "wss:" : "ws:";
+  return url.toString();
+}
+
+/** A request as the server writes it: the method, and everything else as arguments. */
+export function phoneRequestArgs(request: Record<string, unknown>): Record<string, unknown> {
+  const { method: _method, botId: _botId, runId: _runId, ...args } = request;
+  return args;
+}
+
+/** One socket, from `start` to the first close it cannot recover from. */
+export class PhoneConnectorSocket {
+  private socket: { send(data: string): void; close(): void } | undefined;
+  private stopped = true;
+  private attempt = 0;
+  private timer: unknown;
+  private status: PhoneSocketStatus = "off";
+  private cancelled = new Set<string>();
+
+  constructor(private readonly deps: PhoneSocketDeps) {}
+
+  get current(): PhoneSocketStatus {
+    return this.status;
+  }
+
+  /** Opens the socket if a switch is on and the phone is paired; otherwise stays off. */
+  async start(): Promise<void> {
+    if (!this.stopped) return;
+    const state = await this.deps.state();
+    if (!anyPhoneConnectorOn(state)) {
+      this.setStatus("off");
+      return;
+    }
+    const credential = await this.deps.credential();
+    if (!credential) {
+      // Paired the first time a switch went on; a missing token means that never completed.
+      this.setStatus("unavailable");
+      return;
+    }
+    this.stopped = false;
+    this.connect(credential.token);
+  }
+
+  stop(): void {
+    this.stopped = true;
+    this.cancelled.clear();
+    if (this.timer !== undefined) {
+      this.deps.clearTimer?.(this.timer);
+      this.timer = undefined;
+    }
+    const socket = this.socket;
+    this.socket = undefined;
+    try {
+      socket?.close();
+    } catch {
+      // Already closed.
+    }
+    this.setStatus("off");
+  }
+
+  /** After a switch changes: opens, closes or stays as the five switches now say. */
+  async refresh(): Promise<void> {
+    const state = await this.deps.state();
+    if (!anyPhoneConnectorOn(state)) {
+      this.stop();
+      return;
+    }
+    if (this.stopped) await this.start();
+  }
+
+  private setStatus(status: PhoneSocketStatus) {
+    if (this.status === status) return;
+    this.status = status;
+    this.deps.onStatus?.(status);
+  }
+
+  private scheduleRetry() {
+    if (this.stopped) return;
+    const retry = this.deps.retryMs ?? { min: 1_000, max: 30_000 };
+    const ceiling = Math.min(retry.max, retry.min * 2 ** this.attempt);
+    this.attempt += 1;
+    const wait = Math.round(retry.min / 2 + Math.random() * ceiling);
+    const setTimer = this.deps.setTimer ?? ((run, ms) => setTimeout(run, ms));
+    this.timer = setTimer(() => {
+      this.timer = undefined;
+      void this.reconnect();
+    }, wait);
+  }
+
+  private async reconnect() {
+    if (this.stopped) return;
+    const credential = await this.deps.credential();
+    if (!credential) {
+      this.stopped = true;
+      this.setStatus("unavailable");
+      return;
+    }
+    this.connect(credential.token);
+  }
+
+  private connect(token: string) {
+    this.setStatus("connecting");
+    const url = phoneSocketUrl(this.deps.apiBase());
+    this.socket = this.deps.openSocket(
+      url,
+      { authorization: `Bearer ${token}` },
+      {
+        onOpen: () => {
+          this.attempt = 0;
+          this.setStatus("connected");
+        },
+        onMessage: (data) => {
+          if (typeof data === "string") void this.receive(data);
+        },
+        onError: () => undefined,
+        onClose: () => {
+          this.socket = undefined;
+          if (this.stopped) return;
+          this.setStatus("connecting");
+          this.scheduleRetry();
+        },
+      },
+    );
+  }
+
+  /** One message from the server: a request to run, a cancel, or the end of this pairing. */
+  private async receive(raw: string) {
+    let message: ServerMessage;
+    try {
+      message = JSON.parse(raw) as ServerMessage;
+    } catch {
+      return;
+    }
+    if (message.type === "revoked") {
+      this.stopped = true;
+      await forgetPhoneDeviceCredential();
+      this.deps.onRevoked?.();
+      this.setStatus("off");
+      return;
+    }
+    if (message.type === "cancel") {
+      this.cancelled.add(message.id);
+      return;
+    }
+    if (message.type !== "request" || typeof message.id !== "string") return;
+    const method = message.request?.method;
+    if (typeof method !== "string") return;
+    await this.answer(message.id, method, phoneRequestArgs(message.request));
+  }
+
+  private async answer(id: string, method: string, args: Record<string, unknown>) {
+    const socket = this.socket;
+    if (!socket) return;
+    // A request the person switched off since it was sent is refused by the phone itself.
+    const kind = phoneConnectorForMethod(method);
+    const state = await this.deps.state();
+    const permission = kind ? await this.deps.permissionOf(kind) : "granted";
+    const answer = await runPhoneDeviceMethod(method as PhoneDeviceMethod, args, {
+      state,
+      native: phoneConnectorsNative(),
+      permissionOf: () => permission,
+    });
+    if (this.cancelled.delete(id)) return;
+    if (answer.error) {
+      socket.send(
+        JSON.stringify({
+          type: "frame",
+          id,
+          frame: { error: phoneDeviceErrorMessage(answer.error, kind) },
+        }),
+      );
+      socket.send(JSON.stringify({ type: "frame", id, frame: { done: true } }));
+      return;
+    }
+    socket.send(JSON.stringify({ type: "frame", id, frame: { value: answer.value } }));
+    socket.send(JSON.stringify({ type: "frame", id, frame: { done: true } }));
+  }
+}
+
+let phoneSocket: PhoneConnectorSocket | null = null;
+
+/** The app's one phone socket, opened on demand by the settings screen and the app's launch. */
+export function phoneConnectorSocket(): PhoneConnectorSocket {
+  if (!phoneSocket) {
+    const native = phoneConnectorsNative();
+    phoneSocket = new PhoneConnectorSocket({
+      apiBase: currentApiBase,
+      credential: async () => {
+        const stored = await loadPhoneDeviceCredential();
+        return stored ? { token: stored.token } : null;
+      },
+      state: loadPhoneConnectorState,
+      permissionOf: async (kind) => (native ? native.permission(kind) : "unavailable"),
+      openSocket: openRealtimeSocket,
+    });
+  }
+  return phoneSocket;
+}
+
+/** Starts the socket if a switch is already on; safe to call on every launch and focus. */
+export async function resumePhoneConnectorSocket(): Promise<void> {
+  await phoneConnectorSocket().refresh();
+}
