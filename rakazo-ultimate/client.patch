+              fan={cardPose(fanCards, index, box)}
+              fanned={fanned}
+              focused={focused}
+              index={index}
+              onRetry={onRetry}
+            />
+          ))}
+        </Animated.View>
+      </GestureDetector>
+      {caption ? (
+        <View style={styles.captionRow}>
+          <Text style={[styles.caption, { color: tokens.mutedForeground }]}>{caption}</Text>
+        </View>
+      ) : null}
+    </View>
+  );
+}
+
+function ImageViewerIndexSafe(index: number, count: number): number {
+  return Math.max(0, Math.min(index, Math.max(count - 1, 0)));
+}
+
+/** Loads artifact previews and renders them as a stack in a chat bubble. */
+export function MessageImageStack({
+  items,
+  threadTarget,
+  alignment,
+  onOpen,
+}: {
+  items: readonly MessageImageItem[];
+  threadTarget: MobileArtifactTarget;
+  alignment?: "leading" | "trailing";
+  onOpen: (index: number) => void;
+}) {
+  const [uris, setUris] = useState<Record<string, string>>({});
+  const botId = "botId" in threadTarget ? threadTarget.botId : undefined;
+  const groupId = "groupId" in threadTarget ? threadTarget.groupId : undefined;
+  const ids = items.map((item) => item.artifactId).join("|");
+
+  // Each picture loads on its own and shows the moment it lands: a stack of four used to wait
+  // for all four, so one slow picture kept every card a grey box.
+  useEffect(() => {
+    let cancelled = false;
+    const target: MobileArtifactTarget = botId !== undefined ? { botId } : { groupId: groupId! };
+    for (const item of items) {
+      void imageArtifactPreview(target, item.artifactId, item.mimeType)
+        .then((loaded) => {
+          if (cancelled || !loaded.uri) return;
+          setUris((current) =>
+            current[item.artifactId] === loaded.uri
+              ? current
+              : { ...current, [item.artifactId]: loaded.uri },
+          );
+        })
+        .catch(() => {
+          // A picture that will not load keeps its tile; opening it reports the error.
+        });
+    }
+    return () => {
+      cancelled = true;
+    };
+    // item identities are listed in `ids`.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [botId, groupId, ids]);
+
+  const sources = items.map((item) => ({
+    id: item.artifactId,
+    uri: uris[item.artifactId],
+    name: item.name,
+    upload: item.upload,
+  }));
+
+  return <ImageCardStack sources={sources} alignment={alignment} onOpen={onOpen} />;
+}
