+import { StyleSheet, useWindowDimensions, View } from "react-native";
+import Animated, { FadeIn, SlideInDown, SlideOutDown } from "react-native-reanimated";
+import { useSafeAreaInsets } from "react-native-safe-area-context";
+import { SearchSheetScreen } from "../app/search";
+import { mobileTokens } from "../lib/appearance";
+import { SHEET_DETENT, SHEET_FADE_MS } from "./sand";
+
+/** Above the home page's own rows and its floating bar, so nothing of the page shows through. */
+const SEARCH_SHEET_LAYER = 2;
+
+/**
+ * Search, opened over the home page instead of beside it.
+ *
+ * The reference app does not push a search page: the sheet comes up over the inbox and the results
+ * are the inbox's own rows, filtered — so the list you were reading is still visible in the strip
+ * above, and pressing a result lands where the same row would have. Closing it is a dismissal, not
+ * a step back, so the home list never re-renders its way through history.
+ */
+export function HomeSearchSheet({ visible, onClose }: { visible: boolean; onClose: () => void }) {
+  const insets = useSafeAreaInsets();
+  const tokens = mobileTokens();
+  const height = useWindowDimensions().height;
+  // The sheet leaves the same 5% of the page above it that every other page sheet keeps.
+  const topGap = Math.round(height * (1 - SHEET_DETENT));
+  if (!visible) return null;
+  return (
+    <View
+      style={[
+        StyleSheet.absoluteFill,
+        { zIndex: SEARCH_SHEET_LAYER, elevation: SEARCH_SHEET_LAYER },
+      ]}
+      accessibilityViewIsModal
+    >
+      <Animated.View entering={FadeIn.duration(SHEET_FADE_MS)} style={styles.scrim}>
+        <View style={StyleSheet.absoluteFill} onTouchEnd={onClose} />
+      </Animated.View>
+      <Animated.View
+        entering={SlideInDown.duration(SHEET_FADE_MS)}
+        exiting={SlideOutDown.duration(SHEET_FADE_MS)}
+        accessibilityLabel="搜索"
+        style={[
+          styles.sheet,
+          {
+            marginTop: Math.max(topGap, insets.top + 12),
+            backgroundColor: tokens.background,
+          },
+        ]}
+      >
+        <SearchSheetScreen overlay onClose={onClose} topInset={-insets.top + 6} />
+      </Animated.View>
+    </View>
+  );
+}
+
+const styles = StyleSheet.create({
+  scrim: {
+    position: "absolute",
+    left: 0,
+    right: 0,
+    top: 0,
+    bottom: 0,
+    backgroundColor: "rgba(0,0,0,0.16)",
+  },
+  sheet: {
+    position: "absolute",
+    left: 0,
+    right: 0,
+    top: 0,
+    bottom: 0,
+    borderTopLeftRadius: 24,
+    borderTopRightRadius: 24,
+    borderCurve: "continuous",
+    overflow: "hidden",
+  },
+});
