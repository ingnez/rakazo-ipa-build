+import type { OpenRealtimeSocket } from "./realtime-call";
+
+type SocketWithHeaders = new (
+  url: string,
+  protocols?: string | string[] | null,
+  options?: { headers?: Record<string, string> },
+) => WebSocket;
+
+/**
+ * The call's socket, opened the way the app's RPC is: the same server, the same sign-in.
+ *
+ * React Native's WebSocket takes headers as a third argument and hands binary frames back as an
+ * ArrayBuffer, which is exactly what a call needs — the gateway's audio is raw PCM.
+ */
+export const openRealtimeSocket: OpenRealtimeSocket = (url, headers, handlers) => {
+  const Socket = WebSocket as unknown as SocketWithHeaders;
+  const socket = new Socket(url, null, { headers });
+  socket.binaryType = "arraybuffer";
+  socket.onopen = () => handlers.onOpen();
+  socket.onmessage = (event) => handlers.onMessage(event.data);
+  socket.onerror = () => handlers.onError();
+  socket.onclose = (event) => handlers.onClose({ code: event.code, reason: event.reason });
+  return {
+    send: (data) => {
+      // Only an open socket takes a frame; one still connecting drops it, and the gateway treats
+      // the missing audio as silence.
+      if (socket.readyState === 1) socket.send(data as never);
+    },
+    close: () => {
+      try {
+        socket.close();
+      } catch {
+        // Already closed.
+      }
+    },
+  };
+};
diff --git a/apps/mobile/lib/realtime-voice.ts b/apps/mobile/lib/realtime-voice.ts
