@@ -0,0 +1,197 @@
+import type { ReactNode } from "react";
+import { Pressable, StyleSheet, Text, useWindowDimensions, View } from "react-native";
+import Animated, { FadeIn, FadeOut, SlideInDown, SlideOutDown } from "react-native-reanimated";
+import { useSafeAreaInsets } from "react-native-safe-area-context";
+import { mobileTokens } from "../../lib/appearance";
+import { useThemedStyles } from "../../lib/native";
+import { NativeSymbol } from "../native-symbol";
+import {
+  GRABBER_BOTTOM_INSET,
+  GRABBER_HEIGHT,
+  GRABBER_WIDTH,
+  SHEET_CONTENT_PADDING,
+  SHEET_DETENT,
+  SHEET_FADE_MS,
+} from "./metrics";
+import type { SandPageAction } from "./sand-page";
+
+/**
+ * A page presented over another one: the sheet keeps 5% of the screen, shows its grabber above its
+ * own header, and fades its content in over 120 ms.
+ *
+ * The reference app opens every second-level page this way, so the page behind stays visible as a
+ * strip at the top — you can always tell what you are still inside. The sheet dims what it covers
+ * only while it is coming up, and a tap outside it closes it, as the same gesture would on the
+ * page itself.
+ */
+export function SandSheetPage({
+  visible,
+  onClose,
+  title,
+  subtitle,
+  closeIcon = "xmark",
+  closeLabel = "关闭",
+  action,
+  trailing,
+  body = "scroll",
+  children,
+  footer,
+  accessibilityLabel,
+}: {
+  visible: boolean;
+  onClose: () => void;
+  title?: string;
+  subtitle?: string;
+  closeIcon?: "xmark" | "chevron.left";
+  closeLabel?: string;
+  action?: SandPageAction;
+  trailing?: ReactNode;
+  body?: "scroll" | "static";
+  children: ReactNode;
+  footer?: ReactNode;
+  accessibilityLabel?: string;
+}) {
+  const styles = useThemedStyles(createSheetStyles);
+  const tokens = mobileTokens();
+  const insets = useSafeAreaInsets();
+  const height = useWindowDimensions().height;
+  if (!visible) return null;
+  return (
+    <View style={StyleSheet.absoluteFill} accessibilityViewIsModal>
+      <Animated.View entering={FadeIn.duration(SHEET_FADE_MS)} style={styles.scrim}>
+        <Pressable
+          accessibilityRole="button"
+          accessibilityLabel={closeLabel}
+          onPress={onClose}
+          style={StyleSheet.absoluteFill}
+        />
+      </Animated.View>
+      <Animated.View
+        entering={SlideInDown.duration(SHEET_FADE_MS)}
+        exiting={SlideOutDown.duration(SHEET_FADE_MS)}
+        accessibilityLabel={accessibilityLabel}
+        style={[
+          styles.sheet,
+          {
+            marginTop: Math.round(height * (1 - SHEET_DETENT)),
+            paddingBottom: Math.max(insets.bottom, 12),
+            backgroundColor: tokens.background,
+          },
+        ]}
+      >
+        <View style={styles.grabberRow}>
+          <View style={styles.grabber} />
+        </View>
+        <View style={styles.headerRow}>
+          <View style={styles.side}>
+            <Pressable
+              accessibilityRole="button"
+              accessibilityLabel={closeLabel}
+              hitSlop={10}
+              onPress={onClose}
+              style={({ pressed }) => [styles.iconButton, pressed && styles.pressed]}
+            >
+              <NativeSymbol
+                ios={closeIcon}
+                android={closeIcon === "xmark" ? "close" : "chevron-back"}
+                size={18}
+                color={tokens.foreground}
+              />
+            </Pressable>
+          </View>
+          <Text numberOfLines={1} style={styles.title}>
+            {title ?? ""}
+          </Text>
+          <View style={[styles.side, styles.sideEnd]}>
+            {trailing}
+            {action ? (
+              <Pressable
+                accessibilityRole="button"
+                accessibilityLabel={action.label}
+                accessibilityState={{ disabled: action.disabled || action.busy, busy: action.busy }}
+                disabled={action.disabled || action.busy}
+                hitSlop={8}
+                onPress={action.onPress}
+                style={({ pressed }) => [styles.action, pressed && styles.pressed]}
+              >
+                <Text
+                  style={[
+                    styles.actionLabel,
+                    (action.disabled || action.busy) && styles.actionDisabled,
+                  ]}
+                >
+                  {action.label}
+                </Text>
+              </Pressable>
+            ) : null}
+          </View>
+        </View>
+        <View style={styles.body}>{children}</View>
+        {footer ? <View style={styles.footer}>{footer}</View> : null}
+      </Animated.View>
+    </View>
+  );
+}
+
+/** The sheet's own grabber: a 48×3 bar, sitting 5 above the sheet's top edge. */
+export function SheetGrabber() {
+  const styles = useThemedStyles(createSheetStyles);
+  return (
+    <View style={styles.grabberRow}>
+      <View style={styles.grabber} />
+    </View>
+  );
+}
+
+function createSheetStyles() {
+  const tokens = mobileTokens();
+  return StyleSheet.create({
+    scrim: { position: "absolute", left: 0, right: 0, top: 0, bottom: 0, backgroundColor: "rgba(0,0,0,0.18)" },
+    sheet: {
+      position: "absolute",
+      left: 0,
+      right: 0,
+      bottom: 0,
+      top: 0,
+      borderTopLeftRadius: 24,
+      borderTopRightRadius: 24,
+      borderCurve: "continuous",
+      overflow: "hidden",
+    },
+    grabberRow: {
+      height: GRABBER_HEIGHT + GRABBER_BOTTOM_INSET + 8,
+      alignItems: "center",
+      justifyContent: "flex-end",
+      paddingBottom: GRABBER_BOTTOM_INSET,
+    },
+    grabber: {
+      width: GRABBER_WIDTH,
+      height: GRABBER_HEIGHT,
+      borderRadius: GRABBER_HEIGHT,
+      backgroundColor: tokens.border,
+    },
+    headerRow: {
+      minHeight: 44,
+      flexDirection: "row",
+      alignItems: "center",
+      paddingHorizontal: 8,
+      gap: 8,
+    },
+    side: { minWidth: 44, flexDirection: "row", alignItems: "center", gap: 6 },
+    sideEnd: { justifyContent: "flex-end" },
+    iconButton: {
+      width: 34,
+      height: 34,
+      borderRadius: 17,
+      alignItems: "center",
+      justifyContent: "center",
+    },
+    title: { flex: 1, textAlign: "center", fontSize: 17, fontWeight: "600" },
+    action: { minHeight: 34, paddingHorizontal: 8, alignItems: "center", justifyContent: "center" },
+    actionLabel: { fontSize: 17, fontWeight: "600" },
+    actionDisabled: { opacity: 0.45 },
+    body: { flex: 1, paddingHorizontal: SHEET_CONTENT_PADDING },
+    footer: { paddingHorizontal: SHEET_CONTENT_PADDING, paddingTop: 8 },
+    pressed: { opacity: 0.55 },
+  });
+}
diff --git a/apps/mobile/components/scenario-model-slots.tsx b/apps/mobile/components/scenario-model-slots.tsx
new file mode 100644
index 000000000..a7b3fb4ea
--- /dev/null
+++ b/apps/mobile/components/scenario-model-slots.tsx
@@ -0,0 +1,359 @@
+import type { MenuAction } from "@expo/ui/community/menu";
+import type {
+  ModelCatalogEntry,
+  ModelCredential,
+  ModelRoleChoice,
+  ScenarioSlotId,
+  ThinkingLevel,
+} from "@rakazo/contracts";
+import {
+  connectionDisplayName,
+  connectedBackupOptions,
+  MAX_MODEL_BACKUPS,
+  modelRoleChoiceKey,
+  moveBackupChoice,
+  SCENARIO_DEFAULT_THINKING,
+  withConnectionName,
+} from "@rakazo/contracts";
+import { catalogEntryFor, connectionForModelChoice } from "@rakazo/core";
+import { useCallback, useEffect, useMemo, useSyncExternalStore } from "react";
+import { Alert, StyleSheet, Text } from "react-native";
+import type { ModelPickerRequest } from "../lib/model-picker-selection";
+import { native, useThemedStyles } from "../lib/native";
+import {
+  getScenarioView,
+  loadScenarios,
+  scenarioHasThinking,
+  scenarioSlotView,
+  setScenario,
+  subscribeScenarios,
+} from "../lib/scenario-models";
+import { errorText } from "../lib/user-error";
+import { MenuPicker } from "./menu-picker";
+import { RowMenu } from "./model-role-settings";
+import { SettingsGroup, SettingsRow } from "./settings-group";
+
+/** The scenes 日常帮助 does not cover; 日常帮助 is the main model with its own row above. */
+const SLOTS: { id: ScenarioSlotId; title: string; hint: string }[] = [
+  { id: "fast", title: "快速解答", hint: "秒回接话、闲聊与新 Bot 自我介绍" },
+  { id: "code", title: "代码与分析", hint: "编程、排障与逻辑分析" },
+  { id: "heavy", title: "高难任务", hint: "长链路规划与复杂工具执行" },
+  { id: "image", title: "生图模型", hint: "画图与修图，不经过思考" },
+  { id: "video", title: "生视频模型", hint: "生成视频，不经过思考" },
+];
+
+const THINKING_SLOTS: ScenarioSlotId[] = ["fast", "code", "heavy"];
+
+const LEVELS: { level: ThinkingLevel; label: string }[] = [
+  { level: "off", label: "关闭" },
+  { level: "minimal", label: "极简" },
+  { level: "low", label: "低" },
+  { level: "medium", label: "中" },
+  { level: "high", label: "高" },
+  { level: "xhigh", label: "更高" },
+  { level: "max", label: "极限" },
+];
+
+const DEFAULT_CHOICE = "default";
+
+function levelLabel(level: ThinkingLevel): string {
+  return LEVELS.find((entry) => entry.level === level)?.label ?? level;
+}
+
+/**
+ * The scenes a person points at their own models: 快速解答, 代码与分析, 高难任务, 生图 and 生视频.
+ * Every choice is written to the account through `models/setScenario`, and which scene answers a
+ * message is decided by the server, so there is no chat-or-task switch here.
+ *
+ * Each scene is a list like the main model's: the first row runs it, the rows under it are its
+ * fallbacks in order, and 添加备用模型 appends one.
+ */
+export function ScenarioModelSlots({
+  catalog,
+  credentials,
+  openPicker,
+}: {
+  catalog: ModelCatalogEntry[];
+  credentials: ModelCredential[];
+  openPicker: (request: ModelPickerRequest) => void;
+}) {
+  const view = useSyncExternalStore(subscribeScenarios, getScenarioView, getScenarioView);
+  const styles = useThemedStyles(createSlotStyles);
+
+  useEffect(() => {
+    void loadScenarios();
+  }, []);
+
+  const options = useMemo(
+    () => connectedBackupOptions(catalog, credentials),
+    [catalog, credentials],
+  );
+  const optionByKey = useMemo(
+    () => new Map(options.map((option) => [modelRoleChoiceKey(option), option])),
+    [options],
+  );
+
+  const modelLabel = useCallback(
+    (provider: string, modelId: string) =>
+      catalogEntryFor(catalog, provider, modelId)?.label ?? modelId,
+    [catalog],
+  );
+  /**
+   * The connection that runs a choice. It has to be the row's own: two connections of one provider
+   * can offer the same model, and naming the first of them showed the wrong key.
+   */
+  const connectionLabel = useCallback(
+    (provider: string, modelId: string, credentialId?: string | null) => {
+      const entry = catalogEntryFor(catalog, provider, modelId);
+      const name = entry?.providerName ?? provider;
+      const connection = connectionForModelChoice(credentials, {
+        provider,
+        modelId,
+        ...(credentialId ? { credentialId } : {}),
+      });
+      return connection ? connectionDisplayName(connection, name) : name;
+    },
+    [catalog, credentials],
+  );
+
+  const apply = useCallback((update: Parameters<typeof setScenario>[0]) => {
+    void setScenario(update).catch((error) => {
+      Alert.alert("无法保存场景模型", errorText(error, "请重试。"));
+    });
+  }, []);
+
+  const choiceFor = (option: NonNullable<ReturnType<typeof optionByKey.get>>): ModelRoleChoice => ({
+    provider: option.provider,
+    modelId: option.modelId,
+    ...(option.credentialId ? { credentialId: option.credentialId } : {}),
+  });
+
+  /** A picker list for one scene: `follow` offers 跟随日常帮助, a fallback does not. */
+  const pickerRequest = (
+    slot: ScenarioSlotId,
+    title: string,
+    { follow, taken }: { follow: boolean; taken: Set<string> },
+  ): ModelPickerRequest => {
+    const own = scenarioSlotView(view, slot)?.primary;
+    return {
+      title,
+      selectedKey: follow && own ? modelRoleChoiceKey(own) : follow ? "clear" : "",
+      emptyMessage: "没有匹配的模型",
+    choices: [
+      ...(follow ? [{ key: "clear", label: "跟随日常帮助", modelLabel: "跟随日常帮助" }] : []),
+      ...options
+        .filter((option) => !taken.has(modelRoleChoiceKey(option)))
+        .map((option) => ({
+          key: modelRoleChoiceKey(option),
+          label: withConnectionName(option.label, option.connectionName),
+          modelLabel: option.label,
+          providerLabel: option.connectionName,
+          provider: option.provider,
+          modelId: option.modelId,
+        })),
+    ],
+    onSelect: (choice) => {
+      const current = scenarioSlotView(view, slot);
+      const backups = current?.backups ?? [];
+      if (choice.key === "clear") {
+        apply({ slot, primary: null });
+        return;
+      }
+      const option = optionByKey.get(choice.key);
+      if (!option) return;
+      const picked = choiceFor(option);
+      if (follow) {
+        const earlier = current?.primary ?? null;
+        apply({
+          slot,
+          primary: {
+            ...picked,
+            // A model the person already chose keeps their effort; a new one starts on the
+            // scene's own default, which the server fills in.
+            ...(scenarioHasThinking(slot) && earlier?.thinkingLevel
+              ? { thinkingLevel: earlier.thinkingLevel }
+              : {}),
+          },
+          // The same model cannot be the scene and its own fallback.
+          backups: backups.filter(
+            (backup) => modelRoleChoiceKey(backup) !== modelRoleChoiceKey(picked),
+          ),
+        });
+        return;
+      }
+      apply({ slot, backups: [...backups, picked] });
+    },
+  };
+};
+
+  const pick = (slot: ScenarioSlotId, title: string) => {
+    const current = scenarioSlotView(view, slot);
+    const taken = new Set((current?.backups ?? []).map(modelRoleChoiceKey));
+    openPicker(pickerRequest(slot, title, { follow: true, taken }));
+  };
+
+  const addBackup = (slot: ScenarioSlotId, title: string) => {
+    const current = scenarioSlotView(view, slot);
+    const own = current?.primary;
+    const backups = current?.backups ?? [];
+    if (!own || backups.length >= MAX_MODEL_BACKUPS) return;
+    const taken = new Set([modelRoleChoiceKey(own), ...backups.map(modelRoleChoiceKey)]);
+    openPicker(pickerRequest(slot, `添加备用模型 · ${title}`, { follow: false, taken }));
+  };
+
+  const removeBackup = (slot: ScenarioSlotId, index: number) => {
+    const backups = scenarioSlotView(view, slot)?.backups ?? [];
+    if (index < 0 || index >= backups.length) return;
+    apply({ slot, backups: backups.filter((_, item) => item !== index) });
+  };
+
+  const moveBackup = (slot: ScenarioSlotId, index: number, direction: -1 | 1) => {
+    const current = scenarioSlotView(view, slot);
+    const backups = current?.backups ?? [];
+    const next = moveBackupChoice(backups, index, direction);
+    if (next === backups) return;
+    apply({ slot, backups: next });
+  };
+
+  const setThinking = (slot: ScenarioSlotId, key: string) => {
+    const current = scenarioSlotView(view, slot);
+    if (!current?.primary) return;
+    apply({
+      slot,
+      primary: {
+        ...current.primary,
+        // `default` clears the effort, so the scene's own default applies again.
+        thinkingLevel: key === DEFAULT_CHOICE ? null : (key as ThinkingLevel),
+      },
+    });
+  };
+
+  const thinkingChoices = (slot: ScenarioSlotId) => [
+    {
+      key: DEFAULT_CHOICE,
+      label: `默认（${levelLabel(SCENARIO_DEFAULT_THINKING[slot] ?? "off")}）`,
+    },
+    ...LEVELS.map((entry) => ({ key: entry.level, label: entry.label })),
+  ];
+
+  const number = (index: number) => (
+    <Text style={styles.number} accessibilityElementsHidden importantForAccessibility="no">
+      {index + 1}
+    </Text>
+  );
+
+  return (
+    <>
+      <SettingsGroup label="场景模型">
+        {SLOTS.map((slot) => {
+          const current = scenarioSlotView(view, slot.id);
+          const own = current?.primary ?? null;
+          const resolved = current?.resolved ?? null;
+          const backups = current?.backups ?? [];
+          // Order only means something once a scene has more than one row.
+          const ordered = Boolean(own) && backups.length > 0;
+          const detail = own
+            ? `${modelLabel(own.provider, own.modelId)} · ${connectionLabel(
+                own.provider,
+                own.modelId,
+                own.credentialId,
+              )}`
+            : resolved
+              ? `跟随日常帮助 · ${modelLabel(resolved.provider, resolved.modelId)} · ${connectionLabel(
+                  resolved.provider,
+                  resolved.modelId,
+                  resolved.credentialId,
+                )}`
+              : `${slot.hint} · 未选时跟随日常帮助`;
+          return [
+            <SettingsRow
+              key={`${slot.id}:primary`}
+              accessibilityRole="button"
+              chevron="right"
+              leading={ordered ? number(0) : undefined}
+              title={slot.title}
+              detail={detail}
+              onPress={() => pick(slot.id, slot.title)}
+            />,
+            ...backups.map((backup, index) => {
+              const name = modelLabel(backup.provider, backup.modelId);
+              const connection = connectionLabel(
+                backup.provider,
+                backup.modelId,
+                backup.credentialId,
+              );
+              const actions: MenuAction[] = [
+                ...(index > 0 ? [{ id: "moveUp", title: "上移" }] : []),
+                ...(index < backups.length - 1 ? [{ id: "moveDown", title: "下移" }] : []),
+                { id: "remove", title: "移除", attributes: { destructive: true } },
+              ];
+              return (
+                <RowMenu
+                  key={`${slot.id}:backup:${modelRoleChoiceKey(backup)}`}
+                  title={withConnectionName(name, connection)}
+                  actions={actions}
+                  onAction={(id) => {
+                    if (id === "moveUp") moveBackup(slot.id, index, -1);
+                    else if (id === "moveDown") moveBackup(slot.id, index, 1);
+                    else if (id === "remove") removeBackup(slot.id, index);
+                  }}
+                >
+                  <SettingsRow
+                    accessibilityRole="button"
+                    accessibilityHint="移除这个备用模型"
+                    leading={number(index + 1)}
+                    title={name}
+                    detail={`${connection} · 备用模型，点按移除`}
+                    onPress={() => removeBackup(slot.id, index)}
+                  />
+                </RowMenu>
+              );
+            }),
+            ...(own && backups.length < MAX_MODEL_BACKUPS
+              ? [
+                  <SettingsRow
+                    key={`${slot.id}:add`}
+                    accessibilityRole="button"
+                    title="添加备用模型"
+                    onPress={() => addBackup(slot.id, slot.title)}
+                  />,
+                ]
+              : []),
+          ];
+        })}
+      </SettingsGroup>
+      <SettingsGroup
+        label="思考强度"
+        footer="保持默认即可；不支持思考的模型会自动忽略该设置。"
+      >
+        {THINKING_SLOTS.map((slot) => {
+          const current = scenarioSlotView(view, slot);
+          const title = SLOTS.find((entry) => entry.id === slot)?.title ?? slot;
+          return (
+            <MenuPicker
+              key={slot}
+              label={title}
+              choices={thinkingChoices(slot)}
+              value={
+                current?.primary ? (current.primary.thinkingLevel ?? DEFAULT_CHOICE) : DEFAULT_CHOICE
+              }
+              disabled={!current?.primary}
+              onChange={(key) => setThinking(slot, key)}
+            />
+          );
+        })}
+      </SettingsGroup>
+    </>
+  );
+}
+
+function createSlotStyles() {
+  return StyleSheet.create({
+    number: {
+      minWidth: 16,
+      color: native.secondaryLabel,
+      fontSize: 15,
+      fontVariant: ["tabular-nums"],
+    },
+  });
+}
