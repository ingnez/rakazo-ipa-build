@@ -0,0 +1,27 @@
+import type { SpaceBot } from "@rakazo/contracts";
+import type { MobileBot } from "../lib/mobile-types";
+import type { HomeHeroActions } from "./home-hero-body";
+import { HomeHeroBody } from "./home-hero-body";
+
+export type { HomeHeroActions } from "./home-hero-body";
+export { createHeroStyles, HomeHeroBody, homeHeroMenu } from "./home-hero-body";
+
+/**
+ * The bot the home screen puts first, the way a chat app centres its one main character: a large
+ * avatar with the main-bot star at its bottom-right, and its name with no state or online
+ * dot after it. Nothing else — no last-message line under it. Everything else stays a list
+ * row below.
+ *
+ * The body it draws lives in `./home-hero-body`, never here, and the long press is the row's (see
+ * `homeHeroMenu`), so both platforms draw the same hero without a platform twin to resolve it back
+ * to itself.
+ */
+export function HomeHero({
+  bot,
+  onOpen,
+}: {
+  bot: MobileBot | SpaceBot;
+  onOpen: (bot: MobileBot | SpaceBot) => void;
+} & HomeHeroActions) {
+  return <HomeHeroBody bot={bot} onOpen={onOpen} />;
+}
