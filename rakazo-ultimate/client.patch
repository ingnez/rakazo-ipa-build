+    expect(adoptDeletedSpaceFallback).toHaveBeenCalledTimes(2);
+    expect(adoptDeletedSpaceFallback).toHaveBeenLastCalledWith("personal");
+    expect(selectSpace).toHaveBeenCalledOnce();
