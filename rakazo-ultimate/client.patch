+vi.mock("../components/native-symbol", () => ({ NativeSymbol: () => null }));
+vi.mock("../components/native-switch", () => ({
+  NativeSwitch: ({ value, accessibilityLabel }: { value: boolean; accessibilityLabel: string }) =>
+    createElement("span", { "data-switch": accessibilityLabel }, value ? "on" : "off"),
+}));
+vi.mock("../lib/native", () => ({
+  native: { fillPressed: "#eee" },
+  useThemedStyles: <T,>(factory: () => T) => factory(),
+}));
+vi.mock("../lib/appearance", () => ({ mobileTokens: () => ({ success: "#0f0" }) }));
+vi.mock("../lib/phone-connectors", async () => {
+  const { PHONE_CONNECTOR_INFO, PHONE_CONNECTOR_KINDS } =
+    await vi.importActual<typeof import("@rakazo/contracts")>("@rakazo/contracts");
+  const symbols: Record<string, string> = {
+    alarms: "alarm",
+    calendar: "calendar",
+    reminders: "checklist",
+    contacts: "person.crop.circle",
+    location: "location",
+  };
+  return {
+    PHONE_CONNECTOR_ROWS: PHONE_CONNECTOR_KINDS.map((kind: string) => ({
+      kind,
+      name: PHONE_CONNECTOR_INFO[kind as keyof typeof PHONE_CONNECTOR_INFO].name,
+      hint: PHONE_CONNECTOR_INFO[kind as keyof typeof PHONE_CONNECTOR_INFO].hint,
+      permission: PHONE_CONNECTOR_INFO[kind as keyof typeof PHONE_CONNECTOR_INFO].permission,
+      symbol: symbols[kind],
+    })),
+    loadPhoneConnectorState: async () => ({ ...state.stored }),
+    savePhoneConnectorState: async (next: unknown) => {
+      state.saved.push(next);
+      state.stored = next as typeof state.stored;
+    },
+    phoneConnectorToggled: (current: Record<string, boolean>, kind: string, on: boolean) => ({
+      ...current,
+      [kind]: on,
+    }),
+    pairPhoneDevice: async () => {
+      state.pairs += 1;
+      return { ok: true as const, credential: { deviceId: "d", token: "t", name: "iPhone" } };
+    },
+    pushPhoneConnectorState: async (next: unknown) => {
+      state.pushed.push(next);
+      return true;
+    },
+    phoneConnectorsNative: () => ({
+      permission: async () => state.permission,
+      requestPermission: async (kind: string) => {
+        state.requested.push(kind);
+        return state.permission;
+      },
+      run: async () => '{"value":null}',
+    }),
+  };
+});
+vi.mock("../lib/phone-connector-socket", () => ({
+  phoneConnectorSocket: () => ({
+    refresh: async () => {
+      state.refresh += 1;
+    },
+  }),
+  resumePhoneConnectorSocket: async () => {
+    state.resume += 1;
+  },
+}));
+
+let root: Root | null = null;
+let host: HTMLDivElement | null = null;
