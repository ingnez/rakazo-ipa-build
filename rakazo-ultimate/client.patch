+import type { ReactNode } from "react";
+import { Pressable, StyleSheet, Text, useWindowDimensions, View } from "react-native";
+import Animated, { FadeIn, FadeOut, SlideInDown, SlideOutDown } from "react-native-reanimated";
+import { useSafeAreaInsets } from "react-native-safe-area-context";
+import { mobileTokens } from "../../lib/appearance";
+import { useThemedStyles } from "../../lib/native";
+import { NativeSymbol } from "../native-symbol";
+import {
+  GRABBER_BOTTOM_INSET,
+  GRABBER_HEIGHT,
+  GRABBER_WIDTH,
+  SHEET_CONTENT_PADDING,
+  SHEET_DETENT,
+  SHEET_FADE_MS,
+} from "./metrics";
+import type { SandPageAction } from "./sand-page";
+
+/**
+ * A page presented over another one: the sheet keeps 5% of the screen, shows its grabber above its
+ * own header, and fades its content in over 120 ms.
+ *
+ * The reference app opens every second-level page this way, so the page behind stays visible as a
+ * strip at the top — you can always tell what you are still inside. The sheet dims what it covers
+ * only while it is coming up, and a tap outside it closes it, as the same gesture would on the
+ * page itself.
+ */
+export function SandSheetPage({
+  visible,
+  onClose,
+  title,
+  subtitle,
+  closeIcon = "xmark",
+  closeLabel = "关闭",
+  action,
+  trailing,
+  body = "scroll",
+  children,
+  footer,
+  accessibilityLabel,
+}: {
+  visible: boolean;
+  onClose: () => void;
+  title?: string;
+  subtitle?: string;
+  closeIcon?: "xmark" | "chevron.left";
+  closeLabel?: string;
+  action?: SandPageAction;
+  trailing?: ReactNode;
+  body?: "scroll" | "static";
+  children: ReactNode;
+  footer?: ReactNode;
+  accessibilityLabel?: string;
+}) {
+  const styles = useThemedStyles(createSheetStyles);
+  const tokens = mobileTokens();
+  const insets = useSafeAreaInsets();
+  const height = useWindowDimensions().height;
+  if (!visible) return null;
+  return (
+    <View style={StyleSheet.absoluteFill} accessibilityViewIsModal>
+      <Animated.View entering={FadeIn.duration(SHEET_FADE_MS)} style={styles.scrim}>
+        <Pressable
+          accessibilityRole="button"
+          accessibilityLabel={closeLabel}
+          onPress={onClose}
+          style={StyleSheet.absoluteFill}
+        />
+      </Animated.View>
+      <Animated.View
+        entering={SlideInDown.duration(SHEET_FADE_MS)}
+        exiting={SlideOutDown.duration(SHEET_FADE_MS)}
+        accessibilityLabel={accessibilityLabel}
+        style={[
+          styles.sheet,
+          {
+            marginTop: Math.round(height * (1 - SHEET_DETENT)),
+            paddingBottom: Math.max(insets.bottom, 12),
+            backgroundColor: tokens.background,
+          },
+        ]}
+      >
+        <View style={styles.grabberRow}>
+          <View style={styles.grabber} />
+        </View>
+        <View style={styles.headerRow}>
+          <View style={styles.side}>
+            <Pressable
+              accessibilityRole="button"
+              accessibilityLabel={closeLabel}
+              hitSlop={10}
+              onPress={onClose}
+              style={({ pressed }) => [styles.iconButton, pressed && styles.pressed]}
+            >
+              <NativeSymbol
+                ios={closeIcon}
+                android={closeIcon === "xmark" ? "close" : "chevron-back"}
+                size={18}
+                color={tokens.foreground}
+              />
+            </Pressable>
+          </View>
+          <Text numberOfLines={1} style={styles.title}>
+            {title ?? ""}
+          </Text>
+          <View style={[styles.side, styles.sideEnd]}>
+            {trailing}
+            {action ? (
+              <Pressable
+                accessibilityRole="button"
+                accessibilityLabel={action.label}
+                accessibilityState={{ disabled: action.disabled || action.busy, busy: action.busy }}
+                disabled={action.disabled || action.busy}
+                hitSlop={8}
+                onPress={action.onPress}
+                style={({ pressed }) => [styles.action, pressed && styles.pressed]}
+              >
+                <Text
+                  style={[
+                    styles.actionLabel,
+                    (action.disabled || action.busy) && styles.actionDisabled,
+                  ]}
+                >
+                  {action.label}
+                </Text>
+              </Pressable>
+            ) : null}
+          </View>
+        </View>
+        <View style={styles.body}>{children}</View>
+        {footer ? <View style={styles.footer}>{footer}</View> : null}
+      </Animated.View>
+    </View>
+  );
+}
+
+/** The sheet's own grabber: a 48×3 bar, sitting 5 above the sheet's top edge. */
+export function SheetGrabber() {
+  const styles = useThemedStyles(createSheetStyles);
+  return (
+    <View style={styles.grabberRow}>
+      <View style={styles.grabber} />
+    </View>
+  );
+}
+
+function createSheetStyles() {
+  const tokens = mobileTokens();
+  return StyleSheet.create({
+    scrim: { position: "absolute", left: 0, right: 0, top: 0, bottom: 0, backgroundColor: "rgba(0,0,0,0.18)" },
+    sheet: {
+      position: "absolute",
+      left: 0,
+      right: 0,
+      bottom: 0,
+      top: 0,
+      borderTopLeftRadius: 24,
+      borderTopRightRadius: 24,
+      borderCurve: "continuous",
+      overflow: "hidden",
+    },
+    grabberRow: {
