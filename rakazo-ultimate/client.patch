+
+/** The tools by name, longest name first, so a line is read by the longest name it starts with. */
+const TOOL_BY_NAME: readonly (readonly [string, ToolPhrase])[] = TOOL_PHRASES.flatMap((phrase) =>
+  phrase.names.map((name) => [name, phrase] as const),
+).sort(([a], [b]) => b.length - a.length);
+
+/**
+ * Ways of starting a line that the server used to write, kept so an older server still reads as a
+ * phrase. The names above cover every tool it writes today.
