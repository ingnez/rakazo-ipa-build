+/**
+ * The bot bodies the renderers draw, re-exported from Rakazo's own avatar specification
+ * (`avatar-spec.ts`). Every ring is built from an original recipe — no outline here was measured
+ * from or copied out of another app — with 64 vertices clockwise from the top, so two bodies
+ * morph vertex by vertex, and every face is fitted inside its body when the module loads.
+ */
+import { AVATAR_BODIES, AVATAR_VERTICES, type AvatarBody } from "./avatar-spec.js";
+
+/** The box every body is drawn in: 200 units around the head centre. */
+export const BABYGROK_VIEWBOX = "-100 -100 200 200";
+
+/** Every body's outer ring, as this many x,y pairs, clockwise from the top. */
+export const BABYGROK_VERTICES = AVATAR_VERTICES;
+
+/** A body: its ring, the face it wears, and how far that face may travel. */
+export type BabygrokBody = AvatarBody;
+
+export const BABYGROK_BODIES: Record<string, BabygrokBody> = { ...AVATAR_BODIES };
+
+/** The bodies the picker offers, in the order a stored shape index counts. */
+export const BABYGROK_BODY_KEYS = [
+  "hex",
+  "wedge",
+  "squircle",
+  "tablet",
+  "pebble",
+  "blob",
+  "teardrop",
+  "cloud",
+  "bean",
+  "egg",
+  "capsule",
+  "cylinder",
+  "gem",
+  "crystal",
+  "shield",
+  "dome",
+  "arch",
+  "leaf",
+  "square",
+  "sparkle",
+  "clover",
+  "flower",
+  "heart",
+  "house",
+  "star",
+  "pumpkin",
+] as const;
+
+
+/**
+ * The zoom each body needs so the bodies read the same size, computed from the rings themselves:
+ * every ring is normalised to the median ring's area, so equal area is what equal size means, kept
+ * inside a narrow band so no body is pushed past the canvas its avatar is drawn on.
+ */
+export const BABYGROK_VISUAL_SCALES: Readonly<Record<string, number>> = (() => {
+  const area = (ring: readonly number[]): number => {
+    let sum = 0;
+    const count = ring.length / 2;
+    for (let index = 0; index < count; index += 1) {
+      const next = (index + 1) % count;
+      sum += ring[index * 2]! * ring[next * 2 + 1]! - ring[next * 2]! * ring[index * 2 + 1]!;
+    }
+    return Math.abs(sum) / 2;
+  };
+  const areas = Object.entries(BABYGROK_BODIES).map(([key, body]) => [key, area(body.ring)] as const);
+  const sorted = areas.map(([, value]) => value).sort((a, b) => a - b);
+  const median = sorted[Math.floor(sorted.length / 2)] ?? 1;
+  const scales: Record<string, number> = {};
+  for (const [key, value] of areas) {
+    const scale = Math.sqrt(median / value);
+    scales[key] = Math.min(1.22, Math.max(0.86, scale));
+  }
+  return scales;
+})();
+
+/** A body's zoom for the size every body is meant to read at, or 1 for a body not shipped. */
+export function babygrokVisualScale(key: string): number {
+  return BABYGROK_VISUAL_SCALES[key] ?? 1;
+}
+
+/**
+ * How much larger than its footprint an avatar's canvas is drawn, and the box that canvas holds:
+ * a clip lifts, turns and squashes the body, so the canvas leaves it room to move while the body
+ * keeps the same size on screen.
+ */
+export const BABYGROK_DRAW_MARGIN = 1.28;
+export const BABYGROK_DRAW_VIEWBOX = "-128 -128 256 256";
