+            parts.append(
+                "compactClips: [" + ",".join(f'"{c}"' for c in rule["compactClips"]) + "]"
+            )
+        if rule.get("face"):
+            parts.append(f'face: "{rule["face"]}"')
+        if rule.get("morph"):
+            parts.append(f'morph: "{rule["morph"]}"')
+        if rule.get("next"):
+            parts.append(f'next: "{rule["next"]}"')
