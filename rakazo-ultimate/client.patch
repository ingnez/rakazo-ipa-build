+  }, 120_000);
+
+  afterAll(async () => {
+    await screen?.close();
+    notepad?.kill();
+    await sleep(500);
+    await rm(dir, { recursive: true, force: true }).catch(() => undefined);
+  });
+
+  it("observes Notepad, writes into it in the background, and reads the text back", async () => {
