@@ -0,0 +1,142 @@
+import type { UsageDesk, UsageDetailCall, UsageDetailWindow } from "@rakazo/contracts";
+
+/**
+ * How the usage screens write a number down: short enough to sit beside a label, exact enough to
+ * be read at a glance. A token total is a person's own spend, so it is grouped and cut to
+ * millions rather than shown as an eight-digit run of figures.
+ */
+
+/** A figure that never came back reads as a dash, not as a zero it was not. */
+const MISSING = "—";
+
+/**
+ * A token total as a person reads it: `456.07M`, `38.6K`, `512`.
+ *
+ * Millions keep two decimals so the column lines up and a figure that moved shows it; thousands
+ * keep one. The last fifty figures of the thousands band are written in millions instead: they
+ * would otherwise round to `1000.0K`.
+ */
+export function formatCompactTokens(value: number | null | undefined): string {
+  if (value == null || !Number.isFinite(value)) return MISSING;
+  const tokens = Math.max(0, Math.round(value));
+  if (tokens >= 999_950) return `${(tokens / 1_000_000).toFixed(2)}M`;
+  if (tokens >= 1_000) return `${(tokens / 1_000).toFixed(1)}K`;
+  return String(tokens);
+}
+
+/** The same total with every figure kept, for the place a person checks one call by hand. */
+export function formatExactTokens(value: number | null | undefined): string {
+  if (value == null || !Number.isFinite(value)) return MISSING;
+  return String(Math.round(value)).replace(/\B(?=(\d{3})+(?!\d))/g, ",");
+}
+
+/** A whole count, grouped: `1,234`. */
+export function formatCount(value: number | null | undefined): string {
+  if (value == null || !Number.isFinite(value)) return MISSING;
+  return formatExactTokens(value);
+}
+
+/** A share of a prompt that came from the cache: `72.4%`. */
+export function formatPercent(rate: number | null | undefined): string {
+  if (rate == null || !Number.isFinite(rate)) return MISSING;
+  const percent = Math.min(100, Math.max(0, rate * 100));
+  if (percent >= 100) return "100%";
+  return `${percent.toFixed(1)}%`;
+}
+
+/** A wait or a duration: `820ms`, `1.2s`, `2m 5s`, `1h 4m`. */
+export function formatElapsed(ms: number | null | undefined): string {
+  if (ms == null || !Number.isFinite(ms)) return MISSING;
+  const value = Math.max(0, Math.round(ms));
+  if (value < 1_000) return `${value}ms`;
+  if (value < 60_000) return `${(value / 1_000).toFixed(1)}s`;
+  const minutes = Math.floor(value / 60_000);
+  if (minutes < 60) {
+    const seconds = Math.round((value % 60_000) / 1_000);
+    return seconds === 0 ? `${minutes}m` : `${minutes}m ${seconds}s`;
+  }
+  return `${Math.floor(minutes / 60)}h ${minutes % 60}m`;
+}
+
+/** How far back a window reaches, for the line under the overview. */
+export function formatWindowRange(
+  window: UsageDetailWindow,
+  since: string,
+  until: string,
+  locale: string,
+): string {
+  const from = new Date(since);
+  const to = new Date(until);
+  if (Number.isNaN(from.getTime()) || Number.isNaN(to.getTime())) return "";
+  const sameDay = from.toDateString() === to.toDateString();
+  const clock = new Intl.DateTimeFormat(locale, { hour: "2-digit", minute: "2-digit" });
+  const stamp = new Intl.DateTimeFormat(locale, {
+    month: "2-digit",
+    day: "2-digit",
+    hour: "2-digit",
+    minute: "2-digit",
+    hour12: false,
+  });
+  const short = window === "1h" || window === "6h" || window === "24h";
+  if (short && sameDay) return `${clock.format(from)} – ${clock.format(to)}`;
+  return `${stamp.format(from)} – ${stamp.format(to)}`;
+}
+
+/**
+ * The labels one recorded call carries. The desk says which side of the split spent the tokens; a
+ * call that answered the person in a call says so instead, and one that tidied its own context is
+ * named as a compaction rather than as work nobody asked for.
+ */
+export type UsageTagTone = "neutral" | "warning" | "danger";
+export type UsageTagKey =
+  | "front_desk"
+  | "backoffice"
+  | "routine"
+  | "voice"
+  | "compaction"
+  | "other_desk"
+  | "retry"
+  | "failed";
+
+export type UsageTag = { key: UsageTagKey; tone: UsageTagTone };
+
+type TaggedCall = Pick<
+  UsageDetailCall,
+  "desk" | "trigger" | "operationKind" | "status" | "isRetry"
+>;
+
+export function usageTags(call: TaggedCall): UsageTag[] {
+  const deskTag: UsageTagKey =
+    call.operationKind === "compaction"
+      ? "compaction"
+      : call.desk === "front_desk"
+        ? call.trigger === "call_end"
+          ? "voice"
+          : "front_desk"
+        : call.desk === "backoffice"
+          ? "backoffice"
+          : call.trigger === "routine"
+            ? "routine"
+            : "other_desk";
+  const tags: UsageTag[] = [{ key: deskTag, tone: "neutral" }];
+  if (call.isRetry) tags.push({ key: "retry", tone: "warning" });
+  if (call.status === "failed" || call.status === "error") {
+    tags.push({ key: "failed", tone: "danger" });
+  }
+  return tags;
+}
+
+/** Which desk a group stands for, in the order the page shows them. */
+export const USAGE_DESK_ORDER: readonly UsageDesk[] = ["front_desk", "backoffice", "other"];
+
+/** A thinking level as the tag writes it: `max`, `high`, `off`; nothing when the run named none. */
+export function thinkingLabel(level: string | null | undefined): string | null {
+  const trimmed = level?.trim();
+  return trimmed ? trimmed : null;
+}
+
+/** The model's own name, cut to the part a person recognises when a provider prefixes it. */
+export function modelLabel(model: string): string {
+  const slash = model.lastIndexOf("/");
+  return slash === -1 ? model : model.slice(slash + 1);
+}
