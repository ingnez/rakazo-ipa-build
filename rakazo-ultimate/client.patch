+import { AVATAR_FACES } from "./avatar-spec.js";
+import type { BabygrokBody } from "./babygrok-geometry.js";
+
+/**
+ * The face BabyGrok's bodies wear, and how it moves.
+ *
+ * A body's ring is 64 x,y pairs; every body has them in the same order, so two bodies
+ * interpolate vertex by vertex. The eyes are one capsule each, drawn as a stroked line: the
+ * line is straight at rest and bends into an arch when the bot is pleased, and its width (the
+ * stroke) is what a blink closes. Everything here runs inside Reanimated worklets.
+ */
+
+/**
+ * Rounding for the path strings: two decimals is finer than a screen pixel at any size.
+ *
+ * Every worklet below calls this, so it has to be a worklet itself: a plain function captured
+ * by a worklet closure cannot be called on the UI thread, and the first avatar drawn would fail
+ * before the app paints.
+ */
+function round(value: number): number {
+  "worklet";
+  return Math.round(value * 100) / 100;
+}
+/**
+ * How far a pleased eye bends, in radians: about 117 degrees of arc.
+ *
+ * A pleased eye is a shallow crescent, not a half circle: a little more than a third of a turn
+ * each way. Bending the eye the full half turn made a dome with a hairline notch — a bun, not a
+ * `︵`.
+ */
+export const HAPPY_BEND = 2.05;
+/**
+ * How far an arch lifts off the open eye's place, as a share of its length.
+ *
+ * An arch rises `radius · (1 - cos(bend / 2))` above the level of its own feet, with
+ * `radius = length / bend`; lifting it by half of that keeps the arch centred on the eye it
+ * replaces instead of hanging below it. With the bend above that is 0.117 of the length.
+ */
+const HAPPY_LIFT = 0.117;
+/**
+ * How much of its thickness a pleased eye gives up, so the arch is a stroke and not a dome.
+ *
+ * The open eye is a fat capsule — a stroke about 0.4 of its length — and an arch drawn that thick
+ * has almost no notch left under it: at this body's proportions the inner radius fell to about a
+ * unit and the eye read as a solid bun. The reference's arch is 17 units thick over a 19-unit
+ * radius, so the stroke thins to 0.78 of the open eye's.
+ */
+const HAPPY_THIN = 0.22;
+/**
+ * How much of an eye's length the arch gives up, so the two arches keep a clear gap of skin
+ * between them.
+ *
+ * The reference's arch is shorter than the eye it opens from — its centre line runs about 0.7 of
+ * the capsule — and at the authored gap a pair of full-length arcs met in the middle and read as
+ * one `m`. Shortening the arc is what separates them; widening the gap alone would have moved the
+ * face off its own body.
+ */
+const HAPPY_SHORTEN = 0.3;
+/** How much the pair opens up while pleased, as a share of its gap. */
+const HAPPY_WIDEN = 0.16;
+/** How much a quarter turn to the side leans the pair, in degrees. */
+const TURN_LEAN = 22;
+/** How much a quarter turn pulls the eyes together, as a share of their gap. */
+const TURN_CLOSE = 0.1;
+/** The eyes never thin to nothing: a shut lid keeps a hairline, as a shut eye does. */
+const LID_KEEP = 0.06;
+
+/**
+ * One eye's lid curve, as the avatar spec states it: a quadratic `p0 -> p1 -> p2` in
+ * the body's own normalised units, and whether it is an arc (an open `︵`) rather than a closed
+ * stadium. `isArc` also means the lid is a stroke, which is thinner than the open eye it bends
+ * out of.
+ */
+export interface BabygrokEyeSpec {
+  readonly p0: readonly [number, number];
+  readonly p1: readonly [number, number];
+  readonly p2: readonly [number, number];
+  readonly isArc: boolean;
+}
+
+/** The resting lid's length in lid units: the neutral face runs from -0.15 to 0.15. */
+export const BABYGROK_LID_UNITS = 0.3;
+/** The all-zero face means "keep the body's own eye": the resting lid, upright. */
+export const BABYGROK_BASE_SPEC: BabygrokEyeSpec = {
+  p0: [AVATAR_FACES.neutral!.p0[0], AVATAR_FACES.neutral!.p0[1]],
+  p1: [AVATAR_FACES.neutral!.p1[0], AVATAR_FACES.neutral!.p1[1]],
+  p2: [AVATAR_FACES.neutral!.p2[0], AVATAR_FACES.neutral!.p2[1]],
+  isArc: false,
+};
+/** The pleased arch every face bends toward as the bot cheers up. */
+export const BABYGROK_HAPPY_SPEC: BabygrokEyeSpec = {
+  p0: [AVATAR_FACES.happy!.p0[0], AVATAR_FACES.happy!.p0[1]],
+  p1: [AVATAR_FACES.happy!.p1[0], AVATAR_FACES.happy!.p1[1]],
+  p2: [AVATAR_FACES.happy!.p2[0], AVATAR_FACES.happy!.p2[1]],
+  isArc: true,
+};
+/** How much thinner a pleased arc is than the open eye it bends out of, as a share. */
+const ARC_THIN = 0.78;
+/**
+ * How short a shut eye's lid may get, as a share of its open length.
+ *
+ * A blink took the lid almost to nothing (a twelfth), which on a list avatar's forty-point face
+ * left a fleck of ink rather than a closed eye — the dots `IMG_2913` caught beside 生活助理 and
+ * 备忘录. A shut eye keeps enough of its length to read as a short bar, as the reference's lids do.
+ */
+const LOOP_LID_KEEP = 0.42;
+/** How thin a shut eye's lid may get, as a share of its stroke: a closed eye is still a mark. */
+const LOOP_STROKE_KEEP = 0.55;
+/**
+ * The least gap between the two eyes, as a share of the space between their centres: a strip of
+ * skin that keeps a pair of lids from reading as one bar.
+ */
+const EYE_SKIN_SHARE = 0.14;
+/** The same gap in body units, so a small pair still keeps a visible seam. */
+const EYE_SKIN_MIN = 1.6;
+/** How far inside the body's own outline the eyes are kept, so no lid ever crosses the edge. */
+const EYE_BODY_INSET = 0.94;
+
+/** A body's outer ring as a path, `morph` of the way from one body to another. */
+export function babygrokBodyPath(
+  from: readonly number[],
+  to: readonly number[],
+  morph: number,
+): string {
+  "worklet";
+  let path = "";
+  for (let index = 0; index < from.length; index += 2) {
+    const x = round(from[index]! + (to[index]! - from[index]!) * morph);
+    const y = round(from[index + 1]! + (to[index + 1]! - from[index + 1]!) * morph);
+    path += index === 0 ? `M${x} ${y}` : `L${x} ${y}`;
+  }
+  return `${path}Z`;
+}
+
+/**
+ * How far a body's own outline is from its centre in a direction, in body units: the ring's radius
+ * there, interpolated between the two vertices that straddle it. The ring starts at the top and
+ * runs clockwise, so a direction is a quarter turn behind the first vertex.
+ */
+export function babygrokBodyReach(ring: readonly number[], angle: number): number {
+  "worklet";
+  const count = ring.length / 2;
+  let turn = angle / (Math.PI * 2) + 0.25;
+  turn -= Math.floor(turn);
+  const at = turn * count;
+  const index = Math.floor(at) % count;
+  const next = (index + 1) % count;
+  const share = at - Math.floor(at);
+  const from = Math.hypot(ring[index * 2]!, ring[index * 2 + 1]!);
+  const to = Math.hypot(ring[next * 2]!, ring[next * 2 + 1]!);
+  return from + (to - from) * share;
+}
+
+/** How far the eye pair may move from where it sits, along the way it is being pushed. */
+export function babygrokGazeReach(budget: readonly number[], x: number, y: number): number {
+  "worklet";
+  const count = budget.length;
+  const turn = Math.atan2(y, x) / (Math.PI * 2);
+  const index = Math.round((turn < 0 ? turn + 1 : turn) * count) % count;
+  return budget[index] ?? 0;
+}
+
+/**
+ * One eye as a closed loop: the lid curve given a thickness, so it can be filled as ink or, in the
+ * reference app's cut-out variant, subtracted from the body (see `babygrokEyeLoops`).
+ *
+ * The loop runs down one side of the lid, round its tip, back up the other side and round the
+ * start: four quadratics, the two caps being curves whose control point stands the thickness off
+ * the tip, which lands their midpoint exactly on it — a round cap, without an `A` arc whose sweep
+ * flag would have to be right in both directions.
+ */
+function babygrokEyeLoop(
+  spec: BabygrokEyeSpec,
+  cx: number,
+  cy: number,
+  unit: number,
+  tilt: number,
+  lid: number,
+  radius: number,
+  /** How much of its own width the eye keeps, so a wide lid can be squeezed away from its twin. */
+  squeeze: number,
+): string {
+  "worklet";
+  // The reference states a lid in the body's own frame — `x` across, `y` down — so `tilt` is how
+  // far that frame is turned: nothing for a measured face, and the body's own lean (less the
+  // quarter turn that makes it a lean rather than a direction) for the body's authored eye.
+  const cos = Math.cos(tilt);
+  const sin = Math.sin(tilt);
+  // The squeeze is applied in the lid's own frame, before the tilt: the whole eye narrows about
+  // its own centre, which is what keeps a long horizontal lid (the reference's `calm`) apart from
+  // the eye beside it instead of letting the two run into one bar.
+  const at = (x: number, y: number) =>
+    `${round(cx + (x * squeeze * cos - y * sin) * unit)} ${round(cy + (x * squeeze * sin + y * cos) * unit)}`;
+  // The reference states its lids with y up (its pleased arc is `p1` above its feet), and a body
+  // is drawn with y down, so the vertical is turned over here — once, for every face.
+  const [p0x, p0y, p1x, p1y, p2x, p2y] = [
+    spec.p0[0],
+    -spec.p0[1] * lid,
+    spec.p1[0],
+    -spec.p1[1] * lid,
+    spec.p2[0],
+    -spec.p2[1] * lid,
+  ];
+  const r = radius / unit;
+  const dir = (ax: number, ay: number, bx: number, by: number): [number, number] => {
+    const length = Math.hypot(bx - ax, by - ay);
+    return length < 1e-6 ? [0, 1] : [(bx - ax) / length, (by - ay) / length];
+  };
+  const normal = (ax: number, ay: number, bx: number, by: number): [number, number] => {
+    const [dx, dy] = dir(ax, ay, bx, by);
+    return [-dy, dx];
+  };
+  const [n0x, n0y] = normal(p0x, p0y, p1x, p1y);
+  const [n2x, n2y] = normal(p1x, p1y, p2x, p2y);
+  // One normal for the whole curve: shifting all three control points by the same offset moves
+  // the quadratic by exactly that offset, so a straight lid becomes a capsule of the asked width.
+  const [nmx, nmy] = normal(p0x, p0y, p2x, p2y);
+  const [dex, dey] = dir(p1x, p1y, p2x, p2y);
+  const [dsx, dsy] = dir(p0x, p0y, p1x, p1y);
+  const outerStart = at(p0x + n0x * r, p0y + n0y * r);
+  const outerControl = at(p1x + nmx * r, p1y + nmy * r);
+  const outerEnd = at(p2x + n2x * r, p2y + n2y * r);
+  const tip = at(p2x + dex * r * 2, p2y + dey * r * 2);
+  const innerEnd = at(p2x - n2x * r, p2y - n2y * r);
+  const innerControl = at(p1x - nmx * r, p1y - nmy * r);
+  const innerStart = at(p0x - n0x * r, p0y - n0y * r);
+  const heel = at(p0x - dsx * r * 2, p0y - dsy * r * 2);
+  return (
+    `M${outerStart}Q${outerControl} ${outerEnd}Q${tip} ${innerEnd}` +
+    `Q${innerControl} ${innerStart}Q${heel} ${outerStart}Z`
+  );
+}
+
+/**
+ * Both eyes as one closed path, in the body's drawing units: the reference app's cut-out face.
+ *
+ * Joined onto the body path and filled with `evenodd`, these loops are holes the page shows
+ * through; filled on their own they are the ink the reference paints when it does not cut them.
+ * `face` is a canonical face (`MOTION_FACES`), `mood` blends the chosen lid into the pleased arc
+ * for a poke or a self-raised smile, and `lid` shuts both eyes about their own middle.
+ */
+export function babygrokEyeLoops({
+  body,
+  morphFrom,
+  morphTo,
+  morph,
+  gazeX,
+  gazeY,
+  turn,
+  lid,
+  spec,
+  mood,
+}: {
+  body: BabygrokBody;
+  morphFrom: BabygrokBody | null;
+  morphTo: BabygrokBody;
+  morph: number;
+  gazeX: number;
+  gazeY: number;
+  turn: number;
+  /** How open the eyes are, 1 open to 0 shut. */
+  lid: number;
+  /** The lid curve the face asks for; the all-zero one means the body's own eye. */
+  spec: BabygrokEyeSpec;
+  /** How far to bend the lid into the pleased arc, 0 (as chosen) to 1 (pleased). */
+  mood: number;
+}): string {
+  "worklet";
+  const from = morphFrom?.eyes ?? morphTo.eyes;
+  const to = morphTo.eyes;
+  const eye = (index: number) =>
+    from[index]! + (to[index]! - from[index]!) * (morphFrom ? morph : 1);
+  const pairX = eye(0);
+  const pairY = eye(1);
+  const gap = eye(2) * (1 - TURN_CLOSE * Math.abs(turn));
+  const length = eye(3);
+  const thickness = eye(4);
+  const reach = babygrokGazeReach(body.budget, gazeX, gazeY);
+  const distance = Math.hypot(gazeX, gazeY);
+  const pushed = distance > reach && distance > 0 ? reach / distance : 1;
+  let originX = pairX + gazeX * pushed;
+  let originY = pairY + gazeY * pushed;
+  // The reference's unit is the body's own eye, so a face reads at the size the body was drawn
+  // with: the neutral lid (0.31 units long) comes out as the eye the body authored, ends and all.
+  const unit = Math.max(1, length - thickness) / BABYGROK_LID_UNITS;
+  // The reference's all-zero face means "keep the body's own eye": that is the case where the
+  // body's authored lid, tilt and all, is drawn instead of a measured curve.
+  const authored =
+    Math.abs(spec.p0[0]) +
+      Math.abs(spec.p0[1]) +
+      Math.abs(spec.p1[0]) +
+      Math.abs(spec.p1[1]) +
+      Math.abs(spec.p2[0]) +
+      Math.abs(spec.p2[1]) <
+    1e-6;
+  const shape = authored ? BABYGROK_BASE_SPEC : spec;
+  // A lid whose two ends share an x runs up the face, as the body's own eye does; one that spreads
+  // wider than that lies across the face, as an arch or a squint does.
+  const upright = Math.abs(shape.p0[0] - shape.p2[0]) < 0.02;
+  // The reference app draws its lids in the body's own frame, so a lid that runs up the face keeps
+  // the body's authored lean: its neutral face is exactly the body's own pair of eyes, which is why
+  // its bots look up and to the side rather than dead ahead. A lid that runs across the face is
+  // drawn level, as the reference's arches and squints are.
+  const inBodyFrame = authored || upright;
+  const pleased = mood > 0.001;
+  const chosen: BabygrokEyeSpec = pleased
+    ? {
+        p0: [
+          shape.p0[0] + (BABYGROK_HAPPY_SPEC.p0[0] - shape.p0[0]) * mood,
+          shape.p0[1] + (BABYGROK_HAPPY_SPEC.p0[1] - shape.p0[1]) * mood,
+        ],
+        p1: [
+          shape.p1[0] + (BABYGROK_HAPPY_SPEC.p1[0] - shape.p1[0]) * mood,
+          shape.p1[1] + (BABYGROK_HAPPY_SPEC.p1[1] - shape.p1[1]) * mood,
+        ],
+        p2: [
+          shape.p2[0] + (BABYGROK_HAPPY_SPEC.p2[0] - shape.p2[0]) * mood,
+          shape.p2[1] + (BABYGROK_HAPPY_SPEC.p2[1] - shape.p2[1]) * mood,
+        ],
+        isArc: true,
+      }
+    : shape;
+  // A lid that lies across the face is drawn level; one that runs up it keeps the body's authored
+  // tilt, which is what the body was drawn with. The pleased arch swings out of that lean as it
+  // arrives, as the stroked renderer above does: an arch drawn on the eye's slant reads as a
+  // diagonal bar rather than a `︵`.
+  const lean = inBodyFrame ? 1 - mood : 0;
+  const tilt = (((eye(5) - 90) * lean + TURN_LEAN * turn * 0.4) * Math.PI) / 180;
+  // The lid's own opening never collapses past a short bar: a blink is an eye closing, not an
+  // eye turning into a dot that a forty-point avatar cannot show.
+  const opening = Math.max(lid, LOOP_LID_KEEP);
+  const radius =
+    thickness * 0.5 * (chosen.isArc ? ARC_THIN : 1) * Math.max(lid, LOOP_STROKE_KEEP);
+  const pairTilt = ((eye(6) * lean + TURN_LEAN * turn) * Math.PI) / 180;
+  const half = gap / 2;
+  // An eye's own footprint in its lid's frame, in body units: how far the drawn loop reaches
+  // across and along the lid once its stroke is counted.
+  const r = radius / unit;
+  const across = Math.max(
+    Math.abs(chosen.p0[0]),
+    Math.abs(chosen.p1[0]),
+    Math.abs(chosen.p2[0]),
+  );
+  const along =
+    Math.max(Math.abs(chosen.p0[1]), Math.abs(chosen.p1[1]), Math.abs(chosen.p2[1])) * opening;
+  let acrossHalf = (across + r) * unit;
+  let alongHalf = (along + r) * unit;
+  // Where the second eye sits in this eye's own frame, and the strip of skin no pair may give up.
+  const turnToPair = pairTilt - tilt;
+  const apartAcross = Math.abs(gap * Math.cos(turnToPair));
+  const apartAlong = Math.abs(gap * Math.sin(turnToPair));
+  const skin = Math.min(Math.max(length * 0.12, EYE_SKIN_MIN), gap * EYE_SKIN_SHARE);
+  // Two eyes meet when neither their sides nor their ends clear each other: a lid lying across
+  // the face (the reference's `calm`, `squinted`) is wider than the space between the eyes, and a
+  // turned head swings an upright pair into a line — either way the pair ran together into one
+  // bar that even left the body's outline (`IMG_2913`). Give up as little as the geometry needs,
+  // on whichever axis asks for less: the width a long lid carries, or its length.
+  let squeeze = 1;
+  let shorten = 1;
+  if (apartAcross < 2 * acrossHalf + skin && apartAlong < 2 * alongHalf + skin) {
+    const wider = acrossHalf > 1e-3 ? (apartAcross - skin) / (2 * acrossHalf) : 0;
+    const longer = alongHalf > 1e-3 ? (apartAlong - skin) / (2 * alongHalf) : 0;
+    // The floor is a hairline rather than a plump eye on purpose: it only ever answers a lid that
+    // lies across the face (`calm`, `squinted`), which the app draws as its body's own capsule
+    // instead — see `motionFaceEyes` — so a squeezed pair here is arithmetic, not a face.
+    if (wider >= longer) squeeze = Math.min(1, Math.max(0.2, wider));
+    else shorten = Math.min(1, Math.max(0.3, longer));
+    acrossHalf *= squeeze;
+    alongHalf *= shorten;
+  }
+  // What the ink actually reaches from each eye's centre, in body units: the lid's own half length
+  // and the stroke's radius, not the box the two can sit in. `squeeze` narrows the lid's width and
+  // `shorten` its length, but the stroke stays round, so the radius is added after they are.
+  const inkAcross = across * unit * squeeze + radius;
+  const inkAlong = along * unit * shorten + radius;
+  // The pair sits where the face looks, but whole on its body. The gaze is given up first, and the
+  // authored pair is the last thing touched: every body's eyes are drawn up and to the right of
+  // its middle, and a clamp that scaled the pair itself pulled twelve of the thirteen bodies back
+  // to a dead-centre stare the reference never draws (the blob's face, and so the main bot's,
+  // landed in the middle of its body instead of looking up and away).
+  //
+  // Each eye is checked at its own outline rather than at a box around the pair: a capsule's four
+  // extreme points (both tips and both sides) are where it leaves the body, while the box's
+  // corners stand well outside the ink — which is what made the old clamp give up so much.
+  {
+    const ringFrom = morphFrom?.ring ?? body.ring;
+    const ringTo = body.ring;
+    const alongX = -Math.sin(tilt);
+    const alongY = Math.cos(tilt);
+    const acrossX = Math.cos(tilt);
+    const acrossY = Math.sin(tilt);
+    // The eye as a shape to measure: a length along its lid, a width across it, and the stroke's
+    // own roundness around them. Its supporting point in a direction is where that shape reaches,
+    // which is what the body's edge is compared with — not the box around it.
+    const lidAlong = along * unit * shorten;
+    const lidAcross = across * unit * squeeze;
+    const gazeSquared = gazeX * gazeX + gazeY * gazeY;
+    // How far the body's outline is from its middle in a direction, taking the nearest edge within
+    // a little either side: a star's spike or a clover's notch is a few degrees wide.
+    const edge = (x: number, y: number): number => {
+      const angle = Math.atan2(y, x);
+      let edge = Math.min(babygrokBodyReach(ringFrom, angle), babygrokBodyReach(ringTo, angle));
+      for (const around of [-0.22, 0.22])
+        edge = Math.min(
+          edge,
+          babygrokBodyReach(ringFrom, angle + around),
+          babygrokBodyReach(ringTo, angle + around),
+        );
+      return edge * EYE_BODY_INSET;
+    };
+    let give = 1;
+    let hold = 0;
+    // The body's edge changes direction as the pair travels (a star's spike and notch are a quarter
+    // of its width apart), so each eye is measured where the gaze would leave it: two passes settle
+    // on the same answer.
+    for (let pass = 0; pass < 2; pass += 1) {
+      let next = 1;
+      for (const side of [-1, 1]) {
+        const cx = Math.cos(pairTilt) * half * side;
+        const cy = Math.sin(pairTilt) * half * side;
+        const px = pairX + cx;
+        const py = pairY + cy;
+        const out = Math.hypot(px, py);
+        if (out < 1e-6) continue;
+        const dx = px / out;
+        const dy = py / out;
+        const support = Math.hypot(lidAlong * (alongX * dx + alongY * dy), lidAcross * (acrossX * dx + acrossY * dy)) + radius;
+        // The eye's outermost ink, seen from the pair's own middle.
+        const ex = cx + dx * support;
+        const ey = cy + dy * support;
+        if (gazeSquared > 1e-9) {
+          const limit = edge(px + ex + gazeX * give, py + ey + gazeY * give);
+          const restX = pairX + ex;
+          const restY = pairY + ey;
+          const c = restX * restX + restY * restY - limit * limit;
+          const b = 2 * (restX * gazeX + restY * gazeY);
+          // Only an eye that starts on the body and would leave it as the face looks.
+          if (c <= 0 && b > 0) {
+            const root = b * b - 4 * gazeSquared * c;
+            if (root > 0)
+              next = Math.min(next, Math.max(0, (-b + Math.sqrt(root)) / (2 * gazeSquared)));
+          }
+        }
+        // A face drawn with a lid longer than its own (the reference's `surprised`, `calm`) can sit
+        // off the body before it looks anywhere: that is the only case where the pair itself moves,
+        // and then only as far in as it must to be back on the body.
+        const spoken = ex * ex + ey * ey - edge(px, py) ** 2;
+        if (spoken > 0) {
+          const near = 2 * (ex * pairX + ey * pairY);
+          const span = pairX * pairX + pairY * pairY;
+          const root = near * near - 4 * span * spoken;
+          if (span > 1e-9 && root > 0) {
+            // The nearer of the two places the pair has to shrink to: from outside it is the
+            // smaller root, the first one back on the body.
+            const solved = (-near - Math.sqrt(root)) / (2 * span);
+            if (solved > 0 && solved < 1) hold = Math.max(hold, solved);
+          }
+        }
+      }
+      if (next === give) break;
+      give = next;
+    }
+    if (hold > 0) {
+      originX = pairX * hold + (originX - pairX) * Math.min(give, hold);
+      originY = pairY * hold + (originY - pairY) * Math.min(give, hold);
+    } else if (give < 1) {
+      originX = pairX + (originX - pairX) * give;
+      originY = pairY + (originY - pairY) * give;
+    }
+  }
+  let d = "";
+  for (const side of [-1, 1]) {
+    const cx = originX + Math.cos(pairTilt) * half * side;
+    const cy = originY + Math.sin(pairTilt) * half * side;
+    d += babygrokEyeLoop(chosen, cx, cy, unit, tilt, opening * shorten, radius, squeeze);
+  }
+  return d;
+}
+
+/**
+ * One eye: a capsule at rest, bent into an arch as `mood` rises, as a path.
+ *
+ * It sits above `babygrokEyes`, the only thing that calls it, and that order is load-bearing:
+ * the worklet Babel plugin rewrites each `"worklet"` function declaration into a
+ * `var name = function nameFactory(...)(...)` call in the same place, which the plain function
+ * hoisting rule does not lift, so a helper declared below its caller is still `undefined` when
+ * the caller's closure array is built, and the first avatar drawn throws
+ * `TypeError: undefined is not a function`.
+ */
+function babygrokEyePath(
+  cx: number,
+  cy: number,
+  tilt: number,
+  length: number,
+  thickness: number,
+  mood: number,
+): string {
+  "worklet";
+  const bend = HAPPY_BEND * mood;
+  const ax = Math.cos(tilt);
+  const ay = Math.sin(tilt);
+  const point = (along: number, across: number) =>
+    `${round(cx + ax * along - ay * across)} ${round(cy + ay * along + ax * across)}`;
+  if (bend < 0.001) {
+    // A straight capsule: the stroke's own round caps finish it.
+    return `M${point(-length / 2, 0)}L${point(length / 2, 0)}`;
+  }
+  // An arc of the same length, its highest point where the eye's middle is, its ends
+  // hanging down: the arch of a pleased face. Two cubics draw it exactly enough.
+  const radius = length / bend;
+  const half = bend / 2;
+  const at = (angle: number) => ({
+    along: radius * Math.sin(angle),
+    across: radius * (1 - Math.cos(angle)),
+  });
+  // The tangent has to be the unit one: `control` below already carries the radius, so a tangent
+  // that carries it too scales the controls by `radius²`, and since the bend — and with it the
+  // radius — runs away as `mood` starts from nothing, the controls fly off the head entirely.
+  const tangent = (angle: number) => ({
+    along: Math.cos(angle),
+    across: Math.sin(angle),
+  });
+  // A circular arc is a cubic whose controls sit this far along its tangents.
+  const control = (4 / 3) * Math.tan(half / 4) * radius;
+  const start = at(-half);
+  const middle = at(0);
+  const end = at(half);
+  const startTangent = tangent(-half);
+  const middleTangent = tangent(0);
+  const endTangent = tangent(half);
+  // Each control point stands off its own end of the arc, along the way the stroke travels there:
+  // away from the start, and back from the middle and from the end.
+  const c1 = {
+    along: start.along + startTangent.along * control,
+    across: start.across + startTangent.across * control,
+  };
+  const c2 = {
+    along: middle.along - middleTangent.along * control,
+    across: middle.across - middleTangent.across * control,
+  };
+  const c3 = {
+    along: middle.along + middleTangent.along * control,
+    across: middle.across + middleTangent.across * control,
+  };
+  const c4 = {
+    along: end.along - endTangent.along * control,
+    across: end.across - endTangent.across * control,
+  };
+  return (
+    `M${point(start.along, start.across)}` +
+    `C${point(c1.along, c1.across)} ${point(c2.along, c2.across)} ${point(middle.along, middle.across)}` +
+    `C${point(c3.along, c3.across)} ${point(c4.along, c4.across)} ${point(end.along, end.across)}`
+  );
+}
+
+/** The two eyes' centre lines as one path, and the stroke that draws them. */
+export function babygrokEyes({
+  body,
+  morphFrom,
+  morphTo,
+  morph,
+  gazeX,
+  gazeY,
+  turn,
+  mood,
+  lid,
+}: {
+  /** The body whose eye pair is being worn (the one being morphed to). */
+  body: BabygrokBody;
+  /** The pair being left behind, or null when the body is settled. */
+  morphFrom: BabygrokBody | null;
+  morphTo: BabygrokBody;
+  /** How far the body has morphed, 0 (the old one) to 1 (the new one). */
+  morph: number;
+  /** Where the face is looking, in view units. */
+  gazeX: number;
+  gazeY: number;
+  /** How far the head is turned, -1 (left) to 1 (right). */
+  turn: number;
+  /** How pleased the face is, 0 (open eyes) to 1 (an arch). */
+  mood: number;
+  /** How open the eyes are, 1 open to 0 shut. */
+  lid: number;
+}): { d: string; width: number } {
+  "worklet";
+  const from = morphFrom?.eyes ?? morphTo.eyes;
+  const to = morphTo.eyes;
+  const eye = (index: number) =>
+    from[index]! + (to[index]! - from[index]!) * (morphFrom ? morph : 1);
+  const pairX = eye(0);
+  const pairY = eye(1);
+  const gap = eye(2) * (1 + HAPPY_WIDEN * mood) * (1 - TURN_CLOSE * Math.abs(turn));
+  const length = eye(3) * (1 - HAPPY_SHORTEN * mood);
+  // A pleased eye's stroke is thinner than the capsule it opens from: the arch has to keep a
+  // notch under it, or it reads as a dome (see `HAPPY_THIN`).
+  const thickness = eye(4) * (1 - HAPPY_THIN * mood);
+  // The open eye is a capsule standing nearly upright on the face; a pleased one is an arch lying
+  // level on it, hump up, as the reference draws it. Bent about the capsule's own axis the arch
+  // would stand on its side, so the shape swings out of that lean as `mood` rises, and arrives
+  // level at 1 without the straight eye ever jumping.
+  const archTilt = (eye(5) * (1 - mood) * Math.PI) / 180;
+  // The pair the body authored leans with the face, but a pleased pair sits level, as the
+  // reference's does; a turned head still leans it.
+  const pairTilt = ((eye(6) * (1 - mood) + TURN_LEAN * turn) * Math.PI) / 180;
+  // The pair moves where the face looks, but no further than its own body allows.
+  const reach = babygrokGazeReach(body.budget, gazeX, gazeY);
+  const distance = Math.hypot(gazeX, gazeY);
+  const scale = distance > reach && distance > 0 ? reach / distance : 1;
+  const originX = pairX + gazeX * scale;
+  const originY = pairY + gazeY * scale - length * HAPPY_LIFT * mood;
+  const half = gap / 2;
+  let d = "";
+  for (const side of [-1, 1]) {
+    const cx = originX + Math.cos(pairTilt) * half * side;
+    const cy = originY + Math.sin(pairTilt) * half * side;
+    d += babygrokEyePath(cx, cy, archTilt, length, thickness, mood);
+  }
+  return { d, width: Math.max(thickness * Math.max(lid, LID_KEEP), 0.4) };
+}
