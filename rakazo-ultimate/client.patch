+    expect(deleteSpaceTitle(space({ bots: [bot], botCount: 0 }))).toBe("Delete Work?");
+    // Older servers send no count; fall back to the listed bots.
+    expect(deleteSpaceTitle(space({ bots: [bot] }))).toBe("Delete Work and its bot?");
