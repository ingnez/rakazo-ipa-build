+  const { t } = useLingui();
+  const tokens = useMobileTokens();
+  const insets = useSafeAreaInsets();
+  const state = computer
+    ? computer.state === "running"
+      ? t`Running`
+      : computer.state === "booting"
+        ? t`Starting`
+        : computer.state === "suspended"
+          ? t`Asleep`
+          : computer.state === "error"
+            ? t`Needs attention`
+            : t`Stopped`
+    : t`Not set up`;
+  const holder = computer
