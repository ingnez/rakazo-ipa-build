+  it("keeps Reduce Motion avatars glossy after first paint, but does not start loops", () => {
+    motion.reducedMotion = true;
+    paint.ready = true;
+    act(() =>
+      root.render(<MochiBotAvatar color="#E8C4A8" identity="bot-1" size={50} motion="live" />),
+    );
+    expect(container.querySelector('[data-testid="mochi-avatar-glossy"]')).not.toBeNull();
+    expect(motion.repeats).toBe(0);
+  });
+});
