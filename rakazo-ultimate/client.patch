+  it("still folds a path, an English command or a bare name into its phrase", () => {
+    expect(activityStep("Read file magpie-ios-app/Magpie/Views/Server.swift")?.label).toBe(
+      "正在读文件",
+    );
+    expect(activityStep("Shell ls -la /workspace")?.label).toBe("正在执行几条命令");
+    expect(activityStep("Shell python3 fetch.py")?.label).toBe("正在执行几条命令");
