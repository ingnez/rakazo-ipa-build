+    vi.mocked(clearFailedSends).mockClear();
+    await saveSessionToken("fake-a");
+    await clearSessionToken();
+    await restoreSessionToken("fake-b");
+    expect(vi.mocked(clearFailedSends).mock.calls.length).toBeGreaterThanOrEqual(3);
+  });
+
