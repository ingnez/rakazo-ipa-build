+import { describe, expect, it } from "vitest";
+import {
+  ACTIVITY_ELAPSED_THRESHOLD_MS,
+  ACTIVITY_MIN_DWELL_MS,
+  ACTIVITY_SPECIFIC_DWELL_MS,
+  ActivityPacing,
+} from "./activity-pacing";
+
+const search = { key: "search", label: "四处查找" };
+const read = { key: "read", label: "读文件" };
+const shell = { key: "shell", label: "跑命令" };
+
+describe("ActivityPacing", () => {
+  it("shows the first step at once, and counts the dwell from there", () => {
+    const pacing = new ActivityPacing();
+    const first = pacing.pace(search, 0);
+    expect(first.shown).toEqual(search);
+    expect(first.changed).toBe(true);
+  });
+
+  it("holds a new step until the current one has had its 800 ms", () => {
+    const pacing = new ActivityPacing();
+    pacing.pace(search, 1000);
+    const early = pacing.pace(read, 1200);
+    expect(early.shown).toEqual(search);
+    expect(early.changed).toBe(false);
+    expect(early.dueAtMs).toBe(1000 + ACTIVITY_MIN_DWELL_MS);
+    // The wake at the due time takes the queued step.
+    const due = pacing.takeQueued(1000 + ACTIVITY_MIN_DWELL_MS);
+    expect(due.shown).toEqual(read);
+    expect(due.changed).toBe(true);
+  });
+
+  it("changes at once once the dwell is over", () => {
+    const pacing = new ActivityPacing();
+    pacing.pace(search, 1000);
+    const later = pacing.pace(shell, 1000 + ACTIVITY_MIN_DWELL_MS);
+    expect(later.shown).toEqual(shell);
+    expect(later.changed).toBe(true);
+  });
+
+  it("does not redraw the line for the same step again", () => {
+    const pacing = new ActivityPacing();
+    pacing.pace(search, 1000);
+    const again = pacing.pace({ key: "search", label: "四处查找" }, 3000);
+    expect(again.changed).toBe(false);
+    expect(again.dueAtMs).toBeUndefined();
+  });
+
+  it("drops a queued step the run has left behind", () => {
+    const pacing = new ActivityPacing();
+    pacing.pace(search, 1000);
+    pacing.pace(read, 1100);
+    pacing.pace(search, 1200);
+    const due = pacing.takeQueued(2000);
+    expect(due.shown).toEqual(search);
+    expect(due.changed).toBe(false);
+  });
+
+  it("clears the line when the work ends", () => {
+    const pacing = new ActivityPacing();
+    pacing.pace(search, 1000);
+    const done = pacing.pace(undefined, 2000);
+    expect(done.shown).toBeUndefined();
+    expect(done.changed).toBe(true);
+  });
+
+  it("counts seconds only past a minute of the same run", () => {
+    const pacing = new ActivityPacing();
+    pacing.pace(search, 1000);
+    expect(pacing.elapsedSeconds(1000 + ACTIVITY_ELAPSED_THRESHOLD_MS - 1)).toBeUndefined();
+    expect(pacing.elapsedSeconds(1000 + ACTIVITY_ELAPSED_THRESHOLD_MS)).toBe(60);
+    pacing.pace(read, 200_000);
+    // A new step inside the same run keeps counting from when the run's line began.
+    expect(pacing.elapsedSeconds(205_000)).toBe(204);
+  });
+});
+
+/** This round: a step in the work's own words takes the line over quickly. */
+describe("ActivityPacing with the work's own step", () => {
+  const stepA = { key: "step:读取部署文档", label: "读取部署文档", specific: true };
+  const stepB = { key: "step:搜索历史报错", label: "搜索历史报错", specific: true };
+
+  it("shows the next Chinese step after its own short dwell, not the phrase's 800 ms", () => {
+    const pacing = new ActivityPacing();
+    pacing.pace(shell, 1000);
+    const early = pacing.pace(stepA, 1000 + ACTIVITY_SPECIFIC_DWELL_MS);
+    expect(early.shown).toEqual(stepA);
+    expect(early.changed).toBe(true);
+  });
+
+  it("holds a Chinese step that arrives inside the short dwell, then takes it at its due time", () => {
+    const pacing = new ActivityPacing();
+    pacing.pace(shell, 1000);
+    const queued = pacing.pace(stepA, 1100);
+    expect(queued.shown).toEqual(shell);
+    expect(queued.dueAtMs).toBe(1000 + ACTIVITY_SPECIFIC_DWELL_MS);
+    expect(pacing.takeQueued(1000 + ACTIVITY_SPECIFIC_DWELL_MS).shown).toEqual(stepA);
+  });
+
+  it("moves on from one Chinese step to the next as each new step arrives", () => {
+    const pacing = new ActivityPacing();
+    pacing.pace(stepA, 1000);
+    expect(pacing.pace(stepB, 1000 + ACTIVITY_SPECIFIC_DWELL_MS).shown).toEqual(stepB);
+  });
+});
diff --git a/apps/mobile/lib/activity-pacing.ts b/apps/mobile/lib/activity-pacing.ts
new file mode 100644
index 0000000..23b0970
--- /dev/null
+++ b/apps/mobile/lib/activity-pacing.ts
@@ -0,0 +1,176 @@
+import { useEffect, useRef, useState } from "react";
+import type { ActivityStep } from "./activity-label";
+import { activityStep, needsYouStep } from "./activity-label";
+
+/**
+ * How the working line keeps still while a bot works.
+ *
+ * A run calls tools in bursts, and the line would flicker through every one of them. The reference
+ * app holds each line for at least a moment, keeps one phrase while the same kind of step repeats,
+ * and only counts the seconds once the wait is long enough to be worth counting.
+ */
+export const ACTIVITY_MIN_DWELL_MS = 800;
+/**
+ * A step the work wrote itself (「读取 magpie 部署文档」) is the thing the reader asked to see, so it
+ * takes the line over quickly instead of waiting out the plain phrase's dwell.
+ */
+export const ACTIVITY_SPECIFIC_DWELL_MS = 300;
+export const ACTIVITY_ELAPSED_THRESHOLD_MS = 60_000;
+
+/** How long the step on screen is held before `next` may replace it. */
+function dwellMs(next: ActivityStep | undefined): number {
+  return next?.specific ? ACTIVITY_SPECIFIC_DWELL_MS : ACTIVITY_MIN_DWELL_MS;
+}
+
+export type PacedActivity = {
+  /** The step the line shows now, if any. */
+  readonly shown: ActivityStep | undefined;
+  /** Whether the line changed, so a caller knows to animate it. */
+  readonly changed: boolean;
+  /** When a queued step may take over, for the caller to wake at. */
+  readonly dueAtMs: number | undefined;
+};
+
+/**
+ * The line's own state machine: what is shown, when it started, and what is waiting behind it.
+ */
+export class ActivityPacing {
+  private shownStep: ActivityStep | undefined;
+  private shownAtMs = 0;
+  /** A step that arrived inside the dwell, to be shown when the dwell is over. */
+  private queued: ActivityStep | undefined;
+  /** When this run's line first appeared, for the seconds it shows past the threshold. */
+  private startedAtMs = 0;
+
+  get shown(): ActivityStep | undefined {
+    return this.shownStep;
+  }
+
+  /** The run's line began this long ago, in whole seconds, once it is worth showing. */
+  elapsedSeconds(nowMs: number): number | undefined {
+    if (!this.shownStep) return undefined;
+    const elapsed = nowMs - this.startedAtMs;
+    return elapsed >= ACTIVITY_ELAPSED_THRESHOLD_MS ? Math.floor(elapsed / 1000) : undefined;
+  }
+
+  /**
+   * What the line should show at `nowMs`: the step just arrived where it may change, the one held
+   * while the dwell is still running, or nothing once the work ends.
+   */
+  pace(next: ActivityStep | undefined, nowMs: number): PacedActivity {
+    if (!next) {
+      const changed = this.shownStep !== undefined;
+      this.shownStep = undefined;
+      this.queued = undefined;
+      this.shownAtMs = 0;
+      this.startedAtMs = 0;
+      return { shown: undefined, changed, dueAtMs: undefined };
+    }
+    if (!this.shownStep) {
+      this.show(next, nowMs);
+      return { shown: this.shownStep, changed: true, dueAtMs: undefined };
+    }
+    // The same kind of step again: the line stays as it is, and a step that was waiting behind the
+    // dwell is no longer what the run is doing.
+    if (next.key === this.shownStep.key) {
+      this.queued = undefined;
+      return { shown: this.shownStep, changed: false, dueAtMs: undefined };
+    }
+    if (nowMs - this.shownAtMs >= dwellMs(next)) {
+      this.show(next, nowMs);
+      return { shown: this.shownStep, changed: true, dueAtMs: undefined };
+    }
+    this.queued = next;
+    return { shown: this.shownStep, changed: false, dueAtMs: this.shownAtMs + dwellMs(next) };
+  }
+
+  /** The step waiting behind the dwell, if the caller woke at its due time. */
+  takeQueued(nowMs: number): PacedActivity {
+    const next = this.queued;
+    if (!next) return { shown: this.shownStep, changed: false, dueAtMs: undefined };
+    if (nowMs - this.shownAtMs < dwellMs(next)) {
+      return { shown: this.shownStep, changed: false, dueAtMs: this.shownAtMs + dwellMs(next) };
+    }
+    this.show(next, nowMs);
+    return { shown: this.shownStep, changed: true, dueAtMs: undefined };
+  }
+
+  private show(step: ActivityStep, nowMs: number) {
+    if (!this.shownStep) this.startedAtMs = nowMs;
+    this.shownStep = step;
+    this.shownAtMs = nowMs;
+    this.queued = undefined;
+  }
+}
+
+/**
+ * The working line for a chat, paced. `line` is the live activity text, `needsYou` the run waiting
+ * on the user; the result is the phrase to draw, with the seconds once the wait passes a minute.
+ */
+export function usePacedActivity(
+  line: string | undefined,
+  needsYou = false,
+): { label: string | undefined; changed: boolean } {
+  const pacing = useRef(new ActivityPacing());
+  const [shown, setShown] = useState<ActivityStep | undefined>(undefined);
+  const [changed, setChanged] = useState(false);
+  const [seconds, setSeconds] = useState<number | undefined>(undefined);
+  const timer = useRef<ReturnType<typeof setTimeout> | null>(null);
+  const ticker = useRef<ReturnType<typeof setInterval> | null>(null);
+
+  useEffect(() => {
+    const clearTimer = () => {
+      if (timer.current) {
+        clearTimeout(timer.current);
+        timer.current = null;
+      }
+    };
+    const apply = (result: PacedActivity) => {
+      clearTimer();
+      setShown(result.shown);
+      setChanged(result.changed);
+      // A step held back by the dwell takes over as soon as it may.
+      if (result.dueAtMs !== undefined) {
+        const wait = Math.max(result.dueAtMs - Date.now(), 0);
+        timer.current = setTimeout(() => {
+          timer.current = null;
+          apply(pacing.current.takeQueued(Date.now()));
+        }, wait);
+      }
+    };
+    // Waiting on the user is its own step: it says what the bot wants, not what it was doing.
+    const next = needsYou ? needsYouStep() : activityStep(line);
+    apply(pacing.current.pace(next, Date.now()));
+    return clearTimer;
+  }, [line, needsYou]);
+
+  // Past the threshold the line counts the seconds it has been working; before it, nothing moves.
+  useEffect(() => {
+    const stop = () => {
+      if (ticker.current) {
+        clearInterval(ticker.current);
+        ticker.current = null;
+      }
+    };
+    if (!shown) {
+      stop();
+      setSeconds(undefined);
+      return stop;
+    }
+    const read = () => {
+      const value = pacing.current.elapsedSeconds(Date.now());
+      setSeconds(value);
+      if (value === undefined) return;
+      if (!ticker.current) ticker.current = setInterval(read, 1000);
+    };
+    read();
+    return stop;
+  }, [shown]);
+
+  const label = shown
+    ? seconds === undefined
+      ? shown.label
+      : `${shown.label} · ${seconds}s`
+    : undefined;
+  return { label, changed };
+}
