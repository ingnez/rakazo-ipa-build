+
+/** A pasted Grok Bot share link is short; anything longer is not one. */
+export const GROK_BOT_LINK_MAX_LENGTH = 500;
+
+/** The link someone pasted, as `https://x.ai/bot/<id>` or `grokbot://app/v1/bot-template?id=<id>`. */
+export const GrokBotLinkInput = z.object({
+  url: z.string().trim().min(1).max(GROK_BOT_LINK_MAX_LENGTH),
+});
+export type GrokBotLinkInput = z.infer<typeof GrokBotLinkInput>;
+
+/**
+ * What a share page gives before anything is created: the bot's own card, the instructions the
+ * import would write, and the avatar it would wear. Shown first, so a paste can be looked at
+ * without leaving a bot behind.
+ */
+export const GrokBotPreviewSchema = z.object({
+  sourceId: z.string(),
+  sourceUrl: z.string(),
+  name: z.string(),
+  description: z.string(),
+  sharerName: z.string().nullable(),
+  color: z.string().nullable(),
+  shape: z.string().nullable(),
+  /** `#RRGGBB::shape_N`, or just the color, when the page carried one. */
+  avatarValue: z.string().optional(),
+  /** The shipped shape the page's shape maps to, if it maps to one. */
+  shapeKey: z.string().nullable().optional(),
+  instructions: z.string(),
+});
+export type GrokBotPreview = z.infer<typeof GrokBotPreviewSchema>;
+
+export const ImportGrokBotInput = z.object({
+  url: z.string().trim().min(1).max(GROK_BOT_LINK_MAX_LENGTH),
+  /** A name the user gave instead of the shared one. */
+  name: z.string().trim().min(1).max(BOT_NAME_MAX_LENGTH).optional(),
+  /** Instructions the user (or the bot speaking for them) wrote instead of the generated ones. */
+  instructions: z.string().trim().min(1).max(BOT_INSTRUCTIONS_MAX_LENGTH).optional(),
+});
+export type ImportGrokBotInput = z.infer<typeof ImportGrokBotInput>;
+
+/** Sent as the error's `data.reason` when the pasted link is not a Grok Bot share. */
+export const GROK_BOT_LINK_INVALID = "grok_bot_link_invalid";
+/** Sent as the error's `data.reason` when the page could not be read (blocked, gone, empty). */
+export const GROK_BOT_LINK_UNREADABLE = "grok_bot_link_unreadable";
