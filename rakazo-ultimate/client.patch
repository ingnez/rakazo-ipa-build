+});
+
+afterEach(() => {
+  vi.clearAllTimers();
+  vi.useRealTimers();
+});
+
+async function stall(operation: "write" | "delete") {
+  if (operation === "delete") {
+    const remove = vi.mocked(SecureStore.deleteItemAsync).getMockImplementation()!;
+    vi.mocked(SecureStore.deleteItemAsync).mockImplementation((key) =>
