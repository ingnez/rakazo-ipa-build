+        </View>
+        <ScrollView contentContainerStyle={styles.content}>
+          <Text style={[styles.summary, { color: tokens.mutedForeground }]}>
+            你的 Bot 们共用的那一台电脑。
+          </Text>
+          <View style={[styles.card, { backgroundColor: tokens.card, borderColor: tokens.border }]}>
+            {rows.map((row) => (
+              <View key={row.label} style={[styles.row, { borderTopColor: tokens.border }]}>
+                <Text style={[styles.rowLabel, { color: tokens.mutedForeground }]}>{row.label}</Text>
+                <Text numberOfLines={1} style={[styles.rowValue, { color: tokens.foreground }]}>
+                  {row.value}
+                </Text>
+              </View>
+            ))}
+            {!computer ? (
+              <Text style={[styles.empty, { color: tokens.mutedForeground }]}>
+                这台电脑还没有开过。
+              </Text>
+            ) : null}
+          </View>
+          {computer?.diskFullPercent !== undefined ? (
+            <View style={styles.disk}>
+              <View style={[styles.diskTrack, { backgroundColor: tokens.muted }]}>
+                <View
