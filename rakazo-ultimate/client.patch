+import { createElement } from "react";
+import { describe, expect, it } from "vitest";
+import { APP_FONT_FAMILY, applyAppFont } from "./app-font";
+import { capTextScaling } from "./text-scale";
+
+/** react-native's runtime module: `module.exports = { get Text() {…}, get TextInput() {…} }`. */
+function fakeReactNative() {
+  const RealText = (props: Record<string, unknown>) => createElement("div", props);
+  const RealInput = (props: Record<string, unknown>) => createElement("input", props);
+  return {
+    get Text() {
+      return RealText;
+    },
+    get TextInput() {
+      return RealInput;
+    },
+  };
+}
+
+const FONTED = Symbol.for("rakazo.fontedText");
+
+describe("app font", () => {
+  it("replaces Text once and leaves the module replaceable afterwards", () => {
+    const reactNative = fakeReactNative();
+    applyAppFont(reactNative as never);
+    const fonted = reactNative.Text as unknown as Record<symbol, unknown>;
+    expect(fonted[FONTED]).toBe(true);
+
+    // A second install is a no-op rather than a second wrapper.
+    applyAppFont(reactNative as never);
+    expect(reactNative.Text).toBe(fonted);
+
+    // The property stays configurable, so nothing later can hit a frozen property.
+    const descriptor = Object.getOwnPropertyDescriptor(reactNative, "Text");
+    expect(descriptor?.configurable).toBe(true);
+  });
+
+  it("keeps the scale cap when the cap was installed first", () => {
+    const reactNative = fakeReactNative();
+    capTextScaling(reactNative as never);
+    const capped = reactNative.Text;
+    // A second `defineProperty` on the same name used to throw `Cannot redefine property`.
+    expect(() => applyAppFont(reactNative as never)).not.toThrow();
+    expect(reactNative.Text).not.toBe(capped);
+    expect((reactNative.Text as unknown as Record<symbol, unknown>)[FONTED]).toBe(true);
+  });
+
+  it("puts the app face in front of the caller's own style", () => {
+    const reactNative = fakeReactNative();
+    applyAppFont(reactNative as never);
+    const Text = reactNative.Text as unknown as (props: Record<string, unknown>) => {
+      props: { style: unknown; maxFontSizeMultiplier?: number };
+    };
+    const element = Text({ style: { fontSize: 15 } }) as unknown as {
+      props: { style: Array<Record<string, unknown>>; maxFontSizeMultiplier?: number };
+    };
+    expect(element.props.style[0]).toEqual({ fontFamily: APP_FONT_FAMILY });
+    expect(element.props.style[1]).toEqual({ fontSize: 15 });
+    expect(element.props.maxFontSizeMultiplier).toBeGreaterThan(1);
+  });
+});
