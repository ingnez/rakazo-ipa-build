+                    styles.diskFill,
+                    {
+                      backgroundColor:
+                        computer.diskFullPercent >= 95 ? tokens.destructive : tokens.warning,
+                      width: `${Math.min(100, Math.max(0, computer.diskFullPercent))}%`,
+                    },
+                  ]}
+                />
+              </View>
+              <Text style={[styles.diskNote, { color: tokens.mutedForeground }]}>
+                磁盘已用 {computer.diskFullPercent}%，清理构建产物和缓存能腾出空间。
+              </Text>
+            </View>
+          ) : null}
+          <View style={styles.actions}>
+            {onCleanUp && computer ? (
+              <NativeActionButton
+                label={t`Clean up`}
+                prominence="secondary"
+                busy={cleaningUp}
+                onPress={onCleanUp}
+              />
+            ) : null}
+            {onUpdate && computer ? (
+              <NativeActionButton
+                label={computer.canUpdate ? t`Update computer` : t`Repair computer`}
+                prominence="secondary"
+                busy={updating}
+                onPress={onUpdate}
+              />
+            ) : null}
+          </View>
+        </ScrollView>
+      </View>
+    </Modal>
+  );
+}
+
+const styles = StyleSheet.create({
+  sheet: { flex: 1 },
+  header: {
+    flexDirection: "row",
+    alignItems: "center",
+    justifyContent: "space-between",
+    paddingHorizontal: 20,
+    paddingVertical: 8,
+  },
+  title: { fontSize: 18, fontWeight: "600" },
+  content: { paddingHorizontal: 20, paddingBottom: 32, gap: 12 },
+  summary: { fontSize: 13, lineHeight: 18 },
+  card: {
+    borderRadius: 16,
+    borderCurve: "continuous",
+    borderWidth: StyleSheet.hairlineWidth,
+    paddingHorizontal: 14,
+  },
+  row: {
+    flexDirection: "row",
+    alignItems: "center",
+    justifyContent: "space-between",
+    gap: 12,
+    paddingVertical: 12,
+    borderTopWidth: StyleSheet.hairlineWidth,
+  },
+  rowLabel: { ...typeScale.secondary },
+  rowValue: { flexShrink: 1, ...typeScale.secondary, fontWeight: "500", textAlign: "right" },
+  empty: { paddingVertical: 14, ...typeScale.secondary },
+  disk: { gap: 8 },
+  diskTrack: { height: 8, borderRadius: 4, overflow: "hidden" },
+  diskFill: { height: 8, borderRadius: 4 },
+  diskNote: { fontSize: 12, lineHeight: 16 },
+  actions: { flexDirection: "row", flexWrap: "wrap", gap: 10, paddingTop: 4 },
+});
