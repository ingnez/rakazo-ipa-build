@@ -0,0 +1,157 @@
+import { describe, expect, it } from "vitest";
+import { LUMEN_EMBLEMS } from "./lumen-emblems.js";
+import {
+  LUMEN_TEAM,
+  lumenActionFor,
+  lumenColorOf,
+  lumenEmblemForName,
+  lumenFrame,
+  lumenLookFor,
+  lumenLookValue,
+  lumenMix,
+  lumenTheme,
+  lumenViewBox,
+  parseLumenLook,
+} from "./lumen-avatar.js";
+
+describe("the emblem a name earns", () => {
+  it("matches the role word the designer wrote into the library", () => {
+    expect(lumenEmblemForName("开发助理")?.id).toBe("e001");
+    expect(lumenEmblemForName("生活助理")?.id).toBe("e201");
+    expect(lumenEmblemForName("运维助理")?.id).toBe("e021");
+    expect(lumenEmblemForName("刷题教练")?.id).toBe("e081");
+  });
+
+  it("finds a mark for a role nobody drew, from the word itself", () => {
+    const emblem = lumenEmblemForName("咖啡师");
+    expect(emblem).not.toBeNull();
+    expect(emblem!.d.length).toBeGreaterThan(0);
+  });
+
+  it("gives up on a name with nothing to match rather than pick a random mark", () => {
+    expect(lumenEmblemForName("")).toBeNull();
+  });
+
+  it("holds all 247 marks, every one with a path", () => {
+    expect(LUMEN_EMBLEMS).toHaveLength(247);
+    for (const emblem of LUMEN_EMBLEMS) {
+      expect(emblem.d.length).toBeGreaterThan(4);
+      expect(emblem.id).toMatch(/^e\d{3}$/);
+    }
+  });
+});
+
+describe("a bot's look", () => {
+  it("keeps the team's own colour, and the main bot wears the crown", () => {
+    const chief = lumenLookFor({ name: "小猪包", identity: "bot-1" });
+    expect(chief.role).toBe("chief");
+    expect(chief.color).toBe("#D8B878");
+    expect(chief.emblem).toBeNull();
+    expect(lumenViewBox(chief.role).h).toBe(560);
+  });
+
+  it("draws a stored colour and the emblem the person picked", () => {
+    const look = lumenLookFor({
+      name: "随便",
+      identity: "bot-2",
+      value: lumenLookValue("#3DD6F5", "e341"),
+    });
+    expect(look.color).toBe("#3DD6F5");
+    expect(look.emblem?.id).toBe("e341");
+    expect(look.source).toBe("stored");
+  });
+
+  it("gives an unnamed placeholder a real mark instead of a question mark", () => {
+    const placeholder = lumenLookFor({});
+    expect(placeholder.initial).toBeNull();
+    expect(placeholder.emblem?.id).toBe("e012");
+    expect(lumenLookFor({ name: "   " }).emblem?.id).toBe("e012");
+  });
+
+  it("falls back from a name to the id, so the mark is stable", () => {
+    const first = lumenLookFor({ name: "x", identity: "bot-with-no-role" });
+    const again = lumenLookFor({ name: "x", identity: "bot-with-no-role" });
+    expect(first.emblem?.id).toBe(again.emblem?.id);
+  });
+
+  it("round-trips a look through the stored value", () => {
+    const value = lumenLookValue("#B0415A", "e341");
+    expect(value).toBe("#B0415A::lumen_e341");
+    expect(parseLumenLook(value)).toEqual({ color: "#B0415A", emblemId: "e341" });
+    expect(lumenColorOf(value)).toBe("#B0415A");
+    expect(parseLumenLook("#B0415A")).toEqual({ color: "#B0415A", emblemId: null });
+  });
+
+  it("keeps a photo a bot was given, and never reads it as a colour", () => {
+    const photo = "data:image/png;base64,AAAA";
+    expect(lumenColorOf(photo, "#D8B878")).toBe("#D8B878");
+    expect(lumenLookFor({ name: "照片", identity: "p", value: photo }).color).toMatch(/^#/);
+  });
+});
+
+describe("the states", () => {
+  it("breathes on a three second loop, and loops back to where it started", () => {
+    const start = lumenFrame("idle", 0, "#3DD6F5");
+    const three = lumenFrame("idle", 3, "#3DD6F5");
+    expect(three.lift).toBeCloseTo(start.lift, 5);
+    expect(lumenFrame("idle", 0.75, "#3DD6F5").lift).not.toBeCloseTo(start.lift, 2);
+  });
+
+  it("turns cold blue to think and dims to sleep", () => {
+    expect(lumenFrame("think", 0.4, "#3DD6F5").c).toBe("#8FA8FF");
+    const sleep = lumenFrame("sleep", 1.2, "#3DD6F5");
+    expect(sleep.dim).toBe(1);
+    expect(sleep.eyeH).toBeLessThan(10);
+    expect(sleep.crownOp).toBeLessThan(1);
+  });
+
+  it("lights the crown tips left to right as work goes on", () => {
+    const early = lumenFrame("work", 0.3, "#D8B878").tips;
+    const late = lumenFrame("work", 2.4, "#D8B878").tips;
+    expect(early[0]!).toBeGreaterThan(early[4]!);
+    expect(late[4]!).toBeGreaterThan(early[4]!);
+  });
+
+  it("wince, tilt the crown and tear the ring when something fails", () => {
+    const error = lumenFrame("error", 1.4, "#3A6DF0");
+    expect(error.eyeSlash).toBeGreaterThan(0.5);
+    expect(error.crownRot).toBeLessThan(0);
+    expect(error.ringGap).toBeGreaterThan(0);
+    expect(error.bangOn).toBeGreaterThan(0);
+  });
+
+  it("settles back to the resting pose at the end of a finished turn", () => {
+    const happy = lumenFrame("happy", 0.5, "#2FBF8F");
+    expect(happy.eyeArc).toBeGreaterThan(0.5);
+    expect(happy.tips[0]!).toBeGreaterThan(1);
+  });
+
+  it("maps the app's run signals onto the seven states", () => {
+    expect(lumenActionFor({ status: "running" })).toBe("work");
+    expect(lumenActionFor({ activity: "thinking" })).toBe("think");
+    expect(lumenActionFor({ activity: "done" })).toBe("happy");
+    expect(lumenActionFor({ status: "failed" })).toBe("error");
+    expect(lumenActionFor({ composing: true })).toBe("work");
+    expect(lumenActionFor({})).toBe("idle");
+  });
+});
+
+describe("materials", () => {
+  it("presses the glow down and adds an outline on the light page", () => {
+    const dark = lumenTheme(true);
+    const light = lumenTheme(false);
+    expect(dark.haloOp).toBeGreaterThan(light.haloOp);
+    expect(light.outline).not.toBeNull();
+    expect(dark.outline).toBeNull();
+  });
+
+  it("mixes two colours the way the design's own engine does", () => {
+    expect(lumenMix("#000000", "#FFFFFF", 0.5)).toBe("#808080");
+    expect(lumenMix("#3DD6F5", "#3DD6F5", 1)).toBe("#3dd6f5");
+  });
+
+  it("keeps the ten team colours distinct", () => {
+    const colours = new Set(LUMEN_TEAM.map((bot) => bot.color.toLowerCase()));
+    expect(colours.size).toBe(LUMEN_TEAM.length);
+  });
+});
