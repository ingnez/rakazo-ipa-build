diff --git a/apps/mobile/components/onboarding/tour-stage.tsx b/apps/mobile/components/onboarding/tour-stage.tsx
new file mode 100644
index 0000000..efca673
--- /dev/null
+++ b/apps/mobile/components/onboarding/tour-stage.tsx
@@ -0,0 +1,252 @@
+import { useEffect, useRef, useState } from "react";
+import { StyleSheet, Text, View } from "react-native";
+import Animated, {
+  Easing,
+  useAnimatedStyle,
+  useReducedMotion,
+  useSharedValue,
+  withSequence,
+  withSpring,
+  withTiming,
+} from "react-native-reanimated";
+import type { SharedValue } from "react-native-reanimated";
+import { mobileTokens } from "../../lib/appearance";
+import { useThemedStyles } from "../../lib/native";
+import { BotAvatar } from "../bot-avatar";
+import { SandPage } from "../sand";
+import { NativeActionButton } from "../native-action-button";
+
+/**
+ * The reference app's stage, in its own measurements: a 300×440 window onto the one thing this
+ * product is — a Bot that works while you watch.
+ */
+const STAGE_WIDTH = 300;
+const STAGE_HEIGHT = 440;
+
+/** Every movement in the opening, at the length the reference app gives it. */
+const GATHER_MS = 700;
+const MARK_GLIDE_MS = 480;
+const MARK_GLIDE_DELAY_MS = 120;
+const ARRIVAL_MS = 260;
+const ARRIVAL_HOLD_MS = 400;
+const WORD_STAGGER_MS = 50;
+const REVEAL_DELAY_MS = 180;
+const START_SCALE = 0.94;
+
+/** The line the Bot writes into the demo composer, one word at a time. */
+const DEMO_WORDS = ["把", "这", "周", "的", "报", "表", "整", "理", "好"];
+/** What the routine label says under the stage once the words are in. */
+const ROUTINE_LABEL = "例程 · 每周五 18:00";
+
+const PARTICLES = 14;
+
+/**
+ * The opening, as the reference app plays it: particles gather into the Bot, the Bot flies out of
+ * the computer onto the composer, the question is typed word by word, and the screen that names
+ * the product rises into place.
+ *
+ * It explains the product before it asks for anything: what you see is one request, the Bot doing
+ * the work on a computer, and the answer coming back to the same composer. Nothing here is a
+ * screenshot; every part of it is drawn and timed.
+ */
+export function TourStage({ onDone }: { onDone: () => void }) {
+  const styles = useThemedStyles(createStageStyles);
+  const tokens = mobileTokens();
+  const reduceMotion = useReducedMotion();
+  const [words, setWords] = useState(reduceMotion ? DEMO_WORDS.length : 0);
+  const [revealed, setRevealed] = useState(reduceMotion);
+  const [flew, setFlew] = useState(reduceMotion);
+  const timers = useRef<ReturnType<typeof setTimeout>[]>([]);
+  const gather = useSharedValue(reduceMotion ? 1 : 0);
+  const flight = useSharedValue(reduceMotion ? 1 : 0);
+  const copyRise = useSharedValue(reduceMotion ? 1 : 0);
+
+  useEffect(() => {
+    if (reduceMotion) return;
+    const after = (delay: number, run: () => void) => {
+      timers.current.push(setTimeout(run, delay));
+    };
+    // The particles converge, the Bot is there, and then it leaves the computer for the composer.
+    gather.value = withTiming(1, { duration: GATHER_MS, easing: Easing.out(Easing.quad) });
+    after(GATHER_MS + MARK_GLIDE_DELAY_MS, () => {
+      setFlew(true);
+      flight.value = withSequence(
+        withTiming(1, { duration: MARK_GLIDE_MS, easing: Easing.bezier(0.2, 0.8, 0.2, 1) }),
+        withSpring(1.06, { duration: ARRIVAL_MS }),
+        withTiming(1, { duration: ARRIVAL_HOLD_MS }),
+      );
+    });
+    const typingStarts = GATHER_MS + MARK_GLIDE_DELAY_MS + MARK_GLIDE_MS + ARRIVAL_MS;
+    DEMO_WORDS.forEach((_, index) => {
+      after(typingStarts + (index + 1) * WORD_STAGGER_MS, () => setWords(index + 1));
+    });
+    const revealedAt = typingStarts + DEMO_WORDS.length * WORD_STAGGER_MS + REVEAL_DELAY_MS;
+    after(revealedAt, () => {
+      setRevealed(true);
+      copyRise.value = withTiming(1, { duration: 420, easing: Easing.out(Easing.cubic) });
+    });
+    return () => {
+      for (const timer of timers.current) clearTimeout(timer);
+      timers.current = [];
+    };
+  }, [reduceMotion, gather, flight, copyRise]);
+
+  const markStyle = useAnimatedStyle(() => ({
+    // From the computer's screen, down onto the composer: two thirds of the stage's height.
+    transform: [{ translateY: flight.value * STAGE_HEIGHT * 0.36 }, { scale: 1 + (flight.value > 1 ? 0.06 : 0) }],
+  }));
+  const computerStyle = useAnimatedStyle(() => ({ opacity: 1 - flight.value * 0.15 }));
+  const copyStyle = useAnimatedStyle(() => ({
+    opacity: copyRise.value,
+    transform: [{ translateY: (1 - copyRise.value) * 12 }, { scale: START_SCALE + copyRise.value * (1 - START_SCALE) }],
+  }));
+
+  return (
+    <SandPage
+      body="scroll"
+      tone="sheet"
+      accessibilityLabel="开场"
+      footer={
+        <NativeActionButton
+          fill
+          label="开始使用"
+          onPress={onDone}
+          style={{ borderRadius: 26 }}
+        />
+      }
+    >
+      <View style={styles.stageFrame}>
+        <View style={styles.stage}>
+          {/* The particles that gather into the Bot: each one travels the last stretch of its own
+              path as the Bot appears, so the Bot is made of them rather than dropped in. */}
+          {Array.from({ length: PARTICLES }, (_, index) => {
+            const angle = (index / PARTICLES) * Math.PI * 2;
+            return (
+              <Particle
+                key={index}
+                progress={gather}
+                fromX={Math.cos(angle) * 92}
+                fromY={Math.sin(angle) * 92}
+                color={index % 3 === 0 ? tokens.foreground : tokens.mutedForeground}
+              />
+            );
+          })}
+          <Animated.View style={[styles.computer, computerStyle]}>
+            <View style={styles.computerScreen}>
+              <View style={styles.computerLine} />
+              <View style={[styles.computerLine, styles.computerLineShort]} />
+              <View style={[styles.computerLine, styles.computerLineShorter]} />
+            </View>
+            <View style={styles.computerFoot} />
+          </Animated.View>
+          <Animated.View style={[styles.mark, markStyle]}>
+            <BotAvatar color="#FFAF38" motion="running" size={84} />
+          </Animated.View>
+          {/* The composer the Bot lands on, drawn as the chat's own bar. */}
+          <View style={styles.composer}>
+            <View style={styles.composerPlus} />
+            <Text numberOfLines={1} style={styles.composerLine}>
+              {DEMO_WORDS.slice(0, words).join("")}
+              {words < DEMO_WORDS.length && !reduceMotion ? "▍" : ""}
+            </Text>
+            <View style={styles.composerSend} />
+          </View>
+        </View>
+      </View>
+      <Animated.View style={[styles.copy, copyStyle]}>
+        <Text style={styles.heading}>你的 Bot，随时开工</Text>
+        <Text style={styles.body}>说一句话，它在自己的电脑上把活干完，再把结果放回这个对话框。</Text>
+        {revealed ? <Text style={styles.routine}>{ROUTINE_LABEL}</Text> : null}
+      </Animated.View>
+    </SandPage>
+  );
+}
+
+/** One grain of the gather: a dot that travels in and fades as the Bot takes its place. */
+function Particle({
+  progress,
+  fromX,
+  fromY,
+  color,
+}: {
+  progress: SharedValue<number>;
+  fromX: number;
+  fromY: number;
+  color: string;
+}) {
+  const styles = useThemedStyles(createStageStyles);
+  const style = useAnimatedStyle(() => ({
+    opacity: 1 - progress.value,
+    transform: [
+      { translateX: fromX * (1 - progress.value) },
+      { translateY: fromY * (1 - progress.value) },
+      { scale: 1 - progress.value * 0.4 },
+    ],
+  }));
+  return <Animated.View style={[styles.particle, { backgroundColor: color }, style]} />;
+}
+
+function createStageStyles() {
+  const tokens = mobileTokens();
+  return StyleSheet.create({
+    stageFrame: { alignItems: "center", paddingTop: 8 },
+    stage: {
+      width: STAGE_WIDTH,
+      height: STAGE_HEIGHT,
+      alignItems: "center",
+      justifyContent: "center",
+    },
+    particle: { position: "absolute", width: 6, height: 6, borderRadius: 3 },
+    computer: { position: "absolute", top: 24, alignItems: "center" },
+    computerScreen: {
+      width: 148,
+      height: 96,
+      borderRadius: 10,
+      borderCurve: "continuous",
+      borderWidth: 2,
+      borderColor: tokens.border,
+      padding: 12,
+      gap: 7,
+      justifyContent: "center",
+    },
+    computerLine: { height: 5, borderRadius: 3, backgroundColor: tokens.muted },
+    computerLineShort: { width: "72%" },
+    computerLineShorter: { width: "48%" },
+    computerFoot: {
+      width: 54,
+      height: 5,
+      borderBottomLeftRadius: 4,
+      borderBottomRightRadius: 4,
+      backgroundColor: tokens.border,
+    },
+    mark: { position: "absolute", top: 70 },
+    composer: {
+      position: "absolute",
+      bottom: 40,
+      left: 0,
+      right: 0,
+      height: 50,
+      flexDirection: "row",
+      alignItems: "center",
+      gap: 10,
+      paddingHorizontal: 10,
+      borderRadius: 25,
+      borderWidth: 1,
+      borderColor: tokens.border,
+      backgroundColor: tokens.card,
+    },
+    composerPlus: { width: 26, height: 26, borderRadius: 13, backgroundColor: tokens.muted },
+    composerLine: { flex: 1, color: tokens.foreground, fontSize: 15 },
+    composerSend: { width: 26, height: 26, borderRadius: 13, backgroundColor: tokens.foreground },
+    copy: { alignItems: "center", gap: 8, paddingHorizontal: 8 },
+    heading: { color: tokens.foreground, fontSize: 24, fontWeight: "700", textAlign: "center" },
+    body: {
+      color: tokens.mutedForeground,
+      fontSize: 15,
+      lineHeight: 21,
+      textAlign: "center",
+      maxWidth: 320,
+    },
+    routine: { color: tokens.mutedForeground, fontSize: 13, marginTop: 2 },
+  });
+}
