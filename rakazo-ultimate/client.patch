+import { artifactPreviewKind } from "@rakazo/contracts";
+import { splitFileName } from "./file-name";
+
+/**
+ * What a chat's file card can show of the file itself before it is opened: the opening of a text
+ * file set like a page, the first page of a PDF, or the first page of an Office document drawn by
+ * the system's own reader. A file whose bytes are not words — an installer, an archive — answers
+ * `none` and keeps the compact card it had, so the chat never shows a blank white sheet or a line
+ * of mojibake.
+ */
+export type FilePreviewKind = "text" | "pdf" | "office" | "none";
+
+/**
+ * How much of a text file the card reads. The paper shows about a dozen lines, and a fourth of
+ * this is already past the fold: reading more would cost the kind of file that is a log.
+ */
+export const PREVIEW_TEXT_MAX_CHARS = 2400;
+
+/** Past this the card does not read a text file at all: a 3 MB document is not a card's business. */
+export const PREVIEW_TEXT_MAX_BYTES = 512 * 1024;
+
+/** A PDF is read as a whole file before its first page can be drawn, so its own ceiling is low. */
+export const PREVIEW_PDF_MAX_BYTES = 8 * 1024 * 1024;
+
+/**
+ * A deck or a workbook is opened by the system's reader to draw one page, which is slower and
+ * hungrier than a PDF page, so a document past this size keeps its compact row.
+ */
+export const PREVIEW_OFFICE_MAX_BYTES = 16 * 1024 * 1024;
+
+/**
+ * The documents Quick Look draws a page of, by type and by name. Only the first page is drawn:
+ * the card is a preview, and the tap opens the file itself in the system viewer.
+ */
+const OFFICE_MIME_TYPES = new Set([
+  "application/msword",
+  "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
+  "application/vnd.ms-excel",
+  "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
+  "application/vnd.ms-powerpoint",
+  "application/vnd.openxmlformats-officedocument.presentationml.presentation",
+  "application/vnd.oasis.opendocument.text",
+  "application/vnd.oasis.opendocument.spreadsheet",
+  "application/vnd.oasis.opendocument.presentation",
+  "application/vnd.apple.pages",
+  "application/vnd.apple.numbers",
+  "application/vnd.apple.keynote",
+]);
+
+const OFFICE_EXTENSIONS = new Set([
+  "doc",
+  "docx",
+  "dot",
+  "dotx",
+  "ppt",
+  "pptx",
+  "pps",
+  "ppsx",
+  "xls",
+  "xlsx",
+  "xlsm",
+  "pages",
+  "numbers",
+  "key",
+  "odt",
+  "ods",
+  "odp",
+  "rtf",
+]);
+
+/** How much of a document the card shows, in points: roughly twelve lines on the paper. */
+export const PREVIEW_PAPER_HEIGHT = 236;
+
+/**
+ * Names that are text even when the sender calls them plain bytes. `.md` also covers a Markdown
+ * file uploaded from a phone that had no type for it, and `.log` is what a bot writes a run into.
+ */
+const TEXT_EXTENSIONS = new Set([
+  "md",
+  "markdown",
+  "mdx",
+  "txt",
+  "text",
+  "json",
+  "jsonl",
+  "csv",
+  "tsv",
+  "log",
+  "py",
+  "ts",
+  "tsx",
+  "js",
+  "jsx",
+  "mjs",
+  "cjs",
+  "html",
+  "htm",
+  "xml",
+  "yaml",
+  "yml",
+  "toml",
+  "ini",
+  "cfg",
+  "conf",
+  "env",
+  "sh",
+  "bash",
+  "zsh",
+  "sql",
+  "css",
+  "scss",
+  "go",
+  "rs",
+  "java",
+  "kt",
+  "swift",
+  "c",
+  "h",
+  "cpp",
+  "hpp",
+  "m",
+  "rb",
+  "php",
+  "lua",
+  "r",
+  "pl",
+  "tex",
+  "srt",
+  "vtt",
+]);
+
+/**
+ * The formats whose lines are read as code: drawn in the app's monospaced face and never run
+ * through the Markdown rules, because a leading `#` in a shell script is a comment, not a title.
+ */
+const MONO_EXTENSIONS = new Set([
+  "json",
+  "jsonl",
+  "ts",
+  "tsx",
+  "js",
+  "jsx",
+  "mjs",
+  "cjs",
+  "xml",
+  "yaml",
+  "yml",
+  "toml",
+  "ini",
+  "cfg",
+  "conf",
+  "env",
+  "sh",
+  "bash",
+  "zsh",
+  "sql",
+  "css",
+  "scss",
+  "go",
+  "rs",
+  "java",
+  "kt",
+  "swift",
+  "c",
+  "h",
+  "cpp",
+  "hpp",
+  "m",
+  "rb",
+  "php",
+  "lua",
+  "r",
+  "pl",
+  "py",
+]);
+
+/** One line of the page as the card sets it, with the weight its place in the document earns. */
+export type PreviewBlock = {
+  kind: "heading" | "subheading" | "body" | "bullet" | "quote" | "code" | "rule";
+  text: string;
+};
+
+/** The extension a name carries, lower-cased; empty when the name has none. */
+export function fileExtension(name: string): string {
+  return splitFileName(name).extension?.toLowerCase() ?? "";
+}
+
+/**
+ * How this file's card can show its content. The server's own type decides first — it is what the
+ * full preview opens with, so a card that previews more than the viewer is a card that lies — and
+ * the name is the fallback for a sender that had no type to give.
+ */
+export function filePreviewKind(mimeType: string, name = ""): FilePreviewKind {
+  const extension = fileExtension(name);
+  switch (artifactPreviewKind(mimeType)) {
+    case "markdown":
+    case "text":
+    case "html":
+      return "text";
+    case "pdf":
+      return "pdf";
+    case "image":
+    case "video":
+      return "none";
+    case "none":
+      // The server calls a document plain bytes, which is right: its content is not words. Its
+      // page still can be drawn, so a deck or a workbook keeps the card that shows one.
+      if (isOfficeMimeType(mimeType) || OFFICE_EXTENSIONS.has(extension)) return "office";
+      return TEXT_EXTENSIONS.has(extension) ? "text" : "none";
+  }
+}
+
+/** Whether this file is one the system's reader draws a page of. */
+export function isOfficeMimeType(mimeType: string): boolean {
+  return OFFICE_MIME_TYPES.has(mimeType.split(";")[0]?.trim().toLowerCase() ?? "");
+}
+
+/** The most bytes a card will read for this kind of preview; past it the card stays compact. */
+export function previewMaxBytes(kind: FilePreviewKind): number {
+  if (kind === "pdf") return PREVIEW_PDF_MAX_BYTES;
+  if (kind === "office") return PREVIEW_OFFICE_MAX_BYTES;
+  return PREVIEW_TEXT_MAX_BYTES;
+}
+
+/**
+ * Whether this file's lines belong in the monospaced face. A page is prose once its tags are off,
+ * so HTML is set as prose even though its source is code.
+ */
+export function previewIsMonospaced(mimeType: string, name = ""): boolean {
+  if (artifactPreviewKind(mimeType) === "html") return false;
+  return MONO_EXTENSIONS.has(fileExtension(name));
+}
+
+/** The tags a page's words hide behind: HTML is shown by its text, never by its markup. */
+function htmlText(html: string): string {
+  return html
+    .replace(/<!--[\s\S]*?-->/g, " ")
+    .replace(/<(script|style)\b[\s\S]*?<\/\1>/gi, " ")
+    // A page's own headings keep their rank: `<h1>` reads as `#` before the tags come off.
+    .replace(/<h([1-6])\b[^>]*>/gi, (_, level: string) => `\n${"#".repeat(Number(level))} `)
+    .replace(/<\/(p|div|li|h[1-6]|tr|section|article|header|footer)>/gi, "\n")
+    .replace(/<br\s*\/?>/gi, "\n")
+    .replace(/<[^>]+>/g, " ")
+    .replace(/&nbsp;/gi, " ")
+    .replace(/&amp;/gi, "&")
+    .replace(/&lt;/gi, "<")
+    .replace(/&gt;/gi, ">")
+    .replace(/&quot;/gi, '"')
+    .replace(/&#39;/gi, "'")
+    .replace(/&#(\d+);/g, (_, code: string) => String.fromCharCode(Number(code)));
+}
+
+/**
+ * The Markdown a line wears, taken off: emphasis, links, inline code and stray tags. A pair of
+ * markers is only a pair — an underscore inside `file_name` or a lone `*` stays the word it is.
+ */
+function plainLine(line: string): string {
+  return line
+    .replace(/!\[([^\]]*)\]\([^)]*\)/g, "$1")
+    .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
+    .replace(/<\/?[a-z][^>]*>/gi, "")
+    .replace(/`+([^`]*)`+/g, "$1")
+    .replace(/\*\*([^*]+)\*\*/g, "$1")
+    .replace(/__([^_]+)__/g, "$1")
+    .replace(/(^|[\s(（[【"“‘])[*_]([^*_\n]+?)[*_](?=$|[\s)）\]】"”’。，、：；！？!?,.;:])/g, "$1$2")
+    .replace(/\\([\\`*_{}[\]()#+\-.!])/g, "$1")
+    .replace(/\s+/g, " ")
+    .trim();
+}
+
+/** A table row as one line of facts: `| a | b |` reads as `a · b`. */
+function tableRow(line: string): string {
+  return line
+    .replace(/^\||\|$/g, "")
+    .split("|")
+    .map((cell) => cell.trim())
+    .filter(Boolean)
+    .join(" · ");
+}
+
+/**
+ * A text file's opening, as the lines the card sets — the title it carries set apart, its list
+ * items kept as items, and its markup taken off so the first lines read as the document does.
+ * Never more than `maxBlocks`, because the paper is clipped anyway and a long file would build a
+ * thousand views the chat would later lay out on every scroll.
+ */
+export function previewBlocks(
+  text: string,
+  options: { mimeType?: string; name?: string; maxBlocks?: number } = {},
+): PreviewBlock[] {
+  const limit = options.maxBlocks ?? 40;
+  const source = text.startsWith("\ufeff") ? text.slice(1) : text;
+  const body = artifactPreviewKind(options.mimeType ?? "") === "html" ? htmlText(source) : source;
+  const lines = body.replace(/\r\n?/g, "\n").split("\n");
+  const mono = previewIsMonospaced(options.mimeType ?? "", options.name ?? "");
+  const blocks: PreviewBlock[] = [];
+  let fenced = false;
+  for (const raw of lines) {
+    if (blocks.length >= limit) break;
+    const line = raw.replace(/\t/g, "  ").trimEnd();
+    if (/^\s*(```|~~~)/.test(line)) {
+      fenced = !fenced;
+      continue;
+    }
+    if (fenced) {
+      if (line.trim()) blocks.push({ kind: "code", text: line.trim() });
+      continue;
+    }
+    if (!line.trim()) continue;
+    if (/^\s*([-*_]\s*){3,}$/.test(line)) {
+      blocks.push({ kind: "rule", text: "" });
+      continue;
+    }
+    if (mono) {
+      blocks.push({ kind: "code", text: line.trim() });
+      continue;
+    }
+    const heading = /^(#{1,6})\s+(.*)$/.exec(line);
+    if (heading) {
+      const level = heading[1]?.length ?? 1;
+      const title = plainLine(heading[2] ?? "");
+      if (title) blocks.push({ kind: level <= 2 ? "heading" : "subheading", text: title });
+      continue;
+    }
+    // A whole line in bold is a section of its own: documents that write their titles that way
+    // (rather than with `##`) read as the same page once the marks are taken off.
+    const boldLine = /^(\*\*|__)(.+?)\1[:：]?$/.exec(line.trim());
+    if (boldLine) {
+      const title = plainLine(line);
+      if (title) blocks.push({ kind: "subheading", text: title });
+      continue;
+    }
+    if (/^\s*\|.*\|\s*$/.test(line)) {
+      const row = plainLine(tableRow(line));
+      if (row) blocks.push({ kind: "body", text: row });
+      continue;
+    }
+    const quote = /^\s*>\s?(.*)$/.exec(line);
+    if (quote) {
+      const quoted = plainLine(quote[1] ?? "");
+      if (quoted) blocks.push({ kind: "quote", text: quoted });
+      continue;
+    }
+    const ordered = /^\s*(\d{1,2})[.)]\s+(.*)$/.exec(line);
+    if (ordered) {
+      const item = plainLine(ordered[2] ?? "");
+      if (item) blocks.push({ kind: "bullet", text: `${ordered[1]}. ${item}` });
+      continue;
+    }
+    const unordered = /^\s*[-*+•]\s+(.*)$/.exec(line);
+    if (unordered) {
+      const item = plainLine(unordered[1] ?? "");
+      if (item) blocks.push({ kind: "bullet", text: `• ${item}` });
+      continue;
+    }
+    const paragraph = plainLine(line);
+    if (paragraph) blocks.push({ kind: "body", text: paragraph });
+  }
+  return blocks;
+}
