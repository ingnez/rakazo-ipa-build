+
+  it("fetches the strip's pictures from the current one outward", () => {
+    const gallery = ["a", "b", "c", "d", "e"].map((id) => ({ artifactId: id }));
+    expect(galleryNeighbourOrder(gallery, 2).map((item) => item.artifactId)).toEqual([
+      "c",
+      "b",
+      "d",
+      "a",
+      "e",
+    ]);
+    expect(galleryNeighbourOrder(gallery, 0).map((item) => item.artifactId)).toEqual([
+      "a",
+      "b",
+      "c",
+      "d",
+      "e",
+    ]);
+    expect(galleryNeighbourOrder(gallery, 99).map((item) => item.artifactId)[0]).toBe("e");
+    // A repeated id keeps its first place, so no picture is read twice.
+    expect(
+      galleryNeighbourOrder(
+        [
+          { artifactId: "a" },
+          { artifactId: "a" },
+          { artifactId: "b" },
