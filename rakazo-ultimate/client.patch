+import { describe, expect, it } from "vitest";
+import {
+  HERO_AVATAR_SIZE,
+  homeHeroNameStateDot,
+  mainBotBadgeLayout,
+  placeAvatarBadges,
+  styleForAvatarBadgeCorner,
+} from "./avatar-badges.js";
+
+describe("placeAvatarBadges", () => {
+  it("puts only the main-bot star at bottom-end on the home hero, even when the bot is working, unread, or muted", () => {
+    expect(
+      placeAvatarBadges("home-hero", { main: true, working: true, muted: true }),
+    ).toEqual([
+      { kind: "main", corner: "bottom-end" },
+      { kind: "muted", corner: "top-end" },
+    ]);
+    expect(placeAvatarBadges("home-hero", { main: true, working: true })).toEqual([
+      { kind: "main", corner: "bottom-end" },
+    ]);
+  });
+
+  it("shows no working/online dot on home list rows; a muted badge keeps bottom-end", () => {
+    expect(placeAvatarBadges("home-list", { working: true })).toEqual([]);
+    expect(placeAvatarBadges("home-list", { working: true, muted: true })).toEqual([
+      { kind: "muted", corner: "bottom-end" },
+    ]);
+  });
+
+  it("keeps the working dot at bottom-end on chat and other surfaces, and moves it when muted occupies that corner", () => {
+    expect(placeAvatarBadges("chat", { working: true })).toEqual([
+      { kind: "working", corner: "bottom-end" },
+    ]);
+    expect(placeAvatarBadges("default", { working: true, muted: true })).toEqual([
+      { kind: "muted", corner: "bottom-end" },
+      { kind: "working", corner: "bottom-start" },
+    ]);
+  });
+
+  it("never places two badges in the same corner", () => {
+    const cases = [
+      placeAvatarBadges("home-hero", { main: true, working: true, muted: true }),
+      placeAvatarBadges("home-list", { working: true, muted: true }),
+      placeAvatarBadges("chat", { working: true, muted: true }),
+      placeAvatarBadges("default", { main: true, working: true, muted: true }),
+    ];
+    for (const badges of cases) {
+      const corners = badges.map((badge) => badge.corner);
+      expect(corners).toEqual([...new Set(corners)]);
+    }
+  });
+});
+
+describe("home hero chrome", () => {
+  it("never returns a state dot to sit after the name", () => {
+    expect(homeHeroNameStateDot()).toBeNull();
+  });
+
+  it("keeps the yellow star at the lower right of a hero-sized avatar", () => {
+    const badge = mainBotBadgeLayout(HERO_AVATAR_SIZE);
+    expect(badge.color.toLowerCase()).toBe("#ffd600");
+    expect(badge.size).toBeGreaterThan(20);
+    expect(badge.size).toBeLessThan(32);
+    expect(badge.end).toBeLessThan(2);
+    expect(badge.bottom).toBeLessThan(0);
+    expect(badge.icon).toBeGreaterThan(10);
+    expect(styleForAvatarBadgeCorner("bottom-end", { end: 6, start: 0, bottom: 4 })).toEqual({
+      end: 6,
+      bottom: 4,
+    });
+    expect(styleForAvatarBadgeCorner("bottom-start", { end: 3, start: 4, bottom: 10 })).toEqual({
+      start: 4,
+      bottom: 10,
+    });
+    expect(styleForAvatarBadgeCorner("top-end", { end: 2, start: 0, bottom: 10, top: 2 })).toEqual({
+      end: 2,
+      top: 2,
+    });
+  });
+});
