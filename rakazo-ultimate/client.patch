+import { describe, expect, it } from "vitest";
+import {
+  callRates,
+  decodeBase64,
+  encodeBase64,
+  parseRealtimeEvent,
+  realtimeSocketUrl,
+} from "./realtime-protocol";
+
+describe("realtime protocol", () => {
+  it("opens the gateway on the app's own server, over a socket scheme", () => {
+    expect(realtimeSocketUrl("https://rakazo.163ll.com", "/api/voice/realtime?botId=b1")).toBe(
+      "wss://rakazo.163ll.com/api/voice/realtime?botId=b1",
+    );
+    expect(realtimeSocketUrl("http://relay.example.com:3425/", "/api/voice/realtime?botId=b1")).toBe(
+      "ws://relay.example.com:3425/api/voice/realtime?botId=b1",
+    );
+    expect(realtimeSocketUrl("https://rakazo.163ll.com", "api/voice/realtime")).toBe(
+      "wss://rakazo.163ll.com/api/voice/realtime",
+    );
+  });
+
+  it("reads the gateway's own frames, and ignores anything else", () => {
+    expect(parseRealtimeEvent('{"type":"ready","inputSampleRate":16000}')).toEqual({
+      type: "ready",
+      inputSampleRate: 16000,
+    });
+    expect(parseRealtimeEvent('{"type":"speech.start"}')).toEqual({ type: "speech.start" });
+    expect(parseRealtimeEvent('{"type":"user.text","text":"喂","final":false}')).toEqual({
+      type: "user.text",
+      text: "喂",
+      final: false,
+    });
+    expect(parseRealtimeEvent('{"type":"assistant.text","text":"在","final":true}')).toEqual({
+      type: "assistant.text",
+      text: "在",
+      final: true,
+    });
+    expect(
+      parseRealtimeEvent(
+        '{"type":"closed","reason":"hangup","durationSeconds":42,"turns":3,"transcriptWritten":true}',
+      ),
+    ).toEqual({
+      type: "closed",
+      reason: "hangup",
+      durationSeconds: 42,
+      turns: 3,
+      transcriptWritten: true,
+    });
+    expect(parseRealtimeEvent('{"type":"error","message":"Key 无权限","code":"forbidden"}')).toEqual(
+      { type: "error", message: "Key 无权限", code: "forbidden" },
+    );
+    expect(parseRealtimeEvent("not json")).toBeNull();
+    expect(parseRealtimeEvent('{"type":"something-new"}')).toBeNull();
+    expect(parseRealtimeEvent("[]")).toBeNull();
+  });
+
+  it("carries PCM bytes through base64 unchanged", () => {
+    const bytes = new Uint8Array([0, 1, 2, 250, 251, 252, 255, 0, 128, 64]);
+    expect(decodeBase64(encodeBase64(bytes))).toEqual(bytes);
+    // Whole groups, a trailing byte, and a trailing two bytes.
+    for (const length of [1, 2, 3, 640, 641, 960]) {
+      const pcm = Uint8Array.from({ length }, (_, index) => (index * 7) % 256);
+      expect(decodeBase64(encodeBase64(pcm))).toEqual(pcm);
+    }
+  });
+
+  it("takes the rates the ready frame repeats", () => {
+    const plan = {
+      callId: "c1",
+      botId: "b1",
+      threadId: "t1",
+      provider: "bailian-cn" as const,
+      providerName: "阿里百炼 Realtime · 北京",
+      model: "qwen3.8-omni-flash-realtime",
+      voice: "Tina",
+      inputSampleRate: 16000,
+      outputSampleRate: 24000,
+      audioFormat: "binary" as const,
+      path: "/api/voice/realtime?botId=b1",
+      maxDurationSeconds: 1800,
+    };
+    expect(callRates(plan)).toEqual({ inputSampleRate: 16000, outputSampleRate: 24000 });
+    expect(callRates(plan, { inputSampleRate: 24000 })).toEqual({
+      inputSampleRate: 24000,
+      outputSampleRate: 24000,
+    });
+  });
+});
diff --git a/apps/mobile/lib/realtime-protocol.ts b/apps/mobile/lib/realtime-protocol.ts
new file mode 100644
index 0000000..527e7a5
--- /dev/null
+++ b/apps/mobile/lib/realtime-protocol.ts
@@ -0,0 +1,169 @@
+import type { RealtimeCallPlan } from "@rakazo/contracts";
+
+/**
+ * The wire between the phone and the realtime voice gateway, kept plain so it can be read and
+ * tested without a socket or a speaker.
+ *
+ * One connection is one call. Audio goes down as raw PCM16 frames (or base64 in a JSON frame when
+ * the binary path is unavailable), and everything else is a small JSON text frame.
+ */
+
+export type RealtimeServerEvent =
+  | {
+      type: "ready";
+      callId?: string;
+      botId?: string;
+      threadId?: string;
+      provider?: string;
+      model?: string;
+      voice?: string;
+      inputSampleRate?: number;
+      outputSampleRate?: number;
+    }
+  | { type: "speech.start" }
+  | { type: "speech.stop" }
+  | { type: "response.start" }
+  | { type: "response.done" }
+  | { type: "playback.flush" }
+  | { type: "pong" }
+  | { type: "user.text"; text: string; final: boolean }
+  | { type: "assistant.text"; text: string; final: boolean }
+  | { type: "audio"; audio: string }
+  | { type: "error"; message: string; code?: string }
+  | {
+      type: "closed";
+      reason: string;
+      durationSeconds?: number;
+      turns?: number;
+      transcriptWritten?: boolean;
+      error?: string;
+    };
+
+/** The socket a call opens: `wss://<the app's server>${plan.path}`, with the app's own sign-in. */
+export function realtimeSocketUrl(apiBase: string, path: string): string {
+  const base = apiBase.replace(/\/+$/, "").replace(/^https:/i, "wss:").replace(/^http:/i, "ws:");
+  return `${base}${path.startsWith("/") ? path : `/${path}`}`;
+}
+
+/** One text frame from the gateway, or nothing when it is not a frame this app knows. */
+export function parseRealtimeEvent(raw: string): RealtimeServerEvent | null {
+  let value: unknown;
+  try {
+    value = JSON.parse(raw);
+  } catch {
+    return null;
+  }
+  if (!value || typeof value !== "object" || Array.isArray(value)) return null;
+  const frame = value as Record<string, unknown>;
+  const type = typeof frame.type === "string" ? frame.type : "";
+  const text = typeof frame.text === "string" ? frame.text : "";
+  switch (type) {
+    case "ready":
+      return {
+        type: "ready",
+        ...stringField(frame, "callId"),
+        ...stringField(frame, "botId"),
+        ...stringField(frame, "threadId"),
+        ...stringField(frame, "provider"),
+        ...stringField(frame, "model"),
+        ...stringField(frame, "voice"),
+        ...numberField(frame, "inputSampleRate"),
+        ...numberField(frame, "outputSampleRate"),
+      };
+    case "speech.start":
+    case "speech.stop":
+    case "response.start":
+    case "response.done":
+    case "playback.flush":
+    case "pong":
+      return { type };
+    case "user.text":
+      return { type, text, final: frame.final !== false };
+    case "assistant.text":
+      return { type, text, final: frame.final !== false };
+    case "audio":
+      return typeof frame.audio === "string" ? { type, audio: frame.audio } : null;
+    case "error":
+      return {
+        type,
+        message: typeof frame.message === "string" ? frame.message : "",
+        ...stringField(frame, "code"),
+      };
+    case "closed":
+      return {
+        type,
+        reason: typeof frame.reason === "string" ? frame.reason : "client-closed",
+        ...numberField(frame, "durationSeconds"),
+        ...numberField(frame, "turns"),
+        ...(typeof frame.transcriptWritten === "boolean"
+          ? { transcriptWritten: frame.transcriptWritten }
+          : {}),
+        ...stringField(frame, "error"),
+      };
+    default:
+      return null;
+  }
+}
+
+function stringField(frame: Record<string, unknown>, key: string): Record<string, string> {
+  const value = frame[key];
+  return typeof value === "string" ? { [key]: value } : {};
+}
+
+function numberField(frame: Record<string, unknown>, key: string): Record<string, number> {
+  const value = frame[key];
+  return typeof value === "number" && Number.isFinite(value) ? { [key]: value } : {};
+}
+
+const ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+const LOOKUP = (() => {
+  const table = new Uint8Array(128);
+  for (let index = 0; index < ALPHABET.length; index += 1) {
+    table[ALPHABET.charCodeAt(index)] = index;
+  }
+  return table;
+})();
+
+/** PCM bytes as the gateway's JSON frames carry them. */
+export function encodeBase64(bytes: Uint8Array): string {
+  let out = "";
+  for (let index = 0; index < bytes.length; index += 3) {
+    const first = bytes[index] ?? 0;
+    const second = index + 1 < bytes.length ? (bytes[index + 1] ?? 0) : 0;
+    const third = index + 2 < bytes.length ? (bytes[index + 2] ?? 0) : 0;
+    out += ALPHABET[first >> 2];
+    out += ALPHABET[((first & 3) << 4) | (second >> 4)];
+    out += index + 1 < bytes.length ? ALPHABET[((second & 15) << 2) | (third >> 6)] : "=";
+    out += index + 2 < bytes.length ? ALPHABET[third & 63] : "=";
+  }
+  return out;
+}
+
+/** The model's audio as it arrives in a `audioFormat: "json"` call. */
+export function decodeBase64(text: string): Uint8Array {
+  const clean = text.replace(/[^A-Za-z0-9+/]/g, "");
+  const out = new Uint8Array(Math.floor((clean.length * 3) / 4));
+  let written = 0;
+  let buffer = 0;
+  let bits = 0;
+  for (let index = 0; index < clean.length; index += 1) {
+    const value = LOOKUP[clean.charCodeAt(index)];
+    if (value === undefined) continue;
+    buffer = (buffer << 6) | value;
+    bits += 6;
+    if (bits >= 8) {
+      bits -= 8;
+      out[written] = (buffer >> bits) & 0xff;
+      written += 1;
+    }
+  }
+  return written === out.length ? out : out.slice(0, written);
+}
+
+/** The call's own plan carries the rates the phone must use; the `ready` frame repeats them. */
+export function callRates(plan: RealtimeCallPlan, ready?: { inputSampleRate?: number; outputSampleRate?: number }) {
+  return {
+    inputSampleRate: ready?.inputSampleRate ?? plan.inputSampleRate,
+    outputSampleRate: ready?.outputSampleRate ?? plan.outputSampleRate,
+  };
+}
