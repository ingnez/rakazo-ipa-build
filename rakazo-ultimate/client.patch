+import { describe, expect, it } from "vitest";
+import { resolveMainBot, serverMainBotId } from "./main-bot";
+
+const bot = (id: string, isMain = false) => ({ id, isMain });
+
+describe("resolveMainBot", () => {
+  it("follows the main bot the server names, over the one this device remembered", () => {
+    const bots = [bot("first"), bot("chief", true), bot("third")];
+    expect(resolveMainBot(bots, "third")?.id).toBe("chief");
+  });
+
+  it("falls back to the remembered bot while no roster has arrived", () => {
+    const bots = [bot("first"), bot("second")];
+    expect(resolveMainBot(bots, "second")?.id).toBe("second");
+  });
+
+  it("falls back to the first chat when the remembered bot is gone", () => {
+    expect(resolveMainBot([bot("first"), bot("second")], "deleted")?.id).toBe("first");
+  });
+
+  it("has nothing to show for an empty roster", () => {
+    expect(resolveMainBot([], "chief")).toBeUndefined();
+  });
+});
+
+describe("serverMainBotId", () => {
+  it("is the flagged bot, or null when the roster carries none", () => {
+    expect(serverMainBotId([bot("a"), bot("b", true)])).toBe("b");
+    expect(serverMainBotId([bot("a"), bot("b")])).toBeNull();
+    expect(serverMainBotId([])).toBeNull();
+  });
+});
diff --git a/apps/mobile/lib/main-bot.ts b/apps/mobile/lib/main-bot.ts
new file mode 100644
index 000000000..2b88ebc23
--- /dev/null
+++ b/apps/mobile/lib/main-bot.ts
@@ -0,0 +1,87 @@
+/**
+ * The bot shown at the top of the home screen. The roster's main bot lives on the server now
+ * (`bots.isMain`, set through `bots/setMain`), so the server's answer is what the hero follows;
+ * this file keeps a per-account, per-Space note of it for the first frame before the roster lands.
+ */
+const listeners = new Set<() => void>();
+let mainBotId: string | null = null;
+let loadedKey: string | null = null;
+
+function notify(): void {
+  for (const listener of listeners) listener();
+}
+
+/** SecureStore, loaded where it exists: tests and web hosts have no keychain. */
+async function store() {
+  return import("expo-secure-store");
+}
+
+function keyFor(userId: string, spaceId: string): string {
+  return `rakazo.main-bot.${userId}.${spaceId}`;
+}
+
+export function getMainBotId(): string | null {
+  return mainBotId;
+}
+
+export function subscribeMainBot(listener: () => void): () => void {
+  listeners.add(listener);
+  return () => {
+    listeners.delete(listener);
+  };
+}
+
+export async function loadMainBot(userId: string, spaceId: string): Promise<string | null> {
+  const key = keyFor(userId, spaceId);
+  if (key === loadedKey) return mainBotId;
+  loadedKey = key;
+  try {
+    const secure = await store();
+    mainBotId = await secure.getItemAsync(key);
+  } catch {
+    mainBotId = null;
+  }
+  notify();
+  return mainBotId;
+}
+
+/**
+ * Notes the main bot locally: the hero can be drawn before the roster arrives, and the choice is
+ * remembered for the next launch. The server is told separately, through `bots/setMain`.
+ */
+export async function setMainBot(userId: string, spaceId: string, botId: string): Promise<void> {
+  const key = keyFor(userId, spaceId);
+  loadedKey = key;
+  mainBotId = botId;
+  notify();
+  try {
+    const secure = await store();
+    await secure.setItemAsync(key, botId);
+  } catch {
+    // SecureStore is unavailable on some hosts; the choice stays for this session.
+  }
+}
+
+/** The main bot the server named, when the roster carries it. */
+export function serverMainBotId<T extends { id: string; isMain?: boolean }>(
+  bots: readonly T[],
+): string | null {
+  return bots.find((bot) => bot.isMain)?.id ?? null;
+}
+
+/**
+ * The bot the home screen puts first: the roster's main bot as the server names it, else the
+ * choice this device remembers while it is still in the list, else the first chat — so a deleted
+ * or archived main bot never leaves the hero empty.
+ */
+export function resolveMainBot<T extends { id: string; isMain?: boolean }>(
+  bots: readonly T[],
+  chosenId: string | null = mainBotId,
+): T | undefined {
+  const serverId = serverMainBotId(bots);
+  return (
+    bots.find((bot) => bot.id === serverId) ??
+    bots.find((bot) => bot.id === chosenId) ??
+    bots[0]
+  );
+}
