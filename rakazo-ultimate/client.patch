index c1eddc1d4..6003f8281 100644
--- a/packages/contracts/src/reactions.ts
+++ b/packages/contracts/src/reactions.ts
@@ -1,5 +1,52 @@
 import * as z from "zod";
 
+/** The emoji the app offers first in its reaction menu; any other emoji is accepted too. */
 export const MESSAGE_REACTIONS = ["👍", "👎", "❤️", "😂", "🎉", "😮"] as const;
-export const MessageReactionSchema = z.enum(MESSAGE_REACTIONS);
+
+/**
+ * Longest reaction kept, in UTF-16 units. One emoji sequence is far shorter: even a family
+ * of four with a skin tone on each member stays inside this, while pasted text does not.
+ */
+export const REACTION_MAX_LENGTH = 32;
+
+/**
+ * Exactly one emoji sequence: a pictograph with an optional variation selector and skin tone,
+ * more of them joined by zero-width joiners, a flag, a keycap, or a tag sequence.
+ * Property escapes are unsupported on some engines, so the pattern is built defensively.
+ */
+const emojiSequence = (() => {
+  try {
+    const element =
+      "(?:\\p{Emoji_Modifier_Base}\\uFE0F?\\p{Emoji_Modifier}\\uFE0F?|\\p{Extended_Pictographic}\\uFE0F?)";
+    // England, Scotland and Wales, plus any other lettered subdivision flag.
+    const subdivision = "\\u{1F3F4}[\\u{E0061}-\\u{E007A}]{2,}\\u{E007F}";
+    const source = `^(?:[#*0-9]\\uFE0F?\\u20E3|\\p{Regional_Indicator}{2}|${subdivision}|${element}(?:\\u200D${element})*)$`;
+    // biome-ignore lint/complexity/useRegexLiterals: A literal would fail to parse on engines without these properties.
+    return new RegExp(source, "u");
+  } catch {
+    return null;
+  }
+})();
+
+/** Every character outside ASCII, which covers emoji on engines without property escapes. */
+const fallbackSequence = /^[^\x00-\x7F]+$/;
+
+/** True when the value is one emoji: a reaction, not a sentence, a letter or a wall of text. */
+export function isReactionEmoji(value: string): boolean {
+  const emoji = value.trim();
+  if (emoji.length === 0 || emoji.length > REACTION_MAX_LENGTH) return false;
+  return emojiSequence ? emojiSequence.test(emoji) : fallbackSequence.test(emoji);
+}
+
+/**
+ * Any single emoji the phone's keyboard or picker offers: the presets above are only a
+ * starting point, so one chosen further down the picker is saved the same way.
+ */
+export const MessageReactionSchema = z
+  .string()
+  .trim()
+  .min(1)
+  .max(REACTION_MAX_LENGTH)
+  .refine(isReactionEmoji, { message: "Reaction must be one emoji" });
+
 export type MessageReaction = z.infer<typeof MessageReactionSchema>;
