+import { expect, test } from "@playwright/test";
+import { captureScreenshot, chooseOption, completeOnboarding, signup } from "../helpers/helpers";
+
+test("Activity can find a failure before the same chat's latest success", async ({
+  page,
+}, testInfo) => {
