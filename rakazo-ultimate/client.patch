@@ -0,0 +1,38 @@
+import { StyleSheet, View } from "react-native";
+import Svg, { Defs, LinearGradient, Rect, Stop } from "react-native-svg";
+import { native } from "../lib/native";
+
+/**
+ * The page colour fading in under a bar that floats over a list, so rows scroll away beneath it
+ * instead of meeting a hard edge. Sits behind the bar and takes no touches.
+ */
+export function BottomFade({
+  height,
+  id = "bottom-fade",
+  color,
+}: {
+  height: number;
+  /** One id per screen: two gradients on one screen would otherwise share a definition. */
+  id?: string;
+  color?: string;
+}) {
+  const fill = color ?? String(native.page);
+  return (
+    <View pointerEvents="none" style={[StyleSheet.absoluteFill, { top: undefined, height }]}>
+      <Svg width="100%" height="100%">
+        <Defs>
+          {/* The reference app's band is opaque well before the bar: a row's own words never
+              show through the glass pill above it, and the top of the band still melts into the
+              page. By the time the band reaches the search field it is solid page colour. */}
+          <LinearGradient id={id} x1="0" y1="0" x2="0" y2="1">
+            <Stop offset="0" stopColor={fill} stopOpacity={0} />
+            <Stop offset="0.38" stopColor={fill} stopOpacity={0.92} />
+            <Stop offset="0.62" stopColor={fill} stopOpacity={1} />
+            <Stop offset="1" stopColor={fill} stopOpacity={1} />
+          </LinearGradient>
+        </Defs>
+        <Rect width="100%" height="100%" fill={`url(#${id})`} />
+      </Svg>
+    </View>
+  );
+}
