@@ -0,0 +1,33 @@
+import { describe, expect, it } from "vitest";
+import { isStatusLineMessage, statusLinesAfterOpening } from "./status-line.js";
+
+const line = (id: string, at?: string) => ({ id, role: "bot", blocks: [{ kind: "subagent", style: "line" }], ...(at ? { createdAt: at } : {}) });
+const text = (id: string, role = "bot", at?: string) => ({ id, role, blocks: [{ kind: "text" }], ...(at ? { createdAt: at } : {}) });
+
+describe("the status line sits under the opening reply that took the work", () => {
+  it("moves the opening reply saved after the line up in front of it", () => {
+    const order = statusLinesAfterOpening([
+      text("ask", "user", "2026-11-20T00:00:00Z"),
+      line("card", "2026-11-20T00:00:04Z"),
+      text("opening", "bot", "2026-11-20T00:00:05Z"),
+      text("result", "bot", "2026-11-20T00:01:00Z"),
+    ]).map((m) => m.id);
+    expect(order).toEqual(["ask", "opening", "card", "result"]);
+  });
+
+  it("keeps two lines together under one opening, and a still-streaming reply counts", () => {
+    expect(statusLinesAfterOpening([line("a"), line("b"), text("live")]).map((m) => m.id)).toEqual(["live", "a", "b"]);
+  });
+
+  it("leaves a line alone when what follows is the person, or a reply long after", () => {
+    expect(statusLinesAfterOpening([line("card"), text("you", "user")]).map((m) => m.id)).toEqual(["card", "you"]);
+    expect(
+      statusLinesAfterOpening([line("card", "2026-11-20T00:00:00Z"), text("later", "bot", "2026-11-20T00:05:00Z")]).map((m) => m.id),
+    ).toEqual(["card", "later"]);
+  });
+
+  it("only a line-style task card is a status line; a helper's card is not", () => {
+    expect(isStatusLineMessage(line("x"))).toBe(true);
+    expect(isStatusLineMessage({ role: "bot", blocks: [{ kind: "subagent" }] })).toBe(false);
+  });
+});
diff --git a/packages/core/src/status-line.ts b/packages/core/src/status-line.ts
new file mode 100644
index 000000000..582e8be1f
--- /dev/null
+++ b/packages/core/src/status-line.ts
@@ -0,0 +1,58 @@
+/**
+ * A back-office task's status line sits under the opening reply that took the work (idea 11, v25:
+ * 「主人，我去查一下明天北京的天气。」 then 「◌ 查明天北京天气 · 正在搜索…」). The card is written the
+ * moment the work is dispatched, inside the front desk's turn, so it is saved before the turn's own
+ * reply message; drawn in saved order it would sit above the line that announced it. This moves the
+ * opening reply that follows a run of status lines up in front of them.
+ */
+type Block = { kind: string; style?: string };
+type Message = { role: string; blocks: readonly Block[]; createdAt?: string | Date | null };
+
+/** How close the opening reply must follow the line to be the one that announced its work. */
+export const STATUS_LINE_OPENING_WINDOW_MS = 30_000;
+
+export function isStatusLineMessage(message: Message): boolean {
+  return (
+    message.role === "bot" &&
+    message.blocks.length > 0 &&
+    message.blocks.every((block) => block.kind === "subagent" && block.style === "line")
+  );
+}
+
+function hasText(message: Message): boolean {
+  return message.blocks.some((block) => block.kind === "text");
+}
+
+function timeOf(message: Message): number | undefined {
+  if (!message.createdAt) return undefined;
+  const at = new Date(message.createdAt).getTime();
+  return Number.isNaN(at) ? undefined : at;
+}
+
+export function statusLinesAfterOpening<M extends Message>(messages: readonly M[]): M[] {
+  const out: M[] = [];
+  let index = 0;
+  while (index < messages.length) {
+    const message = messages[index]!;
+    if (!isStatusLineMessage(message)) {
+      out.push(message);
+      index += 1;
+      continue;
+    }
+    let end = index;
+    while (end + 1 < messages.length && isStatusLineMessage(messages[end + 1]!)) end += 1;
+    const next = messages[end + 1];
+    const first = timeOf(message);
+    const after = next ? timeOf(next) : undefined;
+    // A live row (no time yet) is this turn's reply still streaming: it belongs above too.
+    const close = first === undefined || after === undefined || after - first <= STATUS_LINE_OPENING_WINDOW_MS;
+    if (next && next.role === "bot" && hasText(next) && close) {
+      out.push(next, ...messages.slice(index, end + 1));
+      index = end + 2;
+    } else {
+      out.push(...messages.slice(index, end + 1));
+      index = end + 1;
+    }
+  }
+  return out;
+}
