+import { describe, expect, it } from "vitest";
+import {
+  CLOUD_CATEGORIES,
+  integrationCategoryFor,
+  pluginIntegrationCategory,
+} from "./integration-categories";
+
+describe("integrationCategoryFor", () => {
+  it.each([
+    ["Gmail", "gmail", "communication"],
+    ["Outlook", "outlook", "communication"],
+    ["Slack", "slack", "communication"],
+    ["X", "x", "communication"],
+    ["Google Calendar", "google-calendar", "productivity"],
+    ["Notion", "notion", "productivity"],
+    ["1Password", "1password", "passwords"],
+    ["Bitwarden", "bitwarden", "passwords"],
+    ["GitHub", "github", "developer"],
+    ["Vercel", "vercel", "developer"],
+  ])("puts %s on the %s shelf", (name, slug, expected) => {
+    expect(integrationCategoryFor(name, slug)).toBe(expected);
+  });
+
+  it("answers from the name when a provider slug says nothing", () => {
+    expect(integrationCategoryFor("Google Drive")).toBe("productivity");
+  });
+
+  it("leaves an app no shelf names on 全部 alone", () => {
+    expect(integrationCategoryFor("AgentMail", "agentmail")).toBeNull();
+    expect(integrationCategoryFor("", "")).toBeNull();
+  });
+
+  it("matches a brand inside a longer name without guessing from a short word", () => {
+    expect(integrationCategoryFor("GitHub Enterprise Cloud")).toBe("developer");
+    expect(integrationCategoryFor("Boxed Water")).toBeNull();
+  });
+});
+
+describe("pluginIntegrationCategory", () => {
+  it.each([
+    ["communication", "communication"],
+    ["code", "developer"],
+    ["productivity", "productivity"],
+    ["design", "productivity"],
+    ["finance", "productivity"],
+    [null, null],
+    ["something-new", null],
+  ])("maps a marketplace category %s", (category, expected) => {
+    expect(pluginIntegrationCategory(category as string | null)).toBe(expected);
+  });
+});
+
+it("lists the shelves in the reference app's order, without 全部 or iPhone", () => {
+  expect(CLOUD_CATEGORIES).toEqual(["passwords", "productivity", "communication", "developer"]);
+});
