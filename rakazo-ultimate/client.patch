@@ -62,3 +62,18 @@ export function canDoubleTapReact(
     blocks.every((block) => ["text", "image", "file", "chart", "page"].includes(block.kind))
   );
 }
+
+/**
+ * What a double tap on a bubble does. Words open for selection — the blue handles are what a
+ * person reaches for twice — and a bubble with nothing to select keeps the quiet like it had.
+ * A bubble that holds controls of its own takes the double tap for neither.
+ */
+export function doubleTapIntent(input: {
+  hasSelectableText: boolean;
+  inlineControls: boolean;
+  canLike: boolean;
+}): "select" | "like" | undefined {
+  if (input.hasSelectableText) return "select";
+  if (input.inlineControls) return undefined;
+  return input.canLike ? "like" : undefined;
+}
