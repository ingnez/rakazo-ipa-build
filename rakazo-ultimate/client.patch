+const TURN_CLOSE = 0.1;
+/** The eyes never thin to nothing: a shut lid keeps a hairline, as a shut eye does. */
+const LID_KEEP = 0.06;
+
+/**
+ * One eye's lid curve, as the avatar spec states it: a quadratic `p0 -> p1 -> p2` in
+ * the body's own normalised units, and whether it is an arc (an open `︵`) rather than a closed
+ * stadium. `isArc` also means the lid is a stroke, which is thinner than the open eye it bends
+ * out of.
+ */
+export interface BabygrokEyeSpec {
+  readonly p0: readonly [number, number];
+  readonly p1: readonly [number, number];
+  readonly p2: readonly [number, number];
+  readonly isArc: boolean;
+}
+
+/** The resting lid's length in lid units: the neutral face runs from -0.15 to 0.15. */
+export const BABYGROK_LID_UNITS = 0.3;
+/** The all-zero face means "keep the body's own eye": the resting lid, upright. */
+export const BABYGROK_BASE_SPEC: BabygrokEyeSpec = {
+  p0: [AVATAR_FACES.neutral!.p0[0], AVATAR_FACES.neutral!.p0[1]],
+  p1: [AVATAR_FACES.neutral!.p1[0], AVATAR_FACES.neutral!.p1[1]],
+  p2: [AVATAR_FACES.neutral!.p2[0], AVATAR_FACES.neutral!.p2[1]],
+  isArc: false,
+};
