+export function buildAgentMemoryPrompt(
+  input: readonly MemoryPromptDocument[],
+  maxBytes = AGENT_MEMORY_MAX_BYTES,
+): { text?: string; plan: MemoryPromptBudget } {
+  const plan: MemoryPromptBudget = {
+    limitBytes: maxBytes,
+    usedBytes: 0,
+    documents: [],
+    omitted: [],
+  };
+  if (input.length === 0) return { plan };
