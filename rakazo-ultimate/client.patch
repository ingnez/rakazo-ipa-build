diff --git a/apps/mobile/lib/activity-label.test.ts b/apps/mobile/lib/activity-label.test.ts
new file mode 100644
index 0000000..dc1b203
--- /dev/null
+++ b/apps/mobile/lib/activity-label.test.ts
@@ -0,0 +1,164 @@
+import { describe, expect, it } from "vitest";
+import { activityStep, needsYouStep } from "./activity-label";
+
+describe("activityStep", () => {
+  it("names the work in a phrase instead of the tool", () => {
+    expect(activityStep("Searching the web: 院外心脏骤停")?.label).toBe("正在四处查找");
+    expect(activityStep("Reading /workspace/notes.md")?.label).toBe("正在读文件");
+    expect(activityStep("Running: ls -la")?.label).toBe("正在执行几条命令");
+    expect(activityStep("Delegating to helper: 文献速递")?.label).toBe("正在和另一个 Bot 确认");
+  });
+
+  it("keeps one step while the same work goes on, whatever its details", () => {
+    expect(activityStep("Searching the web: 一")?.key).toBe(
+      activityStep("Searching the web: 二")?.key,
+    );
+    expect(activityStep("Reading a.md")?.key).toBe(activityStep("Reading b.md")?.key);
+    expect(activityStep("Read file a.md")?.key).toBe(activityStep("Read file b.md")?.key);
+  });
