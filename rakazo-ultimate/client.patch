+/**
+ * Which shelf of 「连接应用」an app belongs on.
+ *
+ * The reference app sorts its cloud apps into a short row of shelves (密码管理器, 效率, 通信, 开发),
+ * and the catalog itself only says a name and a provider slug. This reads those two and answers
+ * with the shelf a person would look on; an app none of the shelves names stays on 全部.
+ */
+export type IntegrationCategory = "passwords" | "productivity" | "communication" | "developer";
+
+/** The shelves after 全部 and iPhone, in the order the row shows them. */
+export const CLOUD_CATEGORIES: readonly IntegrationCategory[] = [
+  "passwords",
+  "productivity",
+  "communication",
+  "developer",
+];
+
+/** A brand's own words, matched against a lowercased name or provider slug with punctuation gone. */
+const CATEGORY_KEYWORDS: Record<IntegrationCategory, readonly string[]> = {
+  passwords: [
+    "1password",
+    "onepassword",
+    "bitwarden",
+    "lastpass",
+    "dashlane",
+    "keeper",
+    "keepass",
+    "enpass",
+    "nordpass",
+    "protonpass",
+    "roboform",
+    "keepersecurity",
+    "password",
+    "passwords",
+    "passkey",
+    "vaultwarden",
+  ],
+  productivity: [
+    "notion",
+    "googledrive",
+    "drive",
+    "dropbox",
+    "box",
+    "googlecalendar",
+    "calendar",
+    "googledocs",
+    "docs",
+    "googlesheets",
+    "sheets",
+    "airtable",
+    "evernote",
+    "obsidian",
+    "todoist",
+    "asana",
+    "trello",
+    "clickup",
+    "monday",
+    "mondaycom",
+    "confluence",
+    "jira",
+    "figma",
+    "miro",
+    "canva",
+    "salesforce",
+    "hubspot",
+    "pipedrive",
+    "stripe",
+    "quickbooks",
+    "xero",
+    "ramp",
+    "brex",
+    "expensify",
+    "zapier",
+    "make",
+    "ifttt",
+  ],
+  communication: [
+    "gmail",
+    "googlemail",
+    "outlook",
+    "hotmail",
+    "mail",
+    "email",
+    "slack",
+    "discord",
+    "telegram",
+    "whatsapp",
+    "signal",
+    "wechat",
+    "weixin",
+    "dingtalk",
+    "feishu",
+    "lark",
+    "line",
+    "kakaotalk",
+    "teams",
+    "microsoftteams",
+    "zoom",
+    "googlemeet",
+    "meet",
+    "x",
+    "twitter",
+    "threads",
+    "instagram",
+    "facebook",
+    "messenger",
+    "linkedin",
+    "reddit",
+    "mastodon",
+    "bluesky",
+  ],
+  developer: [
+    "github",
+    "gitlab",
+    "bitbucket",
+    "gitea",
+    "vercel",
+    "netlify",
+    "cloudflare",
+    "railway",
+    "render",
+    "heroku",
+    "flyio",
+    "sentry",
+    "datadog",
+    "newrelic",
+    "grafana",
+    "postman",
+    "insomnia",
+    "supabase",
+    "firebase",
+    "docker",
+    "circleci",
+    "jenkins",
+    "pagerduty",
+    "linear",
+    "amplitude",
+    "mixpanel",
+    "segment",
+    "twilio",
+    "openai",
+    "anthropic",
+  ],
+};
+
+function normalize(value: string): string {
+  return value.toLowerCase().replace(/[^a-z0-9]+/g, "");
+}
+
+/** The shelf for a catalog app, from its name and provider slug; null when no shelf names it. */
+export function integrationCategoryFor(
+  name: string,
+  slug?: string | null,
+): IntegrationCategory | null {
+  const keys = [normalize(name), normalize(slug ?? "")].filter(Boolean);
+  if (!keys.length) return null;
+  for (const category of CLOUD_CATEGORIES) {
+    const keywords = CATEGORY_KEYWORDS[category];
+    for (const key of keys) {
+      // An exact brand match wins over a longer name that merely contains the word.
+      if (keywords.includes(key)) return category;
+    }
+    for (const key of keys) {
+      if (keywords.some((keyword) => keyword.length > 3 && key.startsWith(keyword)))
+        return category;
+    }
+  }
+  return null;
+}
+
+/** The shelf a marketplace plugin belongs on, from the category its registry gave it. */
+export function pluginIntegrationCategory(category: string | null): IntegrationCategory | null {
+  switch (category) {
+    case "communication":
+      return "communication";
+    case "code":
+      return "developer";
+    case "productivity":
+    case "design":
+    case "sales":
+    case "marketing":
+    case "finance":
+    case "people":
+    case "data":
+    case "ops":
+      return "productivity";
+    default:
+      return null;
+  }
+}
