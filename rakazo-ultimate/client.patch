+
+/** The two light slits: a soft copy behind each bar, the bar itself in the state's ink. */
+function Eyes({
+  frame,
+  ink,
+  glow,
+  opacity,
+}: {
+  frame: LumenFrame;
+  ink: string;
+  glow: string;
+  opacity: number;
+}) {
+  if (opacity <= 0.01) return null;
+  const w = Math.max(2, frame.eyeW);
+  const h = Math.max(2, frame.eyeH);
+  const radius = Math.min(w, h) / 2;
+  const y = frame.eyeCy - h / 2;
+  return (
+    <G transform={`translate(${f2(frame.eyeDx)} ${f2(frame.eyeDy)})`} opacity={f2(opacity)}>
+      {[-26, 26].map((x) => (
+        <G key={`eye${x}`}>
+          <Rect
+            x={f2(x - (w + 9) / 2)}
+            y={f2(y - 4.5)}
+            width={f2(w + 9)}
+            height={f2(h + 9)}
+            rx={f2(radius + 4.5)}
+            fill={glow}
+            opacity="0.5"
+          />
+          <Rect
+            x={f2(x - w / 2)}
+            y={f2(y)}
+            width={f2(w)}
+            height={f2(h)}
+            rx={f2(radius)}
+            fill={ink}
+          />
+        </G>
+      ))}
+    </G>
+  );
+}
+
+function Sparks({ frame, dark, color }: { frame: LumenFrame; dark: boolean; color: string }) {
+  const grow = Math.min(1, frame.sparkK * 3);
+  const opacity = Math.max(0, 1 - Math.max(0, frame.sparkK - 0.6) / 0.4);
+  const fill = dark ? "#FFFFFF" : lumenMix(color, "#1E232B", 0.12);
+  return (
+    <G transform={`scale(${f2(0.6 + 0.55 * grow)})`} opacity={f2(opacity)}>
+      {[
+        [-120, -100, 1],
+        [115, -120, 1.2],
+        [135, -60, 0.8],
+        [-140, -30, 0.7],
+      ].map(([x, y, s], index) => {
+        const a = 10 * (s ?? 1);
+        const b = 3 * (s ?? 1);
+        const px = x ?? 0;
+        const py = y ?? 0;
+        return (
+          <Path
+            key={`spark${index}`}
+            d={`M${px} ${f2(py - a)} L${f2(px + b)} ${f2(py - b)} L${f2(px + a)} ${py} L${f2(
+              px + b,
+            )} ${f2(py + b)} L${px} ${f2(py + a)} L${f2(px - b)} ${f2(py + b)} L${f2(px - a)} ${py} L${f2(
+              px - b,
+            )} ${f2(py - b)}Z`}
+            fill={fill}
+            opacity={0.9 - index * 0.15}
+          />
+        );
+      })}
+    </G>
+  );
+}
+
+/** 五峰光冠：five spires, a band with a gem, and five lit beads that carry the state. */
+function Crown({
+  frame,
+  theme,
+  uid,
+  transform,
+}: {
+  frame: LumenFrame;
+  theme: LumenTheme;
+  uid: string;
+  transform: string;
+}) {
+  const dim = frame.dim;
+  return (
+    <G transform={transform} opacity={f2(frame.crownOp)}>
+      <Ellipse cx="0" cy="-196" rx="120" ry="72" fill={theme.crown[1]} opacity="0.13" />
+      <Path d={LUMEN_CROWN_PATH} fill={`url(#${uid}cg)`} />
+      <Path
+        d={LUMEN_CROWN_PATH}
+        fill={`url(#${uid}cv)`}
+        stroke={theme.crownEdge}
+        strokeOpacity={theme.crownEdgeOp}
+        strokeWidth={theme.crownEdgeW}
+        strokeLinejoin="round"
+      />
+      <Path
+        d={LUMEN_CROWN_BAND_PATH}
+        fill={`url(#${uid}cb)`}
+        stroke={theme.crownEdge}
+        strokeOpacity={theme.crownEdgeOp * 0.85}
+        strokeWidth="1"
+      />
+      <Path
+        d="M-68 -133 Q0 -122 68 -133"
+        fill="none"
+        stroke="#5E4520"
+        strokeOpacity="0.55"
+        strokeWidth="1"
+      />
+      <Path
+        d="M0 -152 L0 -206 M-42 -152 L-42 -194 M42 -152 L42 -194"
+        stroke="#FBEFCB"
+        strokeOpacity={theme.dark ? 0.35 : 0.55}
+        strokeWidth="1.2"
+        strokeLinecap="round"
+      />
+      <Ellipse cx="0" cy="-128" rx="11" ry="7" fill={frame.gemColor} />
+      <Ellipse cx="0" cy="-129" rx="5" ry="2.6" fill="#FFFFFF" opacity="0.85" />
+      <Circle cx="-40" cy="-129" r="3.2" fill="#FBEFCB" opacity="0.8" />
+      <Circle cx="40" cy="-129" r="3.2" fill="#FBEFCB" opacity="0.8" />
+      {LUMEN_CROWN_TIPS.map(([x, y, r], index) => {
+        const lit = frame.tips[index] ?? 1;
+        const alpha = Math.max(0, Math.min(1, lit * (dim ? 0.5 : 1)));
+        const fill = lumenMix(
+          theme.dark ? "#3A3424" : "#8C7A55",
+          frame.tipColor,
+          Math.max(0, Math.min(1, 0.25 + 0.75 * lit)),
+        );
+        return (
+          <G key={`tip${index}`}>
+            <Circle cx={x} cy={y} r={f2(r * 2.4)} fill={fill} opacity={f2(alpha * 0.22)} />
+            <Circle cx={x} cy={y} r={r} fill={fill} opacity={f2(alpha)} />
+            <Circle cx={f2(x - r * 0.3)} cy={f2(y - r * 0.35)} r={f2(r * 0.38)} fill="#FFFFFF" opacity="0.9" />
+          </G>
+        );
+      })}
+    </G>
+  );
+}
+
+/** The emblem: the designer's 24x24 line mark, scaled onto the ring's upper left. */
+function Emblem({ look, theme }: { look: LumenLook; theme: LumenTheme }) {
+  const ink = lumenEmblemInk(look.color, theme.dark);
+  const strokeWidth = theme.dark ? 1.5 : 1.7;
+  return (
+    <G transform="translate(-150 -150) scale(2.1)">
+      {look.emblem ? (
+        <>
+          <Path
+            d={look.emblem.d}
+            fill="none"
+            stroke={ink}
+            strokeOpacity="0.28"
+            strokeWidth={strokeWidth + 2.2}
+            strokeLinecap="round"
+            strokeLinejoin="round"
+          />
+          <Path
+            d={look.emblem.d}
+            fill="none"
+            stroke={ink}
+            strokeWidth={strokeWidth}
+            strokeLinecap="round"
+            strokeLinejoin="round"
+          />
+        </>
+      ) : (
+        <SvgText x="12" y="18" fill={ink} fontSize="16" fontWeight="600" textAnchor="middle">
+          {look.initial ?? ""}
+        </SvgText>
+      )}
+    </G>
+  );
+}
