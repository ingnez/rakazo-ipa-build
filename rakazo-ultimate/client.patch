+import { describe, expect, it } from "vitest";
+import { AVATAR_CLIP_POOLS, AVATAR_REST_POSE, avatarClip, avatarClipPose, avatarEase } from "./avatar-clips.js";
+import { BABYGROK_BODIES } from "./babygrok-geometry.js";
+import {
+  MOTION_CLIPS,
+  MOTION_FACES,
+  MOTION_SHAPE_SCALES,
+  MOTION_STATES,
+  motionClipPool,
+  motionFace,
+  motionFaceEyes,
+  motionShapeScale,
+  motionStateFace,
+  motionStateHold,
+  motionStateMorph,
+} from "./bot-motion-clips.js";
+
+describe("official motion clips", () => {
+  it("carries all 28 clips and 350 keyframes the bytecode held", () => {
+    expect(Object.keys(MOTION_CLIPS)).toHaveLength(28);
+    const keys = Object.values(MOTION_CLIPS).reduce(
+      (total, clip) =>
+        total +
+        (clip.position?.length ?? 0) +
+        (clip.rotation?.length ?? 0) +
+        (clip.zoom?.length ?? 0) +
+        (clip.squash?.length ?? 0) +
+        (clip.lids?.length ?? 0) +
+        clip.faces.length +
+        // A `blink` expression is a face change in the bytecode and a lid blink here.
+        clip.blinks.length,
+      0,
+    );
+    expect(keys).toBe(350);
+  });
+
+  it("plays every clip in a pool, and every state names clips that exist", () => {
+    for (const [state, rule] of Object.entries(MOTION_STATES)) {
+      for (const name of [...rule.clips, ...(rule.compactClips ?? [])])
+        expect(MOTION_CLIPS[name], `${state} → ${name}`).toBeDefined();
+    }
+    expect(Object.keys(MOTION_STATES)).toHaveLength(53);
+    // Idle is the official weighted rotation: five entries, four of them Idle_B.
+    expect(motionClipPool("idle")).toEqual(["Idle_B", "Idle_B", "Idle_D", "Idle_B", "Idle_A"]);
+    expect(motionClipPool("idle", true)).toEqual(["Idle_B"]);
+    expect(motionClipPool("working")).toHaveLength(6);
+  });
+
+  it("keeps a clip inside its work area, so the tail it holds never plays", () => {
+    const blocked = MOTION_CLIPS.Blocked_A!;
+    const early = avatarClipPose(avatarClip("Blocked_A"), 0);
+    const atEnd = avatarClipPose(avatarClip("Blocked_A"), blocked.duration);
+    // The clip's own last key sits at 1.76 s inside a 2.1 s work area that stretches to 2.12 s.
+    expect(early.x).toBeCloseTo(0);
+    expect(atEnd.x).toBeCloseTo(0);
+    const mid = avatarClipPose(avatarClip("Blocked_A"), blocked.duration / 2);
+    expect(Math.abs(mid.x) > 0 || Math.abs(mid.y) > 0).toBe(true);
+  });
+
+  it("normalizes the official resting zoom of 0.6 to 1", () => {
+    const pose = avatarClipPose(avatarClip("Idle_B"), 0);
+    expect(pose.zoom).toBeCloseTo(1, 5);
+    const working = avatarClipPose(avatarClip("Working_B"), 1.41);
+    expect(working.zoom).toBeLessThan(1);
+  });
+
+  it("unwraps rotations stored beyond a full turn, so no frame jumps", () => {
+    for (const name of Object.keys(MOTION_CLIPS)) {
+      const clip = avatarClip(name);
+      let previous = avatarClipPose(clip, 0);
+      for (let t = 0.02; t <= clip.duration; t += 0.02) {
+        const pose = avatarClipPose(clip, t);
+        const step = Math.max(
+          Math.abs(pose.pitch - previous.pitch),
+          Math.abs(pose.yaw - previous.yaw),
+          Math.abs(pose.roll - previous.roll),
+        );
+        expect(step, `${name} at ${t.toFixed(2)}s`).toBeLessThan(120);
+        previous = pose;
+      }
+    }
+  });
+
+  it("keeps the overshooting eases the official clips are built on", () => {
+    // Done_A's landing keys use curves whose y leaves 0..1; a clamped ease would flatten them.
+    const overshoot = Math.max(
+      ...Array.from({ length: 60 }, (_, step) => avatarEase([0.277381, 0.292814, 0.353411, 1.07377], step / 60)),
+    );
+    expect(overshoot).toBeGreaterThan(1);
+  });
+
+  it("resolves an expression through the official aliases to one of the nine faces", () => {
+    expect(motionFace("thinking")).toBe("sad");
+    expect(motionFace("smile")).toBe("happy");
+    expect(motionFace("squint")).toBe("squinted");
+    expect(motionFace("inspect")).toBe("inspecting");
+    expect(motionFace("angry")).toBe("neutral");
+    expect(motionFace("blink")).toBe("neutral");
+    expect(motionFace("nonsense")).toBe("neutral");
+    expect(Object.keys(MOTION_FACES)).toHaveLength(9);
+    for (const face of Object.keys(MOTION_FACES))
+      expect(motionFaceEyes(face), face).toBeDefined();
+  });
+
+  it("blinks where a clip says blink, and squashes where it says squash", () => {
+    const blinks = avatarClip("Idle_B").blinks ?? [];
+    expect(blinks).toHaveLength(2);
+    expect(blinks[0]).toBeCloseTo(1.48, 2);
+    expect(blinks[1]).toBeCloseTo(3.46, 2);
+    // Just after the authored blink time the lids are shut.
+    expect(avatarClipPose(avatarClip("Idle_B"), 1.52).lid).toBeGreaterThan(0.2);
+    // Done_A lands twice: the widest squeeze is the official 1.095 across and 0.95 up.
+    const done = avatarClip("Done_A");
+    let widest = 0;
+    let flattest = 1;
+    for (let t = 0; t <= done.duration; t += 0.01) {
+      const pose = avatarClipPose(done, t);
+      widest = Math.max(widest, pose.squashX);
+      flattest = Math.min(flattest, pose.squashY);
+    }
+    expect(widest).toBeCloseTo(1.095, 2);
+    expect(flattest).toBeCloseTo(0.95, 2);
+  });
+
+  it("wears a state's face over whatever face its clip asks for", () => {
+    expect(motionStateFace("sleeping")).toBe("sleepy");
+    expect(motionStateFace("waking")).toBe("surprised");
+    expect(motionStateFace("finished")).toBe("happy");
+    expect(motionStateFace("idle")).toBeNull();
+    expect(motionStateMorph("searching")).toBe("radar");
+    expect(motionStateMorph("thinking")).toBe("thinking");
+    expect(motionStateHold("blocked")).toBe(120);
+    expect(motionStateFace("unknown-state")).toBeNull();
+  });
+
+  it("keeps the resting pose's face when a clip has no face track", () => {
+    expect(avatarClipPose(avatarClip("Rotation_A"), 1).face).toBe(AVATAR_REST_POSE.face);
+  });
+
+  it("zooms every body to the size the others read at", () => {
+    // The official table alone left `wedge` (a triangle, and its smallest entry) at about half a
+    // blob's area, which read as a shrunken chip in the picker; the zoom is normalised by area.
+    for (const key of Object.keys(MOTION_SHAPE_SCALES)) {
+      const body = BABYGROK_BODIES[key as keyof typeof BABYGROK_BODIES];
+      if (!body) continue;
+      const scale = motionShapeScale(key);
+      expect(scale, key).toBeGreaterThanOrEqual(0.86);
+      expect(scale, key).toBeLessThanOrEqual(1.22);
+    }
+    // Drawn areas now match within a few percent, whichever body it is.
+    const area = (ring: readonly number[]) => {
+      let sum = 0;
+      const count = ring.length / 2;
+      for (let index = 0; index < count; index += 1) {
+        const next = (index + 1) % count;
+        sum += ring[index * 2]! * ring[next * 2 + 1]! - ring[next * 2]! * ring[index * 2 + 1]!;
+      }
+      return Math.abs(sum) / 2;
+    };
+    const drawn = (key: string) => {
+      const body = BABYGROK_BODIES[key as keyof typeof BABYGROK_BODIES]!;
+      return area(body.ring) * motionShapeScale(key) ** 2;
+    };
+    const wedge = drawn("wedge");
+    const blob = drawn("blob");
+    expect(wedge / blob).toBeGreaterThan(0.55);
+    expect(wedge / blob).toBeLessThan(1.15);
+    expect(motionShapeScale("nope")).toBe(1);
+  });
+
+  it("keeps the resting pools small and the working pool the official six", () => {
+    expect(AVATAR_CLIP_POOLS.idle).toEqual(motionClipPool("idle"));
+    expect(AVATAR_CLIP_POOLS.compactIdle).toEqual(motionClipPool("idle", true));
+    expect(AVATAR_CLIP_POOLS.working).toEqual(motionClipPool("working"));
+    // Every pool name is a clip the player can find.
+    for (const pool of Object.values(AVATAR_CLIP_POOLS))
+      for (const name of pool) expect(avatarClip(name).duration, name).toBeGreaterThan(0);
+  });
+});
