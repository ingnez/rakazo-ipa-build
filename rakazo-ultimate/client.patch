@@ -0,0 +1,12 @@
+import { createContext, useContext } from "react";
+import type { SharedValue } from "react-native-reanimated";
+
+/**
+ * The left-drag offset every message row reads, so one drag slides the whole column aside and each
+ * row's own time shows at its edge. A list provides it; a row rendered on its own gets null.
+ */
+export const MessageSwipeContext = createContext<SharedValue<number> | null>(null);
+
+export function useMessageSwipe(): SharedValue<number> | null {
+  return useContext(MessageSwipeContext);
+}
