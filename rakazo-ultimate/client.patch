 import type { MobileBot, MobileMessage, MobileSnapshot } from "./mobile-types";
 
+/**
+ * What a message says, in one line, for a reply quote or a notification. A card that carries no
+ * prose of its own — an approval, a choice, a call or a connection — is named by the line it
+ * leads with, so a quote reads as what it was rather than a bare "消息".
