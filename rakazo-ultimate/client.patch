@@ -0,0 +1,31 @@
+/**
+ * Runs `task` once the JS thread is idle and returns a cancel function.
+ *
+ * React Native 0.88 removed `InteractionManager`: in a release build the export is `undefined`,
+ * so `InteractionManager.runAfterInteractions` throws a TypeError from inside a frame callback,
+ * which the app treats as a fatal startup error. This uses `requestIdleCallback` when the host
+ * has it and a zero-delay timer otherwise, and a task that throws is reported, never rethrown.
+ */
+export function runWhenIdle(task: () => void): () => void {
+  const guarded = () => {
+    try {
+      task();
+    } catch (error) {
+      console.warn("An idle task failed", error);
+    }
+  };
+  const host = globalThis as {
+    requestIdleCallback?: (cb: () => void) => number;
+    cancelIdleCallback?: (id: number) => void;
+  };
+  if (typeof host.requestIdleCallback === "function") {
+    try {
+      const id = host.requestIdleCallback(guarded);
+      return () => host.cancelIdleCallback?.(id);
+    } catch {
+      // Fall through to a timer.
+    }
+  }
+  const timer = setTimeout(guarded, 0);
+  return () => clearTimeout(timer);
+}
