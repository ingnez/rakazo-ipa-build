+    await ensureAiDataConsent({
+      uses,
+      status: () =>
+        rpc("aiConsent/status", { uses, ...consentTarget }, { requestContext: consentContext }),
+      prompt: consentTarget.pageId ? promptPageRevisionConsent : promptAiConsent,
+      allow: (input) =>
