@@ -0,0 +1,345 @@
+import AVFoundation
+import AudioToolbox
+import ExpoModulesCore
+
+/// Carries both directions of one full-duplex voice call.
+///
+/// The microphone is tapped once, converted to the rate the model takes (16 kHz or 24 kHz, PCM16
+/// mono) and handed to JavaScript in 20 ms pieces, which is what the realtime gateway relays to the
+/// provider. The model's own audio arrives the same way and is scheduled on a player node as it
+/// comes, so the reply is heard while it is still being made. The audio session runs in `.voiceChat`
+/// so the system cancels the echo of the reply out of the microphone — without that the model hears
+/// itself and interrupts itself.
+///
+/// The session is deactivated when the call ends, which hands audio back to the rest of the phone
+/// (haptics, music, other apps) instead of leaving it captive to a call that is over.
+///
+/// Echo cancellation is Apple's voice processing I/O, not the session mode alone: the input node has
+/// to be switched into it while the engine is stopped. The unit subtracts what the speaker is playing
+/// from what the microphone hears before the tap ever runs, which is the difference between a call
+/// and a model answering its own voice.
+public class RakazoRealtimeAudioModule: Module {
+  private let engine = AVAudioEngine()
+  private let player = AVAudioPlayerNode()
+  /// Everything the microphone produces, off the audio thread.
+  private let buffers = DispatchQueue(label: "rakazo.realtime.audio")
+  private var interruptionObserver: NSObjectProtocol?
+
+  /// Outputs that are already the right place for a call: anything but the phone's own speaker.
+  private static let headsetPorts = [
+    AVAudioSession.Port.headphones, .bluetoothA2DP, .bluetoothHFP, .bluetoothLE, .headsetMic,
+    .usbAudio, .airPlay, .carAudio,
+  ]
+  /// The level the model's voice is played at. Vendors send PCM16 well below full scale (and a call
+  /// through the voice processing unit is quieter again), so the reply is lifted by one gentle,
+  /// fixed amount and soft-limited — never by an automatic gain that follows each piece. A gain
+  /// that chased the peaks pulled the quiet parts up and pushed the loud ones down piece by piece,
+  /// and the voice wobbled between syllables instead of sounding like a person.
+  private static let downlinkGain: Float = 1.6
+
+  private var inputConverter: AVAudioConverter?
+  private var captureFormat: AVAudioFormat?
+  private var playbackFormat: AVAudioFormat?
+  /// Microphone audio waiting to make a whole 20 ms frame.
+  private var pending = Data()
+  private var chunkBytes = 640
+  private var running = false
+  private var muted = false
+  private var tapInstalled = false
+  private var playerAttached = false
+  /// Whether this call switched the microphone into the voice processing unit, so `stop` only
+  /// hands back what it took.
+  private var voiceProcessingOn = false
+
+  public func definition() -> ModuleDefinition {
+    Name("RakazoRealtimeAudio")
+    Events("onAudio", "onInterruption")
+
+    /// Opens the microphone and the speaker at the two rates the call was planned with.
+    Function("start") { (inputRate: Double, outputRate: Double) throws -> Void in
+      try self.start(inputRate: inputRate, outputRate: outputRate)
+    }
+
+    /// A muted call keeps the microphone running but sends nothing it hears.
+    Function("setMuted") { (muted: Bool) -> Void in
+      self.muted = muted
+      if muted {
+        self.buffers.async { self.pending.removeAll(keepingCapacity: true) }
+      }
+    }
+
+    /// One piece of the model's audio, PCM16 mono at the playback rate, as base64.
+    Function("play") { (base64: String) -> Void in
+      self.play(base64: base64)
+    }
+
+    /// Throws away the audio queued so far: the caller talked over the reply.
+    Function("flush") { () -> Void in
+      self.flush()
+    }
+
+    /// Ends the call's audio and gives the session back to the phone.
+    Function("stop") { () -> Void in
+      self.stop()
+    }
+
+    OnDestroy {
+      self.stop()
+    }
+  }
+
+  private func start(inputRate: Double, outputRate: Double) throws {
+    stop()
+    let session = AVAudioSession.sharedInstance()
+    // `.voiceChat` is the mode with echo cancellation; the speaker stays the default output even
+    // with a headset attached, and a Bluetooth headset may carry the call.
+    try session.setCategory(
+      .playAndRecord, mode: .voiceChat, options: [.defaultToSpeaker, .allowBluetooth]
+    )
+    try session.setActive(true, options: [])
+    observeInterruptions()
+
+    let microphone = engine.inputNode
+    // `.voiceChat` says what kind of audio this is; it does not switch the echo canceller on. The
+    // voice processing unit does, and it can only be enabled while the engine is stopped. It takes
+    // over the output node too, so the speaker's audio is what gets subtracted from the microphone.
+    if !microphone.isVoiceProcessingEnabled {
+      do {
+        try microphone.setVoiceProcessingEnabled(true)
+        voiceProcessingOn = true
+      } catch {
+        // A call without it still works — the reply can just be heard by the model and cut it off —
+        // so fall back to the session's own mode instead of failing the call.
+        NSLog("[RakazoRealtimeAudio] voice processing unavailable: %@", error.localizedDescription)
+      }
+    }
+
+    // With the voice processing unit running, some devices answer on the receiver — the same audio
+    // at a fraction of the volume. A headset is already the right output; on the phone itself, ask
+    // for the speaker explicitly instead of trusting the category option to win.
+    if !Self.playsOnHeadset(session) {
+      try? session.overrideOutputAudioPort(.speaker)
+    }
+
+    guard
+      let capture = AVAudioFormat(
+        commonFormat: .pcmFormatInt16, sampleRate: inputRate, channels: 1, interleaved: true
+      )
+    else {
+      throw Exception(
+        name: "ERR_REALTIME_AUDIO_FORMAT",
+        description: "This device cannot record at \(Int(inputRate)) Hz."
+      )
+    }
+    captureFormat = capture
+    // 20 ms of PCM16 mono: what the gateway is built around.
+    chunkBytes = max(2, Int((inputRate / 50).rounded()) * 2)
+
+    // The format the unit is actually running at, read after voice processing was switched on: it
+    // is the unit's own (48 kHz, one channel as a rule), not the session's before the call.
+    let hardware = microphone.outputFormat(forBus: 0)
+    guard hardware.sampleRate > 0, hardware.channelCount > 0,
+      let converter = AVAudioConverter(from: hardware, to: capture)
+    else {
+      throw Exception(
+        name: "ERR_REALTIME_AUDIO_UNAVAILABLE",
+        description: "The microphone is not available for a call."
+      )
+    }
+    inputConverter = converter
+
+    guard
+      let playback = AVAudioFormat(
+        commonFormat: .pcmFormatFloat32, sampleRate: outputRate, channels: 1, interleaved: false
+      )
+    else {
+      throw Exception(
+        name: "ERR_REALTIME_AUDIO_FORMAT",
+        description: "This device cannot play at \(Int(outputRate)) Hz."
+      )
+    }
+    playbackFormat = playback
+    if !playerAttached {
+      engine.attach(player)
+      playerAttached = true
+    }
+    // Nothing in the chain may be turning the voice down: the player is at unity, the mixer is at
+    // unity, and the level work happens once, in `play`, where the incoming PCM16 is known.
+    player.volume = 1
+    engine.disconnectNodeOutput(player)
+    engine.connect(player, to: engine.mainMixerNode, format: playback)
+    engine.mainMixerNode.outputVolume = 1
+    engine.prepare()
+    try engine.start()
+
+    running = true
+    muted = false
+    buffers.async { self.pending.removeAll(keepingCapacity: true) }
+    microphone.installTap(onBus: 0, bufferSize: 1024, format: hardware) { [weak self] buffer, _ in
+      self?.consume(buffer)
+    }
+    tapInstalled = true
+    player.play()
+  }
+
+  private func stop() {
+    running = false
+    muted = false
+    if tapInstalled {
+      engine.inputNode.removeTap(onBus: 0)
+      tapInstalled = false
+    }
+    if playerAttached {
+      player.stop()
+      engine.disconnectNodeOutput(player)
+    }
+    if engine.isRunning {
+      engine.stop()
+    }
+    buffers.sync { self.pending.removeAll(keepingCapacity: true) }
+    inputConverter = nil
+    captureFormat = nil
+    playbackFormat = nil
+    // Give the microphone back the way it was taken: left on, every later recording (dictation, a
+    // voice note, the turn-based call) would still run through the call's processing.
+    if voiceProcessingOn, engine.inputNode.isVoiceProcessingEnabled {
+      try? engine.inputNode.setVoiceProcessingEnabled(false)
+    }
+    voiceProcessingOn = false
+    removeInterruptionObserver()
+    // Hands audio back: haptics, music and every other sound the call had taken over.
+    let session = AVAudioSession.sharedInstance()
+    try? session.overrideOutputAudioPort(.none)
+    try? session.setActive(false, options: .notifyOthersOnDeactivation)
+  }
+
+  /// True when the call is already going somewhere other than the phone's own receiver or speaker.
+  private static func playsOnHeadset(_ session: AVAudioSession) -> Bool {
+    session.currentRoute.outputs.contains { output in
+      headsetPorts.contains(output.portType)
+    }
+  }
+
+  /// One tap buffer, cut to the call's rate and handed over in whole 20 ms pieces.
+  private func consume(_ buffer: AVAudioPCMBuffer) {
+    guard running, !muted, let converter = inputConverter, let capture = captureFormat else {
+      return
+    }
+    let ratio = capture.sampleRate / buffer.format.sampleRate
+    let capacity = AVAudioFrameCount(Double(buffer.frameLength) * ratio) + 32
+    guard capacity > 0, let converted = AVAudioPCMBuffer(pcmFormat: capture, frameCapacity: capacity)
+    else { return }
+    var error: NSError?
+    var supplied = false
+    converter.convert(to: converted, error: &error) { _, status in
+      if supplied {
+        status.pointee = .noDataNow
+        return nil
+      }
+      supplied = true
+      status.pointee = .haveData
+      return buffer
+    }
+    guard error == nil, converted.frameLength > 0, let samples = converted.int16ChannelData?[0] else {
+      return
+    }
+    let data = Data(
+      bytes: samples, count: Int(converted.frameLength) * MemoryLayout<Int16>.size)
+    let chunk = chunkBytes
+    buffers.async { [weak self] in
+      guard let self else { return }
+      self.pending.append(data)
+      // A client that falls far behind (the socket stalled) drops the backlog rather than
+      // replaying a second of stale speech into the call.
+      if self.pending.count > chunk * 25 {
+        self.pending.removeFirst(self.pending.count - chunk * 25)
+      }
+      while self.pending.count >= chunk {
+        let piece = Data(self.pending.prefix(chunk))
+        self.pending.removeFirst(chunk)
+        self.emit(piece)
+      }
+    }
+  }
+
+  private func emit(_ data: Data) {
+    let base64 = data.base64EncodedString()
+    DispatchQueue.main.async { [weak self] in
+      self?.sendEvent("onAudio", ["data": base64])
+    }
+  }
+
+  private func play(base64: String) {
+    guard running, let format = playbackFormat, let data = Data(base64Encoded: base64) else {
+      return
+    }
+    let frames = data.count / MemoryLayout<Int16>.size
+    guard frames > 0,
+      let buffer = AVAudioPCMBuffer(pcmFormat: format, frameCapacity: AVAudioFrameCount(frames))
+    else { return }
+    buffer.frameLength = AVAudioFrameCount(frames)
+    guard let channel = buffer.floatChannelData?[0] else { return }
+    data.withUnsafeBytes { (raw: UnsafeRawBufferPointer) in
+      let samples = raw.bindMemory(to: Int16.self)
+      for index in 0..<frames {
+        let value = Float(Int16(littleEndian: samples[index])) / 32_768.0
+        channel[index] = softLimit(value * Self.downlinkGain)
+      }
+    }
+    player.scheduleBuffer(buffer, completionHandler: nil)
+    if !player.isPlaying {
+      player.play()
+    }
+  }
+
+  /// Keeps a lifted sample inside full scale without the crackle of a hard clip.
+  private func softLimit(_ value: Float) -> Float {
+    let knee: Float = 0.75
+    let magnitude = abs(value)
+    guard magnitude > knee else { return value }
+    let limited = knee + (1 - knee) * Float(tanh(Double((magnitude - knee) / (1 - knee))))
+    return value < 0 ? -limited : limited
+  }
+
+  private func flush() {
+    guard playerAttached else { return }
+    // Stopping the node throws away everything it had queued and not yet played.
+    player.stop()
+    if running {
+      player.play()
+    }
+  }
+
+  private func observeInterruptions() {
+    guard interruptionObserver == nil else { return }
+    interruptionObserver = NotificationCenter.default.addObserver(
+      forName: AVAudioSession.interruptionNotification,
+      object: AVAudioSession.sharedInstance(),
+      queue: .main
+    ) { [weak self] notification in
+      guard let self,
+        let raw = notification.userInfo?[AVAudioSessionInterruptionTypeKey] as? UInt,
+        let type = AVAudioSession.InterruptionType(rawValue: raw)
+      else { return }
+      switch type {
+      case .began:
+        self.sendEvent("onInterruption", ["began": true])
+      case .ended:
+        // The system paused the engine for the interruption; pick the call back up.
+        if self.running, !self.engine.isRunning {
+          try? self.engine.start()
+          self.player.play()
+        }
+        self.sendEvent("onInterruption", ["began": false])
+      @unknown default:
+        break
+      }
+    }
+  }
+
+  private func removeInterruptionObserver() {
+    guard let observer = interruptionObserver else { return }
+    NotificationCenter.default.removeObserver(observer)
+    interruptionObserver = nil
+  }
+}
