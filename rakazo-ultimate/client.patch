@@ -0,0 +1,46 @@
+import type { ImageArtifactPreviewTarget } from "../components/image-artifact-viewer";
+import type { MobileArtifactTarget } from "./artifact-open";
+import { ImageViewerIndex } from "./image-stack-layout";
+
+export type ImageGallerySession = {
+  threadTarget: MobileArtifactTarget;
+  items: ImageArtifactPreviewTarget[];
+  startIndex: number;
+  /** Attach this image to the composer and focus the input; the viewer closes first. */
+  onAsk?: (item: ImageArtifactPreviewTarget) => void;
+};
+
+let session: ImageGallerySession | null = null;
+
+export function setImageGallerySession(next: ImageGallerySession): ImageGallerySession {
+  const startIndex = ImageViewerIndex.clamp(next.startIndex, next.items.length);
+  session = { ...next, startIndex };
+  return session;
+}
+
+export function peekImageGallerySession(): ImageGallerySession | null {
+  return session;
+}
+
+export function clearImageGallerySession(): void {
+  session = null;
+}
+
+/** Build a session for a tapped image, including its siblings in the same message. */
+export function gallerySessionFor(
+  items: ImageArtifactPreviewTarget[],
+  tapped: ImageArtifactPreviewTarget,
+  threadTarget: MobileArtifactTarget,
+  onAsk?: (item: ImageArtifactPreviewTarget) => void,
+): ImageGallerySession {
+  const startIndex = Math.max(
+    0,
+    items.findIndex((item) => item.artifactId === tapped.artifactId),
+  );
+  return setImageGallerySession({
+    threadTarget,
+    items: items.length ? items : [tapped],
+    startIndex: items.length ? startIndex : 0,
+    onAsk,
+  });
+}
