+import { BOT_COLOR_LIST } from "@rakazo/contracts";
+import { OFFICIAL_FACE_SHAPE_KEYS, SHIPPED_BOT_AVATAR_SHAPE_KEYS } from "@rakazo/core";
+import * as SplashScreen from "expo-splash-screen";
+import { useEffect } from "react";
+import { ScrollView, Text, View } from "react-native";
+import { GestureHandlerRootView } from "react-native-gesture-handler";
+import { useMobileTokens } from "../lib/native";
+import { BotAvatar } from "./bot-avatar";
+
+/**
+ * A single still page of every palette colour, every body and a short bot list, drawn by the
+ * app's own `BotAvatar`. Only a review build compiled with `EXPO_PUBLIC_AVATAR_REVIEW=1` shows
+ * it (the CI simulator job photographs it in light and dark); a shipped build never does.
+ */
+export function AvatarReviewGallery() {
+  const tokens = useMobileTokens();
+  useEffect(() => {
+    void SplashScreen.hideAsync().catch(() => undefined);
+  }, []);
+  const colors = BOT_COLOR_LIST;
+  const label = { color: tokens.mutedForeground, fontSize: 13, marginTop: 18, marginBottom: 8 };
+  const shapeValue = (key: string, index: number) => {
+    const color = colors[(index % (colors.length - 2)) + 2]!.hex;
+    return `${color}::shape_${SHIPPED_BOT_AVATAR_SHAPE_KEYS.indexOf(key as never)}`;
+  };
+  const rows = [
+    {
+      id: "review-bot-1",
+      name: "Research",
+      note: "Found 3 papers on early sepsis bundles",
+      c: "violet",
+    },
+    { id: "review-bot-2", name: "Inbox", note: "2 replies drafted, waiting for you", c: "orange" },
+    {
+      id: "review-bot-3",
+      name: "Shift planner",
+      note: "Night block: sleep 08:30–15:00",
+      c: "green",
+    },
+    { id: "review-bot-4", name: "Parcel", note: "Out for delivery", c: "blue" },
+    { id: "review-bot-5", name: "Notes", note: "Saved", c: "black" },
+  ];
+  return (
+    <GestureHandlerRootView style={{ flex: 1, backgroundColor: tokens.background }}>
+      <ScrollView
+        contentContainerStyle={{ paddingTop: 64, paddingHorizontal: 20, paddingBottom: 40 }}
+      >
+        <Text style={{ color: tokens.foreground, fontSize: 28, fontWeight: "700" }}>Avatars</Text>
+        <Text style={label}>Palette · {colors.length} colours</Text>
+        <View style={{ flexDirection: "row", flexWrap: "wrap", gap: 10 }}>
+          {colors.map((color) => (
+            <View key={color.id} style={{ alignItems: "center", width: 50 }}>
+              <BotAvatar
+                color={color.hex}
+                identity={`review-${color.id}`}
+                size={44}
+                motion="static"
+              />
+              <Text
+                style={{ color: tokens.mutedForeground, fontSize: 9, marginTop: 2 }}
+                numberOfLines={1}
+              >
+                {color.name}
+              </Text>
+            </View>
+          ))}
+        </View>
+        <Text style={label}>Bodies · {OFFICIAL_FACE_SHAPE_KEYS.length}</Text>
+        <View style={{ flexDirection: "row", flexWrap: "wrap", gap: 12 }}>
+          {OFFICIAL_FACE_SHAPE_KEYS.map((key, index) => (
+            <BotAvatar
+              key={key}
+              color={shapeValue(key, index)}
+              identity={`shape-${key}`}
+              size={44}
+              motion="static"
+            />
+          ))}
+        </View>
+        <Text style={label}>Bot list</Text>
+        {rows.map((row) => (
+          <View
+            key={row.id}
+            style={{ flexDirection: "row", alignItems: "center", paddingVertical: 8, gap: 12 }}
+          >
+            <BotAvatar
+              color={colors.find((color) => color.id === row.c)!.hex}
+              identity={row.id}
+              size={44}
+              motion="static"
+            />
+            <View style={{ flex: 1 }}>
+              <Text style={{ color: tokens.foreground, fontSize: 16, fontWeight: "600" }}>
+                {row.name}
+              </Text>
+              <Text style={{ color: tokens.mutedForeground, fontSize: 14 }} numberOfLines={1}>
+                {row.note}
+              </Text>
+            </View>
+          </View>
+        ))}
+      </ScrollView>
+    </GestureHandlerRootView>
+  );
+}
