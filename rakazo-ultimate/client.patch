+import { describe, expect, it } from "vitest";
+import {
+  MOCHI_COLOR_ROWS,
+  MOCHI_COLORS,
+  MOCHI_SHAPE_KEYS,
+  mochiActivityFromSignals,
+  mochiAvatarFill,
+  mochiAvatarSvg,
+  mochiBodyPath,
+  mochiFace,
+  mochiMorphRing,
+  mochiMotionPlan,
+  mochiShapeRing,
+} from "./mochi-avatar.js";
+
+describe("mochiActivityFromSignals", () => {
+  it("maps explicit activity and status onto the five mochi states", () => {
+    expect(mochiActivityFromSignals({ status: "failed" })).toBe("error");
+    expect(mochiActivityFromSignals({ activity: "error" })).toBe("error");
+    expect(mochiActivityFromSignals({ activity: "thinking" })).toBe("thinking");
+    expect(mochiActivityFromSignals({ status: "thinking" })).toBe("thinking");
+    expect(mochiActivityFromSignals({ activity: "working" })).toBe("working");
+    expect(mochiActivityFromSignals({ activity: "reading" })).toBe("working");
+    expect(mochiActivityFromSignals({ activity: "writing" })).toBe("working");
+    expect(mochiActivityFromSignals({ activity: "computer" })).toBe("working");
+    expect(mochiActivityFromSignals({ status: "running" })).toBe("working");
+    expect(mochiActivityFromSignals({ status: "queued" })).toBe("working");
+    expect(mochiActivityFromSignals({ settling: true })).toBe("done");
+    expect(mochiActivityFromSignals({ activity: "done" })).toBe("done");
+    expect(mochiActivityFromSignals({ status: "idle" })).toBe("idle");
+    expect(mochiActivityFromSignals({})).toBe("idle");
+  });
+
+  it("prefers error over a settling hop so a failed run does not look happy", () => {
+    expect(mochiActivityFromSignals({ status: "failed", settling: true })).toBe("error");
+  });
+});
+
+describe("mochiMotionPlan", () => {
+  it("pairs each activity with its face and motion", () => {
+    expect(mochiMotionPlan("idle").expression).toBe("neutral");
+    expect(mochiMotionPlan("thinking").expression).toBe("thinking");
+    expect(mochiMotionPlan("thinking").sway).toBeGreaterThan(0);
+    expect(mochiMotionPlan("working").expression).toBe("determined");
+    expect(mochiMotionPlan("working").breathePeriod).toBeLessThan(mochiMotionPlan("idle").breathePeriod);
+    expect(mochiMotionPlan("working").bob).toBeGreaterThan(0);
+    expect(mochiMotionPlan("done").expression).toBe("happy");
+    expect(mochiMotionPlan("done").hop).toBe(true);
+    expect(mochiMotionPlan("error").expression).toBe("worried");
+    expect(mochiMotionPlan("error").shiver).toBe(true);
+  });
+
+  it("freezes motion and keeps the activity face when Reduce Motion is on", () => {
+    for (const activity of ["idle", "thinking", "working", "done", "error"] as const) {
+      const plan = mochiMotionPlan(activity, true);
+      expect(plan.expression).toBe(mochiMotionPlan(activity).expression);
+      expect(plan.breathe).toBe(0);
+      expect(plan.blink).toBe(false);
+      expect(plan.glance).toBe(false);
+      expect(plan.sway).toBe(0);
+      expect(plan.bob).toBe(0);
+      expect(plan.hop).toBe(false);
+      expect(plan.shiver).toBe(false);
+      expect(plan.wobble).toBe(false);
+    }
+  });
+});
+
+describe("mochi palette and shapes", () => {
+  it("lets every shape use every editor colour", () => {
+    const hexes = MOCHI_COLOR_ROWS.flat().map(
+      (id) => MOCHI_COLORS.find((c) => c.id === id)!.hex,
+    );
+    expect(hexes).toHaveLength(12);
+    for (const key of MOCHI_SHAPE_KEYS) {
+      const path = mochiBodyPath(key);
+      expect(path.startsWith("M")).toBe(true);
+      expect(path.endsWith("Z")).toBe(true);
+      expect(mochiShapeRing(key)).toHaveLength(64);
+      for (const hex of hexes) {
+        const svg = mochiAvatarSvg({ shape: key, color: hex, expression: "neutral" });
+        expect(svg).toContain(path.slice(0, 20));
+        expect(svg.toLowerCase()).toContain(hex.toLowerCase());
+      }
+    }
+  });
+
+  it("maps older persona colours onto the mochi palette", () => {
+    expect(mochiAvatarFill("#000000", true)).toBe(mochiAvatarFill("#F3EEE6"));
+    expect(mochiAvatarFill("#A369D9")).toBe("#D0A6EE");
+    expect(mochiAvatarFill("#EC4E2F")).toBe("#FF8F9B");
+  });
+
+  it("morphs every pair of rings with a shared vertex count", () => {
+    const mid = mochiMorphRing("blob", "hex", 0.5);
+    expect(mid).toHaveLength(64);
+    expect(mochiMorphRing("blob", "blob", 1)[0]).toEqual(mochiShapeRing("blob")[0]);
+  });
+
+  it("draws every expression with brown ink", () => {
+    for (const expression of [
+      "neutral",
+      "happy",
+      "wink",
+      "surprised",
+      "sleepy",
+      "determined",
+      "glance",
+      "worried",
+      "thinking",
+    ] as const) {
+      const face = mochiFace(expression);
+      expect(face.ink).toBe("#5C3A2E");
+      expect(face.fills.length + face.strokes.length).toBeGreaterThan(0);
+    }
+  });
+});
