@@ -0,0 +1,176 @@
+import type { ReactNode } from "react";
+import { Platform, Pressable, ScrollView, StyleSheet, Text, View } from "react-native";
+import Animated, { FadeIn, FadeOut } from "react-native-reanimated";
+import { useSafeAreaInsets } from "react-native-safe-area-context";
+import { mobileTokens } from "../../lib/appearance";
+import { useThemedStyles } from "../../lib/native";
+import { NativeSymbol } from "../native-symbol";
+import { SHEET_CONTENT_PADDING, SHEET_FADE_MS } from "./metrics";
+
+/** A page's own action: the one verb at the top-right, plus the close or back control at the left. */
+export type SandPageAction = {
+  label: string;
+  onPress: () => void;
+  disabled?: boolean;
+  busy?: boolean;
+};
+
+/**
+ * The paper a page is drawn on, with the page's own header row.
+ *
+ * Every screen of the reference app is this same frame: the page's paper, one row across the top
+ * with the way out at the left and the one verb at the right, and a body that either scrolls or
+ * stands still. A page that draws its own header keeps its title where the content starts, so the
+ * title and the thing it names share a line of sight.
+ */
+export function SandPage({
+  title,
+  subtitle,
+  onClose,
+  closeIcon = "xmark",
+  closeLabel = "关闭",
+  action,
+  trailing,
+  body = "scroll",
+  contentStyle,
+  footer,
+  children,
+  tone = "page",
+  accessibilityLabel,
+}: {
+  title?: string;
+  subtitle?: string;
+  onClose?: () => void;
+  closeIcon?: "xmark" | "chevron.left";
+  closeLabel?: string;
+  action?: SandPageAction;
+  /** A control of the page's own, beside the action (a menu, a share). */
+  trailing?: ReactNode;
+  body?: "scroll" | "static";
+  contentStyle?: object;
+  /** A bar that stays at the page's bottom, clear of the home indicator. */
+  footer?: ReactNode;
+  children: ReactNode;
+  tone?: "page" | "sheet";
+  accessibilityLabel?: string;
+}) {
+  const styles = useThemedStyles(createPageStyles);
+  const tokens = mobileTokens();
+  const insets = useSafeAreaInsets();
+  const content = (
+    <View style={[styles.content, contentStyle]}>
+      {subtitle ? <Text style={styles.subtitle}>{subtitle}</Text> : null}
+      {children}
+    </View>
+  );
+  return (
+    <Animated.View
+      entering={FadeIn.duration(SHEET_FADE_MS)}
+      exiting={FadeOut.duration(SHEET_FADE_MS)}
+      accessibilityLabel={accessibilityLabel}
+      style={[
+        styles.page,
+        { paddingTop: insets.top + 6, backgroundColor: tokens.background },
+        tone === "sheet" && styles.sheetPage,
+      ]}
+    >
+      {title || onClose || action || trailing ? (
+        <View style={styles.headerRow}>
+          <View style={styles.side}>
+            {onClose ? (
+              <Pressable
+                accessibilityRole="button"
+                accessibilityLabel={closeLabel}
+                hitSlop={10}
+                onPress={onClose}
+                style={({ pressed }) => [styles.iconButton, pressed && styles.pressed]}
+              >
+                <NativeSymbol
+                  ios={closeIcon}
+                  android={closeIcon === "xmark" ? "close" : "chevron-back"}
+                  size={18}
+                  color={tokens.foreground}
+                />
+              </Pressable>
+            ) : null}
+          </View>
+          <Text numberOfLines={1} style={styles.title}>
+            {title ?? ""}
+          </Text>
+          <View style={[styles.side, styles.sideEnd]}>
+            {trailing}
+            {action ? (
+              <Pressable
+                accessibilityRole="button"
+                accessibilityLabel={action.label}
+                accessibilityState={{ disabled: action.disabled || action.busy, busy: action.busy }}
+                disabled={action.disabled || action.busy}
+                hitSlop={8}
+                onPress={action.onPress}
+                style={({ pressed }) => [styles.action, pressed && styles.pressed]}
+              >
+                <Text
+                  style={[
+                    styles.actionLabel,
+                    (action.disabled || action.busy) && styles.actionDisabled,
+                  ]}
+                >
+                  {action.label}
+                </Text>
+              </Pressable>
+            ) : null}
+          </View>
+        </View>
+      ) : null}
+      {body === "scroll" ? (
+        <ScrollView
+          contentInsetAdjustmentBehavior="never"
+          keyboardShouldPersistTaps="handled"
+          showsVerticalScrollIndicator={false}
+          style={styles.body}
+          contentContainerStyle={styles.scrollContent}
+        >
+          {content}
+        </ScrollView>
+      ) : (
+        <View style={styles.body}>{content}</View>
+      )}
+      {footer ? (
+        <View style={[styles.footer, { paddingBottom: Math.max(insets.bottom, 12) }]}>{footer}</View>
+      ) : null}
+    </Animated.View>
+  );
+}
+
+function createPageStyles() {
+  return StyleSheet.create({
+    page: { flex: 1 },
+    sheetPage: { borderTopLeftRadius: 24, borderTopRightRadius: 24, overflow: "hidden" },
+    headerRow: {
+      minHeight: 44,
+      flexDirection: "row",
+      alignItems: "center",
+      paddingHorizontal: 8,
+      gap: 8,
+    },
+    side: { minWidth: 44, flexDirection: "row", alignItems: "center", gap: 6 },
+    sideEnd: { justifyContent: "flex-end" },
+    iconButton: {
+      width: 34,
+      height: 34,
+      borderRadius: 17,
+      alignItems: "center",
+      justifyContent: "center",
+    },
+    title: { flex: 1, textAlign: "center", fontSize: 17, fontWeight: "600" },
+    action: { minHeight: 34, paddingHorizontal: 8, alignItems: "center", justifyContent: "center" },
+    actionLabel: { fontSize: 17, fontWeight: "600" },
+    actionDisabled: { opacity: 0.45 },
+    body: { flex: 1 },
+    scrollContent: { paddingBottom: Platform.OS === "android" ? 24 : 8 },
+    content: { paddingHorizontal: SHEET_CONTENT_PADDING, paddingTop: 4, gap: 16 },
+    subtitle: { fontSize: 15, lineHeight: 20 },
+    footer: { paddingHorizontal: SHEET_CONTENT_PADDING, paddingTop: 8 },
+    pressed: { opacity: 0.55 },
+  });
+}
