+import { describe, expect, it, vi } from "vitest";
+
+const open = vi.fn(async () => undefined);
+
+vi.mock("expo-modules-core", () => ({
+  requireOptionalNativeModule: (name: string) => (name === "RakazoQuickLook" ? { open } : null),
+}));
+
+describe("quickLookOpens", () => {
+  it("opens documents, slides, sheets and plain text in the viewer", async () => {
+    const { quickLookOpens } = await import("./quick-look");
+    expect(quickLookOpens("application/pdf")).toBe(true);
+    expect(quickLookOpens("text/markdown")).toBe(true);
+    expect(quickLookOpens("application/vnd.openxmlformats-officedocument.presentationml.presentation"))
+      .toBe(true);
+    expect(quickLookOpens("application/vnd.openxmlformats-officedocument.wordprocessingml.document"))
+      .toBe(true);
+    expect(quickLookOpens("application/vnd.apple.keynote")).toBe(true);
+  });
+
+  it("hands an installer or an archive to the share sheet instead", async () => {
+    const { quickLookOpens } = await import("./quick-look");
+    expect(quickLookOpens("application/x-ios-app")).toBe(false);
+    expect(quickLookOpens("application/zip")).toBe(false);
+    expect(quickLookOpens("application/x-msdownload")).toBe(false);
+    expect(quickLookOpens("application/octet-stream")).toBe(false);
+  });
+
+  it("opens the file it was given", async () => {
+    const { openInQuickLook } = await import("./quick-look");
+    await openInQuickLook("file:///docs/plan.md");
+    expect(open).toHaveBeenCalledWith("file:///docs/plan.md");
+  });
+});
