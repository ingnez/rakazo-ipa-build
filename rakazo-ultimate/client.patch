+export const EMOJI_FLAG: EmojiCategory = { id: "flag", title: msg`Flags`, entries: parse(FLAG) };
+
+export const EMOJI_CATEGORIES: EmojiCategory[] = [
+  EMOJI_SMILEYS,
+  EMOJI_NATURE,
+  EMOJI_FOOD,
+  EMOJI_TRAVEL,
+  EMOJI_ACTIVITY,
+  EMOJI_OBJECT,
+  EMOJI_SYMBOL,
+  EMOJI_FLAG,
+];
+
+/** Every emoji the picker shows, for a search that ignores the categories. */
+export const ALL_EMOJI: EmojiEntry[] = EMOJI_CATEGORIES.flatMap((category) => category.entries);
+
+/** The emoji a search keeps: its own words, or one of the categories it appears in. */
+export function searchEmoji(query: string, titles: Record<string, string>): EmojiCategory[] {
+  const needle = query.trim().toLowerCase();
+  if (!needle) return EMOJI_CATEGORIES;
+  return EMOJI_CATEGORIES.map((category) => ({
+    ...category,
+    entries: category.entries.filter(
+      (entry) =>
+        entry.emoji === query.trim() ||
+        entry.keywords.toLowerCase().includes(needle) ||
+        titles[category.id]?.toLowerCase().includes(needle),
+    ),
+  })).filter((category) => category.entries.length > 0);
+}
