@@ -0,0 +1,20 @@
+import type { ReactNode } from "react";
+import type { StyleProp, ViewStyle } from "react-native";
+import { View } from "react-native";
+
+export type GlassSurfaceProps = {
+  shape?: "capsule" | "circle" | "roundedRectangle";
+  /** Corner radius for `roundedRectangle`. */
+  cornerRadius?: number;
+  /** Glass tint, e.g. for a selected or primary control. */
+  tint?: string;
+  style?: StyleProp<ViewStyle>;
+  /** Applied where Liquid Glass is unavailable (Android, iOS before 26). */
+  fallbackStyle?: StyleProp<ViewStyle>;
+  children?: ReactNode;
+};
+
+/** Android and older iOS draw the fallback fill; iOS 26 renders Liquid Glass. */
+export function GlassSurface({ style, fallbackStyle, children }: GlassSurfaceProps) {
+  return <View style={[style, fallbackStyle]}>{children}</View>;
+}
diff --git a/apps/mobile/components/native/glass-title.ios.tsx b/apps/mobile/components/native/glass-title.ios.tsx
new file mode 100644
index 000000000..cec9e3e4e
--- /dev/null
+++ b/apps/mobile/components/native/glass-title.ios.tsx
@@ -0,0 +1,79 @@
+import { Host, Text } from "@expo/ui/swift-ui";
+import {
+  dynamicTypeSize,
+  font,
+  frame,
+  glassEffect,
+  lineLimit,
+  padding,
+} from "@expo/ui/swift-ui/modifiers";
+import { Text as RNText, StyleSheet, useWindowDimensions, View } from "react-native";
+import { useResolvedAppearance } from "../../lib/native/native";
+import {
+  HEADER_CONTROL_SIZE,
+  HEADER_TITLE_MAX_FONT_SCALE,
+  iosAtLeast,
+} from "../../lib/native/native-controls";
+
+/**
+ * Liquid Glass title capsule. The bar sizes its title view before SwiftUI measures,
+ * so an invisible copy of the title gives the capsule its size on the first layout.
+ */
+export function GlassTitle({ title }: { title: string }) {
+  const scheme = useResolvedAppearance();
+  // Bar titles stay between the default text size and xxxLarge; the sizer must match the text.
+  const { fontScale } = useWindowDimensions();
+  const scale = Math.min(Math.max(fontScale, 1), HEADER_TITLE_MAX_FONT_SCALE);
+  if (!title.trim()) return null;
+  return (
+    <View accessibilityLabel={title} accessibilityRole="header" accessible style={styles.frame}>
+      <RNText
+        allowFontScaling={false}
+        numberOfLines={1}
+        style={[styles.sizer, { fontSize: 17 * scale }]}
+      >
+        {title}
+      </RNText>
+      <Host colorScheme={scheme} style={StyleSheet.absoluteFill}>
+        <Text
+          modifiers={[
+            font({ textStyle: "body", weight: "semibold" }),
+            dynamicTypeSize({ min: "large", max: "xxxLarge" }),
+            lineLimit(1),
+            padding({ horizontal: 16 }),
+            frame({ height: HEADER_CONTROL_SIZE }),
+            glassEffect({ glass: { variant: "regular" }, shape: "capsule" }),
+          ]}
+        >
+          {title}
+        </Text>
+      </Host>
+    </View>
+  );
+}
+
+export function floatingHeaderOptions() {
+  if (!iosAtLeast(26)) return {};
+  return {
+    headerTransparent: true,
+    headerStyle: { backgroundColor: "transparent" },
+    headerTitle: ({ children }: { children: string }) => <GlassTitle title={children} />,
+  };
+}
+
+export function glassHeaderOptions(title: string) {
+  return { ...floatingHeaderOptions(), title };
+}
+
+const styles = StyleSheet.create({
+  frame: {
+    maxWidth: 240,
+    height: HEADER_CONTROL_SIZE,
+    paddingHorizontal: 16,
+    justifyContent: "center",
+  },
+  sizer: {
+    opacity: 0,
+    fontWeight: "600",
+  },
+});
diff --git a/apps/mobile/components/native/native-action-button.ios.tsx b/apps/mobile/components/native/native-action-button.ios.tsx
new file mode 100644
index 000000000..456f69bec
--- /dev/null
+++ b/apps/mobile/components/native/native-action-button.ios.tsx
@@ -0,0 +1,172 @@
+import { Button, Host, Label, ProgressView, Text } from "@expo/ui/swift-ui";
+import {
+  accessibilityAddTraits,
+  accessibilityHidden,
+  accessibilityLabel as accessibilityName,
+  accessibilityRemoveTraits,
+  buttonStyle,
+  controlSize,
+  disabled as disable,
+  font,
+  foregroundStyle,
+  frame,
+  labelStyle,
+  padding,
+  progressViewStyle,
+  tint,
+} from "@expo/ui/swift-ui/modifiers";
+import { StyleSheet, View } from "react-native";
+import { useMobileTokens, useResolvedAppearance } from "../../lib/native/native";
+import { actionPressHandler } from "../../lib/native/native-control-actions";
+import type { ActionProminence, NativeActionButtonProps } from "../../lib/native/native-controls";
+import { actionFills, actionProminence, iosAtLeast } from "../../lib/native/native-controls";
+
+/** SwiftUI button. Glass styles need iOS 26; older iOS uses the bordered system styles. */
+export function NativeActionButton({
+  label,
+  accessibilityLabel,
+  accessibilityActions,
+  onAccessibilityAction,
+  onPress,
+  disabled = false,
+  busy = false,
+  prominence = "primary",
+  variant,
+  fill,
+  style,
+  size = "default",
+  icon,
+  selected,
+}: NativeActionButtonProps) {
+  const tokens = useMobileTokens();
+  const scheme = useResolvedAppearance();
+  const inactive = disabled || busy;
+  const press = actionPressHandler(inactive, onPress);
+  const stretches = actionFills(prominence, fill);
+  const small = size === "compact";
+  const effectiveProminence = actionProminence(prominence, selected);
+  const role = prominence === "destructive" ? "destructive" : "default";
+  // The prominent styles draw a white label, which disappears on the light dark-mode primary.
+  const filled = !inactive && effectiveProminence === "primary";
+  const ownLabel = stretches || filled || variant !== undefined;
+  const measuredWidth = StyleSheet.flatten(style)?.width;
+  const labelModifiers = variant
+    ? [
+        font({ textStyle: "callout", weight: "medium" }),
+        foregroundStyle(prominence === "destructive" ? tokens.destructive : tokens.link),
+        padding({ horizontal: 0, vertical: 8 }),
+        ...(stretches
+          ? [
+              typeof measuredWidth === "number"
+                ? frame({ width: measuredWidth })
+                : frame({ maxWidth: Infinity }),
+            ]
+          : []),
+        // The destructive text action (Disconnect) keeps a 44pt target.
+        ...(prominence === "destructive" ? [frame({ minHeight: 44 })] : []),
+      ]
+    : [
+        ...(stretches ? [frame({ maxWidth: Infinity, ...(small ? { minHeight: 16 } : {}) })] : []),
+        ...(filled ? [foregroundStyle(tokens.primaryForeground)] : []),
+      ];
+  // Destructive buttons use the prominent style, which fills with the tint under a white
+  // label; the text-red `destructive` is too pale for that in dark mode.
+  const color =
+    effectiveProminence === "destructive"
+      ? variant
+        ? tokens.destructive
+        : tokens.destructiveFill
+      : effectiveProminence === "primary"
+        ? tokens.primary
+        : undefined;
+  const button = (
+    <Host
+      // Expo UI reads matchContents only on mount. Wrapping changes which axis Yoga owns.
+      key={stretches ? "fill" : "intrinsic"}
+      colorScheme={scheme}
+      ignoreSafeArea="container"
+      matchContents={stretches ? { vertical: true } : true}
+      style={[
+        stretches
+          ? { alignSelf: "stretch", minHeight: small ? undefined : 48 }
+          : { alignSelf: "flex-start" },
+        style,
+      ]}
+    >
+      <Button
+        label={busy || ownLabel ? undefined : (label ?? accessibilityLabel)}
+        systemImage={icon?.ios as never}
+        onPress={press}
+        role={role}
+        modifiers={[
+          ...(accessibilityActions?.length ? [accessibilityHidden(true)] : []),
+          buttonStyle(variant ? "plain" : swiftStyle(effectiveProminence)),
+          controlSize(
+            small ? "small" : stretches ? "large" : prominence === "quiet" ? "small" : "regular",
+          ),
+          ...(small ? [font({ size: 13 })] : []),
+          ...(icon && !label ? [labelStyle("iconOnly")] : []),
+          ...(selected === undefined
+            ? []
+            : [
+                selected
+                  ? accessibilityAddTraits(["isSelected"])
+                  : accessibilityRemoveTraits(["isSelected"]),
+              ]),
+          ...(!variant && prominence === "quiet"
+            ? [font({ size: 15 }), foregroundStyle(tokens.mutedForeground)]
+            : []),
+          disable(inactive),
+          ...(color ? [tint(color)] : []),
+          ...(variant || busy || (accessibilityLabel && accessibilityLabel !== label)
+            ? [accessibilityName(accessibilityLabel ?? label ?? "")]
+            : []),
+        ]}
+      >
+        {busy ? (
+          <ProgressView
+            modifiers={[
+              progressViewStyle("circular"),
+              ...(stretches ? [frame({ maxWidth: Infinity })] : []),
+            ]}
+          />
+        ) : ownLabel && icon ? (
+          <Label
+            title={label ?? accessibilityLabel}
+            systemImage={icon.ios as never}
+            modifiers={labelModifiers}
+          />
+        ) : ownLabel ? (
+          <Text modifiers={labelModifiers}>{label}</Text>
+        ) : undefined}
+      </Button>
+    </Host>
+  );
+  // Expo UI does not expose SwiftUI custom accessibility actions. Give the native
+  // control one React Native accessibility element with the same activation and menu.
+  return accessibilityActions?.length ? (
+    <View
+      accessible
+      accessibilityRole="button"
+      accessibilityLabel={accessibilityLabel ?? label}
+      accessibilityState={{ disabled: inactive, ...(selected === undefined ? {} : { selected }) }}
+      accessibilityActions={accessibilityActions}
+      onAccessibilityAction={onAccessibilityAction}
+      onAccessibilityTap={press}
+    >
+      {button}
+    </View>
+  ) : (
+    button
+  );
+}
+
+function swiftStyle(prominence: ActionProminence) {
+  const glass = iosAtLeast(26);
+  if (prominence === "primary" || prominence === "destructive") {
+    return glass ? "glassProminent" : "borderedProminent";
+  }
+  if (prominence === "quiet") return "plain";
+  if (prominence === "plain") return glass ? "glass" : "plain";
+  return glass ? "glass" : "bordered";
+}
diff --git a/apps/mobile/components/native/native-inset-list.tsx b/apps/mobile/components/native/native-inset-list.tsx
new file mode 100644
index 000000000..8e80311cf
--- /dev/null
+++ b/apps/mobile/components/native/native-inset-list.tsx
@@ -0,0 +1,87 @@
+import { Host, List, Spacer } from "@expo/ui/swift-ui";
+import type { ViewModifier } from "@expo/ui/swift-ui/modifiers";
+import {
+  frame,
+  ignoreSafeArea,
+  listRowInsets,
+  listSectionMargins,
+  listStyle,
+} from "@expo/ui/swift-ui/modifiers";
+import type { ReactNode, Ref } from "react";
+import type { ColorValue } from "react-native";
+import { useSafeAreaInsets } from "react-native-safe-area-context";
+import { useFloatingHeaderInset } from "../../lib/layout/floating-header";
+import { useResolvedAppearance } from "../../lib/native/native";
+import { iosAtLeast } from "../../lib/native/native-controls";
+
+/**
+ * A SwiftUI list (inset grouped by default) filling a screen under the floating header.
+ *
+ * The header's height comes from navigation, not from the hosting view's safe area, which can be
+ * stale after a text size change and put the first row under the close button and title. So the
+ * list ignores the top and bottom safe area and the first section starts with a spacer of the
+ * header's height (`useInsetListEdges`), inside the scroll content so rows still scroll under
+ * the header. The side safe area stays, so rows keep clear of side bars and the iPhone Duo outer
+ * display's status bar.
+ */
+export function NativeInsetList({
+  hostRef,
+  variant = "insetGrouped",
+  modifiers = [],
+  background,
+  seedColor,
+  children,
+}: {
+  /** The hosting view, for native calls that act on the list inside it. */
+  hostRef?: Ref<unknown>;
+  variant?: "insetGrouped" | "plain";
+  modifiers?: ViewModifier[];
+  background?: ColorValue;
+  seedColor?: ColorValue;
+  children: ReactNode;
+}) {
+  const headerInset = useFloatingHeaderInset();
+  const scheme = useResolvedAppearance();
+  return (
+    <Host
+      ref={hostRef}
+      // Rebuilt when the appearance changes, so no row keeps the other theme's colours.
+      key={scheme}
+      style={{ flex: 1, backgroundColor: background }}
+      colorScheme={scheme}
+      seedColor={seedColor}
+    >
+      <List
+        modifiers={[
+          listStyle(variant),
+          ...(headerInset > 0 ? [ignoreSafeArea({ regions: "container", edges: "vertical" })] : []),
+          ...modifiers,
+        ]}
+      >
+        {children}
+      </List>
+    </Host>
+  );
+}
+
+/**
+ * The first section's top (flush on iOS 26, then the floating header's height when there is one)
+ * and the last section's footer, which keeps the last row above the home indicator.
+ */
+export function useInsetListEdges() {
+  const headerInset = useFloatingHeaderInset();
+  const { bottom } = useSafeAreaInsets();
+  return {
+    footer: <Spacer modifiers={[frame({ height: bottom })]} />,
+    modifiers: iosAtLeast(26) ? [listSectionMargins({ edges: "top", length: 0 })] : undefined,
+    header:
+      headerInset > 0 ? (
+        <Spacer
+          modifiers={[
+            frame({ height: headerInset }),
+            listRowInsets({ top: 0, leading: 0, bottom: 0, trailing: 0 }),
+          ]}
+        />
+      ) : undefined,
+  };
+}
diff --git a/apps/mobile/components/native/native-provider-button.tsx b/apps/mobile/components/native/native-provider-button.tsx
