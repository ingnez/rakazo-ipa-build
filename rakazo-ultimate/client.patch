+          try data.write(to: file, options: .atomic)
+        } catch {
+          figure("not written", uri)
+          promise.resolve(nil)
+          return
+        }
+      }
+      promise.resolve([
+        "uri": file.absoluteString,
+        "width": Double(image.size.width),
+        "height": Double(image.size.height),
