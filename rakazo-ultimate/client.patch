+    act(() =>
+      root.render(<MochiBotAvatar color="#E8C4A8" identity="bot-1" size={50} motion="live" />),
+    );
+    expect(container.querySelector('[data-testid="mochi-avatar-glossy"]')).not.toBeNull();
+    expect(container.querySelectorAll('[data-svg="radial"]').length).toBeGreaterThan(0);
+    expect(container.querySelectorAll('[data-svg="linear"]').length).toBeGreaterThan(0);
+    expect(container.querySelectorAll('[data-svg="ellipse"]').length).toBeGreaterThan(1);
