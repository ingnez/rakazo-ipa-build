+export const AVATAR_SOLIDS: Readonly<Record<string, { light: string; dark: string }>> =
+  Object.fromEntries(
+    AVATAR_COLOR_NAMES.map((id) => {
+      const color = paletteColor(id);
+      return [id, { light: color.hex, dark: darkBody(color) }];
+    }),
+  );
