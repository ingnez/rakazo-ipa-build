+}
+
+function Chip({ text, color, background }: { text: string; color: string; background: string }) {
+  return (
+    <View style={[styles.chip, { backgroundColor: background }]}>
+      <Text numberOfLines={1} style={[styles.chipText, { color }]}>
+        {text}
+      </Text>
+    </View>
+  );
+}
+
+/** One line of the timeline: what it was, when, how long, and the address it reached. */
+function StepRow({
+  step,
+  first,
+  last,
+  copied,
+  onCopy,
+}: {
+  step: TaskStep;
+  first: boolean;
+  last: boolean;
+  copied: boolean;
+  onCopy: (detail: string) => void;
+}) {
+  const tokens = useMobileTokens();
+  const tool = step.kind === "tool";
+  const symbol = tool ? toolSymbol(step) : stepSymbol(step);
+  const failed = step.status === "failed";
+  const running = step.status === "running";
+  const ink = failed ? tokens.destructive : running ? tokens.foreground : tokens.mutedForeground;
+  return (
+    <View style={styles.step}>
+      <View style={styles.rail}>
+        <View
+          style={[
+            styles.railLine,
+            { backgroundColor: tokens.border },
+            first ? { top: 22 } : null,
+            last ? { bottom: undefined, height: 22 } : null,
+          ]}
+        />
+        <View style={styles.railIcon}>
+          <NativeSymbol ios={symbol.ios} android={symbol.android} size={14} color={ink} />
+        </View>
+      </View>
+      <View style={styles.stepBody}>
+        <View style={styles.stepHead}>
+          <Text
+            numberOfLines={tool ? 2 : 4}
+            style={[
+              styles.stepLabel,
+              { color: tool ? tokens.foreground : tokens.foreground },
+              tool ? styles.stepLabelTool : null,
+            ]}
+          >
+            {step.label}
+          </Text>
+          <View style={styles.stepTrail}>
+            {running ? (
+              <ActivityIndicator size="small" color={tokens.mutedForeground} />
+            ) : failed ? (
+              <NativeSymbol
+                ios="xmark"
+                android="close"
+                size={11}
+                color={tokens.destructive}
+                weight="semibold"
+              />
+            ) : step.durationMs !== undefined ? (
+              <Text style={[styles.stepTime, { color: tokens.mutedForeground }]}>
+                {taskDurationLabel(step.durationMs)}
+              </Text>
+            ) : null}
+          </View>
+        </View>
+        {step.detail ? (
+          <Pressable
+            accessibilityRole="button"
+            accessibilityLabel={`复制：${step.detail}`}
+            delayLongPress={250}
+            onLongPress={() => onCopy(step.detail ?? "")}
+            style={[styles.code, { backgroundColor: tokens.muted }]}
+          >
+            <Text
+              numberOfLines={6}
+              style={[styles.codeText, { color: tokens.secondaryForeground }]}
+            >
+              {step.detail}
+            </Text>
+            {copied ? (
+              <Text style={[styles.copied, { color: tokens.mutedForeground }]}>已复制</Text>
+            ) : null}
+          </Pressable>
+        ) : null}
+      </View>
+    </View>
+  );
+}
+
+type Glyph = { ios: string; android: Parameters<typeof NativeSymbol>[0]["android"] };
+
+/** A call's own mark, from the tool it ran: the shell, a file, the web, the computer. */
+function toolSymbol(step: TaskStep): Glyph {
+  const name = `${step.toolName ?? ""} ${step.label}`.toLowerCase();
+  if (/shell|bash|terminal|exec|command/.test(name))
+    return { ios: "terminal", android: "terminal-outline" };
+  if (/read|write|edit|file|patch|notebook/.test(name))
+    return { ios: "doc.text", android: "document-text-outline" };
+  if (/web|fetch|http|search|browser|link/.test(name))
+    return { ios: "globe", android: "globe-outline" };
+  if (/computer|desktop|screen|ui/.test(name))
+    return { ios: "desktopcomputer", android: "desktop-outline" };
+  if (/image|photo|draw/.test(name)) return { ios: "photo", android: "image-outline" };
+  return { ios: "wrench.and.screwdriver", android: "construct-outline" };
+}
+
+/** A status line is a marker; what the model said is a bubble. */
+function stepSymbol(step: TaskStep): Glyph {
+  if (step.kind === "status")
+    return step.status === "running"
+      ? { ios: "hourglass", android: "hourglass-outline" }
+      : { ios: "play", android: "play-outline" };
+  return { ios: "bubble.left", android: "chatbubble-outline" };
+}
