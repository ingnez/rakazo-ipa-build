+/**
+ * The zoom each body needs so the bodies read the same size, computed from the rings themselves.
+ *
+ * The reference app scales each of its own bodies by 0.8267–1.0404, but that table is about its
+ * own art: laid over these rings it leaves a triangle (`wedge`, 0.8267) at roughly half the area
+ * of a blob, so a grid of bodies looks like one shrunken chip among ten. This is the same idea
+ * done once from the art we ship: every ring is normalised to the median ring's area, so equal
+ * area is what equal size means here. Kept inside a narrow band so no body is pushed past the
+ * canvas its avatar is drawn on.
+ */
+export const BABYGROK_VISUAL_SCALES: Readonly<Record<string, number>> = (() => {
+  const area = (ring: readonly number[]): number => {
+    let sum = 0;
+    const count = ring.length / 2;
+    for (let index = 0; index < count; index += 1) {
+      const next = (index + 1) % count;
+      sum += ring[index * 2]! * ring[next * 2 + 1]! - ring[next * 2]! * ring[index * 2 + 1]!;
+    }
+    return Math.abs(sum) / 2;
+  };
+  const areas = Object.entries(BABYGROK_BODIES).map(([key, body]) => [key, area(body.ring)] as const);
+  const sorted = areas.map(([, value]) => value).sort((a, b) => a - b);
+  const median = sorted[Math.floor(sorted.length / 2)] ?? 1;
+  const scales: Record<string, number> = {};
+  for (const [key, value] of areas) {
+    const scale = Math.sqrt(median / value);
+    scales[key] = Math.min(1.22, Math.max(0.86, scale));
+  }
+  return scales;
+})();
+
+/** A body's zoom for the size every body is meant to read at, or 1 for a body not shipped. */
+export function babygrokVisualScale(key: string): number {
+  return BABYGROK_VISUAL_SCALES[key] ?? 1;
+}
+
+/**
+ * How much larger than its footprint an avatar's canvas is drawn, and the box that canvas holds.
+ *
+ * A body is drawn to the very edge of its own 200-unit box, so the reference app's clips — which
+ * lift, turn and squash it by up to a fifth of its width — painted past the canvas and the top of
+ * the head was cut off flat. The canvas is this much wider while the body keeps the same scale
+ * inside it, so a pose has somewhere to go and the avatar still takes the same room on screen.
+ */
+export const BABYGROK_DRAW_MARGIN = 1.28;
+export const BABYGROK_DRAW_VIEWBOX = "-128 -128 256 256";
