+    expect(container.querySelectorAll('[data-svg="clip"]')).toHaveLength(0);
+    expect(container.querySelectorAll('[data-svg="ellipse"]').length).toBe(1);
+    expect(container.querySelectorAll('[data-svg="path"]').length).toBeGreaterThan(0);
+    expect(motion.repeats).toBe(0);
