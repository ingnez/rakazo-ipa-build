+
+const rpc = vi.hoisted(() => vi.fn());
+const alert = vi.hoisted(() => vi.fn());
+const hapticSelection = vi.hoisted(() => vi.fn());
+
+vi.mock("react-native", async () => {
+  const { createElement } = await import("react");
