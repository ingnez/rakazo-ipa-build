@@ -0,0 +1,36 @@
+/**
+ * The PDF module's other half: a first page drawn small enough to sit on a chat card. It is the
+ * same native module that shows a PDF in full (`RakazoPdfView`), asked for a thumbnail instead of
+ * a view; a build made before the function existed answers `null`, and the card then keeps the
+ * compact file row it had.
+ */
+import { optionalNativeModule } from "./optional-native";
+
+type PdfThumbnailNative = {
+  pdfThumbnail?: (uri: string, maxWidth: number) => Promise<string | null>;
+};
+
+let found: PdfThumbnailNative | null | undefined;
+
+/** The module, asked for the first time a card has a PDF to draw, then remembered. */
+function pdfModule(): PdfThumbnailNative | null {
+  if (found !== undefined) return found;
+  found = optionalNativeModule<PdfThumbnailNative>("RakazoPdfView");
+  return found;
+}
+
+/** Whether this build can draw a PDF's first page on a card. */
+export function pdfThumbnailAvailable(): boolean {
+  return typeof pdfModule()?.pdfThumbnail === "function";
+}
+
+/**
+ * A local `file://` PNG of the PDF's first page, `maxWidth` points wide, written into the app's
+ * cache by the native side and reused on the next card that asks. A PDF the system cannot read
+ * answers `null` rather than an error: the card has nothing to show and says nothing.
+ */
+export async function pdfThumbnailUri(uri: string, maxWidth: number): Promise<string | null> {
+  const native = pdfModule();
+  if (!native?.pdfThumbnail) return null;
+  return native.pdfThumbnail(uri, maxWidth);
+}
