+import { describe, expect, it, vi } from "vitest";
+import type { LumenManifest } from "./lumen-manifest";
+import { lumenManifestUrl, parseLumenManifest } from "./lumen-manifest";
+
+/** The art this build ships: every picture in it is in the bundle, at a fake asset id. */
+const SHIPPED_VERSION = "20261122-transparent";
+const BUNDLED_ASSET = 7;
+
+vi.mock("./lumen-builtin-avatars", () => {
+  /** Written out here rather than parsed, because a mock factory may not reach for an import. */
+  const shipped = {
+    version: "20261122-transparent",
+    baseUrl: "https://builtin.rakazo.app/lumen-avatars/manifest.json",
+    headerMinPt: 72,
+    reduceMotionStatic: true,
+    surfaces: { "home-hero": "header", chat: "header", "home-list": "list", default: "auto" },
+    bots: [
+      {
+        botId: "chief-id",
+        name: "小猪包",
+        role: "chief",
+        starBaked: true,
+        listVariant: "v3-full",
+        listSizePt: 96,
+        heroSizePt: 136,
+        themes: {
+          dark: {
+            static: "assets/static/chief-dark.png",
+            list: "assets/list/chief-dark.gif",
+            header: "assets/header/chief-dark.gif",
+          },
+          light: {
+            static: "assets/static/chief-light.png",
+            list: "assets/list/chief-light.gif",
+            header: "assets/header/chief-light.gif",
+          },
+        },
+      },
+    ],
+    hashes: { "assets/header/chief-dark.gif": "abc123" },
+  };
+  return {
+    LUMEN_BUILTIN_BASE_URL: "https://builtin.rakazo.app/lumen-avatars/manifest.json",
+    LUMEN_BUILTIN_MANIFEST: shipped,
+    LUMEN_BUILTIN_VERSION: "20261122-transparent",
+    lumenBuiltinAssets: () => ({}),
+    lumenBuiltinPath: (uri: string) => new URL(uri).pathname.replace(/^\/lumen-avatars\//, ""),
+    lumenBuiltinAssetFor: (uri: string) =>
+      uri.includes("/lumen-avatars/assets/") ? 7 : null,
+    lumenBuiltinVersion: (version: string | null | undefined) =>
+      version === "20261122-transparent",
+  };
+});
+
+const { lumenAvatarChoice } = await import("./lumen-avatar-source");
+
+const manifestOf = (version: string, header: string, extra: Record<string, unknown> = {}) =>
+  parseLumenManifest(
+    {
+      schemaVersion: 2,
+      version,
+      bots: [
+        {
+          botId: "chief-id",
+          name: "小猪包",
+          role: "chief",
+          heroSizePt: 136,
+          themes: { dark: { header }, light: { header: "assets/header/chief-light.gif" } },
+          ...extra,
+        },
+      ],
+    },
+    lumenManifestUrl("https://rakazo.163ll.com"),
+  );
+
+const hero = (manifest: LumenManifest | null, dark = true) =>
+  lumenAvatarChoice(manifest, {
+    identity: "chief-id",
+    surface: "home-hero",
+    size: 136,
+    dark,
+    reducedMotion: false,
+  });
+
+describe("lumen avatar choice", () => {
+  it("draws the shipped art from the bundle when the manifest names it", () => {
+    const choice = hero(manifestOf(SHIPPED_VERSION, "assets/header/chief-dark.gif"));
+    expect(choice?.candidates[0]?.local).toBe(BUNDLED_ASSET);
+    expect(choice?.size).toBe(136);
+    expect(choice?.drawMainStar).toBe(true);
+  });
+
+  it("loads newer art from the server and keeps the shipped copy behind it", () => {
+    const choice = hero(manifestOf("20261201-newer", "assets/header/chief-dark.gif"));
+    // The server's picture first, fetched; the bundle's copy last, drawn if the fetch fails.
+    expect(choice?.candidates[0]?.uri).toContain("rakazo.163ll.com");
+    expect(choice?.candidates[0]?.local).toBeNull();
+    expect(choice?.candidates.at(-1)?.local).toBe(BUNDLED_ASSET);
+    expect(choice?.candidates.length).toBeGreaterThan(1);
+  });
+
+  it("never names the same address twice", () => {
+    const uris =
+      hero(manifestOf(SHIPPED_VERSION, "assets/header/chief-dark.gif"))?.candidates.map(
+        (candidate) => candidate.uri,
+      ) ?? [];
+    expect(new Set(uris).size).toBe(uris.length);
+  });
+
+  it("has nothing to draw for a bot the manifest does not name", () => {
+    expect(
+      lumenAvatarChoice(null, {
+        identity: "stranger",
+        surface: "home-hero",
+        size: 136,
+        dark: true,
+        reducedMotion: false,
+      }),
+    ).toBeNull();
+  });
+});
diff --git a/apps/mobile/lib/lumen/lumen-avatar-source.ts b/apps/mobile/lib/lumen/lumen-avatar-source.ts
new file mode 100644
index 000000000..048f18717
--- /dev/null
+++ b/apps/mobile/lib/lumen/lumen-avatar-source.ts
@@ -0,0 +1,86 @@
+/**
+ * Which picture an avatar draws, and where it comes from.
+ *
+ * The app carries the finished Lumen art itself, so the hero is drawn on the first frame after
+ * launch instead of waiting for a 1 MB GIF to arrive. The server's manifest still wins when it
+ * names newer art: the pictures it names are loaded from the server, and the shipped art is kept
+ * as the last resort, so a phone with no network — or a server that has not been given the new
+ * pictures yet — still shows a finished avatar rather than the drawn fallback body.
+ *
+ * Pure on purpose: the choice is a value, and every avatar in the app makes the same one.
+ */
+
+import type {
+  LumenManifest,
+  LumenManifestPicture,
+  LumenManifestSurface,
+} from "./lumen-manifest";
+import { lumenManifestPicture } from "./lumen-manifest";
+import {
+  LUMEN_BUILTIN_MANIFEST,
+  LUMEN_BUILTIN_VERSION,
+  lumenBuiltinAssetFor,
+} from "./lumen-builtin-avatars";
+
+export type LumenAvatarInput = {
+  identity?: string | null;
+  name?: string | null;
+  surface?: LumenManifestSurface;
+  size: number;
+  dark: boolean;
+  reducedMotion: boolean;
+};
+
+export type LumenAvatarCandidate = {
+  /** The pictured address: stable, and what a failed load is remembered by. */
+  uri: string;
+  /** The bundled picture, when this build carries this exact art; otherwise null. */
+  local: number | null;
+};
+
+export type LumenAvatarChoice = {
+  /** The pictures to try in order; the first one that has not already failed is drawn. */
+  candidates: LumenAvatarCandidate[];
+  /** The size the finished art fixes for this surface, in points, or null for the caller's own. */
+  size: number | null;
+  /** False when the art already carries the main bot's star. */
+  drawMainStar: boolean;
+};
+
+/** One manifest picture's addresses, each paired with the copy the bundle carries, if any. */
+function candidatesOf(
+  picture: LumenManifestPicture | null,
+  shipBundled: boolean,
+): LumenAvatarCandidate[] {
+  if (!picture) return [];
+  return picture.uris.map((uri) => ({
+    uri,
+    local: shipBundled ? lumenBuiltinAssetFor(uri) : null,
+  }));
+}
+
+/**
+ * The pictures this avatar may draw, best first: the manifest's own choices, and — when the
+ * manifest names art this build does not carry — the art that is in the bundle. Empty means the
+ * drawn Lumen body.
+ */
+export function lumenAvatarChoice(
+  manifest: LumenManifest | null,
+  input: LumenAvatarInput,
+): LumenAvatarChoice | null {
+  const picture = lumenManifestPicture(manifest, input);
+  if (!picture) return null;
+  // A manifest naming the art this build carries is that art: draw it from the bundle, so a
+  // launch shows the hero at once and a theme switch never waits for the network.
+  const sameArt = Boolean(manifest) && manifest?.version === LUMEN_BUILTIN_VERSION;
+  const candidates = candidatesOf(picture, sameArt);
+  if (!sameArt) {
+    // The server names other art: keep the shipped copy behind it, so a picture that cannot be
+    // fetched (no network, a half-uploaded file) still leaves a finished avatar on screen.
+    for (const fallback of candidatesOf(lumenManifestPicture(LUMEN_BUILTIN_MANIFEST, input), true)) {
+      if (!candidates.some((candidate) => candidate.uri === fallback.uri)) candidates.push(fallback);
+    }
+  }
+  if (candidates.length === 0) return null;
+  return { candidates, size: picture.size, drawMainStar: picture.drawMainStar };
+}
