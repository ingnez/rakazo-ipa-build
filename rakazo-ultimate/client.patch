+    out.append("  zoom?: readonly AvatarKey[];")
+    out.append("  squash?: readonly AvatarKey[];")
+    out.append("  lids?: readonly AvatarKey[];")
+    out.append("  /** Seconds at which the clip's face blinks. */")
