+  spec: BabygrokEyeSpec,
+  cx: number,
+  cy: number,
+  unit: number,
+  tilt: number,
+  lid: number,
+  radius: number,
+  /** How much of its own width the eye keeps, so a wide lid can be squeezed away from its twin. */
+  squeeze: number,
+): string {
+  "worklet";
+  // The reference states a lid in the body's own frame — `x` across, `y` down — so `tilt` is how
+  // far that frame is turned: nothing for a measured face, and the body's own lean (less the
+  // quarter turn that makes it a lean rather than a direction) for the body's authored eye.
+  const cos = Math.cos(tilt);
+  const sin = Math.sin(tilt);
+  // The squeeze is applied in the lid's own frame, before the tilt: the whole eye narrows about
+  // its own centre, which is what keeps a long horizontal lid (the reference's `calm`) apart from
+  // the eye beside it instead of letting the two run into one bar.
