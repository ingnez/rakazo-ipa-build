+    ...browserWindowOptions(process.platform, screen.getPrimaryDisplay().workAreaSize),
+    ...(icon ? { icon } : {}),
+    webPreferences: {
+      preload: path.join(import.meta.dirname, "preload.cjs"),
+      nodeIntegration: false,
+      contextIsolation: true,
+      sandbox: true,
+      ...(partition === null ? {} : { partition }),
+    },
+  });
