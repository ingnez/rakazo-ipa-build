+import { describe, expect, it, vi } from "vitest";
+
+const state = vi.hoisted(() => ({
+  page: null as { uri: string; width: number; height: number } | null,
+  calls: 0,
+  error: null as Error | null,
+}));
+
+// The native side is a phone away; what a card does with the page it hands back is what is tested.
+vi.mock("./optional-native", () => ({
+  optionalNativeModule: () => ({
+    officeThumbnail: async (uri: string, maxWidth: number) => {
+      state.calls += 1;
+      void uri;
+      void maxWidth;
+      if (state.error) throw state.error;
+      return state.page;
+    },
+  }),
+}));
+
+import { officeThumbnailAvailable, officeThumbnailPage } from "./office-thumbnail";
+
+describe("an Office document's first page", () => {
+  it("is available when the build carries the reader", () => {
+    expect(officeThumbnailAvailable()).toBe(true);
+  });
+
+  it("comes back with the shape the reader drew it in", async () => {
+    state.page = { uri: "file:///caches/office-page-thumbnails/abc.png", width: 640, height: 360 };
+    expect(await officeThumbnailPage("file:///caches/art.pptx", 640)).toEqual(state.page);
+    expect(state.calls).toBe(1);
+  });
+
+  it("is nothing at all when the reader draws no page", async () => {
+    state.page = null;
+    expect(await officeThumbnailPage("file:///caches/broken.docx", 640)).toBeNull();
+    // A page without a size cannot be stood on the paper without squashing it.
+    state.page = { uri: "file:///caches/empty.png", width: 0, height: 0 };
+    expect(await officeThumbnailPage("file:///caches/empty.xlsx", 640)).toBeNull();
+  });
+
+  it("passes a reader that fails on to the card, which shows its compact row", async () => {
+    state.page = null;
+    state.error = new Error("unreadable");
+    await expect(officeThumbnailPage("file:///caches/locked.doc", 640)).rejects.toThrow("unreadable");
+    state.error = null;
+  });
+});
