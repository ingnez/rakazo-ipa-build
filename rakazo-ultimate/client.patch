+  { match: /^Using [^:]{1,40}: /i, key: "connector", label: () => t`正在用连接的应用` },
+  { match: /^Using service\b/i, key: "connector", label: () => t`正在用连接的应用` },
+  // Commands and computers.
+  { match: /^Running: /i, key: "shell", label: () => t`正在执行几条命令` },
+  { match: /^(Looking at|Using) /i, key: "its-computer", label: () => t`正在屏幕上点一点` },
+  { match: /^Operating the computer\b/i, key: "its-computer", label: () => t`正在屏幕上点一点` },
