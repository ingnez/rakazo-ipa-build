+    if (
+      process.platform === "darwin" &&
+      !desktop.quitting &&
+      process.env.RAKAZO_DISABLE_WARM_WINDOW !== "1"
+    ) {
+      event.preventDefault();
+      win.hide();
+      clearTimeout(desktop.warmWindowTimer);
+      desktop.warmWindowTimer = setTimeout(() => {
