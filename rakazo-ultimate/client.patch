+import { describe, expect, it } from "vitest";
+import {
+  lumenManifestBot,
+  lumenManifestKind,
+  lumenManifestPicture,
+  lumenManifestUrl,
+  parseLumenManifest,
+} from "./lumen-manifest";
+
+const BASE = "https://rakazo.163ll.com/lumen-avatars/manifest.json";
+const pics = (key: string, theme: string) => ({
+  static: `assets/static/${key}-${theme}.png`,
+  list: `assets/list/${key}-${theme}.gif`,
+  header: `assets/header/${key}-${theme}.gif`,
+});
+const doc = {
+  schemaVersion: 2,
+  version: "20261122-1000",
+  playback: {
+    headerMinPt: 72,
+    reduceMotion: "static",
+    surfaces: { "home-hero": "header", chat: "header", "home-list": "list", default: "auto" },
+  },
+  bots: [
+    {
+      botId: "chief-id",
+      name: "小猪包",
+      role: "chief",
+      starBaked: true,
+      listVariant: "v3-full",
+      listSizePt: 96,
+      heroSizePt: 136,
+      themes: { dark: pics("chief", "dark"), light: pics("chief", "light") },
+    },
+    {
+      botId: "quiz-id",
+      name: "刷题教练",
+      role: "member",
+      starBaked: false,
+      listVariant: "B-fx",
+      listSizePt: 56,
+      themes: { dark: pics("quiz", "dark"), light: pics("quiz", "light") },
+    },
+    // A row that names only a still keeps the bot: the picker falls back to it.
+    { botId: "still-only", name: "只有静图", themes: { dark: { static: "assets/static/memo-dark.png" } } },
+    { botId: "nothing", name: "全空" },
+  ],
+  hashes: { "assets/list/quiz-dark.gif": "abc123" },
+};
+
+describe("lumen manifest", () => {
+  it("builds the manifest address from the server address", () => {
+    expect(lumenManifestUrl("https://rakazo.163ll.com")).toBe(BASE);
+    expect(lumenManifestUrl("https://rakazo.163ll.com:9443/")).toBe(
+      "https://rakazo.163ll.com:9443/lumen-avatars/manifest.json",
+    );
+  });
+
+  it("keeps rows with at least one picture, skips empty ones, refuses files with none", () => {
+    const m = parseLumenManifest(doc, BASE);
+    expect(m?.bots.map((b) => b.name)).toEqual(["小猪包", "刷题教练", "只有静图"]);
+    expect(parseLumenManifest({ ...doc, bots: [doc.bots[3]] }, BASE)).toBeNull();
+    expect(parseLumenManifest({ ...doc, schemaVersion: 1 }, BASE)).toBeNull();
+    expect(parseLumenManifest("nope", BASE)).toBeNull();
+  });
+
+  it("matches a bot by id first, then by exact name", () => {
+    const m = parseLumenManifest(doc, BASE);
+    expect(lumenManifestBot(m, { identity: "quiz-id", name: "别名" })?.name).toBe("刷题教练");
+    expect(lumenManifestBot(m, { identity: "new-id", name: "刷题教练" })?.botId).toBe("quiz-id");
+    expect(lumenManifestBot(m, { identity: "new-id", name: "新来的" })).toBeNull();
+    expect(lumenManifestBot(null, { identity: "quiz-id" })).toBeNull();
+  });
+
+  it("picks the surface's picture, and the still under reduced motion", () => {
+    const base = {
+      headerMinPt: 72,
+      reduceMotionStatic: true,
+      reducedMotion: false,
+      surfaces: { "home-hero": "header", "home-list": "list" } as const,
+    };
+    expect(lumenManifestKind({ ...base, surface: "home-hero", size: 96 })).toBe("header");
+    expect(lumenManifestKind({ ...base, surface: "chat", size: 28 })).toBe("header");
+    expect(lumenManifestKind({ ...base, surface: "home-list", size: 56 })).toBe("list");
+    expect(lumenManifestKind({ ...base, surface: "default", size: 56 })).toBe("list");
+    expect(lumenManifestKind({ ...base, surface: "default", size: 112 })).toBe("header");
+    expect(
+      lumenManifestKind({ ...base, reducedMotion: true, surface: "home-hero", size: 96 }),
+    ).toBe("static");
+  });
+
+  it("resolves the picture address, theme, size and star rule", () => {
+    const m = parseLumenManifest(doc, BASE);
+    const quiz = lumenManifestPicture(m, {
+      identity: "quiz-id",
+      surface: "home-list",
+      size: 56,
+      dark: true,
+      reducedMotion: false,
+    });
+    expect(quiz?.uris[0]).toBe(
+      "https://rakazo.163ll.com/lumen-avatars/assets/list/quiz-dark.gif?h=abc123",
+    );
+    expect(quiz?.kind).toBe("list");
+    expect(quiz?.size).toBe(56);
+    expect(quiz?.drawMainStar).toBe(true);
+
+    const chief = lumenManifestPicture(m, {
+      name: "小猪包",
+      surface: "home-hero",
+      size: 103,
+      dark: false,
+      reducedMotion: false,
+    });
+    expect(chief?.uris[0]).toBe("https://rakazo.163ll.com/lumen-avatars/assets/header/chief-light.gif");
+    expect(chief?.drawMainStar).toBe(false);
+    expect(chief?.size).toBe(136);
+  });
+
+  it("shows the chief's own list row with the full ignition and its wider size", () => {
+    const m = parseLumenManifest(doc, BASE);
+    const chief = lumenManifestPicture(m, {
+      identity: "chief-id",
+      surface: "home-list",
+      size: 56,
+      dark: true,
+      reducedMotion: false,
+    });
+    expect(chief?.kind).toBe("header");
+    expect(chief?.uris[0]).toBe(
+      "https://rakazo.163ll.com/lumen-avatars/assets/header/chief-dark.gif",
+    );
+    expect(chief?.size).toBe(96);
+  });
+
+  it("takes the hero's size from the manifest, and a member's from the list rule", () => {
+    // The chief names 136 pt; a server that leaves it out keeps the build's own hero size.
+    const named = parseLumenManifest(doc, BASE);
+    expect(
+      lumenManifestPicture(named, {
+        identity: "chief-id",
+        surface: "home-hero",
+        size: 54,
+        dark: true,
+        reducedMotion: false,
+      })?.size,
+    ).toBe(136);
+    const withoutHero = parseLumenManifest(
+      { ...doc, bots: [{ ...doc.bots[0], heroSizePt: undefined }] },
+      BASE,
+    );
+    expect(
+      lumenManifestPicture(withoutHero, {
+        identity: "chief-id",
+        surface: "home-hero",
+        size: 54,
+        dark: true,
+        reducedMotion: false,
+      })?.size,
+    ).toBe(136);
+    // A member is never drawn at hero size: its own row size is its size.
+    expect(
+      lumenManifestPicture(named, {
+        identity: "quiz-id",
+        surface: "home-hero",
+        size: 136,
+        dark: true,
+        reducedMotion: false,
+      })?.size,
+    ).toBe(56);
+  });
+
+  it("falls back through the themes and finally the still", () => {
+    const m = parseLumenManifest(doc, BASE);
+    const still = lumenManifestPicture(m, {
+      identity: "still-only",
+      surface: "home-list",
+      size: 56,
+      dark: true,
+      reducedMotion: false,
+    });
+    expect(still?.uris).toEqual([
+      "https://rakazo.163ll.com/lumen-avatars/assets/static/memo-dark.png",
+    ]);
+    // The other theme is the last resort before the drawn body.
+    const other = lumenManifestPicture(m, {
+      identity: "quiz-id",
+      surface: "home-hero",
+      size: 96,
+      dark: false,
+      reducedMotion: true,
+    });
+    expect(other?.uris[0]).toBe(
+      "https://rakazo.163ll.com/lumen-avatars/assets/static/quiz-light.png",
+    );
+    expect(
+      lumenManifestPicture(m, {
+        identity: "x",
+        name: "陌生",
+        size: 56,
+        dark: true,
+        reducedMotion: false,
+      }),
+    ).toBeNull();
+  });
+
+  it("refuses picture paths that are not web addresses", () => {
+    const evil = JSON.parse(JSON.stringify(doc));
+    evil.bots[1].themes.dark.list = "javascript:alert(1)";
+    const m = parseLumenManifest(evil, BASE);
+    const picture = lumenManifestPicture(m, {
+      identity: "quiz-id",
+      surface: "home-list",
+      size: 56,
+      dark: true,
+      reducedMotion: false,
+    });
+    expect(picture?.uris.some((uri) => uri.startsWith("javascript:"))).toBe(false);
+    expect(picture?.uris[0]).toContain("assets/static/quiz-dark.png");
+  });
+});
