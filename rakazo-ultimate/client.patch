+import type { ComputerStatus } from "../lib/computer";
+import { useMobileTokens } from "../lib/native";
+import { NativeActionButton } from "./native-action-button";
+
+/**
+ * The computer's own page: what it is, whose it is, who is holding it, what it is showing, and
+ * how full its disk is. The state a person would otherwise have to infer from an error line.
+ */
+export function ComputerDetailsSheet({
+  open,
+  computer,
+  updating,
+  cleaningUp,
+  onClose,
+  onCleanUp,
+  onUpdate,
+}: {
+  open: boolean;
+  computer: ComputerStatus | null;
+  /** An update or recovery is queued for this computer. */
+  updating: boolean;
+  cleaningUp: boolean;
+  onClose: () => void;
+  onCleanUp?: () => void;
+  onUpdate?: () => void;
+}) {
+  const { t } = useLingui();
+  const tokens = useMobileTokens();
+  const insets = useSafeAreaInsets();
+  const state = computer
+    ? computer.state === "running"
+      ? t`Running`
+      : computer.state === "booting"
+        ? t`Starting`
+        : computer.state === "suspended"
+          ? t`Asleep`
+          : computer.state === "error"
+            ? t`Needs attention`
+            : t`Stopped`
+    : t`Not set up`;
+  const holder = computer
+    ? computer.controlledByOther
+      ? t`Someone else in this space`
+      : computer.controlHolder === "user"
+        ? t`You`
+        : computer.controlHolder === "bot"
+          ? (computer.busyBotName ?? t`A Bot`)
+          : t`No one`
+    : t`No one`;
+  const rows: Array<{ label: string; value: string }> = computer
+    ? [
+        { label: t`State`, value: state },
+        { label: t`Shared with`, value: computer.shared ? t`Everyone in this space` : t`Only this Bot` },
+        { label: t`In control`, value: holder },
+        { label: t`Screen`, value: `${computer.screenWidth} × ${computer.screenHeight}` },
+        ...(computer.diskFullPercent !== undefined
+          ? [{ label: t`Disk`, value: t`${computer.diskFullPercent}% used` }]
+          : []),
+      ]
+    : [];
+  return (
+    <Modal
+      visible={open}
+      animationType="slide"
+      presentationStyle="pageSheet"
+      onRequestClose={onClose}
+    >
+      <View
+        accessibilityViewIsModal
+        style={[
+          styles.sheet,
+          {
+            backgroundColor: tokens.background,
+            paddingTop: Platform.OS === "ios" ? 12 : insets.top + 12,
+            paddingBottom: insets.bottom,
+          },
+        ]}
+      >
+        <View style={styles.header}>
+          <Text style={[styles.title, { color: tokens.foreground }]}>云电脑</Text>
+          <NativeActionButton fill={false} label={t`Done`} onPress={onClose} prominence="primary" />
+        </View>
+        <ScrollView contentContainerStyle={styles.content}>
+          <Text style={[styles.summary, { color: tokens.mutedForeground }]}>
+            你的 Bot 们共用的那一台电脑。
+          </Text>
+          <View style={[styles.card, { backgroundColor: tokens.card, borderColor: tokens.border }]}>
+            {rows.map((row) => (
+              <View key={row.label} style={[styles.row, { borderTopColor: tokens.border }]}>
+                <Text style={[styles.rowLabel, { color: tokens.mutedForeground }]}>{row.label}</Text>
+                <Text numberOfLines={1} style={[styles.rowValue, { color: tokens.foreground }]}>
+                  {row.value}
+                </Text>
+              </View>
+            ))}
+            {!computer ? (
+              <Text style={[styles.empty, { color: tokens.mutedForeground }]}>
+                这台电脑还没有开过。
+              </Text>
+            ) : null}
+          </View>
+          {computer?.diskFullPercent !== undefined ? (
+            <View style={styles.disk}>
+              <View style={[styles.diskTrack, { backgroundColor: tokens.muted }]}>
+                <View
+                  style={[
+                    styles.diskFill,
+                    {
+                      backgroundColor:
+                        computer.diskFullPercent >= 95 ? tokens.destructive : tokens.warning,
+                      width: `${Math.min(100, Math.max(0, computer.diskFullPercent))}%`,
+                    },
+                  ]}
+                />
+              </View>
+              <Text style={[styles.diskNote, { color: tokens.mutedForeground }]}>
+                磁盘已用 {computer.diskFullPercent}%，清理构建产物和缓存能腾出空间。
+              </Text>
+            </View>
+          ) : null}
+          <View style={styles.actions}>
+            {onCleanUp && computer ? (
+              <NativeActionButton
+                label={t`Clean up`}
+                prominence="secondary"
+                busy={cleaningUp}
+                onPress={onCleanUp}
+              />
+            ) : null}
+            {onUpdate && computer ? (
+              <NativeActionButton
+                label={computer.canUpdate ? t`Update computer` : t`Repair computer`}
+                prominence="secondary"
+                busy={updating}
+                onPress={onUpdate}
+              />
+            ) : null}
+          </View>
+        </ScrollView>
+      </View>
+    </Modal>
+  );
+}
+
+const styles = StyleSheet.create({
+  sheet: { flex: 1 },
+  header: {
+    flexDirection: "row",
+    alignItems: "center",
+    justifyContent: "space-between",
+    paddingHorizontal: 20,
+    paddingVertical: 8,
+  },
+  title: { fontSize: 18, fontWeight: "600" },
+  content: { paddingHorizontal: 20, paddingBottom: 32, gap: 12 },
+  summary: { fontSize: 13, lineHeight: 18 },
+  card: {
+    borderRadius: 16,
+    borderCurve: "continuous",
+    borderWidth: StyleSheet.hairlineWidth,
+    paddingHorizontal: 14,
+  },
+  row: {
+    flexDirection: "row",
+    alignItems: "center",
+    justifyContent: "space-between",
+    gap: 12,
+    paddingVertical: 12,
+    borderTopWidth: StyleSheet.hairlineWidth,
+  },
+  rowLabel: { ...typeScale.secondary },
+  rowValue: { flexShrink: 1, ...typeScale.secondary, fontWeight: "500", textAlign: "right" },
+  empty: { paddingVertical: 14, ...typeScale.secondary },
+  disk: { gap: 8 },
+  diskTrack: { height: 8, borderRadius: 4, overflow: "hidden" },
+  diskFill: { height: 8, borderRadius: 4 },
+  diskNote: { fontSize: 12, lineHeight: 16 },
+  actions: { flexDirection: "row", flexWrap: "wrap", gap: 10, paddingTop: 4 },
+});
