diff --git a/apps/mobile/components/home-bottom-bar.tsx b/apps/mobile/components/home-bottom-bar.tsx
new file mode 100644
index 0000000..6ce9c75
--- /dev/null
+++ b/apps/mobile/components/home-bottom-bar.tsx
@@ -0,0 +1,176 @@
+import { StyleSheet, Text, View } from "react-native";
+import Animated, { FadeInUp } from "react-native-reanimated";
+import { useSafeAreaInsets } from "react-native-safe-area-context";
+import Svg, { Defs, LinearGradient, Rect, Stop } from "react-native-svg";
+import { mobileTokens } from "../lib/appearance";
+import { native, useThemedStyles } from "../lib/native";
+import { GlassSurface } from "./glass-surface";
+import { GridPlusIcon } from "./grid-plus-icon";
+import { NativeSymbol } from "./native-symbol";
+import { PressScale } from "./press-scale";
+
+/** The circle's and the pill's height, as the reference bar draws them. */
+const BAR_SIZE = 46;
+/** The band the bar floats on: room above the controls, and below them to the screen edge. */
+const BAND = { top: 14, bottom: 24, left: 20, right: 22 };
+
+/**
+ * The bar that floats over the bottom of the home screen: the button that opens the app
+ * connections on the left, and a search pill that runs the rest of the way to the right edge.
+ *
+ * It floats over the list rather than sitting under it. A gradient band rises from the page colour
+ * at the screen's edge to nothing at the band's top, so rows scrolling past show through behind the
+ * controls the way the reference app's do, and the band takes no touches of its own.
+ */
+export function HomeBottomBar({
+  onOpenIntegrations,
+  onOpenSearch,
+}: {
+  onOpenIntegrations: () => void;
+  onOpenSearch: () => void;
+}) {
+  const styles = useThemedStyles(createBottomBarStyles);
+  const tokens = mobileTokens();
+  const insets = useSafeAreaInsets();
+  const padBottom = Math.max(insets.bottom, BAND.bottom);
+  return (
+    <Animated.View entering={FadeInUp.duration(240)} pointerEvents="box-none" style={styles.dock}>
+      <HomeBottomBarBand height={BAND.top + BAR_SIZE + padBottom + 10} />
+      <View
+        pointerEvents="box-none"
+        style={[
+          styles.row,
+          { paddingBottom: padBottom, paddingLeft: BAND.left, paddingRight: BAND.right },
+        ]}
+      >
+        <GlassSurface fallbackStyle={styles.circleFill} shape="circle" style={styles.circle}>
+          <PressScale
+            accessibilityLabel="连接应用"
+            accessibilityRole="button"
+            hitSlop={6}
+            onPress={onOpenIntegrations}
+            style={styles.circleInner}
+          >
+            <GridPlusIcon size={20} color={tokens.foreground} />
+          </PressScale>
+        </GlassSurface>
+        <GlassSurface fallbackStyle={styles.pillFill} shape="capsule" style={styles.pill}>
+          <PressScale
+            accessibilityLabel="搜索"
+            accessibilityRole="button"
+            // The animated wrapper is what occupies space in the bar, so it takes the growth; the
+            // pill's own text collapsed to nothing without it.
+            containerStyle={styles.pillTouch}
+            onPress={onOpenSearch}
+            style={styles.pillInner}
+          >
+            <View style={styles.pillContent}>
+              <NativeSymbol ios="magnifyingglass" android="search" size={16} />
+              <Text style={styles.pillLabel}>搜索</Text>
+            </View>
+          </PressScale>
+        </GlassSurface>
+      </View>
+    </Animated.View>
+  );
+}
+
+/** The space the bar takes off the screen, so a floating control stays clear of it. */
+export const HOME_BOTTOM_BAR_HEIGHT = BAR_SIZE + BAND.top + BAND.bottom;
+
+/**
+ * The dark band under the bar: the page colour, from see-through at its top to nearly solid at the
+ * screen's edge, so the list reads as passing underneath rather than stopping above.
+ */
+function HomeBottomBarBand({ height }: { height: number }) {
+  const color = mobileTokens().background;
+  return (
+    <View pointerEvents="none" style={[styles.band, { height }]}>
+      <Svg width="100%" height="100%">
+        <Defs>
+          <LinearGradient id="home-bottom-band" x1="0" y1="0" x2="0" y2="1">
+            {/* Solid well before the bar, so no row's words read through the glass search
+                field; the top of the band still fades into the page. */}
+            <Stop offset="0" stopColor={color} stopOpacity={0} />
+            <Stop offset="0.32" stopColor={color} stopOpacity={0.94} />
+            <Stop offset="0.55" stopColor={color} stopOpacity={1} />
+            <Stop offset="1" stopColor={color} stopOpacity={1} />
+          </LinearGradient>
+        </Defs>
+        <Rect width="100%" height="100%" fill="url(#home-bottom-band)" />
+      </Svg>
+    </View>
+  );
+}
+
+const styles = StyleSheet.create({
+  band: {
+    position: "absolute",
+    left: 0,
+    right: 0,
+    bottom: 0,
+  },
+});
+
+function createBottomBarStyles() {
+  const tokens = mobileTokens();
+  return StyleSheet.create({
+    dock: {
+      position: "absolute",
+      left: 0,
+      right: 0,
+      bottom: 0,
+    },
+    row: {
+      flexDirection: "row",
+      alignItems: "center",
+      gap: 14,
+      paddingTop: BAND.top,
+    },
+    circle: {
+      width: BAR_SIZE,
+      height: BAR_SIZE,
+      alignItems: "center",
+      justifyContent: "center",
+    },
+    circleFill: {
+      borderRadius: BAR_SIZE / 2,
+      backgroundColor: native.fillPressed,
+    },
+    circleInner: {
+      width: BAR_SIZE,
+      height: BAR_SIZE,
+      alignItems: "center",
+      justifyContent: "center",
+    },
+    // One long capsule from the button to the right edge, as the reference bar draws it.
+    pill: {
+      flex: 1,
+      height: BAR_SIZE,
+      justifyContent: "center",
+    },
+    pillFill: {
+      borderRadius: BAR_SIZE / 2,
+      backgroundColor: native.fillPressed,
+    },
+    pillInner: {
+      flex: 1,
+      height: BAR_SIZE,
+      justifyContent: "center",
+    },
+    pillTouch: {
+      flex: 1,
+      height: BAR_SIZE,
+    },
+    pillContent: {
+      flexDirection: "row",
+      alignItems: "center",
+      gap: 7,
+      paddingHorizontal: 18,
+    },
+    pillLabel: {
+      color: tokens.mutedForeground,
+      fontSize: 15,
+    },
+  });
+}
diff --git a/apps/mobile/components/home-hero-body.tsx b/apps/mobile/components/home-hero-body.tsx
new file mode 100644
index 0000000..7f95425
--- /dev/null
+++ b/apps/mobile/components/home-hero-body.tsx
@@ -0,0 +1,278 @@
+import type { I18n } from "@lingui/core";
+import { msg } from "@lingui/core/macro";
+import type { SpaceBot } from "@rakazo/contracts";
+import { isRunWorking, SNOOZE_PRESETS, snoozePresetTime } from "@rakazo/core";
+import { Pressable, StyleSheet, Text, View } from "react-native";
+import { mobileTokens } from "../lib/appearance";
+import { SNOOZE_LABELS } from "../lib/inbox-swipe";
+import type { MobileBot } from "../lib/mobile-types";
+import { native, useThemedStyles } from "../lib/native";
+import { BotAvatar } from "./bot-avatar";
+import { UNREAD_DOT_SIZE } from "./home-styles";
+import { FALLBACK_COLOR } from "./inbox-rows";
+import type { NativeRowMenu, NativeRowMenuItem } from "./native-row";
+import { NativeSymbol } from "./native-symbol";
+
+/**
+ * What the home screen's long press on the main bot offers: the same choices its list rows give.
+ * Every callback is optional, so a picker that only opens chats shows none.
+ */
+export interface HomeHeroActions {
+  onOpenBotSettings?: () => void;
+  onMarkRead?: () => void;
+  /** Picks another bot to stand at the top of the home screen. */
+  onReplaceMainBot?: () => void;
+  /** Hands this bot to someone else as a template. */
+  onShareTemplate?: () => void;
+  onTogglePin?: (pinned: boolean) => void;
+  onToggleNotify?: (notify: boolean) => void;
+  onSnooze?: (until: string | null) => void;
+  onArchive?: () => void;
+  onDelete?: () => void;
+}
+
+/**
+ * The long press on the main bot, as a menu for the row it sits in: the native inbox list puts a
+ * SwiftUI context menu on the row, which opens on a hold without taking the tap that opens the
+ * chat. Titles are translated here, through the app's own catalog, because a menu built for
+ * SwiftUI never passes back through a component that could translate it.
+ */
+export function homeHeroMenu({
+  bot,
+  i18n,
+  onOpenBotSettings,
+  onMarkRead,
+  onReplaceMainBot,
+  onShareTemplate,
+  onTogglePin,
+  onToggleNotify,
+  onSnooze,
+  onArchive,
+  onDelete,
+}: {
+  bot: MobileBot | SpaceBot;
+  i18n: I18n;
+} & HomeHeroActions): NativeRowMenu | undefined {
+  const actions: NativeRowMenuItem[] = [];
+  if (onOpenBotSettings) {
+    actions.push({ id: "settings", title: "Bot 设置", image: "slider.horizontal.3" });
+  }
+  if (onMarkRead && bot.unread) {
+    actions.push({ id: "read", title: "标为已读", image: "checkmark.circle" });
+  }
+  if (onTogglePin && typeof bot.pinned === "boolean") {
+    actions.push({
+      id: "pin",
+      title: i18n._(bot.pinned ? msg`Unpin` : msg`Pin`),
+      image: bot.pinned ? "pin.slash" : "pin",
+    });
+  }
+  if (onReplaceMainBot) {
+    actions.push({ id: "replace", title: "替换主 Bot…", image: "arrow.left.arrow.right" });
+  }
+  if (onShareTemplate) {
+    actions.push({ id: "share", title: "分享为模板…", image: "square.and.arrow.up" });
+  }
+  if (onArchive) {
+    actions.push({
+      id: "archive",
+      title: i18n._(msg`Archive`),
+      image: "eye.slash",
+      destructive: true,
+    });
+  }
+  // Everything the hero does not have room for sits one level in: the hold on 更多 opens it.
+  const more: NativeRowMenuItem[] = [];
+  if (onToggleNotify && typeof bot.notifyOnFinish === "boolean") {
+    more.push({
+      id: "notify",
+      title: i18n._(bot.notifyOnFinish ? msg`Silence notifications` : msg`Resume notifications`),
+      image: bot.notifyOnFinish ? "bell.slash" : "bell",
+    });
+  }
+  if (onSnooze) {
+    if (bot.snoozedUntil) {
+      more.push({
+        id: "snooze:none",
+        title: i18n._(msg`Unsnooze`),
+        image: "moon.zzz",
+        dividerBefore: more.length > 0,
+      });
+    } else {
+      SNOOZE_PRESETS.forEach((preset, index) => {
+        more.push({
+          id: `snooze:${preset}`,
+          title: i18n._(SNOOZE_LABELS[preset]),
+          dividerBefore: index === 0 && more.length > 0,
+        });
+      });
+    }
+  }
+  if (onDelete) {
+    more.push({
+      id: "delete",
+      title: i18n._(msg`Delete…`),
+      image: "trash",
+      destructive: true,
+      dividerBefore: true,
+    });
+  }
+  if (more.length > 0) {
+    actions.push({ id: "more", title: i18n._(msg`More`), image: "ellipsis", children: more });
+  }
+  if (actions.length === 0) return undefined;
+  return {
+    // The card the hold lifts: the bot and its last message, not the whole hero area.
+    preview: {
+      title: bot.name,
+      message: bot.preview,
+      avatar: (
+        <BotAvatar
+          avatarSet={bot.avatarSet}
+          color={bot.color || FALLBACK_COLOR}
+          identity={bot.id}
+          size={32}
+        />
+      ),
+    },
+    actions,
+    onAction: (id) => {
+      if (id === "settings") onOpenBotSettings?.();
+      else if (id === "read") onMarkRead?.();
+      else if (id === "replace") onReplaceMainBot?.();
+      else if (id === "share") onShareTemplate?.();
+      else if (id === "pin") onTogglePin?.(!bot.pinned);
+      else if (id === "notify") onToggleNotify?.(!bot.notifyOnFinish);
+      else if (id === "archive") onArchive?.();
+      else if (id === "delete") onDelete?.();
+      else if (id === "snooze:none") onSnooze?.(null);
+      else if (id.startsWith("snooze:")) {
+        const preset = SNOOZE_PRESETS.find((entry) => `snooze:${entry}` === id);
+        if (preset) onSnooze?.(snoozePresetTime(preset, new Date()).toISOString());
+      }
+    },
+  };
+}
+
+/**
+ * The hero as drawn, so the platforms add their own long-press surface around the same view.
+ *
+ * It lives in this file on purpose, with no platform twin next to it: a `home-hero-body.ios.tsx`
+ * does not exist, so both `home-hero.tsx` and `home-hero.ios.tsx` resolve this import to the same
+ * module. Kept inside a platform file, the iOS bundle resolved `./home-hero` back to itself and
+ * the hero rendered as `undefined`.
+ */
+export function HomeHeroBody({
+  bot,
+  onOpen,
+}: {
+  bot: MobileBot | SpaceBot;
+  onOpen: (bot: MobileBot | SpaceBot) => void;
+}) {
+  const styles = useThemedStyles(createHeroStyles);
+  const tokens = mobileTokens();
+  const working = isRunWorking(bot.status);
+  const dotColor = working ? tokens.workingDot : bot.unread ? tokens.unread : null;
+  const state = working ? "正在处理" : bot.unread ? "有新消息" : null;
+  return (
+    <View style={styles.hero}>
+      <Pressable
+        accessible
+        accessibilityLabel={[bot.name, state].filter(Boolean).join(", ")}
+        accessibilityHint="打开与主 Bot 的对话"
+        accessibilityRole="button"
+        onPress={() => onOpen(bot)}
+        style={({ pressed }) => [styles.heroButton, pressed && styles.heroPressed]}
+      >
+        <View style={styles.avatarWrap}>
+          <BotAvatar
+            avatarSet={bot.avatarSet}
+            color={bot.color || FALLBACK_COLOR}
+            identity={bot.id}
+            // The main bot is the one character on this screen: it keeps moving, breathing, blinking
+            // and glancing around even when nothing is happening, as the reference app draws it.
+            motion="live"
+            size={88}
+            status={bot.status}
+          />
+          {/* The star marks the bot that stands at the top of the list. */}
+          <View style={styles.mainBadge}>
+            <NativeSymbol ios="star.fill" android="star" size={12} color="#FFFFFF" />
+          </View>
+        </View>
+        <View style={styles.nameRow}>
+          <Text numberOfLines={1} style={styles.name}>
+            {bot.name}
+          </Text>
+          {dotColor ? <View style={[styles.stateDot, { backgroundColor: dotColor }]} /> : null}
+        </View>
+      </Pressable>
+    </View>
+  );
+}
+
+export function createHeroStyles() {
+  return StyleSheet.create({
+    // Full width, so the body centred inside it is centred on the screen: a shrink-wrapped
+    // column has nothing to centre against and left-aligns the bot on iOS.
+    hero: {
+      width: "100%",
+      alignItems: "center",
+      paddingTop: 6,
+      paddingBottom: 18,
+      paddingHorizontal: 20,
+    },
+    heroButton: {
+      alignItems: "center",
+      alignSelf: "center",
+      gap: 8,
+      paddingHorizontal: 16,
+      paddingVertical: 8,
+      borderRadius: 28,
+      borderCurve: "continuous",
+      maxWidth: "100%",
+    },
+    heroPressed: {
+      opacity: 0.7,
