+import { beforeEach, expect, it, vi } from "vitest";
+import type { InboxItem } from "./inbox-spaces";
+
+const state = vi.hoisted(() => ({
+  saved: new Map<string, unknown>(),
+  space: "space-a",
+  scope: true,
+  rpc: vi.fn(),
+}));
+vi.mock("./api", () => ({ selectedSpaceId: () => state.space }));
+vi.mock("./chat-rpc", () => ({
+  chatRpc: (spaceId: string | undefined, path: string, input: object) =>
+    state.rpc(path, input, spaceId),
+}));
+vi.mock("./integrations-cache", () => ({
+  isIntegrationsScopeCurrent: (scope: { selectionId: string }) => scope.selectionId === state.space,
+}));
+vi.mock("./saved-chats", () => ({
+  currentSavedChatsScope: () => null,
+  savedChatsScope: async () =>
+    state.scope ? { namespace: "ns", selectionId: state.space, spaceId: state.space } : null,
+  savedChatTarget: ({ botId, groupId }: { botId?: string; groupId?: string }) =>
+    groupId ? `group:${groupId}` : `bot:${botId}`,
+  readSavedThread: (scope: { spaceId: string }, target: string) =>
+    state.saved.get(`${scope.spaceId}/${target}`) ?? null,
+  writeSavedThread: (scope: { spaceId: string }, target: string, snapshot: unknown) => {
+    state.saved.set(`${scope.spaceId}/${target}`, snapshot);
+  },
+}));
+
+const {
+  allowPreloadAfterFirstPaint,
+  inboxChats,
+  preloadChats,
+  PRELOADED_CHATS,
+  COLD_START_PRELOAD_CHATS,
+  resetPreloadForTests,
+  setPreloadIdleSchedulerForTests,
+} = await import("./preload-chats");
+const { notifyConversationCleared } = await import("./conversation-cleared");
+
+/** A promise the test resolves when it wants the request to answer. */
+function deferred<T>() {
+  let resolve!: (value: T) => void;
+  const promise = new Promise<T>((settle) => {
+    resolve = settle;
+  });
+  return { promise, resolve };
+}
+
+const snapshotOf = (input: { botId?: string; groupId?: string }) => ({ fetched: input });
+
+beforeEach(() => {
+  state.saved.clear();
+  state.scope = true;
+  state.space = `space-${Math.random()}`;
+  state.rpc.mockReset();
+  state.rpc.mockImplementation(async (_path: string, input: object) => snapshotOf(input));
+  resetPreloadForTests();
+  setPreloadIdleSchedulerForTests((task) => {
+    queueMicrotask(task);
+  });
+});
+
+it("does not fetch until first paint is idle", async () => {
+  const pass = preloadChats([{ botId: "b1" }]);
+  await pass;
+  expect(state.rpc).not.toHaveBeenCalled();
+  allowPreloadAfterFirstPaint();
+  await vi.waitFor(() => expect(state.rpc).toHaveBeenCalledTimes(1));
+  expect(state.rpc.mock.calls.map(([, input]) => input)).toEqual([{ botId: "b1" }]);
+});
+
+it("saves a copy of the first chats that have none, one request at a time, capping the cold-start wave", async () => {
+  allowPreloadAfterFirstPaint();
+  state.saved.set(`${state.space}/bot:b2`, { kept: true });
+  const chats = Array.from({ length: PRELOADED_CHATS + 2 }, (_, index) => ({
+    botId: `b${index + 1}`,
+  }));
+  const first = deferred<unknown>();
+  state.rpc.mockImplementationOnce(() => first.promise);
+  const pass = preloadChats(chats);
+  await vi.waitFor(() => expect(state.rpc).toHaveBeenCalledTimes(1));
+  first.resolve(snapshotOf({ botId: "b1" }));
+  await pass;
+
+  expect(state.rpc.mock.calls.map(([, input]) => input)).toEqual(
+    chats.slice(0, COLD_START_PRELOAD_CHATS).filter(({ botId }) => botId !== "b2"),
+  );
+  expect(state.saved.get(`${state.space}/bot:b2`)).toEqual({ kept: true });
+  expect(state.saved.get(`${state.space}/bot:b1`)).toEqual(snapshotOf({ botId: "b1" }));
+  expect(state.saved.has(`${state.space}/bot:b${COLD_START_PRELOAD_CHATS + 1}`)).toBe(false);
+});
+
+it("fills the rest up to the full cap after the cold-start wave is idle", async () => {
+  allowPreloadAfterFirstPaint();
+  const chats = Array.from({ length: PRELOADED_CHATS + 2 }, (_, index) => ({
+    botId: `b${index + 1}`,
+  }));
+  await preloadChats(chats);
+  await vi.waitFor(() =>
+    expect(state.rpc.mock.calls.map(([, input]) => input)).toEqual(
+      chats.slice(0, PRELOADED_CHATS),
+    ),
+  );
+  expect(state.saved.has(`${state.space}/bot:b${PRELOADED_CHATS}`)).toBe(true);
+  expect(state.saved.has(`${state.space}/bot:b${PRELOADED_CHATS + 1}`)).toBe(false);
+});
+
+it("asks for each chat once per Space, and again after a failed request", async () => {
+  allowPreloadAfterFirstPaint();
+  state.rpc.mockRejectedValueOnce(new TypeError("Network request failed"));
+  await preloadChats([{ botId: "b1" }, { groupId: "g1" }]);
+  // The pass stops at the first failure.
+  expect(state.rpc).toHaveBeenCalledTimes(1);
+
+  await preloadChats([{ botId: "b1" }, { groupId: "g1" }]);
+  await preloadChats([{ botId: "b1" }, { groupId: "g1" }]);
+  expect(state.rpc.mock.calls.map(([, input]) => input)).toEqual([
+    { botId: "b1" },
+    { botId: "b1" },
+    { groupId: "g1" },
+  ]);
+});
+
+it("keeps the copy the chat screen saved while the request was out", async () => {
+  allowPreloadAfterFirstPaint();
+  const answer = deferred<unknown>();
+  state.rpc.mockImplementationOnce(() => answer.promise);
+  const pass = preloadChats([{ botId: "b1" }]);
+  await vi.waitFor(() => expect(state.rpc).toHaveBeenCalled());
+  state.saved.set(`${state.space}/bot:b1`, { opened: true });
+  answer.resolve(snapshotOf({ botId: "b1" }));
+  await pass;
+  expect(state.saved.get(`${state.space}/bot:b1`)).toEqual({ opened: true });
+});
+
+it("does nothing without a saved-chat scope", async () => {
+  allowPreloadAfterFirstPaint();
+  state.scope = false;
+  await preloadChats([{ botId: "b1" }]);
+  expect(state.rpc).not.toHaveBeenCalled();
+});
+
+it("lists every Space's chats in inbox order, pinned ones first", () => {
+  const items = [
+    { type: "pinned", chats: [{ kind: "group", group: { id: "g1", spaceId: "s1" } }] },
+    { type: "heading", key: "h", title: "Bots" },
+    { type: "bot", bot: { id: "b1" } },
+    { type: "bot", bot: { id: "b2", spaceId: "s2" } },
+    { type: "group", group: { id: "g2", spaceId: "s2" } },
+  ] as unknown as InboxItem[];
+  expect(inboxChats(items)).toEqual([
+    { groupId: "g1", spaceId: "s1" },
+    { botId: "b1", spaceId: undefined },
+    { botId: "b2", spaceId: "s2" },
+    { groupId: "g2", spaceId: "s2" },
+  ]);
+});
+
+it("saves another Space's chat under that Space, asking that Space for it", async () => {
+  allowPreloadAfterFirstPaint();
+  await preloadChats([{ botId: "b1" }, { botId: "b2", spaceId: "space-other" }]);
+  expect(state.rpc.mock.calls).toEqual([
+    ["threads/get", { botId: "b1" }, undefined],
+    ["threads/get", { botId: "b2" }, "space-other"],
+  ]);
+  expect(state.saved.get(`${state.space}/bot:b1`)).toEqual(snapshotOf({ botId: "b1" }));
+  expect(state.saved.get("space-other/bot:b2")).toEqual(snapshotOf({ botId: "b2" }));
+  expect(state.saved.has(`${state.space}/bot:b2`)).toBe(false);
+});
+
+it("skips another Space's chat that already has a copy there", async () => {
+  allowPreloadAfterFirstPaint();
+  state.saved.set("space-other/bot:b2", { kept: true });
+  await preloadChats([{ botId: "b2", spaceId: "space-other" }]);
+  expect(state.rpc).not.toHaveBeenCalled();
+});
+
+it("stops when the Space changes, and never asks for one Space's chats in another", async () => {
+  allowPreloadAfterFirstPaint();
+  const answer = deferred<unknown>();
+  state.rpc.mockImplementationOnce(() => answer.promise);
+  const first = state.space;
+  const pass = preloadChats([{ botId: "b1" }, { botId: "b2" }]);
+  await vi.waitFor(() => expect(state.rpc).toHaveBeenCalledTimes(1));
+  state.space = "space-other";
+  // Queued while the first pass is out, under the Space it was listed in.
+  const queued = preloadChats([{ botId: "b3" }]);
+  state.space = "space-new";
+  answer.resolve(snapshotOf({ botId: "b1" }));
+  await pass;
+  await queued;
+  expect(state.rpc).toHaveBeenCalledTimes(1);
+  expect(state.saved.has(`${first}/bot:b2`)).toBe(false);
+});
+
+it("does not save a chat that was cleared while its request was out", async () => {
+  allowPreloadAfterFirstPaint();
+  const answer = deferred<unknown>();
+  state.rpc.mockImplementationOnce(() => answer.promise);
+  const pass = preloadChats([{ botId: "b1" }]);
+  await vi.waitFor(() => expect(state.rpc).toHaveBeenCalled());
+  notifyConversationCleared("b1");
+  answer.resolve(snapshotOf({ botId: "b1" }));
+  await pass;
+  expect(state.saved.has(`${state.space}/bot:b1`)).toBe(false);
+});
+
+it("passes on a refusal, so it is reported", async () => {
+  allowPreloadAfterFirstPaint();
+  state.rpc.mockRejectedValueOnce(Object.assign(new Error("Forbidden"), { status: 403 }));
+  await expect(preloadChats([{ botId: "b1" }])).rejects.toThrow("Forbidden");
+  await preloadChats([{ botId: "b1" }]);
+  expect(state.rpc).toHaveBeenCalledTimes(1);
+});
diff --git a/apps/mobile/lib/preload-chats.ts b/apps/mobile/lib/preload-chats.ts
new file mode 100644
index 000000000..a2c9d1db3
--- /dev/null
+++ b/apps/mobile/lib/preload-chats.ts
@@ -0,0 +1,147 @@
+import { isRetryableError } from "@rakazo/core";
+import { selectedSpaceId } from "./api";
+import { chatRpc } from "./chat-rpc";
+import { onConversationCleared } from "./conversation-cleared";
+import { runWhenIdle as runIdle } from "./run-when-idle";
+import type { InboxItem } from "./inbox-spaces";
+import { isIntegrationsScopeCurrent } from "./integrations-cache";
+import type { MobileSnapshot } from "./mobile-types";
+import type { SavedChatsScope } from "./saved-chats";
+import {
+  currentSavedChatsScope,
+  readSavedThread,
+  savedChatsScope,
+  savedChatTarget,
+  writeSavedThread,
+} from "./saved-chats";
+
+/** How many chats from the top of the inbox, in any Space, open from a saved copy on their first tap. */
+export const PRELOADED_CHATS = 20;
+/** The first wave after a cold start: enough for the visible inbox, not a crowd of requests. */
+export const COLD_START_PRELOAD_CHATS = 5;
+
+type ChatTarget = { spaceId?: string } & (
+  | { botId: string; groupId?: undefined }
+  | { groupId: string; botId?: undefined }
+);
+
+/** Chats already saved or fetched in this session, by Space and chat; each is fetched once. */
+const handled = new Set<string>();
+let running: Promise<void> | null = null;
+let allowed = false;
+let coldStart = true;
+let pending: readonly ChatTarget[] | null = null;
+
+/** Called once the first frames are on screen and the JS thread is idle. */
+export function allowPreloadAfterFirstPaint(): void {
+  if (allowed) return;
+  allowed = true;
+  if (pending) {
+    const chats = pending;
+    pending = null;
+    void preloadChats(chats).catch(() => undefined);
+  }
+}
+
+/** How later waves wait so they do not overlap remaining first-paint work. */
+let runWhenIdle: (task: () => void) => void = (task) => {
+  runIdle(task);
+};
+
+export function setPreloadIdleSchedulerForTests(scheduler: (task: () => void) => void): void {
+  runWhenIdle = scheduler;
+}
+
+export function resetPreloadForTests(): void {
+  handled.clear();
+  running = null;
+  allowed = false;
+  coldStart = true;
+  pending = null;
+}
+
+/** The chats the inbox lists, in every Space, in the order it shows them. */
+export function inboxChats(items: readonly InboxItem[]): ChatTarget[] {
+  const bot = ({ id, spaceId }: { id: string; spaceId?: string }) => ({ botId: id, spaceId });
+  const group = ({ id, spaceId }: { id: string; spaceId?: string }) => ({ groupId: id, spaceId });
+  return items.flatMap((item): ChatTarget[] => {
+    if (item.type === "pinned")
+      return item.chats.map((chat) => (chat.kind === "bot" ? bot(chat.bot) : group(chat.group)));
+    if (item.type === "bot") return [bot(item.bot)];
+    return item.type === "group" ? [group(item.group)] : [];
+  });
+}
+
+/**
+ * Saves a copy of the first chats the inbox lists that have none yet, one at a time, so opening
+ * one shows its messages at once instead of waiting on the network. A chat with a saved copy is
+ * left alone: opening it already shows that copy while it refreshes.
+ *
+ * Nothing is fetched until {@link allowPreloadAfterFirstPaint}. The first wave after a cold start
+ * is capped at {@link COLD_START_PRELOAD_CHATS}; later idle waves fill up to {@link PRELOADED_CHATS}.
+ */
+export function preloadChats(chats: readonly ChatTarget[]): Promise<void> {
+  if (!allowed) {
+    pending = chats;
+    return running ?? Promise.resolve();
+  }
+  const cap = coldStart ? COLD_START_PRELOAD_CHATS : PRELOADED_CHATS;
+  const targets = chats.slice(0, cap);
+  const shouldContinue = coldStart && chats.length > COLD_START_PRELOAD_CHATS;
+  // These chats belong to the Space selected now; a pass that starts after a switch skips them.
+  const selection = selectedSpaceId();
+  const pass = async () => {
+    // The inbox changes often; a Space this session already read needs no keychain reads.
+    const scope = currentSavedChatsScope() ?? (await savedChatsScope());
+    if (scope && scope.selectionId === selection) await preloadInto(scope, targets);
+  };
+  running = (running ?? Promise.resolve()).then(pass, pass);
+  const result = running;
+  if (shouldContinue) {
+    void result.then(() => {
+      coldStart = false;
+      runWhenIdle(() => {
+        void preloadChats(chats).catch(() => undefined);
+      });
+    });
+  }
+  return result;
+}
+
+async function preloadInto(scope: SavedChatsScope, targets: readonly ChatTarget[]) {
+  for (const chat of targets) {
+    // After a Space switch these chats belong to another Space; the new one gets its own pass.
+    if (!isIntegrationsScopeCurrent(scope)) return;
+    // A copy saved under the chat's own Space is the one opening it there reads.
+    const chatScope = { ...scope, spaceId: chat.spaceId ?? scope.spaceId };
+    const target = savedChatTarget(chat);
+    const key = JSON.stringify([scope.namespace, chatScope.spaceId, target]);
+    if (handled.has(key)) continue;
+    handled.add(key);
+    if (readSavedThread(chatScope, target)) continue;
+    let cleared = false;
+    const stopWatching = onConversationCleared((botId) => {
+      if (botId === chat.botId) cleared = true;
+    });
+    let snapshot: MobileSnapshot;
+    try {
+      snapshot = await chatRpc(
+        chatScope.spaceId === scope.spaceId ? undefined : chatScope.spaceId,
+        "threads/get",
+        chat.groupId ? { groupId: chat.groupId } : { botId: chat.botId! },
+      );
+    } catch (error) {
+      // A refusal is the server's answer: reported once and not asked again this launch.
+      if (!isRetryableError(error)) throw error;
+      // Offline or busy: the chat loads as usual when opened, and a later pass asks again.
+      handled.delete(key);
+      return;
+    } finally {
+      stopWatching();
+    }
+    // A chat cleared meanwhile, or opened meanwhile (its screen saved a fresher copy), keeps
+    // what it has.
+    if (!cleared && !readSavedThread(chatScope, target))
+      writeSavedThread(chatScope, target, snapshot);
+  }
+}
diff --git a/apps/mobile/lib/query-client-provided.test.ts b/apps/mobile/lib/query-client-provided.test.ts
new file mode 100644
index 000000000..d29134be0
--- /dev/null
+++ b/apps/mobile/lib/query-client-provided.test.ts
@@ -0,0 +1,104 @@
+import { readdirSync, readFileSync, statSync } from "node:fs";
+import { dirname, join, relative, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import ts from "typescript";
+import { describe, expect, it } from "vitest";
+
+// Nothing in the app wraps a <QueryClientProvider>, so a query hook that is called with only its
+// options reads a client out of React context that no one put there: the screen throws
+// "No QueryClient set, use QueryClientProvider to set one" the moment it renders. That is what
+// the Bot's page did on its 记忆与总结 column, and TypeScript cannot catch it because the hook's
+// second parameter is optional. This test is the guard instead: every query hook call in the app
+// must name the shared client.
+
+const mobileRoot = resolve(dirname(fileURLToPath(import.meta.url)), "..");
+const HOOKS = new Set(["useQuery", "useMutation", "useInfiniteQuery", "useQueries"]);
+
+/** Every .ts/.tsx file the app ships, tests and generated native code left out. */
+function sourceFiles(directory: string): string[] {
+  return readdirSync(directory).flatMap((entry) => {
+    if (entry === "node_modules" || entry.startsWith(".")) return [];
+    const path = join(directory, entry);
+    if (statSync(path).isDirectory()) return sourceFiles(path);
+    if (!/\.tsx?$/.test(entry) || /\.test\.tsx?$/.test(entry) || /\.d\.ts$/.test(entry)) return [];
+    return [path];
+  });
+}
+
+/** The hook names this file takes from @tanstack/react-query, so a same-named local is left alone. */
+function importedHooks(file: ts.SourceFile): Set<string> {
+  const names = new Set<string>();
+  for (const statement of file.statements) {
+    if (!ts.isImportDeclaration(statement)) continue;
+    if (!ts.isStringLiteral(statement.moduleSpecifier)) continue;
+    if (statement.moduleSpecifier.text !== "@tanstack/react-query") continue;
+    const { importClause } = statement;
+    const bindings = importClause?.namedBindings;
+    if (!bindings || !ts.isNamedImports(bindings)) continue;
+    for (const element of bindings.elements) {
+      const imported = (element.propertyName ?? element.name).text;
+      if (HOOKS.has(imported)) names.add(element.name.text);
+    }
+  }
+  return names;
+}
+
+/** The second argument must be the shared client itself, not something that may be undefined. */
+function namesQueryClient(node: ts.Expression): boolean {
+  if (ts.isIdentifier(node)) return node.text === "queryClient";
+  if (ts.isPropertyAccessExpression(node)) return node.name.text === "queryClient";
+  return false;
+}
+
+type Violation = { file: string; line: number; call: string };
+
+function scan(): { calls: number; violations: Violation[]; files: number } {
+  const violations: Violation[] = [];
+  let calls = 0;
+  let files = 0;
+  for (const path of sourceFiles(mobileRoot)) {
+    const text = readFileSync(path, "utf8");
+    if (!HOOKS.size || !/(useQuery|useMutation|useInfiniteQuery|useQueries)/.test(text)) continue;
+    const source = ts.createSourceFile(path, text, ts.ScriptTarget.Latest, true, ts.ScriptKind.TSX);
+    const hooks = importedHooks(source);
+    if (hooks.size === 0) continue;
+    files += 1;
+    const visit = (node: ts.Node) => {
+      if (ts.isCallExpression(node) && ts.isIdentifier(node.expression)) {
+        const name = node.expression.text;
+        if (hooks.has(name)) {
+          calls += 1;
+          const options = node.arguments[0];
+          const client = node.arguments[1];
+          if (!options || !client || !namesQueryClient(client) || node.arguments.length !== 2) {
+            const { line } = source.getLineAndCharacterOfPosition(node.getStart(source));
+            violations.push({
+              file: relative(mobileRoot, path),
+              line: line + 1,
+              call: node.getText(source).split("\n")[0]?.slice(0, 90) ?? name,
+            });
+          }
+        }
+      }
+      ts.forEachChild(node, visit);
+    };
+    ts.forEachChild(source, visit);
+  }
+  return { calls, violations, files };
+}
+
+describe("query hooks name the shared client", () => {
+  it("passes queryClient to every useQuery / useMutation / useInfiniteQuery call", () => {
+    const { calls, violations, files } = scan();
+    // The scan itself must reach the app's screens: a silent zero would pass this test for nothing.
+    expect(files).toBeGreaterThan(5);
+    expect(calls).toBeGreaterThan(15);
+    expect(violations.map((v) => `${v.file}:${v.line} ${v.call}`)).toEqual([]);
+  });
+
+  it("keeps the Bot page's diary list on the shared client", () => {
+    const page = readFileSync(join(mobileRoot, "components", "bot-profile-tabs.tsx"), "utf8");
+    expect(page).toContain("const diaries = useQuery(diaryRead, queryClient);");
+    expect(page).not.toContain("useQuery(diaryRead)");
+  });
+});
