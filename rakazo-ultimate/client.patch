+  /// Starts (or refreshes) the card from this phone, with no push token behind it.
+  ///
+  /// A server with no APNs key cannot update or start a card, so without this the Dynamic Island
+  /// stayed empty however long a bot worked. A card requested with `pushType: nil` is driven from
+  /// here instead: the app starts it, updates it as the work moves on, and ends it.
+  func startLocal(_ row: WorkActivityAttributes.ContentState.Row) {
+    guard ActivityAuthorizationInfo().areActivitiesEnabled else { return }
+    let state = WorkActivityAttributes.ContentState(
+      count: 1, waiting: row.status == .waiting ? 1 : 0, rows: [row])
+    if let activity = current() {
+      update(activity, state)
+      return
+    }
+    guard
+      let activity = try? Activity.request(
+        attributes: WorkActivityAttributes(),
+        content: ActivityContent(state: state, staleDate: nil),
+        pushType: nil)
+    else { return }
+    watch(activity)
+  }
+
+  /// Refreshes the showing card from this phone: a new stage, or a new step of it.
+  func updateLocal(status: WorkActivityAttributes.ContentState.Row.Status, line: String) {
+    guard let activity = current() else { return }
+    var state = activity.content.state
+    state.waiting = status == .waiting ? max(state.waiting, 1) : 0
+    state.rows = state.rows.map { row in
+      var next = row
+      next.status = status
+      next.line = line
+      return next
+    }
+    update(activity, state)
+  }
+
+  private func update(
+    _ activity: Activity<WorkActivityAttributes>,
+    _ state: WorkActivityAttributes.ContentState
+  ) {
+    Task { @MainActor in
+      _ = await activity.update(ActivityContent(state: state, staleDate: nil))
+    }
+  }
+
+  /// The card on screen now, if there is one.
+  private func current() -> Activity<WorkActivityAttributes>? {
+    Activity<WorkActivityAttributes>.activities.first {
+      $0.activityState == .active && !ending.contains($0.id)
+    }
+  }
