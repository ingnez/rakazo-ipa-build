diff --git a/apps/mobile/modules/rakazo-connectors/ios/PhoneAlarmConnector.swift b/apps/mobile/modules/rakazo-connectors/ios/PhoneAlarmConnector.swift
new file mode 100644
index 000000000..649832f8f
--- /dev/null
+++ b/apps/mobile/modules/rakazo-connectors/ios/PhoneAlarmConnector.swift
@@ -0,0 +1,126 @@
+import Foundation
+
+/// One alarm as this app remembers it. AlarmKit keeps the schedule and nothing else — no label,
+/// no repeat pattern it will read back — so the phone keeps its own record beside it, exactly as
+/// Apple suggests: an alarm that fired and was stopped is gone from the daemon, and this record is
+/// what tells the app it existed.
+struct PhoneAlarmRecord: Codable {
+  var id: String
+  var hour: Int
+  var minute: Int
+  var label: String
+  var repeatDays: [Int]
+  /// The person's own choice: false when the switch for this alarm is off.
+  var enabled: Bool
+}
+
+enum PhoneAlarmRegistry {
+  static let key = "rakazo.phone-alarms"
+
+  static func all() -> [PhoneAlarmRecord] {
+    guard let text = UserDefaults.standard.string(forKey: key),
+          let data = text.data(using: .utf8),
+          let records = try? JSONDecoder().decode([PhoneAlarmRecord].self, from: data)
+    else { return [] }
+    return records
+  }
+
+  static func save(_ records: [PhoneAlarmRecord]) {
+    guard let data = try? JSONEncoder().encode(records),
+          let text = String(data: data, encoding: .utf8)
+    else { return }
+    UserDefaults.standard.set(text, forKey: key)
+  }
+
+  static func find(_ id: String) -> PhoneAlarmRecord? {
+    all().first { $0.id == id }
+  }
+
+  static func upsert(_ record: PhoneAlarmRecord) {
+    var records = all()
+    records.removeAll { $0.id == record.id }
+    records.append(record)
+    save(records)
+  }
+
+  static func remove(_ id: String) {
+    save(all().filter { $0.id != id })
+  }
+}
+
+@MainActor
+enum PhoneAlarmConnector {
+  /// Every alarm this phone still holds, with the switch each one is under.
+  static func list() async throws -> [[String: Any]] {
+    guard AlarmKitSupport.available else { throw PhoneConnectorError.unavailable }
+    guard AlarmKitSupport.authorizationState() == PhonePermissionState.granted else {
+      throw PhoneConnectorError.permissionDenied
+    }
+    let live = AlarmKitSupport.liveIDs()
+    return PhoneAlarmRegistry.all().map { record in
+      [
+        "id": record.id,
+        "hour": record.hour,
+        "minute": record.minute,
+        "label": record.label,
+        "enabled": record.enabled && live.contains(record.id),
+        "repeatDays": record.repeatDays,
+      ]
+    }
+  }
+
+  /// Creates one alarm, or changes the one with this id; `enabled: false` turns it off.
+  static func set(_ args: [String: Any]) async throws -> [String: Any] {
+    guard AlarmKitSupport.available else { throw PhoneConnectorError.unavailable }
+    guard let hour = PhoneJSON.int(args, "hour"), (0...23).contains(hour) else {
+      throw PhoneConnectorError.invalid
+    }
+    guard let minute = PhoneJSON.int(args, "minute"), (0...59).contains(minute) else {
+      throw PhoneConnectorError.invalid
+    }
+    let requested = PhoneJSON.string(args, "id").trimmingCharacters(in: .whitespacesAndNewlines)
+    let id = requested.isEmpty ? UUID().uuidString : requested
+    guard let uuid = UUID(uuidString: id) else { throw PhoneConnectorError.invalid }
+    let label = String(PhoneJSON.string(args, "label").prefix(256))
+    let days = Array(Set(PhoneJSON.ints(args, "repeatDays").filter { (1...7).contains($0) })).sorted()
+    let enabled = PhoneJSON.bool(args, "enabled", default: true)
+
+    if enabled {
+      guard AlarmKitSupport.authorizationState() == PhonePermissionState.granted else {
+        throw PhoneConnectorError.permissionDenied
+      }
+      try await AlarmKitSupport.schedule(
+        id: uuid,
+        hour: hour,
+        minute: minute,
+        days: days,
+        title: label
+      )
+    } else {
+      // A record that was never scheduled has nothing to cancel, which is not a failure.
+      try? AlarmKitSupport.cancel(id: uuid)
+    }
+
+    PhoneAlarmRegistry.upsert(
+      PhoneAlarmRecord(id: id, hour: hour, minute: minute, label: label, repeatDays: days, enabled: enabled)
+    )
+    return [
+      "id": id,
+      "hour": hour,
+      "minute": minute,
+      "label": label,
+      "enabled": enabled,
+      "repeatDays": days,
+    ]
+  }
+
+  static func cancel(_ args: [String: Any]) throws -> [String: Any] {
+    guard AlarmKitSupport.available else { throw PhoneConnectorError.unavailable }
+    let id = PhoneJSON.string(args, "id").trimmingCharacters(in: .whitespacesAndNewlines)
+    guard !id.isEmpty, let uuid = UUID(uuidString: id) else { throw PhoneConnectorError.invalid }
+    guard PhoneAlarmRegistry.find(id) != nil else { throw PhoneConnectorError.notFound }
+    try? AlarmKitSupport.cancel(id: uuid)
+    PhoneAlarmRegistry.remove(id)
+    return ["id": id, "cancelled": true]
+  }
+}
diff --git a/apps/mobile/modules/rakazo-connectors/ios/PhoneAlarmKit.swift b/apps/mobile/modules/rakazo-connectors/ios/PhoneAlarmKit.swift
new file mode 100644
index 000000000..831afe9db
--- /dev/null
+++ b/apps/mobile/modules/rakazo-connectors/ios/PhoneAlarmKit.swift
@@ -0,0 +1,131 @@
+import Foundation
+
+#if canImport(AlarmKit)
+import AlarmKit
+import SwiftUI
+
+/// What a scheduled alarm carries besides its time. AlarmKit keeps the schedule; the label is
+/// this app's own, so it is compiled into the alarm's attributes rather than read back later.
+struct PhoneAlarmMetadata: AlarmMetadata, Codable, Hashable, Sendable {
+  var title: String
+}
+
+/// The system's alarm store, reached only where AlarmKit exists.
+@available(iOS 26.0, *)
+enum AlarmKitStore {
+  static func authorizationState() -> String {
+    switch AlarmManager.shared.authorizationState {
+    case .authorized: return PhonePermissionState.granted
+    case .denied: return PhonePermissionState.denied
+    case .notDetermined: return PhonePermissionState.undetermined
+    @unknown default: return PhonePermissionState.undetermined
+    }
+  }
+
+  static func requestAuthorization() async {
+    _ = try? await AlarmManager.shared.requestAuthorization()
+  }
+
+  /// The alarms the system still holds for this app: one that fired and was stopped is gone.
+  static func liveIDs() -> Set<String> {
+    guard let alarms = try? AlarmManager.shared.alarms else { return [] }
+    return Set(alarms.map { $0.id.uuidString })
+  }
+
+  static func schedule(id: UUID, hour: Int, minute: Int, days: [Int], title: String) async throws {
+    let time = Alarm.Schedule.Relative.Time(hour: hour, minute: minute)
+    let repeats: Alarm.Schedule.Relative.Recurrence =
+      days.isEmpty ? .never : .weekly(days.map(weekday))
+    let schedule = Alarm.Schedule.relative(.init(time: time, repeats: repeats))
+    let shownTitle = title.isEmpty ? "闹钟" : title
+    // Written as an interpolated literal so it reads the same whether the alert takes a string or
+    // the system's localizable one.
+    let alert = AlarmPresentation.Alert(
+      title: "\(shownTitle)",
+      stopButton: AlarmButton(text: "停止", textColor: .white, systemImageName: "stop.circle")
+    )
+    let attributes = AlarmAttributes(
+      presentation: AlarmPresentation(alert: alert),
+      metadata: PhoneAlarmMetadata(title: title),
+      tintColor: .blue
+    )
+    let configuration: AlarmManager.AlarmConfiguration<PhoneAlarmMetadata> = .alarm(
+      schedule: schedule,
+      attributes: attributes,
+      sound: .default
+    )
+    _ = try await AlarmManager.shared.schedule(id: id, configuration: configuration)
+  }
+
+  static func cancel(id: UUID) throws {
+    try AlarmManager.shared.cancel(id: id)
+  }
+
+  /// The server counts the week from Monday as 1; Foundation names the days itself.
+  private static func weekday(_ day: Int) -> Locale.Weekday {
+    switch day {
+    case 1: return .monday
+    case 2: return .tuesday
+    case 3: return .wednesday
+    case 4: return .thursday
+    case 5: return .friday
+    case 6: return .saturday
+    default: return .sunday
+    }
+  }
+}
+#endif
+
+/// AlarmKit behind one door, so the connector below reads the same on every system version.
+enum AlarmKitSupport {
+  static var available: Bool {
+    #if canImport(AlarmKit)
+    if #available(iOS 26.0, *) { return true }
+    #endif
+    return false
+  }
+
+  static func authorizationState() -> String {
+    #if canImport(AlarmKit)
+    if #available(iOS 26.0, *) { return AlarmKitStore.authorizationState() }
+    #endif
+    return PhonePermissionState.unavailable
+  }
+
+  static func requestAuthorization() async -> String {
+    #if canImport(AlarmKit)
+    if #available(iOS 26.0, *) {
+      await AlarmKitStore.requestAuthorization()
+      return AlarmKitStore.authorizationState()
+    }
+    #endif
+    return PhonePermissionState.unavailable
+  }
+
+  static func liveIDs() -> Set<String> {
+    #if canImport(AlarmKit)
+    if #available(iOS 26.0, *) { return AlarmKitStore.liveIDs() }
+    #endif
+    return []
+  }
+
+  static func schedule(id: UUID, hour: Int, minute: Int, days: [Int], title: String) async throws {
+    #if canImport(AlarmKit)
+    if #available(iOS 26.0, *) {
+      try await AlarmKitStore.schedule(id: id, hour: hour, minute: minute, days: days, title: title)
+      return
+    }
+    #endif
+    throw PhoneConnectorError.unavailable
+  }
+
+  static func cancel(id: UUID) throws {
+    #if canImport(AlarmKit)
+    if #available(iOS 26.0, *) {
+      try AlarmKitStore.cancel(id: id)
+      return
+    }
+    #endif
+    throw PhoneConnectorError.unavailable
+  }
+}
diff --git a/apps/mobile/modules/rakazo-connectors/ios/PhoneCalendarConnector.swift b/apps/mobile/modules/rakazo-connectors/ios/PhoneCalendarConnector.swift
new file mode 100644
index 000000000..4d4ab13a6
--- /dev/null
+++ b/apps/mobile/modules/rakazo-connectors/ios/PhoneCalendarConnector.swift
@@ -0,0 +1,114 @@
+import EventKit
+import Foundation
+
+/// The phone's calendars: what is in them, and adding or changing one event.
+@MainActor
+enum PhoneCalendarConnector {
+  static func list(_ args: [String: Any]) async throws -> [[String: Any]] {
+    guard PhonePermissions.state("calendar") == PhonePermissionState.granted else {
+      throw PhonePermissions.state("calendar") == PhonePermissionState.unavailable
+        ? PhoneConnectorError.unavailable
+        : PhoneConnectorError.permissionDenied
+    }
+    let store = EKEventStore()
+    let now = Date()
+    let from = PhoneDate.parse(PhoneJSON.string(args, "from")) ?? now
+    let to = PhoneDate.parse(PhoneJSON.string(args, "to")) ?? from.addingTimeInterval(7 * 24 * 3600)
+    guard to >= from else { throw PhoneConnectorError.invalid }
+    let predicate = store.predicateForEvents(withStart: from, end: to, calendars: nil)
+    let events = store.events(matching: predicate).sorted { $0.startDate < $1.startDate }
+    let limit = min(max(PhoneJSON.int(args, "limit") ?? 100, 1), 300)
+    return events.prefix(limit).map(describe)
+  }
+
+  static func create(_ args: [String: Any]) async throws -> [String: Any] {
+    try requirePermission()
+    let store = EKEventStore()
+    let title = PhoneJSON.string(args, "title").trimmingCharacters(in: .whitespacesAndNewlines)
+    guard !title.isEmpty else { throw PhoneConnectorError.invalid }
+    guard let start = PhoneDate.parse(PhoneJSON.string(args, "start")) else {
+      throw PhoneConnectorError.invalid
+    }
+    let allDay = PhoneJSON.bool(args, "allDay")
+    let end = PhoneDate.parse(PhoneJSON.string(args, "end")) ?? start.addingTimeInterval(allDay ? 24 * 3600 : 3600)
+    guard end >= start else { throw PhoneConnectorError.invalid }
+
+    guard let calendar = calendar(for: PhoneJSON.string(args, "calendar"), in: store) else {
+      throw PhoneConnectorError.unavailable
+    }
+    let event = EKEvent(eventStore: store)
+    event.title = title
+    event.startDate = start
+    event.endDate = end
+    event.isAllDay = allDay
+    event.location = PhoneJSON.string(args, "location")
+    event.notes = PhoneJSON.string(args, "notes")
+    event.calendar = calendar
+    do {
+      try store.save(event, span: .thisEvent, commit: true)
+    } catch {
+      throw PhoneConnectorError.unavailable
+    }
+    return describe(event)
+  }
+
+  static func update(_ args: [String: Any]) async throws -> [String: Any] {
+    try requirePermission()
+    let store = EKEventStore()
+    let id = PhoneJSON.string(args, "id").trimmingCharacters(in: .whitespacesAndNewlines)
+    guard !id.isEmpty else { throw PhoneConnectorError.invalid }
+    guard let event = store.event(withIdentifier: id) else { throw PhoneConnectorError.notFound }
+    if let title = args["title"] as? String, !title.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty {
+      event.title = title
+    }
+    if let start = PhoneDate.parse(PhoneJSON.string(args, "start")) { event.startDate = start }
+    if let end = PhoneDate.parse(PhoneJSON.string(args, "end")) { event.endDate = end }
+    if args["allDay"] != nil { event.isAllDay = PhoneJSON.bool(args, "allDay") }
+    if let location = args["location"] as? String { event.location = location }
+    if let notes = args["notes"] as? String { event.notes = notes }
+    if let calendarName = args["calendar"] as? String, !calendarName.isEmpty,
+       let calendar = calendar(for: calendarName, in: store) {
+      event.calendar = calendar
+    }
+    guard event.endDate >= event.startDate else { throw PhoneConnectorError.invalid }
+    do {
+      try store.save(event, span: .thisEvent, commit: true)
+    } catch {
+      throw PhoneConnectorError.unavailable
+    }
+    return describe(event)
+  }
+
+  private static func requirePermission() throws {
+    let state = PhonePermissions.state("calendar")
+    if state == PhonePermissionState.granted { return }
+    throw state == PhonePermissionState.unavailable
+      ? PhoneConnectorError.unavailable
+      : PhoneConnectorError.permissionDenied
+  }
+
+  /// The calendar the person named, or the one new events belong in.
+  private static func calendar(for name: String, in store: EKEventStore) -> EKCalendar? {
+    let wanted = name.trimmingCharacters(in: .whitespacesAndNewlines)
+    if !wanted.isEmpty,
+       let named = store.calendars(for: .event).first(where: {
+         $0.title.caseInsensitiveCompare(wanted) == .orderedSame
+       }) {
+      return named
+    }
+    return store.defaultCalendarForNewEvents
+  }
+
+  private static func describe(_ event: EKEvent) -> [String: Any] {
+    [
+      "id": event.eventIdentifier ?? "",
+      "title": event.title ?? "",
+      "start": PhoneDate.string(event.startDate),
+      "end": PhoneDate.string(event.endDate),
+      "allDay": event.isAllDay,
+      "location": event.location ?? "",
+      "notes": event.notes ?? "",
+      "calendar": event.calendar?.title ?? "",
+    ]
+  }
+}
diff --git a/apps/mobile/modules/rakazo-connectors/ios/PhoneConnectorRunner.swift b/apps/mobile/modules/rakazo-connectors/ios/PhoneConnectorRunner.swift
new file mode 100644
index 000000000..2ab04ba0d
--- /dev/null
+++ b/apps/mobile/modules/rakazo-connectors/ios/PhoneConnectorRunner.swift
@@ -0,0 +1,56 @@
+import Foundation
+
+/// The twelve methods the server sends the phone, and the one shape every answer takes.
+@MainActor
+enum PhoneConnectorRunner {
+  static func run(method: String, argsJson: String) async -> String {
+    let args = PhoneJSON.dictionary(argsJson)
+    do {
+      let value = try await answer(method: method, args: args)
+      return PhoneJSON.encode(["value": value])
+    } catch let error as PhoneConnectorError {
+      return PhoneJSON.encode(["error": error.rawValue])
+    } catch {
+      return PhoneJSON.encode(["error": PhoneConnectorError.unavailable.rawValue])
+    }
+  }
+
+  private static func answer(method: String, args: [String: Any]) async throws -> Any {
+    switch method {
+    case "phoneStatus":
+      return [
+        "permissions": [
+          "alarms": PhonePermissions.state("alarms"),
+          "calendar": PhonePermissions.state("calendar"),
+          "reminders": PhonePermissions.state("reminders"),
+          "contacts": PhonePermissions.state("contacts"),
+          "location": PhonePermissions.state("location"),
+        ],
+      ]
+    case "phoneAlarmList":
+      return try await PhoneAlarmConnector.list()
+    case "phoneAlarmSet":
+      return try await PhoneAlarmConnector.set(args)
+    case "phoneAlarmCancel":
+      return try PhoneAlarmConnector.cancel(args)
+    case "phoneCalendarList":
+      return try await PhoneCalendarConnector.list(args)
+    case "phoneCalendarCreate":
+      return try await PhoneCalendarConnector.create(args)
+    case "phoneCalendarUpdate":
+      return try await PhoneCalendarConnector.update(args)
+    case "phoneReminderList":
+      return try await PhoneReminderConnector.list(args)
+    case "phoneReminderCreate":
+      return try await PhoneReminderConnector.create(args)
+    case "phoneReminderComplete":
+      return try await PhoneReminderConnector.complete(args)
+    case "phoneContactSearch":
+      return try PhoneContactConnector.search(args)
+    case "phoneLocation":
+      return try await PhoneLocationConnector.current()
+    default:
+      throw PhoneConnectorError.invalid
+    }
+  }
+}
diff --git a/apps/mobile/modules/rakazo-connectors/ios/PhoneConnectorSupport.swift b/apps/mobile/modules/rakazo-connectors/ios/PhoneConnectorSupport.swift
new file mode 100644
index 000000000..e5e3fcf2b
--- /dev/null
+++ b/apps/mobile/modules/rakazo-connectors/ios/PhoneConnectorSupport.swift
@@ -0,0 +1,214 @@
+import Contacts
+import CoreLocation
+import EventKit
+import Foundation
+
+/// A refusal, in the words the server and the phone share.
+enum PhoneConnectorError: String, Error {
+  case switchOff = "switch_off"
+  case permissionDenied = "permission_denied"
+  case unavailable = "unavailable"
+  case notFound = "not_found"
+  case invalid = "invalid"
+}
+
+/// The five permissions, each answered by its own framework.
+enum PhonePermissionState {
+  static let granted = "granted"
+  static let denied = "denied"
+  static let undetermined = "undetermined"
+  static let unavailable = "unavailable"
+}
+
+enum PhoneJSON {
+  /// The arguments of one request; anything unreadable is an empty set, which the method refuses.
+  static func dictionary(_ text: String) -> [String: Any] {
+    guard let data = text.data(using: .utf8),
+          let object = try? JSONSerialization.jsonObject(with: data),
+          let dictionary = object as? [String: Any]
+    else { return [:] }
+    return dictionary
+  }
+
+  /// One answer, encoded as text. A value that cannot be encoded is itself a refusal.
+  static func encode(_ object: [String: Any]) -> String {
+    guard let data = try? JSONSerialization.data(withJSONObject: object),
+          let text = String(data: data, encoding: .utf8)
+    else { return #"{"error":"unavailable"}"# }
+    return text
+  }
+
+  static func string(_ args: [String: Any], _ key: String) -> String {
+    (args[key] as? String) ?? ""
+  }
+
+  static func int(_ args: [String: Any], _ key: String) -> Int? {
+    if let value = args[key] as? Int { return value }
+    if let value = args[key] as? Double { return Int(value) }
+    if let value = args[key] as? NSNumber { return value.intValue }
+    if let text = args[key] as? String { return Int(text) }
+    return nil
+  }
+
+  static func bool(_ args: [String: Any], _ key: String, default fallback: Bool = false) -> Bool {
+    if let value = args[key] as? Bool { return value }
+    if let value = args[key] as? NSNumber { return value.boolValue }
+    return fallback
+  }
+
+  static func ints(_ args: [String: Any], _ key: String) -> [Int] {
+    (args[key] as? [Any])?.compactMap { value in
+      if let number = value as? Int { return number }
+      if let number = value as? NSNumber { return number.intValue }
+      if let text = value as? String { return Int(text) }
+      return nil
+    } ?? []
+  }
+}
+
+/// The phone's times, in ISO 8601 with this phone's own offset, and back again.
+enum PhoneDate {
+  static func parse(_ text: String) -> Date? {
+    let trimmed = text.trimmingCharacters(in: .whitespacesAndNewlines)
+    guard !trimmed.isEmpty else { return nil }
+    let fractional = ISO8601DateFormatter()
+    fractional.formatOptions = [.withInternetDateTime, .withFractionalSeconds]
+    if let date = fractional.date(from: trimmed) { return date }
+    let plain = ISO8601DateFormatter()
+    plain.formatOptions = [.withInternetDateTime]
+    if let date = plain.date(from: trimmed) { return date }
+    // A whole day, as an all-day event or reminder writes it.
+    let day = ISO8601DateFormatter()
+    day.formatOptions = [.withFullDate]
+    if let date = day.date(from: trimmed) { return date }
+    let local = DateFormatter()
+    local.locale = Locale(identifier: "en_US_POSIX")
+    local.timeZone = .current
+    local.dateFormat = "yyyy-MM-dd HH:mm"
+    return local.date(from: trimmed)
+  }
+
+  static func string(_ date: Date) -> String {
+    let formatter = ISO8601DateFormatter()
+    formatter.formatOptions = [.withInternetDateTime]
+    formatter.timeZone = .current
+    return formatter.string(from: date)
+  }
+
+  /// A due date as the reminder stores it: the clock time the person meant, in this time zone.
+  static func components(_ date: Date) -> DateComponents {
+    var calendar = Calendar.current
+    calendar.timeZone = .current
+    return calendar.dateComponents([.year, .month, .day, .hour, .minute], from: date)
+  }
+}
+
+/// Whether iOS lets this app use a framework, and asking for it when it has not been asked.
+@MainActor
+enum PhonePermissions {
+  static func state(_ kind: String) -> String {
+    switch kind {
+    case "alarms": return alarmState
+    case "calendar": return eventState(.event)
+    case "reminders": return eventState(.reminder)
+    case "contacts": return contactsState
+    case "location": return locationState
+    default: return PhonePermissionState.unavailable
+    }
+  }
+
+  static func request(_ kind: String) async -> String {
+    switch kind {
+    case "alarms": return await requestAlarms()
+    case "calendar": return await requestEvents(.event)
+    case "reminders": return await requestEvents(.reminder)
+    case "contacts": return await requestContacts()
+    case "location": return await LocationPermission.shared.ask()
+    default: return PhonePermissionState.unavailable
+    }
+  }
+
+  // MARK: - Alarms
+
+  static var alarmState: String {
+    #if canImport(AlarmKit)
+    if #available(iOS 26.0, *) {
+      return AlarmKitStore.authorizationState()
+    }
+    #endif
+    return PhonePermissionState.unavailable
+  }
+
+  static func requestAlarms() async -> String {
+    #if canImport(AlarmKit)
+    if #available(iOS 26.0, *) {
+      await AlarmKitStore.requestAuthorization()
+    }
+    #endif
+    return alarmState
+  }
+
+  // MARK: - Calendar and reminders
+
+  private static func eventState(_ entity: EKEntityType) -> String {
+    switch EKEventStore.authorizationStatus(for: entity) {
+    case .fullAccess: return PhonePermissionState.granted
+    case .authorized: return PhonePermissionState.granted
+    case .writeOnly: return PhonePermissionState.denied
+    case .denied: return PhonePermissionState.denied
+    case .restricted: return PhonePermissionState.denied
+    case .notDetermined: return PhonePermissionState.undetermined
+    @unknown default: return PhonePermissionState.undetermined
+    }
+  }
+
+  private static func requestEvents(_ entity: EKEntityType) async -> String {
+    let store = EKEventStore()
+    if #available(iOS 17.0, *) {
+      if entity == .event {
+        _ = try? await store.requestFullAccessToEvents()
+      } else {
+        _ = try? await store.requestFullAccessToReminders()
+      }
+    } else {
+      await withCheckedContinuation { (continuation: CheckedContinuation<Void, Never>) in
+        store.requestAccess(to: entity) { _, _ in continuation.resume() }
+      }
+    }
+    return eventState(entity)
+  }
+
+  // MARK: - Contacts
+
+  private static var contactsState: String {
+    switch CNContactStore.authorizationStatus(for: .contacts) {
+    case .authorized: return PhonePermissionState.granted
+    case .limited: return PhonePermissionState.granted
+    case .denied: return PhonePermissionState.denied
+    case .restricted: return PhonePermissionState.denied
+    case .notDetermined: return PhonePermissionState.undetermined
+    @unknown default: return PhonePermissionState.undetermined
+    }
+  }
+
+  private static func requestContacts() async -> String {
+    let store = CNContactStore()
+    await withCheckedContinuation { (continuation: CheckedContinuation<Void, Never>) in
+      store.requestAccess(for: .contacts) { _, _ in continuation.resume() }
+    }
+    return contactsState
+  }
+
+  // MARK: - Location
+
+  private static var locationState: String {
+    switch LocationPermission.shared.manager.authorizationStatus {
+    case .authorizedWhenInUse: return PhonePermissionState.granted
+    case .authorizedAlways: return PhonePermissionState.granted
+    case .denied: return PhonePermissionState.denied
+    case .restricted: return PhonePermissionState.denied
+    case .notDetermined: return PhonePermissionState.undetermined
+    @unknown default: return PhonePermissionState.undetermined
+    }
+  }
+}
diff --git a/apps/mobile/modules/rakazo-connectors/ios/PhoneContactConnector.swift b/apps/mobile/modules/rakazo-connectors/ios/PhoneContactConnector.swift
new file mode 100644
index 000000000..bae53e614
--- /dev/null
+++ b/apps/mobile/modules/rakazo-connectors/ios/PhoneContactConnector.swift
@@ -0,0 +1,57 @@
+import Contacts
+import Foundation
+
+/// The phone's contacts: finding one by a name or a number, and the fields worth reading.
+@MainActor
+enum PhoneContactConnector {
+  static func search(_ args: [String: Any]) throws -> [[String: Any]] {
+    let state = PhonePermissions.state("contacts")
+    if state != PhonePermissionState.granted {
+      throw state == PhonePermissionState.unavailable
+        ? PhoneConnectorError.unavailable
+        : PhoneConnectorError.permissionDenied
+    }
+    let query = PhoneJSON.string(args, "query").trimmingCharacters(in: .whitespacesAndNewlines)
+    guard !query.isEmpty else { throw PhoneConnectorError.invalid }
+    let store = CNContactStore()
+    let keys: [CNKeyDescriptor] = [
+      CNContactIdentifierKey,
+      CNContactGivenNameKey,
+      CNContactFamilyNameKey,
+      CNContactOrganizationNameKey,
+      CNContactPhoneNumbersKey,
+      CNContactEmailAddressesKey,
+    ].map { $0 as CNKeyDescriptor }
+
+    let digits = query.filter { $0.isNumber }
+    let predicate: NSPredicate =
+      digits.count >= 3 && digits.count >= query.count / 2
+      ? CNContact.predicateForContacts(matching: CNPhoneNumber(stringValue: query))
+      : CNContact.predicateForContacts(matchingName: query)
+
+    let limit = min(max(PhoneJSON.int(args, "limit") ?? 20, 1), 50)
+    let contacts: [CNContact]
+    do {
+      contacts = try store.unifiedContacts(matching: predicate, keysToFetch: keys)
+    } catch {
+      throw PhoneConnectorError.unavailable
+    }
+    return contacts.prefix(limit).map(describe)
+  }
+
+  private static func describe(_ contact: CNContact) -> [String: Any] {
+    let formatted = CNContactFormatter.string(from: contact, style: .fullName) ?? ""
+    let name =
+      formatted.isEmpty
+      ? [contact.givenName, contact.familyName, contact.organizationName]
+        .filter { !$0.isEmpty }
+        .joined(separator: " ")
+      : formatted
+    return [
+      "id": contact.identifier,
+      "name": name,
+      "phones": contact.phoneNumbers.prefix(10).map { $0.value.stringValue },
+      "emails": contact.emailAddresses.prefix(10).map { $0.value as String },
+    ]
+  }
+}
diff --git a/apps/mobile/modules/rakazo-connectors/ios/PhoneLocationConnector.swift b/apps/mobile/modules/rakazo-connectors/ios/PhoneLocationConnector.swift
new file mode 100644
index 000000000..d4310a7b2
--- /dev/null
+++ b/apps/mobile/modules/rakazo-connectors/ios/PhoneLocationConnector.swift
@@ -0,0 +1,152 @@
+import CoreLocation
+import Foundation
+
+/// Asking iOS for the location permission, once, and waiting for the person's answer.
+@MainActor
+final class LocationPermission: NSObject, CLLocationManagerDelegate {
+  static let shared = LocationPermission()
+  let manager = CLLocationManager()
+  private var waiting: [CheckedContinuation<Void, Never>] = []
+
+  override init() {
+    super.init()
+    manager.delegate = self
+  }
+
+  func ask() async -> String {
+    let state = PhonePermissions.state("location")
+    if state != PhonePermissionState.undetermined { return state }
+    await withCheckedContinuation { (continuation: CheckedContinuation<Void, Never>) in
+      waiting.append(continuation)
+      manager.requestWhenInUseAuthorization()
+      // A question left unanswered must not hold the screen open forever.
+      Task { @MainActor in
+        try? await Task.sleep(nanoseconds: 12_000_000_000)
+        self.settle()
+      }
+    }
+    return PhonePermissions.state("location")
+  }
+
+  private func settle() {
+    let pending = waiting
+    waiting = []
+    for continuation in pending { continuation.resume() }
+  }
+
+  nonisolated func locationManagerDidChangeAuthorization(_ manager: CLLocationManager) {
+    Task { @MainActor in self.settle() }
+  }
+}
+
+/// One location fix, from the phone's own radio, with the address it maps to.
+@MainActor
+final class LocationFix: NSObject, CLLocationManagerDelegate {
+  static let shared = LocationFix()
+  private let manager = CLLocationManager()
+  private var waiting: CheckedContinuation<CLLocation, Error>?
+  private var expiry: Task<Void, Never>?
+
+  override init() {
+    super.init()
+    manager.delegate = self
+    manager.desiredAccuracy = kCLLocationAccuracyHundredMeters
+  }
+
+  func one() async throws -> CLLocation {
+    if let recent = manager.location, recent.timestamp.timeIntervalSinceNow > -60 {
+      return recent
+    }
+    return try await withCheckedThrowingContinuation { (continuation: CheckedContinuation<CLLocation, Error>) in
+      waiting = continuation
+      manager.requestLocation()
+      expiry = Task { @MainActor in
+        try? await Task.sleep(nanoseconds: 15_000_000_000)
+        self.fail(PhoneConnectorError.unavailable)
+      }
+    }
+  }
+
+  private func succeed(_ location: CLLocation?) {
+    expiry?.cancel()
+    expiry = nil
+    let continuation = waiting
+    waiting = nil
+    guard let location else {
+      continuation?.resume(throwing: PhoneConnectorError.unavailable)
+      return
+    }
+    continuation?.resume(returning: location)
+  }
+
+  private func fail(_ error: PhoneConnectorError) {
+    expiry?.cancel()
+    expiry = nil
+    let continuation = waiting
+    waiting = nil
+    continuation?.resume(throwing: error)
+  }
+
+  nonisolated func locationManager(_ manager: CLLocationManager, didUpdateLocations locations: [CLLocation]) {
+    Task { @MainActor in self.succeed(locations.last) }
+  }
+
+  nonisolated func locationManager(_ manager: CLLocationManager, didFailWithError error: Error) {
+    let denied = (error as? CLError)?.code == .denied
+    Task { @MainActor in
+      self.fail(denied ? PhoneConnectorError.permissionDenied : PhoneConnectorError.unavailable)
+    }
+  }
+}
+
+@MainActor
+enum PhoneLocationConnector {
+  static func current() async throws -> [String: Any] {
+    let state = PhonePermissions.state("location")
+    if state != PhonePermissionState.granted {
+      throw state == PhonePermissionState.unavailable
+        ? PhoneConnectorError.unavailable
+        : PhoneConnectorError.permissionDenied
+    }
+    let fix = try await LocationFix.shared.one()
+    let place = await reverseGeocode(fix)
+    return [
+      "latitude": fix.coordinate.latitude,
+      "longitude": fix.coordinate.longitude,
+      "accuracy": fix.horizontalAccuracy,
+      "timestamp": PhoneDate.string(fix.timestamp),
+      "place": place,
+    ]
+  }
+
+  /// The address for a fix; an empty place when the network cannot name it is still a fix.
+  private static func reverseGeocode(_ location: CLLocation) async -> [String: Any] {
+    let empty: [String: Any] = [
+      "name": "",
+      "thoroughfare": "",
+      "locality": "",
+      "administrativeArea": "",
+      "country": "",
+      "postalCode": "",
+    ]
+    let geocoder = CLGeocoder()
+    return await withCheckedContinuation { (continuation: CheckedContinuation<[String: Any], Never>) in
+      geocoder.reverseGeocodeLocation(location) { marks, _ in
+        guard let mark = marks?.first else {
+          continuation.resume(returning: empty)
+          return
+        }
+        continuation.resume(
+          returning: [
+            "name": mark.name ?? "",
+            "thoroughfare": mark.thoroughfare ?? "",
+            "locality": mark.locality ?? "",
+            "administrativeArea": mark.administrativeArea ?? "",
+            "country": mark.country ?? "",
+            "postalCode": mark.postalCode ?? "",
+          ]
+        )
+      }
+    }
+  }
+}
diff --git a/apps/mobile/modules/rakazo-connectors/ios/PhoneReminderConnector.swift b/apps/mobile/modules/rakazo-connectors/ios/PhoneReminderConnector.swift
new file mode 100644
index 000000000..474ace28a
--- /dev/null
+++ b/apps/mobile/modules/rakazo-connectors/ios/PhoneReminderConnector.swift
@@ -0,0 +1,110 @@
+import EventKit
+import Foundation
+
+/// The phone's reminders: the lists, what is still to do, and marking one done.
+@MainActor
+enum PhoneReminderConnector {
+  static func list(_ args: [String: Any]) async throws -> [[String: Any]] {
+    try requirePermission()
+    let store = EKEventStore()
+    let wanted = PhoneJSON.string(args, "list").trimmingCharacters(in: .whitespacesAndNewlines)
+    let calendars = store.calendars(for: .reminder).filter {
+      wanted.isEmpty || $0.title.caseInsensitiveCompare(wanted) == .orderedSame
+    }
+    var reminders = await fetch(
+      store,
+      store.predicateForIncompleteReminders(withDueDateStarting: nil, ending: nil, calendars: calendars)
+    )
+    if PhoneJSON.bool(args, "includeCompleted") {
+      let done = await fetch(
+        store,
+        store.predicateForCompletedReminders(
+          withCompletionDateStarting: nil,
+          ending: nil,
+          calendars: calendars
+        )
+      )
+      reminders.append(contentsOf: done)
+    }
+    let limit = min(max(PhoneJSON.int(args, "limit") ?? 100, 1), 300)
+    return reminders.prefix(limit).map(describe)
+  }
+
+  static func create(_ args: [String: Any]) async throws -> [String: Any] {
+    try requirePermission()
+    let store = EKEventStore()
+    let title = PhoneJSON.string(args, "title").trimmingCharacters(in: .whitespacesAndNewlines)
+    guard !title.isEmpty else { throw PhoneConnectorError.invalid }
+    let wanted = PhoneJSON.string(args, "list").trimmingCharacters(in: .whitespacesAndNewlines)
+    let calendar =
+      store.calendars(for: .reminder).first {
+        !wanted.isEmpty && $0.title.caseInsensitiveCompare(wanted) == .orderedSame
+      } ?? store.defaultCalendarForNewReminders()
+    guard let calendar else { throw PhoneConnectorError.unavailable }
+
+    let reminder = EKReminder(eventStore: store)
+    reminder.title = title
+    reminder.notes = PhoneJSON.string(args, "notes")
+    reminder.calendar = calendar
+    if let due = PhoneDate.parse(PhoneJSON.string(args, "due")) {
+      reminder.dueDateComponents = PhoneDate.components(due)
+    }
+    do {
+      try store.save(reminder, commit: true)
+    } catch {
+      throw PhoneConnectorError.unavailable
+    }
+    return describe(reminder)
+  }
+
+  static func complete(_ args: [String: Any]) async throws -> [String: Any] {
+    try requirePermission()
+    let store = EKEventStore()
+    let id = PhoneJSON.string(args, "id").trimmingCharacters(in: .whitespacesAndNewlines)
+    guard !id.isEmpty else { throw PhoneConnectorError.invalid }
+    guard let reminder = store.calendarItem(withIdentifier: id) as? EKReminder else {
+      throw PhoneConnectorError.notFound
+    }
+    let done = PhoneJSON.bool(args, "completed", default: true)
+    reminder.isCompleted = done
+    reminder.completionDate = done ? Date() : nil
+    do {
+      try store.save(reminder, commit: true)
+    } catch {
+      throw PhoneConnectorError.unavailable
+    }
+    return describe(reminder)
+  }
+
+  private static func fetch(_ store: EKEventStore, _ predicate: NSPredicate) async -> [EKReminder] {
+    await withCheckedContinuation { (continuation: CheckedContinuation<[EKReminder], Never>) in
+      store.fetchReminders(matching: predicate) { reminders in
+        continuation.resume(returning: reminders ?? [])
+      }
+    }
+  }
+
+  private static func requirePermission() throws {
+    let state = PhonePermissions.state("reminders")
+    if state == PhonePermissionState.granted { return }
+    throw state == PhonePermissionState.unavailable
+      ? PhoneConnectorError.unavailable
+      : PhoneConnectorError.permissionDenied
+  }
+
+  private static func describe(_ reminder: EKReminder) -> [String: Any] {
+    var due: String?
+    if let components = reminder.dueDateComponents,
+       let date = Calendar.current.date(from: components) {
+      due = PhoneDate.string(date)
+    }
+    return [
+      "id": reminder.calendarItemIdentifier,
+      "title": reminder.title ?? "",
+      "due": due ?? NSNull(),
+      "completed": reminder.isCompleted,
+      "list": reminder.calendar?.title ?? "",
+      "notes": reminder.notes ?? "",
+    ]
+  }
+}
