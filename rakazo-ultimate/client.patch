+import { describe, expect, it } from "vitest";
+import {
+  formatCompactTokens,
+  formatCount,
+  formatElapsed,
+  formatExactTokens,
+  formatPercent,
+  formatWindowRange,
+  modelLabel,
+  thinkingLabel,
+  usageTags,
+} from "./usage-display";
+
+describe("formatCompactTokens", () => {
+  it("writes a small total as its own figures", () => {
+    expect(formatCompactTokens(0)).toBe("0");
+    expect(formatCompactTokens(512)).toBe("512");
+    expect(formatCompactTokens(999)).toBe("999");
+  });
+
+  it("cuts thousands to one decimal", () => {
+    expect(formatCompactTokens(1_000)).toBe("1.0K");
+    expect(formatCompactTokens(38_581)).toBe("38.6K");
+    expect(formatCompactTokens(999_499)).toBe("999.5K");
+  });
+
+  it("cuts millions to two decimals", () => {
+    expect(formatCompactTokens(1_000_000)).toBe("1.00M");
+    expect(formatCompactTokens(1_250_000)).toBe("1.25M");
+    expect(formatCompactTokens(456_072_752)).toBe("456.07M");
+  });
+
+  it("never prints a thousand thousands", () => {
+    expect(formatCompactTokens(999_999)).toBe("1.00M");
+    expect(formatCompactTokens(999_950)).toBe("1.00M");
+    expect(formatCompactTokens(999_949)).toBe("999.9K");
+  });
+
+  it("shows a figure it never had as a dash", () => {
+    expect(formatCompactTokens(null)).toBe("—");
+    expect(formatCompactTokens(undefined)).toBe("—");
+  });
+});
+
+describe("formatExactTokens", () => {
+  it("groups every figure of a total", () => {
+    expect(formatExactTokens(456_072_752)).toBe("456,072,752");
+    expect(formatExactTokens(999)).toBe("999");
+    expect(formatExactTokens(0)).toBe("0");
+    expect(formatExactTokens(null)).toBe("—");
+  });
+
+  it("counts a whole number the same way", () => {
+    expect(formatCount(1_234)).toBe("1,234");
+  });
+});
+
+describe("formatPercent", () => {
+  it("reads a fraction of the prompt as a percentage", () => {
+    expect(formatPercent(0.7235)).toBe("72.4%");
+    expect(formatPercent(0)).toBe("0.0%");
+    expect(formatPercent(1)).toBe("100%");
+    expect(formatPercent(null)).toBe("—");
+  });
+});
+
+describe("formatElapsed", () => {
+  it("picks the unit the wait belongs to", () => {
+    expect(formatElapsed(820)).toBe("820ms");
+    expect(formatElapsed(1_234)).toBe("1.2s");
+    expect(formatElapsed(59_400)).toBe("59.4s");
+    expect(formatElapsed(125_000)).toBe("2m 5s");
+    expect(formatElapsed(120_000)).toBe("2m");
+    expect(formatElapsed(3_900_000)).toBe("1h 5m");
+    expect(formatElapsed(null)).toBe("—");
+  });
+});
+
+describe("formatWindowRange", () => {
+  it("writes the hours a short window covers", () => {
+    const same = formatWindowRange("1h", "2026-11-18T12:23:00Z", "2026-11-18T13:23:00Z", "en-US");
+    expect(same).toContain("–");
+    expect(same).toContain(":");
+  });
+
+  it("writes nothing when the server sent no window", () => {
+    expect(formatWindowRange("24h", "", "", "en-US")).toBe("");
+  });
+});
+
+describe("usageTags", () => {
+  const call = (over: Partial<Parameters<typeof usageTags>[0]> = {}) => ({
+    desk: "front_desk" as const,
+    trigger: "user",
+    operationKind: "answer" as string | null,
