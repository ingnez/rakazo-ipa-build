--- /dev/null
+++ b/apps/mobile/lib/quick-look.ts
@@ -0,0 +1,66 @@
+import { requireOptionalNativeModule } from "expo-modules-core";
+
+/**
+ * The system document viewer, written for iOS; absent in a build without it.
+ *
+ * QuickLook is what the phone itself uses to show a PDF, a slide deck or a spreadsheet, and it
+ * brings its own close and share buttons — so a document is read where it lies instead of being
+ * handed to the share sheet before a single page is visible.
+ */
+type QuickLookModule = {
+  /** Opens the file full screen; the promise settles when the viewer closes. */
+  open: (uri: string) => Promise<void>;
+};
+
+function quickLook(): QuickLookModule | null {
+  return (requireOptionalNativeModule("RakazoQuickLook") as QuickLookModule | null) ?? null;
+}
+
+/** Whether this build can show files in the system viewer. */
+export function quickLookAvailable(): boolean {
+  try {
+    return quickLook() !== null;
+  } catch {
+    return false;
+  }
+}
+
+/** The document types the viewer reads: pages, slides, sheets, plain text and books. */
+const DOCUMENT_TYPES = [
+  "application/pdf",
+  "text/",
+  "application/json",
+  "application/xml",
+  "application/rtf",
+  "application/epub+zip",
+  "application/msword",
+  "application/vnd.ms-excel",
+  "application/vnd.ms-powerpoint",
+  "wordprocessingml",
+  "spreadsheetml",
+  "presentationml",
+  "opendocument",
+  "application/vnd.apple.pages",
+  "application/vnd.apple.numbers",
+  "application/vnd.apple.keynote",
+];
+
+/**
+ * Whether a file should open in the viewer rather than be offered to other apps.
+ *
+ * Only what the viewer really reads: an installer, an archive or an app package is something to
+ * send somewhere, and the share sheet is the only place for it.
+ */
+export function quickLookOpens(mimeType: string): boolean {
+  const type = mimeType.split(";")[0]?.trim().toLowerCase() ?? "";
+  // The Office types name their format in the middle of the MIME, so the whole string is read.
+  if (!DOCUMENT_TYPES.some((known) => type.includes(known))) return false;
+  return quickLookAvailable();
+}
+
+/** Opens a file in the system's viewer; rejects when this build or device cannot. */
+export function openInQuickLook(uri: string): Promise<void> {
+  const module = quickLook();
+  if (!module) return Promise.reject(new Error("no document viewer in this build"));
+  return module.open(uri);
+}
diff --git a/apps/mobile/lib/realtime-audio.ts b/apps/mobile/lib/realtime-audio.ts
new file mode 100644
index 000000000..1f1e51291
--- /dev/null
+++ b/apps/mobile/lib/realtime-audio.ts
@@ -0,0 +1,112 @@
+import { decodeBase64, encodeBase64 } from "./realtime-protocol";
+
+/**
+ * The phone's side of a live call's audio: the microphone at the model's own rate, and the model's
+ * voice played while it is still arriving.
+ *
+ * The native module is one AVAudioEngine in `.voiceChat` mode — the mode with echo cancellation, so
+ * the bot does not hear itself through the speaker and talk over itself. It is written for iOS;
+ * a build without it reports no realtime audio, and the call falls back to the turn-based path.
+ */
+export interface RealtimeAudioPort {
+  /** Opens microphone and speaker at the call's two rates. */
+  start(inputSampleRate: number, outputSampleRate: number): void;
+  /** Ends the call's audio and hands the session back to the phone. */
+  stop(): void;
+  /** A muted call keeps listening but sends nothing. */
+  setMuted(muted: boolean): void;
+  /** Queues one piece of the model's PCM16 mono audio. */
+  play(pcm: Uint8Array): void;
+  /** Throws away what is queued but not yet heard. */
+  flush(): void;
+  /** Every 20 ms of the microphone, until the returned function is called. */
+  listen(onFrame: (pcm: Uint8Array) => void): () => void;
+  /** A phone call, Siri or an unplugged headset took the audio; `began` is false when it is back. */
+  onInterruption(listener: (began: boolean) => void): () => void;
+}
+
+type RealtimeAudioNative = {
+  start(inputSampleRate: number, outputSampleRate: number): void;
+  setMuted(muted: boolean): void;
+  play(base64: string): void;
+  flush(): void;
+  stop(): void;
+  addListener(event: "onAudio", listener: (event: { data?: string }) => void): { remove(): void };
+  addListener(
+    event: "onInterruption",
+    listener: (event: { began?: boolean }) => void,
+  ): { remove(): void };
+};
+
+/**
+ * The native module, loaded only when a call actually needs it: the engine's own package is a
+ * native-boundary import, and a build without the module (an older IPA, the web) simply has no
+ * live calls — which is a fallback to the turn-based call, not an error.
+ */
+async function realtimeAudioNative(): Promise<RealtimeAudioNative | null> {
+  try {
+    const core = await import("expo-modules-core");
+    return core.requireOptionalNativeModule<RealtimeAudioNative>("RakazoRealtimeAudio") ?? null;
+  } catch {
+    return null;
+  }
+}
+
+/** Whether this build can carry both directions of a live call. */
+export async function realtimeAudioAvailable(): Promise<boolean> {
+  return (await realtimeAudioNative()) !== null;
+}
+
+export async function createRealtimeAudio(): Promise<RealtimeAudioPort | null> {
+  const native = await realtimeAudioNative();
+  if (!native) return null;
+  const frameListeners = new Set<(pcm: Uint8Array) => void>();
+  const interruptionListeners = new Set<(began: boolean) => void>();
+  let subscribed = false;
+  let subscriptions: Array<{ remove(): void }> = [];
+
+  const subscribe = () => {
+    if (subscribed) return;
+    subscribed = true;
+    subscriptions = [
+      native.addListener("onAudio", (event) => {
+        if (!event?.data) return;
+        const pcm = decodeBase64(event.data);
+        for (const listener of [...frameListeners]) listener(pcm);
+      }),
+      native.addListener("onInterruption", (event) => {
+        for (const listener of [...interruptionListeners]) listener(event?.began === true);
+      }),
+    ];
+  };
+  const unsubscribeWhenIdle = () => {
+    if (!subscribed || frameListeners.size > 0 || interruptionListeners.size > 0) return;
+    subscribed = false;
+    for (const subscription of subscriptions) subscription.remove();
+    subscriptions = [];
+  };
+
+  return {
+    start: (inputSampleRate, outputSampleRate) => native.start(inputSampleRate, outputSampleRate),
+    stop: () => native.stop(),
+    setMuted: (muted) => native.setMuted(muted),
+    play: (pcm) => native.play(encodeBase64(pcm)),
+    flush: () => native.flush(),
+    listen: (onFrame) => {
+      frameListeners.add(onFrame);
+      subscribe();
+      return () => {
+        frameListeners.delete(onFrame);
+        unsubscribeWhenIdle();
+      };
+    },
+    onInterruption: (listener) => {
+      interruptionListeners.add(listener);
+      subscribe();
+      return () => {
+        interruptionListeners.delete(listener);
+        unsubscribeWhenIdle();
+      };
+    },
+  };
+}
diff --git a/apps/mobile/lib/realtime-call.test.ts b/apps/mobile/lib/realtime-call.test.ts
