@@ -0,0 +1,91 @@
+import * as z from "zod";
+import { VoiceInfoSchema } from "./domain.js";
+import { Id } from "./ids.js";
+
+/**
+ * The realtime (full-duplex) voice side of the app: which speech-to-speech models this deployment
+ * can hold a live call with, and the call's exact plan — the socket to open, the audio the phone
+ * must produce, and the call id its transcript will be grouped under.
+ */
+
+export const REALTIME_VOICE_PROVIDER_IDS = [
+  "bailian-cn",
+  "bailian-intl",
+  "openai",
+  "xai",
+  "google",
+  "volcengine",
+] as const;
+
+export const RealtimeVoiceProviderIdSchema = z.enum(REALTIME_VOICE_PROVIDER_IDS);
+export type RealtimeVoiceProviderId = z.infer<typeof RealtimeVoiceProviderIdSchema>;
+
+export const RealtimeVoiceProviderSchema = z.object({
+  id: RealtimeVoiceProviderIdSchema,
+  name: z.string(),
+  /** Whether the account already holds the key this provider needs. */
+  connected: z.boolean(),
+  /** The voice connection (设置 → 语音) whose key this provider reads. */
+  credentialProvider: z.string(),
+  defaultModel: z.string(),
+  defaultVoice: z.string(),
+  models: z.array(z.string()),
+  voices: z.array(VoiceInfoSchema),
+  /** PCM16 mono the phone must record at, in Hz. */
+  inputSampleRate: z.number().int().positive(),
+  /** PCM16 mono the gateway sends back, in Hz. */
+  outputSampleRate: z.number().int().positive(),
+  /** The provider needs a business space id (`ws-…`) before it will answer. */
+  needsWorkspace: z.boolean(),
+  /** One line for the settings screen, in Chinese. */
+  notes: z.string(),
+});
+export type RealtimeVoiceProvider = z.infer<typeof RealtimeVoiceProviderSchema>;
+
+export const RealtimeVoiceCatalogSchema = z.object({
+  providers: z.array(RealtimeVoiceProviderSchema),
+  /** The provider a new call starts with: the first connected one, else the first listed. */
+  preferred: RealtimeVoiceProviderIdSchema.nullable(),
+  /** The WebSocket path, so the app appends its own server origin. */
+  path: z.string(),
+});
+export type RealtimeVoiceCatalog = z.infer<typeof RealtimeVoiceCatalogSchema>;
+
+export const RealtimeCallPlanInput = z
+  .object({
+    botId: Id,
+    threadId: Id.optional(),
+    provider: z.string().optional(),
+    model: z.string().max(120).optional(),
+    voice: z.string().max(120).optional(),
+    /** The provider's business space, `ws-…`. */
+    workspace: z.string().max(64).optional(),
+    /** An OpenAI-compatible relay, for the OpenAI protocol only. */
+    baseUrl: z.string().max(512).optional(),
+    /** `json` sends assistant audio as base64 in JSON frames instead of binary frames. */
+    audioFormat: z.enum(["binary", "json"]).optional(),
+  })
+  .strict();
+export type RealtimeCallPlanInput = z.infer<typeof RealtimeCallPlanInput>;
+
+export const RealtimeCallPlanSchema = z.object({
+  /** The call id its messages are grouped under. */
+  callId: z.string(),
+  botId: Id,
+  threadId: Id,
+  provider: RealtimeVoiceProviderIdSchema,
+  providerName: z.string(),
+  model: z.string(),
+  voice: z.string(),
+  inputSampleRate: z.number().int().positive(),
+  outputSampleRate: z.number().int().positive(),
+  audioFormat: z.enum(["binary", "json"]),
+  /**
+   * The WebSocket path with its query, e.g. `/api/voice/realtime?botId=…&callId=…`. Open it
+   * with the same sign-in the app uses for RPC, as `wss://<server>/…`.
+   */
+  path: z.string(),
+  /** How long the gateway keeps the call open before hanging up. */
+  maxDurationSeconds: z.number().int().positive(),
+});
+export type RealtimeCallPlan = z.infer<typeof RealtimeCallPlanSchema>;
