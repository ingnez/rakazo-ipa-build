diff --git a/apps/mobile/lib/image-stack-layout.ts b/apps/mobile/lib/image-stack-layout.ts
new file mode 100644
index 000000000..5e91bbfba
--- /dev/null
+++ b/apps/mobile/lib/image-stack-layout.ts
@@ -0,0 +1,276 @@
+/** Geometry for a message's image cards, the composer attach tray, the viewer, and send policy.
+ * Shared by the UI and by layout tests so both read the same numbers.
+ *
+ * Every number lives at the top of this module as its own constant, and the functions that read
+ * them are rewritten by Reanimated's build into functions that run on the UI thread. A method
+ * written inside `ImageStackLayout`'s own object literal could not do that: the worklet plugin
+ * lifts it out of the literal, so the name it uses to reach its siblings is still undefined when
+ * the method runs, and the first image card crashed the app with "Cannot read property
+ * of undefined". So the object below only gathers the constants and references the functions;
+ * nothing inside a function reaches back through `ImageStackLayout`.*/
+
+export type ImageStackCard = {
+  /** 0 = the front card (the first image). */
+  index: number;
+  rotation: number;
+  offset: { width: number; height: number };
+  zIndex: number;
+};
+
+export type Size = { width: number; height: number };
+export type Point = { x: number; y: number };
+
+/** One image draws as a square card; two or more draw the taller card. */
+const SINGLE_EDGE = 210;
+const CARD_WIDTH = 168;
+const CARD_HEIGHT = 210;
+const STACK_INSET_WIDTH = 28;
+const STACK_INSET_HEIGHT = 8;
+
+export const SINGLE_SIZE: Size = { width: SINGLE_EDGE, height: SINGLE_EDGE };
+export const CARD_SIZE: Size = { width: CARD_WIDTH, height: CARD_HEIGHT };
+export const STACK_INSET: Size = { width: STACK_INSET_WIDTH, height: STACK_INSET_HEIGHT };
+export const CORNER_RADIUS = 18;
+/** Stacked rest pose draws at most this many cards; the caption still uses the real count. */
+export const MAX_STACKED = 3;
+/** Long-press fan-out shows at most this many cards. */
+export const MAX_FANNED = 5;
+export const CAPTION_HEIGHT = 18;
+export const CAPTION_SPACING = 6;
+export const FAN_SPACING = 46;
+/** Finger must travel at least this far, or release only keeps the fan / collapses it. */
+export const SCRUB_THRESHOLD = 12;
+export const HIGHLIGHT_SCALE = 1.14;
+export const REST_SCALE = 0.94;
+export const LONG_PRESS_MS = 350;
+
+/** Whether more than one image draws as a stack. */
+export function imageStackIsStack(count: number): boolean {
+  "worklet";
+  return count > 1;
+}
+
+/** "N 张图片"; a single image has no caption. */
+export function imageStackCaption(count: number): string | null {
+  "worklet";
+  return count > 1 ? `${count} 张图片` : null;
+}
+
+/** The box every card of a count is laid out in. */
+export function imageStackSize(count: number): Size {
+  "worklet";
+  if (count <= 0) return { width: 0, height: 0 };
+  if (count === 1) return { width: SINGLE_EDGE, height: SINGLE_EDGE };
+  return {
+    width: CARD_WIDTH + STACK_INSET_WIDTH * 2,
+    height: CARD_HEIGHT + STACK_INSET_HEIGHT * 2,
+  };
+}
+
+/** One card's own size: a lone image is square, a stack draws the taller card. */
+export function imageStackCardSize(count: number): Size {
+  "worklet";
+  return count === 1
+    ? { width: SINGLE_EDGE, height: SINGLE_EDGE }
+    : { width: CARD_WIDTH, height: CARD_HEIGHT };
+}
+
+/** The stack's height plus, for two or more images, the caption line under it. */
+export function imageStackHeight(count: number): number {
+  "worklet";
+  if (count <= 0) return 0;
+  const box = imageStackSize(count);
+  return box.height + (count > 1 ? CAPTION_SPACING + CAPTION_HEIGHT : 0);
+}
+
+/** Cards in back-to-front paint order (last entry is on top). */
+export function imageStackCards(count: number, fanned = false): ImageStackCard[] {
+  "worklet";
+  if (count <= 0) return [];
+  if (count === 1) return [{ index: 0, rotation: 0, offset: { width: 0, height: 0 }, zIndex: 0 }];
+  if (fanned) {
+    const n = Math.min(count, MAX_FANNED);
+    const mid = (n - 1) / 2;
+    return Array.from({ length: n }, (_, i) => n - 1 - i).map((i) => {
+      const d = i - mid;
+      return {
+        index: i,
+        rotation: d * 8,
+        offset: { width: d * FAN_SPACING, height: Math.abs(d) * 6 },
+        zIndex: n - i,
+      };
+    });
+  }
+  const n = Math.min(count, MAX_STACKED);
+  const rotations = [0, 7, -6];
+  const offsets = [
+    { width: 0, height: 0 },
+    { width: 14, height: 2 },
+    { width: -14, height: 4 },
+  ];
+  return Array.from({ length: n }, (_, i) => n - 1 - i).map((i) => ({
+    index: i,
+    rotation: rotations[i]!,
+    offset: offsets[i]!,
+    zIndex: n - i,
+  }));
+}
+
+/** Hit-test in the stack's box (origin at the top-left). Stacked rest always returns 0. */
+export function imageStackHitIndex(at: Point, count: number, fanned: boolean): number {
+  "worklet";
+  if (!fanned || count <= 1) return 0;
+  const box = imageStackSize(count);
+  const cards = imageStackCards(count, true)
+    .slice()
+    .sort((a, b) => b.zIndex - a.zIndex);
+  for (const card of cards) {
+    const cx = box.width / 2 + card.offset.width;
+    const cy = box.height / 2 + card.offset.height;
+    if (Math.abs(at.x - cx) <= CARD_WIDTH / 2 && Math.abs(at.y - cy) <= CARD_HEIGHT / 2) {
+      return card.index;
+    }
+  }
+  return 0;
+}
+
+/** Finger x (origin at the top-left of the box) maps to the nearest visible fanned card. */
+export function imageStackFocusedIndex(atX: number, count: number): number {
+  "worklet";
+  const n = Math.min(Math.max(count, 1), MAX_FANNED);
+  if (n <= 1) return 0;
+  const mid = imageStackSize(count).width / 2;
+  let best = 0;
+  let bestDist = Number.POSITIVE_INFINITY;
+  for (let i = 0; i < n; i++) {
+    const d = i - (n - 1) / 2;
+    const cx = mid + d * FAN_SPACING;
+    const dist = Math.abs(atX - cx);
+    if (dist < bestDist) {
+      bestDist = dist;
+      best = i;
+    }
+  }
+  return best;
+}
+
+/** The card under the finger grows; its neighbours rest a little smaller. */
+export function imageStackScale(index: number, focused: number, fanned: boolean): number {
+  "worklet";
+  if (!fanned) return 1;
+  return index === focused ? HIGHLIGHT_SCALE : REST_SCALE;
+}
+
+/** Whether a release opens the focused image, or only settles the fan. */
+export function imageStackShouldOpenOnRelease(translation: number): boolean {
+  "worklet";
+  return Math.abs(translation) >= SCRUB_THRESHOLD;
+}
+
+export const ImageStackLayout = {
+  singleSize: SINGLE_SIZE,
+  cardSize: CARD_SIZE,
+  cornerRadius: CORNER_RADIUS,
+  maxStacked: MAX_STACKED,
+  maxFanned: MAX_FANNED,
+  captionHeight: CAPTION_HEIGHT,
+  captionSpacing: CAPTION_SPACING,
+  stackInset: STACK_INSET,
+  fanSpacing: FAN_SPACING,
+  scrubThreshold: SCRUB_THRESHOLD,
+  highlightScale: HIGHLIGHT_SCALE,
+  restScale: REST_SCALE,
+  longPressMs: LONG_PRESS_MS,
+
+  isStack: imageStackIsStack,
+  caption: imageStackCaption,
+  stackSize: imageStackSize,
+  cardSizeFor: imageStackCardSize,
+  height: imageStackHeight,
+  cards: imageStackCards,
+  hitIndex: imageStackHitIndex,
+  focusedIndex: imageStackFocusedIndex,
+  scale: imageStackScale,
+  shouldOpenOnRelease: imageStackShouldOpenOnRelease,
+} as const;
+
+export const ComposerAttachLayout = {
+  thumbSize: { width: 140, height: 140 } as Size,
+  thumbCorner: 18,
+  composerCorner: 22,
+  thumbSpacing: 10,
+  closeOverhang: 10,
+  textMinHeight: 44,
+  get stripHeight(): number {
+    return ComposerAttachLayout.thumbSize.height + ComposerAttachLayout.closeOverhang;
+  },
+  composerMinHeight(attachmentCount: number): number {
+    if (attachmentCount <= 0) return ComposerAttachLayout.textMinHeight;
+    return ComposerAttachLayout.stripHeight + 8 + ComposerAttachLayout.textMinHeight;
+  },
+  textHeight(composerHeight: number, attachmentCount: number): number {
+    if (attachmentCount <= 0) return Math.max(ComposerAttachLayout.textMinHeight, composerHeight);
+    return Math.max(
+      ComposerAttachLayout.textMinHeight,
+      composerHeight - ComposerAttachLayout.stripHeight - 8,
+    );
+  },
+} as const;
+
+export const ImageViewerIndex = {
+  clamp(index: number, count: number): number {
+    return Math.max(0, Math.min(index, Math.max(count - 1, 0)));
+  },
+  showsStrip(count: number): boolean {
+    return count > 1;
+  },
+} as const;
+
+/**
+ * The gallery in the order the thumbnail strip should fetch it: the picture on screen first,
+ * then its neighbours outward on both sides, so the boxes beside the current one fill first and
+ * a strip never opens onto a row of grey tiles. Duplicates keep their first place.
+ */
+export function galleryNeighbourOrder<T extends { artifactId: string }>(
+  gallery: readonly T[],
+  current: number,
+): T[] {
+  const start = ImageViewerIndex.clamp(current, gallery.length);
+  const order: T[] = [];
+  const seen = new Set<string>();
+  const take = (at: number) => {
+    const item = gallery[at];
+    if (!item || seen.has(item.artifactId)) return;
+    seen.add(item.artifactId);
+    order.push(item);
+  };
+  take(start);
+  for (let step = 1; step < gallery.length; step += 1) {
+    take(start - step);
+    take(start + step);
+  }
+  return order;
+}
+
+/** Default send policy: long edge 1600, JPEG; HEIC always becomes JPEG. Keep-original skips resize only. */
+export const ImageSendPolicy = {
+  keepOriginalKey: "imageSend.keepOriginal",
+  maxSide: 1600,
+  compressQuality: 0.7,
+  keepOriginalQuality: 0.92,
+
+  targetSize(size: Size, keepOriginal: boolean): Size {
+    if (keepOriginal || size.width <= 0 || size.height <= 0) return { ...size };
+    const scale = Math.min(1, ImageSendPolicy.maxSide / Math.max(size.width, size.height));
+    return {
+      width: Math.round(size.width * scale),
+      height: Math.round(size.height * scale),
+    };
+  },
+
+  needsHeicConversion(name: string, mimeType: string | null | undefined): boolean {
+    const ext = name.split(".").pop()?.toLowerCase() ?? "";
+    const mime = (mimeType ?? "").toLowerCase();
+    return ext === "heic" || ext === "heif" || mime === "image/heic" || mime === "image/heif";
+  },
+} as const;
