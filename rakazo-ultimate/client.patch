diff --git a/scripts/render-openminis-port.ts b/scripts/render-openminis-port.ts
new file mode 100644
index 000000000..8e8a0cbab
--- /dev/null
+++ b/scripts/render-openminis-port.ts
@@ -0,0 +1,216 @@
+import { writeFileSync, mkdirSync } from "node:fs";
+import { dirname } from "node:path";
+import {
+  OPENMINIS_ROLE_ROWS,
+  OPENMINIS_SHAPE_COUNT,
+  OPENMINIS_SHAPE_NAMES,
+  openminisHashedSpec,
+  openminisHex,
+  openminisSvg,
+  type OpenMinisMood,
+} from "../packages/core/src/openminis-avatar.ts";
+
+const OUT = process.env.OPENMINIS_PORT_OUT ?? "/workspace/rakazo-review/avatars/openminis-port";
+
+function svgToData(svg: string): string {
+  return `data:image/svg+xml;utf8,${encodeURIComponent(svg)}`;
+}
+
+function tile(
+  spec: { shape: number; color: number; role?: (typeof OPENMINIS_ROLE_ROWS)[number]["role"] | "custom" },
+  size: number,
+  dark: boolean,
+  mood: OpenMinisMood = "calm",
+  eyeOpen = 1,
+): string {
+  return openminisSvg(spec, { size, dark, mood, eyeOpen, showsFace: true });
+}
+
+function panel(opts: {
+  title: string;
+  dark: boolean;
+  size: number;
+  labelSize?: number;
+  rows: { label: string; shape: number; color: number; role?: (typeof OPENMINIS_ROLE_ROWS)[number]["role"] | "custom"; mood?: OpenMinisMood; eyeOpen?: number }[];
+  tileGap?: number;
+}): string {
+  const { title, dark, size, rows } = opts;
+  const gap = opts.tileGap ?? 16;
+  const labelH = 22;
+  const pad = 24;
+  const cols = rows.length;
+  const width = pad * 2 + cols * size + (cols - 1) * gap;
+  const height = pad * 2 + 36 + size + labelH + 8;
+  const bg = dark ? "#1C1C1E" : "#F4F1EA";
+  const fg = dark ? "#F2F2F7" : "#1C1C1E";
+  const muted = dark ? "#A1A1AA" : "#5C5C57";
+  const items = rows
+    .map((row, i) => {
+      const x = pad + i * (size + gap);
+      const y = pad + 36;
+      const svg = tile(row, size, dark, row.mood ?? "calm", row.eyeOpen ?? 1);
+      // inline the inner svg in a group translated
+      const inner = svg.replace(/^<svg[^>]*>/, "").replace(/<\/svg>$/, "");
+      return `<g transform="translate(${x} ${y})">
+        <svg width="${size}" height="${size}" viewBox="-0.08 -0.08 1.16 1.16" overflow="visible">${inner}</svg>
+        <text x="${size / 2}" y="${size + 16}" fill="${muted}" font-size="11" font-family="Noto Sans CJK SC, Noto Sans CJK, sans-serif" text-anchor="middle">${escapeXml(row.label)}</text>
+      </g>`;
+    })
+    .join("");
+  return `<svg xmlns="http://www.w3.org/2000/svg" width="${width}" height="${height}" viewBox="0 0 ${width} ${height}">
+    <rect width="${width}" height="${height}" fill="${bg}"/>
+    <text x="${pad}" y="${pad + 16}" fill="${fg}" font-size="16" font-weight="600" font-family="Noto Sans CJK SC, Noto Sans CJK, sans-serif">${escapeXml(title)}</text>
+    ${items}
+  </svg>`;
+}
+
+function escapeXml(s: string): string {
+  return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
+}
+
+const roles = OPENMINIS_ROLE_ROWS.map((row) => ({
+  label: `${row.role}  ${row.name}`,
+  name: row.name,
+  key: row.role,
+  role: row.role,
+  shape: row.shape,
+  color: row.color,
+}));
+
+mkdirSync(OUT, { recursive: true });
+
+const sheets: Record<string, string> = {
+  "home-list-light.svg": panel({
+    title: "Home list · 50 pt · light",
+    dark: false,
+    size: 50,
+    rows: roles.map((row) => ({ ...row, label: row.name })),
+  }),
+  "home-list-dark.svg": panel({
+    title: "Home list · 50 pt · dark",
+    dark: true,
+    size: 50,
+    rows: roles.map((row) => ({ ...row, label: row.name })),
+  }),
+  "chat-header-light.svg": panel({
+    title: "Chat header · 28 pt · light",
+    dark: false,
+    size: 28,
+    rows: roles.map((row) => ({ ...row, label: row.key })),
+  }),
+  "chat-header-dark.svg": panel({
+    title: "Chat header · 28 pt · dark",
+    dark: true,
+    size: 28,
+    rows: roles.map((row) => ({ ...row, label: row.key })),
+  }),
+  "home-hero-light.svg": panel({
+    title: "Home hero · 136 pt · light",
+    dark: false,
+    size: 136,
+    rows: roles.slice(0, 6),
+  }),
+  "home-hero-dark.svg": panel({
+    title: "Home hero · 136 pt · dark",
+    dark: true,
+    size: 136,
+    rows: roles.slice(0, 6),
+  }),
+  "home-hero-light-rest.svg": panel({
+    title: "Home hero · 136 pt · light (rest)",
+    dark: false,
+    size: 136,
+    rows: roles.slice(6),
+  }),
+  "home-hero-dark-rest.svg": panel({
+    title: "Home hero · 136 pt · dark (rest)",
+    dark: true,
+    size: 136,
+    rows: roles.slice(6),
+  }),
+};
+
+// Moods + blink for the chief
+const chief = { shape: 0, color: 10, role: "chief" as const };
+const moods: OpenMinisMood[] = ["calm", "focused", "curious", "happy", "frown", "dozing", "shy"];
+sheets["moods-light.svg"] = panel({
+  title: "Chief moods + blink · light",
+  dark: false,
+  size: 80,
+  rows: [
+    ...moods.map((mood) => ({ label: mood, ...chief, mood })),
+    { label: "blink", ...chief, mood: "calm" as const, eyeOpen: 0.1 },
+  ],
+});
+sheets["moods-dark.svg"] = panel({
+  title: "Chief moods + blink · dark",
+  dark: true,
+  size: 80,
+  rows: [
+    ...moods.map((mood) => ({ label: mood, ...chief, mood })),
+    { label: "blink", ...chief, mood: "calm" as const, eyeOpen: 0.1 },
+  ],
+});
+
+const shapes = Array.from({ length: OPENMINIS_SHAPE_COUNT }, (_, shape) => ({
+  label: `${shape} ${OPENMINIS_SHAPE_NAMES[shape]}`,
+  shape,
+  color: 10,
+}));
+sheets["shapes-indigo.svg"] = panel({
+  title: "All 13 shapes in indigo · 64 pt",
+  dark: false,
+  size: 64,
+  rows: shapes,
+});
+
+for (const [name, svg] of Object.entries(sheets)) {
+  writeFileSync(`${OUT}/${name}`, svg);
+  console.log("wrote", name);
+}
+
+// Also write a combined master SVG that stacks the important sheets.
+const listL = sheets["home-list-light.svg"]!;
+const listD = sheets["home-list-dark.svg"]!;
+const headL = sheets["chat-header-light.svg"]!;
+const headD = sheets["chat-header-dark.svg"]!;
+const heroL = sheets["home-hero-light.svg"]!;
+const heroD = sheets["home-hero-dark.svg"]!;
+const heroL2 = sheets["home-hero-light-rest.svg"]!;
+const heroD2 = sheets["home-hero-dark-rest.svg"]!;
+
+function svgSize(svg: string): { w: number; h: number } {
+  const m = svg.match(/width="(\d+(?:\.\d+)?)" height="(\d+(?:\.\d+)?)"/);
+  if (!m) throw new Error("no size");
+  return { w: Number(m[1]), h: Number(m[2]) };
+}
+
+const parts = [listL, listD, headL, headD, heroL, heroL2, heroD, heroD2, sheets["moods-light.svg"]!, sheets["moods-dark.svg"]!, sheets["shapes-indigo.svg"]!];
+let y = 0;
+const width = Math.max(...parts.map((p) => svgSize(p).w));
+const stacked = parts.map((svg) => {
+  const { h } = svgSize(svg);
+  const inner = svg.replace(/^<svg[^>]*>/, "").replace(/<\/svg>$/, "");
+  const group = `<g transform="translate(0 ${y})">${inner}</g>`;
+  y += h;
+  return group;
+});
+const master = `<svg xmlns="http://www.w3.org/2000/svg" width="${width}" height="${y}" viewBox="0 0 ${width} ${y}">
+  <rect width="${width}" height="${y}" fill="#D8D2C8"/>
+  ${stacked.join("\n")}
+</svg>`;
+writeFileSync(`${OUT}/sheet.svg`, master);
+console.log("wrote sheet.svg", width, "x", y);
+
+// Standalone main-bot home hero (136 pt), used for the screenshot comparison.
+for (const dark of [true, false]) {
+  const name = dark ? "chief-hero-dark.svg" : "chief-hero-light.svg";
+  const svg = openminisSvg(chief, { size: 136, dark, mood: "calm", eyeOpen: 1, showsFace: true });
+  writeFileSync(`${OUT}/${name}`, svg);
+  console.log("wrote", name);
+}
+
+// unused import keep hashed available for debugging
+void openminisHashedSpec;
+void svgToData;
+void dirname;
