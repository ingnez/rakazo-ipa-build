+    const release = deferred();
+    const remove = vi.mocked(SecureStore.deleteItemAsync).getMockImplementation()!;
+    vi.mocked(SecureStore.deleteItemAsync).mockImplementation(async (key) => {
+      if (key === "rakazo.last_bot_id") {
