@@ -0,0 +1,55 @@
+import * as Clipboard from "expo-clipboard";
+import { File } from "expo-file-system";
+import { requireOptionalNativeModule } from "expo-modules-core";
+import * as Sharing from "expo-sharing";
+
+type NativeImageActions = {
+  saveToPhotos(uri: string): Promise<boolean>;
+  recognizeText(uri: string): Promise<string>;
+  printImage(uri: string): Promise<boolean>;
+};
+
+const native = requireOptionalNativeModule<NativeImageActions>("MessageImageActions");
+
+export async function saveImageToPhotos(uri: string): Promise<boolean> {
+  if (!native) return false;
+  return native.saveToPhotos(uri);
+}
+
+export async function recognizeImageText(uri: string): Promise<string> {
+  if (!native) return "";
+  return native.recognizeText(uri);
+}
+
+export async function printImage(uri: string): Promise<boolean> {
+  if (!native) return false;
+  return native.printImage(uri);
+}
+
+export async function copyImage(uri: string): Promise<boolean> {
+  try {
+    const contentBase64 = await new File(uri).base64();
+    await Clipboard.setImageAsync(contentBase64);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+export async function shareImageFile(uri: string, mimeType?: string): Promise<void> {
+  const available = await Sharing.isAvailableAsync();
+  if (!available) throw new Error("Sharing is not available");
+  await Sharing.shareAsync(uri, mimeType ? { mimeType, UTI: mimeType } : undefined);
+}
+
+export function imageActionsAvailable(): {
+  save: boolean;
+  recognize: boolean;
+  print: boolean;
+} {
+  return {
+    save: Boolean(native),
+    recognize: Boolean(native),
+    print: Boolean(native),
+  };
+}
