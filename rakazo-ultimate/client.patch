@@ -0,0 +1,188 @@
+import type { LinkPreview } from "@rakazo/contracts";
+import { useEffect, useState } from "react";
+import { rpc } from "./api";
+
+/**
+ * A link a message mentions, drawn as the page's own card. The server reads the page (the phone
+ * cannot reach most of them from here) and hands back the cover already inlined, so this module
+ * is the only place the app asks for one.
+ */
+
+/** The server gives up well inside this; a card that takes longer is not worth the wait. */
+const PREVIEW_TIMEOUT_MS = 20_000;
+const CACHE_TTL_MS = 30 * 60_000;
+const CACHE_MAX = 60;
+
+type Entry = { at: number; value: Promise<LinkPreview | null> };
+const cache = new Map<string, Entry>();
+
+/** Trailing punctuation is prose around a link, never part of it. */
+function trimLink(raw: string): string {
+  let end = raw.length;
+  const pairs: Record<string, string> = { ")": "(", "]": "[", "}": "{", "）": "（" };
+  while (end > 0) {
+    const char = raw[end - 1]!;
+    if (".,;:!?、。，；：！？'\"”’".includes(char)) {
+      end -= 1;
+      continue;
+    }
+    const open = pairs[char];
+    if (open) {
+      const inside = raw.slice(0, end);
+      const opens = inside.split(open).length - 1;
+      const closes = inside.split(char).length - 1;
+      if (closes > opens) {
+        end -= 1;
+        continue;
+      }
+    }
+    break;
+  }
+  return raw.slice(0, end);
+}
+
+/**
+ * The first link in what someone wrote. Fenced and inline code are skipped: a command is not an
+ * address, and drawing a card for one would read as if it were.
+ */
+export function firstMessageLink(text: string | undefined): string | undefined {
+  if (!text) return undefined;
+  const prose = text.replace(/```[\s\S]*?```/g, " ").replace(/`[^`\n]*`/g, " ");
+  const match = /https?:\/\/[^\s<>"'`\u3000]+/i.exec(prose);
+  if (!match) return undefined;
+  const candidate = trimLink(match[0]);
+  try {
+    const url = new URL(candidate);
+    if (!url.hostname.includes(".")) return undefined;
+    return url.toString();
+  } catch {
+    return undefined;
+  }
+}
+
+/** A public Grok Bot share link, the one kind a card can turn into a bot. */
+export function isGrokBotLink(url: string): boolean {
+  try {
+    const parsed = new URL(url);
+    const host = parsed.hostname.toLowerCase();
+    return (
+      (host === "x.ai" || host === "www.x.ai") && /^\/bot\/[A-Za-z0-9_-]+/.test(parsed.pathname)
+    );
+  } catch {
+    return false;
+  }
+}
+
+/**
+ * The picture a link's card can draw: the copy the server inlined first (a phone that cannot reach
+ * the site still shows it), then the page's own address. Nothing else counts — a card with an
+ * empty or unknown-scheme source would be a blank box, so it stays a plain line instead.
+ */
+export function linkPreviewCover(preview: LinkPreview | null | undefined): string | undefined {
+  const inline = preview?.imageDataUrl?.trim();
+  if (inline?.startsWith("data:image/")) return inline;
+  const remote = preview?.imageUrl?.trim();
+  if (remote && /^https?:\/\//i.test(remote)) return remote;
+  return undefined;
+}
+
+/** The host a card names at its foot, without `www.`. */
+export function linkSiteLabel(url: string): string {
+  try {
+    return new URL(url).hostname.replace(/^www\./, "");
+  } catch {
+    return url;
+  }
+}
+
+/**
+ * A link whose page asks the person to do something — sign in, confirm an authorization, fill in a
+ * code — rather than a page to read. These get the one-button card, because the whole point of
+ * them is the tap; any other link is a reference and stays a single line.
+ */
+const FORM_HOSTS = [
+  "accounts.google.com",
+  "login.microsoftonline.com",
+  "login.live.com",
+  "appleid.apple.com",
+];
+/** Path words that only appear on a page waiting on a person: a login, a code, an approval. */
+const FORM_PATH_WORDS = [
+  "login",
+  "log-in",
+  "signin",
+  "sign-in",
+  "sign_in",
+  "oauth",
+  "authorize",
+  "device",
+  "activate",
+  "verify",
+  "verification",
+  "confirm",
+  "2fa",
+  "mfa",
+  "otp",
+  "sms",
+  "auth/",
+];
+
+/** Whether a link is a form or an authorization to continue in, not a page to read. */
+export function isFormLink(url: string): boolean {
+  try {
+    const parsed = new URL(url);
+    const host = parsed.hostname.toLowerCase().replace(/^www\./, "");
+    const path = parsed.pathname.toLowerCase();
+    // A page that says in its own query that it is a code entry or an approval.
+    const query = parsed.search.toLowerCase();
+    if (/[?&](code|otp|verify|verification|token|continue|confirm)=/.test(query)) return true;
+    if (FORM_HOSTS.some((known) => host === known)) return true;
+    return FORM_PATH_WORDS.some((word) => path.includes(word));
+  } catch {
+    return false;
+  }
+}
+
+function startPreview(url: string): Promise<LinkPreview | null> {
+  return rpc("links/preview", { url }, { timeoutMs: PREVIEW_TIMEOUT_MS }).catch(() => null);
+}
+
+export function loadLinkPreview(url: string): Promise<LinkPreview | null> {
+  const now = Date.now();
+  const hit = cache.get(url);
+  if (hit && now - hit.at < CACHE_TTL_MS) return hit.value;
+  const value = startPreview(url);
+  cache.delete(url);
+  cache.set(url, { at: now, value });
+  while (cache.size > CACHE_MAX) {
+    const oldest = cache.keys().next();
+    if (oldest.done) break;
+    cache.delete(oldest.value);
+  }
+  return value;
+}
+
+/** Test seam: forget everything read so far (a new server, or another account). */
+export function forgetLinkPreviews(): void {
+  cache.clear();
+}
+
+/**
+ * `undefined` until the answer arrives, `null` when there is no card to draw. Both are quiet: a
+ * link that cannot be previewed simply stays the link it was.
+ */
+export function useLinkPreview(url: string | undefined): LinkPreview | null | undefined {
+  const [preview, setPreview] = useState<LinkPreview | null | undefined>(undefined);
+  useEffect(() => {
+    setPreview(undefined);
+    if (!url) return;
+    let active = true;
+    void loadLinkPreview(url).then((value) => {
+      if (active) setPreview(value);
+    });
+    return () => {
+      active = false;
+    };
+  }, [url]);
+  return preview;
+}
