+    state.page = { uri: "file:///caches/office-page-thumbnails/abc.png", width: 640, height: 360 };
+    expect(await officeThumbnailPage("file:///caches/art.pptx", 640)).toEqual(state.page);
+    expect(state.calls).toBe(1);
+  });
+
+  it("is nothing at all when the reader draws no page", async () => {
+    state.page = null;
+    expect(await officeThumbnailPage("file:///caches/broken.docx", 640)).toBeNull();
+    // A page without a size cannot be stood on the paper without squashing it.
+    state.page = { uri: "file:///caches/empty.png", width: 0, height: 0 };
+    expect(await officeThumbnailPage("file:///caches/empty.xlsx", 640)).toBeNull();
+  });
+
+  it("passes a reader that fails on to the card, which shows its compact row", async () => {
+    state.page = null;
+    state.error = new Error("unreadable");
+    await expect(officeThumbnailPage("file:///caches/locked.doc", 640)).rejects.toThrow("unreadable");
+    state.error = null;
+  });
+});
diff --git a/apps/mobile/lib/office-thumbnail.ts b/apps/mobile/lib/office-thumbnail.ts
new file mode 100644
index 000000000..8228f916c
--- /dev/null
+++ b/apps/mobile/lib/office-thumbnail.ts
@@ -0,0 +1,45 @@
+/**
+ * An Office document's first page, drawn by the system's own reader.
+ *
+ * A `.docx`, a deck or a workbook has no lines to read: its bytes are a zip of XML, and printing
+ * them on a card is how a chat ends up showing mojibake. Quick Look renders the page instead, and
+ * the card shows that picture; a build made before the function existed — or a document the system
+ * cannot render — answers `null`, and the card keeps the compact row it had.
+ */
+import { optionalNativeModule } from "./optional-native";
+
+export type OfficePageThumbnail = { uri: string; width: number; height: number };
+
+type OfficeThumbnailNative = {
+  officeThumbnail?: (uri: string, maxWidth: number) => Promise<OfficePageThumbnail | null>;
+};
+
+let found: OfficeThumbnailNative | null | undefined;
+
+/** The module, asked for the first time a card has a document to draw, then remembered. */
+function officeModule(): OfficeThumbnailNative | null {
+  if (found !== undefined) return found;
+  found = optionalNativeModule<OfficeThumbnailNative>("RakazoPdfView");
+  return found;
+}
+
+/** Whether this build can draw an Office document's first page on a card. */
+export function officeThumbnailAvailable(): boolean {
+  return typeof officeModule()?.officeThumbnail === "function";
+}
+
+/**
+ * A local `file://` PNG of the document's first page, `maxWidth` points wide, written into the
+ * app's cache by the native side and reused on the next card that asks. The page's own proportions
+ * come back with it, so the card can stand the picture on the paper without squashing it.
+ */
+export async function officeThumbnailPage(
+  uri: string,
+  maxWidth: number,
+): Promise<OfficePageThumbnail | null> {
+  const native = officeModule();
+  if (!native?.officeThumbnail) return null;
+  const page = await native.officeThumbnail(uri, maxWidth);
+  if (!page || !page.uri || !(page.width > 0) || !(page.height > 0)) return null;
+  return page;
+}
diff --git a/apps/mobile/lib/optional-native.ts b/apps/mobile/lib/optional-native.ts
new file mode 100644
index 000000000..5e5ae6aa7
--- /dev/null
+++ b/apps/mobile/lib/optional-native.ts
@@ -0,0 +1,17 @@
+/**
+ * A native module if this build carries it, and nothing if it does not.
+ *
+ * The bridge is asked for lazily, on the first card that needs it: loading `expo-modules-core` pulls
+ * React Native's runtime in behind it, and a card is decoration — a test or a tool that lays one out
+ * without a phone must not fail on the bridge, and an older build simply answers `null`.
+ */
+export function optionalNativeModule<T>(name: string): T | null {
+  try {
+    const { requireOptionalNativeModule } = require("expo-modules-core") as typeof import(
+      "expo-modules-core"
+    );
+    return requireOptionalNativeModule<T>(name) ?? null;
+  } catch {
+    return null;
+  }
+}
