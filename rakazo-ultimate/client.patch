+/**
+ * Watches the app's state for the return from the background. iOS reports background → inactive →
+ * active on the way back, so the return is remembered as "was away" rather than read off the state
+ * just before; a drop to inactive alone (the app switcher, a control-centre pull) is not away.
+ */
+export function createResumeTracker(initial: string | null | undefined): {
+  next(state: string | null | undefined): boolean;
+} {
+  let away = initial === "background";
+  return {
+    next(state) {
+      if (state === "background") {
+        away = true;
+        return false;
+      }
+      if (state !== "active" || !away) return false;
+      away = false;
+      return true;
