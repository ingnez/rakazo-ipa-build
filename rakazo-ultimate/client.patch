+  { name: "小说写手", color: "#B0415A", emblem: "e341", role: "member" },
+  { name: "PPT大师", color: "#FF8A5B", emblem: "e071", role: "member" },
+  { name: "占卜师", color: "#8E7CFF", emblem: "e381", role: "member" },
+  { name: "生活助理", color: "#F2C48D", emblem: "e201", role: "member" },
+  { name: "刷题教练", color: "#2FBF8F", emblem: "e081", role: "member" },
+  { name: "备忘录", color: "#7FA7C9", emblem: "e409", role: "member" },
+  { name: "运维助理", color: "#3A6DF0", emblem: "e021", role: "member" },
+  { name: "做饭教练", color: "#E8553D", emblem: "e421", role: "member" },
+];
+
+/** The colours the appearance sheet offers, the team's own ten first. */
+export const LUMEN_PALETTE: readonly string[] = [
+  "#D8B878",
+  "#3DD6F5",
+  "#B0415A",
+  "#FF8A5B",
+  "#8E7CFF",
+  "#F2C48D",
+  "#2FBF8F",
+  "#7FA7C9",
+  "#3A6DF0",
+  "#E8553D",
+  "#C9D1DC",
+  "#F4F1EA",
+];
+
+const STORED_SUFFIX = "::lumen_";
+
+/** The value stored in `bots.color` for a Lumen look: the colour, then the emblem it wears. */
+export function lumenLookValue(color: string, emblemId?: string | null): string {
+  return emblemId ? `${color}${STORED_SUFFIX}${emblemId}` : color;
+}
+
+/** The colour and emblem a stored `bots.color` holds, Lumen suffix or not. */
+export function parseLumenLook(raw: string | null | undefined): {
+  color: string | null;
+  emblemId: string | null;
+} {
+  if (!raw) return { color: null, emblemId: null };
+  const at = raw.indexOf(STORED_SUFFIX);
+  if (at < 0) return { color: raw, emblemId: null };
+  return {
+    color: raw.slice(0, at) || null,
+    emblemId: raw.slice(at + STORED_SUFFIX.length) || null,
+  };
+}
+
+/** The stored colour of any bot value, with a Lumen suffix stripped, ready to draw with. */
+export function lumenColorOf(raw: string | null | undefined, fallback = LUMEN_BASE.gold): string {
+  const parsed = parseLumenLook(raw);
+  const color = parsed.color ?? "";
+  return /^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/.test(color) ? color : fallback;
+}
+
+function hash32(text: string): number {
+  let h = 2166136261;
+  for (let i = 0; i < text.length; i += 1) {
+    h ^= text.charCodeAt(i);
+    h = Math.imul(h, 16777619);
+  }
+  return h >>> 0;
+}
+
+/** Two-character pieces of a name, the unit a role word is matched by. */
+function bigrams(text: string): string[] {
+  const out: string[] = [];
+  for (let i = 0; i + 1 < text.length; i += 1) out.push(text.slice(i, i + 2));
+  return out;
+}
+
+/**
+ * The emblem a bot's name earns. A role word the designer wrote into an emblem's own description
+ * ("开发助理、编程、写脚本") is the strongest signal; the name itself, or a word inside it, is the
+ * next; failing everything, the name's first character is drawn as the mark.
+ */
+export function lumenEmblemForName(name: string | null | undefined): LumenEmblem | null {
+  const text = (name ?? "").trim().toLowerCase();
+  if (!text) return null;
+  const pieces = bigrams(text);
+  let best: LumenEmblem | null = null;
+  let bestScore = 0;
+  for (const emblem of LUMEN_EMBLEMS) {
+    const own = emblem.name.toLowerCase();
+    const use = `${emblem.use} ${emblem.catName} ${emblem.key}`.toLowerCase();
+    let score = 0;
+    if (own === text) score += 1000;
+    if (use.includes(text)) score += 400 + text.length * 12;
+    else if (own.length >= 2 && text.includes(own)) score += 260 + own.length * 10;
+    for (const piece of pieces) {
+      if (own.includes(piece)) score += 14;
+      if (use.includes(piece)) score += 9;
+    }
+    if (score > bestScore) {
+      best = emblem;
+      bestScore = score;
+    }
+  }
+  return bestScore >= LUMEN_MATCH_MIN ? best : null;
+}
+
+/** A bot with no name still gets one stable mark rather than a new one on every render. */
+function emblemByIdentity(identity: string): LumenEmblem | null {
+  if (!identity) return null;
+  return LUMEN_EMBLEMS[hash32(identity) % LUMEN_EMBLEMS.length] ?? null;
+}
+
+export type LumenLook = {
+  color: string;
+  role: LumenRole;
+  emblem: LumenEmblem | null;
+  /** Shown instead of an emblem: the first character of a name no mark matches. */
+  initial: string | null;
+  /** Where the mark came from, for the picker's caption. */
+  source: "chief" | "preset" | "stored" | "name" | "identity" | "initial";
+};
+
+/**
+ * What a bot wears. The stored value wins (colour, and an emblem the person picked); a bot that
+ * never picked one is matched by its name, then by its id, then by its name's first character.
+ */
+export function lumenLookFor(input: {
+  name?: string | null;
+  identity?: string | null;
+  value?: string | null;
+  chief?: boolean;
+}): LumenLook {
+  const stored = parseLumenLook(input.value);
+  const preset = LUMEN_TEAM.find(
+    (entry) => entry.name === (input.name ?? "").trim() && entry.emblem !== null,
+  );
+  const chiefPreset = LUMEN_TEAM[0]!;
+  const role: LumenRole = input.chief
+    ? "chief"
+    : (input.name ?? "").trim() === chiefPreset.name
+      ? "chief"
+      : "member";
+  const isHex = (value: string | null | undefined): value is string =>
+    typeof value === "string" && /^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/.test(value);
+  const color = isHex(stored.color)
+    ? stored.color
+    : preset
+      ? preset.color
+      : isHex(parseLumenLook(input.value).color)
+        ? (parseLumenLook(input.value).color as string)
+        : lumenColorForIdentity(input.identity ?? input.name ?? "");
+
+  if (role === "chief") {
+    return { color, role, emblem: null, initial: null, source: "chief" };
+  }
+  if (stored.emblemId) {
+    const storedEmblem = LUMEN_EMBLEM_BY_ID.get(stored.emblemId);
+    if (storedEmblem) return { color, role, emblem: storedEmblem, initial: null, source: "stored" };
+  }
+  if (preset?.emblem) {
+    const teamEmblem = LUMEN_EMBLEM_BY_ID.get(preset.emblem);
+    if (teamEmblem) return { color, role, emblem: teamEmblem, initial: null, source: "preset" };
+  }
+  const named = lumenEmblemForName(input.name);
+  if (named) return { color, role, emblem: named, initial: null, source: "name" };
+  const fallback = emblemByIdentity(input.identity ?? "");
+  if (fallback) return { color, role, emblem: fallback, initial: null, source: "identity" };
+  const first = [...(input.name ?? "").trim()][0] ?? null;
+  if (!first) {
+    // A bot with neither a name nor an id is a placeholder the person is still creating: it gets
+    // the library's own "AI 星芒" rather than a question mark, and the same mark every render.
+    return { color, role, emblem: LUMEN_EMBLEM_BY_ID.get("e012") ?? null, initial: null, source: "identity" };
+  }
+  return { color, role, emblem: null, initial: first, source: "initial" };
+}
+
+/** A role word matched by the emblem scores well above an accidental two-character overlap. */
+/**
+ * What a name has to earn to own a mark: one two-character word the emblems actually mention.
+ * Below this the name is drawn as its first character instead, as the library's own fallback says.
+ */
+export const LUMEN_MATCH_MIN = 9;
+
+/** A colour for a bot that never had one: stable per id, from the system palette. */
+export function lumenColorForIdentity(identity: string): string {
+  if (!identity) return LUMEN_BASE.gold;
+  return LUMEN_PALETTE[hash32(identity) % LUMEN_PALETTE.length] ?? LUMEN_BASE.gold;
+}
+
+/** The emblem's stroke colour: lifted off the bot's colour, pressed down on the light page. */
+export function lumenEmblemInk(color: string, dark: boolean): string {
+  return dark ? lumenMix(color, "#FFFFFF", 0.25) : lumenMix(color, "#1E232B", 0.35);
+}
+
+/** The ink of a state, for a body drawn with it. */
+export function lumenStateColor(action: LumenAction, color: string, t = 0): string {
+  "worklet";
+  if (action === "idle") return color;
+  return lumenFrame(action, t, color).c;
+}
