+/**
+ * 记忆与总结: the stage diaries this chat was written up into, what the daily review proposed and
+ * kept, and the notes this Bot holds.
+ */
+function MemoryColumn({ botId, botName }: { botId: string; botName: string }) {
+  const tokens = useMobileTokens();
+  const router = useRouter();
+  const diaryRead = rpcQuery("memory/diaries", { botId, limit: 20 });
+  const diaries = useQuery(diaryRead, queryClient);
+  const pendingRead = rpcQuery("memory/learnings", { botId, status: "pending", limit: 50 });
+  const pending = useQuery(pendingRead, queryClient);
+  const approvedRead = rpcQuery("memory/learnings", { botId, status: "approved", limit: 50 });
+  const approved = useQuery(approvedRead, queryClient);
+  const notesRead = rpcQuery("memory/list", { botId, scope: "bot" });
+  const notes = useQuery(notesRead, queryClient);
+  const [deciding, setDeciding] = useState<string | null>(null);
+  const [decideError, setDecideError] = useState<string | null>(null);
+  const [opened, setOpened] = useState<MemoryLearning | null>(null);
+  const [openedDiary, setOpenedDiary] = useState<DiarySummary | null>(null);
+  // The list carries no bodies: the one that is open reads its own, in full.
+  const diaryBodyRead = rpcQuery("memory/diary", { diaryId: openedDiary?.id ?? "" });
+  const diaryBody = useQuery({ ...diaryBodyRead, enabled: Boolean(openedDiary?.id) }, queryClient);
+
+  const decide = useCallback(
+    async (learning: MemoryLearning, status: "approved" | "rejected") => {
+      if (deciding) return;
+      setDeciding(learning.id);
+      setDecideError(null);
+      try {
+        await rpc("memory/decideLearning", { learningId: learning.id, status });
+        hapticSuccess();
+        await Promise.all([
+          queryClient.invalidateQueries({ queryKey: pendingRead.queryKey }),
+          queryClient.invalidateQueries({ queryKey: approvedRead.queryKey }),
+          queryClient.invalidateQueries({ queryKey: notesRead.queryKey }),
+        ]);
+        setOpened(null);
+      } catch (reason) {
+        hapticError();
+        setDecideError(errorText(reason, "没能存下这个决定"));
+      } finally {
+        setDeciding(null);
+      }
+    },
+    [approvedRead.queryKey, deciding, notesRead.queryKey, pendingRead.queryKey],
+  );
+
+  const waiting = pending.data ?? [];
+  const written = diaries.data ?? [];
+  const kept = useMemo(() => approved.data ?? [], [approved.data]);
+  // Kept rules read as the day's reviews: one card per day the review wrote them on.
+  const byDay = useMemo(() => {
+    const days = new Map<string, MemoryLearning[]>();
+    for (const learning of kept) {
+      const day = learning.sourceDate ?? "更早";
+      days.set(day, [...(days.get(day) ?? []), learning]);
+    }
+    return [...days.entries()].sort(([a], [b]) => b.localeCompare(a));
+  }, [kept]);
+
+  return (
+    <View style={{ gap: 14 }}>
+      {written.length > 0 ? (
+        <View style={{ gap: 8 }}>
+          <Text style={[styles.sectionLabel, { color: native.secondaryLabel }]}>阶段日记</Text>
+          {written.map((diary) => (
+            <DiaryCard
+              key={diary.id}
+              diary={diary}
+              body={openedDiary?.id === diary.id ? diaryBody.data?.body : undefined}
+              opened={openedDiary?.id === diary.id}
+              onOpen={() => {
+                hapticSelection();
+                setOpenedDiary(openedDiary?.id === diary.id ? null : diary);
+              }}
+              onJump={() =>
+                router.push({
+                  pathname: "/thread",
+                  params: {
+                    botId,
+                    name: botName,
+                    // The diary names the message the stretch starts at; an older row that did
+                    // not keep the id still names its place in the chat by seq.
+                    ...(diary.startMessageId
+                      ? { messageId: diary.startMessageId }
+                      : { seq: String(diary.startSeq) }),
+                  },
+                })
+              }
+            />
+          ))}
+        </View>
+      ) : null}
+
+      {waiting.length > 0 ? (
+        <View style={{ gap: 8 }}>
+          <Text style={[styles.sectionLabel, { color: native.secondaryLabel }]}>等你审核</Text>
+          {waiting.map((learning) => (
+            <View
+              key={learning.id}
+              style={[styles.card, styles.stack, { backgroundColor: native.groupedCell }]}
+            >
+              <Text
+                numberOfLines={opened?.id === learning.id ? undefined : 3}
+                style={[styles.learningText, { color: native.label }]}
+              >
+                {learning.text}
+              </Text>
+              <View style={styles.actions}>
+                <Pressable
+                  accessibilityRole="button"
+                  accessibilityLabel="通过这条记忆"
+                  disabled={Boolean(deciding)}
+                  onPress={() => void decide(learning, "approved")}
+                  style={({ pressed }) => [
+                    styles.approve,
+                    { backgroundColor: pressed ? native.fillPressed : native.fill },
+                  ]}
+                >
+                  <Text style={[styles.approveText, { color: tokens.foreground }]}>
+                    {deciding === learning.id ? "保存中…" : "通过"}
+                  </Text>
+                </Pressable>
+                <Pressable
+                  accessibilityRole="button"
+                  accessibilityLabel="丢弃这条记忆"
+                  disabled={Boolean(deciding)}
+                  onPress={() => void decide(learning, "rejected")}
+                  style={({ pressed }) => [
+                    styles.reject,
+                    { backgroundColor: pressed ? native.fillPressed : native.fill },
+                  ]}
+                >
+                  <Text style={[styles.rejectText, { color: tokens.destructive }]}>丢弃</Text>
+                </Pressable>
+              </View>
+            </View>
+          ))}
+        </View>
+      ) : null}
+
+      {byDay.length > 0 ? (
+        <View style={{ gap: 8 }}>
+          <Text style={[styles.sectionLabel, { color: native.secondaryLabel }]}>复盘记住的</Text>
+          {byDay.map(([day, learnings]) => (
+            <View key={day} style={{ gap: 6 }}>
+              <Text style={[styles.dayLabel, { color: native.tertiaryLabel }]}>
+                {day === "更早" ? "更早" : `复盘 ${day}`} · {learnings.length} 条
+              </Text>
+              {learnings.map((learning) => (
+                <Pressable
+                  key={learning.id}
+                  accessibilityRole="button"
+                  onPress={() => {
+                    hapticSelection();
+                    setOpened(opened?.id === learning.id ? null : learning);
+                  }}
+                  style={({ pressed }) => [
+                    styles.card,
+                    { backgroundColor: native.groupedCell, opacity: pressed ? 0.7 : 1 },
+                  ]}
+                >
+                  <Text
+                    numberOfLines={opened?.id === learning.id ? undefined : 2}
+                    style={[styles.learningText, { color: native.label }]}
+                  >
+                    {learning.text}
+                  </Text>
+                </Pressable>
+              ))}
+            </View>
+          ))}
+        </View>
+      ) : null}
+
+      {opened ? (
+        <View style={styles.actions}>
+          <Pressable
+            accessibilityRole="button"
+            onPress={() => void decide(opened, "rejected")}
+            style={({ pressed }) => [
+              styles.reject,
+              { backgroundColor: pressed ? native.fillPressed : native.fill },
