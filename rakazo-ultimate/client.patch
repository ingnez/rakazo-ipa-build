@@ -0,0 +1,198 @@
+import { readFileSync } from "node:fs";
+import { describe, expect, it } from "vitest";
+import {
+  ComposerAttachLayout,
+  ImageSendPolicy,
+  ImageStackLayout,
+  ImageViewerIndex,
+  imageStackCaption,
+  imageStackCardSize,
+  imageStackCards,
+  imageStackFocusedIndex,
+  imageStackHeight,
+  imageStackHitIndex,
+  imageStackScale,
+  imageStackShouldOpenOnRelease,
+  imageStackSize,
+} from "./image-stack-layout.js";
+
+describe("ImageStackLayout", () => {
+  it("draws nothing for 0 images and one unrotated card for 1", () => {
+    expect(ImageStackLayout.cards(0)).toEqual([]);
+    const one = ImageStackLayout.cards(1);
+    expect(one).toHaveLength(1);
+    expect(one[0]).toMatchObject({ rotation: 0, offset: { width: 0, height: 0 } });
+    expect(ImageStackLayout.caption(1)).toBeNull();
+    expect(ImageStackLayout.isStack(1)).toBe(false);
+  });
+
+  it("stacks two cards and captions them, and caps nine at 3 visible cards", () => {
+    expect(ImageStackLayout.cards(2)).toHaveLength(2);
+    expect(ImageStackLayout.caption(2)).toBe("2 张图片");
+    const nine = ImageStackLayout.cards(9);
+    expect(nine).toHaveLength(3);
+    expect(ImageStackLayout.caption(9)).toBe("9 张图片");
+    expect(nine.at(-1)).toMatchObject({ index: 0, rotation: 0 });
+    expect(nine.map((card) => card.index)).toEqual([2, 1, 0]);
+    expect(new Set(nine.map((card) => card.zIndex)).size).toBe(3);
+    expect(nine.at(-1)!.zIndex).toBeGreaterThan(nine[0]!.zIndex);
+    expect(nine.slice(0, -1).every((card) => card.rotation !== 0)).toBe(true);
+  });
+
+  it("fans at most 5 cards, left to right, symmetric", () => {
+    const fan = ImageStackLayout.cards(9, true);
+    expect(fan).toHaveLength(ImageStackLayout.maxFanned);
+    const xs = fan
+      .slice()
+      .sort((a, b) => a.index - b.index)
+      .map((card) => card.offset.width);
+    expect(xs.every((x, i) => i === 0 || xs[i - 1]! < x)).toBe(true);
+    expect(Math.abs(xs[0]! + xs.at(-1)!)).toBeLessThan(0.001);
+    expect(ImageStackLayout.cards(1, true)).toHaveLength(1);
+  });
+
+  it("computes stack size and row height the way the chat estimates a row", () => {
+    expect(ImageStackLayout.height(0)).toBe(0);
+    expect(ImageStackLayout.height(1)).toBe(ImageStackLayout.singleSize.height);
+    const h3 = ImageStackLayout.height(3);
+    expect(h3).toBe(
+      ImageStackLayout.cardSize.height +
+        2 * ImageStackLayout.stackInset.height +
+        ImageStackLayout.captionSpacing +
+        ImageStackLayout.captionHeight,
+    );
+    expect(ImageStackLayout.height(2)).toBe(ImageStackLayout.height(20));
+    expect(ImageStackLayout.stackSize(4).width).toBeGreaterThanOrEqual(
+      ImageStackLayout.cardSize.width + 28,
+    );
+  });
+
+  it("hit-tests the top card when fanned and always the first card when stacked", () => {
+    const box = ImageStackLayout.stackSize(3);
+    expect(ImageStackLayout.hitIndex({ x: box.width / 2, y: box.height / 2 }, 3, false)).toBe(0);
+    const fan3 = ImageStackLayout.cards(3, true);
+    const cx = box.width / 2;
+    const cy = box.height / 2;
+    const topCard = fan3.reduce((best, card) => (card.zIndex > best.zIndex ? card : best));
+    expect(
+      ImageStackLayout.hitIndex(
+        { x: cx + topCard.offset.width, y: cy + topCard.offset.height },
+        3,
+        true,
+      ),
+    ).toBe(topCard.index);
+    const left = fan3.reduce((best, card) => (card.offset.width < best.offset.width ? card : best));
+    const half = ImageStackLayout.cardSize.width / 2;
+    expect(
+      ImageStackLayout.hitIndex(
+        { x: cx + left.offset.width - half + 4, y: cy + left.offset.height },
+        3,
+        true,
+      ),
+    ).toBe(left.index);
+    expect(ImageStackLayout.hitIndex({ x: -500, y: -500 }, 3, true)).toBe(0);
+  });
+
+  it("follows a horizontal scrub and opens only after the threshold", () => {
+    const midX = ImageStackLayout.stackSize(3).width / 2;
+    expect(ImageStackLayout.focusedIndex(midX, 3)).toBe(1);
+    expect(ImageStackLayout.focusedIndex(midX - ImageStackLayout.fanSpacing, 3)).toBe(0);
+    expect(ImageStackLayout.focusedIndex(midX + ImageStackLayout.fanSpacing, 3)).toBe(2);
+    expect(ImageStackLayout.focusedIndex(midX, 1)).toBe(0);
+    expect(ImageStackLayout.scale(2, 2, true)).toBe(ImageStackLayout.highlightScale);
+    expect(ImageStackLayout.scale(0, 2, true)).toBe(ImageStackLayout.restScale);
+    expect(ImageStackLayout.scale(2, 2, false)).toBe(1);
+    expect(ImageStackLayout.shouldOpenOnRelease(ImageStackLayout.scrubThreshold)).toBe(true);
+    expect(ImageStackLayout.shouldOpenOnRelease(ImageStackLayout.scrubThreshold + 30)).toBe(true);
+    expect(ImageStackLayout.shouldOpenOnRelease(4)).toBe(false);
+    expect(ImageStackLayout.shouldOpenOnRelease(-4)).toBe(false);
+  });
+});
+
+describe("ImageStackLayout's own source", () => {
+  // The shipped build rewrites these functions to run on the UI thread, and a method written
+  // inside the object literal could not see the object it belongs to: v27 crashed on its first
+  // image card with "Cannot read property 'singleSize' of undefined". The literal must stay a
+  // plain table of constants and module-level functions.
+  const source = readFileSync(new URL("./image-stack-layout.ts", import.meta.url), "utf8");
+  const start = source.indexOf("export const ImageStackLayout = {");
+  const end = source.indexOf("} as const;", start);
+  const literal = source.slice(start, end);
+
+  it("keeps the object literal a table, not a place where functions live", () => {
+    expect(start).toBeGreaterThan(-1);
+    expect(end).toBeGreaterThan(start);
+    expect(literal).not.toContain("'worklet'");
+    expect(literal).not.toContain("ImageStackLayout.");
+  });
+
+  it("reads its geometry from module-level constants", () => {
+    expect(ImageStackLayout.singleSize.width).toBe(210);
+    expect(ImageStackLayout.cardSize.height).toBe(210);
+    expect(ImageStackLayout.stackInset.width).toBe(28);
+    expect(ImageStackLayout.cornerRadius).toBe(18);
+    expect(ImageStackLayout.longPressMs).toBe(350);
+    expect(ImageStackLayout.maxStacked).toBe(3);
+    expect(ImageStackLayout.maxFanned).toBe(5);
+  });
+
+  it("answers the same numbers through the functions and through the table", () => {
+    for (const count of [0, 1, 2, 3, 5, 20]) {
+      expect(ImageStackLayout.stackSize(count)).toEqual(imageStackSize(count));
+      expect(ImageStackLayout.height(count)).toEqual(imageStackHeight(count));
+      expect(ImageStackLayout.cards(count, true)).toEqual(imageStackCards(count, true));
+      expect(ImageStackLayout.caption(count)).toEqual(imageStackCaption(count));
+    }
+    expect(imageStackCardSize(1)).toEqual({ width: 210, height: 210 });
+    expect(imageStackCardSize(4)).toEqual({ width: 168, height: 210 });
+    expect(imageStackFocusedIndex(0, 1)).toBe(0);
+    expect(imageStackHitIndex({ x: 0, y: 0 }, 1, false)).toBe(0);
+    expect(imageStackScale(0, 0, false)).toBe(1);
+    expect(imageStackShouldOpenOnRelease(0)).toBe(false);
+  });
+});
+
+describe("ComposerAttachLayout", () => {
+  it("keeps a large thumbnail strip above a text area that is never squeezed", () => {
+    expect(ComposerAttachLayout.thumbSize.width).toBeGreaterThanOrEqual(120);
+    expect(ComposerAttachLayout.thumbSize.height).toBeGreaterThanOrEqual(120);
+    expect(ComposerAttachLayout.composerMinHeight(0)).toBe(ComposerAttachLayout.textMinHeight);
+    const attachH1 = ComposerAttachLayout.composerMinHeight(1);
+    const attachH3 = ComposerAttachLayout.composerMinHeight(3);
+    expect(attachH1).toBe(attachH3);
+    expect(attachH1).toBeGreaterThanOrEqual(
+      ComposerAttachLayout.stripHeight + ComposerAttachLayout.textMinHeight,
+    );
+    expect(ComposerAttachLayout.textHeight(attachH1, 3)).toBeGreaterThanOrEqual(
+      ComposerAttachLayout.textMinHeight,
+    );
+    expect(ComposerAttachLayout.textHeight(80, 3)).toBe(ComposerAttachLayout.textMinHeight);
+    expect(ComposerAttachLayout.stripHeight).toBeGreaterThan(64);
+  });
+});
+
+describe("ImageViewerIndex and ImageSendPolicy", () => {
+  it("clamps the starting page and shows a strip only for two or more images", () => {
+    expect(ImageViewerIndex.clamp(5, 3)).toBe(2);
+    expect(ImageViewerIndex.clamp(-1, 3)).toBe(0);
+    expect(ImageViewerIndex.clamp(2, 0)).toBe(0);
+    expect(ImageViewerIndex.showsStrip(1)).toBe(false);
+    expect(ImageViewerIndex.showsStrip(2)).toBe(true);
+  });
+
+  it("compresses to a 1600 long edge unless the original is kept", () => {
+    const big = { width: 4032, height: 3024 };
+    expect(ImageSendPolicy.targetSize(big, false)).toEqual({ width: 1600, height: 1200 });
+    expect(ImageSendPolicy.targetSize(big, true)).toEqual(big);
+    expect(ImageSendPolicy.targetSize({ width: 800, height: 600 }, false)).toEqual({
+      width: 800,
+      height: 600,
+    });
+  });
+
+  it("treats HEIC and HEIF as formats that must become JPEG", () => {
+    expect(ImageSendPolicy.needsHeicConversion("photo.heic", "image/heic")).toBe(true);
+    expect(ImageSendPolicy.needsHeicConversion("photo.HEIF", undefined)).toBe(true);
+    expect(ImageSendPolicy.needsHeicConversion("photo.jpg", "image/jpeg")).toBe(false);
+  });
+});
diff --git a/apps/mobile/lib/image-stack-layout.ts b/apps/mobile/lib/image-stack-layout.ts
new file mode 100644
index 000000000..0e59e7a36
--- /dev/null
+++ b/apps/mobile/lib/image-stack-layout.ts
@@ -0,0 +1,250 @@
+/** Geometry for a message's image cards, the composer attach tray, the viewer, and send policy.
+ * Shared by the UI and by layout tests so both read the same numbers.
+ *
+ * Every number lives at the top of this module as its own constant, and the functions that read
+ * them are rewritten by Reanimated's build into functions that run on the UI thread. A method
+ * written inside `ImageStackLayout`'s own object literal could not do that: the worklet plugin
+ * lifts it out of the literal, so the name it uses to reach its siblings is still undefined when
+ * the method runs, and the first image card crashed the app with "Cannot read property
+ * of undefined". So the object below only gathers the constants and references the functions;
+ * nothing inside a function reaches back through `ImageStackLayout`.*/
+
+export type ImageStackCard = {
+  /** 0 = the front card (the first image). */
+  index: number;
+  rotation: number;
+  offset: { width: number; height: number };
+  zIndex: number;
+};
+
+export type Size = { width: number; height: number };
+export type Point = { x: number; y: number };
+
+/** One image draws as a square card; two or more draw the taller card. */
+const SINGLE_EDGE = 210;
+const CARD_WIDTH = 168;
+const CARD_HEIGHT = 210;
+const STACK_INSET_WIDTH = 28;
+const STACK_INSET_HEIGHT = 8;
+
+export const SINGLE_SIZE: Size = { width: SINGLE_EDGE, height: SINGLE_EDGE };
+export const CARD_SIZE: Size = { width: CARD_WIDTH, height: CARD_HEIGHT };
+export const STACK_INSET: Size = { width: STACK_INSET_WIDTH, height: STACK_INSET_HEIGHT };
+export const CORNER_RADIUS = 18;
+/** Stacked rest pose draws at most this many cards; the caption still uses the real count. */
+export const MAX_STACKED = 3;
+/** Long-press fan-out shows at most this many cards. */
+export const MAX_FANNED = 5;
+export const CAPTION_HEIGHT = 18;
+export const CAPTION_SPACING = 6;
+export const FAN_SPACING = 46;
+/** Finger must travel at least this far, or release only keeps the fan / collapses it. */
+export const SCRUB_THRESHOLD = 12;
+export const HIGHLIGHT_SCALE = 1.14;
+export const REST_SCALE = 0.94;
+export const LONG_PRESS_MS = 350;
+
+/** Whether more than one image draws as a stack. */
+export function imageStackIsStack(count: number): boolean {
+  "worklet";
+  return count > 1;
+}
+
+/** "N 张图片"; a single image has no caption. */
+export function imageStackCaption(count: number): string | null {
+  "worklet";
+  return count > 1 ? `${count} 张图片` : null;
+}
+
+/** The box every card of a count is laid out in. */
+export function imageStackSize(count: number): Size {
+  "worklet";
+  if (count <= 0) return { width: 0, height: 0 };
+  if (count === 1) return { width: SINGLE_EDGE, height: SINGLE_EDGE };
+  return {
+    width: CARD_WIDTH + STACK_INSET_WIDTH * 2,
+    height: CARD_HEIGHT + STACK_INSET_HEIGHT * 2,
+  };
+}
+
+/** One card's own size: a lone image is square, a stack draws the taller card. */
+export function imageStackCardSize(count: number): Size {
+  "worklet";
+  return count === 1
+    ? { width: SINGLE_EDGE, height: SINGLE_EDGE }
+    : { width: CARD_WIDTH, height: CARD_HEIGHT };
+}
+
+/** The stack's height plus, for two or more images, the caption line under it. */
+export function imageStackHeight(count: number): number {
+  "worklet";
+  if (count <= 0) return 0;
+  const box = imageStackSize(count);
+  return box.height + (count > 1 ? CAPTION_SPACING + CAPTION_HEIGHT : 0);
+}
+
+/** Cards in back-to-front paint order (last entry is on top). */
+export function imageStackCards(count: number, fanned = false): ImageStackCard[] {
+  "worklet";
+  if (count <= 0) return [];
+  if (count === 1) return [{ index: 0, rotation: 0, offset: { width: 0, height: 0 }, zIndex: 0 }];
+  if (fanned) {
+    const n = Math.min(count, MAX_FANNED);
+    const mid = (n - 1) / 2;
+    return Array.from({ length: n }, (_, i) => n - 1 - i).map((i) => {
+      const d = i - mid;
+      return {
+        index: i,
+        rotation: d * 8,
+        offset: { width: d * FAN_SPACING, height: Math.abs(d) * 6 },
+        zIndex: n - i,
+      };
+    });
+  }
+  const n = Math.min(count, MAX_STACKED);
+  const rotations = [0, 7, -6];
+  const offsets = [
+    { width: 0, height: 0 },
+    { width: 14, height: 2 },
+    { width: -14, height: 4 },
+  ];
+  return Array.from({ length: n }, (_, i) => n - 1 - i).map((i) => ({
+    index: i,
+    rotation: rotations[i]!,
+    offset: offsets[i]!,
+    zIndex: n - i,
+  }));
+}
+
+/** Hit-test in the stack's box (origin at the top-left). Stacked rest always returns 0. */
+export function imageStackHitIndex(at: Point, count: number, fanned: boolean): number {
+  "worklet";
+  if (!fanned || count <= 1) return 0;
+  const box = imageStackSize(count);
+  const cards = imageStackCards(count, true)
+    .slice()
+    .sort((a, b) => b.zIndex - a.zIndex);
+  for (const card of cards) {
+    const cx = box.width / 2 + card.offset.width;
+    const cy = box.height / 2 + card.offset.height;
+    if (Math.abs(at.x - cx) <= CARD_WIDTH / 2 && Math.abs(at.y - cy) <= CARD_HEIGHT / 2) {
+      return card.index;
+    }
+  }
+  return 0;
+}
+
+/** Finger x (origin at the top-left of the box) maps to the nearest visible fanned card. */
+export function imageStackFocusedIndex(atX: number, count: number): number {
+  "worklet";
+  const n = Math.min(Math.max(count, 1), MAX_FANNED);
+  if (n <= 1) return 0;
+  const mid = imageStackSize(count).width / 2;
+  let best = 0;
+  let bestDist = Number.POSITIVE_INFINITY;
+  for (let i = 0; i < n; i++) {
+    const d = i - (n - 1) / 2;
+    const cx = mid + d * FAN_SPACING;
+    const dist = Math.abs(atX - cx);
+    if (dist < bestDist) {
+      bestDist = dist;
+      best = i;
+    }
+  }
+  return best;
+}
+
+/** The card under the finger grows; its neighbours rest a little smaller. */
+export function imageStackScale(index: number, focused: number, fanned: boolean): number {
+  "worklet";
+  if (!fanned) return 1;
+  return index === focused ? HIGHLIGHT_SCALE : REST_SCALE;
+}
+
+/** Whether a release opens the focused image, or only settles the fan. */
+export function imageStackShouldOpenOnRelease(translation: number): boolean {
+  "worklet";
+  return Math.abs(translation) >= SCRUB_THRESHOLD;
+}
+
+export const ImageStackLayout = {
+  singleSize: SINGLE_SIZE,
+  cardSize: CARD_SIZE,
+  cornerRadius: CORNER_RADIUS,
+  maxStacked: MAX_STACKED,
+  maxFanned: MAX_FANNED,
+  captionHeight: CAPTION_HEIGHT,
+  captionSpacing: CAPTION_SPACING,
+  stackInset: STACK_INSET,
+  fanSpacing: FAN_SPACING,
+  scrubThreshold: SCRUB_THRESHOLD,
+  highlightScale: HIGHLIGHT_SCALE,
+  restScale: REST_SCALE,
+  longPressMs: LONG_PRESS_MS,
+
+  isStack: imageStackIsStack,
+  caption: imageStackCaption,
+  stackSize: imageStackSize,
+  cardSizeFor: imageStackCardSize,
+  height: imageStackHeight,
+  cards: imageStackCards,
+  hitIndex: imageStackHitIndex,
+  focusedIndex: imageStackFocusedIndex,
+  scale: imageStackScale,
+  shouldOpenOnRelease: imageStackShouldOpenOnRelease,
+} as const;
+
+export const ComposerAttachLayout = {
+  thumbSize: { width: 140, height: 140 } as Size,
+  thumbCorner: 18,
+  composerCorner: 22,
+  thumbSpacing: 10,
+  closeOverhang: 10,
+  textMinHeight: 44,
+  get stripHeight(): number {
+    return ComposerAttachLayout.thumbSize.height + ComposerAttachLayout.closeOverhang;
+  },
+  composerMinHeight(attachmentCount: number): number {
+    if (attachmentCount <= 0) return ComposerAttachLayout.textMinHeight;
+    return ComposerAttachLayout.stripHeight + 8 + ComposerAttachLayout.textMinHeight;
+  },
+  textHeight(composerHeight: number, attachmentCount: number): number {
+    if (attachmentCount <= 0) return Math.max(ComposerAttachLayout.textMinHeight, composerHeight);
+    return Math.max(
+      ComposerAttachLayout.textMinHeight,
+      composerHeight - ComposerAttachLayout.stripHeight - 8,
+    );
+  },
+} as const;
+
+export const ImageViewerIndex = {
+  clamp(index: number, count: number): number {
+    return Math.max(0, Math.min(index, Math.max(count - 1, 0)));
+  },
+  showsStrip(count: number): boolean {
+    return count > 1;
+  },
+} as const;
+
+/** Default send policy: long edge 1600, JPEG; HEIC always becomes JPEG. Keep-original skips resize only. */
+export const ImageSendPolicy = {
+  keepOriginalKey: "imageSend.keepOriginal",
+  maxSide: 1600,
+  compressQuality: 0.7,
+  keepOriginalQuality: 0.92,
+
+  targetSize(size: Size, keepOriginal: boolean): Size {
+    if (keepOriginal || size.width <= 0 || size.height <= 0) return { ...size };
+    const scale = Math.min(1, ImageSendPolicy.maxSide / Math.max(size.width, size.height));
+    return {
+      width: Math.round(size.width * scale),
+      height: Math.round(size.height * scale),
+    };
+  },
+
+  needsHeicConversion(name: string, mimeType: string | null | undefined): boolean {
+    const ext = name.split(".").pop()?.toLowerCase() ?? "";
+    const mime = (mimeType ?? "").toLowerCase();
+    return ext === "heic" || ext === "heif" || mime === "image/heic" || mime === "image/heif";
+  },
+} as const;
