+import { describe, expect, it } from "vitest";
+import { activityNotificationsEnabled, activityPreview } from "./runs.js";
+
+describe("run activity copy", () => {
+  it.each([
+    [
+      "request",
+      "Maya",
+      "Please check the release workflow.",
+      "Maya asked: Please check the release workflow.",
+      "request",
+    ],
+    ["result", "Maya", "Ready", "Update from Maya: Ready", "update"],
+    ["status", "Maya", "Ready", "Update from Maya: Ready", "update"],
+    ["fyi", "Maya", "Ready", "Update from Maya: Ready", "update"],
+    ["request", "  ", " first\n second ", "Another agent asked: first second", "request"],
+    ["result", "  ", " first\n second ", "Update from Another agent: first second", "update"],
+    ["request", " Maya ", " \n ", "Maya asked", "request"],
+    ["result", " Maya ", "", "Update from Maya", "update"],
+    ["request", "", "", "Another agent asked", "request"],
+    ["result", "", "", "Update from Another agent", "update"],
+  ])(
+    "preserves the legacy label for %s from '%s' with text '%s'",
+    (intent, fromBotName, text, legacy, kind) => {
+      expect(
+        activityPreview({
+          trigger: "bot_message",
+          prompt: "[bot] private internal routing envelope",
+          sourceBlocks: [
+            { kind: "bot_message_received", fromBotId: "peer", fromBotName, text, intent },
+          ],
+        }),
+      ).toEqual({
+        promptSnippet: legacy,
+        agentMessage: {
+          fromBotName: fromBotName.trim(),
+          kind,
+          text: text.replace(/\s+/g, " ").trim(),
+        },
+      });
+    },
+  );
+
+  it.each(["created", "call_end"])("shows no prompt for a %s run", (trigger) => {
+    expect(
+      activityPreview({ trigger, prompt: "You were just created. Call ask_user right away." }),
+    ).toEqual({ promptSnippet: "", agentMessage: null });
+  });
+
+  it("caps the whole legacy label and the structured text independently", () => {
+    expect(activityPreview({ trigger: "user", prompt: " hello\n world " })).toEqual({
+      promptSnippet: "hello world",
+      agentMessage: null,
+    });
+    const preview = activityPreview({
+      trigger: "bot_message",
+      prompt: "internal",
+      sourceBlocks: [
+        {
+          kind: "bot_message_received",
+          fromBotId: "peer",
+          fromBotName: "Peer",
+          intent: "request",
+          text: "x".repeat(130),
+        },
+      ],
+    });
+    expect(preview).toEqual({
+      promptSnippet: `Peer asked: ${"x".repeat(107)}…`,
+      agentMessage: { fromBotName: "Peer", kind: "request", text: `${"x".repeat(119)}…` },
+    });
+    expect(activityPreview({ trigger: "user", prompt: "x".repeat(130) }).promptSnippet).toBe(
+      `${"x".repeat(119)}…`,
+    );
+  });
+
+  it("keeps surrogate pairs intact at the activity preview boundary", () => {
+    const emoji = "\u{1f600}";
+    const preview = (prompt: string) => activityPreview({ trigger: "user", prompt }).promptSnippet;
+    expect(preview("a".repeat(118) + emoji)).toBe("a".repeat(118) + emoji);
+    expect(preview("a".repeat(118) + emoji + "x")).toBe("a".repeat(118) + "\u2026");
+    expect(preview("a".repeat(117) + emoji + "xx")).toBe("a".repeat(117) + emoji + "\u2026");
+  });
+
+  it("keeps structured agent message text intact at the same boundary", () => {
+    const text = "a".repeat(118) + "\u{1f600}x";
+    const preview = activityPreview({
+      trigger: "bot_message",
+      prompt: "internal",
+      sourceBlocks: [
+        {
+          kind: "bot_message_received",
+          fromBotId: "peer",
+          fromBotName: "Peer",
+          text,
+          intent: "request",
+        },
+      ],
+    });
+    expect(preview.agentMessage).toEqual({
+      fromBotName: "Peer",
+      kind: "request",
+      text: "a".repeat(118) + "\u2026",
+    });
+  });
+
+  it.each([
+    undefined,
+    null,
+    [],
+    [{ kind: "invalid" }],
+    [{ kind: "text", text: "not a peer message" }],
+  ])("fails closed when an agent message has no valid structured source: %j", (sourceBlocks) => {
+    expect(
+      activityPreview({
+        trigger: "bot_message",
+        prompt: "[bot] private internal routing envelope",
+        sourceBlocks,
+      }),
+    ).toEqual({ promptSnippet: "Message from another agent", agentMessage: { kind: "unknown" } });
+  });
+});
+
+describe("run activity notification preference", () => {
+  it("silences only direct messages", () => {
+    expect(activityNotificationsEnabled(null, false)).toBe(false);
+    expect(activityNotificationsEnabled("group-1", false)).toBe(true);
+  });
+});
+
+it("hides opaque sender names in Activity previews", () => {
+  expect(
+    activityPreview({
+      trigger: "bot_message",
+      prompt: "internal",
+      sourceBlocks: [
+        {
+          kind: "bot_message_received",
+          fromBotId: "peer",
+          fromBotName: "__TestTok1__",
+          text: "Ready",
+          intent: "result",
+        },
+      ],
+    }),
+  ).toEqual({
+    promptSnippet: "Update from Another agent: Ready",
+    agentMessage: { fromBotName: "", kind: "update", text: "Ready" },
+  });
+});
diff --git a/apps/api/src/threads/runs.ts b/apps/api/src/threads/runs.ts
new file mode 100644
index 000000000..444c4ce8f
--- /dev/null
+++ b/apps/api/src/threads/runs.ts
@@ -0,0 +1,155 @@
+import type { Actor, RunActivityRow, RunStatus, RunTrigger } from "@rakazo/contracts";
+import { MessageBlock } from "@rakazo/contracts";
+import {
+  ACTIVE_RUN_STATUSES,
+  BACKGROUND_HELPER_TRIGGER,
+  BACKGROUND_RUN_TRIGGERS,
+  botMessageContext,
+  displayName,
+  HELPER_RESULT_TRIGGER,
+  truncatePlainText,
+} from "@rakazo/core";
+import type { PrismaClient } from "@rakazo/db";
+import { Prisma } from "@rakazo/db";
+
+const RECENT_LIMIT = 20;
+// Background ticket work belongs on the board, not in the activity list. A background helper and
+// the turn passing on its result show in the chat, on the helper's card.
+const ACTIVITY_HIDDEN_TRIGGERS = [
+  ...BACKGROUND_RUN_TRIGGERS,
+  BACKGROUND_HELPER_TRIGGER,
+  HELPER_RESULT_TRIGGER,
+] as const;
+// The prompt of these runs is written by the product, not the user, so it is no preview.
+const SYSTEM_PROMPT_TRIGGERS: readonly string[] = [
+  "created",
+  "call_end",
+] as const satisfies readonly RunTrigger[];
+const TERMINAL_STATUSES = ["completed", "failed", "cancelled"] as const;
+
+function promptSnippet(prompt: string, max = 120): string {
+  const oneLine = prompt.replace(/\s+/g, " ").trim();
+  if (oneLine.length <= max) return oneLine;
+  return `${truncatePlainText(oneLine, max - 1)}…`;
+}
+
+export function activityPreview(
+  input: { trigger: string; prompt: string; sourceBlocks?: unknown },
+  max = 120,
+): Pick<RunActivityRow, "promptSnippet" | "agentMessage"> {
+  if (SYSTEM_PROMPT_TRIGGERS.includes(input.trigger))
+    return { promptSnippet: "", agentMessage: null };
+  if (input.trigger !== "bot_message")
+    return { promptSnippet: promptSnippet(input.prompt, max), agentMessage: null };
+  const parsed = MessageBlock.array().safeParse(input.sourceBlocks);
+  const message = parsed.success ? botMessageContext(parsed.data) : undefined;
+  if (!message) {
+    return {
+      promptSnippet: "Message from another agent",
+      agentMessage: { kind: "unknown" },
+    };
+  }
+  const name = displayName(message.fromBotName, "Another agent");
+  const kind =
+    message.intent === "result" || message.intent === "status" || message.intent === "fyi"
+      ? "update"
+      : "request";
+  const label = kind === "update" ? `Update from ${name}` : `${name} asked`;
+  return {
+    promptSnippet: promptSnippet(message.text.trim() ? `${label}: ${message.text}` : label, max),
+    agentMessage: {
+      fromBotName: displayName(message.fromBotName, ""),
+      kind,
+      text: promptSnippet(message.text, max),
+    },
+  };
+}
+
+export function activityNotificationsEnabled(
+  groupId: string | null,
+  notifyOnFinish: boolean,
+): boolean {
+  return groupId !== null || notifyOnFinish;
+}
+
+export async function listSpaceRuns(
+  prisma: PrismaClient,
+  actor: Actor,
+  filter: "active" | "recent",
+  status?: RunStatus,
+): Promise<RunActivityRow[]> {
+  const sectionStatuses: readonly RunStatus[] =
+    filter === "active" ? ACTIVE_RUN_STATUSES : TERMINAL_STATUSES;
+  if (status && !sectionStatuses.includes(status)) return [];
+  const statuses = status ? [status] : [...sectionStatuses];
+  const rows = await prisma.run.findMany({
+    where: {
+      spaceId: actor.spaceId,
+      bot: { archivedAt: null },
+      trigger: { notIn: [...ACTIVITY_HIDDEN_TRIGGERS] },
+      status: { in: statuses },
+      ...(filter === "recent"
+        ? { id: { in: await latestFinishedRunPerChat(prisma, actor, statuses) } }
+        : {}),
+    },
+    include: {
+      bot: { select: { name: true, archivedAt: true, notifyOnFinish: true } },
+      task: { select: { prompt: true } },
+      sourceMessage: { select: { blocks: true } },
+      thread: {
+        select: {
+          groupId: true,
+          group: { select: { name: true } },
+        },
+      },
+    },
+    orderBy:
+      filter === "active"
+        ? [{ updatedAt: "desc" }, { id: "desc" }]
+        : [{ completedAt: "desc" }, { updatedAt: "desc" }, { id: "desc" }],
+  });
+
+  return rows.map((row) => ({
+    runId: row.id,
+    botId: row.botId,
+    botName: row.bot.name,
+    groupId: row.thread.groupId,
+    groupName: row.thread.group ? row.thread.group.name : null,
+    threadId: row.threadId,
+    status: row.status as RunActivityRow["status"],
+    trigger: row.trigger as RunActivityRow["trigger"],
+    notificationsEnabled: activityNotificationsEnabled(row.thread.groupId, row.bot.notifyOnFinish),
+    ...activityPreview({
+      trigger: row.trigger,
+      prompt: row.task.prompt,
+      sourceBlocks: row.sourceMessage?.blocks,
+    }),
+    updatedAt: (filter === "recent" && row.completedAt
+      ? row.completedAt
+      : row.updatedAt
+    ).toISOString(),
+  }));
+}
+
+/** Recent lists chats keyed like `activitySections`, so one busy chat must not push the others out of the limit. */
+async function latestFinishedRunPerChat(
+  prisma: PrismaClient,
+  actor: Actor,
+  statuses: RunStatus[],
+): Promise<string[]> {
+  const rows = await prisma.$queryRaw<Array<{ id: string }>>`
+    SELECT id FROM (
+      SELECT DISTINCT ON (COALESCE('group:' || t."groupId", 'bot:' || r."botId")) r.id, r."completedAt", r."updatedAt"
+      FROM runs r
+      JOIN threads t ON t.id = r."threadId"
+      JOIN bots b ON b.id = r."botId"
+      WHERE r."spaceId" = ${actor.spaceId}
+        AND b."archivedAt" IS NULL
+        AND r.trigger NOT IN (${Prisma.join([...ACTIVITY_HIDDEN_TRIGGERS])})
+        AND r.status IN (${Prisma.join(statuses)})
+      ORDER BY COALESCE('group:' || t."groupId", 'bot:' || r."botId"), r."completedAt" DESC, r."updatedAt" DESC, r.id DESC
+    ) latest
+    ORDER BY "completedAt" DESC, "updatedAt" DESC, id DESC
+    LIMIT ${RECENT_LIMIT}`;
+  return rows.map((row) => row.id);
+}
