diff --git a/apps/mobile/components/bot-profile-tabs.tsx b/apps/mobile/components/bot-profile-tabs.tsx
new file mode 100644
index 000000000..97bf11c77
--- /dev/null
+++ b/apps/mobile/components/bot-profile-tabs.tsx
@@ -0,0 +1,744 @@
+import type { DiarySummary, FrontDeskTask, MemoryLearning, Routine } from "@rakazo/contracts";
+import { useInfiniteQuery, useQuery } from "@tanstack/react-query";
+import { useRouter } from "expo-router";
+import { useCallback, useMemo, useState } from "react";
+import { ActivityIndicator, Alert, Pressable, StyleSheet, Text, View } from "react-native";
+import { rpc } from "../lib/api";
+import { dateLocaleForUi } from "../lib/i18n";
+import { hapticError, hapticSelection, hapticSuccess } from "../lib/haptics";
+import { native, useMobileTokens } from "../lib/native";
+import { queryClient, rpcQuery } from "../lib/query";
+import { deviceTimeZone, routineRowDetail } from "../lib/routine";
+import { setRoutineActive, useBotRoutines } from "../lib/routine-store";
+import {
+  groupTasksByDay,
+  mergeTaskPages,
+  TASK_LIST_POLL_MS,
+  taskIsOpen,
+  taskRowDetail,
+  taskRowMeta,
+  taskRowTrail,
+  taskStatusLabel,
+} from "../lib/task-steps";
+import { errorText } from "../lib/user-error";
+import { NativeSwitch } from "./native-switch";
+import { NativeSymbol } from "./native-symbol";
+import { TaskStepsSheet } from "./task-steps-sheet";
+
+/**
+ * The Bot's own page, in the reference app's three columns: the work it has been given, the
+ * schedules that start it by itself, and what it has learned — each a tab under its name, so the
+ * page answers "what is it doing", "when does it run" and "what does it remember" without leaving
+ * the chat it belongs to.
+ */
+
+export type ProfileTab = "tasks" | "schedules" | "memory";
+
+const TABS = [
+  { id: "tasks", ios: "list.bullet", android: "list-outline", label: "任务" },
+  { id: "schedules", ios: "clock", android: "time-outline", label: "定时任务" },
+  { id: "memory", ios: "book", android: "book-outline", label: "记忆与总结" },
+] as const;
+
+/** How many rows one page of the bot's work holds. */
+const TASK_PAGE_SIZE = 30;
+
+export function BotProfileTabs({ botId, botName }: { botId: string; botName: string }) {
+  const tokens = useMobileTokens();
+  const [tab, setTab] = useState<ProfileTab>("tasks");
+  return (
+    <View style={{ gap: 18 }}>
+      <View
+        accessibilityRole="tablist"
+        style={[styles.segments, { backgroundColor: tokens.muted }]}
+      >
+        {TABS.map((entry) => {
+          const selected = entry.id === tab;
+          return (
+            <Pressable
+              key={entry.id}
+              accessibilityRole="tab"
+              accessibilityLabel={entry.label}
+              accessibilityState={{ selected }}
+              onPress={() => {
+                if (selected) return;
+                hapticSelection();
+                setTab(entry.id);
+              }}
+              style={[
+                styles.segment,
+                selected && [styles.segmentOn, { backgroundColor: tokens.card }],
+              ]}
+            >
+              <NativeSymbol
+                ios={entry.ios}
+                android={entry.android}
+                size={18}
+                color={selected ? tokens.foreground : tokens.mutedForeground}
+              />
+            </Pressable>
+          );
+        })}
+      </View>
+      {tab === "tasks" ? <TasksColumn botId={botId} /> : null}
+      {tab === "schedules" ? <SchedulesColumn botId={botId} botName={botName} /> : null}
+      {tab === "memory" ? <MemoryColumn botId={botId} botName={botName} /> : null}
+    </View>
+  );
+}
+
+/**
+ * 任务: the work this Bot handed to the back office lately, across every chat it takes part in —
+ * newest first, under the day it was handed over. A row opens the steps that work actually took,
+ * so the page answers "what is it doing, and how far did it get" without leaving the Bot.
+ */
+function TasksColumn({ botId }: { botId: string }) {
+  const tokens = useMobileTokens();
+  const [opened, setOpened] = useState<string | null>(null);
+  const read = rpcQuery("bots/tasks", { botId, limit: TASK_PAGE_SIZE });
+  const query = useInfiniteQuery(
+    {
+      queryKey: read.queryKey,
+      queryFn: (context) =>
+        rpcQuery("bots/tasks", {
+          botId,
+          limit: TASK_PAGE_SIZE,
+          ...(context.pageParam ? { before: context.pageParam as string } : {}),
+        }).queryFn(context as never) as Promise<FrontDeskTask[]>,
+      initialPageParam: null as string | null,
+      // A full page's last row is where the one after it starts: the server pages by `before`.
+      getNextPageParam: (page: FrontDeskTask[]) =>
+        page.length >= TASK_PAGE_SIZE ? (page[page.length - 1]?.createdAt ?? null) : null,
+      // The work keeps moving behind the page, so a row settles and a step lands while it is open.
+      refetchInterval: TASK_LIST_POLL_MS,
+    },
+    queryClient,
+  );
+  const rows = useMemo(() => (query.data ? mergeTaskPages(query.data.pages) : null), [query.data]);
+  const days = useMemo(() => groupTasksByDay(rows ?? []), [rows]);
+
+  if (query.isPending) {
+    return <ActivityIndicator accessibilityLabel="正在读任务" color={tokens.mutedForeground} />;
+  }
+  return (
+    <View style={{ gap: 14 }}>
+      {query.error ? (
+        <Text accessibilityRole="alert" style={[styles.error, { color: tokens.destructive }]}>
+          {errorText(query.error, "现在读不到任务")}
+        </Text>
+      ) : null}
+      {rows && rows.length === 0 ? (
+        <Text style={[styles.empty, { color: tokens.mutedForeground }]}>
+          还没有任务。直接跟它说一句，派出去的活会出现在这里。
+        </Text>
+      ) : null}
+      {days.map((day) => (
+        <View key={day.key} style={{ gap: 8 }}>
+          <Text style={[styles.sectionLabel, { color: native.secondaryLabel }]}>{day.label}</Text>
+          {day.tasks.map((task) => (
+            <TaskRow
+              key={task.id}
+              task={task}
+              onOpen={() => {
+                hapticSelection();
+                setOpened(task.id);
+              }}
+            />
+          ))}
+        </View>
+      ))}
+      {query.hasNextPage ? (
+        <Pressable
+          accessibilityRole="button"
+          disabled={query.isFetchingNextPage}
+          onPress={() => void query.fetchNextPage()}
+          style={({ pressed }) => [styles.linkRow, { opacity: pressed ? 0.6 : 1 }]}
+        >
+          <Text style={[styles.link, { color: tokens.accent }]}>
+            {query.isFetchingNextPage ? "正在读更早的…" : "更早的任务"}
+          </Text>
+        </Pressable>
+      ) : null}
+      {/* The steps the work actually took, opened over this page so the list keeps its place. */}
+      <TaskStepsSheet taskId={opened} botId={botId} onClose={() => setOpened(null)} />
+    </View>
+  );
+}
+
+/** One piece of work: what it is, the line it is on, and the mark that says where it stands. */
+function TaskRow({ task, onOpen }: { task: FrontDeskTask; onOpen: () => void }) {
+  const tokens = useMobileTokens();
+  const open = taskIsOpen(task.status);
+  const failed = task.status === "failed";
+  const detail = taskRowDetail(task);
+  const trail = taskRowTrail(task);
+  return (
+    <Pressable
+      accessibilityRole="button"
+      accessibilityLabel={`${task.title}，${taskStatusLabel(task.status)}，${detail}`}
+      onPress={onOpen}
+      style={({ pressed }) => [
+        styles.card,
+        { backgroundColor: native.groupedCell, opacity: pressed ? 0.7 : 1 },
+      ]}
+    >
+      <View style={styles.mark}>
+        {open ? (
+          <ActivityIndicator size="small" color={tokens.warning} />
+        ) : (
+          <NativeSymbol
+            ios={failed ? "exclamationmark.circle.fill" : "checkmark.circle.fill"}
+            android={failed ? "alert-circle" : "checkmark-circle"}
+            size={17}
+            color={failed ? tokens.destructive : native.tertiaryLabel}
+          />
+        )}
+      </View>
+      <View style={styles.cardBody}>
+        <Text numberOfLines={1} style={[styles.cardTitle, { color: native.label }]}>
+          {task.title.trim() || task.slot || "任务"}
+        </Text>
+        <Text
+          numberOfLines={1}
+          style={[styles.cardDetail, { color: open ? tokens.accent : native.secondaryLabel }]}
+        >
+          {detail}
+        </Text>
+        <Text numberOfLines={1} style={[styles.cardMeta, { color: native.tertiaryLabel }]}>
+          {taskRowMeta(task)}
+        </Text>
+      </View>
+      <View style={styles.trail}>
+        {trail ? (
+          <Text style={[styles.cardMeta, { color: native.tertiaryLabel }]}>{trail}</Text>
+        ) : null}
+        <NativeSymbol
+          ios="chevron.right"
+          android="chevron-forward"
+          size={14}
+          color={native.tertiaryLabel}
+        />
+      </View>
+    </Pressable>
+  );
+}
+
+/** 定时任务: the schedules that start this Bot by itself, each with its next run and its switch. */
+function SchedulesColumn({ botId, botName }: { botId: string; botName: string }) {
+  const tokens = useMobileTokens();
+  const router = useRouter();
+  const { routines, error } = useBotRoutines(botId);
+  const zone = deviceTimeZone();
+  const [busy, setBusy] = useState<string | null>(null);
+
+  const toggle = (routine: Routine, active: boolean) => {
+    hapticSelection();
+    setRoutineActive(botId, routine, active, (cause) =>
+      Alert.alert("没能改这个定时任务", errorText(cause, "再试一次。")),
+    );
+  };
+
+  return (
+    <View style={{ gap: 10 }}>
+      {error ? (
+        <Text accessibilityRole="alert" style={[styles.error, { color: tokens.destructive }]}>
+          {errorText(error, "读不到定时任务")}
+        </Text>
+      ) : null}
+      {routines === undefined ? (
+        <ActivityIndicator accessibilityLabel="Loading…" color={tokens.mutedForeground} />
+      ) : routines.length === 0 ? (
+        <Text style={[styles.empty, { color: tokens.mutedForeground }]}>
+          还没有定时任务。让它每天或每周自己跑一件事，就会排在这里。
+        </Text>
+      ) : (
+        routines.map((routine) => (
+          <Pressable
+            key={routine.id}
+            accessibilityRole="button"
+            accessibilityLabel={`${routine.name}，${routine.active ? "开着" : "关着"}`}
+            disabled={busy === routine.id}
+            onPress={() => {
+              hapticSelection();
+              setBusy(routine.id);
+              router.push({
+                pathname: "/routine",
+                params: { botId, botName, routineId: routine.id, origin: "profile" },
+              });
+              setTimeout(() => setBusy(null), 400);
+            }}
+            style={({ pressed }) => [
+              styles.card,
+              { backgroundColor: native.groupedCell, opacity: pressed ? 0.7 : 1 },
+            ]}
+          >
+            <View style={styles.cardBody}>
+              <Text numberOfLines={1} style={[styles.cardTitle, { color: native.label }]}>
+                {routine.name.trim() || "定时任务"}
+              </Text>
+              <Text numberOfLines={1} style={[styles.cardDetail, { color: native.secondaryLabel }]}>
+                {[routineRowDetail(routine, zone), nextRun(routine)].filter(Boolean).join(" · ")}
+              </Text>
+            </View>
+            <NativeSwitch
+              accessibilityLabel={`${routine.name} 开关`}
+              disabled={routine.editable === false}
+              value={routine.active}
+              onValueChange={(active) => toggle(routine, active)}
+            />
+          </Pressable>
+        ))
+      )}
+      <Pressable
+        accessibilityRole="button"
+        onPress={() => router.push({ pathname: "/routines", params: { botId, name: botName } })}
+        style={({ pressed }) => [styles.linkRow, { opacity: pressed ? 0.6 : 1 }]}
+      >
+        <Text style={[styles.link, { color: tokens.accent }]}>管理全部定时任务</Text>
+      </Pressable>
+    </View>
+  );
+}
+
+/**
+ * 记忆与总结: the stage diaries this chat was written up into, what the daily review proposed and
+ * kept, and the notes this Bot holds.
+ */
+function MemoryColumn({ botId, botName }: { botId: string; botName: string }) {
+  const tokens = useMobileTokens();
+  const router = useRouter();
+  const diaryRead = rpcQuery("memory/diaries", { botId, limit: 20 });
+  const diaries = useQuery(diaryRead, queryClient);
+  const pendingRead = rpcQuery("memory/learnings", { botId, status: "pending", limit: 50 });
+  const pending = useQuery(pendingRead, queryClient);
+  const approvedRead = rpcQuery("memory/learnings", { botId, status: "approved", limit: 50 });
+  const approved = useQuery(approvedRead, queryClient);
+  const notesRead = rpcQuery("memory/list", { botId, scope: "bot" });
+  const notes = useQuery(notesRead, queryClient);
+  const [deciding, setDeciding] = useState<string | null>(null);
+  const [decideError, setDecideError] = useState<string | null>(null);
+  const [opened, setOpened] = useState<MemoryLearning | null>(null);
+  const [openedDiary, setOpenedDiary] = useState<DiarySummary | null>(null);
+  // The list carries no bodies: the one that is open reads its own, in full.
+  const diaryBodyRead = rpcQuery("memory/diary", { diaryId: openedDiary?.id ?? "" });
+  const diaryBody = useQuery({ ...diaryBodyRead, enabled: Boolean(openedDiary?.id) }, queryClient);
+
+  const decide = useCallback(
+    async (learning: MemoryLearning, status: "approved" | "rejected") => {
+      if (deciding) return;
+      setDeciding(learning.id);
+      setDecideError(null);
+      try {
+        await rpc("memory/decideLearning", { learningId: learning.id, status });
+        hapticSuccess();
+        await Promise.all([
+          queryClient.invalidateQueries({ queryKey: pendingRead.queryKey }),
+          queryClient.invalidateQueries({ queryKey: approvedRead.queryKey }),
+          queryClient.invalidateQueries({ queryKey: notesRead.queryKey }),
+        ]);
+        setOpened(null);
+      } catch (reason) {
+        hapticError();
+        setDecideError(errorText(reason, "没能存下这个决定"));
+      } finally {
+        setDeciding(null);
+      }
+    },
+    [approvedRead.queryKey, deciding, notesRead.queryKey, pendingRead.queryKey],
+  );
+
+  const waiting = pending.data ?? [];
+  const written = diaries.data ?? [];
+  const kept = useMemo(() => approved.data ?? [], [approved.data]);
+  // Kept rules read as the day's reviews: one card per day the review wrote them on.
+  const byDay = useMemo(() => {
+    const days = new Map<string, MemoryLearning[]>();
+    for (const learning of kept) {
+      const day = learning.sourceDate ?? "更早";
+      days.set(day, [...(days.get(day) ?? []), learning]);
+    }
+    return [...days.entries()].sort(([a], [b]) => b.localeCompare(a));
+  }, [kept]);
+
+  return (
+    <View style={{ gap: 14 }}>
+      {written.length > 0 ? (
+        <View style={{ gap: 8 }}>
+          <Text style={[styles.sectionLabel, { color: native.secondaryLabel }]}>阶段日记</Text>
+          {written.map((diary) => (
+            <DiaryCard
+              key={diary.id}
+              diary={diary}
+              body={openedDiary?.id === diary.id ? diaryBody.data?.body : undefined}
+              opened={openedDiary?.id === diary.id}
+              onOpen={() => {
+                hapticSelection();
+                setOpenedDiary(openedDiary?.id === diary.id ? null : diary);
+              }}
+              onJump={() =>
+                router.push({
+                  pathname: "/thread",
+                  params: {
+                    botId,
+                    name: botName,
+                    // The diary names the message the stretch starts at; an older row that did
+                    // not keep the id still names its place in the chat by seq.
+                    ...(diary.startMessageId
+                      ? { messageId: diary.startMessageId }
+                      : { seq: String(diary.startSeq) }),
+                  },
+                })
+              }
+            />
+          ))}
+        </View>
+      ) : null}
+
+      {waiting.length > 0 ? (
+        <View style={{ gap: 8 }}>
+          <Text style={[styles.sectionLabel, { color: native.secondaryLabel }]}>等你审核</Text>
+          {waiting.map((learning) => (
+            <View
+              key={learning.id}
+              style={[styles.card, styles.stack, { backgroundColor: native.groupedCell }]}
+            >
+              <Text
+                numberOfLines={opened?.id === learning.id ? undefined : 3}
+                style={[styles.learningText, { color: native.label }]}
+              >
+                {learning.text}
+              </Text>
+              <View style={styles.actions}>
+                <Pressable
+                  accessibilityRole="button"
+                  accessibilityLabel="通过这条记忆"
+                  disabled={Boolean(deciding)}
+                  onPress={() => void decide(learning, "approved")}
+                  style={({ pressed }) => [
+                    styles.approve,
+                    { backgroundColor: pressed ? native.fillPressed : native.fill },
+                  ]}
+                >
+                  <Text style={[styles.approveText, { color: tokens.foreground }]}>
+                    {deciding === learning.id ? "保存中…" : "通过"}
+                  </Text>
+                </Pressable>
+                <Pressable
+                  accessibilityRole="button"
+                  accessibilityLabel="丢弃这条记忆"
+                  disabled={Boolean(deciding)}
+                  onPress={() => void decide(learning, "rejected")}
+                  style={({ pressed }) => [
+                    styles.reject,
+                    { backgroundColor: pressed ? native.fillPressed : native.fill },
+                  ]}
+                >
+                  <Text style={[styles.rejectText, { color: tokens.destructive }]}>丢弃</Text>
+                </Pressable>
+              </View>
+            </View>
+          ))}
+        </View>
+      ) : null}
+
+      {byDay.length > 0 ? (
+        <View style={{ gap: 8 }}>
+          <Text style={[styles.sectionLabel, { color: native.secondaryLabel }]}>复盘记住的</Text>
+          {byDay.map(([day, learnings]) => (
+            <View key={day} style={{ gap: 6 }}>
+              <Text style={[styles.dayLabel, { color: native.tertiaryLabel }]}>
+                {day === "更早" ? "更早" : `复盘 ${day}`} · {learnings.length} 条
+              </Text>
+              {learnings.map((learning) => (
+                <Pressable
+                  key={learning.id}
+                  accessibilityRole="button"
+                  onPress={() => {
+                    hapticSelection();
+                    setOpened(opened?.id === learning.id ? null : learning);
+                  }}
+                  style={({ pressed }) => [
+                    styles.card,
+                    { backgroundColor: native.groupedCell, opacity: pressed ? 0.7 : 1 },
+                  ]}
+                >
+                  <Text
+                    numberOfLines={opened?.id === learning.id ? undefined : 2}
+                    style={[styles.learningText, { color: native.label }]}
+                  >
+                    {learning.text}
+                  </Text>
+                </Pressable>
+              ))}
+            </View>
+          ))}
+        </View>
+      ) : null}
+
+      {opened ? (
+        <View style={styles.actions}>
+          <Pressable
+            accessibilityRole="button"
+            onPress={() => void decide(opened, "rejected")}
+            style={({ pressed }) => [
+              styles.reject,
+              { backgroundColor: pressed ? native.fillPressed : native.fill },
+            ]}
+          >
+            <Text style={[styles.rejectText, { color: tokens.destructive }]}>移出长期记忆</Text>
+          </Pressable>
+        </View>
+      ) : null}
+
+      {decideError ? (
+        <Text accessibilityRole="alert" style={[styles.error, { color: tokens.destructive }]}>
+          {decideError}
+        </Text>
+      ) : null}
+
+      {(notes.data ?? []).length > 0 ? (
+        <View style={{ gap: 8 }}>
+          <Text style={[styles.sectionLabel, { color: native.secondaryLabel }]}>它自己的笔记</Text>
+          {(notes.data ?? []).map((note) => (
+            <Pressable
+              key={note.id}
+              accessibilityRole="button"
+              onPress={() => {
+                hapticSelection();
+                router.push({ pathname: "/memory-note", params: { id: note.id, botId } });
+              }}
+              style={({ pressed }) => [
+                styles.card,
+                { backgroundColor: native.groupedCell, opacity: pressed ? 0.7 : 1 },
+              ]}
+            >
+              <View style={styles.cardBody}>
+                <Text numberOfLines={1} style={[styles.cardTitle, { color: native.label }]}>
+                  {note.path}
+                </Text>
+                <Text
+                  numberOfLines={1}
+                  style={[styles.cardDetail, { color: native.secondaryLabel }]}
+                >
+                  {firstLine(note.content) || "空笔记"}
+                </Text>
+              </View>
+              <NativeSymbol
+                ios="chevron.right"
+                android="chevron-forward"
+                size={14}
+                color={native.tertiaryLabel}
+              />
+            </Pressable>
+          ))}
+        </View>
+      ) : null}
+
+      {!pending.isLoading &&
+      written.length === 0 &&
+      waiting.length === 0 &&
+      byDay.length === 0 &&
+      (notes.data ?? []).length === 0 ? (
+        <Text style={[styles.empty, { color: tokens.mutedForeground }]}>
+          还没有复盘，也没有它记下的笔记。聊几天之后，这里会出现它记住的东西。
+        </Text>
+      ) : null}
+    </View>
+  );
+}
+
+/**
+ * One stretch of this chat, as it was written up afterwards: the day and the messages it covers,
+ * what came of it, what it left open, and the one tap back to where it starts.
+ */
+function DiaryCard({
+  diary,
+  body,
+  opened,
+  onOpen,
+  onJump,
+}: {
+  diary: DiarySummary;
+  /** The full record, once the opened card has read it. */
+  body?: string;
+  opened: boolean;
+  onOpen: () => void;
+  onJump: () => void;
+}) {
+  const tokens = useMobileTokens();
+  const hooks = diary.openHooks;
+  // A long stretch says how many hooks are still open; the first two are worth reading at once.
+  const shownHooks = opened ? hooks : hooks.slice(0, 2);
+  return (
+    <View style={[styles.card, styles.stack, { backgroundColor: native.groupedCell }]}>
+      <Pressable
+        accessibilityRole="button"
+        accessibilityLabel={`${diary.title}，${diary.summary}`}
+        onPress={onOpen}
+        style={{ gap: 3 }}
+      >
+        <Text style={[styles.dayLabel, { color: native.tertiaryLabel }]}>{diarySpan(diary)}</Text>
+        <Text
+          numberOfLines={opened ? undefined : 2}
+          style={[styles.cardTitle, { color: native.label }]}
+        >
+          {diary.title}
+        </Text>
+        <Text
+          numberOfLines={opened ? undefined : 2}
+          style={[styles.learningText, { color: native.secondaryLabel }]}
+        >
+          {diary.summary}
+        </Text>
+      </Pressable>
+      {opened ? (
+        <Text style={[styles.learningText, { color: native.label }]}>
+          {body?.trim() || diary.summary}
+        </Text>
+      ) : null}
+      {shownHooks.length > 0 ? (
+        <View style={styles.hooks}>
+          {shownHooks.map((hook) => (
+            <View key={hook} style={[styles.hookChip, { backgroundColor: native.fill }]}>
+              <NativeSymbol
+                ios="circle.dashed"
+                android="ellipse-outline"
+                size={11}
+                color={tokens.warning}
+              />
+              <Text numberOfLines={1} style={[styles.hookText, { color: native.secondaryLabel }]}>
+                {hook}
+              </Text>
+            </View>
+          ))}
+          {!opened && hooks.length > shownHooks.length ? (
+            <Text style={[styles.hookText, { color: native.tertiaryLabel }]}>
+              +{hooks.length - shownHooks.length}
+            </Text>
+          ) : null}
+        </View>
+      ) : null}
+      {opened ? (
+        <Pressable
+          accessibilityRole="button"
+          accessibilityLabel="跳回原对话"
+          onPress={onJump}
+          style={({ pressed }) => [styles.jumpRow, { opacity: pressed ? 0.6 : 1 }]}
+        >
+          <NativeSymbol
+            ios="arrow.uturn.backward"
+            android="return-up-back-outline"
+            size={14}
+            color={tokens.accent}
+          />
+          <Text style={[styles.link, { color: tokens.accent }]}>跳回原对话</Text>
+        </Pressable>
+      ) : null}
+    </View>
+  );
+}
+
+/** "11月16日 23:41 · #120-#134 · 15 条消息": the day it happened and the stretch it covers. */
+function diarySpan(diary: DiarySummary): string {
+  const day = /^(\d{4})-(\d{2})-(\d{2})$/.exec(diary.day);
+  const date = day ? `${Number(day[2])}月${Number(day[3])}日` : diary.day;
+  const at = new Date(diary.createdAt);
+  const time = Number.isNaN(at.getTime())
+    ? ""
+    : at.toLocaleTimeString(dateLocaleForUi(), { hour: "numeric", minute: "2-digit" });
+  const range =
+    diary.endSeq > diary.startSeq ? `#${diary.startSeq}-#${diary.endSeq}` : `#${diary.startSeq}`;
+  return [date, time, range, diary.messageCount > 0 ? `${diary.messageCount} 条消息` : ""]
+    .filter(Boolean)
+    .join(" · ");
+}
+
+function firstLine(text: string | null | undefined): string {
+  return (text ?? "").split("\n")[0]?.trim() ?? "";
+}
+
+/** When the schedule runs next, in the shortest form that still reads as time. */
+export function nextRun(routine: Pick<Routine, "active" | "nextRunAt">, now = Date.now()): string {
+  if (!routine.active || !routine.nextRunAt) return "";
+  const at = new Date(routine.nextRunAt).getTime();
+  if (!Number.isFinite(at)) return "";
+  const minutes = Math.round((at - now) / 60_000);
+  if (minutes <= 0) return "马上跑";
+  if (minutes < 60) return `下次 ${minutes} 分钟后`;
+  const hours = Math.round(minutes / 60);
+  if (hours < 24) return `下次 ${hours} 小时后`;
+  return `下次 ${Math.round(hours / 24)} 天后`;
+}
+
+const styles = StyleSheet.create({
+  segments: {
+    flexDirection: "row",
+    alignItems: "center",
+    borderRadius: 12,
+    borderCurve: "continuous",
+    padding: 3,
+    gap: 3,
+  },
+  segment: { flex: 1, height: 34, alignItems: "center", justifyContent: "center", borderRadius: 9 },
+  segmentOn: {
+    shadowColor: "#000000",
+    shadowOpacity: 0.18,
+    shadowRadius: 4,
+    shadowOffset: { width: 0, height: 1 },
+  },
+  card: {
+    flexDirection: "row",
+    alignItems: "center",
+    gap: 12,
+    borderRadius: 14,
+    borderCurve: "continuous",
+    paddingHorizontal: 14,
+    paddingVertical: 12,
+  },
+  stack: { flexDirection: "column", alignItems: "stretch", gap: 10 },
+  cardBody: { flex: 1, minWidth: 0, gap: 3 },
+  cardTitle: { fontSize: 15, fontWeight: "600" },
+  cardDetail: { fontSize: 13 },
+  sectionLabel: { fontSize: 13, fontWeight: "600", paddingHorizontal: 4 },
+  dayLabel: { fontSize: 12, paddingHorizontal: 4 },
+  empty: { fontSize: 14, lineHeight: 20, paddingHorizontal: 4 },
+  error: { fontSize: 13, paddingHorizontal: 4 },
+  learningText: { fontSize: 15, lineHeight: 21 },
+  actions: { flexDirection: "row", gap: 10 },
+  approve: {
+    alignItems: "center",
+    borderRadius: 10,
+    borderCurve: "continuous",
+    flex: 1,
+    height: 36,
+    justifyContent: "center",
+  },
+  approveText: { fontSize: 15, fontWeight: "600" },
+  reject: {
+    alignItems: "center",
+    borderRadius: 10,
+    borderCurve: "continuous",
+    height: 36,
+    justifyContent: "center",
+    paddingHorizontal: 18,
+  },
+  rejectText: { fontSize: 15, fontWeight: "500" },
+  linkRow: { paddingVertical: 6, alignItems: "flex-start" },
+  link: { fontSize: 14, fontWeight: "500" },
+  mark: { width: 18, alignItems: "center", justifyContent: "center" },
+  trail: { alignItems: "flex-end", justifyContent: "center", gap: 2 },
+  cardMeta: { fontSize: 11, fontVariant: ["tabular-nums"] },
+  hooks: { flexDirection: "row", flexWrap: "wrap", alignItems: "center", gap: 6 },
+  hookChip: {
+    flexDirection: "row",
+    alignItems: "center",
+    gap: 4,
+    maxWidth: "100%",
+    borderRadius: 8,
+    borderCurve: "continuous",
+    paddingHorizontal: 7,
+    paddingVertical: 3,
+  },
+  hookText: { fontSize: 12, flexShrink: 1 },
+  jumpRow: { flexDirection: "row", alignItems: "center", gap: 5, paddingTop: 2 },
+});
