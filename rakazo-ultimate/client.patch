+// @vitest-environment jsdom
+
+import type { ReactNode } from "react";
+import { act, createElement } from "react";
+import type { Root } from "react-dom/client";
+import { createRoot } from "react-dom/client";
+import { afterEach, beforeEach, expect, it, vi } from "vitest";
+import { ConnectionModelList } from "../components/connection-model-list";
+
+// The list's own logic under test; native rows render as plain text.
+vi.mock("react-native", () => ({ AccessibilityInfo: { announceForAccessibility: () => {} } }));
+vi.mock("../components/list-search-input", () => ({ ListSearchInput: () => null }));
+vi.mock("../components/settings-group", async () => {
+  const { createElement: h } = await import("react");
+  return {
+    SettingsGroup: ({ children }: { children?: ReactNode }) => h("ul", null, children),
+    SettingsRow: ({ title, detail }: { title: string; detail?: string }) =>
+      h("li", null, h("span", null, title), detail ? h("small", null, detail) : null),
+  };
+});
+
+const models = [
+  { id: "gpt-4o", label: "gpt-4o", settings: { contextWindow: 128_000, images: true } },
+  { id: "long-text", label: "long-text", settings: { contextWindow: 1_048_576, images: false } },
+  { id: "mystery-1", label: "mystery-1" },
+];
+
+let root: Root | undefined;
+let container: HTMLDivElement;
+
+beforeEach(() => {
+  vi.stubGlobal("IS_REACT_ACT_ENVIRONMENT", true);
+  container = document.createElement("div");
+  document.body.append(container);
+});
+afterEach(() => {
+  act(() => root?.unmount());
+  root = undefined;
+  container.remove();
+  vi.unstubAllGlobals();
+});
+
+async function render(showCapabilities?: boolean) {
+  root = createRoot(container);
+  await act(async () => {
+    root?.render(
+      createElement(ConnectionModelList, { models, onOpen: () => {}, showCapabilities }),
+    );
+  });
+  return container.textContent ?? "";
+}
+
+it("shows each third-party model's context and image support, and unknown when unknown", async () => {
+  const text = await render(true);
+  expect(text).toContain("128K context · Reads images");
+  expect(text).toContain("1M context · Text only");
+  expect(text).toContain("Context unknown · Image support unknown");
+});
+
+it("shows no capability line for catalog providers", async () => {
+  const text = await render(false);
+  expect(text).toContain("gpt-4o");
+  expect(text).not.toContain("context");
+  expect(text).not.toContain("Image support");
+});
diff --git a/apps/mobile/lib/count-label.ts b/apps/mobile/lib/count-label.ts
