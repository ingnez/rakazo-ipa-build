@@ -0,0 +1,81 @@
+import { t } from "@lingui/core/macro";
+
+/**
+ * A bot's soul is how it talks — its temper, its pace, the words it reaches for — kept apart from
+ * what it is told to do. These presets are starting points: one tap writes a whole way of speaking
+ * into the field, where it stays an ordinary string the person can rewrite or empty.
+ */
+export type BotSoulPreset = { key: string; label: string; soul: string };
+
+export function botSoulPresets(): BotSoulPreset[] {
+  return [
+    {
+      key: "brisk",
+      label: t`Brisk`,
+      soul: t`You are upbeat and quick. You talk with energy, give the answer first and the details after, and push things forward without being asked. Short, warm sentences; no pleasantries, and never a call-centre script.`,
+    },
+    {
+      key: "gentle",
+      label: t`Gentle`,
+      soul: t`You are gentle and patient. You notice how the other person feels and answer that first, then get to the matter. Softer, shorter sentences; no lectures and no empty comfort — you stay with them and help them sort it out.`,
+    },
+    {
+      key: "witty",
+      label: t`Sharp wit`,
+      soul: t`You are quick-tongued and funny. A well-placed joke or a little teasing keeps the conversation alive, but never at the other person's expense and never instead of the answer. Serious things still get said plainly.`,
+    },
+    {
+      key: "composed",
+      label: t`Composed`,
+      soul: t`You are calm and precise, the steady professional in the room. Plain words, the facts first and your judgement after; you say so when you are unsure and never oversell. Few exclamation marks, no small talk.`,
+    },
+    {
+      key: "friend",
+      label: t`Straight-talking friend`,
+      soul: t`You talk like an old friend: direct, everyday words, no circling around. Honest but considerate — you say the awkward thing when it matters, and you drop the lecture.`,
+    },
+  ];
+}
+
+/**
+ * The soul the page edits: a server from before this field answers without it, and null means the
+ * person cleared it. Both read as empty here, so nothing on the page has to guard against them.
+ */
+export function soulOf(bot: { soul?: string | null } | null | undefined): string {
+  return bot?.soul ?? "";
+}
+
+/** The preset the field holds word for word, if any; a preset is recognised by its text. */
+export function soulPresetFor(
+  soul: string,
+  presets: BotSoulPreset[] = botSoulPresets(),
+): BotSoulPreset | undefined {
+  const text = soul.trim();
+  if (!text) return undefined;
+  return presets.find((preset) => preset.soul.trim() === text);
+}
+
+/** A tap fills the field with that way of speaking, or empties it when it is already that one. */
+export function soulAfterPresetTap(current: string, preset: BotSoulPreset): string {
+  return current.trim() === preset.soul.trim() ? "" : preset.soul;
+}
+
+/**
+ * What the page sends for the soul: the field trimmed, and nothing at all while it still reads as
+ * the saved one. One rule for both the save button's own state and the `bots/update` payload, so
+ * the button can never offer a save the payload would leave out.
+ */
+export function soulEdits(
+  bot: { soul?: string | null } | null | undefined,
+  soul: string,
+): { soul?: string } {
+  const text = soul.trim();
+  return text === soulOf(bot).trim() ? {} : { soul: text };
+}
+
+export function soulIsDirty(
+  bot: { soul?: string | null } | null | undefined,
+  soul: string,
+): boolean {
+  return "soul" in soulEdits(bot, soul);
+}
