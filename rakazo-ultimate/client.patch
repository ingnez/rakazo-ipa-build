@@ -0,0 +1,35 @@
+import { readdirSync, readFileSync, statSync } from "node:fs";
+import { join } from "node:path";
+import { describe, expect, it } from "vitest";
+
+// React Native 0.88 removed these from release builds: the export is undefined there, so using
+// one throws at runtime even though tests that mock react-native pass. v24 crashed on launch
+// this way (InteractionManager on the home screen). Use lib/run-when-idle.ts instead.
+const REMOVED = ["InteractionManager"];
+const ROOT = join(__dirname, "..");
+const DIRS = ["app", "components", "lib", "hooks"];
+
+function sources(dir: string): string[] {
+  let entries: string[];
+  try {
+    entries = readdirSync(dir);
+  } catch {
+    return [];
+  }
+  return entries.flatMap((name) => {
+    const path = join(dir, name);
+    if (name === "node_modules") return [];
+    if (statSync(path).isDirectory()) return sources(path);
+    return /\.(ts|tsx)$/.test(name) && !/\.test\.(ts|tsx)$/.test(name) ? [path] : [];
+  });
+}
+
+describe("removed React Native APIs", () => {
+  it("are not used by app code", () => {
+    const offenders = DIRS.flatMap((dir) => sources(join(ROOT, dir))).filter((file) => {
+      const text = readFileSync(file, "utf8").replace(/\/\/.*$|\/\*[\s\S]*?\*\//gm, "");
+      return REMOVED.some((api) => new RegExp(`\\b${api}\\b`).test(text));
+    });
+    expect(offenders).toEqual([]);
+  });
+});
