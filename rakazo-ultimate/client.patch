@@ -0,0 +1,250 @@
+import { useNow } from "@rakazo/chat-ui/hooks";
+import { useEffect } from "react";
+import { Pressable, StyleSheet, Text, View } from "react-native";
+import Animated, {
+  useAnimatedStyle,
+  useReducedMotion,
+  useSharedValue,
+  withRepeat,
+  withTiming,
+} from "react-native-reanimated";
+import { mobileTokens } from "../../lib/appearance";
+import { hapticImpact } from "../../lib/haptics";
+import type { LedgerTask } from "../../lib/ledger-tasks";
+import { ledgerElapsed, ledgerOpenCount } from "../../lib/ledger-tasks";
+import { NativeSymbol } from "../native-symbol";
+
+const OPEN_MS = 220;
+
+/**
+ * How far below the Bot pill in the title the panel starts: close enough to read as the pill's own
+ * drawer, far enough not to touch it.
+ */
+export const LEDGER_PANEL_GAP = 7;
+
+/**
+ * The chat's background ledger, opened from the Bot pill in the title: one line per piece of work
+ * running behind the conversation — what it is, the step it is on, the model doing it, how long
+ * it has been going, and a way to stop it. It floats under the header, so the chat keeps its
+ * place; tapping anywhere else closes it.
+ */
+export function LedgerPanel({
+  open,
+  tasks,
+  topInset,
+  onClose,
+  onStop,
+  onOpenTask,
+  stopping,
+}: {
+  open: boolean;
+  tasks: LedgerTask[];
+  /** Where the panel starts: just under the header's own paper. */
+  topInset: number;
+  onClose: () => void;
+  onStop: (task: LedgerTask) => void;
+  /** A ledger row opens the steps its work actually took, without leaving the chat. */
+  onOpenTask?: (task: LedgerTask) => void;
+  /** Cards whose Stop was pressed, until their own update settles them. */
+  stopping: ReadonlySet<string>;
+}) {
+  const tokens = mobileTokens();
+  const reducedMotion = useReducedMotion();
+  const shown = useSharedValue(open ? 1 : 0);
+  // The times only tick while the ledger is open: a closed panel costs nothing.
+  const now = useNow(open ? 1_000 : null);
+  const working = ledgerOpenCount(tasks);
+  useEffect(() => {
+    shown.value = reducedMotion ? (open ? 1 : 0) : withTiming(open ? 1 : 0, { duration: OPEN_MS });
+  }, [open, reducedMotion, shown]);
+  const panelStyle = useAnimatedStyle(() => ({
+    opacity: shown.value,
+    transform: [{ translateY: (1 - shown.value) * -12 }],
+  }));
+  return (
+    <Animated.View
+      // A closed ledger keeps its place in the tree but takes no touch: the chat stays live.
+      pointerEvents={open ? "auto" : "none"}
+      style={[styles.layer, { top: topInset }, panelStyle]}
+    >
+      <Pressable
+        accessibilityElementsHidden
+        importantForAccessibility="no-hide-descendants"
+        onPress={onClose}
+        style={StyleSheet.absoluteFill}
+      />
+      <View
+        accessibilityLabel="进行中"
+        style={[styles.panel, { backgroundColor: tokens.card, borderColor: tokens.border }]}
+      >
+        <View style={styles.head}>
+          <Text style={[styles.headTitle, { color: tokens.foreground }]}>进行中</Text>
+          <Text style={[styles.headCount, { color: tokens.mutedForeground }]}>
+            {working > 0 ? `${working} 路在做` : tasks.length > 0 ? "刚做完" : "都做完了"}
+          </Text>
+        </View>
+        {tasks.length === 0 ? (
+          <Text style={[styles.empty, { color: tokens.mutedForeground }]}>
+            现在没有在做的任务。派了活，这里会显示每一路做到哪一步。
+          </Text>
+        ) : (
+          tasks.map((task) => (
+            <LedgerRow
+              key={task.id}
+              task={task}
+              now={now}
+              stopping={stopping.has(task.id)}
+              onStop={() => onStop(task)}
+              // Only a ledger row names a task the server can open; a card has no timeline.
+              onOpen={onOpenTask && task.taskId ? () => onOpenTask(task) : undefined}
+            />
+          ))
+        )}
+      </View>
+    </Animated.View>
+  );
+}
+
+function LedgerRow({
+  task,
+  now,
+  stopping,
+  onStop,
+  onOpen,
+}: {
+  task: LedgerTask;
+  now: number;
+  stopping: boolean;
+  onStop: () => void;
+  /** Opens this work's steps; absent on a row the server cannot open. */
+  onOpen?: () => void;
+}) {
+  const tokens = mobileTokens();
+  const elapsed = ledgerElapsed(task.startedAt, now);
+  const settled =
+    task.status !== undefined && task.status !== "queued" && task.status !== "running";
+  const body = (
+    <>
+      {settled ? (
+        <NativeSymbol
+          ios={task.status === "failed" ? "exclamationmark.circle" : "checkmark.circle"}
+          android={task.status === "failed" ? "alert-circle" : "checkmark-circle"}
+          size={13}
+          color={task.status === "failed" ? tokens.destructive : tokens.mutedForeground}
+        />
+      ) : (
+        <BreathingDot />
+      )}
+      <View style={styles.rowText}>
+        <Text numberOfLines={1} style={[styles.title, { color: tokens.foreground }]}>
+          {task.title}
+        </Text>
+        <Text numberOfLines={1} style={[styles.step, { color: tokens.mutedForeground }]}>
+          {settled ? (task.status === "failed" ? "没能做完" : "已完成") : (task.step ?? "正在开始")}
+        </Text>
+      </View>
+      <View style={styles.trailing}>
+        {elapsed ? (
+          <Text style={[styles.elapsed, { color: tokens.mutedForeground }]}>{elapsed}</Text>
+        ) : null}
+        {task.model ? (
+          <Text numberOfLines={1} style={[styles.model, { color: tokens.mutedForeground }]}>
+            {task.model}
+          </Text>
+        ) : null}
+        {task.stop && !settled ? (
+          <Pressable
+            accessibilityRole="button"
+            accessibilityLabel={`停止 ${task.title}`}
+            hitSlop={8}
+            disabled={stopping}
+            onPress={() => {
+              hapticImpact();
+              onStop();
+            }}
+          >
+            <Text
+              style={[
+                styles.stop,
+                { color: stopping ? tokens.mutedForeground : tokens.destructive },
+              ]}
+            >
+              {stopping ? "停止中…" : "停止"}
+            </Text>
+          </Pressable>
+        ) : null}
+      </View>
+    </>
+  );
+  if (!onOpen) {
+    return <View style={[styles.row, { borderTopColor: tokens.border }]}>{body}</View>;
+  }
+  return (
+    <Pressable
+      accessibilityRole="button"
+      accessibilityLabel={`${task.title}，看它做到哪一步`}
+      onPress={() => {
+        hapticImpact();
+        onOpen();
+      }}
+      style={({ pressed }) => [
+        styles.row,
+        { borderTopColor: tokens.border, opacity: pressed ? 0.7 : 1 },
+      ]}
+    >
+      {body}
+    </Pressable>
+  );
+}
+
+/** A dot that breathes while work runs, so a still panel still reads as alive. */
+function BreathingDot() {
+  const tokens = mobileTokens();
+  const reducedMotion = useReducedMotion();
+  const pulse = useSharedValue(1);
+  useEffect(() => {
+    if (reducedMotion) return;
+    pulse.value = withRepeat(withTiming(0.35, { duration: 900 }), -1, true);
+    return () => {
+      pulse.value = 1;
+    };
+  }, [pulse, reducedMotion]);
+  const style = useAnimatedStyle(() => ({ opacity: pulse.value }));
+  return <Animated.View style={[styles.dot, { backgroundColor: tokens.warning }, style]} />;
+}
+
+const styles = StyleSheet.create({
+  layer: { position: "absolute", left: 0, right: 0, bottom: 0, paddingHorizontal: 12 },
+  panel: {
+    borderRadius: 20,
+    borderCurve: "continuous",
+    borderWidth: StyleSheet.hairlineWidth,
+    paddingHorizontal: 14,
+    paddingVertical: 12,
+    gap: 2,
+    shadowColor: "#000000",
+    shadowOpacity: 0.24,
+    shadowRadius: 18,
+    shadowOffset: { width: 0, height: 8 },
+  },
+  head: { flexDirection: "row", alignItems: "center", justifyContent: "space-between", gap: 8 },
+  headTitle: { fontSize: 15, fontWeight: "600" },
+  headCount: { fontSize: 12, fontVariant: ["tabular-nums"] },
+  empty: { fontSize: 13, lineHeight: 18, paddingTop: 6, paddingBottom: 2 },
+  row: {
+    flexDirection: "row",
+    alignItems: "center",
+    gap: 10,
+    paddingTop: 10,
+    marginTop: 8,
+    borderTopWidth: StyleSheet.hairlineWidth,
+  },
+  dot: { width: 7, height: 7, borderRadius: 3.5 },
+  rowText: { flex: 1, minWidth: 0, gap: 2 },
+  title: { fontSize: 15, fontWeight: "600" },
+  step: { fontSize: 13 },
+  trailing: { alignItems: "flex-end", gap: 2, maxWidth: 132 },
+  elapsed: { fontSize: 11, fontVariant: ["tabular-nums"] },
+  model: { fontSize: 11 },
+  stop: { fontSize: 12, fontWeight: "600" },
+});
