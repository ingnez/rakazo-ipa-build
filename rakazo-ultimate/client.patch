+              />
+              <Text style={{ color: tokens.mutedForeground, fontSize: 8, marginTop: 2 }} numberOfLines={1}>
+                {bot.name}
+              </Text>
+            </View>
+          ))}
+        </View>
+
+        <Text style={label}>Main bot · states</Text>
+        <View style={{ flexDirection: "row", flexWrap: "wrap", gap: 8 }}>
+          {states.map((state) => (
+            <View key={state.key} style={{ alignItems: "center", width: 56 }}>
+              <OpenMinisBotAvatar
+                color="#D8B878"
+                name="小猪包"
+                id={`state-${state.key}`}
+                size={46}
+                chief
+                activity={state.activity}
+                motion="live"
+              />
+              <Text style={{ color: tokens.mutedForeground, fontSize: 9, marginTop: 2 }}>{state.name}</Text>
+            </View>
+          ))}
+        </View>
+
+        <Text style={label}>Edit appearance · 同一套真实组件</Text>
+        <View style={{ alignItems: "center", paddingVertical: 6 }}>
+          <OpenMinisBotAvatar color={look} name="咖啡师" id="picker-preview" size={112} motion="live" />
+        </View>
+        <BotLookPicker compact value={look} name="咖啡师" identity="picker-preview" onChange={setLook} />
+
+        <Text style={label}>Palette · {LUMEN_PALETTE.length}</Text>
+        <View style={{ flexDirection: "row", flexWrap: "wrap", gap: 12 }}>
+          {LUMEN_PALETTE.map((color, index) => (
+            <OpenMinisBotAvatar
+              key={color}
+              color={color}
+              name={LUMEN_TEAM[index]?.name ?? "Bot"}
+              id={`palette-${color}`}
+              size={44}
+              motion="still"
+            />
+          ))}
+        </View>
+
+        <Text style={label}>Bot list</Text>
+        {[
+          { id: "review-bot-1", name: "Research", note: "Found 3 papers on early sepsis bundles", color: "#8E7CFF" },
+          { id: "review-bot-2", name: "Inbox", note: "2 replies drafted, waiting for you", color: "#FF8A5B" },
+          { id: "review-bot-3", name: "Shift planner", note: "Night block: sleep 08:30–15:00", color: "#2FBF8F" },
+          { id: "review-bot-4", name: "Parcel", note: "Out for delivery", color: "#3A6DF0" },
+          { id: "review-bot-5", name: "Notes", note: "Saved", color: "#7FA7C9" },
+        ].map((row) => (
+          <View key={row.id} style={{ flexDirection: "row", alignItems: "center", paddingVertical: 8, gap: 12 }}>
+            <OpenMinisBotAvatar color={row.color} name={row.name} id={row.id} size={44} motion="lazy" />
+            <View style={{ flex: 1 }}>
+              <Text style={{ color: tokens.foreground, fontSize: 16, fontWeight: "600" }}>{row.name}</Text>
+              <Text style={{ color: tokens.mutedForeground, fontSize: 14 }} numberOfLines={1}>
+                {row.note}
+              </Text>
+            </View>
+          </View>
+        ))}
+      </ScrollView>
+    </GestureHandlerRootView>
+  );
+}
