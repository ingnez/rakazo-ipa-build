+import type { MessageBlock } from "@rakazo/contracts";
+import type { ImageArtifactPreviewTarget } from "../components/image-artifact-viewer";
+import type { MobileArtifactTarget } from "./artifact-open";
+import { ImageViewerIndex } from "./image-stack-layout";
+
+export type ImageGallerySession = {
+  threadTarget: MobileArtifactTarget;
+  items: ImageArtifactPreviewTarget[];
+  startIndex: number;
+  /** Attach this image to the composer and focus the input; the viewer closes first. */
+  onAsk?: (item: ImageArtifactPreviewTarget) => void;
+};
+
+let session: ImageGallerySession | null = null;
+
+export function setImageGallerySession(next: ImageGallerySession): ImageGallerySession {
+  const startIndex = ImageViewerIndex.clamp(next.startIndex, next.items.length);
+  session = { ...next, startIndex };
+  return session;
+}
+
+export function peekImageGallerySession(): ImageGallerySession | null {
+  return session;
+}
+
+export function clearImageGallerySession(): void {
+  session = null;
+}
+
+/** Build a session for a tapped image, including its siblings in the same message. */
+export function gallerySessionFor(
+  items: ImageArtifactPreviewTarget[],
+  tapped: ImageArtifactPreviewTarget,
+  threadTarget: MobileArtifactTarget,
+  onAsk?: (item: ImageArtifactPreviewTarget) => void,
+): ImageGallerySession {
+  const found = items.findIndex((item) => item.artifactId === tapped.artifactId);
+  // An image that is not in the gallery (an older message the list no longer holds) still opens,
+  // at the front, rather than opening the wrong picture.
+  const list = found >= 0 ? items : [tapped, ...items];
+  return setImageGallerySession({
+    threadTarget,
+    items: list.length ? list : [tapped],
+    startIndex: found >= 0 ? found : 0,
+    onAsk,
+  });
+}
+
+/**
+ * Every image in a thread — the person's and the bot's — in the order they were sent, so the
+ * full-screen viewer can be flipped through as one gallery from whichever image was tapped.
+ */
+export function threadImageGallery(
+  messages: readonly { blocks: readonly MessageBlock[] }[],
+  fallbackName: string,
+): ImageArtifactPreviewTarget[] {
+  const out: ImageArtifactPreviewTarget[] = [];
+  const seen = new Set<string>();
+  for (const message of messages) {
+    for (const block of message.blocks ?? []) {
+      if (block.kind !== "image" || !block.artifactId) continue;
+      const mimeType = block.mimeType ?? "image/png";
+      if (!mimeType.toLowerCase().startsWith("image/") || mimeType.toLowerCase().includes("svg")) {
+        continue;
+      }
+      if (seen.has(block.artifactId)) continue;
+      seen.add(block.artifactId);
+      out.push({ artifactId: block.artifactId, name: block.name ?? fallbackName, mimeType });
+    }
+  }
+  return out;
+}
