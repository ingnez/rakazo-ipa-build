+  const labels = { photo: t`Photo`, attachment: t`Attachment`, message: t`Message` };
+  const text = previewText(message, labels);
+  if (text !== labels.message) return text;
+  // The hidden prompt a delivery carries is never shown here, as the shared preview never does.
+  if (isDeliveryMessage(message.blocks)) return text;
+  const line = message.blocks.map(blockLine).find(Boolean);
+  return line ? compactReplyExcerpt(line) : text;
+}
+
+/** The first line a block leads with, for the cards that hold no ordinary text. */
+function blockLine(block: MessageBlock): string | undefined {
+  switch (block.kind) {
+    case "ask":
+      return block.text || block.detail;
+    case "choice":
+      return block.question;
+    case "card":
+      return block.lines.map((line) => `${line.k}: ${line.v}`).join(" · ");
+    case "voice_call":
+      return block.title;
+    case "call_request":
+      return block.reason;
+    case "app_connect":
+    case "connect":
+      return block.name;
+    case "computer":
+    case "meta":
+      return block.text;
+    default:
+      return undefined;
+  }
 }
 
