+ * and the bot keeps the look its name or id earns.
+ */
+export function parseOpenminisLook(
+  value: string | null | undefined,
+): { shape: number; color: number } | null {
+  const match = /^(#[0-9a-fA-F]{6})::shape_(\d{1,2})$/.exec(value ?? "");
+  if (!match) return null;
+  const shape = Number(match[2]);
