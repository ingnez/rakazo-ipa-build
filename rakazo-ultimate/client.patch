+        resolve({
+          attachments: [
+            { id: "w1", name: "w1.txt", mimeType: "text/plain", contentBase64: "aGk=" },
+          ],
+          skipped: [],
+          failedFiles: [],
+          sources: [files[0]!.uri],
+        });
+    }),
+  );
+  /** Settles the read in the warm link's layout phase, after its commit and before its effects. */
+  function SettleOnCommit({ botId }: { botId: string }) {
