--- /dev/null
+++ b/apps/mobile/components/send-progress-bar.tsx
@@ -0,0 +1,85 @@
+import { useEffect, useState } from "react";
+import { StyleSheet, View } from "react-native";
+import Animated, {
+  Easing,
+  useAnimatedStyle,
+  useSharedValue,
+  withRepeat,
+  withTiming,
+} from "react-native-reanimated";
+import { mobileTokens } from "../lib/appearance";
+
+/**
+ * How long a send stays quiet before it admits it is still going. A message usually lands in well
+ * under this, and a bar that appears and vanishes inside a moment reads as a glitch; past it, the
+ * bar is honest about a wait the user is starting to feel.
+ */
+export const SEND_PROGRESS_DELAY_MS = 2000;
+
+/** The bar the reference app draws: a 20 × 4 track with an 8 × 4 slider crossing it each second. */
+export const SEND_PROGRESS_BAR = { width: 20, height: 4, slider: 8, sweepMs: 1000 } as const;
+
+/** The bar under a message that is still on its way, shown only once the wait is worth mentioning. */
+export function SendProgressBar({ delayMs = SEND_PROGRESS_DELAY_MS }: { delayMs?: number }) {
+  const tokens = mobileTokens();
+  const [showing, setShowing] = useState(false);
+  const sweep = useSharedValue(0);
+
+  useEffect(() => {
+    const timer = setTimeout(() => setShowing(true), delayMs);
+    return () => clearTimeout(timer);
+  }, [delayMs]);
+
+  useEffect(() => {
+    if (!showing) return;
+    sweep.value = withRepeat(
+      withTiming(1, { duration: SEND_PROGRESS_BAR.sweepMs, easing: Easing.linear }),
+      -1,
+      false,
+    );
+    return () => {
+      sweep.value = 0;
+    };
+  }, [showing, sweep]);
+
+  const sliderStyle = useAnimatedStyle(() => ({
+    transform: [
+      {
+        translateX:
+          -SEND_PROGRESS_BAR.slider +
+          sweep.value * (SEND_PROGRESS_BAR.width + SEND_PROGRESS_BAR.slider),
+      },
+    ],
+  }));
+
+  if (!showing) return null;
+  return (
+    <View
+      accessibilityRole="progressbar"
+      accessibilityLabel="正在发送"
+      style={[styles.track, { backgroundColor: tokens.border }]}
+    >
+      <Animated.View
+        style={[
+          styles.slider,
+          { backgroundColor: tokens.mutedForeground },
+          sliderStyle,
+        ]}
+      />
+    </View>
+  );
+}
+
+const styles = StyleSheet.create({
+  track: {
+    width: SEND_PROGRESS_BAR.width,
+    height: SEND_PROGRESS_BAR.height,
+    borderRadius: SEND_PROGRESS_BAR.height / 2,
+    overflow: "hidden",
+  },
+  slider: {
+    width: SEND_PROGRESS_BAR.slider,
+    height: SEND_PROGRESS_BAR.height,
+    borderRadius: SEND_PROGRESS_BAR.height / 2,
+  },
+});
