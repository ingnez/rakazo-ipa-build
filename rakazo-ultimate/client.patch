diff --git a/packages/adapters/src/pi-runtime-quick-reply.test.ts b/packages/adapters/src/pi-runtime-quick-reply.test.ts
new file mode 100644
index 000000000..c75ff6e99
--- /dev/null
+++ b/packages/adapters/src/pi-runtime-quick-reply.test.ts
@@ -0,0 +1,230 @@
+import type { AgentRunRequest, ConnectorTool } from "@rakazo/adapter-kit";
+import { describe, expect, it } from "vitest";
+import { PiAgentRuntime } from "./pi-runtime.js";
+
+/**
+ * The fast tier is only worth having if it reaches the person before the real turn does, and
+ * costs nothing when the model is quick. Both are asserted on the runtime's own event stream.
+ */
+
+const ACK_MARKER = "QUICKLINE";
+
+function completionsReply(text: string): Response {
+  return new Response(
+    `data: ${JSON.stringify({
+      id: "fixture",
+      choices: [{ index: 0, delta: { role: "assistant", content: text }, finish_reason: "stop" }],
+    })}\n\ndata: [DONE]\n\n`,
+    { headers: { "content-type": "text/event-stream" } },
+  );
+}
+
+const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
+
+const compatible = {
+  provider: "openai-compatible",
+  id: "fixture",
+  baseUrl: "http://127.0.0.1:9/v1",
+  allowPrivateEndpoint: true,
+  contextWindow: 128_000,
+  maxTokens: 1024,
+} as const;
+
+/** A transport where the fast-tier call and the real turn answer at chosen speeds. */
+function transport(input: { ackMs: number; turnMs: number; ack: string; turn: string }) {
+  const calls: { quick: boolean; tools: number }[] = [];
+  const modelFetch: typeof globalThis.fetch = async (_input, init) => {
+    const body = String(init?.body ?? "");
+    const quick = body.includes(ACK_MARKER);
+    calls.push({ quick, tools: (JSON.parse(body || "{}").tools ?? []).length });
+    await sleep(quick ? input.ackMs : input.turnMs);
+    return completionsReply(quick ? input.ack : input.turn);
+  };
+  return { modelFetch, calls };
+}
+
+/** The real turn calls a tool first and only writes its answer after the tool result returns. */
+function toolFirstTransport(input: {
+  ackMs: number;
+  answerMs: number;
+  ack: string;
+  answer: string;
+  tool: string;
+}) {
+  const calls: { quick: boolean; tools: number }[] = [];
+  let realTurns = 0;
+  const modelFetch: typeof globalThis.fetch = async (_input, init) => {
+    const body = String(init?.body ?? "");
+    const quick = body.includes(ACK_MARKER);
+    calls.push({ quick, tools: (JSON.parse(body || "{}").tools ?? []).length });
+    if (quick) {
+      await sleep(input.ackMs);
+      return completionsReply(input.ack);
+    }
+    realTurns += 1;
+    if (realTurns === 1) return toolCallReply(input.tool, { query: "bots" });
+    await sleep(input.answerMs);
+    return completionsReply(input.answer);
+  };
+  return { modelFetch, calls };
+}
+
+function toolCallReply(name: string, args: Record<string, unknown>): Response {
+  const chunk = (delta: unknown, finish: string | null) =>
+    `data: ${JSON.stringify({
+      id: "fixture",
+      choices: [{ index: 0, delta, finish_reason: finish }],
+    })}\n\n`;
+  return new Response(
+    chunk(
+      {
+        role: "assistant",
+        tool_calls: [
+          {
+            index: 0,
+            id: "call-1",
+            type: "function",
+            function: { name, arguments: JSON.stringify(args) },
+          },
+        ],
+      },
+      null,
+    ) +
+      chunk({}, "tool_calls") +
+      "data: [DONE]\n\n",
+    { headers: { "content-type": "text/event-stream" } },
+  );
+}
+
+async function run(
+  input: Pick<AgentRunRequest, "quickReply"> & { tools?: AgentRunRequest["tools"] },
+  modelFetch: typeof globalThis.fetch,
+) {
+  const runtime = new PiAgentRuntime({ modelFetch });
+  const events: { type: string; text?: string }[] = [];
+  const started = Date.now();
+  const arrival: { text?: string; at: number }[] = [];
+  for await (const event of runtime.run(
+    {
+      botId: "bot",
+      threadId: "thread",
+      runId: `run-${Math.random()}`,
+      prompt: "把这个设成主 bot 吧",
+      instructions: "Answer briefly.",
+      history: [],
+      model: compatible,
+      ...input,
+      tools: input.tools ?? [],
+    },
+    {
+      operationId: "quick-reply-test",
+      traceId: "quick-reply-test",
+      spaceId: "space",
+      userId: "user",
+      signal: new AbortController().signal,
+    },
+  )) {
+    events.push(event);
+    if (event.type === "text" && event.text) arrival.push({ text: event.text, at: Date.now() - started });
+  }
+  return { events, arrival };
+}
+
+const notesTool: ConnectorTool = {
+  name: "notes_search",
+  description: "Search the notes in this workspace",
+  inputSchema: {
+    type: "object",
+    properties: { query: { type: "string" } },
+    required: ["query"],
+  },
+};
+
+describe("fast-tier opening line", () => {
+  it("reaches the chat before a slow turn's own answer", async () => {
+    const { modelFetch, calls } = transport({
+      ackMs: 10,
+      turnMs: 300,
+      ack: "好，我这就弄。",
+      turn: "已经设成主 bot 了。",
+    });
+    const { arrival, events } = await run(
+      { quickReply: { prompt: "把这个设成主 bot 吧", instructions: `${ACK_MARKER} one short line` } },
+      modelFetch,
+    );
+
+    expect(calls.filter((call) => call.quick)).toHaveLength(1);
+    // The fast call carries no tools: it only writes a line.
+    expect(calls.find((call) => call.quick)?.tools).toBe(0);
+    expect(arrival[0]?.text).toBe("好，我这就弄。");
+    expect(arrival.at(-1)?.text).toContain("已经设成主 bot 了。");
+    // The opening line is the first thing the person sees, by a wide margin.
+    expect(arrival[0]!.at + 200).toBeLessThan(arrival.at(-1)!.at);
+    // Both reach one reply, with the turn break that keeps them apart.
+    const texts = events.filter((event) => event.type === "text").map((event) => event.text);
+    expect(texts.join("")).toBe("好，我这就弄。已经设成主 bot 了。");
+    expect(events.some((event) => event.type === "turn")).toBe(true);
+  });
+
+  it("drops the line when the model answers first", async () => {
+    const { modelFetch, calls } = transport({
+      ackMs: 250,
+      turnMs: 5,
+      ack: "好，我这就弄。",
+      turn: "已经设成主 bot 了。",
+    });
+    const { events } = await run(
+      { quickReply: { prompt: "把这个设成主 bot 吧", instructions: `${ACK_MARKER} one short line` } },
+      modelFetch,
+    );
+    // Give the slow line every chance to arrive late.
+    await sleep(320);
+
+    const texts = events.filter((event) => event.type === "text").map((event) => event.text);
+    expect(texts.join("")).toBe("已经设成主 bot 了。");
+    expect(texts.join("")).not.toContain("好，我这就弄。");
+    expect(calls.some((call) => call.quick)).toBe(true);
+  });
+
+  it("speaks even when the turn calls a tool before it writes a word", async () => {
+    // The reported bug: Chief went straight to a tool call ("Checking your bots") and the fast
+    // line it had ready was dropped because a tool had run, leaving the person with silence.
+    const { modelFetch, calls } = toolFirstTransport({
+      ackMs: 120,
+      answerMs: 400,
+      ack: "好，我这就去建。",
+      answer: "建好了，它叫 Scout。",
+      tool: notesTool.name,
+    });
+    const { arrival, events } = await run(
+      {
+        quickReply: { prompt: "把这个设成主 bot 吧", instructions: `${ACK_MARKER} one short line` },
+        tools: [notesTool],
+      },
+      modelFetch,
+    );
+    await sleep(250);
+
+    // The turn really did call the tool, and only then answered.
+    expect(calls.some((call) => !call.quick && call.tools > 0)).toBe(true);
+    expect(calls.filter((call) => !call.quick)).toHaveLength(2);
+    const texts = events.filter((event) => event.type === "text").map((event) => event.text);
+    expect(texts.join("")).toContain("好，我这就去建。");
+    expect(texts.join("")).toContain("建好了，它叫 Scout。");
+    // The line still comes first and keeps its own turn.
+    expect(arrival[0]?.text).toBe("好，我这就去建。");
+    expect(events.some((event) => event.type === "turn")).toBe(true);
+  });
+
+  it("asks for no extra call when the run brings no opening line", async () => {
+    const { modelFetch, calls } = transport({
+      ackMs: 1,
+      turnMs: 1,
+      ack: "好，我这就弄。",
+      turn: "放在这里了。",
+    });
+    await run({}, modelFetch);
+    expect(calls).toHaveLength(1);
+    expect(calls[0]?.quick).toBe(false);
+  });
+});
