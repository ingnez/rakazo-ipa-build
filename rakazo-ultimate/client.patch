new file mode 100644
index 000000000..1b765cd4f
--- /dev/null
+++ b/apps/mobile/components/task-steps-sheet.tsx
@@ -0,0 +1,489 @@
+import type { TaskStep } from "@rakazo/contracts";
+import { useQuery } from "@tanstack/react-query";
+import * as Clipboard from "expo-clipboard";
+import { useCallback, useEffect, useMemo, useRef, useState } from "react";
+import type { ScrollViewInstance } from "react-native";
+import {
+  ActivityIndicator,
+  Modal,
+  Platform,
+  Pressable,
+  ScrollView,
+  StyleSheet,
+  Text,
+  View,
+} from "react-native";
+import { useSafeAreaInsets } from "react-native-safe-area-context";
+import { rpc } from "../lib/api";
+import { hapticImpact, hapticSuccess } from "../lib/haptics";
+import { ledgerModelLabel } from "../lib/ledger-tasks";
+import { useMobileTokens } from "../lib/native";
+import { queryClient, rpcQuery } from "../lib/query";
+import {
+  TASK_STEPS_POLL_MS,
+  taskDurationLabel,
+  taskElapsedLabel,
+  taskIsOpen,
+  taskStatusLabel,
+  taskTimelineSteps,
+} from "../lib/task-steps";
+import { errorText } from "../lib/user-error";
+import { NativeSymbol } from "./native-symbol";
+
+/**
+ * One piece of the back office's work, opened up: what it was handed, what the model said on the
+ * way, and every call it made — the command it ran, the file it read, how long each took and which
+ * one is still running. It is a page sheet over whatever the person was reading, so the chat (or
+ * the Bot's page) keeps its place underneath.
+ *
+ * A task still in hand is read again every couple of seconds, and stops being read the moment it
+ * settles; an open one can be stopped from here.
+ */
+export function TaskStepsSheet({
+  taskId,
+  botId,
+  onClose,
+}: {
+  /** The task to open; null keeps the sheet closed. */
+  taskId: string | null;
+  /** Whose work it is: what Stop names, and what the read is authorised against. */
+  botId: string;
+  onClose: () => void;
+}) {
+  const tokens = useMobileTokens();
+  const insets = useSafeAreaInsets();
+  const read = rpcQuery("threads/taskSteps", { taskId: taskId ?? "" });
+  const query = useQuery(
+    {
+      ...read,
+      enabled: Boolean(taskId),
+      // The work keeps moving while it is watched: read it again until it settles.
+      refetchInterval: (context) =>
+        taskIsOpen(context.state.data?.status) ? TASK_STEPS_POLL_MS : false,
+    },
+    queryClient,
+  );
+  const [stopping, setStopping] = useState(false);
+  const [copied, setCopied] = useState<string | null>(null);
+  const scroll = useRef<ScrollViewInstance>(null);
+  // The answer for the task that was open last is not this task's: only its own id counts.
+  const task = query.data && query.data.id === taskId ? query.data : undefined;
+  const steps = useMemo(() => taskTimelineSteps(task), [task]);
+  const open = taskIsOpen(task?.status);
+  const model = task ? (ledgerModelLabel(task.modelProvider, task.modelId) ?? "") : "";
+
+  // Opening another task starts clean: no copy toast, no stop in flight.
+  useEffect(() => {
+    setStopping(false);
+    setCopied(null);
+  }, [taskId]);
+
+  const copy = useCallback((detail: string) => {
+    void Clipboard.setStringAsync(detail)
+      .then(() => {
+        hapticSuccess();
+        setCopied(detail);
+      })
+      .catch(() => undefined);
+  }, []);
+
+  const stop = useCallback(() => {
+    if (!taskId || stopping) return;
+    hapticImpact();
+    setStopping(true);
+    void rpc("threads/stopHelper", { botId, taskId })
+      .catch(() => undefined)
+      .finally(() => {
+        setStopping(false);
+        void query.refetch();
+      });
+  }, [botId, query, stopping, taskId]);
+
+  const subtitle = task
+    ? [
+        (task.currentStep ?? "").trim() || taskStatusLabel(task.status),
+        taskElapsedLabel(task.elapsedMs),
+      ]
+        .filter(Boolean)
+        .join(" · ")
+    : "";
+
+  // A closed sheet costs nothing: no modal in the tree until a task is asked for.
+  if (!taskId) return null;
+
+  return (
+    <Modal
+      visible
+      animationType="slide"
+      presentationStyle="pageSheet"
+      onRequestClose={onClose}
+    >
+      <View
+        accessibilityViewIsModal
+        style={{
+          flex: 1,
+          backgroundColor: tokens.background,
+          paddingTop: Platform.OS === "ios" ? 12 : insets.top + 12,
+          paddingBottom: insets.bottom,
+        }}
+      >
+        <View style={styles.header}>
+          <Pressable
+            accessibilityRole="button"
+            accessibilityLabel="收起"
+            hitSlop={8}
+            onPress={onClose}
+            style={[styles.round, { backgroundColor: tokens.muted }]}
+          >
+            <NativeSymbol
+              ios="chevron.down"
+              android="chevron-down"
+              size={15}
+              color={tokens.foreground}
+            />
+          </Pressable>
+          <View style={styles.headText}>
+            <Text
+              accessibilityRole="header"
+              numberOfLines={2}
+              style={[styles.title, { color: tokens.foreground }]}
+            >
+              {task?.title?.trim() || "任务"}
+            </Text>
+            {subtitle ? (
+              <Text numberOfLines={1} style={[styles.subtitle, { color: tokens.accent }]}>
+                {subtitle}
+              </Text>
+            ) : null}
+          </View>
+          {open ? (
+            <Pressable
+              accessibilityRole="button"
+              accessibilityLabel="停止这个任务"
+              disabled={stopping}
+              hitSlop={8}
+              onPress={stop}
+              style={[styles.stopButton, { backgroundColor: tokens.muted }]}
+            >
+              <Text style={[styles.stopText, { color: tokens.destructive }]}>
+                {stopping ? "停止中…" : "停止"}
+              </Text>
+            </Pressable>
+          ) : (
+            <View style={styles.round} />
+          )}
+        </View>
+
+        <ScrollView
+          ref={scroll}
+          style={{ flex: 1 }}
+          contentContainerStyle={styles.body}
+          // A task still working keeps its newest step in sight; a settled one opens at its start.
+          onContentSizeChange={() => {
+            if (open) scroll.current?.scrollToEnd({ animated: false });
+          }}
+        >
+          {query.error ? (
+            <Text accessibilityRole="alert" style={[styles.error, { color: tokens.destructive }]}>
+              {errorText(query.error, "现在读不到这个任务的步骤")}
+            </Text>
+          ) : null}
+
+          {query.isPending && taskId ? (
+            <ActivityIndicator
+              accessibilityLabel="正在读"
+              color={tokens.mutedForeground}
+              style={{ paddingTop: 24 }}
+            />
+          ) : null}
+
+          {task ? (
+            <>
+              <View style={styles.chips}>
+                <Chip
+                  text={taskStatusLabel(task.status)}
+                  color={open ? tokens.accent : tokens.mutedForeground}
+                  background={tokens.muted}
+                />
+                {model ? (
+                  <Chip text={model} color={tokens.mutedForeground} background={tokens.muted} />
+                ) : null}
+                {task.attempt > 1 || task.redos > 0 ? (
+                  <Chip
+                    text={[
+                      task.attempt > 1 ? `第 ${task.attempt} 次` : "",
+                      task.redos > 0 ? `退回 ${task.redos} 次` : "",
+                    ]
+                      .filter(Boolean)
+                      .join(" · ")}
+                    color={tokens.mutedForeground}
+                    background={tokens.muted}
+                  />
+                ) : null}
+              </View>
+
+              {task.task.trim() && task.task.trim() !== task.title.trim() ? (
+                <View
+                  style={[
+                    styles.brief,
+                    { backgroundColor: tokens.card, borderColor: tokens.border },
+                  ]}
+                >
+                  <Text style={[styles.briefLabel, { color: tokens.mutedForeground }]}>交办</Text>
+                  <Text numberOfLines={4} style={[styles.briefText, { color: tokens.foreground }]}>
+                    {task.task.trim()}
+                  </Text>
+                </View>
+              ) : null}
+
+              {steps.length === 0 ? (
+                <Text style={[styles.empty, { color: tokens.mutedForeground }]}>
+                  这一步还没有记录，等它开始做就会出现。
+                </Text>
+              ) : (
+                <View>
+                  {steps.map((step, index) => (
+                    <StepRow
+                      key={step.id}
+                      step={step}
+                      first={index === 0}
+                      last={index === steps.length - 1}
+                      copied={copied === step.detail}
+                      onCopy={copy}
+                    />
+                  ))}
+                </View>
+              )}
+
+              {task.error ? (
+                <View
+                  style={[
+                    styles.brief,
+                    { backgroundColor: tokens.card, borderColor: tokens.border },
+                  ]}
+                >
+                  <Text style={[styles.briefLabel, { color: tokens.destructive }]}>报错</Text>
+                  <Text style={[styles.briefText, { color: tokens.foreground }]}>{task.error}</Text>
+                </View>
+              ) : null}
+
+              {!open && task.result?.trim() ? (
+                <View
+                  style={[
+                    styles.brief,
+                    { backgroundColor: tokens.card, borderColor: tokens.border },
+                  ]}
+                >
+                  <Text style={[styles.briefLabel, { color: tokens.mutedForeground }]}>结果</Text>
+                  <Text style={[styles.briefText, { color: tokens.foreground }]}>
+                    {task.result.trim()}
+                  </Text>
+                </View>
+              ) : null}
+            </>
+          ) : null}
+        </ScrollView>
+      </View>
+    </Modal>
+  );
+}
+
+function Chip({ text, color, background }: { text: string; color: string; background: string }) {
+  return (
+    <View style={[styles.chip, { backgroundColor: background }]}>
+      <Text numberOfLines={1} style={[styles.chipText, { color }]}>
+        {text}
+      </Text>
+    </View>
+  );
+}
+
+/** One line of the timeline: what it was, when, how long, and the address it reached. */
+function StepRow({
+  step,
+  first,
+  last,
+  copied,
+  onCopy,
+}: {
+  step: TaskStep;
+  first: boolean;
+  last: boolean;
+  copied: boolean;
+  onCopy: (detail: string) => void;
+}) {
+  const tokens = useMobileTokens();
+  const tool = step.kind === "tool";
+  const symbol = tool ? toolSymbol(step) : stepSymbol(step);
+  const failed = step.status === "failed";
+  const running = step.status === "running";
+  const ink = failed ? tokens.destructive : running ? tokens.foreground : tokens.mutedForeground;
+  return (
+    <View style={styles.step}>
+      <View style={styles.rail}>
+        <View
+          style={[
+            styles.railLine,
+            { backgroundColor: tokens.border },
+            first ? { top: 22 } : null,
+            last ? { bottom: undefined, height: 22 } : null,
+          ]}
+        />
+        <View style={styles.railIcon}>
+          <NativeSymbol ios={symbol.ios} android={symbol.android} size={14} color={ink} />
+        </View>
+      </View>
+      <View style={styles.stepBody}>
+        <View style={styles.stepHead}>
+          <Text
+            numberOfLines={tool ? 2 : 4}
+            style={[
+              styles.stepLabel,
+              { color: tool ? tokens.foreground : tokens.foreground },
+              tool ? styles.stepLabelTool : null,
+            ]}
+          >
+            {step.label}
+          </Text>
+          <View style={styles.stepTrail}>
+            {running ? (
+              <ActivityIndicator size="small" color={tokens.mutedForeground} />
+            ) : failed ? (
+              <NativeSymbol
+                ios="xmark"
+                android="close"
+                size={11}
+                color={tokens.destructive}
+                weight="semibold"
+              />
+            ) : step.durationMs !== undefined ? (
+              <Text style={[styles.stepTime, { color: tokens.mutedForeground }]}>
+                {taskDurationLabel(step.durationMs)}
+              </Text>
