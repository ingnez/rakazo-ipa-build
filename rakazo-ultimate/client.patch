--- /dev/null
+++ b/apps/mobile/lib/platform/open-url.ts
@@ -0,0 +1,19 @@
+import { bestEffort } from "@rakazo/logging/best-effort";
+import { Linking } from "react-native";
+
+/**
+ * Opens a link outside the app. The system can refuse even a web page (no default browser,
+ * restrictions, an app switch in progress), so a web page then opens in the in-app browser.
+ */
+export async function openExternalUrl(url: string): Promise<void> {
+  const opened = await bestEffort(
+    "open link",
+    // The executor turns an opener that throws synchronously into a rejection.
+    new Promise((resolve) => resolve(Linking.openURL(url))).then(() => true),
+  );
+  if (opened || !/^https?:\/\//i.test(url)) return;
+  await bestEffort(
+    "open link in browser",
+    import("expo-web-browser").then((browser) => browser.openBrowserAsync(url)),
+  );
+}
diff --git a/apps/mobile/lib/platform/startup-error.ts b/apps/mobile/lib/platform/startup-error.ts
new file mode 100644
index 000000000..e92b432f6
--- /dev/null
+++ b/apps/mobile/lib/platform/startup-error.ts
@@ -0,0 +1,158 @@
+import { sanitizedError } from "@rakazo/logging/monitoring";
+import type * as Application from "expo-application";
+import { API_BASE_STORAGE_KEY, DEFAULT_API } from "../api/server-config";
+
+export interface StartupErrorStorage {
+  getItem(key: string): string | null;
+  setItem(key: string, value: string): void;
+}
+
+export type NativeApplication = Pick<
+  typeof Application,
+  "applicationId" | "nativeApplicationVersion" | "nativeBuildVersion"
+>;
+
+const KEY = "rakazo.startup-error";
+const MAX_LENGTH = 8_192;
+const EXPO_LOG_KEY = "rakazo.expo-error-window";
+
+type ExpoErrorWindow = { server: string; since: number; reportedThrough: number };
+
+function readExpoErrorWindow(storage: StartupErrorStorage): ExpoErrorWindow | undefined {
+  const raw = storage.getItem(EXPO_LOG_KEY);
+  if (!raw || raw.length > 1_024) return;
+  const value = JSON.parse(raw) as Partial<ExpoErrorWindow> | null;
+  if (
+    value &&
+    typeof value.server === "string" &&
+    typeof value.since === "number" &&
+    Number.isFinite(value.since) &&
+    typeof value.reportedThrough === "number" &&
+    Number.isFinite(value.reportedThrough)
+  )
+    return value as ExpoErrorWindow;
+}
+
+/** Only errors recorded after a known server boundary can be replayed safely. */
+export function startExpoErrorWindow(
+  storage?: StartupErrorStorage,
+  base?: string,
+): ExpoErrorWindow | undefined {
+  if (!storage) return;
+  try {
+    const server = base ? new URL(base).origin : selectedServer(storage);
+    let existing: ExpoErrorWindow | undefined;
+    try {
+      existing = readExpoErrorWindow(storage);
+    } catch {
+      // A malformed checkpoint starts a new window; older logs have no established owner.
+    }
+    if (existing?.server === server) return existing;
+    const window = { server, since: Date.now(), reportedThrough: 0 };
+    storage.setItem(EXPO_LOG_KEY, JSON.stringify(window));
+    return window;
+  } catch {
+    return;
+  }
+}
+
+export function markExpoErrorReported(
+  timestamp: number,
+  storage: StartupErrorStorage | undefined,
+  base: string,
+): void {
+  if (!storage) return;
+  try {
+    const window = readExpoErrorWindow(storage);
+    if (!window || window.server !== new URL(base).origin) return;
+    window.reportedThrough = Math.max(window.reportedThrough, timestamp);
+    storage.setItem(EXPO_LOG_KEY, JSON.stringify(window));
+  } catch {
+    // A failed checkpoint leaves the report eligible for retry.
+  }
+}
+
+function selectedServer(storage: StartupErrorStorage): string {
+  return new URL(storage.getItem(API_BASE_STORAGE_KEY) || DEFAULT_API).origin;
+}
+
+/** Synchronous because React Native's fatal handler may terminate before a write promise runs. */
+export function saveStartupError(
+  error: unknown,
+  storage: StartupErrorStorage | undefined,
+  application: NativeApplication | undefined,
+): void {
+  if (!storage) return;
+  try {
+    const safe = sanitizedError(error);
+    const { applicationId, nativeApplicationVersion, nativeBuildVersion } = application ?? {};
+    const record = {
+      server: selectedServer(storage),
+      // The native SDK's default release, so the next launch reports the build that crashed.
+      ...(applicationId && nativeApplicationVersion && nativeBuildVersion
+        ? {
+            release: `${applicationId}@${nativeApplicationVersion}+${nativeBuildVersion}`,
+            dist: nativeBuildVersion,
+          }
+        : {}),
+      name: safe.name.slice(0, 128),
+      message: safe.message.slice(0, 1_024),
+      stack: safe.stack?.slice(0, 4_096),
+    };
+    let serialized = JSON.stringify(record);
+    if (serialized.length > MAX_LENGTH && record.stack) {
+      // Escaped characters can occupy several characters in JSON. Preserve the message
+      // and shorten the stack until the final record fits the reader's size limit.
+      record.stack = record.stack.slice(
+        0,
+        Math.max(0, record.stack.length - (serialized.length - MAX_LENGTH)),
+      );
+      serialized = JSON.stringify(record);
+    }
+    if (serialized.length <= MAX_LENGTH) storage.setItem(KEY, serialized);
+  } catch {
+    // Locked storage or a missing native host must not replace the original fatal error.
+  }
+}
+
+export function readStartupError(
+  storage?: StartupErrorStorage,
+): { error: Error; release?: string; dist?: string } | undefined {
+  if (!storage) return;
+  try {
+    const raw = storage.getItem(KEY);
+    if (!raw || raw.length > MAX_LENGTH) return;
+    const value: unknown = JSON.parse(raw);
+    if (!value || typeof value !== "object") return;
+    const stored = value as {
+      server?: unknown;
+      name?: unknown;
+      message?: unknown;
+      stack?: unknown;
+      release?: unknown;
+      dist?: unknown;
+    };
+    // A failed best-effort wipe must never send another server's report after a restart.
+    if (stored.server !== selectedServer(storage)) return;
+    if (typeof stored.message !== "string" || typeof stored.name !== "string") return;
+    const error = new Error(stored.message);
+    error.name = stored.name;
+    if (typeof stored.stack === "string") error.stack = stored.stack;
+    return {
+      error: sanitizedError(error),
+      release: typeof stored.release === "string" ? stored.release : undefined,
+      dist: typeof stored.dist === "string" ? stored.dist : undefined,
+    };
+  } catch {
+    return;
+  }
+}
+
+export function clearStartupError(storage?: StartupErrorStorage): void {
+  if (!storage) return;
+  try {
+    storage.setItem(KEY, "");
+  } catch {
+    // Reporting remains optional when secure storage is unavailable.
+  }
+}
diff --git a/apps/mobile/lib/platform/store-review.test.ts b/apps/mobile/lib/platform/store-review.test.ts
new file mode 100644
index 000000000..c83072dd2
--- /dev/null
+++ b/apps/mobile/lib/platform/store-review.test.ts
@@ -0,0 +1,206 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+const store = new Map<string, string>();
+const native = vi.hoisted(() => ({
+  os: "ios",
+  appState: "active",
+  appId: "com.rakazo.app" as string | null,
+  module: {} as object | null,
+  available: true,
+  requestReview: vi.fn(async () => undefined),
+  openUrl: vi.fn(async (_url: string) => undefined),
+}));
+
+const failRead = vi.hoisted(() => ({ on: false }));
+vi.mock("expo-secure-store", () => ({
+  getItemAsync: vi.fn(async (key: string) => {
+    if (failRead.on) throw new Error("keychain locked");
+    return store.get(key) ?? null;
+  }),
+  setItemAsync: vi.fn(async (key: string, value: string) => {
+    store.set(key, value);
+  }),
+}));
+vi.mock("react-native", () => ({
+  AppState: {
+    get currentState() {
+      return native.appState;
+    },
+  },
+  Platform: {
+    get OS() {
+      return native.os;
+    },
+  },
+}));
+vi.mock("expo-application", () => ({
+  get applicationId() {
+    return native.appId;
+  },
+}));
+vi.mock("expo-modules-core", () => ({ requireOptionalNativeModule: () => native.module }));
+vi.mock("expo-store-review", () => ({
+  isAvailableAsync: async () => native.available,
+  requestReview: native.requestReview,
+}));
+vi.mock("./open-url", () => ({ openExternalUrl: native.openUrl }));
+vi.mock("./store-update", () => ({ OFFICIAL_BUNDLE_ID: "com.rakazo.app" }));
+
+const DAY = 24 * 60 * 60_000;
+const start = new Date(2026, 10, 2, 12).getTime();
+
+async function load() {
+  const review = await import("./store-review");
+  review.resetStoreReviewForTests();
+  return review;
+}
+
+/** Two days of use with three runs watched finish, the last one just now. */
+async function engaged() {
+  const review = await load();
+  vi.setSystemTime(start);
+  await review.askForReviewIfDue(() => true);
+  review.noteRunCompleted();
+  review.noteRunCompleted();
+  vi.setSystemTime(start + DAY);
+  review.noteRunCompleted();
+  return review;
+}
+
+describe("store review prompt", () => {
+  beforeEach(() => {
+    store.clear();
+    vi.useFakeTimers({ toFake: ["Date"] });
+    vi.clearAllMocks();
+    failRead.on = false;
+    Object.assign(native, {
+      os: "ios",
+      appState: "active",
+      appId: "com.rakazo.app",
+      module: {},
+      available: true,
+    });
+  });
+
+  it("asks once the person has used the app on two days and watched three runs finish", async () => {
+    const review = await engaged();
+    await review.askForReviewIfDue(() => true);
+    expect(native.requestReview).toHaveBeenCalledOnce();
+
+    review.noteRunCompleted();
+    await review.askForReviewIfDue(() => true);
+    expect(native.requestReview).toHaveBeenCalledOnce();
+  });
+
+  it("waits for a second day of use", async () => {
+    const review = await load();
+    vi.setSystemTime(start);
+    for (let i = 0; i < 5; i++) review.noteRunCompleted();
+    await review.askForReviewIfDue(() => true);
+    expect(native.requestReview).not.toHaveBeenCalled();
+  });
+
+  it("asks only right after a run finished in this session", async () => {
+    const review = await engaged();
+    review.resetStoreReviewForTests();
+    await review.askForReviewIfDue(() => true);
+    expect(native.requestReview).not.toHaveBeenCalled();
+  });
+
+  it("asks again only after the wait, counting the saved state", async () => {
+    const first = await engaged();
+    await first.askForReviewIfDue(() => true);
+    first.resetStoreReviewForTests();
+
+    vi.setSystemTime(start + 30 * DAY);
+    first.noteRunCompleted();
+    await first.askForReviewIfDue(() => true);
+    expect(native.requestReview).toHaveBeenCalledOnce();
+
+    vi.setSystemTime(start + 125 * DAY);
+    first.noteRunCompleted();
+    await first.askForReviewIfDue(() => true);
+    expect(native.requestReview).toHaveBeenCalledTimes(2);
+  });
+
+  it("does not carry a run past a check that was not due yet", async () => {
+    const review = await load();
+    vi.setSystemTime(start);
+    for (let i = 0; i < 3; i++) review.noteRunCompleted();
+    await review.askForReviewIfDue(() => true);
+    vi.setSystemTime(start + DAY);
+    await review.askForReviewIfDue(() => true);
+    expect(native.requestReview).not.toHaveBeenCalled();
+  });
+
+  it("leaves the saved state alone when it cannot be read", async () => {
+    const review = await engaged();
+    await review.askForReviewIfDue(() => true);
+    const saved = store.get("rakazo.store-review");
+    review.resetStoreReviewForTests();
+
+    failRead.on = true;
+    review.noteRunCompleted();
+    await expect(review.askForReviewIfDue(() => true)).rejects.toThrow("keychain locked");
+    expect(store.get("rakazo.store-review")).toBe(saved);
+
+    failRead.on = false;
+    await review.askForReviewIfDue(() => true);
+    expect(native.requestReview).toHaveBeenCalledOnce();
+    expect(JSON.parse(store.get("rakazo.store-review") ?? "{}").askedAt).toBe(start + DAY);
+  });
+
+  it("keeps the chance when the inbox or the app left view before the prompt", async () => {
+    const review = await engaged();
+    await review.askForReviewIfDue(() => false);
+    native.appState = "background";
+    await review.askForReviewIfDue(() => true);
+    expect(native.requestReview).not.toHaveBeenCalled();
+    native.appState = "active";
+    await review.askForReviewIfDue(() => true);
+    expect(native.requestReview).toHaveBeenCalledOnce();
+  });
+
+  it.each([
+    ["a fork's build", { appId: "com.example.fork" }],
+    ["a build without the native module", { module: null }],
+    ["a store that cannot prompt", { available: false }],
+    ["the web", { os: "web" }],
+  ])("never asks on %s", async (_name, overrides) => {
+    Object.assign(native, overrides);
+    const review = await engaged();
+    await review.askForReviewIfDue(() => true);
+    expect(native.requestReview).not.toHaveBeenCalled();
+  });
+
+  it("treats an unreadable saved state as a fresh start", async () => {
+    const { parseReviewState } = await load();
+    expect(parseReviewState("{not json")).toEqual({
+      lastDay: null,
+      activeDays: 0,
+      completedRuns: 0,
+      askedAt: null,
+    });
+    expect(parseReviewState('{"activeDays":-1,"completedRuns":"3","askedAt":5}')).toEqual({
+      lastDay: null,
+      activeDays: 0,
+      completedRuns: 0,
+      askedAt: 5,
+    });
+  });
+
+  it("opens each store's write-a-review page, and none for a fork", async () => {
+    const review = await load();
+    review.openWriteReview();
+    expect(native.openUrl).toHaveBeenLastCalledWith(
+      "https://apps.apple.com/app/rakazo/id6801531099?action=write-review",
+    );
+    native.os = "android";
+    review.openWriteReview();
+    expect(native.openUrl).toHaveBeenLastCalledWith(
+      "https://play.google.com/store/apps/details?id=com.rakazo.app",
+    );
+    native.appId = "com.example.fork";
+    expect(review.writeReviewUrl()).toBeNull();
+  });
+});
