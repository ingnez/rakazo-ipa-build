+/**
+ * Rakazo's own avatar specification: the single source every renderer draws from.
+ *
+ * Nothing in this file was measured from, traced over or extracted out of another app. Every body
+ * is a recipe — a few numbers fed through the functions below — and every motion is a handful of
+ * keyframes written here by hand. The goal is the *feel* of a friendly, soft, two-eyed character,
+ * not anyone's geometry. Mobile, web and the server's push-notification image all read the same
+ * exports, so a bot looks the same everywhere it appears.
+ *
+ * Conventions shared with the renderers:
+ * - A body lives in a 200-unit box centred on the origin, y pointing down.
+ * - Its outline is a ring of `AVATAR_VERTICES` points, one per ray from the centre, starting
+ *   straight up and turning clockwise, so any two bodies morph vertex by vertex.
+ * - The eye pair is `[x, y, gap, length, thickness, eyeTiltDeg, pairTiltDeg]`; an eye tilt of 90
+ *   is upright and a pair tilt of 0 is level.
+ * - `budget[k]` is how far the eye pair may slide along the direction `k · 360/64°` measured from
+ *   due right (screen coordinates) and still sit wholly inside the body with a margin.
+ */
+
+import type { BotColorDef } from "@rakazo/contracts";
+import { BOT_COLOR_LIST } from "@rakazo/contracts";
+
+export const AVATAR_SPEC_VERSION = 1;
+export const AVATAR_VERTICES = 64;
+/** No body reaches closer than this to its 100-unit half box: 8% breathing room. */
+export const AVATAR_BODY_MAX_RADIUS = 92;
+/** The least skin kept between an eye and the body's outline, in body units. */
+export const AVATAR_EYE_MARGIN = 6;
+
+export type AvatarEyes = readonly [number, number, number, number, number, number, number];
+
+export interface AvatarBody {
+  readonly ring: readonly number[];
+  readonly eyes: AvatarEyes;
+  readonly budget: readonly number[];
+}
+
+/** A body recipe: a radius for every direction, `phi` measured clockwise from straight up. */
+type Recipe = (phi: number) => number;
+
+const TAU = Math.PI * 2;
+
+const superellipse =
+  (a: number, b: number, n: number): Recipe =>
+  (phi) => {
+    const s = Math.abs(Math.sin(phi)) / a;
+    const c = Math.abs(Math.cos(phi)) / b;
+    return 1 / Math.pow(Math.pow(s, n) + Math.pow(c, n), 1 / n);
+  };
+
+/** A regular polygon with `k` sides, its first corner `turn` radians clockwise from the top. */
+const polygon =
+  (k: number, turn = 0): Recipe =>
+  (phi) => {
+    const sector = TAU / k;
+    const local = (((phi - turn) % sector) + sector) % sector;
+    return Math.cos(Math.PI / k) / Math.cos(local - Math.PI / k);
+  };
+
+const bump = (centre: number, width: number, height: number) => (phi: number) => {
+  let d = Math.abs(phi - centre) % TAU;
+  if (d > Math.PI) d = TAU - d;
+  return 1 + height * Math.exp(-((d / width) ** 2));
+};
+
+const lobes =
+  (count: number, depth: number, turn = 0) =>
+  (phi: number) =>
+    1 + depth * Math.cos(count * (phi - turn));
+
+/** Top narrower (`t > 0`) or wider (`t < 0`) than the bottom. */
+const taper = (t: number) => (phi: number) => 1 - t * Math.cos(phi);
+
+const stretch =
+  (base: Recipe, sx: number, sy: number): Recipe =>
+  (phi) => {
+    // The radius of `base` scaled by (sx, sy), found along the same ray.
+    const x = Math.sin(phi) / sx;
+    const y = Math.cos(phi) / sy;
+    const inner = Math.atan2(x, y);
+    const scale = Math.hypot(x, y);
+    return base(inner) / scale;
+  };
+
+const flatBelow =
+  (base: Recipe, floor: number): Recipe =>
+  (phi) => {
+    const r = base(phi);
+    const down = -Math.cos(phi);
+    return down > 1e-6 ? Math.min(r, floor / down) : r;
+  };
+
+const times =
+  (base: Recipe, ...factors: ((phi: number) => number)[]): Recipe =>
+  (phi) =>
+    factors.reduce((r, f) => r * f(phi), base(phi));
+
+/** Rounds corners: a circular moving average over `width` radians of the radius. */
+function smoothRing(samples: number[], width: number): number[] {
+  const n = samples.length;
+  const half = Math.max(1, Math.round((width / TAU) * n));
+  const out: number[] = [];
+  for (let i = 0; i < n; i += 1) {
+    let sum = 0;
+    for (let j = -half; j <= half; j += 1) sum += samples[(i + j + n) % n]!;
+    out.push(sum / (2 * half + 1));
+  }
+  return out;
+}
+
+/**
+ * The 26 bodies, in the order a stored shape index counts. Each is an original recipe: a base
+ * outline, a few soft factors, and how much its corners are rounded.
+ */
+const RECIPES: ReadonlyArray<readonly [string, Recipe, number]> = [
+  ["hex", polygon(6, Math.PI / 6), 0.22],
+  ["wedge", stretch(polygon(3, 0), 1.05, 0.95), 0.34],
+  ["squircle", superellipse(1, 1, 4.2), 0.06],
+  ["tablet", superellipse(1, 0.8, 3.4), 0.06],
+  ["pebble", times(superellipse(1, 0.88, 2.3), lobes(3, 0.025, 0.4)), 0.1],
+  ["blob", times(() => 1, lobes(5, 0.04, 0.35)), 0.12],
+  ["teardrop", times(() => 0.86, bump(0, 0.55, 0.26), taper(-0.04)), 0.14],
+  [
+    "cloud",
+    flatBelow(
+      times(() => 1, lobes(6, 0.07, 0)),
+      0.72,
+    ),
+    0.1,
+  ],
+  ["bean", times(superellipse(1, 0.84, 2.2), bump((3 * Math.PI) / 2, 0.42, -0.13)), 0.12],
+  ["egg", times(superellipse(0.84, 1, 2), taper(0.09)), 0.04],
+  ["capsule", superellipse(0.6, 1, 2.6), 0.06],
+  ["cylinder", superellipse(0.8, 1, 5.5), 0.08],
+  ["gem", times(polygon(8, Math.PI / 8), taper(-0.06)), 0.18],
+  ["crystal", stretch(polygon(4, 0), 0.72, 1), 0.3],
+  ["shield", times(superellipse(0.92, 0.86, 3), bump(Math.PI, 0.5, 0.18)), 0.12],
+  ["dome", flatBelow(() => 1, 0.6), 0.16],
+  ["arch", flatBelow(superellipse(0.86, 1, 3.2), 0.72), 0.12],
+  [
+    "leaf",
+    times(superellipse(0.66, 1, 1.7), bump(0.6, 0.4, 0.1), bump(0.6 + Math.PI, 0.4, 0.1)),
+    0.12,
+  ],
+  ["square", superellipse(0.94, 0.94, 7), 0.1],
+  ["sparkle", (phi) => 0.6 + 0.4 * Math.abs(Math.cos(2 * phi)) ** 2.4, 0.18],
+  ["clover", times(() => 1, lobes(4, 0.15, Math.PI / 4)), 0.1],
+  ["flower", times(() => 1, lobes(6, 0.11, 0)), 0.08],
+  [
+    "heart",
+    times(
+      superellipse(1, 0.9, 2.1),
+      bump(0, 0.34, -0.22),
+      bump(Math.PI, 0.42, 0.14),
+      bump(0.8, 0.5, 0.06),
+      bump(-0.8, 0.5, 0.06),
+    ),
+    0.1,
+  ],
+  ["house", flatBelow(times(polygon(5, 0), bump(0, 0.3, 0.04)), 0.66), 0.2],
+  ["star", (phi) => 0.76 + 0.24 * Math.cos(5 * phi), 0.16],
+  ["pumpkin", times(superellipse(1, 0.84, 2.2), lobes(8, 0.045, 0), bump(0, 0.22, -0.08)), 0.06],
+];
+
+export const AVATAR_BODY_KEYS = RECIPES.map(([key]) => key) as readonly string[];
+
+/** A body's ring: one sample per ray, rounded, scaled so its farthest point sits at the limit. */
+export function avatarRing(recipe: Recipe, rounding: number): number[] {
+  const fine = 512;
+  const radii: number[] = [];
+  for (let i = 0; i < fine; i += 1) radii.push(Math.max(0.05, recipe((i / fine) * TAU)));
+  const soft = smoothRing(radii, rounding);
+  const peak = Math.max(...soft);
+  const ring: number[] = [];
+  for (let i = 0; i < AVATAR_VERTICES; i += 1) {
+    const r = (soft[(i * fine) / AVATAR_VERTICES]! / peak) * AVATAR_BODY_MAX_RADIUS;
+    const phi = (i / AVATAR_VERTICES) * TAU;
+    ring.push(round1(r * Math.sin(phi)), round1(-r * Math.cos(phi)));
+  }
+  return ring;
+}
+
+function round1(value: number): number {
+  return Math.round(value * 10) / 10 || 0;
+}
+
+function pointInRing(ring: readonly number[], x: number, y: number): boolean {
+  let inside = false;
+  const n = ring.length / 2;
+  for (let i = 0, j = n - 1; i < n; j = i, i += 1) {
+    const xi = ring[i * 2]!;
+    const yi = ring[i * 2 + 1]!;
+    const xj = ring[j * 2]!;
+    const yj = ring[j * 2 + 1]!;
+    if (yi > y !== yj > y && x < ((xj - xi) * (y - yi)) / (yj - yi) + xi) inside = !inside;
+  }
+  return inside;
+}
+
+function distanceToRing(ring: readonly number[], x: number, y: number): number {
+  let best = Infinity;
+  const n = ring.length / 2;
+  for (let i = 0; i < n; i += 1) {
+    const j = (i + 1) % n;
+    const ax = ring[i * 2]!;
+    const ay = ring[i * 2 + 1]!;
+    const bx = ring[j * 2]!;
+    const by = ring[j * 2 + 1]!;
+    const dx = bx - ax;
+    const dy = by - ay;
+    const t = Math.max(0, Math.min(1, ((x - ax) * dx + (y - ay) * dy) / (dx * dx + dy * dy || 1)));
+    best = Math.min(best, Math.hypot(x - (ax + t * dx), y - (ay + t * dy)));
+  }
+  return best;
+}
+
+/** Whether both upright eyes of a pair sit wholly inside the ring with `margin` to spare. */
+export function eyesInside(
+  ring: readonly number[],
+  eyes: AvatarEyes,
+  offsetX = 0,
+  offsetY = 0,
+  margin = AVATAR_EYE_MARGIN,
+): boolean {
+  const [x, y, gap, length, thickness] = eyes;
+  const radius = thickness / 2;
+  // Checked at the tallest face any expression draws, so no face can leave the body.
+  const reach = Math.max(0, (length - thickness) / 2) * AVATAR_FACE_STRETCH;
+  // The widest lid any expression lays across the face (`calm`), measured the same way.
+  const across = Math.max(0, length - thickness) * AVATAR_FACE_ACROSS;
+  const clear = (px: number, py: number) =>
+    pointInRing(ring, px, py) && distanceToRing(ring, px, py) >= radius + margin;
+  for (const side of [-1, 1]) {
+    const cx = x + offsetX + side * (gap / 2);
+    const cy = y + offsetY;
+    for (let k = 0; k <= 6; k += 1) {
+      if (!clear(cx, cy - reach + (2 * reach * k) / 6)) return false;
+      if (!clear(cx - across + (2 * across * k) / 6, cy)) return false;
+    }
+  }
+  return true;
+}
+
+/** How much taller than the resting lid the tallest expression (`surprised`) draws an eye. */
+export const AVATAR_FACE_STRETCH = 2.2;
+/** How far, as a share of the resting lid, the widest expression (`calm`) reaches across. */
+export const AVATAR_FACE_ACROSS = 0.95;
+
+/** The face every body starts from, before it is fitted inside that body. */
+export const AVATAR_BASE_EYES: AvatarEyes = [0, -8, 46, 42, 19, 90, 0];
+
+/**
+ * Fits the base face inside a ring. Shrinking is a last resort: the pair first tries a few heights
+ * near the middle, then narrows, and only then gets smaller. Fitting is a build-time rule, so no
+ * renderer ever needs a run-time clamp to keep an eye on the body.
+ */
+export function fitEyes(ring: readonly number[]): AvatarEyes {
+  const [, baseY, baseGap, baseLength, baseThickness] = AVATAR_BASE_EYES;
+  for (let scale = 1; scale >= 0.4; scale -= 0.02) {
+    for (const narrow of [1, 0.9, 0.8]) {
+      for (const dy of [0, 6, -6, 12, -12, 18, 24]) {
+        const eyes: AvatarEyes = [
+          0,
+          baseY + dy,
+          round1(baseGap * scale * narrow),
+          round1(baseLength * scale),
+          round1(baseThickness * Math.max(0.75, scale)),
+          90,
+          0,
+        ];
+        if (eyesInside(ring, eyes)) return eyes;
+      }
+    }
+  }
+  return [0, 0, 20, 16, 8, 90, 0];
+}
+
+/** How far the fitted pair may slide in each of the 64 directions, measured from due right. */
+export function gazeBudget(ring: readonly number[], eyes: AvatarEyes): number[] {
+  const budget: number[] = [];
+  for (let k = 0; k < AVATAR_VERTICES; k += 1) {
+    const angle = (k / AVATAR_VERTICES) * TAU;
+    const ux = Math.cos(angle);
+    const uy = Math.sin(angle);
+    let lo = 0;
+    let hi = 100;
+    for (let step = 0; step < 18; step += 1) {
+      const mid = (lo + hi) / 2;
+      if (eyesInside(ring, eyes, ux * mid, uy * mid, AVATAR_EYE_MARGIN * 0.5)) lo = mid;
+      else hi = mid;
+    }
+    budget.push(Math.floor(lo * 2) / 2);
+  }
+  return budget;
+}
+
+function buildBodies(): Record<string, AvatarBody> {
+  const bodies: Record<string, AvatarBody> = {};
+  for (const [key, recipe, rounding] of RECIPES) {
+    const ring = avatarRing(recipe, rounding);
+    const eyes = fitEyes(ring);
+    bodies[key] = { ring, eyes, budget: gazeBudget(ring, eyes) };
+  }
+  return bodies;
+}
+
+/** Every body, built once when the module loads (a few milliseconds). */
+export const AVATAR_BODIES: Readonly<Record<string, AvatarBody>> = buildBodies();
+
+/** The body a stored shape index means: indexes past the list wrap round it. */
+export function avatarBodyKey(shapeIndex: number): string {
+  const count = AVATAR_BODY_KEYS.length;
+  const index = ((Math.trunc(shapeIndex) % count) + count) % count;
+  return AVATAR_BODY_KEYS[index]!;
+}
+
+/** The ring as an SVG path, for renderers that draw a still body (push images, web). */
+export function avatarRingPath(ring: readonly number[], scale = 1, cx = 0, cy = 0): string {
+  const n = ring.length / 2;
+  const at = (i: number) =>
+    [cx + ring[(i % n) * 2]! * scale, cy + ring[(i % n) * 2 + 1]! * scale] as const;
+  // A closed Catmull-Rom spline through the ring, written as cubic Béziers.
+  let d = "";
+  for (let i = 0; i < n; i += 1) {
+    const p0 = at(i - 1 + n);
+    const p1 = at(i);
+    const p2 = at(i + 1);
+    const p3 = at(i + 2);
+    if (i === 0) d += `M${p1[0].toFixed(2)} ${p1[1].toFixed(2)}`;
+    const c1x = p1[0] + (p2[0] - p0[0]) / 6;
+    const c1y = p1[1] + (p2[1] - p0[1]) / 6;
+    const c2x = p2[0] - (p3[0] - p1[0]) / 6;
+    const c2y = p2[1] - (p3[1] - p1[1]) / 6;
+    d += `C${c1x.toFixed(2)} ${c1y.toFixed(2)} ${c2x.toFixed(2)} ${c2y.toFixed(2)} ${p2[0].toFixed(2)} ${p2[1].toFixed(2)}`;
+  }
+  return `${d}Z`;
+}
+
+/* ---------------------------------------------------------------------------------------------
+ * Colour. The twelve palette colours live in `BOT_COLOR_LIST` (`@rakazo/contracts`), because the
+ * server assigns from the same list it draws push portraits with; this spec reads them from there
+ * and derives the two-stop gradients, so the palette has one table and nothing here repeats it.
+ * ------------------------------------------------------------------------------------------- */
+
+/** The body colours a renderer offers, white excepted (it vanishes on the light page). */
+export const AVATAR_COLOR_NAMES: readonly string[] = BOT_COLOR_LIST.filter(
+  (color) => color.id !== "white",
+).map((color) => color.id);
+
+function paletteColor(id: string): BotColorDef {
+  return BOT_COLOR_LIST.find((color) => color.id === id)!;
+}
+
+/** The body's dark-page value: its own, or the palette's white for the black body. */
+function darkBody(color: BotColorDef): string {
+  return color.id === "black" ? paletteColor("white").hex : (color.darkHex ?? color.hex);
+}
+
+/** Mixes a `#rrggbb` colour toward white (`amount` > 0) or black (`amount` < 0) in sRGB. */
+function shade(hex: string, amount: number): string {
+  const value = Number.parseInt(hex.replace("#", "").slice(0, 6), 16);
+  const target = amount > 0 ? 255 : 0;
+  const t = Math.abs(amount);
+  const channel = (shift: number) => {
+    const c = (value >> shift) & 255;
+    return Math.round(c + (target - c) * t)
+      .toString(16)
+      .padStart(2, "0");
+  };
+  return `#${channel(16)}${channel(8)}${channel(0)}`.toUpperCase();
+}
+
+export const AVATAR_SOLIDS: Readonly<Record<string, { light: string; dark: string }>> =
+  Object.fromEntries(
+    AVATAR_COLOR_NAMES.map((id) => {
+      const color = paletteColor(id);
+      return [id, { light: color.hex, dark: darkBody(color) }];
+    }),
+  );
+
+/** A soft top-lit gradient around each solid: 18% lighter at the top, 12% deeper at the foot. */
+export const AVATAR_GRADIENTS: Readonly<
+  Record<string, { lightFrom: string; lightTo: string; darkFrom: string; darkTo: string }>
+> = Object.fromEntries(
+  AVATAR_COLOR_NAMES.map((id) => {
+    const solid = AVATAR_SOLIDS[id]!;
+    return [
+      id,
+      {
+        lightFrom: shade(solid.light, 0.18),
+        lightTo: shade(solid.light, -0.12),
+        darkFrom: shade(solid.dark, 0.12),
+        darkTo: shade(solid.dark, -0.18),
+      },
+    ];
+  }),
+);
+
+/** Top-left to bottom-right. */
+export const AVATAR_GRADIENT_ANGLE = 140;
+
+/** Relative luminance (WCAG) of a `#rrggbb` colour. */
+export function luminance(hex: string): number {
+  const value = Number.parseInt(hex.replace("#", "").slice(0, 6), 16);
+  const channel = (shift: number) => {
+    const c = ((value >> shift) & 255) / 255;
+    return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
+  };
+  return 0.2126 * channel(16) + 0.7152 * channel(8) + 0.0722 * channel(0);
+}
+
+export function contrastRatio(a: string, b: string): number {
+  const [hi, lo] = [luminance(a), luminance(b)].sort((x, y) => y - x) as [number, number];
+  return (hi + 0.05) / (lo + 0.05);
+}
+
+/** The eye ink for a body colour: whichever of near-black and white reads better on it. */
+export function avatarEyeInk(fill: string): string {
+  const dark = "#121214";
+  const light = "#FFFFFF";
+  return contrastRatio(fill, dark) >= contrastRatio(fill, light) ? dark : light;
+}
+
+/* ---------------------------------------------------------------------------------------------
+ * Faces: each eye is a quadratic lid curve in eye units (p0 → p1 → p2), written for this app.
+ * ------------------------------------------------------------------------------------------- */
+
+export interface AvatarFaceSpec {
+  p0: readonly [number, number];
+  p1: readonly [number, number];
+  p2: readonly [number, number];
+  isArc: boolean;
+}
+
+export const AVATAR_FACES: Readonly<Record<string, AvatarFaceSpec>> = {
+  neutral: { p0: [0, -0.15], p1: [0, 0], p2: [0, 0.15], isArc: false },
+  happy: { p0: [0.15, -0.03], p1: [0, 0.11], p2: [-0.15, -0.03], isArc: true },
+  surprised: { p0: [0, -0.2], p1: [0, 0], p2: [0, 0.2], isArc: false },
+  inspecting: { p0: [0, 0], p1: [0, 0], p2: [0, 0], isArc: false },
+  sad: { p0: [0.03, 0.12], p1: [0, 0], p2: [-0.03, -0.1], isArc: false },
+  sleepy: { p0: [-0.1, 0.02], p1: [0, -0.04], p2: [0.1, 0.02], isArc: false },
+  squinted: { p0: [-0.11, 0], p1: [0, 0], p2: [0.11, 0], isArc: false },
+  calm: { p0: [-0.26, 0.01], p1: [0, -0.02], p2: [0.26, 0.01], isArc: false },
+  confused: { p0: [0.02, 0.15], p1: [-0.14, 0], p2: [0.02, -0.15], isArc: false },
