+    store.set("rakazo.server_headers", JSON.stringify({ apiBase: ONE, headers: ACCESS }));
+    await loadApiBase();
+    expect(currentApiBase()).toBe(ONE);
+    expect(savedServers()).toEqual([]);
+    await resetApiBase();
+    expect(savedServers()).toEqual([{ apiBase: ONE, headers: ACCESS }]);
