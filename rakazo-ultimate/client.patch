+import { describe, expect, it } from "vitest";
+import { expandInlineLatex, expandMathInText, looksLikeMath, readMath } from "./markdown-latex";
+
+describe("readMath", () => {
+  it("reads the Greek letters a medical question turns on", () => {
+    expect(readMath("\\alpha")).toBe("α");
+    expect(readMath("\\beta + \\gamma")).toBe("β + γ");
+    expect(readMath("\\Delta P")).toBe("Δ P");
+  });
+
+  it("reads comparison and arithmetic commands as the signs", () => {
+    expect(readMath("\\pm 0.5")).toBe("± 0.5");
+    expect(readMath("\\le 1")).toBe("≤ 1");
+    expect(readMath("\\geq 1")).toBe("≥ 1");
+    expect(readMath("3 \\times 4 \\div 2")).toBe("3 × 4 ÷ 2");
+  });
+
+  it("keeps fractions and powers readable", () => {
+    expect(readMath("\\frac{1}{2}")).toBe("1/2");
+    expect(readMath("x^2")).toBe("x²");
+    expect(readMath("x_{i}")).toBe("xᵢ");
+    expect(readMath("10^{-3}")).toBe("10⁻³");
+    expect(readMath("a^{n+1}")).toBe("aⁿ⁺¹");
+    // A power with no Unicode form keeps its brackets rather than losing the meaning.
+    expect(readMath("a^{x y}")).toBe("a^(x y)");
+  });
+
+  it("takes the braces of \\text away and keeps the words", () => {
+    expect(readMath("\\text{mg/dL}")).toBe("mg/dL");
+    expect(readMath("\\left( \\alpha \\right)")).toBe("( α )");
+  });
+
+  it("drops the backslash of a command it does not know", () => {
+    expect(readMath("\\foo")).toBe("foo");
+  });
+});
+
+describe("looksLikeMath", () => {
+  it("takes a run with a command, or one shaped like an expression", () => {
+    expect(looksLikeMath("\\alpha")).toBe(true);
+    expect(looksLikeMath("x^2")).toBe(true);
+    expect(looksLikeMath("a=1")).toBe(true);
+  });
+
+  it("leaves money and prose between two dollars alone", () => {
+    expect(looksLikeMath("5 and ")).toBe(false);
+    expect(looksLikeMath("成本")).toBe(false);
+  });
+});
+
+describe("expandMathInText", () => {
+  it("turns the inline maths a bot writes into characters", () => {
+    expect(expandMathInText("内在活性 $\\alpha$ 等于")).toBe("内在活性 α 等于");
+    expect(expandMathInText("$\\alpha \\le 1$")).toBe("α ≤ 1");
+    expect(expandMathInText("剂量 \\(20\\) mg")).toBe("剂量 20 mg");
+  });
+
+  it("reads a display block without the doubled marks", () => {
+    expect(expandMathInText("$$\\frac{a}{b}$$")).toBe("a/b");
+  });
+
+  it("keeps a dollar that means money, and one that has no partner", () => {
+    expect(expandMathInText("$5 and $10")).toBe("$5 and $10");
+    expect(expandMathInText("花了 $20")).toBe("花了 $20");
+    expect(expandMathInText("\\$5")).toBe("$5");
+  });
+
+  it("leaves a plain sentence untouched", () => {
+    expect(expandMathInText("重症医学科的刷题")).toBe("重症医学科的刷题");
+  });
+});
+
+describe("expandInlineLatex", () => {
+  it("expands prose but leaves fenced and inline code as written", () => {
+    const message = [
+      "内在活性 $\\alpha$ 等于",
+      "```",
+      "echo $\\alpha$",
+      "```",
+      "跑 `$\\beta$` 这段",
+    ].join("\n");
+    expect(expandInlineLatex(message)).toBe(
+      ["内在活性 α 等于", "```", "echo $\\alpha$", "```", "跑 `$\\beta$` 这段"].join("\n"),
+    );
+  });
+
+  it("returns a message with nothing to expand as it is", () => {
+    const message = "你好，今天重症监护室 12 张床。";
+    expect(expandInlineLatex(message)).toBe(message);
+  });
+});
