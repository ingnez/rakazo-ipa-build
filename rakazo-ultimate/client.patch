+/** Where an avatar badge sits, and which badges a given surface may show.
+
+The home header keeps only the yellow main-bot star at the avatar's bottom-right.
+It never shows a green working/online dot on the avatar, and never a second dot
+after the name. List rows also have no online/working dots. Every other surface
+places at most one badge in a corner, and shows working/online at most once.
+*/
+
+export type AvatarBadgeKind = "main" | "lead" | "working" | "muted";
+export type AvatarBadgeCorner = "bottom-end" | "bottom-start" | "top-end";
+export type AvatarBadgeSurface = "home-hero" | "home-list" | "chat" | "default";
+
+export type AvatarBadgeFlags = {
+  main?: boolean;
+  /** The bot leads its folder: the flag takes a corner the star leaves free. */
+  lead?: boolean;
+  working?: boolean;
+  muted?: boolean;
+};
+
+export type PlacedAvatarBadge = {
+  kind: AvatarBadgeKind;
+  corner: AvatarBadgeCorner;
+};
+
+/**
+ * The home hero avatar's footprint, in points. The main character is the one thing the home screen
+ * leads with, and the finished art's own canvas carries the ignition's glow, so the footprint is
+ * the size the hero is drawn at (the manifest's `heroSizePt`), not the body inside it.
+ */
+export const HERO_AVATAR_SIZE = 96;
+
+/**
+ * The official-matching yellow star on a {@link HERO_AVATAR_SIZE} avatar.
+ * Measured from the owner's dark-mode home screenshot of the main bot.
+ * `innerRatio` / `relX` / `relY` are in body-diameter or body-radius units of
+ * the OpenMinis drawing (the SVG viewBox pads the body by 0.08 on each side).
+ */
+export const OPENMINIS_SVG_VIEWBOX_SPAN = 1.16;
+
+export const HERO_MAIN_BADGE = {
+  /** Yellow fill diameter as a fraction of the drawn body diameter. */
+  innerRatio: 0.2496,
+  /** Badge centre relative to the body centre, in body-radius units. */
+  relX: 0.8642,
+  relY: 0.9882,
+  /** Ring thickness as a fraction of the drawn body diameter. */
+  ringRatio: 0.031,
+  /** Star icon size as a fraction of the drawn body diameter. */
+  iconRatio: 0.18,
+  /** Screenshot yellow (close to iOS dark systemYellow), not the older orange. */
+  color: "#FFD600",
+} as const;
+
+export function mainBotBadgeLayout(avatarSize: number) {
+  const body = avatarSize / OPENMINIS_SVG_VIEWBOX_SPAN;
+  const radius = body / 2;
+  const inner = HERO_MAIN_BADGE.innerRatio * body;
+  const ring = Math.max(1.5, HERO_MAIN_BADGE.ringRatio * body);
+  const size = inner + 2 * ring;
+  const cx = avatarSize / 2 + HERO_MAIN_BADGE.relX * radius;
+  const cy = avatarSize / 2 + HERO_MAIN_BADGE.relY * radius;
+  return {
+    size,
+    icon: HERO_MAIN_BADGE.iconRatio * body,
+    ring,
+    end: avatarSize - (cx + size / 2),
+    bottom: avatarSize - (cy + size / 2),
+    color: HERO_MAIN_BADGE.color,
+  };
+}
+
+/**
+ * Pick corners for the badges a surface is allowed to show. `main` wins bottom-end;
+ * `muted` then `working` take the next free corner, or are dropped rather than overlap.
+ */
+export function placeAvatarBadges(
+  surface: AvatarBadgeSurface,
+  flags: AvatarBadgeFlags,
+): PlacedAvatarBadge[] {
+  const main = Boolean(flags.main);
+  const lead = Boolean(flags.lead);
+  const muted = Boolean(flags.muted);
+  const workingAllowed = surface !== "home-hero" && surface !== "home-list";
+  const working = workingAllowed && Boolean(flags.working);
+
+  const placed: PlacedAvatarBadge[] = [];
+  const taken = new Set<AvatarBadgeCorner>();
+  const put = (
+    kind: AvatarBadgeKind,
+    preferred: AvatarBadgeCorner,
+    fallback: AvatarBadgeCorner,
+  ) => {
+    const corner = taken.has(preferred) ? fallback : preferred;
+    if (taken.has(corner)) return;
+    taken.add(corner);
+    placed.push({ kind, corner });
+  };
+
+  if (main) put("main", "bottom-end", "top-end");
+  if (lead) put("lead", "top-end", "bottom-start");
+  if (muted) put("muted", "bottom-end", "top-end");
+  if (working) put("working", "bottom-end", "bottom-start");
+  return placed;
+}
+
+/** The home hero never draws a state dot after the name, even when the bot is working or unread. */
+export function homeHeroNameStateDot(): null {
+  return null;
+}
+
+export function styleForAvatarBadgeCorner(
+  corner: AvatarBadgeCorner,
+  inset: { end: number; start: number; bottom: number; top?: number },
+): { end?: number; start?: number; bottom?: number; top?: number } {
+  const vertical =
+    corner === "top-end" ? { top: inset.top ?? inset.end } : { bottom: inset.bottom };
+  if (corner === "bottom-start") return { start: inset.start, ...vertical };
+  return { end: inset.end, ...vertical };
+}
