diff --git a/apps/desktop/src/main/windows/second-instance.ts b/apps/desktop/src/main/windows/second-instance.ts
new file mode 100644
index 000000000..8830bef8e
--- /dev/null
+++ b/apps/desktop/src/main/windows/second-instance.ts
@@ -0,0 +1,16 @@
+import type { BrowserWindow } from "electron";
+
+/** The window a duplicate launch raises: setup while onboarding, main after. */
+export function secondInstanceWindow(
+  setupWindow: BrowserWindow | null,
+  mainWindow: BrowserWindow | null,
+): BrowserWindow | null {
+  const win = setupWindow !== null && !setupWindow.isDestroyed() ? setupWindow : mainWindow;
+  return win !== null && !win.isDestroyed() ? win : null;
+}
+
+export function revealSecondInstanceWindow(win: BrowserWindow): void {
+  if (win.isMinimized()) win.restore();
+  win.show();
+  win.focus();
+}
diff --git a/apps/desktop/src/main/windows/window-controls.ts b/apps/desktop/src/main/windows/window-controls.ts
new file mode 100644
index 000000000..c6783b3b5
--- /dev/null
+++ b/apps/desktop/src/main/windows/window-controls.ts
@@ -0,0 +1,35 @@
+import { BrowserWindow } from "electron";
+import type { IpcCaller } from "../ipc/ipc.js";
+import { handleIpc } from "../ipc/ipc.js";
+
+/**
+ * Each acts on the window that sent the call, never on the app window: the page a server switch
+ * is replacing may call these too, and its buttons must not move the window that replaces it.
+ */
+export function registerWindowControls() {
+  const windowFrom = (event: IpcCaller) => BrowserWindow.fromWebContents(event.sender);
+  handleIpc("desktop.window.close", (event) => {
+    windowFrom(event)?.close();
+  });
+  handleIpc("desktop.window.minimize", (event) => {
+    windowFrom(event)?.minimize();
+  });
+  handleIpc("desktop.window.toggleMaximize", (event) => {
+    const win = windowFrom(event);
+    if (!win) return;
+    if (win.isMaximized() || win.isFullScreen()) {
+      win.setFullScreen(false);
+      if (win.isMaximized()) win.unmaximize();
+    } else {
+      win.maximize();
+    }
+  });
+  handleIpc("desktop.window.state", (event) => {
+    const win = windowFrom(event);
+    return {
+      minimized: win?.isMinimized() ?? false,
+      maximized: win?.isMaximized() ?? false,
+      fullScreen: win?.isFullScreen() ?? false,
+    };
+  });
+}
