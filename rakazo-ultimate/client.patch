@@ -0,0 +1,90 @@
+import { useLingui } from "@lingui/react/macro";
+import { useNavigation, useRouter } from "expo-router";
+import type { ReactNode } from "react";
+import { useLayoutEffect } from "react";
+import { AccountHeaderButton } from "../components/account-header-button";
+import type { CreateAction } from "./create-chooser";
+import { createMenuItems } from "./create-chooser";
+import { useUiLocale } from "./i18n";
+
+/** Liquid Glass home header: the account on the left, one create button on the right. */
+export function useHomeHeader({
+  nativeHeader,
+  hidden,
+  ready,
+  hasSession,
+  initials,
+  runCreateAction,
+  headerTitle,
+}: {
+  nativeHeader: boolean;
+  /** A sheet covering the page also covers the bar: a native header always draws above RN views. */
+  hidden?: boolean;
+  ready: boolean;
+  hasSession: boolean;
+  initials: string;
+  runCreateAction: (action: CreateAction) => void;
+  headerTitle?: () => ReactNode;
+}) {
+  const navigation = useNavigation();
+  const router = useRouter();
+  const { t, i18n } = useLingui();
+  const locale = useUiLocale();
+  useLayoutEffect(() => {
+    if (!nativeHeader) return;
+    const signedIn = ready && hasSession;
+    navigation.setOptions({
+      headerShown: signedIn && !hidden,
+      headerTransparent: true,
+      headerStyle: { backgroundColor: "transparent" },
+      title: "",
+      headerTitle,
+      unstable_headerLeftItems: () => [
+        {
+          // The person's initials in a circle, as the reference app's account button is drawn: a
+          // custom item, because a header button can only carry a glyph and a label, not this.
+          type: "custom" as const,
+          // The chip draws its own circle; the bar's shared glass behind it would ring it twice.
+          hidesSharedBackground: true,
+          element: (
+            <AccountHeaderButton
+              initials={initials}
+              label={t`Account`}
+              onPress={() => router.push("/account")}
+            />
+          ),
+        },
+      ],
+      // One clean circular button: activity and search live in the bar above the home indicator.
+      unstable_headerRightItems: () => [
+        {
+          type: "menu" as const,
+          label: t`Create`,
+          accessibilityLabel: t`Create`,
+          icon: { type: "sfSymbol" as const, name: "plus" },
+          menu: {
+            items: createMenuItems.map(({ id, label, sfSymbol }) => ({
+              type: "action" as const,
+              label: i18n._(label),
+              icon: { type: "sfSymbol" as const, name: sfSymbol },
+              onPress: () => runCreateAction(id),
+            })),
+          },
+        },
+      ],
+    });
+  }, [
+    nativeHeader,
+    hidden,
+    navigation,
+    ready,
+    hasSession,
+    initials,
+    runCreateAction,
+    headerTitle,
+    router,
+    t,
+    i18n,
+    locale,
+  ]);
+}
