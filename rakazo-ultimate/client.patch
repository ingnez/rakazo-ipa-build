--- /dev/null
+++ b/apps/mobile/components/bot-profile-tabs.tsx
@@ -0,0 +1,743 @@
+import type { DiarySummary, FrontDeskTask, MemoryLearning, Routine } from "@rakazo/contracts";
+import { useInfiniteQuery, useQuery } from "@tanstack/react-query";
+import { useRouter } from "expo-router";
+import { useCallback, useMemo, useState } from "react";
+import { ActivityIndicator, Alert, Pressable, StyleSheet, Text, View } from "react-native";
+import { rpc } from "../lib/api";
+import { hapticError, hapticSelection, hapticSuccess } from "../lib/haptics";
+import { native, useMobileTokens } from "../lib/native";
+import { queryClient, rpcQuery } from "../lib/query";
+import { deviceTimeZone, routineRowDetail } from "../lib/routine";
+import { setRoutineActive, useBotRoutines } from "../lib/routine-store";
+import {
+  groupTasksByDay,
+  mergeTaskPages,
+  TASK_LIST_POLL_MS,
+  taskIsOpen,
+  taskRowDetail,
+  taskRowMeta,
+  taskRowTrail,
+  taskStatusLabel,
+} from "../lib/task-steps";
+import { errorText } from "../lib/user-error";
+import { NativeSwitch } from "./native-switch";
+import { NativeSymbol } from "./native-symbol";
+import { TaskStepsSheet } from "./task-steps-sheet";
+
+/**
+ * The Bot's own page, in the reference app's three columns: the work it has been given, the
+ * schedules that start it by itself, and what it has learned — each a tab under its name, so the
+ * page answers "what is it doing", "when does it run" and "what does it remember" without leaving
+ * the chat it belongs to.
+ */
+
+export type ProfileTab = "tasks" | "schedules" | "memory";
+
+const TABS = [
+  { id: "tasks", ios: "list.bullet", android: "list-outline", label: "任务" },
+  { id: "schedules", ios: "clock", android: "time-outline", label: "定时任务" },
+  { id: "memory", ios: "book", android: "book-outline", label: "记忆与总结" },
+] as const;
+
+/** How many rows one page of the bot's work holds. */
+const TASK_PAGE_SIZE = 30;
+
+export function BotProfileTabs({ botId, botName }: { botId: string; botName: string }) {
+  const tokens = useMobileTokens();
+  const [tab, setTab] = useState<ProfileTab>("tasks");
+  return (
+    <View style={{ gap: 18 }}>
+      <View
+        accessibilityRole="tablist"
+        style={[styles.segments, { backgroundColor: tokens.muted }]}
+      >
+        {TABS.map((entry) => {
+          const selected = entry.id === tab;
+          return (
+            <Pressable
+              key={entry.id}
+              accessibilityRole="tab"
+              accessibilityLabel={entry.label}
+              accessibilityState={{ selected }}
+              onPress={() => {
+                if (selected) return;
+                hapticSelection();
+                setTab(entry.id);
+              }}
+              style={[
+                styles.segment,
+                selected && [styles.segmentOn, { backgroundColor: tokens.card }],
+              ]}
+            >
+              <NativeSymbol
+                ios={entry.ios}
+                android={entry.android}
+                size={18}
+                color={selected ? tokens.foreground : tokens.mutedForeground}
+              />
+            </Pressable>
+          );
+        })}
+      </View>
+      {tab === "tasks" ? <TasksColumn botId={botId} /> : null}
+      {tab === "schedules" ? <SchedulesColumn botId={botId} botName={botName} /> : null}
+      {tab === "memory" ? <MemoryColumn botId={botId} botName={botName} /> : null}
+    </View>
+  );
+}
+
+/**
+ * 任务: the work this Bot handed to the back office lately, across every chat it takes part in —
+ * newest first, under the day it was handed over. A row opens the steps that work actually took,
+ * so the page answers "what is it doing, and how far did it get" without leaving the Bot.
+ */
+function TasksColumn({ botId }: { botId: string }) {
+  const tokens = useMobileTokens();
+  const [opened, setOpened] = useState<string | null>(null);
+  const read = rpcQuery("bots/tasks", { botId, limit: TASK_PAGE_SIZE });
+  const query = useInfiniteQuery(
+    {
+      queryKey: read.queryKey,
+      queryFn: (context) =>
+        rpcQuery("bots/tasks", {
+          botId,
+          limit: TASK_PAGE_SIZE,
+          ...(context.pageParam ? { before: context.pageParam as string } : {}),
+        }).queryFn(context as never) as Promise<FrontDeskTask[]>,
+      initialPageParam: null as string | null,
+      // A full page's last row is where the one after it starts: the server pages by `before`.
+      getNextPageParam: (page: FrontDeskTask[]) =>
+        page.length >= TASK_PAGE_SIZE ? (page[page.length - 1]?.createdAt ?? null) : null,
+      // The work keeps moving behind the page, so a row settles and a step lands while it is open.
+      refetchInterval: TASK_LIST_POLL_MS,
+    },
+    queryClient,
+  );
+  const rows = useMemo(() => (query.data ? mergeTaskPages(query.data.pages) : null), [query.data]);
+  const days = useMemo(() => groupTasksByDay(rows ?? []), [rows]);
+
+  if (query.isPending) {
+    return <ActivityIndicator accessibilityLabel="正在读任务" color={tokens.mutedForeground} />;
+  }
+  return (
+    <View style={{ gap: 14 }}>
+      {query.error ? (
+        <Text accessibilityRole="alert" style={[styles.error, { color: tokens.destructive }]}>
+          {errorText(query.error, "现在读不到任务")}
+        </Text>
+      ) : null}
+      {rows && rows.length === 0 ? (
+        <Text style={[styles.empty, { color: tokens.mutedForeground }]}>
+          还没有任务。直接跟它说一句，派出去的活会出现在这里。
+        </Text>
+      ) : null}
+      {days.map((day) => (
+        <View key={day.key} style={{ gap: 8 }}>
+          <Text style={[styles.sectionLabel, { color: native.secondaryLabel }]}>{day.label}</Text>
+          {day.tasks.map((task) => (
+            <TaskRow
+              key={task.id}
+              task={task}
+              onOpen={() => {
+                hapticSelection();
+                setOpened(task.id);
+              }}
+            />
+          ))}
+        </View>
+      ))}
+      {query.hasNextPage ? (
+        <Pressable
+          accessibilityRole="button"
+          disabled={query.isFetchingNextPage}
+          onPress={() => void query.fetchNextPage()}
+          style={({ pressed }) => [styles.linkRow, { opacity: pressed ? 0.6 : 1 }]}
+        >
+          <Text style={[styles.link, { color: tokens.accent }]}>
+            {query.isFetchingNextPage ? "正在读更早的…" : "更早的任务"}
+          </Text>
+        </Pressable>
+      ) : null}
+      {/* The steps the work actually took, opened over this page so the list keeps its place. */}
+      <TaskStepsSheet taskId={opened} botId={botId} onClose={() => setOpened(null)} />
+    </View>
+  );
+}
+
+/** One piece of work: what it is, the line it is on, and the mark that says where it stands. */
+function TaskRow({ task, onOpen }: { task: FrontDeskTask; onOpen: () => void }) {
+  const tokens = useMobileTokens();
+  const open = taskIsOpen(task.status);
+  const failed = task.status === "failed";
+  const detail = taskRowDetail(task);
+  const trail = taskRowTrail(task);
+  return (
+    <Pressable
+      accessibilityRole="button"
+      accessibilityLabel={`${task.title}，${taskStatusLabel(task.status)}，${detail}`}
+      onPress={onOpen}
+      style={({ pressed }) => [
+        styles.card,
+        { backgroundColor: native.groupedCell, opacity: pressed ? 0.7 : 1 },
+      ]}
+    >
+      <View style={styles.mark}>
+        {open ? (
+          <ActivityIndicator size="small" color={tokens.warning} />
+        ) : (
+          <NativeSymbol
+            ios={failed ? "exclamationmark.circle.fill" : "checkmark.circle.fill"}
+            android={failed ? "alert-circle" : "checkmark-circle"}
+            size={17}
+            color={failed ? tokens.destructive : native.tertiaryLabel}
+          />
+        )}
+      </View>
+      <View style={styles.cardBody}>
+        <Text numberOfLines={1} style={[styles.cardTitle, { color: native.label }]}>
+          {task.title.trim() || task.slot || "任务"}
+        </Text>
+        <Text
+          numberOfLines={1}
+          style={[styles.cardDetail, { color: open ? tokens.accent : native.secondaryLabel }]}
+        >
+          {detail}
+        </Text>
+        <Text numberOfLines={1} style={[styles.cardMeta, { color: native.tertiaryLabel }]}>
+          {taskRowMeta(task)}
+        </Text>
+      </View>
+      <View style={styles.trail}>
+        {trail ? (
+          <Text style={[styles.cardMeta, { color: native.tertiaryLabel }]}>{trail}</Text>
+        ) : null}
+        <NativeSymbol
+          ios="chevron.right"
+          android="chevron-forward"
+          size={14}
+          color={native.tertiaryLabel}
+        />
+      </View>
+    </Pressable>
+  );
+}
+
+/** 定时任务: the schedules that start this Bot by itself, each with its next run and its switch. */
+function SchedulesColumn({ botId, botName }: { botId: string; botName: string }) {
+  const tokens = useMobileTokens();
+  const router = useRouter();
+  const { routines, error } = useBotRoutines(botId);
+  const zone = deviceTimeZone();
+  const [busy, setBusy] = useState<string | null>(null);
+
+  const toggle = (routine: Routine, active: boolean) => {
+    hapticSelection();
+    setRoutineActive(botId, routine, active, (cause) =>
+      Alert.alert("没能改这个定时任务", errorText(cause, "再试一次。")),
+    );
+  };
+
+  return (
+    <View style={{ gap: 10 }}>
+      {error ? (
+        <Text accessibilityRole="alert" style={[styles.error, { color: tokens.destructive }]}>
+          {errorText(error, "读不到定时任务")}
+        </Text>
+      ) : null}
+      {routines === undefined ? (
+        <ActivityIndicator accessibilityLabel="Loading…" color={tokens.mutedForeground} />
+      ) : routines.length === 0 ? (
+        <Text style={[styles.empty, { color: tokens.mutedForeground }]}>
+          还没有定时任务。让它每天或每周自己跑一件事，就会排在这里。
+        </Text>
+      ) : (
+        routines.map((routine) => (
+          <Pressable
+            key={routine.id}
