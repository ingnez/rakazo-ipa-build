new file mode 100644
index 000000000..0292bf886
--- /dev/null
+++ b/apps/mobile/lib/bot-template-share.ts
@@ -0,0 +1,73 @@
+import { Share } from "react-native";
+
+/** The bot fields a shared template is built from; a Space's bot and a local one both fit. */
+export type ShareableBot = {
+  name: string;
+  preview?: string | null;
+  instructions?: string | null;
+  modelProvider?: string | null;
+  modelId?: string | null;
+};
+
+/**
+ * What a bot looks like as a template: the fields a template's preview shows, filled from what the
+ * app already holds for the bot. Sharing ships this to the person a bot is handed to, so it carries
+ * the instructions and model choice and nothing private — no thread, no memory, no credentials.
+ */
+export type SharedBotTemplate = {
+  name: string;
+  summary: string;
+  sample: string;
+  description: string;
+  instructions: string;
+  model?: string;
+  skills: { name: string; description: string; body: string }[];
+  routines: { name: string; prompt: string; crons: string[] }[];
+  apps: string[];
+};
+
+function firstLine(text: string | null | undefined): string {
+  return (
+    (text ?? "")
+      .split("\n")
+      .map((line) => line.trim())
+      .find((line) => line.length > 0)
+      ?.slice(0, 120) ?? ""
+  );
+}
+
+/** The bot as a template another Rakazo server can create a bot from. */
+export function botAsTemplate(bot: ShareableBot): SharedBotTemplate {
+  const instructions = bot.instructions?.trim() ?? "";
+  const preview = bot.preview?.trim() ?? "";
+  const model = bot.modelId ? `${bot.modelProvider ?? ""}/${bot.modelId}`.replace(/^\//, "") : "";
+  return {
+    name: bot.name,
+    summary: firstLine(instructions) || firstLine(preview) || bot.name,
+    sample: preview || firstLine(instructions) || bot.name,
+    description: firstLine(instructions),
+    instructions: instructions || firstLine(preview),
+    ...(model ? { model } : {}),
+    skills: [],
+    routines: [],
+    apps: [],
+  };
+}
+
+/** The text the share sheet carries: readable at a glance, and a template below it. */
+export function botTemplateText(bot: ShareableBot): string {
+  const template = botAsTemplate(bot);
+  return [template.name, template.summary, "", JSON.stringify(template, null, 2)].join("\n");
+}
+
+/**
+ * Hands a bot to someone as a template through the system share sheet. Resolves false when the
+ * sheet was dismissed without sharing, so a caller can stay quiet instead of claiming success.
+ */
+export async function shareBotTemplate(bot: ShareableBot): Promise<boolean> {
+  const result = await Share.share(
+    { title: bot.name, message: botTemplateText(bot) },
+    { dialogTitle: bot.name, subject: bot.name },
+  );
+  return result.action === Share.sharedAction;
+}
