+import { describe, expect, it } from "vitest";
+import {
+  fastReplyEnabled,
+  fastReplyModelId,
+  fastReplyTimeoutMs,
+  introQuickReply,
+  messageQuickReply,
+  quickReplyForRun,
+} from "./fast-reply.js";
+
+const env = (pairs: Record<string, string>): NodeJS.ProcessEnv => pairs as NodeJS.ProcessEnv;
+
+describe("fast reply settings", () => {
+  it("is on unless it is switched off", () => {
+    expect(fastReplyEnabled(env({}))).toBe(true);
+    expect(fastReplyEnabled(env({ RAKAZO_FAST_REPLY: "1" }))).toBe(true);
+    for (const off of ["0", "false", "no", "off", "OFF"]) {
+      expect(fastReplyEnabled(env({ RAKAZO_FAST_REPLY: off }))).toBe(false);
+    }
+  });
+
+  it("runs the run's own model unless a faster one is named", () => {
+    expect(fastReplyModelId({ id: "big-reasoner" }, env({}))).toBe("big-reasoner");
+    expect(
+      fastReplyModelId({ id: "big-reasoner" }, env({ RAKAZO_FAST_REPLY_MODEL: " tiny-chat " })),
+    ).toBe("tiny-chat");
+    expect(fastReplyModelId({ id: "big-reasoner" }, env({ RAKAZO_FAST_REPLY_MODEL: "  " }))).toBe(
+      "big-reasoner",
+    );
+  });
+
+  it("keeps the wait short and ignores unusable timeouts", () => {
+    expect(fastReplyTimeoutMs(env({}))).toBe(6_000);
+    expect(fastReplyTimeoutMs(env({ RAKAZO_FAST_REPLY_TIMEOUT_MS: "2500" }))).toBe(2_500);
+    for (const bad of ["0", "-5", "soon", "999999"]) {
+      expect(fastReplyTimeoutMs(env({ RAKAZO_FAST_REPLY_TIMEOUT_MS: bad }))).toBe(6_000);
+    }
+  });
+});
+
+describe("quick reply lines", () => {
+  it("names the bot and the person and keeps one short line", () => {
+    const reply = messageQuickReply({ botName: "Chief", personName: "土豆哇", text: "帮我看看明天天气" });
+    expect(reply.prompt).toBe("帮我看看明天天气");
+    expect(reply.instructions).toContain("Chief");
+    expect(reply.instructions).toContain("土豆哇");
+    expect(reply.instructions).toContain("one short line");
+    expect(reply.instructions).toContain("same language");
+  });
+
+  it("does not introduce a bot by a placeholder name", () => {
+    const reply = introQuickReply({ botName: "New Bot", personName: "Li" });
+    expect(reply.instructions).not.toContain("New Bot");
+    expect(reply.instructions).toContain("name is not chosen yet");
+    expect(reply.instructions).toContain("Li");
+  });
+
+  it("describes what the bot is for when it already knows", () => {
+    const reply = introQuickReply({
+      botName: "Chief",
+      description: "Runs my day",
+    });
+    expect(reply.instructions).toContain("Chief");
+    expect(reply.instructions).toContain("Runs my day");
+  });
+});
+
+describe("quickReplyForRun", () => {
+  const base = {
+    bot: { name: "Chief", description: null },
+    personName: "Li",
+    text: "帮我把你设成主 bot",
+    silent: false,
+    scripted: false,
+  };
+
+  it("answers a message the person sent", () => {
+    for (const trigger of ["user", "follow_up", "call_end"]) {
+      expect(quickReplyForRun({ ...base, trigger })).toBeDefined();
+    }
+  });
+
+  it("greets the person who just created the bot", () => {
+    const reply = quickReplyForRun({ ...base, trigger: "created", text: "Chief 的主 bot" });
+    expect(reply?.instructions).toContain("brand-new assistant");
+  });
+
+  it("says nothing where silence is the answer", () => {
+    expect(quickReplyForRun({ ...base, trigger: "routine" })).toBeUndefined();
+    expect(quickReplyForRun({ ...base, trigger: "webhook" })).toBeUndefined();
+    expect(quickReplyForRun({ ...base, trigger: "tickets" })).toBeUndefined();
+    expect(quickReplyForRun({ ...base, trigger: "bot_message" })).toBeUndefined();
+    expect(
+      quickReplyForRun({ ...base, trigger: "user", silent: true, env: env({}) }),
+    ).toBeUndefined();
+  });
+
+  it("never adds a turn to a scripted harness or a switched-off deployment", () => {
+    expect(quickReplyForRun({ ...base, trigger: "user", scripted: true })).toBeUndefined();
+    expect(
+      quickReplyForRun({ ...base, trigger: "user", env: env({ RAKAZO_FAST_REPLY: "0" }) }),
+    ).toBeUndefined();
+  });
+
+  it("sends only the head of a very long message", () => {
+    const reply = quickReplyForRun({ ...base, trigger: "user", text: "字".repeat(5_000) });
+    expect(reply?.prompt.length).toBeLessThan(1_300);
+    expect(reply?.prompt.endsWith("…")).toBe(true);
+  });
+});
