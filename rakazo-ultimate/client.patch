+import { describe, expect, it } from "vitest";
+import { consecutiveImageRun } from "./events.js";
+
+describe("consecutiveImageRun", () => {
+  it("returns null when the index is not a picture", () => {
+    expect(consecutiveImageRun([{ kind: "text" }], 0)).toBeNull();
+  });
+
+  it("returns null when the index is not the first of its run", () => {
+    const items = [{ kind: "image" }, { kind: "image" }];
+    expect(consecutiveImageRun(items, 1)).toBeNull();
+  });
+
+  it("returns a lone picture as a run of one", () => {
+    expect(consecutiveImageRun([{ kind: "image" }], 0)).toEqual([{ kind: "image" }]);
+  });
+
+  it("returns the full consecutive run", () => {
+    const items = [{ kind: "image" }, { kind: "image" }, { kind: "file" }];
+    expect(consecutiveImageRun(items, 0)).toEqual([{ kind: "image" }, { kind: "image" }]);
+  });
+});
