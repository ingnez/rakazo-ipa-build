--- /dev/null
+++ b/apps/mobile/lib/quick-look.ts
@@ -0,0 +1,66 @@
+import { requireOptionalNativeModule } from "expo-modules-core";
+
+/**
+ * The system document viewer, written for iOS; absent in a build without it.
+ *
+ * QuickLook is what the phone itself uses to show a PDF, a slide deck or a spreadsheet, and it
+ * brings its own close and share buttons — so a document is read where it lies instead of being
+ * handed to the share sheet before a single page is visible.
+ */
+type QuickLookModule = {
+  /** Opens the file full screen; the promise settles when the viewer closes. */
+  open: (uri: string) => Promise<void>;
+};
+
+function quickLook(): QuickLookModule | null {
+  return (requireOptionalNativeModule("RakazoQuickLook") as QuickLookModule | null) ?? null;
+}
+
+/** Whether this build can show files in the system viewer. */
+export function quickLookAvailable(): boolean {
+  try {
+    return quickLook() !== null;
+  } catch {
+    return false;
+  }
+}
+
+/** The document types the viewer reads: pages, slides, sheets, plain text and books. */
+const DOCUMENT_TYPES = [
+  "application/pdf",
+  "text/",
+  "application/json",
+  "application/xml",
+  "application/rtf",
+  "application/epub+zip",
+  "application/msword",
+  "application/vnd.ms-excel",
+  "application/vnd.ms-powerpoint",
+  "wordprocessingml",
+  "spreadsheetml",
+  "presentationml",
+  "opendocument",
+  "application/vnd.apple.pages",
+  "application/vnd.apple.numbers",
+  "application/vnd.apple.keynote",
+];
+
+/**
+ * Whether a file should open in the viewer rather than be offered to other apps.
+ *
+ * Only what the viewer really reads: an installer, an archive or an app package is something to
+ * send somewhere, and the share sheet is the only place for it.
+ */
+export function quickLookOpens(mimeType: string): boolean {
+  const type = mimeType.split(";")[0]?.trim().toLowerCase() ?? "";
+  // The Office types name their format in the middle of the MIME, so the whole string is read.
+  if (!DOCUMENT_TYPES.some((known) => type.includes(known))) return false;
+  return quickLookAvailable();
+}
+
+/** Opens a file in the system's viewer; rejects when this build or device cannot. */
+export function openInQuickLook(uri: string): Promise<void> {
+  const module = quickLook();
+  if (!module) return Promise.reject(new Error("no document viewer in this build"));
+  return module.open(uri);
+}
diff --git a/apps/mobile/lib/realtime-audio.ts b/apps/mobile/lib/realtime-audio.ts
new file mode 100644
index 0000000..1f1e512
--- /dev/null
+++ b/apps/mobile/lib/realtime-audio.ts
@@ -0,0 +1,112 @@
+import { decodeBase64, encodeBase64 } from "./realtime-protocol";
+
+/**
+ * The phone's side of a live call's audio: the microphone at the model's own rate, and the model's
+ * voice played while it is still arriving.
+ *
+ * The native module is one AVAudioEngine in `.voiceChat` mode — the mode with echo cancellation, so
+ * the bot does not hear itself through the speaker and talk over itself. It is written for iOS;
+ * a build without it reports no realtime audio, and the call falls back to the turn-based path.
+ */
+export interface RealtimeAudioPort {
+  /** Opens microphone and speaker at the call's two rates. */
+  start(inputSampleRate: number, outputSampleRate: number): void;
+  /** Ends the call's audio and hands the session back to the phone. */
+  stop(): void;
+  /** A muted call keeps listening but sends nothing. */
+  setMuted(muted: boolean): void;
+  /** Queues one piece of the model's PCM16 mono audio. */
+  play(pcm: Uint8Array): void;
+  /** Throws away what is queued but not yet heard. */
+  flush(): void;
+  /** Every 20 ms of the microphone, until the returned function is called. */
+  listen(onFrame: (pcm: Uint8Array) => void): () => void;
+  /** A phone call, Siri or an unplugged headset took the audio; `began` is false when it is back. */
+  onInterruption(listener: (began: boolean) => void): () => void;
+}
+
+type RealtimeAudioNative = {
+  start(inputSampleRate: number, outputSampleRate: number): void;
+  setMuted(muted: boolean): void;
+  play(base64: string): void;
+  flush(): void;
+  stop(): void;
+  addListener(event: "onAudio", listener: (event: { data?: string }) => void): { remove(): void };
+  addListener(
+    event: "onInterruption",
+    listener: (event: { began?: boolean }) => void,
+  ): { remove(): void };
+};
+
+/**
+ * The native module, loaded only when a call actually needs it: the engine's own package is a
+ * native-boundary import, and a build without the module (an older IPA, the web) simply has no
+ * live calls — which is a fallback to the turn-based call, not an error.
+ */
+async function realtimeAudioNative(): Promise<RealtimeAudioNative | null> {
+  try {
+    const core = await import("expo-modules-core");
+    return core.requireOptionalNativeModule<RealtimeAudioNative>("RakazoRealtimeAudio") ?? null;
+  } catch {
+    return null;
+  }
+}
+
+/** Whether this build can carry both directions of a live call. */
+export async function realtimeAudioAvailable(): Promise<boolean> {
+  return (await realtimeAudioNative()) !== null;
+}
+
+export async function createRealtimeAudio(): Promise<RealtimeAudioPort | null> {
+  const native = await realtimeAudioNative();
+  if (!native) return null;
+  const frameListeners = new Set<(pcm: Uint8Array) => void>();
+  const interruptionListeners = new Set<(began: boolean) => void>();
+  let subscribed = false;
+  let subscriptions: Array<{ remove(): void }> = [];
+
+  const subscribe = () => {
+    if (subscribed) return;
+    subscribed = true;
+    subscriptions = [
+      native.addListener("onAudio", (event) => {
+        if (!event?.data) return;
+        const pcm = decodeBase64(event.data);
+        for (const listener of [...frameListeners]) listener(pcm);
+      }),
+      native.addListener("onInterruption", (event) => {
+        for (const listener of [...interruptionListeners]) listener(event?.began === true);
+      }),
+    ];
+  };
+  const unsubscribeWhenIdle = () => {
+    if (!subscribed || frameListeners.size > 0 || interruptionListeners.size > 0) return;
+    subscribed = false;
+    for (const subscription of subscriptions) subscription.remove();
+    subscriptions = [];
+  };
+
+  return {
+    start: (inputSampleRate, outputSampleRate) => native.start(inputSampleRate, outputSampleRate),
+    stop: () => native.stop(),
+    setMuted: (muted) => native.setMuted(muted),
+    play: (pcm) => native.play(encodeBase64(pcm)),
+    flush: () => native.flush(),
+    listen: (onFrame) => {
+      frameListeners.add(onFrame);
+      subscribe();
+      return () => {
+        frameListeners.delete(onFrame);
+        unsubscribeWhenIdle();
+      };
+    },
+    onInterruption: (listener) => {
+      interruptionListeners.add(listener);
+      subscribe();
+      return () => {
+        interruptionListeners.delete(listener);
+        unsubscribeWhenIdle();
+      };
+    },
+  };
+}
diff --git a/apps/mobile/lib/realtime-call.test.ts b/apps/mobile/lib/realtime-call.test.ts
new file mode 100644
index 0000000..d861ae2
--- /dev/null
+++ b/apps/mobile/lib/realtime-call.test.ts
@@ -0,0 +1,242 @@
+import type { RealtimeCallPlan } from "@rakazo/contracts";
+import { describe, expect, it, vi } from "vitest";
+import type { RealtimeAudioPort } from "./realtime-audio";
+import type { OpenRealtimeSocket, RealtimeCallPhase, RealtimeSocketHandlers } from "./realtime-call";
+import { RealtimeCall } from "./realtime-call";
+
+const PLAN: RealtimeCallPlan = {
+  callId: "call-1",
+  botId: "bot-1",
+  threadId: "thread-1",
+  provider: "bailian-cn",
+  providerName: "阿里百炼 Realtime · 北京",
+  model: "qwen3.8-omni-flash-realtime",
+  voice: "Tina",
+  inputSampleRate: 16000,
+  outputSampleRate: 24000,
+  audioFormat: "binary",
+  path: "/api/voice/realtime?botId=bot-1&callId=call-1&format=binary",
+  maxDurationSeconds: 1800,
+};
+
+/** The socket, the audio and the call card, as a call would drive them. */
+function harness() {
+  const sent: Array<string | ArrayBuffer> = [];
+  const phases: RealtimeCallPhase[] = [];
+  const captions: string[] = [];
+  const userText: Array<[string, boolean]> = [];
+  const botText: Array<[string, boolean]> = [];
+  const closed: Array<Record<string, unknown>> = [];
+  let handlers: RealtimeSocketHandlers | null = null;
+  let url = "";
+  let headers: Record<string, string> = {};
+  const timers: Array<{ callback: () => void; ms: number }> = [];
+  let mic: ((pcm: Uint8Array) => void) | null = null;
+  const audioMocks = {
+    start: vi.fn(),
+    stop: vi.fn(),
+    setMuted: vi.fn(),
+    play: vi.fn(),
+    flush: vi.fn(),
+    listen: vi.fn((onFrame: (pcm: Uint8Array) => void) => {
+      mic = onFrame;
+      return () => {
+        mic = null;
+      };
+    }),
+    onInterruption: vi.fn(() => () => undefined),
+  };
+  const openSocket = vi.fn<OpenRealtimeSocket>((socketUrl, socketHeaders, socketHandlers) => {
+    url = socketUrl;
+    headers = socketHeaders;
+    handlers = socketHandlers;
+    return {
+      send: (data) => sent.push(data),
+      close: () => undefined,
+    };
+  });
+  const call = new RealtimeCall(
+    PLAN,
+    {
+      audio: audioMocks as unknown as RealtimeAudioPort,
+      openSocket,
+      setTimer: (callback, ms) => {
+        timers.push({ callback, ms });
+        return timers.length;
+      },
+      clearTimer: () => undefined,
+    },
+    {
+      onReady: vi.fn(),
+      onPhase: (phase) => phases.push(phase),
+      onUserText: (text, final) => userText.push([text, final]),
+      onAssistantText: (text, final) => botText.push([text, final]),
+      onCaption: (text) => captions.push(text),
+      onClosed: (result) => closed.push(result as unknown as Record<string, unknown>),
+    },
+  );
+  call.connect({ apiBase: "https://rakazo.163ll.com", headers: { authorization: "Bearer t" } });
+  return {
+    call,
+    audio: audioMocks,
+    sent,
+    phases,
+    captions,
+    userText,
+    botText,
+    closed,
+    timers,
+    mic: () => mic,
+    socket: () => handlers,
+    url: () => url,
+    headers: () => headers,
+  };
+}
+
+function frame(socket: RealtimeSocketHandlers | null, body: unknown) {
+  socket?.onMessage(JSON.stringify(body));
+}
+
+describe("RealtimeCall", () => {
+  it("opens the call's socket on the app's server with its own sign-in", () => {
+    const h = harness();
+    expect(h.url()).toBe(
+      "wss://rakazo.163ll.com/api/voice/realtime?botId=bot-1&callId=call-1&format=binary",
+    );
+    expect(h.headers()).toEqual({ authorization: "Bearer t" });
+    expect(h.phases).toEqual(["connecting"]);
+  });
+
+  it("streams the microphone only once the gateway is ready", () => {
+    const h = harness();
+    // Audio the phone produced before `ready` is worth nothing to the gateway.
+    expect(h.audio.listen).not.toHaveBeenCalled();
+    frame(h.socket(), { type: "ready", inputSampleRate: 16000, outputSampleRate: 24000 });
+    expect(h.audio.start).toHaveBeenCalledWith(16000, 24000);
+    expect(h.audio.listen).toHaveBeenCalledOnce();
+    expect(h.phases).toEqual(["connecting", "listening"]);
+    h.mic()?.(new Uint8Array([1, 2, 3, 4]));
+    expect(h.sent).toHaveLength(1);
+    expect([...new Uint8Array(h.sent[0] as ArrayBuffer)]).toEqual([1, 2, 3, 4]);
+  });
+
+  it("stops the reply the moment the model hears the caller", () => {
+    const h = harness();
+    frame(h.socket(), { type: "ready" });
+    frame(h.socket(), { type: "response.start" });
+    expect(h.phases).toEqual(["connecting", "listening", "speaking"]);
+    frame(h.socket(), { type: "speech.start" });
+    expect(h.audio.flush).toHaveBeenCalledOnce();
+    expect(h.phases.at(-1)).toBe("listening");
+  });
+
+  it("shows both sides' words as they arrive", () => {
+    const h = harness();
+    frame(h.socket(), { type: "ready" });
+    frame(h.socket(), { type: "user.text", text: "帮我看看", final: false });
+    frame(h.socket(), { type: "user.text", text: "帮我看看排班", final: true });
+    frame(h.socket(), { type: "assistant.text", text: "好", final: false });
+    frame(h.socket(), { type: "assistant.text", text: "好的，我看看。", final: true });
+    expect(h.userText).toEqual([
+      ["帮我看看", false],
+      ["帮我看看排班", true],
+    ]);
+    expect(h.botText).toEqual([
+      ["好", false],
+      ["好的，我看看。", true],
+    ]);
+  });
+
+  it("plays the model's audio from binary frames and from JSON ones", () => {
+    const h = harness();
+    frame(h.socket(), { type: "ready" });
+    // Binary frames carry raw PCM straight to the speaker.
+    h.socket()?.onMessage(new Uint8Array([9, 8, 7]).buffer);
+    expect(h.audio.play).toHaveBeenCalledWith(new Uint8Array([9, 8, 7]));
+    h.audio.play.mockClear();
+    // A JSON call carries the same PCM as base64.
+    frame(h.socket(), { type: "audio", audio: "CQgH" });
+    expect(h.audio.play).toHaveBeenCalledWith(new Uint8Array([9, 8, 7]));
+  });
+
+  it("hangs up by saying so, and keeps the socket open for the chat it writes", () => {
+    const h = harness();
+    frame(h.socket(), { type: "ready" });
+    h.sent.length = 0;
+    h.call.hangUp();
+    expect(h.sent.map((item) => String(item))).toEqual(['{"type":"hangup"}']);
+    expect(h.audio.stop).toHaveBeenCalled();
+    // The gateway writes the call into the chat before it answers: not ended yet.
+    expect(h.closed).toHaveLength(0);
+    frame(h.socket(), {
+      type: "closed",
+      reason: "hangup",
+      durationSeconds: 63,
+      turns: 4,
+      transcriptWritten: true,
+    });
+    expect(h.closed).toEqual([
+      { reason: "hangup", durationSeconds: 63, turns: 4, transcriptWritten: true },
+    ]);
+  });
+
+  it("ends the call on its own if the gateway never answers the hang-up", () => {
+    const h = harness();
+    frame(h.socket(), { type: "ready" });
+    h.call.hangUp();
+    expect(h.timers.at(-1)?.ms).toBe(8_000);
+    h.timers.at(-1)?.callback();
+    expect(h.closed).toEqual([
+      { reason: "hangup", durationSeconds: 0, turns: 0, transcriptWritten: false },
+    ]);
+  });
+
+  it("sends nothing while muted, and nothing once hung up", () => {
+    const h = harness();
+    frame(h.socket(), { type: "ready" });
+    h.call.setMuted(true);
+    expect(h.audio.setMuted).toHaveBeenCalledWith(true);
+    h.mic()?.(new Uint8Array([1, 2]));
+    expect(h.sent).toHaveLength(0);
+    h.call.setMuted(false);
+    h.mic()?.(new Uint8Array([1, 2]));
+    expect(h.sent).toHaveLength(1);
+  });
+
+  it("hangs up by itself at the gateway's own limit", () => {
+    const h = harness();
+    frame(h.socket(), { type: "ready" });
+    const limit = h.timers.find((timer) => timer.ms === 1_800_000);
+    expect(limit).toBeDefined();
+    h.sent.length = 0;
+    limit?.callback();
+    expect(h.sent.map((item) => String(item))).toEqual(['{"type":"hangup"}']);
+  });
+
+  it("says so when the socket never opened", () => {
+    const h = harness();
+    h.socket()?.onError();
+    expect(h.captions.at(-1)).toContain("Could not connect");
+    h.socket()?.onClose({ code: 1006 });
+    expect(h.closed.at(-1)).toMatchObject({ reason: "client-closed", transcriptWritten: false });
+  });
+
+  it("passes on the gateway's human-readable refusal", () => {
+    const h = harness();
+    frame(h.socket(), {
+      type: "error",
+      message: "还没有连接对应厂商的语音 Key",
+      code: "no_credential",
+    });
+    expect(h.captions.at(-1)).toBe("还没有连接对应厂商的语音 Key");
+  });
+
+  it("cancels the reply on a local interruption", () => {
+    const h = harness();
+    frame(h.socket(), { type: "ready" });
+    h.sent.length = 0;
+    h.call.interrupt();
+    expect(h.sent.map((item) => String(item))).toEqual(['{"type":"cancel"}']);
+    expect(h.audio.flush).toHaveBeenCalledOnce();
+  });
+});
diff --git a/apps/mobile/lib/realtime-call.ts b/apps/mobile/lib/realtime-call.ts
