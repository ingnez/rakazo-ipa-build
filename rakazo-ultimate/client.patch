+import { describe, expect, it } from "vitest";
+import { doubleTapIntent } from "./double-tap";
+
+describe("doubleTapIntent", () => {
+  it("opens a message's words for selection", () => {
+    expect(doubleTapIntent({ hasSelectableText: true, inlineControls: false, canLike: true })).toBe(
+      "select",
+    );
+    // Selection wins even where a like was offered before.
+    expect(doubleTapIntent({ hasSelectableText: true, inlineControls: false, canLike: false })).toBe(
+      "select",
+    );
+  });
+
+  it("keeps the quiet like on a bubble with nothing to select", () => {
+    expect(doubleTapIntent({ hasSelectableText: false, inlineControls: false, canLike: true })).toBe(
+      "like",
+    );
+  });
+
+  it("does nothing on a card that holds controls of its own", () => {
+    expect(doubleTapIntent({ hasSelectableText: false, inlineControls: true, canLike: true })).toBe(
+      undefined,
+    );
+  });
+
+  it("does nothing where neither is offered", () => {
+    expect(
+      doubleTapIntent({ hasSelectableText: false, inlineControls: false, canLike: false }),
+    ).toBeUndefined();
+  });
+});
