+
+  it("writes nothing when the server sent no window", () => {
+    expect(formatWindowRange("24h", "", "", "en-US")).toBe("");
+  });
+});
+
+describe("usageTags", () => {
+  const call = (over: Partial<Parameters<typeof usageTags>[0]> = {}) => ({
+    desk: "front_desk" as const,
+    trigger: "user",
+    operationKind: "answer" as string | null,
+    status: "completed" as string | null,
+    isRetry: false,
+    ...over,
+  });
+
+  it("names the desk a call spent its tokens on", () => {
+    expect(usageTags(call())).toEqual([{ key: "front_desk", tone: "neutral" }]);
+    expect(usageTags(call({ desk: "backoffice", trigger: "backoffice" }))).toEqual([
+      { key: "backoffice", tone: "neutral" },
+    ]);
+    expect(usageTags(call({ desk: "other", trigger: "routine" }))).toEqual([
+      { key: "routine", tone: "neutral" },
+    ]);
+    expect(usageTags(call({ desk: "other", trigger: "created" }))).toEqual([
+      { key: "other_desk", tone: "neutral" },
