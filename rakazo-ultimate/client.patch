+    expect(usageTags(call({ isRetry: true, status: "failed" }))).toEqual([
+      { key: "front_desk", tone: "neutral" },
+      { key: "retry", tone: "warning" },
+      { key: "failed", tone: "danger" },
+    ]);
+  });
+});
