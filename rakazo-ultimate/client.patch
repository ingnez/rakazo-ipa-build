+import type { PrismaClient } from "@rakazo/db";
+import { describe, expect, it } from "vitest";
+import { isAdmin } from "./admins.js";
+
+describe("isAdmin", () => {
+  const users = [
+    { id: "verified", email: "Admin@Example.test", emailVerified: true },
+    { id: "unverified", email: "admin@example.test", emailVerified: false },
+  ];
+  const prisma = {
+    user: {
+      findUnique: async ({ where }: { where: { id: string } }) =>
+        users.find((user) => user.id === where.id) ?? null,
+    },
+  } as unknown as PrismaClient;
+
+  it("requires a listed, verified email", async () => {
+    const deps = { prisma, env: { adminEmails: ["admin@example.test"] } as never };
+    expect(await isAdmin(deps, "verified")).toBe(true);
+    expect(await isAdmin(deps, "unverified")).toBe(false);
+    expect(await isAdmin({ prisma, env: {} as never }, "verified")).toBe(false);
+  });
+});
diff --git a/apps/api/src/auth/request-auth-queries.postgres.test.ts b/apps/api/src/auth/request-auth-queries.postgres.test.ts
new file mode 100644
index 000000000..8886a338c
--- /dev/null
+++ b/apps/api/src/auth/request-auth-queries.postgres.test.ts
@@ -0,0 +1,96 @@
+import { AsyncLocalStorage } from "node:async_hooks";
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { asSystem, createDb } from "@rakazo/db";
+import { expect, it } from "vitest";
+import { sessionCookieHeader } from "../../../../packages/testkit/src/index.js";
+import { createApp } from "../app.js";
+
+const databaseUrl = process.env.VERIFY_DATABASE === "1" ? process.env.DATABASE_URL : undefined;
+const origin = "http://127.0.0.1:5173";
+const AUTH_TABLE = /FROM "public"\."(session|user|member|space_members)"/;
+
+it.skipIf(!databaseUrl)(
+  "authorizes a signed-in request with one session, user and membership read, and still refuses revoked access",
+  async () => {
+    const dataDir = await mkdtemp(join(tmpdir(), "rakazo-request-auth-"));
+    const db = createDb(databaseUrl!);
+    // Only this request's reads, not background work its signup started.
+    const counted = new AsyncLocalStorage<string[]>();
+    const query = db.pool.query.bind(db.pool) as (...args: unknown[]) => unknown;
+    db.pool.query = ((...args: unknown[]) => {
+      const [config] = args;
+      const text = typeof config === "string" ? config : (config as { text?: string }).text;
+      const table = text?.match(AUTH_TABLE)?.[1];
+      if (table) counted.getStore()?.push(table);
+      return query(...args);
+    }) as typeof db.pool.query;
+    const handles = await createApp({
+      databaseUrl: databaseUrl!,
+      prisma: db.prisma,
+      dataDir,
+      sandboxProvider: "fake",
+      agentRuntime: "scripted",
+      wakeupDriver: "memory",
+      signupsEnabled: "true",
+      webOrigin: origin,
+      authUrl: origin,
+    });
+    const system = asSystem(db.prisma);
+    try {
+      const signUp = async (email: string) => {
+        const response = await handles.app.request("/api/auth/sign-up/email", {
+          method: "POST",
+          headers: { "content-type": "application/json", origin },
+          body: JSON.stringify({ email, password: "test-password-123", name: "Auth reads" }),
+        });
+        expect(response.status).toBeLessThan(400);
+        return sessionCookieHeader(response);
+      };
+      const call = (cookie: string, procedure = "bots/list") =>
+        handles.app.request(`/rpc/${procedure}`, {
+          method: "POST",
+          headers: { "content-type": "application/json", cookie, origin },
+          body: JSON.stringify({ json: {} }),
+        });
+      const stamp = Date.now();
+      const email = `request-auth-${stamp}@example.test`;
+      const cookie = await signUp(email);
+      // The first request pins the session to an organization.
+      expect((await call(cookie)).status).toBe(200);
+
+      const authReads: string[] = [];
+      expect((await counted.run(authReads, () => call(cookie))).status).toBe(200);
+      expect(authReads.sort()).toEqual(["session", "space_members", "user"]);
+
+      const user = await system.user.findUniqueOrThrow({ where: { email } });
+      await system.spaceMember.deleteMany({ where: { userId: user.id } });
+      expect((await call(cookie)).status).toBe(401);
+
+      const deactivatedEmail = `request-auth-deactivated-${stamp}@example.test`;
+      const deactivatedCookie = await signUp(deactivatedEmail);
+      expect((await call(deactivatedCookie)).status).toBe(200);
+      await system.user.update({
+        where: { email: deactivatedEmail },
+        data: { deactivatedAt: new Date() },
+      });
+      expect((await call(deactivatedCookie)).status).toBe(401);
+
+      const signedOutCookie = await signUp(`request-auth-signed-out-${stamp}@example.test`);
+      expect((await call(signedOutCookie)).status).toBe(200);
+      const signOut = await handles.app.request("/api/auth/sign-out", {
+        method: "POST",
+        headers: { cookie: signedOutCookie, origin },
+      });
+      expect(signOut.status).toBe(200);
+      expect((await call(signedOutCookie)).status).toBe(401);
+    } finally {
+      await handles.stop();
+      await db.prisma.$disconnect();
+      await db.pool.end();
+      await rm(dataDir, { recursive: true, force: true });
+    }
+  },
+  60_000,
+);
diff --git a/apps/api/src/auth/security-audit.test.ts b/apps/api/src/auth/security-audit.test.ts
new file mode 100644
index 000000000..6875cc330
--- /dev/null
+++ b/apps/api/src/auth/security-audit.test.ts
@@ -0,0 +1,143 @@
+import { BotSecretPutInput } from "@rakazo/contracts";
+import type * as Db from "@rakazo/db";
+import { recordSecurityEvent } from "@rakazo/db";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { createAuthResponseAudit, procedureSecurityEvent } from "./security-audit.js";
+
+vi.mock("@rakazo/db", async (original) => ({
+  ...(await original<typeof Db>()),
+  recordSecurityEvent: vi.fn(async () => undefined),
+}));
+
+const actor = { userId: "user-1", spaceId: "space-1" };
+
+beforeEach(() => vi.mocked(recordSecurityEvent).mockClear());
+
+describe("procedureSecurityEvent", () => {
+  it("records which credential changed without its value", () => {
+    const event = procedureSecurityEvent(
+      ["models", "connect"],
+      { provider: "openrouter", apiKey: "sk-or-v1-secretvalue", label: "Work key" },
+      actor,
+    );
+    expect(event).toEqual({
+      type: "credential.created",
+      userId: "user-1",
+      spaceId: "space-1",
+      metadata: { procedure: "models.connect", kind: "model", provider: "openrouter" },
+    });
+  });
+
+  it("records an MCP server added by connecting it, with the bot it is for", () => {
+    const event = procedureSecurityEvent(
+      ["mcp", "servers", "connect"],
+      { name: "Tracker", endpoint: "https://mcp.tracker.example.test/mcp", botId: "bot-1" },
+      actor,
+    );
+    expect(event?.metadata).toEqual({
+      procedure: "mcp.servers.connect",
+      kind: "mcp",
+      botId: "bot-1",
+    });
+  });
+
+  it("keeps secret names but never secret values", () => {
+    const event = procedureSecurityEvent(
+      ["botSecrets", "put"],
+      // The real RPC shape, so a renamed field fails here instead of silently dropping the name.
+      BotSecretPutInput.parse({
+        botId: "bot-1",
+        destination: { name: "github-deploy", auth: { type: "command" } },
+        value: "ghp_secretvalue",
+      }),
+      actor,
+    );
+    expect(event?.metadata).toEqual({
+      procedure: "botSecrets.put",
+      kind: "bot_secret",
+      botId: "bot-1",
+      name: "github-deploy",
+    });
+    expect(JSON.stringify(event)).not.toContain("ghp_secretvalue");
+  });
+
+  it("lists which deployment settings changed without the allowlist itself", () => {
+    const event = procedureSecurityEvent(
+      ["deployment", "update"],
+      { signupsEnabled: true, signupAllowlist: ["owner@example.test"], computerHost: undefined },
+      actor,
+    );
+    expect(event?.type).toBe("deployment.settings.changed");
+    expect(event?.metadata).toMatchObject({
+      changed: "signupAllowlist,signupsEnabled",
+      signupsEnabled: true,
+    });
+    expect(JSON.stringify(event)).not.toContain("owner@example.test");
+  });
+
+  it("records an MCP approval as a decision", () => {
+    expect(
+      procedureSecurityEvent(
+        ["mcp", "assignments", "dismiss"],
+        { botId: "bot-1", serverId: "server-1" },
+        actor,
+      ),
+    ).toMatchObject({ type: "approval.decided", metadata: { decision: "deny", kind: "mcp" } });
+  });
+
+  it("ignores procedures that change nothing security-relevant", () => {
+    expect(procedureSecurityEvent(["threads", "send"], { text: "hello" }, actor)).toBeUndefined();
+  });
+});
+
+describe("createAuthResponseAudit", () => {
+  const json = (status: number, body: unknown) =>
+    new Response(JSON.stringify(body), { status, headers: { "content-type": "application/json" } });
+
+  it("records a failed sign-in with its error code and no credentials", async () => {
+    const audit = createAuthResponseAudit();
+    await audit(
+      "/sign-in/email",
+      "203.0.113.5",
+      json(401, { code: "INVALID_EMAIL_OR_PASSWORD", message: "Invalid email or password" }),
+    );
+    expect(recordSecurityEvent).toHaveBeenCalledWith({
+      type: "auth.sign_in.failed",
+      ip: "203.0.113.5",
+      metadata: { path: "/sign-in/email", status: 401, reason: "INVALID_EMAIL_OR_PASSWORD" },
+    });
+  });
+
+  it("records a refused sign-up", async () => {
+    const audit = createAuthResponseAudit();
+    await audit("/sign-up/email", "203.0.113.5", json(400, { code: "REGISTRATION_CLOSED" }));
+    expect(recordSecurityEvent).toHaveBeenCalledWith(
+      expect.objectContaining({ type: "auth.sign_up.failed" }),
+    );
+  });
+
+  it("does not record successes or unrelated failures here", async () => {
+    const audit = createAuthResponseAudit();
+    await audit("/sign-in/email", "203.0.113.5", json(200, { token: "session-token" }));
+    await audit("/get-session", "203.0.113.5", json(401, {}));
+    expect(recordSecurityEvent).not.toHaveBeenCalled();
+  });
+
+  it("records a rate-limit hit once a minute per address and path", async () => {
+    let now = 0;
+    const audit = createAuthResponseAudit(() => now);
+    for (let attempt = 0; attempt < 20; attempt++) {
+      await audit("/sign-in/email", "203.0.113.5", new Response(null, { status: 429 }));
+    }
+    await audit("/sign-in/email", "198.51.100.7", new Response(null, { status: 429 }));
+    expect(recordSecurityEvent).toHaveBeenCalledTimes(2);
+    now = 61_000;
+    await audit("/sign-in/email", "203.0.113.5", new Response(null, { status: 429 }));
+    expect(recordSecurityEvent).toHaveBeenCalledTimes(3);
+    expect(recordSecurityEvent).toHaveBeenLastCalledWith({
+      type: "rate_limit.hit",
+      ip: "203.0.113.5",
+      metadata: { path: "/sign-in/email" },
+    });
+  });
+});
diff --git a/apps/api/src/billing/byok-plan.postgres.test.ts b/apps/api/src/billing/byok-plan.postgres.test.ts
new file mode 100644
index 000000000..979d323cf
--- /dev/null
+++ b/apps/api/src/billing/byok-plan.postgres.test.ts
@@ -0,0 +1,352 @@
+import type { SandboxProvider } from "@rakazo/adapter-kit";
+import type * as Adapters from "@rakazo/adapters";
+import { BillingEmulator, sandboxAllowance } from "@rakazo/adapters";
+import type { Actor } from "@rakazo/contracts";
+import { BYOK_TIERS } from "@rakazo/contracts";
+import type { PrismaClient } from "@rakazo/db";
+import {
+  asSystem,
+  billingAccountForOrganization,
+  createDb,
+  planComputerSize,
+  spaceHasModelAccess,
+} from "@rakazo/db";
+import { afterAll, beforeAll, describe, expect, it, vi } from "vitest";
+import { createBillingService } from "./billing.js";
+
+// Computer use is read from runs and deployment settings that other suites share; tests set it.
+vi.mock("@rakazo/adapters", async (importOriginal) => ({
+  ...(await importOriginal<typeof Adapters>()),
+  sandboxAllowance: vi.fn(async () => null),
+}));
+
+const dbTests = process.env.VERIFY_DATABASE && process.env.DATABASE_URL ? describe : describe.skip;
+dbTests("own-key plan", () => {
+  const stamp = `${process.pid}-${Date.now()}`;
+  const userId = `byok-owner-${stamp}`,
+    organizationId = `byok-org-${stamp}`,
+    spaceId = `byok-space-${stamp}`;
+  const actor: Actor = {
+    userId,
+    spaceId,
+    email: `byok-${stamp}@rakazo.test`,
+    isDeploymentOwner: false,
+  };
+  const provider = new BillingEmulator({ modelCredits: true, namespace: `byok-${stamp}` });
+  let prisma: PrismaClient,
+    db: ReturnType<typeof createDb>,
+    service: ReturnType<typeof createBillingService>;
+  beforeAll(async () => {
+    db = createDb(process.env.DATABASE_URL!);
+    prisma = asSystem(db.prisma);
+    const createdAt = new Date();
+    await prisma.user.create({
+      data: { id: userId, name: "Demo owner", email: actor.email, emailVerified: false },
+    });
+    await prisma.organization.create({
+      data: { id: organizationId, name: "Own-key fixture", slug: organizationId, createdAt },
+    });
+    await prisma.space.create({
+      data: { id: spaceId, organizationId, name: "Personal", isDefault: true },
+    });
+    await prisma.member.create({
+      data: { id: `member-${stamp}`, organizationId, userId, role: "owner", createdAt },
+    });
+    service = createBillingService({ prisma, provider, webOrigin: "https://example.test" });
+  });
+  afterAll(async () => {
+    await prisma.organization.delete({ where: { id: organizationId } });
+    await prisma.user.delete({ where: { id: userId } });
+    await db.prisma.$disconnect();
+    await db.pool.end();
+  });
+
+  it("stays free without a checkout during the free period", async () => {
+    const freeUntil = new Date(Date.now() + 86_400_000);
+    await prisma.modelCreditAccount.create({
+      data: { organizationId, mode: "byok", byokFreeUntil: freeUntil },
+    });
+    await expect(service.selectFunding(actor, "byok")).resolves.toEqual({ ok: true });
+    await expect(service.status(actor)).resolves.toMatchObject({
+      access: true,
+      byokFreeUntil: freeUntil.toISOString(),
+    });
+    await expect(spaceHasModelAccess(prisma, spaceId)).resolves.toBe(true);
+    expect(await billingAccountForOrganization(prisma, organizationId)).toBeNull();
+  });
+
+  it("loses access when the free period ends", async () => {
+    await prisma.modelCreditAccount.update({
+      where: { organizationId },
+      data: { byokFreeUntil: new Date(Date.now() - 1000) },
+    });
+    await expect(service.status(actor)).resolves.toMatchObject({
+      access: false,
+      byokFreeUntil: null,
+    });
+    await expect(spaceHasModelAccess(prisma, spaceId)).resolves.toBe(false);
+  });
+
+  it("grants access once the plan is paid", async () => {
+    const { url } = await service.checkout(actor);
+    expect(url).toContain("/byok/");
+    const customer = (await billingAccountForOrganization(prisma, organizationId))!.customerId;
+    // The free period was this organization's trial.
+    expect(provider.byokCheckouts.get(customer)?.trialDays).toBeUndefined();
+    provider.completeByokCheckout(customer);
+    await service.sync(customer);
+    await expect(service.status(actor)).resolves.toMatchObject({
+      access: true,
+      funding: "byok",
+      state: "active",
+      balanceUsd: 0,
+    });
+    await expect(spaceHasModelAccess(prisma, spaceId)).resolves.toBe(true);
+    await expect(service.checkout(actor)).rejects.toMatchObject({ code: "CONFLICT" });
+  });
+
+  it("keeps showing the price the plan was bought at after the price changes", async () => {
+    const customer = (await billingAccountForOrganization(prisma, organizationId))!.customerId;
+    const plan = provider.subscriptions.find((subscription) => subscription.byokPlan)!;
+    expect(plan.byokPriceCents).toBe(BYOK_TIERS.standard.monthlyPriceCents);
+    // Bought before the price rose.
+    plan.byokPriceCents = BYOK_TIERS.standard.monthlyPriceCents! - 500;
+    await service.sync(customer);
+    await expect(service.status(actor)).resolves.toMatchObject({
+      byokPriceCents: BYOK_TIERS.standard.monthlyPriceCents! - 500,
+    });
+  });
+
+  it("ends the plan at renewal once monthly credits start", async () => {
+    await service.purchaseCredits(actor, { amountCents: 2000, monthly: true });
+    const customer = (await billingAccountForOrganization(prisma, organizationId))!.customerId;
+    provider.completeCreditCheckout(customer);
+    await service.sync(customer);
+    await expect(service.status(actor)).resolves.toMatchObject({
+      funding: "credits",
+      monthlyAmountCents: 2000,
+    });
+    expect(
+      provider.subscriptions.find((subscription) => !subscription.creditAmountCents),
+    ).toMatchObject({ status: "active", cancelAtPeriodEnd: true });
+  });
+
+  it("switches to the plan when its payment syncs, without the checkout return", async () => {
+    const customer = (await billingAccountForOrganization(prisma, organizationId))!.customerId;
+    for (const subscription of provider.subscriptions) subscription.status = "canceled";
+    await service.sync(customer);
+    await expect(service.status(actor)).resolves.toMatchObject({
+      access: true,
+      funding: "credits",
+    });
+    await expect(service.selectFunding(actor, "byok")).resolves.toMatchObject({
+      url: expect.stringContaining("/byok/"),
+    });
+    await expect(service.status(actor)).resolves.toMatchObject({ funding: "credits" });
+    provider.completeByokCheckout(customer);
+    await service.sync(customer);
+    await expect(service.status(actor)).resolves.toMatchObject({ funding: "byok", access: true });
+  });
+
+  it("ends the plan when monthly credits start already set not to renew", async () => {
+    await service.purchaseCredits(actor, { amountCents: 2000, monthly: true });
+    const customer = (await billingAccountForOrganization(prisma, organizationId))!.customerId;
+    provider.completeCreditCheckout(customer);
+    provider.subscriptions.at(-1)!.cancelAtPeriodEnd = true;
+    await service.sync(customer);
+    expect(
+      provider.subscriptions.find(
+        (subscription) => subscription.byokPlan && subscription.status === "active",
+      ),
+    ).toMatchObject({ cancelAtPeriodEnd: true });
+  });
+
+  it("bills the yearly plan at the yearly price and shows it as yearly", async () => {
+    const customer = (await billingAccountForOrganization(prisma, organizationId))!.customerId;
+    for (const subscription of provider.subscriptions) subscription.status = "canceled";
+    await service.sync(customer);
+    await expect(service.status(actor)).resolves.toMatchObject({
+      byokPriceCents: BYOK_TIERS.standard.monthlyPriceCents,
+      byokInterval: "month",
+      byokAnnualPriceCents: BYOK_TIERS.standard.annualPriceCents,
+    });
+    await service.selectFunding(actor, "byok", undefined, "year");
+    expect(provider.byokCheckouts.get(customer)).toMatchObject({
+      amountCents: BYOK_TIERS.standard.annualPriceCents,
+      interval: "year",
+    });
+    provider.completeByokCheckout(customer);
+    await service.sync(customer);
+    await expect(service.status(actor)).resolves.toMatchObject({
+      access: true,
+      funding: "byok",
+      byokPriceCents: BYOK_TIERS.standard.annualPriceCents,
+      byokInterval: "year",
+    });
+  });
+
+  it("switches a paid monthly plan to yearly, once", async () => {
+    const customer = (await billingAccountForOrganization(prisma, organizationId))!.customerId;
+    for (const subscription of provider.subscriptions) subscription.status = "canceled";
+    await service.sync(customer);
+    await service.selectFunding(actor, "byok");
+    provider.completeByokCheckout(customer);
+    await service.sync(customer);
+    await expect(service.status(actor)).resolves.toMatchObject({ byokInterval: "month" });
+    // A subscriber on an older, cheaper monthly price would pay more by switching.
+    const plan = provider.subscriptions.at(-1)!;
+    plan.byokPriceCents = 1000;
+    await expect(service.switchToYearly(actor)).rejects.toMatchObject({ code: "CONFLICT" });
+    plan.byokPriceCents = BYOK_TIERS.standard.monthlyPriceCents!;
+    // An overdue month must not be credited against the year.
+    plan.status = "past_due";
+    await expect(service.switchToYearly(actor)).rejects.toMatchObject({ code: "CONFLICT" });
+    plan.status = "active";
+    await service.switchToYearly(actor);
+    await expect(service.status(actor)).resolves.toMatchObject({
+      access: true,
+      byokPriceCents: BYOK_TIERS.standard.annualPriceCents,
+      byokInterval: "year",
+    });
+    await expect(service.switchToYearly(actor)).rejects.toMatchObject({ code: "CONFLICT" });
+  });
+
+  it("subscribes to a tier and moves between tiers at the same interval", async () => {
+    const customer = (await billingAccountForOrganization(prisma, organizationId))!.customerId;
+    for (const subscription of provider.subscriptions) subscription.status = "canceled";
+    await service.sync(customer);
+    await expect(service.status(actor)).resolves.toMatchObject({
+      byokTier: "standard",
+      byokTiers: [
+        { tier: "standard", monthlyPriceCents: 1500, computerSize: "standard", computerHours: 25 },
+        { tier: "pro", monthlyPriceCents: 4900, computerSize: "large", computerHours: 100 },
+        { tier: "max", monthlyPriceCents: 9900, computerSize: "xlarge", computerHours: 200 },
+        {
+          tier: "ultra",
+          monthlyPriceCents: 19900,
+          annualPriceCents: 190800,
+          computerSize: "xlarge",
+          computerHours: 600,
+        },
+      ],
+    });
+    await service.checkout(actor, undefined, "year", "pro");
+    expect(provider.byokCheckouts.get(customer)).toMatchObject({
+      amountCents: BYOK_TIERS.pro.annualPriceCents,
+      interval: "year",
+      tier: "pro",
+    });
+    provider.completeByokCheckout(customer);
+    await service.sync(customer);
+    await expect(service.status(actor)).resolves.toMatchObject({
+      byokTier: "pro",
+      byokPriceCents: BYOK_TIERS.pro.annualPriceCents,
+      byokInterval: "year",
+    });
+    const computer = await prisma.computer.create({
+      data: {
+        spaceId,
+        userId,
+        scope: "team",
+        scopeKey: `byok-team-${stamp}`,
+        homeKey: `byok-home-${stamp}`,
+        kind: "boat",
+      },
+    });
+    expect(await planComputerSize(prisma, computer.id)).toBe("standard");
+    const sized = createBillingService({
+      prisma,
+      provider,
+      sandbox: { describe: () => ({ id: "boat" }) } as SandboxProvider,
+      webOrigin: "https://example.test",
+    });
+    await expect(sized.cloudComputers(actor)).resolves.toEqual({
+      computers: [
+        { id: computer.id, scope: "team", botName: null, size: "standard", savedSize: "standard" },
+      ],
