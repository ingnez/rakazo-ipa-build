+import { ph } from "@lingui/core/macro";
+import { useLingui } from "@lingui/react/macro";
+import type { Bot } from "@rakazo/contracts";
+import { useRouter } from "expo-router";
+import { memo, useState } from "react";
+import { Alert, Image, Linking, Pressable, StyleSheet, Text, View } from "react-native";
+import { rpc } from "../../lib/api";
+import {
+  isFormLink,
+  linkPreviewCover,
+  linkSiteLabel,
+  useLinkPreview,
+} from "../../lib/link-preview";
+import { useMobileTokens, useResolvedAppearance } from "../../lib/native";
+import { errorText } from "../../lib/user-error";
+import { NativeSymbol } from "../native-symbol";
+import { PressScale } from "../press-scale";
+
+/**
+ * The card a pasted link becomes — the page's own picture across the top, as the reference app
+ * draws one.
+ *
+ * A page the server could read a picture from draws as a wide card: the cover across the top at
+ * `2:1`, the page's title under it, and the domain at the foot. The card takes the width the
+ * message column gives it, so a `1280×640` banner reads as the page it belongs to; the cover used
+ * to be a `96pt` square on the right, which cropped that banner down to a middle slice and squeezed
+ * the title into a column two words wide (`IMG_2989`). Its height stays the banner's own, so a chat
+ * can hold several of these cards and still read.
+ *
+ * A link whose page is a form to fill in or an authorization to confirm (a sign-in, a device code,
+ * a page that asks the person to continue) is the one thing here a person must act on, so it is
+ * drawn the way the reference app draws it: a `🌐 表单` line, the page's title, and one `继续`
+ * button. A link with no picture to show stays the single quiet line it is now: it is a
+ * reference, not a page to read in the chat, and an empty frame would be worse than a line.
+ *
+ * It sits outside the bubble, so it reads as the page rather than as something the speaker said.
+ * A link with nothing to show draws no card at all: the text already carries it.
+ */
+export const LinkPreviewCard = memo(function LinkPreviewCard({
+  url,
+}: {
+  /** The link as it appeared in the message. */
+  url: string;
+}) {
+  const preview = useLinkPreview(url);
+  if (!preview) return null;
+  const title = preview.title?.trim() || linkSiteLabel(preview.url);
+  if (isGrokShare(preview.url)) return <BotShare url={preview.url} title={title} />;
+  const site = preview.siteName?.trim() || linkSiteLabel(preview.url);
+  if (isFormLink(preview.url)) return <FormCard url={preview.url} title={title} site={site} />;
+  const cover = linkPreviewCover(preview);
+  if (!cover) return <LinkLine url={preview.url} title={title} site={site} />;
+  return (
+    <LinkCard
+      url={preview.url}
+      title={title}
+      site={site}
+      cover={cover}
+      description={preview.description?.trim() || undefined}
+    />
+  );
+});
+
+/** A page with a picture: its cover across the top, then the title, and the domain at the foot. */
+function LinkCard({
+  url,
+  title,
+  site,
+  cover,
+  description,
+}: {
+  url: string;
+  title: string;
+  site: string;
+  cover: string;
+  description?: string;
+}) {
+  const { t } = useLingui();
+  const tokens = useMobileTokens();
+  const theme = useResolvedAppearance();
+  const card = theme === "dark" ? tokens.card : "#FFFFFF";
+  return (
+    <Pressable
+      accessibilityRole="link"
+      accessibilityLabel={t`Open ${ph({ title })}`}
+      testID="link-card"
+      onPress={() => void Linking.openURL(url).catch(() => undefined)}
+      style={({ pressed }) => [
+        styles.card,
+        { backgroundColor: card, borderColor: tokens.border, opacity: pressed ? 0.85 : 1 },
+      ]}
+    >
+      <Image
+        accessibilityIgnoresInvertColors
+        source={{ uri: cover }}
+        resizeMode="cover"
+        testID="link-card-cover"
+        style={[styles.cardCover, { backgroundColor: tokens.muted }]}
+      />
+      <View style={styles.cardBody}>
+        <Text numberOfLines={2} style={[styles.cardTitle, { color: tokens.foreground }]}>
+          {title}
+        </Text>
+        {description ? (
+          <Text
+            numberOfLines={2}
+            style={[styles.cardDescription, { color: tokens.mutedForeground }]}
+          >
+            {description}
+          </Text>
+        ) : null}
+        <View style={styles.cardSiteRow}>
+          <NativeSymbol
+            ios="globe"
+            android="globe-outline"
+            size={11}
+            color={tokens.mutedForeground}
+          />
+          <Text numberOfLines={1} style={[styles.cardSite, { color: tokens.mutedForeground }]}>
+            {site}
+          </Text>
+        </View>
+      </View>
+    </Pressable>
+  );
+}
+
+/** An external form or an authorization waiting on the person: one title, one button. */
+function FormCard({ url, title, site }: { url: string; title: string; site: string }) {
+  const { t } = useLingui();
+  const tokens = useMobileTokens();
+  const theme = useResolvedAppearance();
+  const card = theme === "dark" ? tokens.card : "#FFFFFF";
+  // The reference app's button is light on a dark card; on a light card it takes the ink instead.
+  const button = theme === "dark" ? "#FFFFFF" : tokens.foreground;
+  const label = theme === "dark" ? "#000000" : tokens.background;
+  return (
+    <View
+      accessibilityRole="button"
+      accessibilityLabel={t`Continue in ${ph({ site })}`}
+      testID="form-card"
+      style={[styles.form, { backgroundColor: card, borderColor: tokens.border }]}
+    >
+      <View style={styles.formHead}>
+        <NativeSymbol
+          ios="globe"
+          android="globe-outline"
+          size={12}
+          color={tokens.mutedForeground}
+        />
+        <Text style={[styles.formKind, { color: tokens.mutedForeground }]}>{t`表单`}</Text>
+      </View>
+      <Text numberOfLines={2} style={[styles.formTitle, { color: tokens.foreground }]}>
+        {title}
+      </Text>
+      <View style={styles.formFoot}>
+        <PressScale
+          accessibilityRole="button"
+          accessibilityLabel={t`Continue`}
+          testID="form-card-continue"
+          onPress={() => void Linking.openURL(url).catch(() => undefined)}
+          containerStyle={styles.continueContainer}
+          style={[styles.continue, { backgroundColor: button }]}
+        >
+          <Text style={[styles.continueLabel, { color: label }]}>{t`继续`}</Text>
+        </PressScale>
+      </View>
+    </View>
+  );
+}
+
+/** Any other link: one line with its title and its site. Nothing to fill in, nothing to cover. */
+function LinkLine({ url, title, site }: { url: string; title: string; site: string }) {
+  const { t } = useLingui();
+  const tokens = useMobileTokens();
+  return (
+    <Pressable
+      accessibilityRole="link"
+      accessibilityLabel={t`Open ${ph({ title })}`}
+      testID="link-line"
+      onPress={() => void Linking.openURL(url).catch(() => undefined)}
+      style={({ pressed }) => [
+        styles.line,
+        { backgroundColor: tokens.muted, opacity: pressed ? 0.7 : 1 },
+      ]}
+    >
+      <NativeSymbol ios="link" android="link-outline" size={12} color={tokens.mutedForeground} />
+      <Text numberOfLines={1} style={[styles.lineTitle, { color: tokens.foreground }]}>
+        {title}
+      </Text>
+      <Text numberOfLines={1} style={[styles.lineSite, { color: tokens.mutedForeground }]}>
+        {site}
+      </Text>
+    </Pressable>
+  );
+}
+
+/** A public Grok Bot share: the same compact card, with the one action it carries. */
+function BotShare({ url, title }: { url: string; title: string }) {
+  const { t } = useLingui();
+  const router = useRouter();
+  const tokens = useMobileTokens();
+  const theme = useResolvedAppearance();
+  const [importing, setImporting] = useState(false);
+  const card = theme === "dark" ? tokens.card : "#FFFFFF";
+  const button = theme === "dark" ? "#FFFFFF" : tokens.foreground;
+  const label = theme === "dark" ? "#000000" : tokens.background;
+
+  async function importBot() {
+    if (importing) return;
+    setImporting(true);
+    try {
+      const bot: Bot = await rpc("bots/importGrokLink", { url });
+      router.push({ pathname: "/thread", params: { botId: bot.id, name: bot.name } });
+    } catch (cause) {
+      Alert.alert(t`Could not import this bot`, errorText(cause, t`Please try again.`));
+    } finally {
+      setImporting(false);
+    }
+  }
+
+  return (
+    <View style={[styles.form, { backgroundColor: card, borderColor: tokens.border }]}>
+      <View style={styles.formHead}>
+        <NativeSymbol ios="link" android="link-outline" size={12} color={tokens.mutedForeground} />
+        <Text style={[styles.formKind, { color: tokens.mutedForeground }]}>{t`Bot 链接`}</Text>
+      </View>
+      <Text numberOfLines={2} style={[styles.formTitle, { color: tokens.foreground }]}>
+        {title}
+      </Text>
+      <View style={styles.formFoot}>
+        <PressScale
+          accessibilityRole="button"
+          disabled={importing}
+          onPress={() => void importBot()}
+          containerStyle={styles.continueContainer}
+          style={[styles.continue, { backgroundColor: button }]}
+        >
+          <Text style={[styles.continueLabel, { color: label }]}>
+            {importing ? t`Importing…` : t`Import bot`}
+          </Text>
+        </PressScale>
+      </View>
+    </View>
+  );
+}
+
+/** The same rule the server uses for an importable share, kept local so the card can decide. */
+function isGrokShare(url: string): boolean {
+  try {
+    const parsed = new URL(url);
+    const host = parsed.hostname.toLowerCase();
+    return (host === "x.ai" || host === "www.x.ai") && parsed.pathname.startsWith("/bot/");
+  } catch {
+    return false;
+  }
+}
+
+const styles = StyleSheet.create({
+  // Narrower than a message bubble and only as tall as its three lines.
+  form: {
+    alignSelf: "flex-start",
+    minWidth: 208,
+    maxWidth: 292,
+    borderRadius: 20,
+    borderCurve: "continuous",
+    borderWidth: StyleSheet.hairlineWidth,
+    paddingHorizontal: 16,
+    paddingTop: 12,
+    paddingBottom: 10,
+    gap: 8,
+  },
+  formHead: { flexDirection: "row", alignItems: "center", gap: 6 },
+  formKind: { fontSize: 12.5, fontWeight: "500" },
+  formTitle: { fontSize: 16, fontWeight: "600", lineHeight: 21 },
+  formFoot: { flexDirection: "row", justifyContent: "flex-end" },
+  continueContainer: { alignSelf: "flex-end" },
+  continue: { borderRadius: 999, paddingHorizontal: 16, paddingVertical: 7 },
+  continueLabel: { fontSize: 13.5, fontWeight: "600" },
+  // The page card: a banner of cover across the top, then the words underneath. It fills the
+  // column the message row gives it (up to 310pt), so the banner is the page's own shape, and its
+  // corners are cut by the card rather than by the picture.
+  card: {
+    alignSelf: "flex-start",
+    width: "100%",
+    maxWidth: 310,
+    borderRadius: 18,
+    borderCurve: "continuous",
+    borderWidth: StyleSheet.hairlineWidth,
+    overflow: "hidden",
+  },
+  cardCover: { width: "100%", aspectRatio: 2 },
+  cardBody: {
+    paddingHorizontal: 14,
+    paddingTop: 10,
+    paddingBottom: 12,
+    gap: 3,
+  },
+  cardTitle: { fontSize: 16, fontWeight: "600", lineHeight: 21 },
+  cardDescription: { fontSize: 13, lineHeight: 18 },
+  cardSiteRow: { flexDirection: "row", alignItems: "center", gap: 4, marginTop: 2 },
+  cardSite: { fontSize: 12, flexShrink: 1 },
+  line: {
+    flexDirection: "row",
+    alignItems: "center",
+    gap: 6,
+    borderRadius: 12,
+    borderCurve: "continuous",
+    paddingHorizontal: 10,
+    paddingVertical: 7,
+  },
+  lineTitle: { fontSize: 12.5, fontWeight: "500", flexShrink: 1 },
+  lineSite: { fontSize: 11.5, flexShrink: 1 },
+});
