new file mode 100644
index 000000000..ba9ef39e0
--- /dev/null
+++ b/apps/mobile/lib/document-scanner.ts
@@ -0,0 +1,144 @@
+import {
+  ATTACHMENT_MAX_BYTES,
+  ATTACHMENT_MAX_COUNT,
+} from "@rakazo/contracts";
+import { inferAttachmentMimeType } from "@rakazo/core";
+import { File } from "expo-file-system";
+import { requireOptionalNativeModule } from "expo-modules-core";
+import { Image } from "react-native";
+import { prepareImageAttachment } from "./pick-attachments";
+import type { PickedAttachment, PickSkip } from "./pick-attachments-filter.js";
+import {
+  attachmentCountSkipReason,
+  attachmentSizeSkipReason,
+  filterPickedAttachments,
+} from "./pick-attachments-filter.js";
+
+/** The document camera module, written for iOS; absent in a build without it. */
+type DocumentScannerModule = {
+  isAvailable: () => boolean;
+  /** One file URI per scanned page, in page order; empty when the person backs out. */
+  scan: () => Promise<string[]>;
+};
+
+function documentScanner(): DocumentScannerModule | null {
+  return (
+    (requireOptionalNativeModule("RakazoDocumentScanner") as DocumentScannerModule | null) ?? null
+  );
+}
+
+/** Whether this build and device can open the document camera. */
+export function canScanDocuments(): boolean {
+  try {
+    return documentScanner()?.isAvailable() ?? false;
+  } catch {
+    return false;
+  }
+}
+
+async function readBase64(
+  uri: string,
+  maxBytes: number,
+): Promise<{ contentBase64: string; size: number }> {
+  const file = new File(uri);
+  const knownSize = file.info().size;
+  if (typeof knownSize === "number" && knownSize > maxBytes) {
+    return { contentBase64: "", size: knownSize };
+  }
+  const contentBase64 = await file.base64();
+  return { contentBase64, size: knownSize ?? Math.floor((contentBase64.length * 3) / 4) };
+}
+
+/** A page's pixel size, so a scan is sized down like a camera photo and not rejected as too big. */
+function imageSize(uri: string): Promise<{ width: number; height: number } | null> {
+  return new Promise((resolve) => {
+    Image.getSize(
+      uri,
+      (width, height) => resolve({ width, height }),
+      () => resolve(null),
+    );
+  });
+}
+
+async function removeQuietly(uri: string) {
+  try {
+    const file = new File(uri);
+    if (file.exists) file.delete();
+  } catch {
+    // A temporary page that cannot be removed is left to the system's own cleanup.
+  }
+}
+
+/**
+ * Scans paper documents with the system camera and returns the pages as image attachments, in
+ * the shape the photo picker returns, so the composer sends them like any other image. The pages
+ * are straightened and cropped by the system before they arrive.
+ */
+export async function scanDocuments(
+  existingCount = 0,
+  maxBytes = ATTACHMENT_MAX_BYTES,
+  maxCount = ATTACHMENT_MAX_COUNT,
+): Promise<{ attachments: PickedAttachment[]; skipped: PickSkip[] }> {
+  const module = documentScanner();
+  if (!module || !module.isAvailable()) {
+    return { attachments: [], skipped: [{ name: "scan", reason: "unsupported type" }] };
+  }
+  let uris: string[];
+  try {
+    uris = await module.scan();
+  } catch (error) {
+    // A camera that cannot open is reported like a picker that fails to open.
+    const message = error instanceof Error ? error.message : String(error);
+    return { attachments: [], skipped: [{ name: "scan", reason: message || "could not read" }] };
+  }
+  const attachments: PickedAttachment[] = [];
+  const skipped: PickSkip[] = [];
+  for (const uri of uris) {
+    const name = `scan-${Date.now()}-${attachments.length + 1}.jpg`;
+    if (existingCount + attachments.length >= maxCount) {
+      skipped.push({ name, reason: attachmentCountSkipReason(maxCount) });
+      continue;
+    }
+    let previewUri = uri;
+    try {
+      // The same treatment a camera photo gets: sized down to what a message carries, converted
+      // to a format every model can read.
+      const dimensions = await imageSize(uri);
+      const prepared = await prepareImageAttachment(
+        uri,
+        name,
+        "image/jpeg",
+        dimensions?.width,
+        dimensions?.height,
+      );
+      previewUri = prepared.uri;
+      const { contentBase64, size } = await readBase64(prepared.uri, maxBytes);
+      if (size > maxBytes) {
+        skipped.push({ name, reason: attachmentSizeSkipReason(maxBytes) });
+        continue;
+      }
+      const filtered = filterPickedAttachments(
+        existingCount + attachments.length,
+        [
+          {
+            name: prepared.name,
+            mimeType: inferAttachmentMimeType(prepared.name, prepared.mimeType ?? "image/jpeg"),
+            size,
+            contentBase64,
+            previewUri: prepared.uri,
+          },
+        ],
+        maxBytes,
+        maxCount,
+      );
+      attachments.push(...filtered.attachments);
+      skipped.push(...filtered.skipped);
+    } catch {
+      skipped.push({ name, reason: "could not read" });
+    } finally {
+      void removeQuietly(uri);
+      if (previewUri !== uri) void removeQuietly(previewUri);
+    }
+  }
+  return { attachments, skipped };
+}
