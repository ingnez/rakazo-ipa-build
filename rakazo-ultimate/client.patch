+    key: "approval",
+    label: () => t`需要你确认`,
+  },
+];
+
+/** The line a bot waiting on the user shows instead of what it is doing. */
+export function needsYouStep(): ActivityStep {
+  return { key: "needs-you", label: t`需要你输入` };
+}
+
+/** `using Read file` — a call whose arguments named no target at all. */
+const USING_TOOL = /^using\s+(.+)$/i;
+
+/** A line with no Chinese in it is not the bot talking to this reader. */
+const HAS_CJK = /[\u3400-\u9fff\uf900-\ufaff]/;
+
+/**
+ * A name this table has not learned, followed by what it was given: `Notion search 周报`. Two
+ * English words at least, so a note that merely opens with one is still the bot's own.
+ */
+const UNKNOWN_TOOL_LINE = /^[A-Za-z][\w.-]*(?: [\w./-]+)+ \S/;
+
+/**
+ * The programs a bare command line may start with. A shell writes its own step as the command
+ * itself, with no tool's name in front of it.
+ */
+const COMMANDS = new Set(
+  (
+    "ls ll la cat head tail less more grep egrep rg ag sed awk find fd tree stat file wc sort " +
+    "uniq cut tr diff patch xargs echo printf tee touch mkdir rmdir cp mv rm ln chmod chown cd " +
+    "pwd env export source alias which whereis type readlink date sleep time du df free ps top " +
+    "htop kill pkill nohup node npm npx pnpm yarn bun deno tsc eslint biome prettier vitest jest " +
+    "pytest python python3 pip pip3 uv poetry ruby gem go cargo rustc java javac mvn gradle swift " +
+    "swiftc xcrun xcodebuild pod fastlane plutil defaults osascript screencapture security git gh " +
+    "curl wget ssh scp rsync nc ping dig nslookup netstat lsof ip ifconfig ss traceroute openssl " +
+    "gpg tar zip unzip gzip gunzip jq yq sqlite3 psql mysql redis-cli mongosh docker " +
+    "docker-compose kubectl helm terraform ansible aws gcloud az make cmake ninja bash sh zsh " +
+    "fish sudo su apt apt-get dpkg brew systemctl service journalctl crontab launchctl mount " +
+    "umount uname whoami id groups hostname uptime man vim vi nano emacs code open ffmpeg convert " +
+    "magick sips textutil base64 md5 md5sum shasum sha256sum"
+  ).split(" "),
+);
+
+/** True for a line that is one command rather than a sentence (`ls -la`, `/usr/bin/env node x`). */
+function isCommandLine(text: string): boolean {
+  const first = text.split(" ")[0] ?? "";
+  if (COMMANDS.has(first.toLowerCase())) return true;
+  // A program named by its path: `./build.sh`, `~/bin/check`, `/usr/bin/env node …`.
+  if (/^(?:\.{0,2}\/|~\/)/.test(first)) return true;
+  // A command with a variable set in front of it: `EXPO_PUBLIC_API_URL=… pnpm build`.
+  if (/^[A-Za-z_][A-Za-z0-9_]*=/.test(first)) return true;
+  // One line that pipes, chains, redirects or reads a variable is one command.
+  return /[|&;<>()`$]/.test(text);
+}
+
+/** The phrase for the tool at the head of a line, and what the tool was handed after it. */
+function toolStepParts(text: string): { step: ActivityStep; detail: string } | undefined {
+  const lower = text.toLowerCase();
+  for (const [name, phrase] of TOOL_BY_NAME) {
+    if (lower === name) return { step: { key: phrase.key, label: phrase.label() }, detail: "" };
+    if (lower.startsWith(`${name} `)) {
+      const step = { key: phrase.key, label: phrase.label() };
+      return { step, detail: text.slice(name.length).trim() };
+    }
+  }
+  return undefined;
+}
+
+/** How much of a step the line shows before it is cut short. */
+const STEP_MAX = 16;
+
+/** A path, a file, or a URL: a thing a tool was handed rather than the action it took. */
+const PATH_LIKE =
+  /(?:^|\s)(?:~?\/|\.{0,2}\/)\S|https?:\/\/|\b[\w-]+\.(?:swift|tsx?|jsx?|mjs|cjs|json|ya?ml|md|txt|csv|tsv|py|sh|bash|zsh|rb|go|rs|java|kt|html?|css|scss|png|jpe?g|gif|webp|heic|pdf|docx?|xlsx?|pptx?|zip|tar|gz|ipa|apk|plist|pbxproj|sql|env)\b/i;
+
+/**
+ * The verbs a Chinese action opens with: 「读取 magpie 部署文档」「搜索历史报错」. A name a tool was
+ * handed — 交班记录 — opens with none of them, and stays a name.
+ */
+const ACTION_VERBS = [
+  "读取",
+  "读",
+  "查看",
+  "看看",
+  "翻开",
+  "翻看",
+  "翻",
+  "搜索",
+  "搜",
+  "查找",
+  "找到",
+  "找",
+  "查询",
+  "查",
+  "检索",
+  "整理",
+  "核对",
+  "对比",
+  "比较",
+  "分析",
+  "总结",
+  "归纳",
+  "收尾",
+  "准备",
+  "生成",
+  "创建",
+  "新建",
+  "更新",
+  "修改",
+  "改",
+  "删除",
+  "删",
+  "发送",
+  "发",
+  "写",
+  "保存",
+  "导入",
+  "导出",
+  "同步",
+  "下载",
+  "上传",
+  "安装",
+  "部署",
+  "构建",
+  "编译",
+  "运行",
+  "跑",
+  "执行",
+  "重启",
+  "启动",
+  "打开",
+  "关闭",
+  "确认",
+  "检查",
+  "检测",
+  "修复",
+  "修",
+  "记录",
+  "记下",
+  "记",
+  "安排",
+  "提醒",
+  "回复",
+  "转述",
+  "拍",
+  "画",
+  "做",
+  "烧",
+  "订",
+  "买",
+  "呼叫",
+  "拨打",
+  "朗读",
+  "播放",
+  "收听",
+] as const;
+
+/**
+ * The work's own step, in the reader's words: the detail a call was given when it is an action
+ * rather than a file name or a command. Cut at sixteen characters so the line stays one line.
+ */
+export function specificStep(detail: string | undefined): string | undefined {
+  const text = detail?.replace(/\s+/g, " ").trim();
+  if (!text) return undefined;
+  if (!HAS_CJK.test(text)) return undefined;
+  // An action opens in the reader's own words; `to 张医生` is a target, not the step.
+  if (!HAS_CJK.test(text[0] ?? "")) return undefined;
+  if (isCommandLine(text)) return undefined;
+  if (PATH_LIKE.test(text)) return undefined;
+  const opensWithVerb = ACTION_VERBS.some((verb) => text.startsWith(verb));
+  // A phrase of several words is a sentence even without a verb this table knows.
+  const phraseLike = text.includes(" ") && text.length >= 6;
+  if (!opensWithVerb && !phraseLike) return undefined;
+  return text.length > STEP_MAX ? `${text.slice(0, STEP_MAX).trimEnd()}…` : text;
+}
+
+/** A note that is not about a tool: the bot's own words, kept as written. */
+const NOTE_MAX = 90;
+
+/**
+ * The step one live activity line stands for. A call's line becomes its phrase, a command line
+ * becomes the shell's, and anything with no Chinese in it — a tool this table has not met, a
+ * command — is never shown as written. The bot's own note stays its words, so a reader sees
+ * "先去查院内的指南" rather than a tool name.
+ */
+export function activityStep(line: string | undefined): ActivityStep | undefined {
+  const text = line?.replace(/\s+/g, " ").trim();
+  if (!text) return undefined;
+  // `using Read file`: the tool is the whole line, and it is not `Using your computer`.
+  const named = USING_TOOL.exec(text)?.[1];
+  if (named) {
+    const parts = toolStepParts(named);
+    if (parts) {
+      const specific = specificStep(parts.detail);
+      if (specific) return { key: `step:${specific}`, label: specific, specific: true };
+      return parts.step;
+    }
+  }
+  // The work wrote what it is doing in the reader's language: that is the line, not a fold of it.
+  // Only after an English tool's own prefix, so a Chinese note that happens to contain a colon
+  // keeps its own opening.
+  const colon = text.indexOf(": ");
+  const written =
+    colon > 0 && !HAS_CJK.test(text.slice(0, colon))
+      ? specificStep(text.slice(colon + 2))
+      : undefined;
+  if (written) return { key: `step:${written}`, label: written, specific: true };
+  for (const rule of RULES) {
+    if (rule.match.test(text)) return { key: rule.key, label: rule.label() };
+  }
+  const parts = toolStepParts(text);
+  if (parts) {
+    const specific = specificStep(parts.detail);
+    if (specific) return { key: `step:${specific}`, label: specific, specific: true };
+    return parts.step;
+  }
+  if (!HAS_CJK.test(text)) {
+    return isCommandLine(text)
+      ? { key: "shell", label: t`正在执行几条命令` }
+      : { key: "unknown-tool", label: t`正在处理` };
+  }
+  if (UNKNOWN_TOOL_LINE.test(text)) return { key: "unknown-tool", label: t`正在处理` };
+  const clipped = text.length > NOTE_MAX ? `${text.slice(0, NOTE_MAX).trimEnd()}…` : text;
+  return { key: `note:${clipped}`, label: clipped, specific: true };
+}
