+    // A card is about 330 points wide; asking for more than 900 only spends memory.
+    let width = min(max(maxWidth, 160), 900)
+    let request = QLThumbnailGenerator.Request(
+      fileAt: url,
+      size: CGSize(width: width, height: (width * 1.4).rounded()),
+      scale: 2,
+      representationTypes: .all
+    )
+    let race = Race()
+    // A deck that takes its time is a card that shows its compact row: the chat never waits on one.
+    DispatchQueue.main.asyncAfter(deadline: .now() + 5) {
+      guard race.claim() else { return }
+      figure("timed out", uri)
+      promise.resolve(nil)
+    }
+    QLThumbnailGenerator.shared.generateBestRepresentation(for: request) { representation, error in
+      guard race.claim() else { return }
+      guard let image = representation?.uiImage, image.size.width > 0, image.size.height > 0 else {
+        figure(error?.localizedDescription ?? "no image", uri)
+        promise.resolve(nil)
+        return
+      }
+      guard let data = image.pngData() else {
+        figure("no png", uri)
+        promise.resolve(nil)
+        return
+      }
+      let directory = FileManager.default
+        .urls(for: .cachesDirectory, in: .userDomainMask)[0]
+        .appendingPathComponent("office-page-thumbnails", isDirectory: true)
+      do {
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+      } catch {
+        figure("no cache directory", uri)
+        promise.resolve(nil)
+        return
+      }
+      let file = directory.appendingPathComponent("\(stamp(uri: uri, width: width)).png")
+      if !FileManager.default.fileExists(atPath: file.path) {
+        do {
+          try data.write(to: file, options: .atomic)
+        } catch {
+          figure("not written", uri)
+          promise.resolve(nil)
+          return
+        }
+      }
+      promise.resolve([
+        "uri": file.absoluteString,
+        "width": Double(image.size.width),
+        "height": Double(image.size.height),
+      ])
+    }
+  }
+
+  /// A page that could not be drawn says why in the device log, once per card that asked.
+  private static func figure(_ why: String, _ uri: String) {
+    NSLog("[RakazoQuickLook] office-page-thumbnail %@: %@", why, uri)
+  }
+
+  /// A stable name for one file at one width: FNV-1a, so it needs no hashing framework.
+  private static func stamp(uri: String, width: Double) -> String {
+    var hash: UInt64 = 0xcbf2_9ce4_8422_2325
+    for byte in "\(uri)#office#\(Int(width))".utf8 {
+      hash ^= UInt64(byte)
+      hash = hash &* 0x0000_0100_0000_01b3
+    }
+    return String(hash, radix: 16)
+  }
+}
