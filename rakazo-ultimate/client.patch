@@ -0,0 +1,123 @@
+import { existsSync, readFileSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+import { BOT_COLOR_LIST, botColorDefForHex, isWhiteBotColor } from "@rakazo/contracts";
+import { describe, expect, it } from "vitest";
+import {
+  AVATAR_BODIES,
+  AVATAR_BODY_KEYS,
+  AVATAR_BODY_MAX_RADIUS,
+  AVATAR_GRADIENTS,
+  AVATAR_SOLIDS,
+  AVATAR_VERTICES,
+  avatarBodyKey,
+  avatarEyeInk,
+  avatarRingPath,
+  contrastRatio,
+  eyesInside,
+} from "./avatar-spec.js";
+
+/**
+ * The avatar spec is the one source every renderer draws from, and it is Rakazo's own: these
+ * checks are the machine-readable half of its acceptance (the other half is side-by-side
+ * screenshots the owner signs off on).
+ */
+describe("Rakazo's avatar spec", () => {
+  it("builds 26 bodies of 64 vertices each, clockwise from the top, inside the box", () => {
+    expect(AVATAR_BODY_KEYS).toHaveLength(26);
+    for (const key of AVATAR_BODY_KEYS) {
+      const { ring } = AVATAR_BODIES[key]!;
+      expect(ring, key).toHaveLength(AVATAR_VERTICES * 2);
+      expect(ring[0], key).toBeCloseTo(0, 5);
+      expect(ring[1], key).toBeLessThan(0);
+      // The second vertex is to the right of the first: clockwise on a y-down screen.
+      expect(ring[2], key).toBeGreaterThan(0);
+      for (let i = 0; i < AVATAR_VERTICES; i += 1)
+        expect(Math.hypot(ring[i * 2]!, ring[i * 2 + 1]!), key).toBeLessThanOrEqual(
+          AVATAR_BODY_MAX_RADIUS + 0.1,
+        );
+    }
+  });
+
+  it("fits both eyes inside every body when the spec is built, not with a run-time clamp", () => {
+    for (const key of AVATAR_BODY_KEYS) {
+      const body = AVATAR_BODIES[key]!;
+      expect(eyesInside(body.ring, body.eyes), key).toBe(true);
+      // Every direction the face may look in keeps the pair on the body.
+      for (let k = 0; k < AVATAR_VERTICES; k += 1) {
+        const angle = (k / AVATAR_VERTICES) * Math.PI * 2;
+        const d = body.budget[k]!;
+        expect(
+          eyesInside(body.ring, body.eyes, Math.cos(angle) * d, Math.sin(angle) * d, 2),
+          `${key} ${k}`,
+        ).toBe(true);
+      }
+    }
+  });
+
+  it("maps any stored shape index onto a body, wrapping past the end", () => {
+    expect(avatarBodyKey(0)).toBe(AVATAR_BODY_KEYS[0]);
+    expect(avatarBodyKey(26)).toBe(AVATAR_BODY_KEYS[0]);
+    expect(avatarBodyKey(-1)).toBe(AVATAR_BODY_KEYS[25]);
+  });
+
+  it("draws a closed path for any ring", () => {
+    const path = avatarRingPath(AVATAR_BODIES.blob!.ring, 0.5, 64, 64);
+    expect(path.startsWith("M")).toBe(true);
+    expect(path.endsWith("Z")).toBe(true);
+    expect(path.match(/C/g)).toHaveLength(AVATAR_VERTICES);
+  });
+
+  it("picks eye ink that reads on every body colour, light and dark", () => {
+    for (const [name, solid] of Object.entries(AVATAR_SOLIDS)) {
+      for (const fill of [solid.light, solid.dark]) {
+        expect(contrastRatio(fill, avatarEyeInk(fill)), `${name} ${fill}`).toBeGreaterThanOrEqual(
+          3,
+        );
+      }
+    }
+    expect(Object.keys(AVATAR_GRADIENTS)).toEqual(Object.keys(AVATAR_SOLIDS));
+  });
+
+  it("holds Rakazo's own twelve colours, none of them a value an earlier palette stored", () => {
+    expect(BOT_COLOR_LIST).toHaveLength(12);
