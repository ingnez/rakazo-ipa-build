--- /dev/null
+++ b/apps/mobile/components/mochi-bot-avatar.tsx
@@ -0,0 +1,464 @@
+import type { LogoAvatarActivity } from "@rakazo/core";
+import {
+  avatarLifeState,
+  mochiActivityFromSignals,
+  mochiAvatarFill,
+  mochiBodyMetrics,
+  mochiBodyPath,
+  mochiFace,
+  mochiFaceOrigin,
+  mochiMorphRing,
+  mochiMotionPlan,
+  mochiRingPath,
+  mochiShades,
+  type MochiExpression,
+} from "@rakazo/core";
+import { memo, useEffect, useId, useRef, useState } from "react";
+import { Image, Pressable } from "react-native";
+import Animated, {
+  Easing,
+  cancelAnimation,
+  useAnimatedStyle,
+  useReducedMotion,
+  useSharedValue,
+  withRepeat,
+  withSequence,
+  withSpring,
+  withTiming,
+} from "react-native-reanimated";
+import Svg, { ClipPath, Defs, Ellipse, G, LinearGradient, Path, RadialGradient, Rect, Stop } from "react-native-svg";
+import type { AvatarMotionMode } from "@rakazo/core";
+import { useAfterFirstPaint } from "../lib/after-first-paint";
+import { useAvatarOnScreen, useSettling } from "../lib/avatar-life";
+import { mobileBotAvatarPresentation } from "../lib/bot-avatar";
+import { useResolvedAppearance } from "../lib/native";
+
+export type MochiBotAvatarProps = {
+  color: string;
+  size?: number;
+  status?: string;
+  identity?: string;
+  activity?: LogoAvatarActivity;
+  muted?: boolean;
+  motion?: AvatarMotionMode;
+  composing?: boolean;
+  pokeable?: boolean;
+};
+
+const SIT_Y = 106;
+const MORPH_MS = 560;
+const BLINK_MS = 140;
+
+function elasticOut(t: number): number {
+  if (t <= 0) return 0;
+  if (t >= 1) return 1;
+  return 1 - 2 ** (-10 * t) * Math.cos((t * 10 - 0.75) * (Math.PI / 3));
+}
+
+function rand(min: number, max: number): number {
+  return min + Math.random() * (max - min);
+}
+
+/**
+ * The squishy vector dumpling: one body, any colour, a brown face, and cheap Reanimated motion.
+ * Photos still render as images; badges stay on the wrapper so the home hero can keep its star.
+ */
+export const MochiBotAvatar = memo(function MochiBotAvatar({
+  color,
+  size = 54,
+  status,
+  identity,
+  activity: activityProp,
+  motion = "live",
+  composing = false,
+  pokeable = false,
+}: MochiBotAvatarProps) {
+  const parsed = mobileBotAvatarPresentation(color, identity ?? "");
+  const dark = useResolvedAppearance() === "dark";
+  const onScreen = useAvatarOnScreen();
+  const reducedMotionPref = useReducedMotion();
+  // First paint of the home list was paying for every dumpling's gradients,
+  // clip, and Reanimated loops before the splash could hide. Keep a static
+  // silhouette until the first frames are on screen, then turn the rest on.
+  const afterFirstPaint = useAfterFirstPaint();
+  const lifeState = avatarLifeState(status, composing);
+  const settling = useSettling(lifeState);
+  const activity = mochiActivityFromSignals({
+    status,
+    activity: composing && activityProp !== "error" ? "writing" : activityProp,
+    settling,
+  });
+  const still =
+    !afterFirstPaint ||
+    Boolean(reducedMotionPref) ||
+    !onScreen ||
+    motion === "still" ||
+    (motion === "lazy" && activity === "idle") ||
+    size < 22;
+  const plan = mochiMotionPlan(activity, still);
+  const fill =
+    parsed.kind === "shape" || parsed.kind === "color"
+      ? mochiAvatarFill(parsed.color, dark)
+      : mochiAvatarFill(color, dark);
+  const shape = "bodyKey" in parsed && parsed.bodyKey ? parsed.bodyKey : "blob";
+  if (parsed.kind === "image" && parsed.imageUrl) {
+    return <Image source={{ uri: parsed.imageUrl }} style={{ width: size, height: size }} />;
+  }
+
+  return (
+    <MochiBody
+      shape={shape}
+      fill={fill}
+      size={size}
+      planActivity={activity}
+      expression={plan.expression}
+      still={still}
+      detailed={afterFirstPaint}
+      plan={plan}
+      pokeable={pokeable}
+    />
+  );
+});
+
+function MochiBody({
+  shape,
+  fill,
+  size,
+  planActivity,
+  expression,
+  still,
+  detailed,
+  plan,
+  pokeable,
+}: {
+  shape: string;
+  fill: string;
+  size: number;
+  planActivity: ReturnType<typeof mochiActivityFromSignals>;
+  expression: MochiExpression;
+  still: boolean;
+  detailed: boolean;
+  plan: ReturnType<typeof mochiMotionPlan>;
+  pokeable: boolean;
+}) {
+  const uid = useId().replace(/:/g, "");
+  const shades = mochiShades(fill);
+  const [path, setPath] = useState(() => mochiBodyPath(shape));
+  const [metrics, setMetrics] = useState(() => mochiBodyMetrics(shape));
+  const fromKey = useRef(shape);
+  const morphRaf = useRef<number | null>(null);
+
+  useEffect(() => {
+    // The initial path and metrics already come from useState. Setting them
+    // again here would redraw every dumpling once more during first paint.
+    if (fromKey.current === shape) {
+      return;
+    }
+    const from = fromKey.current;
+    fromKey.current = shape;
+    if (still) {
+      setPath(mochiBodyPath(shape));
+      setMetrics(mochiBodyMetrics(shape));
+      return;
+    }
+    const start = Date.now();
+    const tick = () => {
+      const t = Math.min(1, (Date.now() - start) / MORPH_MS);
+      const ring = mochiMorphRing(from, shape, elasticOut(t));
+      setPath(mochiRingPath(ring));
+      setMetrics({
+        ...mochiBodyMetrics(shape),
+        ...{
+          // Use the in-between ring's box so the highlight stays on the body as it morphs.
+          minX: Math.min(...ring.map((p) => p[0])),
+          maxX: Math.max(...ring.map((p) => p[0])),
+          minY: Math.min(...ring.map((p) => p[1])),
+          maxY: Math.max(...ring.map((p) => p[1])),
+        },
+      });
+      if (t < 1) morphRaf.current = requestAnimationFrame(tick);
+      else {
+        setPath(mochiBodyPath(shape));
+        setMetrics(mochiBodyMetrics(shape));
+      }
+    };
+    morphRaf.current = requestAnimationFrame(tick);
+    return () => {
+      if (morphRaf.current != null) cancelAnimationFrame(morphRaf.current);
+    };
+  }, [shape, still]);
+
+  const [blink, setBlink] = useState(0);
+  const [glance, setGlance] = useState(0);
+  useEffect(() => {
+    if (still || !plan.blink) {
+      setBlink(0);
+      return;
+    }
+    let timeout: ReturnType<typeof setTimeout>;
+    let frame: number | null = null;
+    const loop = () => {
+      timeout = setTimeout(() => {
+        const start = Date.now();
+        const step = () => {
+          const t = (Date.now() - start) / BLINK_MS;
+          if (t >= 1) {
+            setBlink(0);
+            loop();
+            return;
+          }
+          setBlink(t < 0.5 ? t * 2 : 2 - t * 2);
+          frame = requestAnimationFrame(step);
+        };
+        frame = requestAnimationFrame(step);
+      }, rand(3000, 6000));
+    };
+    loop();
+    return () => {
+      clearTimeout(timeout);
+      if (frame != null) cancelAnimationFrame(frame);
+    };
+  }, [still, plan.blink]);
+
+  useEffect(() => {
+    if (still || !plan.glance) {
+      setGlance(0);
+      return;
+    }
+    let timeout: ReturnType<typeof setTimeout>;
+    const loop = () => {
+      timeout = setTimeout(() => {
+        setGlance(1);
+        timeout = setTimeout(() => {
+          setGlance(0);
+          loop();
+        }, 700);
+      }, rand(8000, 14000));
+    };
+    loop();
+    return () => clearTimeout(timeout);
+  }, [still, plan.glance]);
+
+  const breath = useSharedValue(0);
+  const hop = useSharedValue(0);
+  const squash = useSharedValue(0);
+  const sway = useSharedValue(0);
+  const bob = useSharedValue(0);
+  const shiver = useSharedValue(0);
+  const shrink = useSharedValue(1);
+  const wobble = useSharedValue(0);
+
+  useEffect(() => {
+    cancelAnimation(breath);
+    if (still || plan.breathe <= 0) {
+      breath.value = withTiming(0, { duration: 200 });
+      return;
+    }
+    breath.value = withRepeat(
+      withSequence(
+        withTiming(1, { duration: (plan.breathePeriod * 1000) / 2, easing: Easing.inOut(Easing.sin) }),
+        withTiming(0, { duration: (plan.breathePeriod * 1000) / 2, easing: Easing.inOut(Easing.sin) }),
+      ),
+      -1,
+      false,
+    );
+  }, [still, plan.breathe, plan.breathePeriod, breath]);
+
+  useEffect(() => {
+    cancelAnimation(sway);
+    if (still || plan.sway <= 0) {
+      sway.value = withTiming(0, { duration: 200 });
+      return;
+    }
+    sway.value = withRepeat(
+      withSequence(
+        withTiming(plan.sway, { duration: 900, easing: Easing.inOut(Easing.sin) }),
+        withTiming(-plan.sway, { duration: 1800, easing: Easing.inOut(Easing.sin) }),
+        withTiming(0, { duration: 900, easing: Easing.inOut(Easing.sin) }),
+      ),
+      -1,
+      false,
+    );
+  }, [still, plan.sway, sway]);
+
+  useEffect(() => {
+    cancelAnimation(bob);
+    if (still || plan.bob <= 0) {
+      bob.value = withTiming(0, { duration: 200 });
+      return;
+    }
+    bob.value = withRepeat(
+      withSequence(
+        withTiming(-plan.bob, { duration: 280, easing: Easing.inOut(Easing.sin) }),
+        withTiming(plan.bob, { duration: 280, easing: Easing.inOut(Easing.sin) }),
+      ),
+      -1,
+      false,
+    );
+  }, [still, plan.bob, bob]);
+
+  const prevActivity = useRef(planActivity);
+  useEffect(() => {
+    const prev = prevActivity.current;
+    prevActivity.current = planActivity;
+    if (still) {
+      hop.value = 0;
+      squash.value = 0;
+      shiver.value = 0;
+      shrink.value = withTiming(1, { duration: 160 });
+      return;
+    }
+    if (plan.hop && prev !== "done") {
+      hop.value = 0;
+      squash.value = 0;
+      hop.value = withSequence(
+        withTiming(0.2, { duration: 180, easing: Easing.out(Easing.quad) }),
+        withTiming(0, { duration: 220, easing: Easing.in(Easing.quad) }),
+      );
+      squash.value = withSequence(
+        withTiming(-0.35, { duration: 180 }),
+        withTiming(1, { duration: 120 }),
+        withSpring(0, { damping: 8, stiffness: 180 }),
+      );
+    }
+    if (plan.shiver && prev !== "error") {
+      shrink.value = withTiming(0.94, { duration: 120 });
+      shiver.value = withSequence(
+        withRepeat(
+          withSequence(
+            withTiming(1, { duration: 40 }),
+            withTiming(-1, { duration: 40 }),
+          ),
+          7,
+          true,
+        ),
+        withTiming(0, { duration: 80 }),
+      );
+    } else if (!plan.shiver) {
+      shrink.value = withTiming(1, { duration: 180 });
+      shiver.value = withTiming(0, { duration: 80 });
+    }
+  }, [planActivity, plan.hop, plan.shiver, still, hop, squash, shiver, shrink]);
+
+  const poke = () => {
+    if (!pokeable || still || !plan.wobble) return;
+    wobble.value = 0;
+    wobble.value = withSequence(
+      withTiming(1, { duration: 70 }),
+      withTiming(-0.75, { duration: 90 }),
+      withTiming(0.45, { duration: 110 }),
+      withSpring(0, { damping: 8, stiffness: 200 }),
+    );
+  };
+
+  const motionStyle = useAnimatedStyle(() => {
+    const b = breath.value * plan.breathe + squash.value * 0.08;
+    const sx = shrink.value * (1 + b * 0.55 + wobble.value * 0.12);
+    const sy = shrink.value * (1 - b * 0.7 - wobble.value * 0.1);
+    return {
+      transform: [
+        { translateY: -hop.value * size * 0.22 + bob.value * size },
+        { translateX: shiver.value * size * 0.035 },
+        { rotate: `${sway.value}deg` },
+        { scaleX: sx },
+        { scaleY: sy },
+      ],
+    };
+  });
+
+  const face = mochiFace(expression, {
+    blink,
+    glance,
+    gazeY: expression === "thinking" ? -2.2 : 0,
+    origin: mochiFaceOrigin(shape),
+  });
+  const hx = metrics.minX + (metrics.maxX - metrics.minX) * 0.32;
+  const hy = metrics.minY + (metrics.maxY - metrics.minY) * 0.3;
+  const hrx = (metrics.maxX - metrics.minX) * 0.24;
+  const hry = (metrics.maxY - metrics.minY) * 0.17;
+  const shadowCx = (metrics.minX + metrics.maxX) / 2;
+  const shadowCy = Math.min(118, metrics.maxY + 8);
+  const shadowRx = Math.max(16, (metrics.maxX - metrics.minX) * 0.42);
+
+  const body = (
+    <Animated.View
+      style={[
+        { width: size, height: size, transformOrigin: "50% 84%" as const },
+        motionStyle,
+      ]}
+      testID={detailed ? "mochi-avatar-glossy" : "mochi-avatar-static"}
+    >
+      <Svg width={size} height={size} viewBox="0 0 128 128">
+        {detailed ? (
+          <Defs>
+            <RadialGradient id={`${uid}-body`} cx="32%" cy="28%" r="78%">
+              <Stop offset="0%" stopColor={shades.shine} />
+              <Stop offset="28%" stopColor={shades.shine} stopOpacity="0.55" />
+              <Stop offset="62%" stopColor={fill} />
+              <Stop offset="100%" stopColor={shades.shade} />
+            </RadialGradient>
+            <RadialGradient id={`${uid}-spec`} cx="50%" cy="50%" r="50%">
+              <Stop offset="0%" stopColor="#FFFFFF" stopOpacity="0.92" />
+              <Stop offset="45%" stopColor="#FFFFFF" stopOpacity="0.35" />
+              <Stop offset="100%" stopColor="#FFFFFF" stopOpacity="0" />
+            </RadialGradient>
+            <LinearGradient id={`${uid}-bot`} x1="0" y1="0" x2="0" y2="1">
+              <Stop offset="40%" stopColor={shades.deep} stopOpacity="0" />
+              <Stop offset="100%" stopColor={shades.deep} stopOpacity="0.38" />
+            </LinearGradient>
+            <ClipPath id={`${uid}-clip`}>
+              <Path d={path} />
+            </ClipPath>
+          </Defs>
+        ) : null}
+        {detailed ? (
+          <>
+            <Ellipse cx={shadowCx} cy={shadowCy} rx={shadowRx} ry="5.5" fill={shades.shadow} opacity="0.22" />
+            <Ellipse cx={shadowCx} cy={shadowCy} rx={shadowRx * 1.25} ry="7.5" fill={shades.shadow} opacity="0.14" />
+            <Ellipse cx={shadowCx} cy={shadowCy} rx={shadowRx * 1.55} ry="10" fill={shades.shadow} opacity="0.08" />
+          </>
+        ) : (
+          <Ellipse cx={shadowCx} cy={shadowCy} rx={shadowRx} ry="5.5" fill={shades.shadow} opacity="0.18" />
+        )}
+        <Path d={path} fill={detailed ? `url(#${uid}-body)` : fill} />
+        {detailed ? (
+          <G clipPath={`url(#${uid}-clip)`}>
+            <Rect x="0" y="0" width="128" height="128" fill={`url(#${uid}-bot)`} />
+            <Ellipse cx={hx} cy={hy} rx={hrx} ry={hry} fill={`url(#${uid}-spec)`} />
+            <Ellipse
+              cx={hx - hrx * 0.28}
+              cy={hy - hry * 0.28}
+              rx={hrx * 0.42}
+              ry={hry * 0.36}
+              fill="#FFFFFF"
+              opacity="0.32"
+            />
+          </G>
+        ) : null}
+        {face.fills.map((f, i) => (
+          <Path key={`f${i}`} d={f.d} fill={f.fill} />
+        ))}
+        {face.strokes.map((s, i) => (
+          <Path
+            key={`s${i}`}
+            d={s.d}
+            fill="none"
+            stroke={face.ink}
+            strokeWidth={s.width}
+            strokeLinecap="round"
+            strokeLinejoin="round"
+          />
+        ))}
+      </Svg>
+    </Animated.View>
+  );
+
+  if (!pokeable) return body;
+  return (
+    <Pressable onPress={poke} accessibilityRole="button">
+      {body}
+    </Pressable>
+  );
+}
+
+void SIT_Y;
