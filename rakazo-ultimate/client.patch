diff --git a/apps/mobile/components/thread/memory-run-sheet.tsx b/apps/mobile/components/thread/memory-run-sheet.tsx
new file mode 100644
index 0000000..4762d37
--- /dev/null
+++ b/apps/mobile/components/thread/memory-run-sheet.tsx
@@ -0,0 +1,167 @@
+import { useLingui } from "@lingui/react/macro";
+import { useQuery } from "@tanstack/react-query";
+import { ActivityIndicator, Modal, Platform, ScrollView, Text, View } from "react-native";
+import { useSafeAreaInsets } from "react-native-safe-area-context";
+import { useMobileTokens } from "../../lib/native";
+import { queryClient, rpcQuery } from "../../lib/query";
+import { errorText } from "../../lib/user-error";
+import { NativeActionButton } from "../native-action-button";
+
+const SCOPE_LABELS: Record<string, string> = {
+  bot: "这个 Bot 自己的记忆",
+  user: "整个 Space 共用的记忆",
+  daily: "当天的复盘",
+};
+
+/**
+ * What one reply was written with: the memory documents its prompt carried, the ones that did not
+ * fit, and the learnings it hit. Read-only — it explains a reply rather than changing anything.
+ */
+export function MemoryRunSheet({
+  runId,
+  onClose,
+}: {
+  runId: string;
+  onClose: () => void;
+}) {
+  const { t } = useLingui();
+  const tokens = useMobileTokens();
+  const insets = useSafeAreaInsets();
+  const read = rpcQuery("memory/usedByRun", { runId });
+  const { data, error, isPending } = useQuery(read, queryClient);
+
+  return (
+    <Modal visible animationType="slide" presentationStyle="pageSheet" onRequestClose={onClose}>
+      <View
+        accessibilityViewIsModal
+        style={{
+          flex: 1,
+          backgroundColor: tokens.background,
+          paddingTop: Platform.OS === "ios" ? 12 : insets.top + 12,
+          paddingBottom: insets.bottom,
+        }}
+      >
+        <View
+          style={{
+            flexDirection: "row",
+            alignItems: "center",
+            justifyContent: "space-between",
+            paddingHorizontal: 20,
+            paddingBottom: 10,
+          }}
+        >
+          <Text accessibilityRole="header" style={{ color: tokens.foreground, fontSize: 17, fontWeight: "600" }}>
+            这轮回复用到的记忆
+          </Text>
+          <NativeActionButton label={t`Close`} onPress={onClose} prominence="plain" />
+        </View>
+        <ScrollView style={{ flex: 1, paddingHorizontal: 20 }} contentContainerStyle={{ gap: 18, paddingBottom: 24 }}>
+          {isPending ? (
+            <ActivityIndicator color={tokens.mutedForeground} accessibilityLabel={t`Loading…`} />
+          ) : null}
+          {error ? (
+            <Text accessibilityRole="alert" style={{ color: tokens.destructive, fontSize: 13 }}>
+              {errorText(error, t`Could not load memory`)}
+            </Text>
+          ) : null}
+          {data === null ? (
+            <Text style={{ color: tokens.mutedForeground, fontSize: 15 }}>
+              这一轮没有记下任何记忆。
+            </Text>
+          ) : null}
+          {data ? (
+            <>
+              <Section title="带入提示词的记忆" empty="这一轮没有带入记忆文档。" tokens={tokens}>
+                {data.documents.map((document) => (
+                  <Row
+                    key={`${document.scope}:${document.path}`}
+                    detail={`${SCOPE_LABELS[document.scope] ?? document.scope} · ${formatBytes(document.includedBytes)}${
+                      document.truncated ? ` · 只带了前 ${Math.round((document.includedBytes / Math.max(1, document.totalBytes)) * 100)}%` : ""
+                    }`}
+                    label={document.path}
+                    tokens={tokens}
+                  />
+                ))}
+              </Section>
+              {data.omitted.length ? (
+                <Section title="放不下的记忆" empty="" tokens={tokens}>
+                  {data.omitted.map((document) => (
+                    <Row
+                      key={`omitted:${document.scope}:${document.path}`}
+                      detail={`${SCOPE_LABELS[document.scope] ?? document.scope} · 共 ${formatBytes(document.totalBytes)}`}
+                      label={document.path}
+                      tokens={tokens}
+                    />
+                  ))}
+                </Section>
+              ) : null}
+              <Section title="命中的记忆条目" empty="这一轮没有命中已通过的记忆条目。" tokens={tokens}>
+                {data.learnings.map((learning) => (
+                  <Row
+                    key={learning.id}
+                    detail={SCOPE_LABELS[learning.scope] ?? learning.scope}
+                    label={learning.text}
+                    tokens={tokens}
+                  />
+                ))}
+              </Section>
+            </>
+          ) : null}
+        </ScrollView>
+      </View>
+    </Modal>
+  );
+}
+
+function Section({
+  title,
+  empty,
+  tokens,
+  children,
+}: {
+  title: string;
+  empty: string;
+  tokens: ReturnType<typeof useMobileTokens>;
+  children: React.ReactNode;
+}) {
+  const count = Array.isArray(children) ? children.length : children ? 1 : 0;
+  return (
+    <View style={{ gap: 8 }}>
+      <Text style={{ color: tokens.mutedForeground, fontSize: 13, fontWeight: "600" }}>{title}</Text>
+      {count ? children : empty ? (
+        <Text style={{ color: tokens.mutedForeground, fontSize: 14 }}>{empty}</Text>
+      ) : null}
+    </View>
+  );
+}
+
+function Row({
+  label,
+  detail,
+  tokens,
+}: {
+  label: string;
+  detail: string;
+  tokens: ReturnType<typeof useMobileTokens>;
+}) {
+  return (
+    <View
+      style={{
+        borderRadius: 14,
+        borderCurve: "continuous",
+        backgroundColor: tokens.card,
+        paddingHorizontal: 14,
+        paddingVertical: 12,
+        gap: 4,
+      }}
+    >
+      <Text style={{ color: tokens.foreground, fontSize: 15, lineHeight: 20 }}>{label}</Text>
+      <Text style={{ color: tokens.mutedForeground, fontSize: 12 }}>{detail}</Text>
+    </View>
+  );
+}
+
+function formatBytes(bytes: number): string {
+  if (bytes < 1024) return `${bytes} 字`;
+  return `${(bytes / 1024).toFixed(1)} KB`;
+}
