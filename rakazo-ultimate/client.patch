+      release.resolve();
+      await changing;
+      expect(await read).toBe("");
+      expect(finishedBeforeDelete).toBe(false);
+    } finally {
+      release.resolve();
+      vi.mocked(SecureStore.deleteItemAsync).mockImplementation(remove);
+    }
+  });
+});
