+import { beforeEach, expect, it, vi } from "vitest";
+
+const state = vi.hoisted(() => ({
+  generation: 1,
+  token: "fake-token",
+  returningUser: true,
+  activityMode: false,
+  collapsed: null as { userId?: string; keys: ReadonlySet<string> } | null,
+  inbox: null as { bots: Array<{ id: string }> } | null,
+  reads: [] as string[],
+  serverSettled: false,
+}));
+
+vi.mock("./session", () => ({
+  currentSessionGeneration: () => state.generation,
+  loadSessionToken: async () => {
+    state.reads.push("token");
+    return state.token;
+  },
+}));
+vi.mock("./returning-user", () => ({
+  hasSignedInBefore: async () => {
+    state.reads.push("returning");
+    return state.returningUser;
+  },
+}));
+vi.mock("./activity-mode", () => ({
+  loadActivityMode: async () => {
+    state.reads.push("activity");
+    return state.activityMode;
+  },
+}));
+vi.mock("./collapsed-sections", () => ({
+  loadCollapsedSections: async () => {
+    state.reads.push("collapsed");
+    return state.collapsed;
+  },
+}));
+vi.mock("./saved-chats", () => ({
+  loadSavedInbox: async () => {
+    state.reads.push(`inbox:${state.serverSettled ? "after-server" : "before-server"}`);
+    return state.inbox;
+  },
+}));
+
+/** A fresh launch: the module keeps its seed per process, as the app does. */
+async function launch() {
+  vi.resetModules();
+  return import("./launch-warmup.js");
+}
+
+function tick() {
+  return new Promise((resolve) => setTimeout(resolve, 0));
+}
+
+beforeEach(() => {
+  state.generation = 1;
+  state.token = "fake-token";
+  state.returningUser = true;
+  state.activityMode = false;
+  state.collapsed = null;
+  state.inbox = { bots: [{ id: "bot-a" }] };
+  state.reads = [];
+  state.serverSettled = false;
+});
+
+it("reads the home screen's own state in one wave, before the splash is gone", async () => {
+  const { launchState, startLaunchWarmup } = await launch();
+  let releaseServer!: () => void;
+  const server = new Promise<void>((resolve) => {
+    releaseServer = () => {
+      state.serverSettled = true;
+      resolve();
+    };
+  });
+  const warm = startLaunchWarmup(server);
+
+  // Nothing is drawn from a seed before the reads land.
+  expect(launchState()).toBeNull();
+
+  await tick();
+  // The saved inbox is filed under the Space the launch restores, so it waits for the server read
+  // instead of reading another Space's copy or none.
+  expect(state.reads).toEqual(
+    expect.arrayContaining(["token", "returning", "activity", "collapsed"]),
+  );
+  expect(state.reads.some((read) => read.startsWith("inbox"))).toBe(false);
+
+  releaseServer();
+  await expect(warm).resolves.toEqual({
+    generation: 1,
+    token: "fake-token",
+    returningUser: true,
+    activityMode: false,
+    collapsed: null,
+    inbox: { bots: [{ id: "bot-a" }] },
+  });
+  expect(state.reads).toContain("inbox:after-server");
+  // The home screen's first frame draws this, with no second wait.
+  expect(launchState()).toMatchObject({ token: "fake-token", inbox: { bots: [{ id: "bot-a" }] } });
+});
+
+it("starts each read once and joins the read already running", async () => {
+  const { startLaunchWarmup } = await launch();
+  const first = startLaunchWarmup(Promise.resolve());
+  const second = startLaunchWarmup();
+  expect(second).toBe(first);
+
+  await first;
+  expect(state.reads.filter((read) => read === "token")).toHaveLength(1);
+  expect(state.reads.filter((read) => read.startsWith("inbox"))).toHaveLength(1);
+});
+
+it("reads no saved inbox for a signed-out launch", async () => {
+  state.token = "";
+  state.inbox = null;
+  const { startLaunchWarmup } = await launch();
+
+  await expect(startLaunchWarmup(Promise.resolve())).resolves.toMatchObject({
+    token: "",
+    inbox: null,
+  });
+  expect(state.reads.some((read) => read.startsWith("inbox"))).toBe(false);
+});
+
+it("does not hand one session's seed to the next", async () => {
+  const warmup = await launch();
+  await warmup.startLaunchWarmup(Promise.resolve());
+  expect(warmup.launchState()).not.toBeNull();
+
+  // Signing in, signing out or switching servers is a new session generation.
+  state.generation = 2;
+  state.token = "other-token";
+  state.inbox = null;
+  expect(warmup.launchState()).toBeNull();
+
+  const next = warmup.startLaunchWarmup();
+  await expect(next).resolves.toMatchObject({ generation: 2, token: "other-token" });
+  expect(warmup.launchState()).toMatchObject({ generation: 2, token: "other-token" });
+});
+
+it("keeps a failing read from holding the first frame", async () => {
+  const { launchState, startLaunchWarmup } = await launch();
+  const failing = Promise.reject(new Error("server read failed"));
+
+  await expect(startLaunchWarmup(failing)).resolves.toMatchObject({ token: "fake-token" });
+  expect(launchState()).not.toBeNull();
+});
