+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+// The preview module reaches the server through `rpc`; these tests only read its own rules.
+vi.mock("./api", () => ({ rpc: vi.fn(async () => null) }));
+
+import {
+  firstMessageLink,
+  forgetLinkPreviews,
+  isFormLink,
+  isGrokBotLink,
+  linkPreviewCover,
+  linkSiteLabel,
+} from "./link-preview";
+
+beforeEach(() => {
+  forgetLinkPreviews();
+});
+
+describe("firstMessageLink", () => {
+  it("takes the first address in what someone wrote", () => {
+    expect(
+      firstMessageLink(
+        "编译链接在这： https://github.com/ingnez/rakazo-ipa-build （大约 19 分钟）",
+      ),
+    ).toBe("https://github.com/ingnez/rakazo-ipa-build");
+    expect(firstMessageLink("https://a.example.com/x https://b.example.com/y")).toBe(
+      "https://a.example.com/x",
+    );
+  });
+
+  it("leaves the prose's own punctuation out of the address", () => {
+    expect(firstMessageLink("看这个 https://example.com/a。")).toBe("https://example.com/a");
+    expect(firstMessageLink("(see https://example.com/b)")).toBe("https://example.com/b");
+    expect(firstMessageLink("https://en.wikipedia.org/wiki/Foo_(bar)")).toBe(
+      "https://en.wikipedia.org/wiki/Foo_(bar)",
+    );
+  });
+
+  it("ignores a command in code and a bare word that is not an address", () => {
+    expect(firstMessageLink("```\ncurl https://example.com\n```\nnothing here")).toBeUndefined();
+    expect(firstMessageLink("run `https://example.com` later")).toBeUndefined();
+    expect(firstMessageLink("https://localhost:3000")).toBeUndefined();
+    expect(firstMessageLink(undefined)).toBeUndefined();
+  });
+});
+
+describe("linkSiteLabel", () => {
+  it("names the site without www", () => {
+    expect(linkSiteLabel("https://www.github.com/ingnez")).toBe("github.com");
+    expect(linkSiteLabel("https://x.ai/bot/abc")).toBe("x.ai");
+    expect(linkSiteLabel("not a url")).toBe("not a url");
+  });
+});
+
+describe("isFormLink", () => {
+  it("recognizes a page that waits on the person", () => {
+    expect(isFormLink("https://accounts.google.com/o/oauth2/v2/auth?client_id=x")).toBe(true);
+    expect(isFormLink("https://example.com/oauth/authorize")).toBe(true);
+    expect(isFormLink("https://example.com/device")).toBe(true);
+    expect(isFormLink("https://example.com/start?code=ABC123")).toBe(true);
+  });
+
+  it("leaves an ordinary page a page", () => {
+    expect(isFormLink("https://github.com/ingnez/rakazo-ipa-build")).toBe(false);
+    expect(isFormLink("https://news.example.com/2026/11/20/story")).toBe(false);
+    expect(isFormLink("garbage")).toBe(false);
+  });
+});
+
+describe("isGrokBotLink", () => {
+  it("only treats a public bot share as importable", () => {
+    expect(isGrokBotLink("https://x.ai/bot/abc123")).toBe(true);
+    expect(isGrokBotLink("https://www.x.ai/bot/abc123")).toBe(true);
+    expect(isGrokBotLink("https://x.ai/pricing")).toBe(false);
+    expect(isGrokBotLink("https://github.com/x.ai/bot/1")).toBe(false);
+  });
+});
+
+describe("linkPreviewCover", () => {
+  it("prefers the server's inlined copy, then the page's own address", () => {
+    expect(
+      linkPreviewCover({
+        url: "https://example.com",
+        imageDataUrl: "data:image/jpeg;base64,AAAA",
+        imageUrl: "https://example.com/cover.png",
+      }),
+    ).toBe("data:image/jpeg;base64,AAAA");
+    expect(
+      linkPreviewCover({
+        url: "https://example.com",
+        imageUrl: "https://example.com/cover.png",
+      }),
+    ).toBe("https://example.com/cover.png");
+  });
+
+  it("draws no cover when there is nothing a card could show", () => {
+    expect(linkPreviewCover(null)).toBeUndefined();
+    expect(linkPreviewCover({ url: "https://example.com" })).toBeUndefined();
+    expect(linkPreviewCover({ url: "https://example.com", imageUrl: "   " })).toBeUndefined();
+    expect(
+      linkPreviewCover({ url: "https://example.com", imageUrl: "javascript:alert(1)" }),
+    ).toBeUndefined();
+    expect(
+      linkPreviewCover({ url: "https://example.com", imageDataUrl: "data:text/html,x" }),
+    ).toBeUndefined();
+  });
+});
