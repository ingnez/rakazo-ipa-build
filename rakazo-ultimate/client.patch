diff --git a/apps/web/e2e/chat/artifact-preview.spec.ts b/apps/web/e2e/chat/artifact-preview.spec.ts
new file mode 100644
index 000000000..b774482c5
--- /dev/null
+++ b/apps/web/e2e/chat/artifact-preview.spec.ts
@@ -0,0 +1,143 @@
+import { expect, test } from "@playwright/test";
+import { captureScreenshot, completeOnboarding, signup } from "../helpers/helpers";
+
+test("agent-attached files appear as cards with previews and downloads", async ({
+  page,
+}, testInfo) => {
+  const stamp = Date.now();
+  await signup(page, `artifact-card-${stamp}@rakazo.test`, "password12", "Artifact Card");
+  await completeOnboarding(page);
+
+  const composer = page.getByPlaceholder(/Message/);
+  await composer.fill("write path notes/result.txt and attach it to the thread says Result notes");
+  await page.keyboard.press("Enter");
+
+  // Text files open in the viewer instead of downloading.
+  const fileCard = page.getByRole("button", { name: "Preview result.txt" });
+  await expect(fileCard).toBeVisible({ timeout: 30_000 });
+  await captureScreenshot(page, testInfo, "current-file-card");
+  await fileCard.click();
+
+  const textDialog = page.getByRole("dialog", { name: "result.txt" });
+  await expect(textDialog.getByText("Result notes")).toBeVisible();
+  await captureScreenshot(page, testInfo, "text-preview-open");
+  const downloadPromise = page.waitForEvent("download");
+  await textDialog.getByRole("button", { name: "Download result.txt" }).click();
+  const download = await downloadPromise;
+  expect(download.suggestedFilename()).toBe("result.txt");
+  await page.keyboard.press("Escape");
+  await expect(textDialog).toHaveCount(0);
+
+  await expect(page.getByRole("button", { name: "Send" })).toBeVisible({ timeout: 30_000 });
+  await composer.fill(
+    "write path notes/preview.md and attach it to the thread says # Project preview",
+  );
+  await page.keyboard.press("Enter");
+
+  const previewButton = page.getByRole("button", { name: "Preview preview.md" });
+  await expect(previewButton).toBeVisible({ timeout: 30_000 });
+  await captureScreenshot(page, testInfo, "markdown-file-card");
+  let releasePreview = () => {};
+  const previewReady = new Promise<void>((resolve) => {
+    releasePreview = resolve;
+  });
+  await page.route("**/rpc/artifacts/get", async (route) => {
+    await previewReady;
+    await route.continue();
+  });
+  await previewButton.click();
+
+  const dialog = page.getByRole("dialog", { name: "preview.md" });
+  await expect(dialog).toBeVisible();
+  await expect(dialog.getByRole("status", { name: "Loading preview…" })).toBeVisible();
+  await expect(dialog).not.toContainText("Loading preview…");
+  await captureScreenshot(page, testInfo, "markdown-preview-loading-spinner");
+  releasePreview();
+  await expect(dialog.getByRole("heading", { name: "Project preview" })).toBeVisible();
+  const closeButton = dialog.getByRole("button", { name: "Close preview" });
+  const downloadButton = dialog.getByRole("button", { name: "Download preview.md" });
+  const copyButton = dialog.getByRole("button", { name: "Copy preview.md" });
+  await expect(closeButton).toBeFocused();
+  await page.keyboard.press("Tab");
+  await expect(copyButton).toBeFocused();
+  await page.keyboard.press("Shift+Tab");
+  await expect(closeButton).toBeFocused();
+  await captureScreenshot(page, testInfo, "markdown-preview-open");
+
+  const markdownDownloadPromise = page.waitForEvent("download");
+  await downloadButton.click();
+  const markdownDownload = await markdownDownloadPromise;
+  expect(markdownDownload.suggestedFilename()).toBe("preview.md");
+
+  await page.keyboard.press("Escape");
+  await expect(dialog).toHaveCount(0);
+  await expect(previewButton).toBeFocused();
+
+  await expect(page.getByRole("button", { name: "Send" })).toBeVisible({ timeout: 30_000 });
+  await composer.fill(
+    "write path notes/page.html and attach it to the thread says <h1>Rendered page</h1><p id=ran></p><script>document.getElementById('ran').textContent = 'script ran'</script>",
+  );
+  await page.keyboard.press("Enter");
+
+  const htmlPreviewButton = page.getByRole("button", { name: "Preview page.html" });
+  await expect(htmlPreviewButton).toBeVisible({ timeout: 30_000 });
+  await htmlPreviewButton.click();
+
+  const htmlDialog = page.getByRole("dialog", { name: "page.html" });
+  await expect(htmlDialog).toBeVisible();
+  // The viewer loads the network shell, which renders the document in a nested sandboxed frame.
+  const shell = htmlDialog.locator('iframe[title="page.html"]');
+  await expect(shell).toHaveAttribute("src", "/html-viewer.html");
+  const preview = shell.contentFrame().locator("iframe#preview").contentFrame();
+  await expect(preview.getByRole("heading", { name: "Rendered page" })).toBeVisible();
+  await expect(preview.getByText("script ran")).toBeVisible();
+  // The preview's opaque origin keeps it away from the app's storage and DOM.
+  expect(await preview.locator("body").evaluate(() => window.origin)).toBe("null");
+  await captureScreenshot(page, testInfo, "html-preview-open");
+});
+
+test("audio attachments can retry a failed preview without leaving the card", async ({
+  page,
+}, testInfo) => {
+  await signup(page, `audio-retry-${Date.now()}@rakazo.test`, "password12", "Audio Retry");
+  await completeOnboarding(page);
+
+  // A short silent PCM WAV exercises native controls without an external audio service.
+  const wav = Buffer.alloc(44 + 1600);
+  wav.write("RIFF", 0);
+  wav.writeUInt32LE(wav.length - 8, 4);
+  wav.write("WAVEfmt ", 8);
+  wav.writeUInt32LE(16, 16);
+  wav.writeUInt16LE(1, 20);
+  wav.writeUInt16LE(1, 22);
+  wav.writeUInt32LE(8000, 24);
+  wav.writeUInt32LE(16000, 28);
+  wav.writeUInt16LE(2, 32);
+  wav.writeUInt16LE(16, 34);
+  wav.write("data", 36);
+  wav.writeUInt32LE(1600, 40);
+  await page.locator('input[type="file"]').setInputFiles({
+    name: "clip.wav",
+    mimeType: "audio/wav",
+    buffer: wav,
+  });
+  const composer = page.getByRole("combobox", { name: /Message/ });
+  await composer.fill("Here is the audio clip");
+  await composer.press("Enter");
+  const play = page.getByRole("button", { name: "Play clip.wav", exact: true });
+  await expect(play).toBeVisible({ timeout: 30_000 });
+  await page.route("**/rpc/artifacts/get", (route) => route.abort("failed"));
+  await play.click();
+  await expect(page.getByRole("alert")).toContainText("Could not load this file.");
+  await expect(play).toBeEnabled();
+  await expect(page.getByRole("button", { name: "Download clip.wav", exact: true })).toBeVisible();
+  await captureScreenshot(page, testInfo, "audio-preview-failure-retry");
+  await page.unroute("**/rpc/artifacts/get");
+  await play.click();
+  const audio = page.locator('audio[aria-label="clip.wav"]');
+  await expect(audio).toBeVisible();
+  await expect(audio).toHaveAttribute("controls", "");
+  await expect(play).toHaveCount(0);
+  await expect(page.getByText("Could not load this file.", { exact: true })).toHaveCount(0);
+  await captureScreenshot(page, testInfo, "audio-preview-recovered");
+});
diff --git a/apps/web/e2e/chat/chart-export.spec.ts b/apps/web/e2e/chat/chart-export.spec.ts
new file mode 100644
index 000000000..9e811a6cf
--- /dev/null
+++ b/apps/web/e2e/chat/chart-export.spec.ts
@@ -0,0 +1,97 @@
+import { expect, test } from "@playwright/test";
+import { captureScreenshot } from "../helpers/helpers";
+
+const fixture = "/e2e/fixtures/chart-export.html";
+
+for (const width of [640, 320, 160, 64]) {
+  test(`exported legend fits a ${width}px canvas`, async ({ page }, testInfo) => {
+    const long = width !== 640;
+    await page.goto(`${fixture}?width=${width}${long ? "&long" : ""}`);
+    const svg = page.locator("body > svg");
+    await expect(svg).toBeVisible();
+    const layout = await svg.evaluate((element) => {
+      const plot = element.querySelector("svg")!;
+      const labels = Array.from(element.children).filter((child) => child.tagName === "text");
+      const swatches = Array.from(element.children).filter((child) => child.tagName === "rect");
+      return {
+        width: Number(element.getAttribute("width")),
+        height: Number(element.getAttribute("height")),
+        plotY: Number(plot.getAttribute("y")),
+        plotHeight: Number(plot.getAttribute("height")),
+        labels: labels.map((label) => {
+          const box = (label as SVGGraphicsElement).getBBox();
+          return {
+            text: label.textContent,
+            x: box.x,
+            right: box.x + box.width,
+            bottom: box.y + box.height,
+          };
+        }),
+        rows: new Set(swatches.map((swatch) => swatch.getAttribute("y"))).size,
+      };
+    });
+    expect(layout.width).toBe(width);
+    expect(layout.rows).toBeGreaterThan(1);
+    expect(layout.height).toBe(layout.plotY + layout.plotHeight);
+    expect(layout.labels).toHaveLength(long ? 5 : 11);
+    for (const label of layout.labels) {
+      expect(label.x).toBeGreaterThanOrEqual(8);
+      expect(label.right, label.text ?? "legend label").toBeLessThanOrEqual(width - 8);
+      expect(label.bottom).toBeLessThan(layout.plotY);
+    }
+    const text = layout.labels.map((label) => label.text);
+    if (long) {
+      expect(text).toContain("W".repeat(80));
+      expect(text).toContain("类别😀".repeat(16));
+      expect(text).toContain('<&" export');
+    } else {
+      for (let i = 1; i <= 10; i++) expect(text).toContain(`Category ${i}`);
+    }
+    await captureScreenshot(page, testInfo, `exported-legend-${width}px`);
+  });
+}
+
+for (const width of [160, 40]) {
+  test(`exported graphemes keep natural proportions at ${width}px`, async ({ page }, testInfo) => {
+    await page.goto(`${fixture}?width=${width}&long&graphemes`);
+    const svg = page.locator("body > svg");
+    await expect(svg).toBeVisible();
+    const labels = await svg.evaluate((element) =>
+      Array.from(element.children)
+        .filter((child) => child.tagName === "text")
+        .map((label) => ({
+          text: label.textContent,
+          lines: Array.from(label.children).map((child) => {
+            const line = child as SVGTSpanElement;
+            const reference = document.createElementNS("http://www.w3.org/2000/svg", "text");
+            reference.setAttribute("font-family", label.getAttribute("font-family")!);
+            reference.setAttribute("font-size", "12");
+            reference.textContent = line.textContent;
+            element.append(reference);
+            const naturalWidth = reference.getBBox().width;
+            reference.remove();
+            const box = line.getBBox();
+            return {
+              text: line.textContent,
+              width: box.width,
+              right: box.x + box.width,
+              naturalWidth,
+              fontSize: Number.parseFloat(getComputedStyle(line).fontSize),
+            };
+          }),
+        })),
+    );
+    await captureScreenshot(page, testInfo, `exported-graphemes-${width}px`);
+    expect(labels.map((label) => label.text)).toEqual(
+      expect.arrayContaining(["👨‍👩‍👧‍👦", "🇨🇦", "👍🏽", "1️⃣", "é", "👨‍👩‍👧‍👦".repeat(20)]),
+    );
+    for (const label of labels) {
+      for (const line of label.lines) {
+        expect(line.width, line.text ?? "grapheme").toBeLessThanOrEqual(line.naturalWidth + 0.1);
+        expect(line.right).toBeLessThanOrEqual(width - 8);
+        expect(line.fontSize).toBeLessThanOrEqual(12);
+        if (width === 160) expect(line.fontSize).toBe(12);
+      }
+    }
+  });
+}
