+import { BOT_COLOR_LIST } from "@rakazo/contracts";
+import { describe, expect, it } from "vitest";
+import { BOT_EYE_INK, botEyeInk } from "./bot-avatar-colors.js";
+import {
+  BOT_AVATAR_DARK_FILLS,
+  botAvatarFill,
+  FLIPPED_BODY_DARK_FILL,
+  PALE_BODY_LIGHT_FILL,
+} from "./bot-avatar-palette.js";
+
+describe("the body a bot is drawn with", () => {
+  it("keeps a black body black on a light page, and its eyes white", () => {
+    expect(botAvatarFill("#000000", false)).toBe("#000000");
+    // A body too dark for the near-black ink keeps white eyes, by contrast.
+    expect(botEyeInk(botAvatarFill("#000000", false))).toBe("#FFFFFF");
+  });
+
+  it("turns a black body white on the dark page, so it is still a face", () => {
+    const fill = botAvatarFill("#000000", true);
+    expect(fill).toBe(FLIPPED_BODY_DARK_FILL);
+    // The eyes are what makes the flip readable: the near-black ink on the white body, as the
+    // reference's `小猪包` wears them.
+    expect(botEyeInk(fill)).toBe(BOT_EYE_INK);
+    expect(botAvatarFill("#000000", false)).not.toBe(fill);
+  });
+
+  it("flips a body only when it would vanish into the dark page", () => {
+    // Near-black bodies are what the palette offers for a second dark bot; both would be a hole.
+    for (const color of ["#000000", "#0A0A0A", "#1C1C1E"]) {
+      expect(botAvatarFill(color, true), color).toBe(FLIPPED_BODY_DARK_FILL);
+    }
+    // A body with any colour left in it keeps its own dark value.
+    expect(botAvatarFill("#FF5EB1", true)).toBe(BOT_AVATAR_DARK_FILLS["#FF5EB1"]);
