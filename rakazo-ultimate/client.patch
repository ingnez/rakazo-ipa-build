+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+const store = vi.hoisted(() => new Map<string, string>());
+const native = vi.hoisted(() => ({
+  module: null as null | {
+    permission?: (kind: string) => Promise<string>;
+    run?: (method: string, argsJson: string) => Promise<string>;
+  },
+}));
+
+vi.mock("expo-secure-store", () => ({
+  getItemAsync: async (key: string) => store.get(key) ?? null,
+  setItemAsync: async (key: string, value: string) => {
+    store.set(key, value);
+  },
+  deleteItemAsync: async (key: string) => {
+    store.delete(key);
+  },
+}));
+vi.mock("expo-modules-core", () => ({
+  requireOptionalNativeModule: () => native.module,
+}));
+vi.mock("./api", () => ({ currentApiBase: () => "https://rakazo.163ll.com" }));
+vi.mock("./session", () => ({ loadSessionToken: async () => "session-token" }));
+
+import type { PhoneConnectorState } from "@rakazo/contracts";
+import { PHONE_CONNECTORS_OFF } from "@rakazo/contracts";
+import type { PhoneSocketDeps, PhoneSocketStatus } from "./phone-connector-socket";
+import { PhoneConnectorSocket, phoneRequestArgs, phoneSocketUrl } from "./phone-connector-socket";
+import { PHONE_DEVICE_KEY } from "./phone-connectors";
+
+type Handlers = {
+  onOpen: () => void;
+  onMessage: (data: unknown) => void;
+  onClose: (event?: { code?: number; reason?: string }) => void;
+  onError: () => void;
+};
+
+function setup(options: {
+  state?: Partial<PhoneConnectorState>;
+  token?: string | null;
+  permission?: "granted" | "denied" | "undetermined" | "unavailable";
+}) {
+  const sent: string[] = [];
+  const sockets: {
+    url: string;
+    headers: Record<string, string>;
+    handlers: Handlers;
+    closed: boolean;
+  }[] = [];
+  const timers: { run: () => void; ms: number }[] = [];
+  const statuses: PhoneSocketStatus[] = [];
+  let revoked = 0;
+  const state: PhoneConnectorState = { ...PHONE_CONNECTORS_OFF, ...options.state };
+  const deps: PhoneSocketDeps = {
+    apiBase: () => "https://rakazo.163ll.com",
+    credential: async () => (options.token === null ? null : { token: options.token ?? "tok-1" }),
+    state: async () => state,
+    permissionOf: async () => options.permission ?? "granted",
+    openSocket: ((url: string, headers: Record<string, string>, handlers: Handlers) => {
+      const socket = { url, headers, handlers, closed: false };
+      sockets.push(socket);
+      return {
+        send: (data: string | ArrayBuffer) => sent.push(String(data)),
+        close: () => {
+          socket.closed = true;
+        },
+      };
+    }) as never,
+    setTimer: (run, ms) => {
+      timers.push({ run, ms });
+      return timers.length;
+    },
+    clearTimer: () => undefined,
+    onStatus: (status) => statuses.push(status),
+    onRevoked: () => {
+      revoked += 1;
+    },
+  };
+  return {
+    socket: new PhoneConnectorSocket(deps),
+    sent,
+    sockets,
+    timers,
+    statuses,
+    revoked: () => revoked,
+  };
+}
+
+const tick = () => new Promise((resolve) => setTimeout(resolve, 0));
+
+beforeEach(() => {
+  store.clear();
+  native.module = {
+    permission: async () => "granted",
+    run: async () => '{"value":[{"id":"alarm-1","hour":7,"minute":0}]}',
+  };
+});
+
+describe("the phone's socket address", () => {
+  it("is the device path on the same server, encrypted with the server", () => {
+    expect(phoneSocketUrl("https://rakazo.163ll.com")).toBe(
+      "wss://rakazo.163ll.com/api/devices/connect",
+    );
+    expect(phoneSocketUrl("http://127.0.0.1:3000/")).toBe(
+      "ws://127.0.0.1:3000/api/devices/connect",
+    );
+  });
+
+  it("passes everything but the method and the run as the method's arguments", () => {
+    expect(
+      phoneRequestArgs({
+        method: "phoneCalendarList",
+        botId: "b1",
+        runId: "r1",
+        from: "2026-11-17",
+      }),
+    ).toEqual({ from: "2026-11-17" });
+  });
+});
+
+describe("opening the socket", () => {
+  it("stays shut while every switch is off", async () => {
+    const path = setup({});
+    await path.socket.start();
+    expect(path.sockets).toHaveLength(0);
+    expect(path.socket.current).toBe("off");
+  });
+
+  it("stays shut, and says so, when the phone was never paired", async () => {
+    const path = setup({ state: { alarms: true }, token: null });
+    await path.socket.start();
+    expect(path.sockets).toHaveLength(0);
+    expect(path.socket.current).toBe("unavailable");
+  });
+
+  it("dials out with the pairing token once a switch is on", async () => {
+    const path = setup({ state: { alarms: true } });
+    await path.socket.start();
+    expect(path.sockets).toHaveLength(1);
+    expect(path.sockets[0]!.url).toBe("wss://rakazo.163ll.com/api/devices/connect");
+    expect(path.sockets[0]!.headers).toEqual({ authorization: "Bearer tok-1" });
+    path.sockets[0]!.handlers.onOpen();
+    expect(path.socket.current).toBe("connected");
+    expect(path.statuses).toContain("connecting");
+  });
+});
+
+describe("answering a request", () => {
+  it("sends the value, then done, under the request's own id", async () => {
+    const path = setup({ state: { alarms: true } });
+    await path.socket.start();
+    path.sockets[0]!.handlers.onOpen();
+    path.sockets[0]!.handlers.onMessage(
+      JSON.stringify({
+        type: "request",
+        id: "req-1",
+        request: { method: "phoneAlarmList", botId: "b1" },
+      }),
+    );
+    await tick();
+    expect(path.sent).toEqual([
+      JSON.stringify({
+        type: "frame",
+        id: "req-1",
+        frame: { value: [{ id: "alarm-1", hour: 7, minute: 0 }] },
+      }),
+      JSON.stringify({ type: "frame", id: "req-1", frame: { done: true } }),
+    ]);
+  });
+
+  it("refuses, in Chinese, a connector the person has since switched off", async () => {
+    const path = setup({ state: { alarms: true } });
+    await path.socket.start();
+    // The switch goes off between the question being sent and answered.
+    (path.socket as unknown as { deps: PhoneSocketDeps }).deps.state = async () => ({
+      ...PHONE_CONNECTORS_OFF,
+    });
+    path.sockets[0]!.handlers.onOpen();
+    path.sockets[0]!.handlers.onMessage(
+      JSON.stringify({ type: "request", id: "req-2", request: { method: "phoneAlarmList" } }),
+    );
+    await tick();
+    const first = JSON.parse(path.sent[0]!) as { frame: { error?: string } };
+    expect(first.frame.error).toContain("没有打开");
+    expect(JSON.parse(path.sent[1]!)).toEqual({
+      type: "frame",
+      id: "req-2",
+      frame: { done: true },
+    });
+  });
+
+  it("does not answer a request that was cancelled while it ran", async () => {
+    const path = setup({ state: { alarms: true } });
+    await path.socket.start();
+    path.sockets[0]!.handlers.onOpen();
+    path.sockets[0]!.handlers.onMessage(
+      JSON.stringify({ type: "request", id: "req-3", request: { method: "phoneAlarmList" } }),
+    );
+    path.sockets[0]!.handlers.onMessage(JSON.stringify({ type: "cancel", id: "req-3" }));
+    await tick();
+    expect(path.sent).toEqual([]);
+  });
+});
+
+describe("when the pairing ends", () => {
+  it("forgets the token, closes, and tells the app", async () => {
+    const path = setup({ state: { alarms: true } });
+    await path.socket.start();
+    path.sockets[0]!.handlers.onOpen();
+    path.sockets[0]!.handlers.onMessage(JSON.stringify({ type: "revoked" }));
+    await tick();
+    expect(path.revoked()).toBe(1);
+    expect(path.socket.current).toBe("off");
+    expect(store.get(PHONE_DEVICE_KEY)).toBeUndefined();
+  });
+});
+
+describe("staying connected", () => {
+  it("dials again with a longer wait after a drop", async () => {
+    const path = setup({ state: { alarms: true } });
+    await path.socket.start();
+    path.sockets[0]!.handlers.onOpen();
+    path.sockets[0]!.handlers.onClose({ code: 1006 });
+    expect(path.socket.current).toBe("connecting");
+    expect(path.timers).toHaveLength(1);
+    expect(path.timers[0]!.ms).toBeGreaterThan(0);
+    path.timers[0]!.run();
+    await tick();
+    expect(path.sockets).toHaveLength(2);
+  });
+
+  it("closes when the last switch goes off, and reopens when one comes back", async () => {
+    const path = setup({ state: { alarms: true } });
+    await path.socket.start();
+    path.sockets[0]!.handlers.onOpen();
+    (path.socket as unknown as { deps: PhoneSocketDeps }).deps.state = async () => ({
+      ...PHONE_CONNECTORS_OFF,
+    });
+    await path.socket.refresh();
+    expect(path.sockets[0]!.closed).toBe(true);
+    expect(path.socket.current).toBe("off");
+    (path.socket as unknown as { deps: PhoneSocketDeps }).deps.state = async () => ({
+      ...PHONE_CONNECTORS_OFF,
+      location: true,
+    });
+    await path.socket.refresh();
+    expect(path.sockets).toHaveLength(2);
+  });
+
+  it("carries the switch it was opened for, not the first one", async () => {
+    const path = setup({ state: { contacts: true }, permission: "denied" });
+    await path.socket.start();
+    path.sockets[0]!.handlers.onOpen();
+    path.sockets[0]!.handlers.onMessage(
+      JSON.stringify({
+        type: "request",
+        id: "req-4",
+        request: { method: "phoneContactSearch", query: "李" },
+      }),
+    );
+    await tick();
+    const first = JSON.parse(path.sent[0]!) as { frame: { error?: string } };
+    expect(first.frame.error).toContain("没有允许");
+  });
+});
diff --git a/apps/mobile/lib/phone-connector-socket.ts b/apps/mobile/lib/phone-connector-socket.ts
new file mode 100644
index 000000000..3a50823bf
--- /dev/null
+++ b/apps/mobile/lib/phone-connector-socket.ts
@@ -0,0 +1,252 @@
+import type { PhoneConnectorKind, PhoneConnectorState, PhoneDeviceMethod } from "@rakazo/contracts";
+import { currentApiBase } from "./api";
+import {
+  anyPhoneConnectorOn,
+  forgetPhoneDeviceCredential,
+  loadPhoneConnectorState,
+  loadPhoneDeviceCredential,
+  phoneConnectorForMethod,
+  phoneConnectorsNative,
+  phoneDeviceErrorMessage,
+  runPhoneDeviceMethod,
+} from "./phone-connectors";
+import { openRealtimeSocket } from "./realtime-socket";
+
+/**
+ * The phone's socket to the server: the only way a bot's tool reaches this handset.
+ *
+ * The phone dials out, says nothing it was not asked, and answers one request at a time with the
+ * device socket's own frames. It stays open only while a switch is on; signing out or a revoke
+ * closes it and the next launch pairs again.
+ */
+export type PhoneSocketStatus = "off" | "connecting" | "connected" | "unavailable";
+
+export type PhoneSocketDeps = {
+  /** The server's address right now. */
+  apiBase(): string;
+  credential(): Promise<{ token: string } | null>;
+  /** The five switches, read fresh for every request. */
+  state(): Promise<PhoneConnectorState>;
+  permissionOf(
+    kind: PhoneConnectorKind,
+  ): Promise<"granted" | "denied" | "undetermined" | "unavailable">;
+  openSocket: typeof openRealtimeSocket;
+  /** Retry waits, in milliseconds; the first is used for the first failure. */
+  retryMs?: { min: number; max: number };
+  setTimer?: (run: () => void, ms: number) => unknown;
+  clearTimer?: (handle: unknown) => void;
+  onStatus?: (status: PhoneSocketStatus) => void;
+  onRevoked?: () => void;
+};
+
+type ServerMessage =
+  | { type: "request"; id: string; request: { method: string; [key: string]: unknown } }
+  | { type: "cancel"; id: string }
+  | { type: "revoked"; reason?: string };
+
+/** The socket's address for a server: the same host, the device path, over the same security. */
+export function phoneSocketUrl(apiBase: string): string {
+  const url = new URL("/api/devices/connect", apiBase);
+  url.protocol = url.protocol === "https:" ? "wss:" : "ws:";
+  return url.toString();
+}
+
+/** A request as the server writes it: the method, and everything else as arguments. */
+export function phoneRequestArgs(request: Record<string, unknown>): Record<string, unknown> {
+  const { method: _method, botId: _botId, runId: _runId, ...args } = request;
+  return args;
+}
+
+/** One socket, from `start` to the first close it cannot recover from. */
+export class PhoneConnectorSocket {
+  private socket: { send(data: string): void; close(): void } | undefined;
+  private stopped = true;
+  private attempt = 0;
+  private timer: unknown;
+  private status: PhoneSocketStatus = "off";
+  private cancelled = new Set<string>();
+
+  constructor(private readonly deps: PhoneSocketDeps) {}
+
+  get current(): PhoneSocketStatus {
+    return this.status;
+  }
+
+  /** Opens the socket if a switch is on and the phone is paired; otherwise stays off. */
+  async start(): Promise<void> {
+    if (!this.stopped) return;
+    const state = await this.deps.state();
+    if (!anyPhoneConnectorOn(state)) {
+      this.setStatus("off");
+      return;
+    }
+    const credential = await this.deps.credential();
+    if (!credential) {
+      // Paired the first time a switch went on; a missing token means that never completed.
+      this.setStatus("unavailable");
+      return;
+    }
+    this.stopped = false;
+    this.connect(credential.token);
+  }
+
+  stop(): void {
+    this.stopped = true;
+    this.cancelled.clear();
+    if (this.timer !== undefined) {
+      this.deps.clearTimer?.(this.timer);
+      this.timer = undefined;
+    }
+    const socket = this.socket;
+    this.socket = undefined;
+    try {
+      socket?.close();
+    } catch {
+      // Already closed.
+    }
+    this.setStatus("off");
+  }
+
+  /** After a switch changes: opens, closes or stays as the five switches now say. */
+  async refresh(): Promise<void> {
+    const state = await this.deps.state();
+    if (!anyPhoneConnectorOn(state)) {
+      this.stop();
+      return;
+    }
+    if (this.stopped) await this.start();
+  }
+
+  private setStatus(status: PhoneSocketStatus) {
+    if (this.status === status) return;
+    this.status = status;
+    this.deps.onStatus?.(status);
+  }
+
+  private scheduleRetry() {
+    if (this.stopped) return;
+    const retry = this.deps.retryMs ?? { min: 1_000, max: 30_000 };
+    const ceiling = Math.min(retry.max, retry.min * 2 ** this.attempt);
+    this.attempt += 1;
+    const wait = Math.round(retry.min / 2 + Math.random() * ceiling);
+    const setTimer = this.deps.setTimer ?? ((run, ms) => setTimeout(run, ms));
+    this.timer = setTimer(() => {
+      this.timer = undefined;
+      void this.reconnect();
+    }, wait);
+  }
+
+  private async reconnect() {
+    if (this.stopped) return;
+    const credential = await this.deps.credential();
+    if (!credential) {
+      this.stopped = true;
+      this.setStatus("unavailable");
+      return;
+    }
+    this.connect(credential.token);
+  }
+
+  private connect(token: string) {
+    this.setStatus("connecting");
+    const url = phoneSocketUrl(this.deps.apiBase());
+    this.socket = this.deps.openSocket(
+      url,
+      { authorization: `Bearer ${token}` },
+      {
+        onOpen: () => {
+          this.attempt = 0;
+          this.setStatus("connected");
+        },
+        onMessage: (data) => {
+          if (typeof data === "string") void this.receive(data);
+        },
+        onError: () => undefined,
+        onClose: () => {
+          this.socket = undefined;
+          if (this.stopped) return;
+          this.setStatus("connecting");
+          this.scheduleRetry();
+        },
+      },
+    );
+  }
+
+  /** One message from the server: a request to run, a cancel, or the end of this pairing. */
+  private async receive(raw: string) {
+    let message: ServerMessage;
+    try {
+      message = JSON.parse(raw) as ServerMessage;
+    } catch {
+      return;
+    }
+    if (message.type === "revoked") {
+      this.stopped = true;
+      await forgetPhoneDeviceCredential();
+      this.deps.onRevoked?.();
+      this.setStatus("off");
+      return;
+    }
+    if (message.type === "cancel") {
+      this.cancelled.add(message.id);
+      return;
+    }
+    if (message.type !== "request" || typeof message.id !== "string") return;
+    const method = message.request?.method;
+    if (typeof method !== "string") return;
+    await this.answer(message.id, method, phoneRequestArgs(message.request));
+  }
+
+  private async answer(id: string, method: string, args: Record<string, unknown>) {
+    const socket = this.socket;
+    if (!socket) return;
+    // A request the person switched off since it was sent is refused by the phone itself.
+    const kind = phoneConnectorForMethod(method);
+    const state = await this.deps.state();
+    const permission = kind ? await this.deps.permissionOf(kind) : "granted";
+    const answer = await runPhoneDeviceMethod(method as PhoneDeviceMethod, args, {
+      state,
+      native: phoneConnectorsNative(),
+      permissionOf: () => permission,
+    });
+    if (this.cancelled.delete(id)) return;
+    if (answer.error) {
+      socket.send(
+        JSON.stringify({
+          type: "frame",
+          id,
+          frame: { error: phoneDeviceErrorMessage(answer.error, kind) },
+        }),
+      );
+      socket.send(JSON.stringify({ type: "frame", id, frame: { done: true } }));
+      return;
+    }
+    socket.send(JSON.stringify({ type: "frame", id, frame: { value: answer.value } }));
+    socket.send(JSON.stringify({ type: "frame", id, frame: { done: true } }));
+  }
+}
+
+let phoneSocket: PhoneConnectorSocket | null = null;
+
+/** The app's one phone socket, opened on demand by the settings screen and the app's launch. */
+export function phoneConnectorSocket(): PhoneConnectorSocket {
+  if (!phoneSocket) {
+    const native = phoneConnectorsNative();
+    phoneSocket = new PhoneConnectorSocket({
+      apiBase: currentApiBase,
+      credential: async () => {
+        const stored = await loadPhoneDeviceCredential();
+        return stored ? { token: stored.token } : null;
+      },
+      state: loadPhoneConnectorState,
+      permissionOf: async (kind) => (native ? native.permission(kind) : "unavailable"),
+      openSocket: openRealtimeSocket,
+    });
+  }
+  return phoneSocket;
+}
+
+/** Starts the socket if a switch is already on; safe to call on every launch and focus. */
+export async function resumePhoneConnectorSocket(): Promise<void> {
+  await phoneConnectorSocket().refresh();
+}
