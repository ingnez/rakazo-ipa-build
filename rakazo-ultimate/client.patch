+import { describe, expect, it } from "vitest";
+import {
+  OPENMINIS_CLOVER,
+  OPENMINIS_CLOUD,
+  OPENMINIS_COLOR_COUNT,
+  OPENMINIS_FLOWER,
+  OPENMINIS_PALETTE,
+  OPENMINIS_ROLE_ROWS,
+  OPENMINIS_SHAPE_COUNT,
+  openminisBodyPath,
+  openminisContains,
+  openminisHashedSpec,
+  OPENMINIS_CHIEF_LOOK,
+  openminisBodyHex,
+  openminisEyeHex,
+  openminisHex,
+  openminisMoodFor,
+  openminisRgb,
+  openminisSpecFor,
+  openminisSvg,
+} from "./openminis-avatar.js";
+
+describe("openminis palette and hash defaults", () => {
+  it("has twelve colours and thirteen shapes", () => {
+    expect(OPENMINIS_PALETTE).toHaveLength(OPENMINIS_COLOR_COUNT);
+    expect(OPENMINIS_SHAPE_COUNT).toBe(13);
+  });
+
+  it("turns black into graphite in the dark theme and leaves indigo alone", () => {
+    expect(openminisRgb(0, false)).toEqual([0, 0, 0]);
+    expect(openminisRgb(0, true)).toEqual([0.42, 0.42, 0.44]);
+    expect(openminisHex(10, false)).toBe(openminisHex(10, true));
+    expect(openminisHex(10, false).toLowerCase()).toBe("#6366f2");
+  });
+
+  it("matches OpenMinis template defaults for the hashed ids", () => {
+    expect(openminisHashedSpec("any", true)).toEqual({ shape: 0, color: 10 });
+    expect(openminisHashedSpec("coder", false)).toEqual({ shape: 7, color: 6 });
+    expect(openminisHashedSpec("writer", false)).toEqual({ shape: 8, color: 6 });
+    expect(openminisHashedSpec("life", false)).toEqual({ shape: 8, color: 7 });
+    expect(openminisHashedSpec("quiz", false)).toEqual({ shape: 0, color: 5 });
+  });
+});
+
+describe("openminis role mapping", () => {
+  it("gives the chief the circle body and does not bake or suppress the overlay star", () => {
+    expect(openminisSpecFor({ name: "小猪包" })).toMatchObject({
+      shape: 0,
+      color: 10,
+      role: "chief",
+      suppressMainStar: false,
+    });
+    expect(openminisSpecFor({ chief: true, name: "someone" }).role).toBe("chief");
+    expect(openminisSpecFor({ identity: "cmwgm49boyweiboib5meju5x7" }).role).toBe("chief");
+  });
+
+  it("uses OpenMinis template defaults where a counterpart exists", () => {
+    expect(openminisSpecFor({ name: "开发助理" })).toMatchObject({ role: "dev", shape: 7, color: 6 });
+    expect(openminisSpecFor({ name: "小说写手" })).toMatchObject({ role: "novel", shape: 8, color: 6 });
+    expect(openminisSpecFor({ name: "生活助理" })).toMatchObject({ role: "life", shape: 8, color: 7 });
+    expect(openminisSpecFor({ name: "刷题教练" })).toMatchObject({ role: "quiz", shape: 0, color: 5 });
+  });
+
+  it("gives every one of the twelve roles a mapped look, matched by name, key or id", () => {
+    for (const row of OPENMINIS_ROLE_ROWS) {
+      expect(openminisSpecFor({ name: row.name }).role).toBe(row.role);
+      expect(openminisSpecFor({ identity: row.role }).role).toBe(row.role);
+      expect(openminisSpecFor({ identity: row.botIds[0] }).role).toBe(row.role);
+    }
+  });
+
+  it("hashes an unknown bot instead of falling back to the chief", () => {
+    const spec = openminisSpecFor({ identity: "a-new-helper", name: "新助手" });
+    expect(spec.role).toBe("custom");
+    expect(spec).toMatchObject(openminisHashedSpec("a-new-helper", false));
+    expect(spec.suppressMainStar).toBe(false);
+  });
+});
+
+describe("openminis moods", () => {
+  it("maps working, waiting, errors and long idleness", () => {
+    expect(openminisMoodFor({ status: "running" })).toBe("focused");
+    expect(openminisMoodFor({ composing: true })).toBe("focused");
+    expect(openminisMoodFor({ status: "waiting" })).toBe("curious");
+    expect(openminisMoodFor({ status: "failed" })).toBe("frown");
+    expect(openminisMoodFor({ unread: true })).toBe("happy");
+    expect(openminisMoodFor({ idleSeconds: 2 * 86_400 })).toBe("dozing");
+    expect(openminisMoodFor({ shy: true, status: "running" })).toBe("shy");
+    expect(openminisMoodFor({})).toBe("calm");
+  });
+});
+
+describe("openminis body paths", () => {
+  it("returns a closed path for every shape", () => {
+    for (let shape = 0; shape < OPENMINIS_SHAPE_COUNT; shape += 1) {
+      const d = openminisBodyPath(shape);
+      expect(d.startsWith("M"), `shape ${shape}`).toBe(true);
+      expect(d.endsWith("Z"), `shape ${shape}`).toBe(true);
+      expect(d.length).toBeGreaterThan(20);
+    }
+  });
+
+  it("builds clover, cloud and flower as a single union, covering their discs", () => {
+    expect(openminisContains(OPENMINIS_CLOVER, 0.5, 0.5)).toBe(true);
+    expect(openminisContains(OPENMINIS_CLOUD, 0.5, 0.5)).toBe(true);
+    expect(openminisContains(OPENMINIS_FLOWER, 0.5, 0.5)).toBe(true);
+    expect(openminisContains(OPENMINIS_CLOVER, 0.32, 0.36)).toBe(true);
+    expect(openminisContains(OPENMINIS_CLOVER, 0, 0)).toBe(false);
+    expect(openminisBodyPath(1).includes("L")).toBe(true);
+  });
+
+  it("draws a teardrop whose bulb sits at the bottom", () => {
+    const d = openminisBodyPath(7);
+    expect(d).toContain("A0.4 0.4");
+    expect(d).toContain("0.9 0.62");
+    expect(d).toContain("0.1 0.62");
+  });
+
+  it("emits an svg with the body fill and white eyes", () => {
+    const svg = openminisSvg(
+      { shape: 0, color: 10 },
+      { size: 50, dark: false, eyeOpen: 1, mood: "calm" },
+    );
+    expect(svg).toContain('fill="#6366f2"');
+    expect(svg).toContain('fill="#ffffff"');
+    expect(svg).toContain("<svg");
+    const dark = openminisSvg({ shape: 0, color: 0 }, { size: 50, dark: true, showsFace: false });
+    expect(dark).toContain("omGlow");
+    expect(dark).toContain(openminisHex(0, true).toLowerCase());
+  });
+});
+
+describe("chief official face", () => {
+  it("inks the chief white with black eyes in dark mode, near-black with white eyes in light mode", () => {
+    const chief = openminisSpecFor({ name: "小猪包" });
+    expect(openminisBodyHex(chief, true).toLowerCase()).toBe("#ffffff");
+    expect(openminisEyeHex(chief, true).toLowerCase()).toBe("#000000");
+    expect(openminisBodyHex(chief, false).toLowerCase()).toBe("#111111");
+    expect(openminisEyeHex(chief, false).toLowerCase()).toBe("#ffffff");
+    const dark = openminisSvg(chief, { size: 96, dark: true, eyeOpen: 1, mood: "calm" });
+    expect(dark.toLowerCase()).toContain('fill="#ffffff"');
+    expect(dark.toLowerCase()).toContain('fill="#000000"');
+    expect(dark.toLowerCase()).not.toContain("#6366f2");
+    expect(dark).not.toContain("omGlow");
+    expect(dark).not.toContain("star");
+    const light = openminisSvg(chief, { size: 96, dark: false, eyeOpen: 1, mood: "calm" });
+    expect(light.toLowerCase()).toContain('fill="#111111"');
+    expect(light.toLowerCase()).not.toContain("#6366f2");
+  });
+
+  it("uses the screenshot backslash tilt, up-right placement and asymmetric eyes", () => {
+    expect(OPENMINIS_CHIEF_LOOK.rotate).toBeCloseTo(-33.4, 1);
+    const [left, right] = OPENMINIS_CHIEF_LOOK.eyes;
+    expect(left.x).toBeLessThan(right.x);
+    expect(right.y).toBeLessThan(left.y);
+    expect(right.width).toBeLessThan(left.width);
+    const svg = openminisSvg(openminisSpecFor({ name: "小猪包" }), {
+      size: 96,
+      dark: true,
+      eyeOpen: 1,
+      mood: "calm",
+    });
+    expect(svg).toContain("rotate(-33.4)");
+    expect(svg).toContain(`translate(${left.x} ${left.y})`);
+    expect(svg).toContain(`translate(${right.x} ${right.y})`);
+  });
+});
