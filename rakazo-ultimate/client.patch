+++ b/apps/api/src/billing/payment-wallet-router.test.ts
@@ -0,0 +1,136 @@
+import { RPCHandler } from "@orpc/server/fetch";
+import type { PaymentWalletProvider } from "@rakazo/adapter-kit";
+import { createPaymentWalletProvider } from "@rakazo/adapters";
+import type { Actor } from "@rakazo/contracts";
+import type { PrismaClient } from "@rakazo/db";
+import { describe, expect, it, vi } from "vitest";
+import type { RouterDeps } from "../router.js";
+import { createRouter } from "../router.js";
+
+// Offline boundary: a fake Prisma table and secret store drive the real router handlers and the
+// real wallet service against the deterministic emulator wallet.
+
+type Row = Record<string, unknown>;
+
+const actor = {
+  spaceId: "space-1",
+  userId: "user-1",
+  email: "user@rakazo.test",
+  isDeploymentOwner: false,
+} satisfies Actor;
+
+function walletDeps(paymentWallet: PaymentWalletProvider | null) {
+  const rows: Row[] = [];
+  const matches = (row: Row, where: Row) =>
+    Object.entries(where).every(([key, value]) =>
+      value instanceof Date
+        ? row[key] instanceof Date && (row[key] as Date).getTime() === value.getTime()
+        : row[key] === value,
+    );
+  const paymentWallet_ = {
+    findUnique: vi.fn(async ({ where }: { where: Row }) => {
+      const row = rows.find((entry) => matches(entry, where));
+      return row ? { ...row } : null;
+    }),
+    updateMany: vi.fn(async ({ where, data }: { where: Row; data: Row }) => {
+      const found = rows.filter((row) => matches(row, where));
+      for (const row of found) Object.assign(row, data);
+      return { count: found.length };
+    }),
+    deleteMany: vi.fn(async ({ where }: { where: Row }) => {
+      const before = rows.length;
+      for (let index = rows.length - 1; index >= 0; index -= 1)
+        if (matches(rows[index]!, where)) rows.splice(index, 1);
+      return { count: before - rows.length };
+    }),
+    upsert: vi.fn(async ({ where, create, update }: { where: Row; create: Row; update: Row }) => {
+      const row = rows.find((entry) => matches(entry, where));
+      if (row) Object.assign(row, update);
+      else rows.push({ id: "wallet-1", ...create });
+      return {};
+    }),
+  };
+  const prisma = {
+    paymentWallet: paymentWallet_,
+    $executeRaw: vi.fn(async () => 1),
+    $transaction: vi.fn(async (fn: (tx: unknown) => unknown) => fn(prisma)),
+  };
+  const values = new Map<string, string>();
+  const secrets = {
+    put: vi.fn(async (plaintext: string, _context: unknown, options: { recordId: string }) => {
+      const ref = `enc:${values.size + 1}`;
+      values.set(ref, plaintext);
+      return { id: options.recordId, ref, ciphertext: ref };
+    }),
+    load: vi.fn(async (ref: string) => values.get(ref) ?? ""),
+    delete: vi.fn(async (ref: string) => {
+      values.delete(ref);
+    }),
+    isRemote: () => false,
+  };
+  const deps = {
+    prisma: prisma as unknown as PrismaClient,
+    secrets,
+    jobs: { enqueue: vi.fn(), enqueueIn: vi.fn(), cancel: vi.fn() },
+    paymentWallet,
+    env: {
+      defaultProvider: "fake",
+      defaultModel: "fake-model",
+      webOrigin: "http://127.0.0.1:5173",
+      screenProxySecret: "fake-test-secret",
+      sandboxProvider: "fake",
+    },
+    dataDir: "/tmp/rakazo-router-test",
+  } as unknown as RouterDeps;
+  const handler = new RPCHandler(createRouter(deps));
+  async function call(path: "status" | "connect" | "disconnect") {
+    const { response } = await handler.handle(
+      new Request(`http://127.0.0.1/rpc/paymentWallet/${path}`, {
+        method: "POST",
+        headers: { "content-type": "application/json" },
+        body: JSON.stringify({}),
+      }),
+      { prefix: "/rpc", context: { actor } },
+    );
+    if (!response) throw new Error("Procedure did not match");
+    return { status: response.status, body: (await response.json()) as { json: unknown } };
+  }
+  return { rows, values, call };
+}
+
+describe("paymentWallet routes", () => {
+  it("reads disconnected and refuses to connect without a provider", async () => {
+    const { call } = walletDeps(null);
+    expect((await call("status")).body.json).toEqual({ status: "disconnected" });
+    expect((await call("connect")).status).toBe(404);
+    expect((await call("disconnect")).body.json).toEqual({ status: "disconnected" });
+  });
+
+  it("connects, finishes the sign-in on a later status read, and disconnects", async () => {
+    vi.useFakeTimers({ toFake: ["Date"] });
+    try {
+      const { call, rows, values } = walletDeps(
+        await createPaymentWalletProvider({ PAYMENT_WALLET_PROVIDER: "emulator" }),
+      );
+      const started = await call("connect");
+      expect(started.status).toBe(200);
+      expect(started.body.json).toMatchObject({
+        status: "connecting",
+        verificationUrl: expect.stringMatching(/^https:\/\//),
+        userCode: "EMUL-ATOR",
+      });
+      expect(rows[0]).toMatchObject({ provider: "emulator", status: "connecting" });
+
+      vi.setSystemTime(new Date(Date.now() + 2_000));
+      const status = await call("status");
+      expect(status.body.json).toMatchObject({ status: "connected" });
+      expect(JSON.stringify(status.body)).not.toContain(String(values.values().next().value));
+
+      expect((await call("disconnect")).body.json).toEqual({ status: "disconnected" });
+      expect(rows).toHaveLength(0);
+      expect(values.size).toBe(0);
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+});
diff --git a/apps/api/src/billing/plan-start-emails.ts b/apps/api/src/billing/plan-start-emails.ts
new file mode 100644
index 000000000..a65d8a6ed
--- /dev/null
+++ b/apps/api/src/billing/plan-start-emails.ts
@@ -0,0 +1,57 @@
+import type { BillingSubscriptionSnapshot } from "@rakazo/adapter-kit";
+import { retry } from "@rakazo/core";
+import { bestEffort } from "@rakazo/logging";
+import type { ScheduleLifecycleEmail } from "../email/lifecycle-email.js";
+import {
+  AGENT_IMPORT_EMAIL_DELAY_MS,
+  MODEL_CONNECTION_EMAIL_DELAY_MS,
+} from "../email/lifecycle-email.js";
+
+/**
+ * The mails a plan's start queues for its owner. Concurrent syncs that both see the start queue
+ * the same keyed jobs. Scheduling is outside the billing snapshot's transaction, so a brief
+ * queue outage is ridden out here and a failure never stops the sync.
+ */
+export async function schedulePlanStartEmails(
+  deps: {
+    schedule?: ScheduleLifecycleEmail;
+    modelCredits: boolean;
+    ownerUserId: (organizationId: string) => Promise<string | undefined>;
+  },
+  organizationId: string,
+  live: BillingSubscriptionSnapshot,
+): Promise<void> {
+  const { schedule } = deps;
+  if (!schedule) return;
+  // The owner is looked up inside the guarded call: a failed read must not stop the sync either.
+  const queue = (kind: Parameters<ScheduleLifecycleEmail>[0], delayMs: number) =>
+    bestEffort(
+      `schedule the ${kind} email`,
+      retry(
+        async () => {
+          const userId = await deps.ownerUserId(organizationId);
+          if (userId)
+            await schedule(kind, { organizationId, userId }, dueAfterStart(live, delayMs));
+        },
+        { attempts: 3 },
+      ),
+    );
+  // An own-key plan runs nothing until its owner connects a model, so a day in they are
+  // reminded if they still have not. Without model credits the deployment's own model serves
+  // everyone, so nobody is asked.
+  if (deps.modelCredits && live.byokPlan && !live.creditAmountCents)
+    await queue("model-connection", MODEL_CONNECTION_EMAIL_DELAY_MS);
+  // Two days into any plan its owner is shown how to bring an assistant over, unless they
+  // already have: a day after the model reminder, so the two never arrive together.
+  await queue("agent-import", AGENT_IMPORT_EMAIL_DELAY_MS);
+}
+
+/**
+ * From the plan's own start, so every sync that sees it names the same time. A start recorded
+ * later than the delay still leaves the owner the whole delay.
+ */
+function dueAfterStart(live: BillingSubscriptionSnapshot, delayMs: number): Date {
+  const now = Date.now();
+  const fromStart = (live.currentPeriodStartsAt?.getTime() ?? now) + delayMs;
+  return new Date(fromStart > now ? fromStart : now + delayMs);
+}
