+  target: { botId: string } | { groupId: string } | null;
+  status: string | null | undefined;
+  stage: string;
+}): void {
+  const working = isRunWorking(status);
+  const waiting = isRunWaitingOnUser(status);
+  const targetKey = target ? ("botId" in target ? target.botId : target.groupId) : "";
