+function superscript(body: string): string {
+  const mapped = [...body].map((character) => SUPERSCRIPTS[character]);
+  return mapped.every(Boolean) ? mapped.join("") : `^(${body})`;
+}
+
+function subscript(body: string): string {
+  const mapped = [...body].map((character) => SUBSCRIPTS[character]);
+  return mapped.every(Boolean) ? mapped.join("") : `_(${body})`;
+}
+
+/** Takes one `{…}` group starting at `index`, returning its body and where it ends. */
+function braced(text: string, index: number): { body: string; end: number } | null {
+  if (text[index] !== "{") return null;
+  let depth = 0;
+  for (let cursor = index; cursor < text.length; cursor += 1) {
+    if (text[cursor] === "{") depth += 1;
+    else if (text[cursor] === "}") {
+      depth -= 1;
+      if (depth === 0) return { body: text.slice(index + 1, cursor), end: cursor + 1 };
+    }
+  }
+  return null;
+}
+
+/**
+ * A maths expression as read-aloud characters: commands looked up, fractions as `a/b`, powers and
+ * indices as Unicode where they exist, and braces used only for grouping taken away.
+ */
+export function readMath(expression: string): string {
+  let out = "";
+  let index = 0;
+  while (index < expression.length) {
+    const character = expression[index]!;
+    if (character === "\\") {
+      const name = /^\\([a-zA-Z]+|.)/.exec(expression.slice(index));
+      if (!name) {
+        out += " ";
+        index += 1;
+        continue;
+      }
+      const command = name[1]!;
+      index += name[0].length;
+      if (command === "\\") {
+        // A forced line break inside maths reads as a space.
+        out += " ";
+        continue;
+      }
+      if (FRACTION_COMMANDS.has(command)) {
+        const numerator = braced(expression, index);
+        if (!numerator) continue;
+        index = numerator.end;
+        const denominator = braced(expression, index);
+        if (!denominator) {
+          out += readMath(numerator.body);
+          continue;
+        }
+        index = denominator.end;
+        const top = readMath(numerator.body).trim();
+        const bottom = readMath(denominator.body).trim();
+        out += `${top}/${bottom}`;
+        continue;
+      }
+      if (ARGUMENT_COMMANDS.has(command)) {
+        const argument = braced(expression, index);
+        if (argument) {
+          out += readMath(argument.body);
+          index = argument.end;
+        }
+        continue;
+      }
+      if (STYLE_COMMANDS.has(command)) continue;
+      const symbol = SYMBOLS[command];
+      if (symbol !== undefined) {
+        out += symbol;
+        continue;
+      }
+      // An unknown command is still a word the reader should see, without its backslash.
+      out += command;
+      continue;
+    }
+    if (character === "^" || character === "_") {
+      const group = braced(expression, index + 1);
+      if (group) {
+        out += character === "^" ? superscript(readMath(group.body)) : subscript(readMath(group.body));
+        index = group.end;
+        continue;
+      }
+      const single = expression[index + 1];
+      if (single !== undefined && single !== " " && single !== "^" && single !== "_") {
+        out += character === "^" ? superscript(single) : subscript(single);
+        index += 2;
+        continue;
+      }
+      out += character;
+      index += 1;
+      continue;
+    }
+    if (character === "{" || character === "}") {
+      index += 1;
+      continue;
+    }
+    if (character === "~") {
+      out += " ";
+      index += 1;
+      continue;
+    }
+    out += character;
+    index += 1;
+  }
+  return out;
+}
+
+/**
+ * Whether a run between dollars is maths rather than money. A command settles it; otherwise the run
+ * has to read as an expression — no spaces, and an operator a reader would type as maths.
+ */
+export function looksLikeMath(body: string): boolean {
+  if (/\\[a-zA-Z]+/.test(body)) return true;
+  if (!/^[0-9A-Za-z.+\-*/=<>()^_{}[\]\s]+$/.test(body)) return false;
+  if (!/[=+*/^_<>]/.test(body)) return false;
+  return body.trim().length > 0 && body.length <= 40;
+}
+
+/** Expands the maths in one run of prose, leaving anything that is not maths alone. */
+export function expandMathInText(text: string): string {
+  let out = "";
+  let index = 0;
+  while (index < text.length) {
+    const character = text[index]!;
+    // `\$` is a literal dollar, not the start of maths.
+    if (character === "\\" && text[index + 1] === "$") {
+      out += "$";
+      index += 2;
+      continue;
+    }
+    if (character === "\\" && (text[index + 1] === "(" || text[index + 1] === "[")) {
+      const close = text[index + 1] === "(" ? "\\)" : "\\]";
+      const end = text.indexOf(close, index + 2);
+      if (end !== -1) {
+        const body = text.slice(index + 2, end);
+        if (body.trim()) {
+          out += readMath(body).replace(/\s+/g, " ").trim();
+          index = end + close.length;
+          continue;
+        }
+      }
+    }
+    if (character === "$") {
+      // `$$…$$` is a display block; its body reads the same here, without the doubled marks.
+      const double = text.startsWith("$$", index);
+      const openAt = double ? index + 2 : index + 1;
+      const closeAt = text.indexOf(double ? "$$" : "$", openAt);
+      if (closeAt !== -1) {
+        const body = text.slice(openAt, closeAt);
+        const relaxed = double || body.includes("\n");
+        if (body.trim() && !body.includes("$") && (relaxed || looksLikeMath(body))) {
+          out += readMath(body).replace(/\s*\n\s*/g, " ").trim();
+          index = closeAt + (double ? 2 : 1);
+          continue;
+        }
+      }
+    }
+    out += character;
+    index += 1;
+  }
+  return out;
+}
+
+/** Whether a line opens or closes a fenced code block. */
+function isFence(line: string): boolean {
+  return /^\s*(```|~~~)/.test(line);
+}
+
+/**
+ * A whole message with its inline maths expanded, outside fenced blocks and inline code spans,
+ * where a backslash is part of the code rather than a command.
+ */
+export function expandInlineLatex(markdown: string): string {
+  if (!markdown.includes("$") && !markdown.includes("\\(")) return markdown;
+  let inFence = false;
+  return markdown
+    .split("\n")
+    .map((line) => {
+      if (isFence(line)) {
+        inFence = !inFence;
+        return line;
+      }
+      if (inFence) return line;
+      // Code spans keep their characters: split on them and expand only the prose between.
+      return line
+        .split(/(`+[^`]*`+)/)
+        .map((part) => (part.startsWith("`") ? part : expandMathInText(part)))
+        .join("");
+    })
+    .join("\n");
+}
