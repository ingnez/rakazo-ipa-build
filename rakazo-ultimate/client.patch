+        <Text style={label}>Chat header</Text>
+        <View style={{ flexDirection: "row", alignItems: "center", gap: 10, paddingVertical: 8 }}>
+          <ChatTitleAvatar bot={chief} status="working" composing={false} />
+          <Text style={{ color: tokens.foreground, fontSize: 17, fontWeight: "600" }}>{chief.name}</Text>
+        </View>
+
+        <Text style={label}>Shimmer</Text>
