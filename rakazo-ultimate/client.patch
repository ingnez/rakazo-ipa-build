@@ -0,0 +1,76 @@
+// Rakazo's own motion and colour tables, re-exported from `avatar-spec.ts` under the names the
+// player reads. Every clip, face and colour here was written for this app; none of it was
+// extracted from another app's bundle.
+
+import type { AvatarKey } from "./avatar-clips.js";
+import {
+  AVATAR_BODY_KEYS,
+  AVATAR_CLIPS,
+  AVATAR_FACE_ALIASES,
+  AVATAR_FACES,
+  AVATAR_GRADIENT_ANGLE,
+  AVATAR_GRADIENTS,
+  AVATAR_MORPH_DURATIONS,
+  AVATAR_MORPHS,
+  AVATAR_SOLIDS,
+  AVATAR_STATES,
+  type AvatarFaceSpec,
+  type AvatarStateRule,
+} from "./avatar-spec.js";
+
+export interface MotionClipData {
+  duration: number;
+  /** The body the clip was written on (only a label: clips play on every body). */
+  body: string;
+  /** Where a squash is anchored along the body, or -1 for none. */
+  squashAnchor: number;
+  /** Seconds of the clip that actually play, stretched over the whole duration. */
+  workArea: readonly [number, number] | null;
+  position?: readonly AvatarKey[];
+  rotation?: readonly AvatarKey[];
+  zoom?: readonly AvatarKey[];
+  squash?: readonly AvatarKey[];
+  lids?: readonly AvatarKey[];
+  /** Seconds at which the clip's face blinks. */
+  blinks: readonly number[];
+  /** Face changes: seconds, the face name (aliases resolved later), and whether it cuts. */
+  faces: readonly (readonly [number, string, number])[];
+}
+
+/** The clip table, in the player's units. */
+export const MOTION_CLIPS: Readonly<Record<string, MotionClipData>> = AVATAR_CLIPS;
+
+/** Which clips a state plays, and what it does over time. */
+export type MotionStateRule = AvatarStateRule;
+export const MOTION_STATES: Readonly<Record<string, MotionStateRule>> = AVATAR_STATES;
+
+/** An eyelid pair: a quadratic curve per eye. */
+export type MotionFaceSpec = AvatarFaceSpec;
+export const MOTION_FACES: Readonly<Record<string, MotionFaceSpec>> = AVATAR_FACES;
+
+/** The names a clip may use for a face, and the canonical one it means. */
+export const MOTION_FACE_ALIASES: Readonly<Record<string, string>> = AVATAR_FACE_ALIASES;
+
+/** The morph effects a state may lay over a clip. */
+export const MOTION_MORPHS: Readonly<Record<string, string>> = AVATAR_MORPHS;
+export const MOTION_MORPH_NAMES: readonly string[] = Object.keys(AVATAR_MORPHS);
+export const MOTION_MORPH_DURATIONS: Readonly<Record<string, number>> = AVATAR_MORPH_DURATIONS;
+
+/** No body needs its own zoom: the bodies are already sized to read alike. */
+export const MOTION_SHAPE_SCALE_OVERRIDE: Readonly<Record<string, number>> = {};
+
+/** The two stops of a body's gradient, per colour, in light and dark mode. */
+export const MOTION_BODY_GRADIENTS: Readonly<
+  Record<string, { lightFrom: string; lightTo: string; darkFrom: string; darkTo: string }>
+> = AVATAR_GRADIENTS;
+
+/** The single fill each body keeps for small sizes and flat surfaces. */
+export const MOTION_BODY_SOLIDS: Readonly<Record<string, { light: string; dark: string }>> =
+  AVATAR_SOLIDS;
+
+export const MOTION_GRADIENT_ANGLE = AVATAR_GRADIENT_ANGLE;
+
+/** Every body's own zoom: 1, because `BABYGROK_VISUAL_SCALES` already evens their size out. */
+export const MOTION_SHAPE_SCALES: Readonly<Record<string, number>> = Object.fromEntries(
+  AVATAR_BODY_KEYS.map((key) => [key, 1]),
+);
