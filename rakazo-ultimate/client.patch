+
+/** Whether a point lies inside a body's ring. */
+function onBody(ring: readonly number[], [x, y]: [number, number]): boolean {
+  let odd = false;
+  for (let index = 0; index < ring.length; index += 2) {
+    const next = (index + 2) % ring.length;
+    const [x0, y0, x1, y1] = [ring[index]!, ring[index + 1]!, ring[next]!, ring[next + 1]!];
+    if (y0 > y !== y1 > y) {
+      if (x < x0 + ((y - y0) * (x1 - x0)) / (y1 - y0)) odd = !odd;
+    }
+  }
+  return odd;
+}
+
+/**
+ * The eyes a loop path draws, each walked into a closed outline: every side is one quadratic, so a
+ * dozen samples along it are finer than a screen pixel at any size.
+ */
+function loopPolygons(d: string): Array<Array<[number, number]>> {
+  const loops: Array<Array<[number, number]>> = [];
+  let current: Array<[number, number]> | null = null;
+  let cursor: [number, number] = [0, 0];
+  const tokens = d.match(/[MQZ]|-?\d+\.?\d*/g) ?? [];
+  let index = 0;
+  while (index < tokens.length) {
+    const token = tokens[index];
+    if (token === "M") {
+      if (current) loops.push(current);
+      cursor = [Number(tokens[index + 1]), Number(tokens[index + 2])];
+      current = [cursor];
+      index += 3;
+      continue;
+    }
+    if (token === "Q") {
+      const [x1, y1, x2, y2] = [
+        Number(tokens[index + 1]),
+        Number(tokens[index + 2]),
+        Number(tokens[index + 3]),
+        Number(tokens[index + 4]),
+      ] as [number, number, number, number];
+      const [x0, y0] = cursor;
+      for (let step = 1; step <= 12; step += 1) {
+        const t = step / 12;
+        current!.push([
+          (1 - t) ** 2 * x0 + 2 * (1 - t) * t * x1 + t * t * x2,
+          (1 - t) ** 2 * y0 + 2 * (1 - t) * t * y1 + t * t * y2,
+        ]);
+      }
+      cursor = [x2, y2];
+      index += 5;
+      continue;
+    }
+    if (token === "Z") {
+      if (current) loops.push(current);
+      current = null;
+      index += 1;
+      continue;
+    }
+    index += 1;
+  }
+  if (current) loops.push(current);
+  return loops;
+}
+
+/** Whether a point lies inside a closed outline, by the crossing rule. */
+function insidePolygon(polygon: Array<[number, number]>, [x, y]: [number, number]): boolean {
+  let odd = false;
+  for (let index = 0; index < polygon.length; index += 1) {
+    const [x0, y0] = polygon[index]!;
+    const [x1, y1] = polygon[(index + 1) % polygon.length]!;
+    if (y0 > y !== y1 > y && x < x0 + ((y - y0) * (x1 - x0)) / (y1 - y0)) odd = !odd;
+  }
+  return odd;
+}
+
+/** Whether two closed outlines touch or overlap at any point. */
+function eyesMeet(
+  one: Array<[number, number]>,
+  other: Array<[number, number]>,
+): boolean {
+  const box = (points: Array<[number, number]>) => ({
+    minX: Math.min(...points.map((point) => point[0])),
+    maxX: Math.max(...points.map((point) => point[0])),
+    minY: Math.min(...points.map((point) => point[1])),
+    maxY: Math.max(...points.map((point) => point[1])),
+  });
+  const a = box(one);
+  const b = box(other);
+  // Two outlines whose boxes are apart are apart; this is the answer for almost every pair.
+  if (a.maxX < b.minX || b.maxX < a.minX || a.maxY < b.minY || b.maxY < a.minY) return false;
+  if (one.some((point) => insidePolygon(other, point))) return true;
+  if (other.some((point) => insidePolygon(one, point))) return true;
+  const crosses = (
+    [x0, y0]: [number, number],
+    [x1, y1]: [number, number],
+    [x2, y2]: [number, number],
+    [x3, y3]: [number, number],
+  ) => {
+    const side = (ax: number, ay: number, bx: number, by: number, cx: number, cy: number) =>
+      (bx - ax) * (cy - ay) - (by - ay) * (cx - ax);
+    return (
+      side(x0, y0, x1, y1, x2, y2) * side(x0, y0, x1, y1, x3, y3) < 0 &&
+      side(x2, y2, x3, y3, x0, y0) * side(x2, y2, x3, y3, x1, y1) < 0
+    );
+  };
+  for (let index = 0; index < one.length; index += 1) {
+    const [x0, y0] = one[index]!;
+    const [x1, y1] = one[(index + 1) % one.length]!;
+    for (let step = 0; step < other.length; step += 1) {
+      const [x2, y2] = other[step]!;
+      const [x3, y3] = other[(step + 1) % other.length]!;
+      if (crosses([x0, y0], [x1, y1], [x2, y2], [x3, y3])) return true;
+    }
+  }
+  return false;
+}
+
+/** Every x,y pair in a path body, as numbers. */
+function points(path: string): Array<[number, number]> {
+  return path
+    .slice(1, -1)
+    .split("L")
+    .map((pair) => pair.split(" ").map(Number) as [number, number]);
+}
