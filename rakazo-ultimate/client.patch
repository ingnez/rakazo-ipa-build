+/**
+ * First-page thumbnails for PDF artifacts. A card shows the top of the page at the width the card
+ * has, and the rest of it waits for the tap that opens the file itself.
+ */
+enum RakazoPdfThumbnail {
+  /// The page is drawn on the main thread, where Core Graphics is at home, even though the JS call
+  /// arrives on a module queue.
+  static func make(uri: String, maxWidth: Double) -> String? {
+    guard let url = URL(string: uri), url.isFileURL else {
+      figure("not a local file", uri)
+      return nil
+    }
+    let render: () -> String? = {
+      guard let document = PDFDocument(url: url), let page = document.page(at: 0) else {
+        figure("unreadable", uri)
+        return nil
+      }
+      let box = page.bounds(for: .cropBox)
+      guard box.width > 0, box.height > 0 else {
+        figure("empty page", uri)
+        return nil
+      }
+      // A card is about 330 points wide; asking for more than 600 only spends memory.
+      let width = min(max(maxWidth, 120), 600)
+      let size = CGSize(width: width, height: (width * box.height / box.width).rounded())
+      let image = page.thumbnail(of: size, for: .cropBox)
+      guard let data = image.pngData() else {
+        figure("no image", uri)
+        return nil
+      }
+      let directory = FileManager.default
+        .urls(for: .cachesDirectory, in: .userDomainMask)[0]
+        .appendingPathComponent("pdf-page-thumbnails", isDirectory: true)
+      do {
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+      } catch {
+        figure("no cache directory", uri)
+        return nil
+      }
+      let file = directory.appendingPathComponent("\(stamp(uri: uri, width: width)).png")
+      if !FileManager.default.fileExists(atPath: file.path) {
+        do {
+          try data.write(to: file, options: .atomic)
+        } catch {
+          figure("not written", uri)
+          return nil
+        }
+      }
+      return file.absoluteString
+    }
+    if Thread.isMainThread { return render() }
+    return DispatchQueue.main.sync(execute: render)
+  }
+
+  /// A page that could not be drawn says why in the device log, once per card that asked: the
+  /// card itself shows nothing, which is the right thing on screen and no help in a bug report.
+  private static func figure(_ why: String, _ uri: String) {
+    NSLog("[RakazoPdfView] pdf-page-thumbnail %@: %@", why, uri)
+  }
+
+  /// A stable name for one file at one width: FNV-1a, so it needs no hashing framework.
+  private static func stamp(uri: String, width: Double) -> String {
+    var hash: UInt64 = 0xcbf2_9ce4_8422_2325
+    for byte in "\(uri)#\(Int(width))".utf8 {
+      hash ^= UInt64(byte)
+      hash = hash &* 0x0000_0100_0000_01b3
+    }
+    return String(hash, radix: 16)
+  }
+}
+
+/**
+ * First-page thumbnails for the documents Quick Look knows how to draw: Word, Excel, PowerPoint,
+ * Pages, Numbers and Keynote files, and their OpenDocument twins. Nothing here reads the file as
