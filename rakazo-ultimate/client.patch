+          >
+            <Text style={[styles.rejectText, { color: tokens.destructive }]}>移出长期记忆</Text>
+          </Pressable>
+        </View>
+      ) : null}
+
+      {decideError ? (
+        <Text accessibilityRole="alert" style={[styles.error, { color: tokens.destructive }]}>
+          {decideError}
+        </Text>
+      ) : null}
+
+      {(notes.data ?? []).length > 0 ? (
+        <View style={{ gap: 8 }}>
+          <Text style={[styles.sectionLabel, { color: native.secondaryLabel }]}>它自己的笔记</Text>
+          {(notes.data ?? []).map((note) => (
+            <Pressable
+              key={note.id}
+              accessibilityRole="button"
+              onPress={() => {
+                hapticSelection();
+                router.push({ pathname: "/memory-note", params: { id: note.id, botId } });
+              }}
+              style={({ pressed }) => [
+                styles.card,
+                { backgroundColor: native.groupedCell, opacity: pressed ? 0.7 : 1 },
+              ]}
+            >
+              <View style={styles.cardBody}>
+                <Text numberOfLines={1} style={[styles.cardTitle, { color: native.label }]}>
+                  {note.path}
+                </Text>
+                <Text
+                  numberOfLines={1}
+                  style={[styles.cardDetail, { color: native.secondaryLabel }]}
+                >
+                  {firstLine(note.content) || "空笔记"}
+                </Text>
+              </View>
+              <NativeSymbol
+                ios="chevron.right"
+                android="chevron-forward"
+                size={14}
+                color={native.tertiaryLabel}
+              />
+            </Pressable>
+          ))}
+        </View>
+      ) : null}
+
+      {!pending.isLoading &&
+      written.length === 0 &&
+      waiting.length === 0 &&
+      byDay.length === 0 &&
+      (notes.data ?? []).length === 0 ? (
+        <Text style={[styles.empty, { color: tokens.mutedForeground }]}>
