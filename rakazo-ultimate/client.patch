diff --git a/apps/mobile/app/(settings)/import-memory.tsx b/apps/mobile/app/(settings)/import-memory.tsx
new file mode 100644
index 000000000..7e57db05e
--- /dev/null
+++ b/apps/mobile/app/(settings)/import-memory.tsx
@@ -0,0 +1,312 @@
+import { useLingui } from "@lingui/react/macro";
+import type { MemoryDocument } from "@rakazo/contracts";
+import { MEMORY_INDEX_PATH } from "@rakazo/contracts";
+import { useTimeout } from "@rakazo/chat-ui/hooks";
+import * as Clipboard from "expo-clipboard";
+import { useLocalSearchParams } from "expo-router";
+import { useCallback, useEffect, useRef, useState } from "react";
+import {
+  ActivityIndicator,
+  ScrollView,
+  StyleSheet,
+  Text,
+  TextInput,
+  View,
+} from "react-native";
+import { SafeAreaView } from "react-native-safe-area-context";
+import { NativeActionButton } from "../../components/native-action-button";
+import { rpc } from "../../lib/api";
+import { mobileTokens } from "../../lib/appearance";
+import { hapticError, hapticSuccess } from "../../lib/haptics";
+import { native, useThemedStyles } from "../../lib/native";
+import { useSideInsets } from "../../lib/side-insets";
+import { errorText } from "../../lib/user-error";
+
+/**
+ * The prompt to paste into another assistant. It asks for what is known about the person, as
+ * plain lines, so the answer can be pasted back here unchanged.
+ */
+const EXPORT_PROMPT = [
+  "请把你知道的关于我的一切，整理成一份纯文本记忆清单：",
+  "1. 我的偏好与习惯（口味、作息、说话方式、讨厌什么）；",
+  "2. 我的工作与背景（职业、科室/岗位、常做的事、正在推进的项目）；",
+  "3. 重要的人和关系（家人、同事、合作伙伴，怎么称呼）；",
+  "4. 常用工具与账号环境；",
+  "5. 我明确说过「记住」或反复提到的事实。",
+  "",
+  "要求：只写你确实从我们的对话里知道的内容，不要推测、不要编造、不要给建议、不要客套。",
+  "每行一条，以「- 」开头，用中文书写。只输出这份清单，不加任何解释。",
+].join("\n");
+
+const BOT_MEMORY_MAX_BYTES = 4 * 1024;
+const SHARED_MEMORY_MAX_BYTES = 14 * 1024;
+
+function errorCode(error: unknown): unknown {
+  return (error as { code?: unknown } | null)?.code;
+}
+
+function byteLength(text: string): number {
+  // UTF-8 bytes without a TextEncoder: Hermes does not guarantee one.
+  let bytes = 0;
+  for (const character of text) {
+    const code = character.codePointAt(0) ?? 0;
+    bytes += code < 0x80 ? 1 : code < 0x800 ? 2 : code < 0x10000 ? 3 : 4;
+  }
+  return bytes;
+}
+
+function todayKey(): string {
+  const now = new Date();
+  const month = `${now.getMonth() + 1}`.padStart(2, "0");
+  const day = `${now.getDate()}`.padStart(2, "0");
+  return `${now.getFullYear()}-${month}-${day}`;
+}
+
+/** Brings memory that another assistant already knows into this Space's or a bot's memory. */
+export default function ImportMemoryScreen() {
+  const params = useLocalSearchParams<{ botId?: string; name?: string }>();
+  const sideInsets = useSideInsets();
+  const styles = useThemedStyles(createStyles);
+  const { t } = useLingui();
+  const botId = params.botId || undefined;
+  const targetName = botId ? (params.name ?? t`This Bot`) : t`Shared memory`;
+  const maxBytes = botId ? BOT_MEMORY_MAX_BYTES : SHARED_MEMORY_MAX_BYTES;
+
+  const [document, setDocument] = useState<MemoryDocument | null>(null);
+  const [state, setState] = useState<"loading" | "ready" | "missing" | "failed">("loading");
+  const [draft, setDraft] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [saved, setSaved] = useState<string | null>(null);
+  const [copied, setCopied] = useState(false);
+  const [attempt, setAttempt] = useState(0);
+  // The check mark on the copy button says so for a moment, then goes back.
+  useTimeout(() => setCopied(false), copied ? 1600 : null);
+
+  const read = useCallback(
+    async () =>
+      (await rpc("memory/list", botId ? { botId, scope: "bot" } : { scope: "user" })).find(
+        (entry) => entry.path === MEMORY_INDEX_PATH,
+      ),
+    [botId],
+  );
+  const readRef = useRef(read);
+  readRef.current = read;
+
+  useEffect(() => {
+    let live = true;
+    setState("loading");
+    setError(null);
+    readRef
+      .current()
+      .then((found) => {
+        if (!live) return;
+        setDocument(found ?? null);
+        setState(found ? "ready" : "missing");
+      })
+      .catch((reason) => {
+        if (!live) return;
+        setError(errorText(reason, t`Could not load memory`));
+        setState("failed");
+      });
+    return () => {
+      live = false;
+    };
+  }, [t, attempt]);
+
+  async function copyPrompt() {
+    await Clipboard.setStringAsync(EXPORT_PROMPT).catch(() => undefined);
+    hapticSuccess();
+    setCopied(true);
+  }
+
+  /**
+   * Appends the pasted lines to the index document. The existing text is kept whole and the new
+   * lines go under their own heading, so nothing already remembered is overwritten.
+   */
+  async function importMemory() {
+    const addition = draft.trim();
+    if (!addition || busy) return;
+    setBusy(true);
+    setError(null);
+    setSaved(null);
+    try {
+      for (let round = 0; round < 2; round += 1) {
+        // Read again for the second round: a save that raced this one changed the revision.
+        const current = round === 0 && document ? document : await read();
+        if (!current) {
+          setState("missing");
+          throw new Error(t`Could not load memory`);
+        }
+        const existing = current.content.trimEnd();
+        const section = `## 从其他 AI 导入（${todayKey()}）`;
+        const next = `${existing ? `${existing}\n\n` : ""}${section}\n${addition}`;
+        if (byteLength(next) > maxBytes) {
+          const limit = botId
+            ? "这个 Bot 的记忆满了（上限 4 KB）。先去 MEMORY.md 合并或删掉几行，再回来导入。"
+            : "共享记忆满了（上限 14 KB）。先去 MEMORY.md 合并或删掉几行，再回来导入。";
+          throw new Error(limit);
+        }
+        try {
+          const updated = await rpc("memory/update", {
+            documentId: current.id,
+            content: next,
+            expectedRevision: current.revision,
+          });
+          setDocument(updated);
+          setDraft("");
+          setSaved(
+            botId
+              ? `已存入「${targetName}」的记忆，原有内容都保留了。`
+              : "已存入整个 Space 的共享记忆，原有内容都保留了。",
+          );
+          hapticSuccess();
+          return;
+        } catch (reason) {
+          // Someone else saved in between: read the live text once more and append to that.
+          if (errorCode(reason) === "CONFLICT" && round === 0) continue;
+          throw reason;
+        }
+      }
+    } catch (reason) {
+      hapticError();
+      setError(errorText(reason, t`Could not save`));
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  const canImport = state === "ready" && draft.trim().length > 0 && !busy;
+
+  return (
+    <SafeAreaView edges={["bottom"]} style={styles.screen}>
+      <ScrollView
+        style={sideInsets}
+        contentContainerStyle={styles.content}
+        contentInsetAdjustmentBehavior="automatic"
+        keyboardShouldPersistTaps="handled"
+      >
+        <Text style={styles.lead}>
+          先把下面这段提示词发给 ChatGPT、Claude、豆包、Grok 或任何了解你的 AI，让它把你的偏好、习惯、工作背景和重要事实整理成纯文本；再把它的回答整段粘贴到下面，就能存进{botId ? `「${targetName}」的记忆` : "整个 Space 的共享记忆"}。
+        </Text>
+
+        <View style={styles.card}>
+          <Text accessibilityRole="header" style={styles.cardTitle}>
+            第一步 · 复制提示词
+          </Text>
+          <Text selectable style={styles.prompt}>
+            {EXPORT_PROMPT}
+          </Text>
+          <NativeActionButton
+            fill={false}
+            label={copied ? "已复制" : "复制提示词"}
+            onPress={() => void copyPrompt()}
+            prominence={copied ? "plain" : "secondary"}
+          />
+        </View>
+
+        <View style={styles.card}>
+          <Text accessibilityRole="header" style={styles.cardTitle}>
+            第二步 · 粘贴对方的回答
+          </Text>
+          {state === "loading" ? (
+            <ActivityIndicator color={native.secondaryLabel} accessibilityLabel={t`Loading…`} />
+          ) : null}
+          {state === "missing" ? (
+            <Text style={styles.secondary}>
+              这块记忆还没有记忆档案（MEMORY.md）。先让{botId ? "这个 Bot" : "任意一个 Bot"}记住一句话，生成了档案再回来导入。
+            </Text>
+          ) : null}
+          {state === "failed" ? (
+            <NativeActionButton
+              fill={false}
+              label={t`Retry`}
+              onPress={() => setAttempt((count) => count + 1)}
+              prominence="secondary"
+            />
+          ) : null}
+          {state === "ready" ? (
+            <>
+              <TextInput
+                value={draft}
+                onChangeText={(next) => {
+                  setDraft(next);
+                  setSaved(null);
+                  setError(null);
+                }}
+                accessibilityLabel="粘贴其他 AI 导出的记忆"
+                editable={!busy}
+                multiline
+                placeholder="- 例如：我是龙门县人民医院 ICU 医生，按 4 天一轮值班。"
+                placeholderTextColor={native.tertiaryLabel}
+                textAlignVertical="top"
+                style={styles.editor}
+              />
+              <Text style={styles.meta}>
+                {`已有 ${byteLength(document?.content ?? "")} 字 · 上限 ${maxBytes} 字 · 导入只会在末尾追加，不会覆盖已有记忆`}
+              </Text>
+              <NativeActionButton
+                disabled={!canImport}
+                label={busy ? "导入中…" : "导入到记忆"}
+                onPress={() => void importMemory()}
+                prominence={canImport ? "primary" : "plain"}
+              />
+            </>
+          ) : null}
+          {saved ? (
+            <Text accessibilityRole="alert" style={styles.saved}>
+              {saved}
+            </Text>
+          ) : null}
+          {error ? (
+            <Text accessibilityRole="alert" style={styles.error}>
+              {error}
+            </Text>
+          ) : null}
+        </View>
+
+        <Text style={styles.footnote}>
+          导入的内容会带上日期单独成段；想改动或删掉，回到「记忆」里打开 MEMORY.md 就能改。
+        </Text>
+      </ScrollView>
+    </SafeAreaView>
+  );
+}
+
+function createStyles() {
+  return StyleSheet.create({
+    screen: { flex: 1, backgroundColor: native.groupedPage },
+    content: { padding: 20, gap: 16, paddingBottom: 40 },
+    lead: { color: native.secondaryLabel, fontSize: 14, lineHeight: 20 },
+    card: {
+      borderRadius: 18,
+      borderCurve: "continuous",
+      backgroundColor: native.groupedCell,
+      padding: 16,
+      gap: 12,
+    },
+    cardTitle: { color: native.label, fontSize: 15, fontWeight: "600" },
+    prompt: {
+      color: native.secondaryLabel,
+      fontSize: 14,
