+  function MockView(props: { children?: ReactNode; testID?: string }) {
+    return createElement("div", { "data-testid": props.testID }, props.children);
+  }
+
+  function MockText(props: { children?: ReactNode; accessibilityRole?: string; style?: unknown }) {
+    return createElement(
+      "span",
+      { role: props.accessibilityRole, "data-style": JSON.stringify({}) },
+      props.children,
+    );
+  }
+
+  function MockPressable(props: {
+    children?: ReactNode;
+    onPress?: () => void;
+    disabled?: boolean;
+    accessibilityLabel?: string;
+    accessibilityState?: { disabled?: boolean; selected?: boolean };
+    testID?: string;
+  }) {
+    const disabled = Boolean(props.disabled || props.accessibilityState?.disabled);
+    return createElement(
+      "button",
+      {
+        type: "button",
+        disabled,
+        "aria-label": props.accessibilityLabel,
+        "aria-selected": props.accessibilityState?.selected ? "true" : "false",
+        "data-testid": props.testID,
+        onClick: () => {
+          if (!disabled) props.onPress?.();
+        },
+      },
+      props.children,
+    );
+  }
+
+  return {
+    ActivityIndicator: () => null,
+    Alert: { alert },
+    Pressable: MockPressable,
+    StyleSheet: { create: <T,>(styles: T) => styles },
+    Text: MockText,
+    View: MockView,
+    useWindowDimensions: () => ({ width: 393, height: 852, scale: 1, fontScale: 1 }),
+  };
+});
+
+vi.mock("./api-server", () => ({}));
+vi.mock("./api-auth", () => ({}));
+vi.mock("./api-live", () => ({}));
+vi.mock("./api", () => ({ rpc }));
+vi.mock("./haptics", () => ({
+  hapticError: vi.fn(),
+  hapticSelection,
+  hapticSuccess: vi.fn(),
+}));
+
+vi.mock("../components/glass-icon-button", async () => {
+  const { Pressable } = await import("react-native");
+  return { GlassIconButton: Pressable };
+});
+
+vi.mock("./native", () => ({
+  native: { fill: "fill", fillPressed: "fill-pressed" },
+  useMobileTokens: () => ({
+    background: "background",
+    border: "border",
+    card: "card",
+    foreground: "foreground",
+    mutedForeground: "muted",
+    destructive: "destructive",
+  }),
+}));
+
+vi.mock("../components/native-symbol", () => ({
+  NativeSymbol: () => null,
+}));
+
+import { answerSheetText, ChoiceCard } from "../components/ChoiceCard";
+
+type ChoiceBlock = Extract<MessageBlock, { kind: "choice" }>;
+
+/** Two questions, the first single-choice, the second one that takes two picks. */
+const quiz: ChoiceBlock = {
+  kind: "choice",
+  question: "重症医学 2 题",
+  options: [],
+  questions: [
+    {
+      question: "受体部分激动药的内在活性 α 等于",
+      options: [
+        { id: "a", letter: "A", label: "1" },
+        { id: "b", letter: "B", label: "0" },
+        { id: "c", letter: "C", label: "0~1" },
+      ],
+    },
+    {
+      id: "q2",
+      question: "下列哪些是机械通气的适应证",
+      multiple: true,
+      options: [
+        { id: "d", letter: "A", label: "呼吸衰竭" },
+        { id: "e", letter: "B", label: "气道保护" },
+      ],
+    },
+  ],
+};
+
+function button(container: HTMLElement, label: string) {
+  const element = container.querySelector<HTMLButtonElement>(`[aria-label="${label}"]`);
+  if (!element) throw new Error(`missing button ${label}`);
+  return element;
+}
+
+describe("ChoiceCard question sets", () => {
+  let root: Root | undefined;
+  let container: HTMLDivElement | undefined;
+
+  beforeEach(() => {
+    rpc.mockReset();
+    alert.mockReset();
+    hapticSelection.mockReset();
+    vi.stubGlobal("IS_REACT_ACT_ENVIRONMENT", true);
+  });
+
+  afterEach(() => {
+    act(() => {
+      root?.unmount();
+    });
+    container?.remove();
+    root = undefined;
+    container = undefined;
+  });
+
+  function render(block: ChoiceBlock = quiz) {
+    if (!container) {
+      container = document.createElement("div");
+      document.body.append(container);
+      root = createRoot(container);
+    }
+    act(() => {
+      root?.render(<ChoiceCard botId="bot-1" block={block} />);
+    });
+    return container;
+  }
+
+  it("shows the first question of the set with its place in it", () => {
+    const view = render();
+    expect(view.textContent).toContain("1 / 2");
+    expect(view.textContent).toContain("受体部分激动药的内在活性 α 等于");
+    expect(view.textContent).not.toContain("下列哪些是机械通气的适应证");
+  });
+
+  it("keeps a pick on the phone, with a tap of feedback, and pages on", async () => {
