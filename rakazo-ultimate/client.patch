+  });
+
+  it("says why a switch is not simply on", () => {
+    const on = { ...PHONE_CONNECTORS_OFF, alarms: true };
+    expect(phoneConnectorStatus("alarms", on, "granted")).toBe("on");
+    expect(phoneConnectorStatus("alarms", on, "denied")).toBe("blocked");
+    expect(phoneConnectorStatus("alarms", PHONE_CONNECTORS_OFF, "granted")).toBe("off");
+    expect(phoneConnectorStatus("alarms", on, "unavailable")).toBe("unavailable");
+    expect(phoneConnectorNote("alarms", on, "denied")).toContain("系统没有允许");
+    expect(phoneConnectorNote("alarms", PHONE_CONNECTORS_OFF, "denied")).toBeUndefined();
+    expect(
+      phoneConnectorNote("location", { ...PHONE_CONNECTORS_OFF, location: true }, "unavailable"),
+    ).toContain("不能提供");
+  });
+});
+
+describe("the native module", () => {
+  it("is absent in a build without it", async () => {
+    expect(phoneConnectorsNative()).toBeNull();
+    const answer = await runPhoneDeviceMethod(
+      "phoneAlarmList",
+      {},
+      {
+        state: { ...PHONE_CONNECTORS_OFF, alarms: true },
+        native: null,
+        permissionOf: () => "granted",
+      },
+    );
+    expect(answer).toEqual({ error: "unavailable" });
+  });
+
+  it("passes the method and its arguments through as JSON", async () => {
+    const calls: { method: string; argsJson: string }[] = [];
+    native.module = {
+      permission: async () => "granted",
+      requestPermission: async () => "granted",
+      run: async (method, argsJson) => {
+        calls.push({ method, argsJson });
+        return '{"value":[{"id":"a1"}]}';
+      },
+    };
+    const module = phoneConnectorsNative();
+    expect(module).not.toBeNull();
+    const answer = await module?.run("phoneAlarmList", { limit: 3 });
+    expect(calls).toEqual([{ method: "phoneAlarmList", argsJson: '{"limit":3}' }]);
+    expect(phoneDeviceAnswer(answer ?? "")).toEqual({ value: [{ id: "a1" }] });
+  });
+});
+
+describe("what the phone answers the server", () => {
+  it("refuses a connector the person switched off", async () => {
+    native.module = { run: async () => '{"value":[]}' };
+    const answer = await runPhoneDeviceMethod(
+      "phoneCalendarList",
+      {},
+      {
+        state: PHONE_CONNECTORS_OFF,
+        native: phoneConnectorsNative(),
+        permissionOf: () => "granted",
+      },
+    );
+    expect(answer).toEqual({ error: "switch_off" });
+  });
+
+  it("refuses when iOS never granted the permission, without calling the framework", async () => {
+    native.module = { run: async () => '{"value":[]}' };
+    const answer = await runPhoneDeviceMethod(
+      "phoneContactSearch",
+      { query: "张" },
+      {
+        state: { ...PHONE_CONNECTORS_OFF, contacts: true },
+        native: phoneConnectorsNative(),
+        permissionOf: () => "denied",
+      },
+    );
+    expect(answer).toEqual({ error: "permission_denied" });
+  });
+
+  it("answers the framework's own value when the switch is on and iOS agreed", async () => {
+    native.calls.push({ method: "sent", args: {} });
+    native.module = {
+      run: async (method) =>
+        method === "phoneLocation" ? '{"value":{"latitude":23.1}}' : '{"error":"not_found"}',
+    };
+    const answer = await runPhoneDeviceMethod(
+      "phoneLocation",
+      {},
+      {
+        state: { ...PHONE_CONNECTORS_OFF, location: true },
+        native: phoneConnectorsNative(),
+        permissionOf: () => "granted",
+      },
+    );
+    expect(answer).toEqual({ value: { latitude: 23.1 } });
+  });
+
+  it("reads a refusal the framework wrote, and an unreadable answer as unavailable", () => {
+    expect(phoneDeviceAnswer('{"error":"permission_denied"}')).toEqual({
+      error: "permission_denied",
+    });
+    expect(phoneDeviceAnswer("not json")).toEqual({ error: "unavailable" });
+    expect(phoneDeviceAnswer('{"error":"something-else"}')).toEqual({ value: undefined });
+  });
+
+  it("says each refusal in words the reader can act on", () => {
+    expect(phoneDeviceErrorMessage("switch_off", "alarms")).toContain("设置 → 集成");
+    expect(phoneDeviceErrorMessage("permission_denied", "calendar")).toContain("系统");
+    expect(phoneDeviceErrorMessage("unavailable", "reminders")).toContain("无法提供");
+    expect(phoneDeviceErrorMessage("not_found", "contacts")).toContain("没有找到");
+    expect(phoneDeviceErrorMessage("invalid", "location")).toContain("格式");
+  });
+
+  it("gives every method its switch; phoneStatus belongs to all five", () => {
+    expect(phoneConnectorForMethod("phoneAlarmSet")).toBe("alarms");
+    expect(phoneConnectorForMethod("phoneCalendarUpdate")).toBe("calendar");
+    expect(phoneConnectorForMethod("phoneReminderComplete")).toBe("reminders");
+    expect(phoneConnectorForMethod("phoneContactSearch")).toBe("contacts");
+    expect(phoneConnectorForMethod("phoneLocation")).toBe("location");
+    expect(phoneConnectorForMethod("phoneStatus")).toBeUndefined();
+  });
+});
+
+describe("pairing this phone", () => {
+  it("pairs once, keeps the token, and reuses it", async () => {
+    fetchMock.mockResolvedValue(
+      new Response(JSON.stringify({ deviceId: "dev-1", token: "tok-1" }), { status: 201 }),
+    );
+    const first = await pairPhoneDevice(fetchMock as unknown as typeof fetch);
+    expect(first).toEqual({
+      ok: true,
+      credential: { deviceId: "dev-1", token: "tok-1", name: "这台 iPhone" },
+    });
+    expect(fetchMock).toHaveBeenCalledTimes(1);
+    const [url, init] = fetchMock.mock.calls[0] as [string, RequestInit];
+    expect(url).toBe("https://rakazo.163ll.com/api/devices/pair");
+    expect(init.method).toBe("POST");
+    expect((init.headers as Record<string, string>).authorization).toBe("Bearer session-token");
+    expect(JSON.parse(String(init.body))).toEqual({ name: "这台 iPhone", platform: "ios" });
+
+    const again = await pairPhoneDevice(fetchMock as unknown as typeof fetch);
+    expect(again.ok).toBe(true);
+    expect(fetchMock).toHaveBeenCalledTimes(1);
+  });
+
+  it("says plainly when the server does not know an iPhone yet", async () => {
+    fetchMock.mockResolvedValue(new Response("{}", { status: 400 }));
+    const result = await pairPhoneDevice(fetchMock as unknown as typeof fetch);
+    expect(result.ok).toBe(false);
+    expect(result.ok === false && result.reason).toContain("还不认识 iPhone");
+  });
+
+  it("does not pretend a broken pairing worked", async () => {
+    fetchMock.mockRejectedValue(new Error("offline"));
+    const result = await pairPhoneDevice(fetchMock as unknown as typeof fetch);
+    expect(result).toEqual({ ok: false, reason: "连不上服务端，配对没有完成。" });
+  });
+});
+
+describe("the server's copy of the switches", () => {
+  it("puts the five switches with the session", async () => {
+    fetchMock.mockResolvedValue(new Response("{}", { status: 200 }));
+    const state = { ...PHONE_CONNECTORS_OFF, calendar: true };
+    expect(await pushPhoneConnectorState(state, fetchMock as unknown as typeof fetch)).toBe(true);
+    const [url, init] = fetchMock.mock.calls[0] as [string, RequestInit];
+    expect(url).toBe("https://rakazo.163ll.com/api/devices/phone");
+    expect(init.method).toBe("PUT");
+    expect(JSON.parse(String(init.body))).toEqual({ connectors: state });
+  });
+
+  it("reports a refused sync rather than pretending", async () => {
+    fetchMock.mockResolvedValue(new Response("{}", { status: 500 }));
+    expect(
+      await pushPhoneConnectorState(PHONE_CONNECTORS_OFF, fetchMock as unknown as typeof fetch),
+    ).toBe(false);
+  });
+});
diff --git a/apps/mobile/lib/phone-connectors.ts b/apps/mobile/lib/phone-connectors.ts
new file mode 100644
index 0000000..f258189
--- /dev/null
+++ b/apps/mobile/lib/phone-connectors.ts
@@ -0,0 +1,363 @@
+import type {
+  PhoneConnectorKind,
+  PhoneConnectorState,
+  PhoneDeviceError,
+  PhoneDeviceMethod,
+  PhonePermission,
+} from "@rakazo/contracts";
+import {
+  PHONE_CONNECTOR_INFO,
+  PHONE_CONNECTOR_KINDS,
+  PHONE_CONNECTORS_OFF,
+  phoneConnectorState,
+} from "@rakazo/contracts";
+import { requireOptionalNativeModule } from "expo-modules-core";
+import * as SecureStore from "expo-secure-store";
+import { currentApiBase } from "./api";
+import { loadSessionToken } from "./session";
+
+/**
+ * The iPhone's own five connectors, as the app keeps them.
+ *
+ * The switches live here and on the server (`/api/devices/phone`): here so the screen paints at
+ * once, there so a bot asked about alarms can say 「这一项没开」 even while the phone is away. iOS's
+ * own permission is a third state, asked for the first time a switch goes on.
+ */
+
+const PHONE_CONNECTOR_SYMBOLS: Record<PhoneConnectorKind, string> = {
+  alarms: "alarm",
+  calendar: "calendar",
+  reminders: "checklist",
+  contacts: "person.crop.circle",
+  location: "location",
+};
+
+/** The five rows of the settings screen, in the order a person thinks of them. */
+export const PHONE_CONNECTOR_ROWS: readonly {
+  kind: PhoneConnectorKind;
+  name: string;
+  hint: string;
+  permission: string;
+  symbol: string;
+}[] = PHONE_CONNECTOR_KINDS.map((kind) => ({
+  kind,
+  name: PHONE_CONNECTOR_INFO[kind].name,
+  hint: PHONE_CONNECTOR_INFO[kind].hint,
+  permission: PHONE_CONNECTOR_INFO[kind].permission,
+  symbol: PHONE_CONNECTOR_SYMBOLS[kind],
+}));
+
+/** Where the phone keeps its five switches on this handset. */
+export const PHONE_CONNECTORS_KEY = "rakazo.phone-connectors";
+
+/** Where the phone keeps the token the server issued it at pairing. */
+export const PHONE_DEVICE_KEY = "rakazo.phone-device";
+
+export type PhoneDeviceCredential = { deviceId: string; token: string; name: string };
+
+/** True while at least one connector is on: the only time the phone keeps its socket open. */
+export function anyPhoneConnectorOn(state: PhoneConnectorState): boolean {
+  return PHONE_CONNECTOR_KINDS.some((kind) => state[kind] === true);
+}
+
+/** How a switch reads on the screen: on, off, on but refused by iOS, or not offered here. */
+export function phoneConnectorStatus(
+  kind: PhoneConnectorKind,
+  state: PhoneConnectorState,
+  permission: PhonePermission | undefined,
+): "on" | "off" | "blocked" | "unavailable" {
+  if (permission === "unavailable") return "unavailable";
+  if (state[kind] !== true) return "off";
+  if (permission === "denied") return "blocked";
+  return "on";
+}
+
+/** What the row's second line says when a switch cannot simply be on. */
+export function phoneConnectorNote(
+  kind: PhoneConnectorKind,
+  state: PhoneConnectorState,
+  permission: PhonePermission | undefined,
+): string | undefined {
+  const info = PHONE_CONNECTOR_INFO[kind];
+  if (state[kind] !== true) return undefined;
+  if (permission === "denied")
+    return `系统没有允许 Bot 使用${info.permission}，请到 iPhone 设置里打开。`;
+  if (permission === "unavailable") return `这台 iPhone 或系统版本不能提供这项能力。`;
+  if (permission === "undetermined") return `正在等待系统询问${info.permission}…`;
+  return undefined;
+}
+
+/** The five switches as last saved on this handset; a missing or unreadable record is all off. */
+export async function loadPhoneConnectorState(): Promise<PhoneConnectorState> {
+  try {
+    const stored = await SecureStore.getItemAsync(PHONE_CONNECTORS_KEY);
+    if (!stored) return { ...PHONE_CONNECTORS_OFF };
+    return phoneConnectorState(JSON.parse(stored));
+  } catch {
+    return { ...PHONE_CONNECTORS_OFF };
+  }
+}
+
+export async function savePhoneConnectorState(state: PhoneConnectorState): Promise<void> {
+  try {
+    await SecureStore.setItemAsync(PHONE_CONNECTORS_KEY, JSON.stringify(state));
+  } catch {
+    // SecureStore unavailable in some test / web hosts: the screen still holds the choice.
+  }
+}
+
+/** One switch changed, with the other four as they were. */
+export function phoneConnectorToggled(
+  state: PhoneConnectorState,
+  kind: PhoneConnectorKind,
+  on: boolean,
+): PhoneConnectorState {
+  return { ...state, [kind]: on };
+}
+
+export async function loadPhoneDeviceCredential(): Promise<PhoneDeviceCredential | null> {
+  try {
+    const stored = await SecureStore.getItemAsync(PHONE_DEVICE_KEY);
+    if (!stored) return null;
+    const parsed = JSON.parse(stored) as Partial<PhoneDeviceCredential>;
+    if (typeof parsed.deviceId !== "string" || typeof parsed.token !== "string") return null;
+    return { deviceId: parsed.deviceId, token: parsed.token, name: parsed.name ?? "iPhone" };
+  } catch {
+    return null;
+  }
+}
+
+async function savePhoneDeviceCredential(credential: PhoneDeviceCredential): Promise<void> {
+  try {
+    await SecureStore.setItemAsync(PHONE_DEVICE_KEY, JSON.stringify(credential));
+  } catch {
+    // The socket still works for this launch; the next one pairs again.
+  }
+}
+
+export async function forgetPhoneDeviceCredential(): Promise<void> {
+  try {
+    await SecureStore.deleteItemAsync(PHONE_DEVICE_KEY);
+  } catch {
+    // Nothing stored is the same outcome.
+  }
+}
+
+/** The name this iPhone pairs under: the handset's own, so a second phone is told apart. */
+export function phoneDeviceName(deviceName: string | undefined): string {
+  const trimmed = deviceName?.trim();
+  return trimmed ? trimmed.slice(0, 128) : "这台 iPhone";
+}
+
+export type PhonePairing =
+  | { ok: true; credential: PhoneDeviceCredential }
+  | { ok: false; reason: string };
+
+/**
+ * Pairs this phone with the server, the way the desktop computer pairs: a JSON POST with the
+ * signed-in session, answered with the token the socket then carries. A server that does not know
+ * `platform: "ios"` answers 400, and that is reported as such rather than retried.
+ */
+export async function pairPhoneDevice(fetchImpl: typeof fetch = fetch): Promise<PhonePairing> {
+  const existing = await loadPhoneDeviceCredential();
+  if (existing) return { ok: true, credential: existing };
+  const token = await loadSessionToken();
+  if (!token) return { ok: false, reason: "还没有登录，先在 App 里登录再打开这些开关。" };
+  let response: Response;
+  try {
+    response = await fetchImpl(`${currentApiBase()}/api/devices/pair`, {
+      method: "POST",
+      headers: {
+        "content-type": "application/json",
+        authorization: `Bearer ${token}`,
+      },
+      body: JSON.stringify({ name: phoneDeviceName(undefined), platform: "ios" }),
+    });
+  } catch {
+    return { ok: false, reason: "连不上服务端，配对没有完成。" };
+  }
+  if (!response.ok) {
+    return {
+      ok: false,
+      reason:
+        response.status === 400
+          ? "这个服务端还不认识 iPhone，等它升级后再打开这些开关。"
+          : `配对没有完成（${response.status}）。`,
+    };
+  }
+  const body = (await response.json().catch(() => null)) as {
+    deviceId?: unknown;
+    token?: unknown;
+  } | null;
+  if (typeof body?.deviceId !== "string" || typeof body.token !== "string")
+    return { ok: false, reason: "服务端的配对回执不完整，请稍后再试。" };
+  const credential: PhoneDeviceCredential = {
+    deviceId: body.deviceId,
+    token: body.token,
+    name: phoneDeviceName(undefined),
+  };
+  await savePhoneDeviceCredential(credential);
+  return { ok: true, credential };
+}
+
+/** The server's stored switches, for a fresh install of the same account. */
+export async function fetchPhoneConnectorState(
+  fetchImpl: typeof fetch = fetch,
+): Promise<PhoneConnectorState | null> {
+  const token = await loadSessionToken();
+  if (!token) return null;
+  try {
+    const response = await fetchImpl(`${currentApiBase()}/api/devices/phone`, {
+      headers: { authorization: `Bearer ${token}` },
+    });
+    if (!response.ok) return null;
+    const body = (await response.json()) as { connectors?: unknown };
+    return phoneConnectorState(body?.connectors);
+  } catch {
+    return null;
+  }
+}
+
+/** Tells the server which switches are on; a failure leaves the phone's own copy as it is. */
+export async function pushPhoneConnectorState(
+  state: PhoneConnectorState,
+  fetchImpl: typeof fetch = fetch,
+): Promise<boolean> {
+  const token = await loadSessionToken();
+  if (!token) return false;
+  try {
+    const response = await fetchImpl(`${currentApiBase()}/api/devices/phone`, {
+      method: "PUT",
+      headers: { "content-type": "application/json", authorization: `Bearer ${token}` },
+      body: JSON.stringify({ connectors: state }),
+    });
+    return response.ok;
+  } catch {
+    return false;
+  }
+}
+
+/** What this binary can do, per connector, without asking iOS for anything. */
+export type NativePhoneConnectors = {
+  permission(kind: PhoneConnectorKind): Promise<PhonePermission>;
+  requestPermission(kind: PhoneConnectorKind): Promise<PhonePermission>;
+  /** Runs one phone method; resolves with the JSON the native side answered. */
+  run(method: PhoneDeviceMethod, args: Record<string, unknown>): Promise<string>;
+};
+
+type NativeModule = {
+  permission?: (kind: string) => Promise<string>;
+  requestPermission?: (kind: string) => Promise<string>;
+  run?: (method: string, argsJson: string) => Promise<string>;
+};
+
+/**
+ * The native module, or null in a build (or a test, or the web) that has no phone connectors.
+ */
+export function phoneConnectorsNative(): NativePhoneConnectors | null {
+  const module = requireOptionalNativeModule<NativeModule>("RakazoConnectors");
+  if (!module?.run) return null;
+  const parse = (value: unknown): PhonePermission =>
+    value === "granted" || value === "denied" || value === "undetermined" || value === "unavailable"
+      ? value
+      : "unavailable";
+  return {
+    async permission(kind) {
+      try {
+        return parse(await module.permission?.(kind));
+      } catch {
+        return "unavailable";
+      }
+    },
+    async requestPermission(kind) {
+      try {
+        return parse(await module.requestPermission?.(kind));
+      } catch {
+        return "denied";
+      }
+    },
+    async run(method, args) {
+      return module.run?.(method, JSON.stringify(args)) ?? '{"error":"unavailable"}';
+    },
+  };
+}
+
+/** What a bot is told when this connector cannot answer, in words the reader can act on. */
+export function phoneDeviceErrorMessage(
+  error: PhoneDeviceError,
+  kind?: PhoneConnectorKind,
+): string {
+  const name = kind ? PHONE_CONNECTOR_INFO[kind].name : "这一项";
+  switch (error) {
+    case "switch_off":
+      return `「${name}」没有打开，先在 App 的 设置 → 集成 → 这台 iPhone 里打开。`;
+    case "permission_denied":
+      return `iPhone 没有允许 Bot 使用「${name}」，请到系统的设置里打开这项权限。`;
+    case "unavailable":
+      return `这台 iPhone 现在无法提供「${name}」（系统版本或设备不支持）。`;
+    case "not_found":
+      return `没有找到对应的「${name}」内容。`;
+    case "invalid":
+      return `「${name}」这次的要求不完整或格式不对，换个说法再试。`;
+    default:
+      return `「${name}」没有办成。`;
+  }
+}
+
+export type PhoneDeviceAnswer = { value?: unknown; error?: PhoneDeviceError };
+
+/** Reads the native side's answer: a value, or one of the refused words. */
+export function phoneDeviceAnswer(json: string): PhoneDeviceAnswer {
+  try {
+    const parsed = JSON.parse(json) as { value?: unknown; error?: unknown };
+    if (typeof parsed.error === "string" && isPhoneDeviceError(parsed.error))
+      return { error: parsed.error };
+    return { value: parsed.value };
+  } catch {
+    return { error: "unavailable" };
+  }
+}
+
+function isPhoneDeviceError(value: string): value is PhoneDeviceError {
+  return (
+    value === "switch_off" ||
+    value === "permission_denied" ||
+    value === "unavailable" ||
+    value === "not_found" ||
+    value === "invalid"
+  );
+}
+
+/**
+ * Runs one phone method for the server, refusing anything the person switched off here. The
+ * switch is checked on the phone, not trusted from the request: a server that still has the old
+ * state cannot make the phone read the calendar.
+ */
+export async function runPhoneDeviceMethod(
+  method: PhoneDeviceMethod,
+  args: Record<string, unknown>,
+  deps: {
+    state: PhoneConnectorState;
+    native: NativePhoneConnectors | null;
+    permissionOf: (kind: PhoneConnectorKind) => PhonePermission;
+  },
+): Promise<PhoneDeviceAnswer> {
+  const kind = phoneConnectorForMethod(method);
+  if (kind && deps.state[kind] !== true) return { error: "switch_off" };
+  if (kind && deps.permissionOf(kind) !== "granted") {
+    const permission = deps.permissionOf(kind);
+    return { error: permission === "unavailable" ? "unavailable" : "permission_denied" };
+  }
+  if (!deps.native) return { error: "unavailable" };
+  return phoneDeviceAnswer(await deps.native.run(method, args));
+}
+
+/** The switch a method answers to; `phoneStatus` belongs to all five at once. */
+export function phoneConnectorForMethod(method: string): PhoneConnectorKind | undefined {
+  if (method.startsWith("phoneAlarm")) return "alarms";
+  if (method.startsWith("phoneCalendar")) return "calendar";
+  if (method.startsWith("phoneReminder")) return "reminders";
+  if (method.startsWith("phoneContact")) return "contacts";
+  if (method === "phoneLocation") return "location";
+  return undefined;
+}
