diff --git a/apps/mobile/components/composer-attach-tray.tsx b/apps/mobile/components/composer-attach-tray.tsx
new file mode 100644
index 000000000..b798d1ff3
--- /dev/null
+++ b/apps/mobile/components/composer-attach-tray.tsx
@@ -0,0 +1,236 @@
+import { ph } from "@lingui/core/macro";
+import { useLingui } from "@lingui/react/macro";
+import { useEffect, useState } from "react";
+import { Image, Pressable, ScrollView, StyleSheet, Text, View } from "react-native";
+import { Gesture, GestureDetector } from "react-native-gesture-handler";
+import Animated, { runOnJS, useAnimatedStyle, useSharedValue, withTiming } from "react-native-reanimated";
+import { mobileTokens } from "../lib/appearance";
+import { hapticSelection } from "../lib/haptics";
+import {
+  getKeepOriginalImages,
+  loadKeepOriginalImages,
+  setKeepOriginalImages,
+  subscribeKeepOriginalImages,
+} from "../lib/image-send-preference";
+import { ComposerAttachLayout } from "../lib/image-stack-layout";
+import type { ImageCardUpload } from "./image-card-stack";
+
+export type ComposerTrayItem = {
+  id: string;
+  name: string;
+  previewUri?: string;
+  mimeType?: string;
+  upload?: ImageCardUpload;
+};
+
+function isImageItem(item: ComposerTrayItem): boolean {
+  const mime = item.mimeType ?? "";
+  if (mime.startsWith("image/")) return true;
+  return /\.(jpg|jpeg|png|gif|webp|heic|heif)$/i.test(item.name);
+}
+
+export function ComposerAttachTray({
+  attachments,
+  onRemove,
+  onReorder,
+  onRetry,
+}: {
+  attachments: readonly ComposerTrayItem[];
+  onRemove: (id: string) => void;
+  onReorder: (from: number, to: number) => void;
+  onRetry?: (id: string) => void;
+}) {
+  const tokens = mobileTokens();
+  const { t } = useLingui();
+  const [keepOriginal, setKeepOriginal] = useState(getKeepOriginalImages);
+  useEffect(() => {
+    void loadKeepOriginalImages();
+    return subscribeKeepOriginalImages(() => setKeepOriginal(getKeepOriginalImages()));
+  }, []);
+
+  if (attachments.length === 0) return null;
+
+  const move = (from: number, to: number) => {
+    if (to < 0 || to >= attachments.length || from === to) return;
+    hapticSelection();
+    onReorder(from, to);
+  };
+
+  return (
+    <View testID="composerAttachTray">
+      <ScrollView
+        horizontal
+        showsHorizontalScrollIndicator={false}
+        style={{ marginTop: ComposerAttachLayout.closeOverhang }}
+        contentContainerStyle={styles.strip}
+      >
+        {attachments.map((item, index) => (
+          <TrayCard
+            key={item.id}
+            item={item}
+            index={index}
+            count={attachments.length}
+            onRemove={onRemove}
+            onMove={move}
+            onRetry={onRetry}
+          />
+        ))}
+      </ScrollView>
+      {attachments.some(isImageItem) ? (
+        <Pressable
+          testID="keepOriginalToggle"
+          accessibilityRole="switch"
+          accessibilityState={{ checked: keepOriginal }}
+          accessibilityLabel={
+            keepOriginal ? "保留原图（之后选的图不缩小，HEIC 仍转 JPEG）" : "自动压缩大图（长边 1600，HEIC 转 JPEG）"
+          }
+          onPress={() => void setKeepOriginalImages(!keepOriginal)}
+          style={styles.toggle}
+        >
+          <Text style={[styles.toggleLabel, { color: tokens.mutedForeground }]}>
+            {keepOriginal ? "保留原图（之后选的图不缩小）" : "自动压缩大图（长边 1600）"}
+          </Text>
+        </Pressable>
+      ) : null}
+    </View>
+  );
+}
+
+function TrayCard({
+  item,
+  index,
+  count,
+  onRemove,
+  onMove,
+  onRetry,
+}: {
+  item: ComposerTrayItem;
+  index: number;
+  count: number;
+  onRemove: (id: string) => void;
+  onMove: (from: number, to: number) => void;
+  onRetry?: (id: string) => void;
+}) {
+  const tokens = mobileTokens();
+  const { t } = useLingui();
+  const translateX = useSharedValue(0);
+  const dragging = useSharedValue(0);
+  const shift = ComposerAttachLayout.thumbSize.width + ComposerAttachLayout.thumbSpacing;
+
+  const finishDrag = (translation: number) => {
+    const steps = Math.round(translation / shift);
+    const to = Math.max(0, Math.min(count - 1, index + steps));
+    translateX.value = withTiming(0, { duration: 160 });
+    dragging.value = 0;
+    if (to !== index) onMove(index, to);
+  };
+
+  const drag = Gesture.Pan()
+    .activateAfterLongPress(200)
+    .onStart(() => {
+      dragging.value = 1;
+    })
+    .onUpdate((event) => {
+      translateX.value = event.translationX;
+    })
+    .onFinalize((event) => {
+      runOnJS(finishDrag)(event.translationX);
+    });
+
+  const style = useAnimatedStyle(() => ({
+    zIndex: dragging.value ? 2 : 0,
+    opacity: dragging.value ? 0.92 : 1,
+    transform: [{ translateX: translateX.value }, { scale: dragging.value ? 1.04 : 1 }],
+  }));
+
+  const upload = item.upload ?? { kind: "done" as const };
+  const size = ComposerAttachLayout.thumbSize;
+
+  return (
+    <GestureDetector gesture={drag}>
+      <Animated.View testID="trayCard" style={[{ width: size.width, height: size.height }, style]}>
+        <View
+          style={[
+            styles.thumb,
+            {
+              width: size.width,
+              height: size.height,
+              borderRadius: ComposerAttachLayout.thumbCorner,
+              backgroundColor: tokens.muted,
+            },
+          ]}
+        >
+          {item.previewUri ? (
+            <Image source={{ uri: item.previewUri }} style={styles.fill} accessibilityIgnoresInvertColors />
+          ) : (
+            <Text style={[styles.fileName, { color: tokens.mutedForeground }]} numberOfLines={2}>
+              {item.name}
+            </Text>
+          )}
+          {upload.kind === "uploading" ? (
+            <View style={styles.dim} accessibilityLabel="正在上传" />
+          ) : null}
+          {upload.kind === "failed" ? (
+            <Pressable
+              accessibilityRole="button"
+              accessibilityLabel="重试"
+              onPress={() => onRetry?.(item.id)}
+              style={styles.retry}
+            >
+              <Text style={styles.retryLabel}>重试</Text>
+            </Pressable>
+          ) : null}
+        </View>
+        <Pressable
+          accessibilityRole="button"
+          accessibilityLabel={t`Remove ${ph({ name: item.name })}`}
+          onPress={() => onRemove(item.id)}
+          hitSlop={8}
+          style={styles.close}
+        >
+          <Text style={styles.closeMark}>×</Text>
+        </Pressable>
+      </Animated.View>
+    </GestureDetector>
+  );
+}
+
+const styles = StyleSheet.create({
+  strip: {
+    flexDirection: "row",
+    alignItems: "flex-start",
+    gap: ComposerAttachLayout.thumbSpacing,
+    paddingHorizontal: 4,
+    paddingTop: 2,
+  },
+  thumb: {
+    overflow: "hidden",
+    alignItems: "center",
+    justifyContent: "center",
+  },
+  fill: { width: "100%", height: "100%" },
+  fileName: { fontSize: 11, paddingHorizontal: 8, textAlign: "center" },
+  close: {
+    position: "absolute",
+    top: -8,
+    right: -8,
+    width: 24,
+    height: 24,
+    borderRadius: 12,
+    backgroundColor: "rgba(0,0,0,0.62)",
+    alignItems: "center",
+    justifyContent: "center",
+  },
+  closeMark: { color: "white", fontSize: 16, fontWeight: "700", marginTop: -1 },
+  toggle: { paddingHorizontal: 14, paddingTop: 8, paddingBottom: 2 },
+  toggleLabel: { fontSize: 12 },
+  dim: { ...StyleSheet.absoluteFillObject, backgroundColor: "rgba(0,0,0,0.35)" },
+  retry: {
+    position: "absolute",
+    backgroundColor: "rgba(220,50,50,0.85)",
+    paddingHorizontal: 10,
+    paddingVertical: 6,
+    borderRadius: 12,
+  },
+  retryLabel: { color: "white", fontSize: 12, fontWeight: "600" },
+});
diff --git a/apps/mobile/components/composer-dictation-bar.tsx b/apps/mobile/components/composer-dictation-bar.tsx
new file mode 100644
index 000000000..ef1530fe8
--- /dev/null
+++ b/apps/mobile/components/composer-dictation-bar.tsx
@@ -0,0 +1,343 @@
+import { useLingui } from "@lingui/react/macro";
+import { useEffect, useRef, useState } from "react";
+import { Animated, PanResponder, Pressable, StyleSheet, Text, View } from "react-native";
+import { useReducedMotion } from "react-native-reanimated";
+import {
+  dictationLevelStep,
+  nextAdaptiveFloor,
+  SILENCE_LEVEL,
+  SPECTRUM_NOISE_GATE,
+} from "../lib/dictation-level";
+import { useMobileTokens, useResolvedAppearance } from "../lib/native";
+import { NativeSymbol } from "./native-symbol";
+
+/**
+ * The bar that takes over the composer while dictation listens, as the reference app draws it:
+ * a two-row capsule — the words being heard above, the controls below — with the swipe hint above
+ * it. It covers the capsule, so the draft and its other buttons stay where they were underneath.
+ *
+ * Every number here is the reference app's own (measured from its bytecode): bars 2 pt wide with
+ * a 2 pt gap (a 4 pt step), 3–22 pt tall, corner radius 1, filled from a queue that advances at
+ * 56 px/s; the circles are 34 pt across on the continuous-curve corner; a 50 pt drag left cancels
+ * and a 50 pt drag up sends; the cancel wash is its red at 0.19. The bars follow the microphone
+ * itself (see `dictation-level.ts`), not a stand-in level.
+ */
+const BAR_WIDTH = 2;
+const BAR_GAP = 2;
+const BAR_STEP = BAR_WIDTH + BAR_GAP;
+const BAR_MIN_HEIGHT = 3;
+const BAR_MAX_HEIGHT = 22;
+/** Pixels per second the queue travels left. */
+const SCROLL_SPEED = 56;
+/** A drag this far left cancels, this far up sends. */
+const SWIPE_ARM_DISTANCE = 50;
+/** Cancel paints the bar red at this opacity. */
+const CANCEL_FILL_ALPHA = 0.19;
+const CANCEL_RED = "#e5484d";
+const BUTTON_SIZE = 34;
+const BAR_ROW_HEIGHT = BAR_MAX_HEIGHT;
+/** The transcript the bar shows above its controls: 12 pt above, 14 pt in from the sides. */
+const TRANSCRIPT_PADDING_TOP = 12;
+const TRANSCRIPT_PADDING_HORIZONTAL = 14;
+/** The controls' own row, and the air under them. */
+const CONTROL_ROW_HEIGHT = BUTTON_SIZE + 8;
+
+/** How many bars fit a width: the official `max(1, floor((width + 2) / 4))`. */
+export function barCountForWidth(width: number): number {
+  return Math.max(1, Math.floor((width + BAR_GAP) / BAR_STEP));
+}
+
+/** How tall a bar stands for a level, 0–1. */
+export function barHeight(level: number): number {
+  const clamped = Math.min(Math.max(level, 0), 1);
+  return BAR_MIN_HEIGHT + (BAR_MAX_HEIGHT - BAR_MIN_HEIGHT) * clamped;
+}
+
+/**
+ * One step of the official scroll queue: `carry` seconds' worth of travel is added, whole bars
+ * are pushed in at the right and the same number fall off the left.
+ */
+export function advanceQueue(
+  history: readonly number[],
+  carry: number,
+  level: number,
+  deltaMs: number,
+  count: number,
+): { history: number[]; carry: number } {
+  const value = Math.min(1, Math.max(SILENCE_LEVEL, level));
+  if (count <= 0) return { history: [], carry: 0 };
+  const base = history.length === count ? history.slice() : Array(count).fill(SILENCE_LEVEL);
+  const advanced = carry + (SCROLL_SPEED * Math.max(0, deltaMs)) / 1000 / BAR_STEP;
+  const steps = Math.floor(advanced);
+  if (steps <= 0) {
+    base[base.length - 1] = value;
+    return { history: base, carry: advanced };
+  }
+  const pushed = Math.min(steps, count);
+  return {
+    history: [...base.slice(pushed), ...Array(pushed).fill(value)],
+    carry: advanced - steps,
+  };
+}
+
+/**
+ * The bar that listens, drawn over the composer's capsule: the words being heard on top, and the
+ * stop circle, the waveform and the send circle under them.
+ */
+export function ComposerDictationBar({
+  level,
+  transcript,
+  onStop,
+  onCancel,
+  onSend,
+}: {
+  /** The microphone's level right now, 0–1, read without re-rendering. */
+  level?: { current: number };
+  /** What has been heard so far, as it is heard. */
+  transcript?: string;
+  /** Stops listening and keeps the words. */
+  onStop: () => void;
+  /** Drops what was heard and closes the microphone. */
+  onCancel: () => void;
+  /** Stops listening and sends. */
+  onSend: () => void;
+}) {
+  const { t } = useLingui();
+  const tokens = useMobileTokens();
+  const dark = useResolvedAppearance() === "dark";
+  const reduceMotion = useReducedMotion();
+  const [width, setWidth] = useState(0);
+  const count = barCountForWidth(width);
+  /** Bumped when the bars are rebuilt, so the row renders the new values once. */
+  const [, setBarTick] = useState(0);
+  // Bars are animated values rather than state: the queue moves 14 times a second and the row
+  // must not re-render the composer at that rate.
+  const heights = useRef<Animated.Value[]>([]);
+  const history = useRef<number[]>([]);
+  const carry = useRef(0);
+  const slide = useRef(new Animated.ValueXY()).current;
+  const cancelFill = useRef(new Animated.Value(0)).current;
+  const sendDim = useRef(new Animated.Value(1)).current;
+  /** Windows of words the controls make way for: the hint fades once a transcript is showing. */
+  const words = transcript?.trim() ?? "";
+  const speaking = words.length > 0;
+
+  useEffect(() => {
+    history.current = Array(count).fill(SILENCE_LEVEL);
+    carry.current = 0;
+    heights.current = Array.from({ length: count }, () => new Animated.Value(BAR_MIN_HEIGHT));
+    setBarTick((tick) => tick + 1);
+  }, [count]);
+
+  useEffect(() => {
+    if (count <= 0) return;
+    let frame = 0;
+    let last = Date.now();
+    const start = Date.now();
+    let shown = SILENCE_LEVEL;
+    let adaptiveFloor: number | null = null;
+    const tick = () => {
+      const now = Date.now();
+      const delta = Math.max(0, now - last);
+      last = now;
+      const raw = reduceMotion ? 0.42 : (level?.current ?? 0);
+      // The reference's adaptive floor learns the room, so a hiss does not fill the row; with the
+      // fixed gate the same envelope runs off its 0.24 threshold.
+      adaptiveFloor = nextAdaptiveFloor(adaptiveFloor, raw, delta, now - start);
+      const floor = adaptiveFloor >= SPECTRUM_NOISE_GATE ? adaptiveFloor : SPECTRUM_NOISE_GATE;
+      shown = dictationLevelStep(shown, raw, floor);
+      const next = advanceQueue(
+        history.current,
+        carry.current,
+        Math.max(SILENCE_LEVEL, shown),
+        delta,
+        count,
+      );
+      history.current = next.history;
+      carry.current = next.carry;
+      for (let index = 0; index < count; index += 1) {
+        const bar = heights.current[index];
+        const value = next.history[index] ?? SILENCE_LEVEL;
+        if (bar) bar.setValue(barHeight(value));
+      }
+      frame = requestAnimationFrame(tick);
+    };
+    frame = requestAnimationFrame(tick);
+    return () => cancelAnimationFrame(frame);
+  }, [count, reduceMotion]);
+
+  const pan = useRef(
+    PanResponder.create({
+      onMoveShouldSetPanResponder: (_, gesture) =>
+        Math.abs(gesture.dx) > 6 || Math.abs(gesture.dy) > 6,
+      onPanResponderMove: (_, gesture) => {
+        slide.setValue({ x: Math.min(0, gesture.dx), y: Math.min(0, gesture.dy) });
+        cancelFill.setValue(Math.min(1, Math.max(0, -gesture.dx / SWIPE_ARM_DISTANCE)));
+        sendDim.setValue(1 - 0.3 * Math.min(1, Math.max(0, -gesture.dy / SWIPE_ARM_DISTANCE)));
+      },
+      onPanResponderRelease: (_, gesture) => {
+        Animated.spring(slide, {
+          toValue: { x: 0, y: 0 },
+          useNativeDriver: true,
+          bounciness: 0,
+        }).start();
+        cancelFill.setValue(0);
+        sendDim.setValue(1);
+        // Up wins only when it is the larger of the two, as the official gesture reads it.
+        if (gesture.dx <= -SWIPE_ARM_DISTANCE && Math.abs(gesture.dx) >= Math.abs(gesture.dy)) {
+          onCancel();
+          return;
+        }
+        if (gesture.dy <= -SWIPE_ARM_DISTANCE && Math.abs(gesture.dy) > Math.abs(gesture.dx)) {
+          onSend();
+        }
+      },
+      onPanResponderTerminate: () => {
+        Animated.spring(slide, {
+          toValue: { x: 0, y: 0 },
+          useNativeDriver: true,
+          bounciness: 0,
+        }).start();
+        cancelFill.setValue(0);
+        sendDim.setValue(1);
+      },
+    }),
+  ).current;
+
+  // The reference's two circles are white with black glyphs on its dark glass; on a light page
+  // they invert, so they keep the same contrast either way.
+  const circleFill = dark ? "#FFFFFF" : tokens.foreground;
+  const circleGlyph = dark ? "#000000" : tokens.background;
+
+  return (
+    <View
+      testID="dictation-waveform"
+      style={[
+        styles.bar,
+        { backgroundColor: tokens.muted, minHeight: CONTROL_ROW_HEIGHT },
+        speaking ? { paddingTop: TRANSCRIPT_PADDING_TOP } : null,
+      ]}
+    >
+      <Animated.View
+        pointerEvents="none"
+        style={[
+          StyleSheet.absoluteFill,
+          {
+            backgroundColor: CANCEL_RED,
+            opacity: cancelFill.interpolate({
+              inputRange: [0, 1],
+              outputRange: [0, CANCEL_FILL_ALPHA],
+            }),
+            borderRadius: 25,
+          },
+        ]}
+      />
+      {speaking ? (
+        <Text
+          numberOfLines={2}
+          testID="dictation-transcript"
+          style={[
+            styles.transcript,
+            { color: tokens.foreground, paddingHorizontal: TRANSCRIPT_PADDING_HORIZONTAL },
+          ]}
+        >
+          {words}
+        </Text>
+      ) : null}
+      <Animated.View
+        {...pan.panHandlers}
+        style={[styles.controls, { transform: [{ translateX: slide.x }, { translateY: slide.y }] }]}
+      >
+        <Pressable
+          accessibilityRole="button"
+          accessibilityLabel={t`Stop dictating`}
+          hitSlop={6}
+          onPress={onStop}
+          style={[styles.circle, { backgroundColor: circleFill }]}
+        >
+          <NativeSymbol ios="stop.fill" android="square" size={18} color={circleGlyph} />
+        </Pressable>
+        <View style={styles.center}>
+          {speaking ? null : (
+            <View style={styles.hintRow}>
+              <NativeSymbol
+                ios="chevron.left"
+                android="chevron-back"
+                size={9}
+                color={tokens.mutedForeground}
+              />
+              <Text numberOfLines={1} style={[styles.hint, { color: tokens.mutedForeground }]}>
+                {t`向左滑动以取消`}
+              </Text>
+            </View>
+          )}
+          <View
+            style={[styles.waveform, { height: BAR_ROW_HEIGHT, flex: speaking ? 1 : 1.4 }]}
+            onLayout={(event) => setWidth(event.nativeEvent.layout.width)}
+          >
+            {heights.current.map((height, index) => (
+              <Animated.View
+                key={`dictation-bar-${index + 1}`}
+                style={{
+                  width: BAR_WIDTH,
+                  height,
+                  borderRadius: BAR_WIDTH / 2,
+                  backgroundColor: tokens.foreground,
+                }}
+              />
+            ))}
+          </View>
+        </View>
+        <Animated.View style={{ opacity: sendDim }}>
+          <Pressable
+            accessibilityRole="button"
+            accessibilityLabel={t`Send`}
+            hitSlop={6}
+            onPress={onSend}
+            style={[styles.circle, { backgroundColor: circleFill }]}
+          >
+            <NativeSymbol ios="arrow.up" android="arrow-up" size={20} color={circleGlyph} />
+          </Pressable>
+        </Animated.View>
+      </Animated.View>
+    </View>
+  );
+}
+
+const styles = StyleSheet.create({
+  bar: {
+    position: "absolute",
+    left: 0,
+    right: 0,
+    bottom: 0,
+    flexDirection: "column",
+    justifyContent: "flex-end",
+    paddingHorizontal: 8,
+    borderRadius: 25,
+    overflow: "hidden",
+  },
+  transcript: {
+    fontSize: 17,
+    lineHeight: 22,
+    paddingBottom: 8,
+  },
+  controls: {
+    flexDirection: "row",
+    alignItems: "center",
+    gap: 10,
+    paddingVertical: 4,
+    height: CONTROL_ROW_HEIGHT,
+  },
+  circle: {
+    width: BUTTON_SIZE,
+    height: BUTTON_SIZE,
+    borderRadius: BUTTON_SIZE / 2,
+    borderCurve: "continuous",
+    alignItems: "center",
+    justifyContent: "center",
+  },
+  center: { flex: 1.6, flexDirection: "row", alignItems: "center", gap: 10 },
+  waveform: { flex: 1, flexDirection: "row", alignItems: "center", gap: BAR_GAP, overflow: "hidden" },
+  hintRow: { flexDirection: "row", alignItems: "center", gap: 2 },
+  hint: { fontSize: 11 },
+});
