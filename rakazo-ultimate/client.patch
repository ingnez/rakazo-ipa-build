+    out.append("export const MOTION_STATES: Readonly<Record<string, MotionStateRule>> = {")
+    for state, rule in data["stateTable"].items():
+        parts = ["clips: [" + ",".join(f'"{c}"' for c in rule["clips"]) + "]"]
