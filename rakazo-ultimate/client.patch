@@ -0,0 +1,51 @@
+/**
+ * The reference app's own measurements, in one place, so every page that composes a sand tile
+ * lands on the same numbers instead of each screen inventing its own.
+ *
+ * A page is a sheet edge (16), a group gap (8), and a radius family (10 / 16 / 20 / 24). A press
+ * takes 90 ms to settle and springs back at 16/340/0.6. A sheet shows 48×3 of grabber and leaves
+ * 5% of the page under it. These are the values the whole app is built from; a page that needs a
+ * different number is a page that is not one of these.
+ */
+
+/** The inset a sheet's content keeps from its edges. */
+export const SHEET_CONTENT_PADDING = 16;
+/** The gap between one inset group and the next. */
+export const GROUP_GAP = 8;
+
+export const SAND_RADIUS = {
+  /** Small chips and key caps. */
+  sm: 10,
+  /** The grouped card on a settings page. */
+  md: 16,
+  /** A wide grouped card, as the reference's larger groups draw it. */
+  lg: 20,
+  /** A card of its own: message cards, sheets' subjects. */
+  card: 24,
+} as const;
+
+/** A press: down over 90 ms, then the spring that lets it out. */
+export const PRESS_IN_MS = 90;
+export const PRESS_SCALE = 0.97;
+export const RELEASE_SPRING = { duration: 320, dampingRatio: 0.75 } as const;
+
+/** A sheet's grabber: 48 wide, 3 tall, 5 above the sheet's top edge. */
+export const GRABBER_WIDTH = 48;
+export const GRABBER_HEIGHT = 3;
+export const GRABBER_BOTTOM_INSET = 5;
+
+/** The share of the screen a page sheet keeps: it stops 5% short of the top. */
+export const SHEET_DETENT = 0.95;
+/** A sheet's content fades in over this long once it is placed. */
+export const SHEET_FADE_MS = 120;
+
+/** A grouped row's inner space: leading inset 22, trailing 23.5, as the reference measures them. */
+export const ROW_LEADING_INSET = 22;
+export const ROW_TRAILING_INSET = 23.5;
+/** The shortest a grouped row is drawn, in points. */
+export const ROW_MIN_HEIGHT = 48;
+
+/** How far a card's own actions sit from its edge. */
+export const CARD_HIT_SLOP = 5;
+/** The shortest a card action's own row is drawn, so a thumb finds it. */
+export const ACTION_MIN_HEIGHT = 44;
