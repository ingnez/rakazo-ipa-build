@@ -0,0 +1,137 @@
+import type { AvatarMotionMode } from "@rakazo/core";
+import {
+  openminisBlinkWait,
+  openminisMoodFor,
+  openminisSpecFor,
+  openminisSvg,
+} from "@rakazo/core";
+import { memo, useEffect, useState } from "react";
+import { Pressable, View } from "react-native";
+import { SvgXml } from "react-native-svg";
+import { useAfterFirstPaint } from "../lib/after-first-paint";
+import { useAvatarOnScreen } from "../lib/avatar-life";
+import { hapticImpact } from "../lib/haptics";
+import { useLumenReducedMotion } from "../lib/lumen/lumen-manifest-store";
+import { useResolvedAppearance } from "../lib/native";
+
+export type OpenMinisBotAvatarProps = {
+  color?: string;
+  name?: string;
+  id?: string;
+  size?: number;
+  status?: string;
+  identity?: string;
+  activity?: string;
+  motion?: AvatarMotionMode | "still";
+  composing?: boolean;
+  pokeable?: boolean;
+  chief?: boolean;
+  unread?: boolean;
+};
+
+function sleep(ms: number): Promise<void> {
+  return new Promise((resolve) => {
+    setTimeout(resolve, ms);
+  });
+}
+
+function rand(min: number, max: number): number {
+  return min + Math.random() * (max - min);
+}
+
+/**
+ * The OpenMinis avatar: a coloured shape with two white capsule eyes, drawn in SVG at the size
+ * it is shown. It blinks on its own unless motion is reduced, the avatar is off-screen, or the
+ * caller asked for a still frame.
+ */
+export const OpenMinisBotAvatar = memo(function OpenMinisBotAvatar({
+  name,
+  id,
+  size = 54,
+  status,
+  identity,
+  activity,
+  motion = "live",
+  composing = false,
+  pokeable = false,
+  chief = false,
+  unread = false,
+}: OpenMinisBotAvatarProps) {
+  const dark = useResolvedAppearance() === "dark";
+  const onScreen = useAvatarOnScreen();
+  const afterFirstPaint = useAfterFirstPaint();
+  const reducedMotion = useLumenReducedMotion();
+  const spec = openminisSpecFor({ name, identity: id ?? identity, chief });
+  const [shy, setShy] = useState(false);
+  const mood = openminisMoodFor({ status, activity, composing, unread, shy });
+  const working = mood === "focused";
+  const still =
+    reducedMotion ||
+    !afterFirstPaint ||
+    !onScreen ||
+    motion === "still" ||
+    motion === "static" ||
+    (motion === "lazy" && mood === "calm") ||
+    size < 22;
+  const [eyeOpen, setEyeOpen] = useState(1);
+
+  useEffect(() => {
+    if (still) {
+      setEyeOpen(1);
+      return;
+    }
+    let cancelled = false;
+    const run = async () => {
+      await sleep(rand(300, 1600));
+      while (!cancelled) {
+        const wait = openminisBlinkWait(working);
+        await sleep(rand(wait.min, wait.max) * 1000);
+        if (cancelled) return;
+        setEyeOpen(0.1);
+        await sleep(120);
+        if (cancelled) return;
+        setEyeOpen(1);
+        if (Math.random() < 0.2) {
+          await sleep(180);
+          if (cancelled) return;
+          setEyeOpen(0.1);
+          await sleep(100);
+          if (cancelled) return;
+          setEyeOpen(1);
+        }
+      }
+    };
+    void run();
+    return () => {
+      cancelled = true;
+    };
+  }, [still, working]);
+
+  const xml = openminisSvg(spec, {
+    size,
+    dark,
+    eyeOpen: still ? 1 : eyeOpen,
+    mood,
+    showsFace: true,
+  });
+
+  const body = (
+    <View style={{ width: size, height: size }} pointerEvents={pokeable ? "box-only" : "none"}>
+      <SvgXml xml={xml} width={size} height={size} />
+    </View>
+  );
+
+  if (!pokeable) return body;
+  return (
+    <Pressable
+      onPressIn={() => {
+        setShy(true);
+        hapticImpact();
+      }}
+      onPressOut={() => setShy(false)}
+      accessibilityRole="button"
+    >
+      {body}
+    </Pressable>
+  );
+});
