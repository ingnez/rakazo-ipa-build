@@ -0,0 +1,36 @@
+import { z } from "zod";
+import { Id } from "./ids.js";
+
+/**
+ * A stage diary: one stretch of a chat, written a few minutes after the person stopped writing,
+ * so a later turn — or a later day's page — can pick the thread up without re-reading everything.
+ *
+ * It carries its own anchors: the seq and message ids of the first and last message it covers, so
+ * the app can jump back to the exact place in the conversation it came from.
+ */
+export const DiarySchema = z.object({
+  id: Id,
+  botId: Id,
+  threadId: Id,
+  /** The person's local day (YYYY-MM-DD) the stretch mostly happened on. */
+  day: z.string(),
+  title: z.string(),
+  /** One line: what this stretch of conversation came to. */
+  summary: z.string(),
+  /** The diary itself, markdown. */
+  body: z.string(),
+  /** What is still owed to the person: unfinished work, questions left open. */
+  openHooks: z.array(z.string()),
+  startSeq: z.number().int().nonnegative(),
+  endSeq: z.number().int().nonnegative(),
+  startMessageId: Id.nullable(),
+  endMessageId: Id.nullable(),
+  messageCount: z.number().int().nonnegative(),
+  taskCount: z.number().int().nonnegative(),
+  createdAt: z.string(),
+});
+export type Diary = z.infer<typeof DiarySchema>;
+
+/** The list the app reads: summaries and hooks, without the bodies. */
+export const DiarySummarySchema = DiarySchema.omit({ body: true });
+export type DiarySummary = z.infer<typeof DiarySummarySchema>;
