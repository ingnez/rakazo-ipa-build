+import type { MessageDescriptor } from "@lingui/core";
+import { msg } from "@lingui/core/macro";
+
+/**
+ * The emoji the reaction picker offers, in the categories it groups them by.
+ *
+ * The characters are the standard Unicode set; each one carries the words a search for it uses,
+ * so typing "笑" or "火" finds it in the language the app is read in.
+ */
+export type EmojiEntry = { emoji: string; keywords: string };
+
+export type EmojiCategory = {
+  id: string;
+  title: MessageDescriptor;
+  entries: EmojiEntry[];
+};
+
+function parse(raw: string): EmojiEntry[] {
+  return raw
+    .split("|")
+    .map((line) => line.trim())
+    .filter(Boolean)
+    .map((line) => {
+      const space = line.indexOf(" ");
+      // Everything after the first space is what a search for this emoji matches.
+      return space < 0
+        ? { emoji: line, keywords: "" }
+        : { emoji: line.slice(0, space), keywords: line.slice(space + 1).trim() };
+    });
+}
