+import { t } from "@lingui/core/macro";
+import type { ReplyPreview } from "@rakazo/contracts";
+import { replyLabel } from "@rakazo/core";
+import { Pressable, Text, View } from "react-native";
+import { mobileTokens } from "../../lib/appearance";
+import type { MobileArtifactTarget } from "../../lib/artifact-open";
+import { NativeSymbol } from "../native-symbol";
+import { ReplyThumbnail } from "../reply-thumbnail";
+
+/**
+ * The message a reply is aimed at, inside the top of the composer's own card as the reference app
+ * draws it: one line of what it says, and the way to put the reply down again. It sits above the
+ * input rather than in a sheet of its own, so writing a reply never pushes the card up the screen.
+ */
+export function ComposerReplyBar({
+  quote,
+  text,
+  attachment,
+  threadTarget,
+  onDismiss,
+}: {
+  quote?: string | null;
+  text: string;
+  attachment?: ReplyPreview["attachment"];
+  threadTarget?: MobileArtifactTarget;
+  onDismiss: () => void;
+}) {
+  const tokens = mobileTokens();
+  const line = replyLabel(quote, text, attachment, {
+    photo: t`Photo`,
+    attachment: t`Attachment`,
+  });
+  return (
+    <View
+      style={{
+        flexDirection: "row",
+        alignItems: "center",
+        gap: 8,
+        paddingStart: 10,
+        paddingEnd: 4,
+        paddingTop: 10,
+        paddingBottom: 2,
+      }}
+    >
+      {attachment ? <ReplyThumbnail attachment={attachment} threadTarget={threadTarget} /> : null}
+      <Text numberOfLines={1} style={{ flex: 1, color: tokens.mutedForeground, fontSize: 14 }}>
+        {line}
+      </Text>
+      {/* A thin cross, as the reference bar carries: the filled one crowds the line of text. */}
+      <Pressable
+        accessibilityRole="button"
+        accessibilityLabel={t`Cancel reply`}
+        hitSlop={10}
+        onPress={onDismiss}
+        style={{ padding: 4 }}
+      >
+        <NativeSymbol ios="xmark" android="close" size={13} color={tokens.mutedForeground} />
+      </Pressable>
+    </View>
+  );
+}
diff --git a/apps/mobile/components/thread/file-attachment-card.tsx b/apps/mobile/components/thread/file-attachment-card.tsx
new file mode 100644
index 000000000..7ac181d4b
--- /dev/null
+++ b/apps/mobile/components/thread/file-attachment-card.tsx
@@ -0,0 +1,208 @@
+import { ph } from "@lingui/core/macro";
+import { useLingui } from "@lingui/react/macro";
+import { formatFileSize } from "@rakazo/core";
+import type { PressableProps, ViewProps } from "react-native";
+import { Pressable, StyleSheet, Text, View } from "react-native";
+import Svg, { Path } from "react-native-svg";
+import type { MobileArtifactTarget } from "../../lib/artifact-open";
+import { splitFileName } from "../../lib/file-name";
+import { useMobileTokens, useResolvedAppearance } from "../../lib/native";
+import { FilePreviewPaper } from "./file-preview-paper";
+
+/** The card's own surface in the dark appearance, as the reference app draws it. */
+const DARK_CARD_FILL = "#1C1C1E";
+/** The document glyph, in the reference app's soft solid: a sheet a shade off the card. */
+const GLYPH_DARK = { sheet: "#2C2C2E", fold: "#3A3A3C", line: "#7A7A80" } as const;
+const GLYPH_LIGHT = { sheet: "#ECECF0", fold: "#DCDCE1", line: "#A6A6AC" } as const;
+/** The glyph's own box, in points: a portrait sheet, as tall as the two lines beside it. */
+const GLYPH_WIDTH = 30;
+const GLYPH_HEIGHT = 38;
+/**
+ * How wide a file card is: at least this much, and the caller stretches it to the reference app's
+ * share of the row, so an ordinary name reads on one line instead of wrapping in a narrow chip.
+ */
+export const FILE_CARD_MIN_WIDTH = 264;
+
+/**
+ * The colour a format's glyph wears, as the reference app draws each kind of file: a spreadsheet's
+ * green grid, a deck's orange page, a document's blue page.
+ */
+const FORMAT_TINTS: Readonly<Record<string, { sheet: string; fold: string; line: string }>> = {
+  xlsx: { sheet: "#21A366", fold: "#1B8A56", line: "#FFFFFF" },
+  xls: { sheet: "#21A366", fold: "#1B8A56", line: "#FFFFFF" },
+  csv: { sheet: "#21A366", fold: "#1B8A56", line: "#FFFFFF" },
+  pptx: { sheet: "#D24726", fold: "#B23A1D", line: "#FFFFFF" },
+  ppt: { sheet: "#D24726", fold: "#B23A1D", line: "#FFFFFF" },
+  docx: { sheet: "#2B579A", fold: "#22477F", line: "#FFFFFF" },
+  doc: { sheet: "#2B579A", fold: "#22477F", line: "#FFFFFF" },
+  pdf: { sheet: "#D93832", fold: "#B62C27", line: "#FFFFFF" },
+};
+
+/**
+ * A file in a chat, drawn as the file itself: what is inside it when the app can show that (a
+ * text file's opening set like a page, a PDF's first page), then the document glyph, its name and
+ * what kind of thing it is. A tap opens it (or downloads it to the share sheet); the card is a
+ * button, so no outer gesture has to be guessed at, and a file that cannot open says why instead
+ * of doing nothing.
+ */
+export function FileAttachmentCard({
+  name,
+  mimeType,
+  size,
+  caption,
+  tone = "sent",
+  busy = false,
+  preview,
+  onPress,
+  onLongPress,
+  accessibilityActions,
+  onAccessibilityAction,
+  style,
+}: {
+  name: string;
+  /** What the server called the file; the sheet above the name is read by it. */
+  mimeType: string;
+  size?: number;
+  /** A line under the card: sending, failed, or the reason it would not open. */
+  caption?: string;
+  tone?: "sent" | "pending" | "failed";
+  busy?: boolean;
+  /**
+   * The file the card is showing: its content is read for the sheet above the name when the app
+   * can draw it, and nothing is drawn when it cannot.
+   */
+  preview?: { target: MobileArtifactTarget; artifactId: string };
+  onPress?: () => void;
+  onLongPress?: PressableProps["onLongPress"];
+  accessibilityActions?: ViewProps["accessibilityActions"];
+  onAccessibilityAction?: ViewProps["onAccessibilityAction"];
+  style?: ViewProps["style"];
+}) {
+  const { t } = useLingui();
+  const tokens = useMobileTokens();
+  const theme = useResolvedAppearance();
+  // The reference app names the file without its extension and puts the type under it after the
+  // size, in its own lower case ("10.2 KB · md"), so a long name keeps its room and the format
+  // reads at a glance.
+  const { title, extension } = splitFileName(name);
+  const sizeLabel = size === undefined ? undefined : formatFileSize(size);
+  // A file with no extension still says how big it is, without a dot left dangling after it.
+  const format = extension
+    ? [sizeLabel, extension.toLowerCase()].filter(Boolean).join(" · ")
+    : sizeLabel;
+  const detail = caption ?? format ?? t`File`;
+  const cardFill = theme === "dark" ? DARK_CARD_FILL : "#FFFFFF";
+  return (
+    <View style={[styles.wrap, style]}>
+      <Pressable
+        accessibilityRole="button"
+        accessibilityLabel={t`${ph({ name })}: ${ph({ detail })}`}
+        accessibilityHint={onPress ? t`Opens the file` : undefined}
+        accessibilityActions={accessibilityActions}
+        onAccessibilityAction={onAccessibilityAction}
+        android_ripple={{ color: tokens.muted }}
+        disabled={!onPress || busy}
+        onLongPress={onLongPress}
+        onPress={onPress}
+        style={({ pressed }) => [
+          styles.card,
+          {
+            // The reference app draws a file as a card of its own: near-black on a dark chat and
+            // pure white on a light one, with a border faint enough to only separate it.
+            backgroundColor: cardFill,
+            borderColor: tone === "failed" ? tokens.destructive : tokens.border,
+            opacity: tone === "pending" ? 0.72 : pressed ? 0.9 : 1,
+          },
+        ]}
+      >
+        {preview ? (
+          // The sheet sits inside the card's own rounded edge, so the card reads as the page's
+          // frame rather than as a panel glued above a file row.
+          <View style={styles.preview}>
+            <FilePreviewPaper
+              artifactId={preview.artifactId}
+              background={cardFill}
+              mimeType={mimeType}
+              name={name}
+              size={size}
+              target={preview.target}
+            />
+          </View>
+        ) : null}
+        <View style={[styles.info, preview ? styles.infoUnderPreview : null]}>
+          <DocumentGlyph dark={theme === "dark"} format={extension?.toLowerCase() ?? ""} />
+          <View style={styles.text}>
+            <Text
+              numberOfLines={1}
+              ellipsizeMode="middle"
+              style={[styles.name, { color: tokens.foreground }]}
+            >
+              {title}
+            </Text>
+            <Text numberOfLines={1} style={[styles.detail, { color: tokens.mutedForeground }]}>
+              {busy ? t`Opening…` : detail}
+            </Text>
+          </View>
+        </View>
+      </Pressable>
+    </View>
+  );
+}
+
+/**
+ * A file's own glyph: a sheet with a dog-eared corner and its lines, drawn soft and solid the way
+ * the reference app draws it — a shade lighter than the card, not a white outline on a tile.
+ */
+function DocumentGlyph({ dark, format }: { dark: boolean; format: string }) {
+  const ink = FORMAT_TINTS[format] ?? (dark ? GLYPH_DARK : GLYPH_LIGHT);
+  return (
+    <Svg width={GLYPH_WIDTH} height={GLYPH_HEIGHT} viewBox="0 0 26 32">
+      {/* The sheet, its top-right corner folded back over the page. */}
+      <Path
+        d="M6 0 H16.5 L26 9.5 V26 A6 6 0 0 1 20 32 H6 A6 6 0 0 1 0 26 V6 A6 6 0 0 1 6 0 Z"
+        fill={ink.sheet}
+      />
+      <Path d="M16.5 0 L26 9.5 H20 A3.5 3.5 0 0 1 16.5 6 Z" fill={ink.fold} />
+      {/* Three lines of text, the middle one longest, as the reference draws the page. */}
+      <Path
+        d="M6.5 13.4 H15.5 M6.5 18.2 H20.5 M6.5 23 H17.5"
+        stroke={ink.line}
+        strokeWidth={2.2}
+        strokeLinecap="round"
+      />
+    </Svg>
+  );
+}
+
+const styles = StyleSheet.create({
+  wrap: { gap: 4 },
+  card: {
+    // The card is a frame: the sheet above and the file's row inside share its rounded edge.
+    borderRadius: 18,
+    borderCurve: "continuous",
+    borderWidth: StyleSheet.hairlineWidth,
+    overflow: "hidden",
+    // A file card is a card of the conversation's own width: the reference app gives a name the
+    // room to read on one line, and the caller hands it the message's whole width, which is the
+    // same share of the row a long text bubble takes.
+    alignSelf: "stretch",
+    minWidth: FILE_CARD_MIN_WIDTH,
+  },
+  preview: { paddingHorizontal: 16, paddingTop: 16, paddingBottom: 10 },
+  info: {
+    flexDirection: "row",
+    alignItems: "center",
+    gap: 12,
+    paddingHorizontal: 14,
+    paddingVertical: 13,
+  },
+  // Under the sheet the row is already spaced by the sheet's own padding: no second gap.
+  infoUnderPreview: { paddingTop: 4, paddingBottom: 14 },
+  // Never `flex: 1`: the card is a shrink-wrap box inside a row that sizes to its content, and
+  // Yoga gives a `flex: 1` child of such a box a width of zero — the name and the kind collapsed
+  // away and only the icon was left. `flexShrink` with `minWidth: 0` lets the text take the room
+  // the card has and still wrap inside it.
+  text: { flex: 1, flexShrink: 1, minWidth: 0, gap: 2 },
+  name: { fontSize: 17, fontWeight: "600", lineHeight: 22 },
+  detail: { fontSize: 15, lineHeight: 20 },
+});
diff --git a/apps/mobile/components/thread/file-preview-paper.tsx b/apps/mobile/components/thread/file-preview-paper.tsx
new file mode 100644
index 000000000..49960f2bb
--- /dev/null
+++ b/apps/mobile/components/thread/file-preview-paper.tsx
@@ -0,0 +1,196 @@
+import { useEffect, useRef, useState } from "react";
+import { Image, StyleSheet, Text, View } from "react-native";
+import Svg, { Defs, LinearGradient, Rect, Stop } from "react-native-svg";
+import type { MobileArtifactTarget } from "../../lib/artifact-open";
+import {
+  officeArtifactThumbnail,
+  pdfArtifactThumbnail,
+  previewTextMobileArtifact,
+} from "../../lib/artifact-open";
+import type { PreviewBlock } from "../../lib/file-preview";
+import {
+  PREVIEW_PAPER_HEIGHT,
+  PREVIEW_TEXT_MAX_CHARS,
+  filePreviewKind,
+  previewBlocks,
+  previewMaxBytes,
+} from "../../lib/file-preview";
+import { officeThumbnailAvailable } from "../../lib/office-thumbnail";
+import { pdfThumbnailAvailable } from "../../lib/pdf-thumbnail";
+import { APP_MONO_FONT_FAMILY } from "../../lib/app-font";
+import { useMobileTokens } from "../../lib/native";
+
+/** A portrait page's shape, so a PDF's first page can be laid out before it is drawn. */
+const PAGE_ASPECT_RATIO = 1 / 1.414;
+
+/**
+ * What a file holds, drawn on the card itself: a text file's opening set like a page, a PDF's first
+ * page, or the first page of an Office document as the system's own reader draws it. It is
+ * decoration over a card that opens the real file, so it takes no touches and says nothing to
+ * VoiceOver; a file it cannot show — or one too big to read for a card — draws nothing at all, and
+ * the card keeps the compact file row it had.
+ */
+export function FilePreviewPaper({
+  target,
+  artifactId,
+  mimeType,
+  name,
+  size,
+  background,
+}: {
+  target: MobileArtifactTarget;
+  artifactId: string;
+  mimeType: string;
+  name: string;
+  /** The block's own size, so a 3 MB log is not read to show twelve lines of it. */
+  size?: number;
+  /** The card's fill: the page fades into it at the fold. */
+  background: string;
+}) {
+  const tokens = useMobileTokens();
+  const kind = filePreviewKind(mimeType, name);
+  const [blocks, setBlocks] = useState<PreviewBlock[] | null>(null);
+  // A page already drawn, and the shape of the paper it came on: a slide is not a sheet of A4.
+  const [page, setPage] = useState<{ uri: string; aspect?: number } | null>(null);
+  const [failed, setFailed] = useState(false);
+  // The target is a fresh object on every render of the bubble; the read is keyed on its identity
+  // as a string so a re-render does not ask the server again.
+  const targetRef = useRef(target);
+  targetRef.current = target;
+  const targetKey = "botId" in target ? `bot:${target.botId}` : `group:${target.groupId}`;
+
+  useEffect(() => {
+    if (!artifactId || kind === "none" || (size !== undefined && size > previewMaxBytes(kind))) {
+      setFailed(true);
+      return;
+    }
+    let active = true;
+    setFailed(false);
+    // One guarded read: a file that cannot be read — or a card drawn where the app's own reader is
+    // not there to ask — shows nothing and the card stays compact.
+    const load = async () => {
+      try {
+        if (kind === "text") {
+          const text = await previewTextMobileArtifact(
+            targetRef.current,
+            artifactId,
+            mimeType,
+            PREVIEW_TEXT_MAX_CHARS,
+          );
+          if (!active) return;
+          const next = previewBlocks(text, { mimeType, name });
+          if (next.length) setBlocks(next);
+          else setFailed(true);
+          return;
+        }
+        if (kind === "office") {
+          // The page is drawn by the system's reader, never read as bytes: a workbook or a deck
+          // printed as text is exactly the mojibake a card must not show.
+          if (!officeThumbnailAvailable()) {
+            if (active) setFailed(true);
+            return;
+          }
+          const sheet = await officeArtifactThumbnail(targetRef.current, artifactId, mimeType, 640);
+          if (!active) return;
+          if (sheet) setPage({ uri: sheet.uri, aspect: sheet.width / sheet.height });
+          else setFailed(true);
+          return;
+        }
+        if (!pdfThumbnailAvailable()) {
+          if (active) setFailed(true);
+          return;
+        }
+        const uri = await pdfArtifactThumbnail(targetRef.current, artifactId, mimeType, 420);
+        if (!active) return;
+        if (uri) setPage({ uri });
+        else setFailed(true);
+      } catch {
+        if (active) setFailed(true);
+      }
+    };
+    void load();
+    return () => {
+      active = false;
+    };
+  }, [artifactId, kind, mimeType, name, size, targetKey]);
+
+  if (failed) return null;
+
+  return (
+    <View
+      pointerEvents="none"
+      importantForAccessibility="no-hide-descendants"
+      accessibilityElementsHidden
+      style={styles.paper}
+    >
+      {kind === "pdf" || kind === "office" ? (
+        page ? (
+          <Image
+            accessibilityIgnoresInvertColors
+            resizeMode="contain"
+            source={{ uri: page.uri }}
+            // A deck's page is wide and a letter's is tall: the picture keeps the proportions the
+            // reader drew it with, and the fold cuts whatever runs past the paper's height.
+            style={[styles.page, page.aspect ? { aspectRatio: page.aspect } : null]}
+          />
+        ) : null
+      ) : (
+        <View style={styles.blocks}>
+          {blocks?.map((block, index) =>
+            block.kind === "rule" ? (
+              <View
+                key={`rule-${index}`}
+                style={[styles.rule, { backgroundColor: tokens.border }]}
+              />
+            ) : (
+              <Text
+                key={`${index}-${block.kind}`}
+                style={[
+                  blockStyles[block.kind],
+                  { color: block.kind === "quote" ? tokens.mutedForeground : tokens.foreground },
+                  index > 0 && block.kind === "heading" ? styles.headingGap : null,
+                  index > 0 && block.kind === "subheading" ? styles.subheadingGap : null,
+                ]}
+              >
+                {block.text}
+              </Text>
+            ),
+          )}
+        </View>
+      )}
+      {kind === "text" ? (
+        <Svg style={styles.fade} width="100%" height={36}>
+          <Defs>
+            <LinearGradient id="file-paper-fade" x1="0" y1="0" x2="0" y2="1">
+              <Stop offset="0" stopColor={background} stopOpacity={0} />
+              <Stop offset="1" stopColor={background} stopOpacity={1} />
+            </LinearGradient>
+          </Defs>
+          <Rect width="100%" height={36} fill="url(#file-paper-fade)" />
+        </Svg>
+      ) : null}
+    </View>
+  );
+}
+
+/** One place for the page's type, so a title reads as a title on every card. */
+const blockStyles = StyleSheet.create({
+  heading: { fontSize: 17, lineHeight: 22, fontWeight: "700" },
+  subheading: { fontSize: 14.5, lineHeight: 20, fontWeight: "700" },
+  body: { fontSize: 13.5, lineHeight: 19, fontWeight: "400" },
+  bullet: { fontSize: 13.5, lineHeight: 19, fontWeight: "400" },
+  quote: { fontSize: 13, lineHeight: 18, fontWeight: "400" },
+  code: { fontSize: 11.5, lineHeight: 16, fontFamily: APP_MONO_FONT_FAMILY },
+  rule: { fontSize: 1, lineHeight: 1 },
+});
+
+const styles = StyleSheet.create({
+  // The fold: what does not fit is cut off mid-line, as a page under its own edge.
+  paper: { height: PREVIEW_PAPER_HEIGHT, overflow: "hidden" },
+  blocks: { gap: 3 },
+  headingGap: { marginTop: 5 },
+  subheadingGap: { marginTop: 4 },
+  rule: { height: StyleSheet.hairlineWidth, marginVertical: 5 },
+  page: { width: "100%", aspectRatio: PAGE_ASPECT_RATIO },
+  fade: { position: "absolute", left: 0, right: 0, bottom: 0 },
+});
diff --git a/apps/mobile/components/thread/ledger-panel.tsx b/apps/mobile/components/thread/ledger-panel.tsx
