+  const later = "Summarize the launch notes";
+  await composer.fill(earlier);
+  await send.click();
+  await expect(page.getByTestId("composer-error")).toBeVisible();
+  await page.getByTestId("composer-error-dismiss").click();
+  await composer.fill(later);
