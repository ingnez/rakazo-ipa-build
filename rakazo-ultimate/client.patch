index 000000000..cb1ffd3bb
--- /dev/null
+++ b/apps/mobile/components/image-card-stack.tsx
@@ -0,0 +1,402 @@
+import { useEffect, useMemo, useState } from "react";
+import { Image, Pressable, StyleSheet, Text, View } from "react-native";
+import { Gesture, GestureDetector } from "react-native-gesture-handler";
+import Animated, {
+  Easing,
+  runOnJS,
+  useAnimatedStyle,
+  useSharedValue,
+  withSpring,
+  withTiming,
+} from "react-native-reanimated";
+import { mobileTokens } from "../lib/appearance";
+import type { MobileArtifactTarget } from "../lib/artifact-open";
+import { imageArtifactPreview } from "../lib/artifact-open";
+import { hapticImpact, hapticSelection } from "../lib/haptics";
+import type { ImageStackCard } from "../lib/image-stack-layout";
+import {
+  CAPTION_HEIGHT,
+  CAPTION_SPACING,
+  CARD_SIZE,
+  CORNER_RADIUS,
+  HIGHLIGHT_SCALE,
+  imageStackCaption,
+  imageStackCards,
+  imageStackFocusedIndex,
+  imageStackHitIndex,
+  imageStackShouldOpenOnRelease,
+  imageStackSize,
+  LONG_PRESS_MS,
+  MAX_FANNED,
+  REST_SCALE,
+  SINGLE_SIZE,
+} from "../lib/image-stack-layout";
+import type { ImageArtifactPreviewTarget } from "./image-artifact-viewer";
+
+export type ImageCardUpload =
+  | { kind: "done" }
+  | { kind: "uploading"; progress?: number }
+  | { kind: "failed" };
+
+export type ImageCardSource = {
+  id: string;
+  uri?: string;
+  name?: string;
+  upload?: ImageCardUpload;
+};
+
+export type MessageImageItem = ImageArtifactPreviewTarget & { upload?: ImageCardUpload };
+
+function cardPose(
+  cards: readonly ImageStackCard[],
+  index: number,
+  box: { width: number; height: number },
+) {
+  const card = cards.find((item) => item.index === index);
+  if (!card) {
+    return { x: box.width / 2, y: box.height / 2, rotation: 0, zIndex: 0, visible: false };
+  }
+  return {
+    x: box.width / 2 + card.offset.width,
+    y: box.height / 2 + card.offset.height,
+    rotation: card.rotation,
+    zIndex: card.zIndex,
+    visible: true,
+  };
+}
+
+function ImageStackCardView({
+  source,
+  width,
+  height,
+  rest,
+  fan,
+  fanned,
+  focused,
+  index,
+  onRetry,
+}: {
+  source: ImageCardSource;
+  width: number;
+  height: number;
+  rest: ReturnType<typeof cardPose>;
+  fan: ReturnType<typeof cardPose>;
+  fanned: Animated.SharedValue<number>;
+  focused: Animated.SharedValue<number>;
+  index: number;
+  onRetry?: () => void;
+}) {
+  const style = useAnimatedStyle(() => {
+    const t = fanned.value;
+    const x = rest.x + (fan.x - rest.x) * t;
+    const y = rest.y + (fan.y - rest.y) * t;
+    const rotation = rest.rotation + (fan.rotation - rest.rotation) * t;
+    const highlight = index === focused.value ? HIGHLIGHT_SCALE : REST_SCALE;
+    const scale = 1 + (highlight - 1) * t;
+    const restOpacity = rest.visible ? 1 : 0;
+    const fanOpacity = fan.visible ? 1 : 0;
+    const opacity = restOpacity + (fanOpacity - restOpacity) * t;
+    const zIndex = t > 0.5 ? fan.zIndex : rest.zIndex;
+    return {
+      opacity,
+      zIndex,
+      transform: [
+        { translateX: x - width / 2 },
+        { translateY: y - height / 2 },
+        { rotate: `${rotation}deg` },
+        { scale },
+      ],
+    };
+  });
+  const upload = source.upload ?? { kind: "done" as const };
+  return (
+    <Animated.View
+      pointerEvents="none"
+      style={[styles.card, { width, height, borderRadius: CORNER_RADIUS }, style]}
+    >
+      {source.uri ? (
+        <Image source={{ uri: source.uri }} style={styles.fill} accessibilityIgnoresInvertColors />
+      ) : (
+        <View style={[styles.fill, styles.placeholder]} />
+      )}
+      {upload.kind === "uploading" ? (
+        <View style={styles.badge} accessibilityLabel="正在上传">
+          <View style={styles.ringTrack} />
+          <View
+            style={[
+              styles.ringFill,
+              {
+                transform: [
+                  { rotate: `${-90 + 360 * Math.max(0.02, upload.progress ?? 0.15)}deg` },
+                ],
+              },
+            ]}
+          />
+        </View>
+      ) : null}
+      {upload.kind === "failed" && onRetry ? (
+        <Pressable
+          pointerEvents="auto"
+          accessibilityRole="button"
+          accessibilityLabel="重试"
+          onPress={onRetry}
+          style={styles.retry}
+        >
+          <Text style={styles.retryLabel}>重试</Text>
+        </Pressable>
+      ) : null}
+    </Animated.View>
+  );
+}
+
+/**
+ * One image is a rounded card; several images fan into a stack with "N 张图片".
+ * A long-press spreads the stack; sliding left/right (finger still down) highlights
+ * the current card with light haptics; releasing after a slide opens that image.
+ * The long-press must live on this view, not on the message menu around it.
+ */
+export function ImageCardStack({
+  sources,
+  alignment = "trailing",
+  onOpen,
+  onRetry,
+}: {
+  sources: readonly ImageCardSource[];
+  alignment?: "leading" | "trailing";
+  onOpen: (index: number) => void;
+  onRetry?: () => void;
+}) {
+  const tokens = mobileTokens();
+  const count = sources.length;
+  const box = imageStackSize(count);
+  const size = count === 1 ? SINGLE_SIZE : CARD_SIZE;
+  const caption = imageStackCaption(count);
+  const visible = Math.min(count, MAX_FANNED);
+  const restCards = useMemo(() => imageStackCards(count, false), [count]);
+  const fanCards = useMemo(() => imageStackCards(count, true), [count]);
+  const fanned = useSharedValue(0);
+  const focused = useSharedValue(0);
+  const startX = useSharedValue(0);
+  const startY = useSharedValue(0);
+  const startedFanned = useSharedValue(0);
+  const opened = useSharedValue(0);
+
+  const openAt = (index: number) => {
+    opened.value = 0;
+    fanned.value = withTiming(0, { duration: 160, easing: Easing.out(Easing.cubic) });
+    focused.value = 0;
+    onOpen(ImageViewerIndexSafe(index, count));
+  };
+
+  const collapse = () => {
+    fanned.value = withSpring(0, { damping: 18, stiffness: 240 });
+    focused.value = 0;
+  };
+
+  useEffect(() => {
+    fanned.value = 0;
+    focused.value = 0;
+  }, [count, fanned, focused]);
+
+  const scrub = Gesture.Pan()
+    .enabled(count > 1)
+    .activateAfterLongPress(LONG_PRESS_MS)
+    .maxPointers(1)
+    .onStart((event) => {
+      startedFanned.value = fanned.value;
+      startX.value = event.x;
+      startY.value = event.y;
+      opened.value = 0;
+      const next = imageStackFocusedIndex(event.x, count);
+      focused.value = next;
+      if (fanned.value < 0.5) {
+        fanned.value = withSpring(1, { damping: 16, stiffness: 220, mass: 0.7 });
+        runOnJS(hapticImpact)();
+      }
+    })
+    .onUpdate((event) => {
+      const next = imageStackFocusedIndex(event.x, count);
+      if (next !== focused.value) {
+        focused.value = next;
+        runOnJS(hapticSelection)();
+      }
+    })
+    .onFinalize((event) => {
+      const dx = event.x - startX.value;
+      const dy = event.y - startY.value;
+      const translation = Math.hypot(dx, dy);
+      if (imageStackShouldOpenOnRelease(translation)) {
+        const index = Math.round(focused.value);
+        opened.value = 1;
+        runOnJS(openAt)(index);
+      } else if (startedFanned.value > 0.5) {
+        runOnJS(collapse)();
+      }
+    });
+
+  const tap = Gesture.Tap()
+    .maxDuration(400)
+    .onEnd((event) => {
+      const index = imageStackHitIndex({ x: event.x, y: event.y }, count, fanned.value > 0.5);
+      runOnJS(openAt)(index);
+    });
+
+  // The long-press pan must win over a message context menu; the tap waits for it to fail.
+  const gesture = Gesture.Exclusive(scrub, tap);
+
+  if (count <= 0) return null;
+
+  return (
+    <View
+      style={{ alignItems: alignment === "leading" ? "flex-start" : "flex-end" }}
+      accessibilityElementsHidden={false}
+    >
+      <GestureDetector gesture={gesture}>
+        <Animated.View
+          testID="imageStack"
+          accessible
+          accessibilityRole="button"
+          accessibilityLabel={caption ?? sources[0]?.name ?? "图片"}
+          accessibilityHint="轻点全屏查看"
+          style={{ width: box.width, height: box.height }}
+        >
+          {Array.from({ length: visible }, (_, index) => (
+            <ImageStackCardView
+              key={sources[index]?.id ?? String(index)}
+              source={sources[index]!}
+              width={size.width}
+              height={size.height}
+              rest={cardPose(restCards, index, box)}
+              fan={cardPose(fanCards, index, box)}
+              fanned={fanned}
+              focused={focused}
+              index={index}
+              onRetry={onRetry}
+            />
+          ))}
+        </Animated.View>
+      </GestureDetector>
+      {caption ? (
+        <View style={styles.captionRow}>
+          <Text style={[styles.caption, { color: tokens.mutedForeground }]}>{caption}</Text>
+        </View>
+      ) : null}
+    </View>
+  );
+}
+
+function ImageViewerIndexSafe(index: number, count: number): number {
+  return Math.max(0, Math.min(index, Math.max(count - 1, 0)));
+}
+
+/** Loads artifact previews and renders them as a stack in a chat bubble. */
+export function MessageImageStack({
+  items,
+  threadTarget,
+  alignment,
+  onOpen,
+}: {
+  items: readonly MessageImageItem[];
+  threadTarget: MobileArtifactTarget;
+  alignment?: "leading" | "trailing";
+  onOpen: (index: number) => void;
+}) {
+  const [uris, setUris] = useState<Record<string, string>>({});
+  const botId = "botId" in threadTarget ? threadTarget.botId : undefined;
+  const groupId = "groupId" in threadTarget ? threadTarget.groupId : undefined;
+  const ids = items.map((item) => item.artifactId).join("|");
+
+  useEffect(() => {
+    let cancelled = false;
+    const target: MobileArtifactTarget = botId !== undefined ? { botId } : { groupId: groupId! };
+    void Promise.all(
+      items.map(async (item) => {
+        try {
+          const loaded = await imageArtifactPreview(target, item.artifactId, item.mimeType);
+          return [item.artifactId, loaded.uri] as const;
+        } catch {
+          return [item.artifactId, ""] as const;
+        }
+      }),
+    ).then((entries) => {
+      if (cancelled) return;
+      const next: Record<string, string> = {};
+      for (const [id, uri] of entries) if (uri) next[id] = uri;
+      setUris(next);
+    });
+    return () => {
+      cancelled = true;
+    };
+    // item identities are listed in `ids`.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [botId, groupId, ids]);
+
+  const sources = items.map((item) => ({
+    id: item.artifactId,
+    uri: uris[item.artifactId],
+    name: item.name,
+    upload: item.upload,
+  }));
+
+  return <ImageCardStack sources={sources} alignment={alignment} onOpen={onOpen} />;
+}
+
+const styles = StyleSheet.create({
+  card: {
+    position: "absolute",
+    left: 0,
+    top: 0,
+    overflow: "hidden",
+    backgroundColor: "rgba(127,127,127,0.18)",
+    borderWidth: StyleSheet.hairlineWidth,
+    borderColor: "rgba(255,255,255,0.12)",
+    shadowColor: "#000",
+    shadowOpacity: 0.16,
+    shadowRadius: 6,
+    shadowOffset: { width: 0, height: 2 },
+  },
+  fill: { width: "100%", height: "100%" },
+  placeholder: { backgroundColor: "rgba(127,127,127,0.25)" },
+  captionRow: {
+    marginTop: CAPTION_SPACING,
+    height: CAPTION_HEIGHT,
+    flexDirection: "row",
+    alignItems: "center",
+    justifyContent: "flex-end",
+    gap: 4,
+  },
+  caption: { fontSize: 13, lineHeight: 18 },
+  badge: {
+    ...StyleSheet.absoluteFillObject,
+    alignItems: "center",
+    justifyContent: "center",
+    backgroundColor: "rgba(0,0,0,0.35)",
+  },
+  ringTrack: {
+    width: 44,
+    height: 44,
+    borderRadius: 22,
+    borderWidth: 3,
+    borderColor: "rgba(255,255,255,0.3)",
+    position: "absolute",
+  },
+  ringFill: {
+    width: 44,
+    height: 44,
+    borderRadius: 22,
+    borderWidth: 3,
+    borderColor: "white",
+    borderRightColor: "transparent",
+    borderBottomColor: "transparent",
+  },
+  retry: {
+    position: "absolute",
+    alignSelf: "center",
+    top: "45%",
+    backgroundColor: "rgba(220,50,50,0.85)",
+    paddingHorizontal: 12,
+    paddingVertical: 8,
+    borderRadius: 14,
+  },
+  retryLabel: { color: "white", fontSize: 13, fontWeight: "600" },
+});
