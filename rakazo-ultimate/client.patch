+    expect(ImageStackLayout.height(0)).toBe(0);
+    expect(ImageStackLayout.height(1)).toBe(ImageStackLayout.singleSize.height);
+    const h3 = ImageStackLayout.height(3);
+    expect(h3).toBe(
+      ImageStackLayout.cardSize.height +
+        2 * ImageStackLayout.stackInset.height +
+        ImageStackLayout.captionSpacing +
+        ImageStackLayout.captionHeight,
+    );
+    expect(ImageStackLayout.height(2)).toBe(ImageStackLayout.height(20));
+    expect(ImageStackLayout.stackSize(4).width).toBeGreaterThanOrEqual(
+      ImageStackLayout.cardSize.width + 28,
+    );
+  });
+
+  it("hit-tests the top card when fanned and always the first card when stacked", () => {
+    const box = ImageStackLayout.stackSize(3);
+    expect(ImageStackLayout.hitIndex({ x: box.width / 2, y: box.height / 2 }, 3, false)).toBe(0);
+    const fan3 = ImageStackLayout.cards(3, true);
+    const cx = box.width / 2;
+    const cy = box.height / 2;
+    const topCard = fan3.reduce((best, card) => (card.zIndex > best.zIndex ? card : best));
+    expect(
+      ImageStackLayout.hitIndex(
+        { x: cx + topCard.offset.width, y: cy + topCard.offset.height },
+        3,
+        true,
+      ),
+    ).toBe(topCard.index);
+    const left = fan3.reduce((best, card) => (card.offset.width < best.offset.width ? card : best));
+    const half = ImageStackLayout.cardSize.width / 2;
+    expect(
+      ImageStackLayout.hitIndex(
+        { x: cx + left.offset.width - half + 4, y: cy + left.offset.height },
+        3,
+        true,
+      ),
+    ).toBe(left.index);
+    expect(ImageStackLayout.hitIndex({ x: -500, y: -500 }, 3, true)).toBe(0);
+  });
+
+  it("follows a horizontal scrub and opens only after the threshold", () => {
+    const midX = ImageStackLayout.stackSize(3).width / 2;
+    expect(ImageStackLayout.focusedIndex(midX, 3)).toBe(1);
+    expect(ImageStackLayout.focusedIndex(midX - ImageStackLayout.fanSpacing, 3)).toBe(0);
+    expect(ImageStackLayout.focusedIndex(midX + ImageStackLayout.fanSpacing, 3)).toBe(2);
+    expect(ImageStackLayout.focusedIndex(midX, 1)).toBe(0);
+    expect(ImageStackLayout.scale(2, 2, true)).toBe(ImageStackLayout.highlightScale);
+    expect(ImageStackLayout.scale(0, 2, true)).toBe(ImageStackLayout.restScale);
+    expect(ImageStackLayout.scale(2, 2, false)).toBe(1);
+    expect(ImageStackLayout.shouldOpenOnRelease(ImageStackLayout.scrubThreshold)).toBe(true);
+    expect(ImageStackLayout.shouldOpenOnRelease(ImageStackLayout.scrubThreshold + 30)).toBe(true);
+    expect(ImageStackLayout.shouldOpenOnRelease(4)).toBe(false);
+    expect(ImageStackLayout.shouldOpenOnRelease(-4)).toBe(false);
+  });
+});
+
+describe("ImageStackLayout's own source", () => {
+  // The shipped build rewrites these functions to run on the UI thread, and a method written
+  // inside the object literal could not see the object it belongs to: v27 crashed on its first
+  // image card with "Cannot read property 'singleSize' of undefined". The literal must stay a
+  // plain table of constants and module-level functions.
+  const source = readFileSync(new URL("./image-stack-layout.ts", import.meta.url), "utf8");
+  const start = source.indexOf("export const ImageStackLayout = {");
+  const end = source.indexOf("} as const;", start);
+  const literal = source.slice(start, end);
+
+  it("keeps the object literal a table, not a place where functions live", () => {
+    expect(start).toBeGreaterThan(-1);
+    expect(end).toBeGreaterThan(start);
+    expect(literal).not.toContain("'worklet'");
+    expect(literal).not.toContain("ImageStackLayout.");
+  });
+
+  it("reads its geometry from module-level constants", () => {
+    expect(ImageStackLayout.singleSize.width).toBe(210);
+    expect(ImageStackLayout.cardSize.height).toBe(210);
+    expect(ImageStackLayout.stackInset.width).toBe(28);
+    expect(ImageStackLayout.cornerRadius).toBe(18);
+    expect(ImageStackLayout.longPressMs).toBe(350);
+    expect(ImageStackLayout.maxStacked).toBe(3);
+    expect(ImageStackLayout.maxFanned).toBe(5);
+  });
+
+  it("answers the same numbers through the functions and through the table", () => {
+    for (const count of [0, 1, 2, 3, 5, 20]) {
+      expect(ImageStackLayout.stackSize(count)).toEqual(imageStackSize(count));
+      expect(ImageStackLayout.height(count)).toEqual(imageStackHeight(count));
+      expect(ImageStackLayout.cards(count, true)).toEqual(imageStackCards(count, true));
+      expect(ImageStackLayout.caption(count)).toEqual(imageStackCaption(count));
+    }
+    expect(imageStackCardSize(1)).toEqual({ width: 210, height: 210 });
+    expect(imageStackCardSize(4)).toEqual({ width: 168, height: 210 });
+    expect(imageStackFocusedIndex(0, 1)).toBe(0);
+    expect(imageStackHitIndex({ x: 0, y: 0 }, 1, false)).toBe(0);
+    expect(imageStackScale(0, 0, false)).toBe(1);
+    expect(imageStackShouldOpenOnRelease(0)).toBe(false);
+  });
+});
+
+describe("ComposerAttachLayout", () => {
+  it("keeps a large thumbnail strip above a text area that is never squeezed", () => {
+    expect(ComposerAttachLayout.thumbSize.width).toBeGreaterThanOrEqual(120);
+    expect(ComposerAttachLayout.thumbSize.height).toBeGreaterThanOrEqual(120);
+    expect(ComposerAttachLayout.composerMinHeight(0)).toBe(ComposerAttachLayout.textMinHeight);
+    const attachH1 = ComposerAttachLayout.composerMinHeight(1);
