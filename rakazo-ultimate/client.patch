+  id: string,
+  { botId, botName }: { botId: string; botName?: string },
+) {
+  if (id === "profile") router.push({ pathname: "/bot-profile", params: { botId, name: botName ?? "" } });
+  else if (id === "settings") router.push({ pathname: "/bot-settings", params: { botId } });
+  else if (id === "share-template") {
+    void shareBotAsTemplate(botId).catch((error: unknown) =>
+      Alert.alert(t`Could not share this Bot`, errorText(error, t`Try again.`)),
+    );
+  } else if (id === "invite") openInvite();
+  else if (id === "delete") {
+    // The same confirmation and recovery the inbox row uses; the chat closes onto the inbox.
+    void confirmDeleteBot({ id: botId, name: botName ?? t`Bot` }, () => {
+      if (router.canGoBack()) router.back();
+      else router.replace("/");
+    }).catch((error) =>
+      Alert.alert(t`Could not delete bot`, error instanceof Error ? error.message : t`Try again.`),
+    );
+  }
+}
+
+/** The `···` button on iOS before 26, where a native header menu is not available. */
+function BotChatMenuButton({
+  actions,
+  botId,
+  botName,
+  color,
+}: {
+  actions: MenuAction[];
+  botId: string;
+  botName?: string;
+  color: string;
+}) {
+  return (
+    <MenuView
+      actions={actions}
+      colorScheme={resolveMobileAppearance()}
+      onPressAction={(event) => runBotChatAction(event.nativeEvent.event, { botId, botName })}
+    >
+      <Pressable accessibilityRole="button" accessibilityLabel={t`Chat actions`} hitSlop={8}>
+        <NativeSymbol ios="ellipsis" android="ellipsis-horizontal" size={21} color={color} />
+      </Pressable>
+    </MenuView>
+  );
+}
