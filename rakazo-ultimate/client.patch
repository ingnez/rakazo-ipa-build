+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+const store = vi.hoisted(() => new Map<string, string>());
+
+vi.mock("expo-secure-store", () => ({
+  getItemAsync: vi.fn(async (key: string) => store.get(key) ?? null),
+  setItemAsync: vi.fn(async (key: string, value: string) => {
+    store.set(key, value);
+  }),
+}));
+
+describe("keep-original image send preference", () => {
+  beforeEach(async () => {
+    store.clear();
+    vi.resetModules();
+    const mod = await import("./image-send-preference.js");
+    mod.resetKeepOriginalImagesForTests(false);
+  });
+
+  it("defaults to compressing and persists a change", async () => {
+    const mod = await import("./image-send-preference.js");
+    expect(mod.getKeepOriginalImages()).toBe(false);
+    await mod.setKeepOriginalImages(true);
+    expect(mod.getKeepOriginalImages()).toBe(true);
+    expect(store.get("imageSend.keepOriginal")).toBe("true");
+  });
+
+  it("notifies subscribers when the toggle changes", async () => {
+    const mod = await import("./image-send-preference.js");
+    const seen: boolean[] = [];
+    const stop = mod.subscribeKeepOriginalImages(() => seen.push(mod.getKeepOriginalImages()));
+    await mod.setKeepOriginalImages(true);
+    await mod.setKeepOriginalImages(false);
+    stop();
+    expect(seen).toEqual([true, false]);
+  });
+});
diff --git a/apps/mobile/lib/image-send-preference.ts b/apps/mobile/lib/image-send-preference.ts
new file mode 100644
index 000000000..d7f0be54f
--- /dev/null
+++ b/apps/mobile/lib/image-send-preference.ts
@@ -0,0 +1,60 @@
+import * as SecureStore from "expo-secure-store";
+import { ImageSendPolicy } from "./image-stack-layout";
+
+let keepOriginal = false;
+let loaded = false;
+let changedLocally = false;
+let loadTask: Promise<void> | undefined;
+let writeTask = Promise.resolve();
+const listeners = new Set<() => void>();
+
+function notify(): void {
+  for (const listener of listeners) listener();
+}
+
+export function getKeepOriginalImages(): boolean {
+  return keepOriginal;
+}
+
+export function subscribeKeepOriginalImages(listener: () => void): () => void {
+  listeners.add(listener);
+  return () => {
+    listeners.delete(listener);
+  };
+}
+
+export function loadKeepOriginalImages(): Promise<void> {
+  if (loadTask) return loadTask;
+  loadTask = Promise.resolve().then(async () => {
+    try {
+      const stored = await SecureStore.getItemAsync(ImageSendPolicy.keepOriginalKey);
+      if (!changedLocally) keepOriginal = stored === "true";
+      loaded = true;
+    } catch {
+      loadTask = undefined;
+    } finally {
+      notify();
+    }
+  });
+  return loadTask;
+}
+
+export function setKeepOriginalImages(value: boolean): Promise<void> {
+  keepOriginal = value;
+  changedLocally = true;
+  loaded = true;
+  notify();
+  const writing = writeTask.then(() =>
+    SecureStore.setItemAsync(ImageSendPolicy.keepOriginalKey, String(value)),
+  );
+  writeTask = writing.catch(() => undefined);
+  return writing;
+}
+
+/** Test-only: reset the in-memory flag without touching storage. */
+export function resetKeepOriginalImagesForTests(value = false): void {
+  keepOriginal = value;
+  loaded = true;
+  changedLocally = true;
+  loadTask = Promise.resolve();
+}
