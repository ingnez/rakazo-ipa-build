+
+/**
+ * Whether a block draws the file card itself, and so takes the message's whole width. A clip that
+ * plays in place wears its own pill instead, which keeps the size of its own controls.
+ */
+function isFileCardAttachment(attachment: Extract<MessageBlock, { kind: "image" | "file" }>) {
+  return attachment.kind === "file" && !isAudioAttachment(attachment);
+}
+
+/** Whether a file block plays as a clip here rather than standing as a card. */
+function isAudioAttachment(attachment: Extract<MessageBlock, { kind: "image" | "file" }>) {
+  return Boolean(attachment.artifactId) && isAttachmentAudioMimeType(attachment.mimeType ?? "");
+}
+
+/**
+ * A file block as its own card: a tap previews it when the app can draw it, and otherwise
+ * downloads it to the share sheet. The card owns the wait, so a slow or failed download says so
+ * instead of leaving the tap unanswered.
+ */
+function MessageFileAttachment({
+  attachment,
+  target,
+  onPreviewFile,
+  actionProps,
+}: {
+  attachment: Extract<MessageBlock, { kind: "file" }>;
+  target: MobileArtifactTarget;
+  onPreviewFile: (artifactId: string) => void;
+  actionProps: MessageActionProps;
+}) {
+  const { t } = useLingui();
+  const [busy, setBusy] = useState(false);
+  const artifactId = attachment.artifactId;
+  const mimeType = attachment.mimeType ?? "";
+
+  async function open() {
+    if (!artifactId) {
+      Alert.alert(t`This file is not ready yet`, t`It is still uploading. Try again in a moment.`);
+      return;
+    }
+    if (artifactPreviewKind(mimeType) !== "none") {
+      onPreviewFile(artifactId);
+      return;
+    }
+    setBusy(true);
+    try {
+      await openMobileArtifact(
+        target,
+        artifactId,
+        attachment.name ?? t`File`,
+        mimeType || "application/octet-stream",
+      );
+    } catch (err) {
+      Alert.alert(t`Could not open file`, errorText(err, t`Try again.`));
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  return (
+    <FileAttachmentCard
+      accessibilityActions={actionProps.accessibilityActions}
+      busy={busy}
+      mimeType={mimeType}
+      name={attachment.name ?? t`File`}
+      onAccessibilityAction={actionProps.onAccessibilityAction}
+      onLongPress={actionProps.onLongPress}
+      onPress={() => void open()}
+      size={attachment.size}
+    />
+  );
+}
