+import type { RealtimeCallPlan, RealtimeVoiceCatalog, RealtimeVoiceProvider } from "@rakazo/contracts";
+import type { ApiRequestContext } from "./api";
+import { captureApiRequestContext, rpc } from "./api";
+import { realtimeAudioAvailable } from "./realtime-audio";
+
+/**
+ * Which live-call provider this account can use, and the exact plan for one call.
+ *
+ * The account's speech-to-speech key is the same one its voice settings already hold, so a call
+ * needs no setup of its own; the catalog only says which of those connections the gateway can hold
+ * a live call with (`edge-tts`, a speak-only voice, cannot).
+ */
+
+/** The providers a live call can use, or nothing when this server or build cannot hold one. */
+export async function loadRealtimeCatalog(): Promise<RealtimeVoiceCatalog | null> {
+  let catalog: RealtimeVoiceCatalog;
+  try {
+    catalog = await rpc("voice/realtimeCatalog");
+  } catch {
+    // A server from before live calls answers 404 here: the turn-based call still works.
+    return null;
+  }
+  // The gateway can hold the call; this build has to be able to carry its audio.
+  if (!(await realtimeAudioAvailable())) return null;
+  return catalog;
+}
+
+/** The provider a call should use: the catalog's own pick, when the account holds its key. */
+export function realtimeProvider(catalog: RealtimeVoiceCatalog | null): RealtimeVoiceProvider | null {
+  if (!catalog) return null;
+  const preferred = catalog.providers.find((provider) => provider.id === catalog.preferred);
+  const chosen = preferred?.connected
+    ? preferred
+    : catalog.providers.find((provider) => provider.connected);
+  return chosen ?? null;
+}
+
+/**
+ * The plan for calling this bot in full duplex, or null when that is not possible — no key, no
+ * microphone path in this build, an older server, or a bot the gateway will not call.
+ */
+export async function realtimePlanFor(
+  botId: string,
+  requestContext?: ApiRequestContext,
+): Promise<RealtimeCallPlan | null> {
+  const catalog = await loadRealtimeCatalog();
+  const provider = realtimeProvider(catalog);
+  if (!provider) return null;
+  try {
+    return await rpc(
+      "voice/realtimeCall",
+      { botId, provider: provider.id },
+      { requestContext, timeoutMs: 15_000 },
+    );
+  } catch {
+    return null;
+  }
+}
+
+/** The request context a plan was made in, so its socket is opened in the same one. */
+export async function realtimeRequestContext(): Promise<ApiRequestContext> {
+  return captureApiRequestContext();
+}
diff --git a/apps/mobile/lib/scenario-models.ts b/apps/mobile/lib/scenario-models.ts
new file mode 100644
