+const EYE_SKIN_MIN = 1.6;
+/** How far inside the body's own outline the eyes are kept, so no lid ever crosses the edge. */
+const EYE_BODY_INSET = 0.94;
+
+/** A body's outer ring as a path, `morph` of the way from one body to another. */
+export function babygrokBodyPath(
+  from: readonly number[],
+  to: readonly number[],
+  morph: number,
+): string {
+  "worklet";
+  let path = "";
+  for (let index = 0; index < from.length; index += 2) {
+    const x = round(from[index]! + (to[index]! - from[index]!) * morph);
+    const y = round(from[index + 1]! + (to[index + 1]! - from[index + 1]!) * morph);
