index 000000000..f0cf35886
--- /dev/null
+++ b/apps/mobile/lib/after-first-paint.test.tsx
@@ -0,0 +1,97 @@
+/** @vitest-environment jsdom */
+
+import { act, createElement, useEffect } from "react";
+import { createRoot } from "react-dom/client";
+import type { Root } from "react-dom/client";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+// React Native 0.88 ships no InteractionManager in release builds: the hook must not need it.
+vi.mock("react-native", () => ({}));
+
+import { useAfterFirstPaint } from "./after-first-paint";
+
+let root: Root;
+let container: HTMLDivElement;
+const frames: Array<FrameRequestCallback> = [];
+
+beforeEach(() => {
+  vi.useFakeTimers({ toFake: ["setTimeout", "clearTimeout"] });
+  container = document.createElement("div");
+  document.body.appendChild(container);
+  root = createRoot(container);
+  frames.length = 0;
+  vi.stubGlobal("requestAnimationFrame", (cb: FrameRequestCallback) => {
+    frames.push(cb);
+    return frames.length;
+  });
+  vi.stubGlobal("cancelAnimationFrame", (id: number) => {
+    frames[id - 1] = () => undefined;
+  });
+});
+
+afterEach(() => {
+  act(() => root.unmount());
+  container.remove();
+  vi.unstubAllGlobals();
+  vi.useRealTimers();
+});
+
+function Probe({ onValue }: { onValue: (value: boolean) => void }) {
+  const ready = useAfterFirstPaint();
+  useEffect(() => {
+    onValue(ready);
+  }, [ready, onValue]);
+  return createElement("span", { "data-ready": String(ready) });
+}
+
+function flushFrame() {
+  const next = frames.shift();
+  if (next) act(() => next(0));
+}
+
+function flushIdle() {
+  act(() => {
+    vi.runOnlyPendingTimers();
+  });
+}
+
+describe("useAfterFirstPaint", () => {
+  it("is false on the first commit, before any frame has been drawn", () => {
+    const values: boolean[] = [];
+    act(() => root.render(<Probe onValue={(value) => values.push(value)} />));
+    expect(container.querySelector("span")?.getAttribute("data-ready")).toBe("false");
+    expect(values[0]).toBe(false);
+  });
+
+  it("stays false after one frame, and becomes true after the second frame once the thread is idle", () => {
+    const values: boolean[] = [];
+    act(() => root.render(<Probe onValue={(value) => values.push(value)} />));
+    flushFrame();
+    expect(container.querySelector("span")?.getAttribute("data-ready")).toBe("false");
+    flushFrame();
+    flushIdle();
+    expect(container.querySelector("span")?.getAttribute("data-ready")).toBe("true");
+    expect(values.at(-1)).toBe(true);
+  });
+
+  it("does not flip to true if the component unmounts before the second frame", () => {
+    const values: boolean[] = [];
+    act(() => root.render(<Probe onValue={(value) => values.push(value)} />));
+    flushFrame();
+    act(() => root.unmount());
+    flushFrame();
+    expect(values.at(-1)).toBe(false);
+  });
+
+  it("uses requestIdleCallback when the host has it", () => {
+    const idle: Array<() => void> = [];
+    vi.stubGlobal("requestIdleCallback", (cb: () => void) => idle.push(cb));
+    vi.stubGlobal("cancelIdleCallback", () => undefined);
+    act(() => root.render(<Probe onValue={() => undefined} />));
+    flushFrame();
+    flushFrame();
+    expect(idle).toHaveLength(1);
+    act(() => idle[0]!());
+    expect(container.querySelector("span")?.getAttribute("data-ready")).toBe("true");
+  });
+});
diff --git a/apps/mobile/lib/after-first-paint.ts b/apps/mobile/lib/after-first-paint.ts
new file mode 100644
index 000000000..fd051d523
--- /dev/null
+++ b/apps/mobile/lib/after-first-paint.ts
@@ -0,0 +1,33 @@
+import { useEffect, useState } from "react";
+import { runWhenIdle } from "./run-when-idle";
+
+/**
+ * False on the first commit, then true once the first two frames have been
+ * drawn and the JS thread is idle. Callers should keep first paint cheap
+ * (static pictures, no Reanimated loops) until this flips.
+ *
+ * Nothing here may throw at startup: this runs on the home screen and on every avatar.
+ */
+export function useAfterFirstPaint(): boolean {
+  const [ready, setReady] = useState(false);
+  useEffect(() => {
+    let cancelled = false;
+    let inner = 0;
+    let cancelIdle: (() => void) | undefined;
+    const outer = requestAnimationFrame(() => {
+      inner = requestAnimationFrame(() => {
+        if (cancelled) return;
+        cancelIdle = runWhenIdle(() => {
+          if (!cancelled) setReady(true);
+        });
+      });
+    });
+    return () => {
+      cancelled = true;
+      cancelAnimationFrame(outer);
+      cancelAnimationFrame(inner);
+      cancelIdle?.();
+    };
+  }, []);
+  return ready;
+}
