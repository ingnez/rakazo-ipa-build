@@ -0,0 +1,34 @@
+import { requireOptionalNativeModule } from "expo-modules-core";
+
+/** One chosen photo, as the picker's module hands it over: a file it already copied out. */
+export type PickedPhoto = {
+  uri: string;
+  name: string;
+  mimeType?: string | null;
+  width?: number;
+  height?: number;
+};
+
+export type PhotoPickResult = {
+  canceled: boolean;
+  assets?: PickedPhoto[];
+  /** Why the picker itself failed, when it did: the composer shows it instead of staying quiet. */
+  error?: string;
+};
+
+type NativePhotoPicker = {
+  pickImages(limit: number): Promise<PhotoPickResult>;
+};
+
+// The app's own picker. Binaries built before it existed fall back to expo-image-picker.
+const native = requireOptionalNativeModule<NativePhotoPicker>("PhotoPicker");
+
+export function hasNativePhotoPicker(): boolean {
+  return typeof native?.pickImages === "function";
+}
+
+/** Opens the system photo library and resolves with the files it picked. */
+export async function pickPhotos(limit: number): Promise<PhotoPickResult> {
+  if (!native?.pickImages) return { canceled: true, assets: [], error: "no photo picker" };
+  return native.pickImages(limit);
+}
