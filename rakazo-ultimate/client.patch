@@ -0,0 +1,129 @@
+import { InfisicalSecretStore } from "@rakazo/adapters";
+import { describe, expect, it, vi } from "vitest";
+import { infisicalFake } from "../../../../packages/adapters/src/secrets/secret-store-fake.js";
+import { DATABASE_CHECK_TIMEOUT_MS, healthRoutes } from "./health.js";
+
+const app = healthRoutes(() => ({ runtime: "pi", sandbox: "docker", revision: "abc123" }));
+
+describe("health routes", () => {
+  it("reports degraded readiness during a store outage and recovers on later reads", async () => {
+    const fake = infisicalFake();
+    const writer = new InfisicalSecretStore(fake.options);
+    const record = await writer.put("fake", {
+      operationId: "test",
+      traceId: "test",
+      userId: "test",
+      spaceId: "test",
+      signal: new AbortController().signal,
+    });
+    await writer.close();
+    fake.offline = true;
+    const store = new InfisicalSecretStore(fake.options);
+    await store.start();
+    const health = healthRoutes(() => ({ degraded: store.describe().capabilities.degraded }));
+    try {
+      const response = await health.request("/ready");
+      expect(response.status).toBe(503);
+      await expect(response.json()).resolves.toEqual({ ok: false, degraded: true });
+      expect((await health.request("/health")).status).toBe(200);
+      fake.offline = false;
+      await store.load(record.ref, record.id);
+      expect((await health.request("/ready")).status).toBe(200);
+    } finally {
+      await store.close();
+    }
+  });
+  it("reports not ready while the database is unreachable", async () => {
+    let up = false;
+    const health = healthRoutes(
+      () => ({}),
+      async () => {
+        if (!up) throw new Error("connection refused");
+      },
+    );
+    const response = await health.request("/ready");
+    expect(response.status).toBe(503);
+    await expect(response.json()).resolves.toEqual({
+      ok: false,
+      degraded: false,
+      database: "unreachable",
+    });
+    expect((await health.request("/health")).status).toBe(200);
+    up = true;
+    expect((await health.request("/ready")).status).toBe(200);
+  });
+
+  it("answers 503 at the deadline while the database hangs, with one probe at a time", async () => {
+    vi.useFakeTimers();
+    try {
+      const check = vi.fn(() => new Promise<never>(() => {}));
+      const health = healthRoutes(() => ({}), check);
+      const first = health.request("/ready");
+      const second = health.request("/ready");
+      expect((await health.request("/health")).status).toBe(200);
+      await vi.advanceTimersByTimeAsync(DATABASE_CHECK_TIMEOUT_MS);
+      expect((await first).status).toBe(503);
+      expect((await second).status).toBe(503);
+      expect(check).toHaveBeenCalledTimes(1);
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+
+  it("keeps public liveness free of deployment details", async () => {
+    const response = await app.request("/health");
+    expect(response.status).toBe(200);
+    await expect(response.json()).resolves.toEqual({ ok: true });
+  });
+
+  it("serves details to direct requests on the API port", async () => {
+    const response = await app.request("/internal/health");
+    expect(response.status).toBe(200);
+    await expect(response.json()).resolves.toEqual({
+      ok: true,
+      runtime: "pi",
+      sandbox: "docker",
+      revision: "abc123",
+      telemetry: { failures: 0, lastFailureAt: null, degraded: false, droppedLines: 0 },
+    });
+  });
+
+  it("hides details from requests that came through a reverse proxy", async () => {
+    const proxied: Record<string, string>[] = [
+      { "x-forwarded-for": "203.0.113.7" },
+      { forwarded: "for=203.0.113.7;proto=https" },
+    ];
+    for (const headers of proxied) {
+      const response = await app.request("/internal/health", { headers });
+      expect(response.status).toBe(404);
+    }
+  });
+
+  /** Answers as a connection from `remoteAddress` would, which app.request has no socket for. */
+  const fromPeer = (remoteAddress: string, headers: Record<string, string> = {}) =>
+    app.fetch(new Request("http://api.test/internal/health", { headers }), {
+      incoming: { socket: { remoteAddress } },
+    });
+
+  it("answers deployment details to a caller on this deployment's network", async () => {
+    // Loopback, the IPv4-mapped form a dual-stack listener reports, and the bridge address a
+    // published container port reports, which is how the documented curls reach the API port.
+    for (const address of ["127.0.0.1", "::1", "::ffff:127.0.0.1", "172.18.0.1"]) {
+      const response = await fromPeer(address);
+      expect(response.status).toBe(200);
+      expect(Object.keys(await response.json())).toContain("revision");
+    }
+  });
+
+  it("hides details from a caller on the public internet", async () => {
+    for (const address of ["203.0.113.7", "2001:db8::7"]) {
+      const response = await fromPeer(address);
+      expect(response.status).toBe(404);
+    }
+  });
+
+  it("hides details from a local caller that arrived through the proxy", async () => {
+    const response = await fromPeer("127.0.0.1", { "x-forwarded-for": "203.0.113.7" });
+    expect(response.status).toBe(404);
+  });
+});
diff --git a/apps/api/src/http/health.ts b/apps/api/src/http/health.ts
new file mode 100644
index 000000000..586c234ad
--- /dev/null
+++ b/apps/api/src/http/health.ts
@@ -0,0 +1,69 @@
+import { isPrivateNetworkAddress } from "@rakazo/contracts/network-host";
+import { logSinkHealth } from "@rakazo/logging";
+import { Hono } from "hono";
+import { socketPeer } from "./socket-peer.js";
+
+/**
+ * `/health` is public liveness, so it stays a constant body. Deployment details are for
+ * operators on the API port: a caller on this deployment's own network (loopback, or the bridge
+ * a published container port reports) whose request did not come through a forwarding proxy.
+ */
+export function healthRoutes(
+  details: () => Record<string, unknown>,
+  database?: () => Promise<unknown>,
+) {
+  const app = new Hono();
+  // One probe at a time: polls during a hung check wait on it instead of taking more connections.
+  let inFlight: Promise<boolean> | null = null;
+  const probe = (check: () => Promise<unknown>) => {
+    inFlight ??= Promise.resolve()
+      .then(check)
+      .then(
+        () => true,
+        () => false,
+      )
+      .finally(() => {
+        inFlight = null;
+      });
+    return inFlight;
+  };
+  app.get("/ready", async (c) => {
+    const degraded = details().degraded === true;
+    const databaseUp = database ? await withinDeadline(probe(database)) : true;
+    const ok = !degraded && databaseUp;
+    return c.json(
+      { ok, degraded, ...(databaseUp ? {} : { database: "unreachable" }) },
+      ok ? 200 : 503,
+    );
+  });
+  app.get("/health", (c) => c.json({ ok: true }));
+  app.get("/internal/health", (c) => {
+    if (c.req.header("x-forwarded-for") || c.req.header("forwarded")) return c.notFound();
+    // The peer check also covers a proxy that adds no forwarding header. An in-process request
+    // (a test, or the app asking itself) has no peer.
+    const peer = socketPeer(c);
+    if (peer !== undefined && !isPrivateNetworkAddress(unmapped(peer))) return c.notFound();
+    return c.json({ ok: true, ...details(), telemetry: logSinkHealth() });
+  });
+  return app;
+}
+
+export const DATABASE_CHECK_TIMEOUT_MS = 1500;
+
+/** A dual-stack listener reports IPv4 peers as `::ffff:a.b.c.d`. */
+function unmapped(address: string): string {
+  return address.replace(/^::ffff:(?=\d+\.\d+\.\d+\.\d+$)/i, "");
+}
+
+/** Readiness callers poll with short timeouts, so a hung database counts as unreachable. */
+async function withinDeadline(check: Promise<boolean>) {
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  const timeout = new Promise<false>((resolve) => {
+    timer = setTimeout(() => resolve(false), DATABASE_CHECK_TIMEOUT_MS);
+  });
+  try {
+    return await Promise.race([check, timeout]);
+  } finally {
+    clearTimeout(timer);
+  }
+}
diff --git a/apps/api/src/http/hourly-sweep.ts b/apps/api/src/http/hourly-sweep.ts
new file mode 100644
index 000000000..cfcf309c7
--- /dev/null
+++ b/apps/api/src/http/hourly-sweep.ts
@@ -0,0 +1,28 @@
+const HOUR_MS = 60 * 60 * 1000;
+
+/**
+ * Runs the sweep at startup and hourly; every API instance may run it, so sweeps claim their work.
+ * Stopping aborts the signal a running sweep was given and waits for it to return.
+ */
+export function startHourlySweep(
+  sweep: (signal: AbortSignal) => Promise<void>,
+  onError: (error: unknown) => void,
+) {
+  const stopping = new AbortController();
+  let running: Promise<void> | undefined;
+  const tick = () => {
+    running ??= sweep(stopping.signal)
+      .catch(onError)
+      .finally(() => {
+        running = undefined;
+      });
+  };
+  const timer = setInterval(tick, HOUR_MS);
+  timer.unref();
+  tick();
+  return async () => {
+    clearInterval(timer);
+    stopping.abort();
+    await running;
+  };
+}
diff --git a/apps/api/src/http/request-body-limit.test.ts b/apps/api/src/http/request-body-limit.test.ts
new file mode 100644
index 000000000..7863539fd
--- /dev/null
+++ b/apps/api/src/http/request-body-limit.test.ts
@@ -0,0 +1,183 @@
+import { ATTACHMENT_MAX_BASE64_LENGTH } from "@rakazo/contracts";
+import { Hono } from "hono";
+import { describe, expect, it, vi } from "vitest";
+import {
+  MAX_AUTH_REQUEST_BYTES,
+  MAX_RPC_REQUEST_BYTES,
+  mountApiRequestBodyLimits,
+  requestBodyLimit,
+  rpcBodyLimit,
+  rpcRequestMaxBytes,
+} from "./request-body-limit.js";
+
+function rpcApp(signedIn: boolean, maxUploadSizeBytes?: number) {
+  const parse = vi.fn(async (request: Request) => request.json());
+  const app = new Hono();
+  const limit = rpcBodyLimit(maxUploadSizeBytes);
+  app.post("/rpc/*", async (c) => (await limit(c, signedIn)) ?? c.json(await parse(c.req.raw)));
+  return { app, parse };
+}
+
+function testApp(maxSize: number, parse = vi.fn(async (request: Request) => request.json())) {
+  const app = new Hono();
+  app.use("/*", requestBodyLimit(maxSize));
+  app.post("/parse", async (c) => c.json(await parse(c.req.raw)));
+  return { app, parse };
+}
+
+describe("API request body limits", () => {
+  it("expands the HTTP envelope for a larger configured upload", async () => {
+    const limit = 25 * 1024 * 1024;
+    const { app } = rpcApp(true, limit);
+    const request = (length: number) =>
+      app.request("/rpc/artifacts/create", {
+        method: "POST",
+        headers: { "content-length": String(length) },
+        body: "{}",
+      });
+    expect((await request(Math.ceil(limit / 3) * 4 + 100)).status).toBe(200);
+    const rejected = await request(rpcRequestMaxBytes(limit) + 1);
+    expect(rejected.status).toBe(413);
+    expect(await rejected.json()).toEqual({
+      error: "Request body is too large. Upload limit: 25 MiB per file.",
+    });
+  });
+
+  it("discards a signed-out RPC body unread", async () => {
+    const cancel = vi.fn();
+    const pull = vi.fn();
+    const app = new Hono();
+    const limit = rpcBodyLimit();
+    app.post("/rpc/*", async (c) => (await limit(c, false)) ?? c.text(await c.req.raw.text()));
+    const response = await app.request(
+      new Request("http://localhost/rpc/me", {
+        method: "POST",
+        headers: { "content-length": "999999999" },
+        body: new ReadableStream({ pull, cancel }),
+        duplex: "half",
+      } as RequestInit & { duplex: "half" }),
+    );
+    expect(response.status).toBe(200);
+    expect(await response.text()).toBe("");
+    expect(cancel).toHaveBeenCalledOnce();
+    expect(pull).not.toHaveBeenCalled();
+    const signedIn = rpcApp(true).app;
+    const upload = await signedIn.request("/rpc/artifacts/create", {
+      method: "POST",
+      headers: { "content-length": String(MAX_AUTH_REQUEST_BYTES + 1) },
+      body: "{}",
+    });
+    expect(upload.status).toBe(200);
+  });
+
+  it("keeps the RPC allowance above the largest supported attachment envelope", () => {
+    expect(MAX_RPC_REQUEST_BYTES).toBeGreaterThan(ATTACHMENT_MAX_BASE64_LENGTH);
+    expect(MAX_AUTH_REQUEST_BYTES).toBeLessThan(MAX_RPC_REQUEST_BYTES);
+  });
+
+  it("mounts the auth limit without intercepting independently bounded routes", async () => {
+    const parse = vi.fn(async (request: Request) => request.json());
+    const app = new Hono();
+    mountApiRequestBodyLimits(app);
+    app.post("/api/auth/sign-in/email", async (c) => c.json(await parse(c.req.raw)));
+    app.post("/api/voice/speak", async (c) => c.json(await parse(c.req.raw)));
+
+    const request = (path: string, contentLength: number) =>
+      app.request(path, {
+        method: "POST",
+        headers: {
+          "content-type": "application/json",
+          "content-length": String(contentLength),
+        },
+        body: "{}",
+      });
+    const auth = await request("/api/auth/sign-in/email", MAX_AUTH_REQUEST_BYTES + 1);
+    const voice = await request("/api/voice/speak", MAX_RPC_REQUEST_BYTES + 1);
+
+    expect(auth.status).toBe(413);
+    expect(voice.status).toBe(200);
+    expect(parse).toHaveBeenCalledOnce();
+  });
+
+  it("rejects an oversized declared body before the route parser", async () => {
+    const { app, parse } = testApp(8);
+    const response = await app.request("/parse", {
+      method: "POST",
+      headers: { "content-type": "application/json", "content-length": "9" },
+      body: JSON.stringify({ ok: true }),
+    });
+
+    expect(response.status).toBe(413);
+    await expect(response.json()).resolves.toEqual({ error: "Request body is too large." });
+    expect(parse).not.toHaveBeenCalled();
+  });
+
+  it.each(["", "8.0"])(
+    "rejects invalid declared length %j before the route parser",
+    async (contentLength) => {
+      const { app, parse } = testApp(8);
+      const response = await app.request("/parse", {
+        method: "POST",
+        headers: { "content-type": "application/json", "content-length": contentLength },
+        body: "{}",
+      });
+
+      expect(response.status).toBe(413);
+      await expect(response.json()).resolves.toEqual({ error: "Request body is too large." });
+      expect(parse).not.toHaveBeenCalled();
+    },
+  );
+
+  it("stops an oversized streamed body before the route parser", async () => {
+    const cancel = vi.fn();
+    const { app, parse } = testApp(8);
+    const response = await app.request(
+      new Request("http://localhost/parse", {
+        method: "POST",
+        headers: { "content-type": "application/json" },
+        body: new ReadableStream({
+          start(controller) {
+            controller.enqueue(new TextEncoder().encode('{"value":"'));
+            controller.enqueue(new TextEncoder().encode('too large"}'));
+          },
+          cancel,
+        }),
+        duplex: "half",
+      } as RequestInit & { duplex: "half" }),
+    );
+
+    expect(response.status).toBe(413);
+    await expect(response.json()).resolves.toEqual({ error: "Request body is too large." });
+    expect(parse).not.toHaveBeenCalled();
+    expect(cancel).toHaveBeenCalledOnce();
+  });
+
+  it("counts the streamed body when transfer-encoding accompanies a small declared length", async () => {
+    const { app, parse } = testApp(8);
+    const response = await app.request("/parse", {
+      method: "POST",
+      headers: {
+        "content-type": "application/json",
+        "content-length": "2",
+        "transfer-encoding": "chunked",
+      },
+      body: JSON.stringify({ ok: true }),
+    });
+
+    expect(response.status).toBe(413);
+    expect(parse).not.toHaveBeenCalled();
+  });
+
+  it("passes bodies at the configured boundary to the route parser", async () => {
+    const { app, parse } = testApp(2);
+    for (const headers of [{}, { "content-length": "2" }] as Record<string, string>[]) {
+      const response = await app.request("/parse", {
+        method: "POST",
+        headers: { "content-type": "application/json", ...headers },
+        body: "{}",
+      });
+      expect(response.status).toBe(200);
+    }
+    expect(parse).toHaveBeenCalledTimes(2);
+  });
+});
diff --git a/apps/api/src/http/request-body-limit.ts b/apps/api/src/http/request-body-limit.ts
new file mode 100644
index 000000000..dc2287d07
--- /dev/null
+++ b/apps/api/src/http/request-body-limit.ts
@@ -0,0 +1,98 @@
+import { ATTACHMENT_MAX_BYTES, attachmentSizeLabel } from "@rakazo/contracts";
+import type { Context, Hono, MiddlewareHandler } from "hono";
+import { cancelBody } from "./http-body.js";
+
+export const MAX_AUTH_REQUEST_BYTES = 64 * 1024;
+export const MAX_RPC_REQUEST_BYTES = 16 * 1024 * 1024;
+
+/** Bound JSON entry points before their framework parsers buffer the request. */
+export function requestBodyLimit(maxSize: number, tooLargeMessage?: string): MiddlewareHandler {
+  if (!Number.isSafeInteger(maxSize) || maxSize <= 0) {
+    throw new Error("Request body limit must be a positive integer");
+  }
+  return async (c, next) => (await limitRequestBody(c, maxSize, tooLargeMessage)) ?? next();
+}
+
+/** The 413 response for a body over maxSize; otherwise the body stays readable downstream. */
+async function limitRequestBody(
+  c: Context,
+  maxSize: number,
+  tooLargeMessage = "Request body is too large.",
+): Promise<Response | undefined> {
+  const request = c.req.raw;
+  if (!request.body) return undefined;
+
+  const contentLength = request.headers.get("content-length");
+  if (contentLength !== null && !request.headers.has("transfer-encoding")) {
+    const declared = /^[0-9]+$/.test(contentLength) ? Number(contentLength) : Number.NaN;
+    if (!Number.isSafeInteger(declared) || declared < 0 || declared > maxSize) {
+      cancelBody(request.body);
+      return c.json({ error: tooLargeMessage }, 413);
+    }
+    return undefined;
+  }
+
+  const reader = request.body.getReader();
+  const chunks: Uint8Array[] = [];
+  let size = 0;
+  try {
+    for (;;) {
+      const { done, value } = await reader.read();
+      if (done) break;
+      size += value.byteLength;
+      if (size > maxSize) {
+        cancelBody(reader);
+        return c.json({ error: tooLargeMessage }, 413);
+      }
+      chunks.push(value);
+    }
+  } finally {
+    reader.releaseLock();
+  }
+
+  c.req.raw = new Request(request, {
+    body: new ReadableStream({
+      start(controller) {
+        for (const chunk of chunks) controller.enqueue(chunk);
+        controller.close();
+      },
+    }),
+    duplex: "half",
+  } as RequestInit & { duplex: "half" });
+  return undefined;
+}
+
+/** Allow base64 expansion plus room for the RPC JSON envelope. */
+export function rpcRequestMaxBytes(maxUploadSizeBytes = ATTACHMENT_MAX_BYTES): number {
+  return Math.max(MAX_RPC_REQUEST_BYTES, Math.ceil(maxUploadSizeBytes / 3) * 4 + 1024 * 1024);
+}
+
+/** Install limits only on framework-parsed JSON surfaces with known payload contracts. */
+export function mountApiRequestBodyLimits(app: Hono): void {
+  app.use("/api/auth/*", requestBodyLimit(MAX_AUTH_REQUEST_BYTES));
+}
+
+/**
+ * Signed out, only the bodiless `health` procedure is callable, so the body
+ * is discarded unread and oRPC answers as it would anyway: 401, or health.
+ */
+export function rpcBodyLimit(maxUploadSizeBytes = ATTACHMENT_MAX_BYTES) {
+  const signedInLimit = rpcRequestMaxBytes(maxUploadSizeBytes);
+  const message = `Request body is too large. Upload limit: ${attachmentSizeLabel(maxUploadSizeBytes)} per file.`;
+  return async (c: Context, signedIn: boolean) => {
+    if (signedIn) return limitRequestBody(c, signedInLimit, message);
+    const request = c.req.raw;
+    if (request.body) {
+      cancelBody(request.body);
+      const headers = new Headers(request.headers);
+      headers.delete("content-length");
+      headers.delete("transfer-encoding");
+      c.req.raw = new Request(request.url, {
+        method: request.method,
+        headers,
+        signal: request.signal,
+      });
+    }
+    return undefined;
+  };
+}
