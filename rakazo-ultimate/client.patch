@@ -0,0 +1,60 @@
+import { describe, expect, it } from "vitest";
+import {
+  dictationLevelStep,
+  meteringToLevel,
+  nextAdaptiveFloor,
+  SILENCE_LEVEL,
+  volumeToLevel,
+} from "./dictation-level";
+
+describe("the dictation waveform's level", () => {
+  it("reads a recorder's dBFS as silence at the floor and full scale at 0 dB", () => {
+    expect(meteringToLevel(undefined)).toBe(0);
+    expect(meteringToLevel(-160)).toBe(0);
+    expect(meteringToLevel(-60)).toBe(0);
+    expect(meteringToLevel(0)).toBe(1);
+    expect(meteringToLevel(-30)).toBeCloseTo(0.5, 5);
+  });
+
+  it("reads the recognizer's own -2..10 scale, where under 0 is inaudible", () => {
+    expect(volumeToLevel(undefined)).toBe(0);
+    expect(volumeToLevel(-2)).toBe(0);
+    expect(volumeToLevel(0)).toBe(0);
+    expect(volumeToLevel(5)).toBeCloseTo(0.5, 5);
+    expect(volumeToLevel(10)).toBe(1);
+  });
+
+  it("gates room noise out and lifts a voice above it", () => {
+    expect(dictationLevelStep(0, 0.1)).toBe(0);
+    expect(dictationLevelStep(0, 0.24)).toBe(0);
+    expect(dictationLevelStep(0, 0.5)).toBeGreaterThan(0);
+    // 0.24 gate, 2.2 gain: half a bar of voice arrives at 0.32 of its target at the first step.
+    expect(dictationLevelStep(0, 0.5)).toBeCloseTo(0.572 * 0.32, 3);
+    expect(dictationLevelStep(0, 1)).toBeCloseTo(0.32, 5);
+  });
+
+  it("rises fast and lets go slowly, so a syllable reads and a gap does not thump", () => {
+    const rising = dictationLevelStep(0, 0.9);
+    // Attack 0.32: a third of the way there on the first frame.
+    expect(rising).toBeCloseTo(0.32, 5);
+    // Release 0.12: with the voice gone it keeps almost all of that, falling only a little.
+    const held = dictationLevelStep(rising, 0);
+    expect(held / rising).toBeGreaterThan(0.85);
+    expect(held).toBeLessThan(rising);
+  });
+
+  it("learns an adaptive floor from the room and lets it creep up slowly", () => {
+    const floor = nextAdaptiveFloor(null, 0.12, 16);
+    expect(floor).toBeCloseTo(0.12, 5);
+    const next = nextAdaptiveFloor(floor, 0.3, 200);
+    expect(next).toBeGreaterThan(floor);
+    expect(next).toBeLessThanOrEqual(0.3);
+    // It never exceeds its ceiling, however loud the room is.
+    expect(nextAdaptiveFloor(0.4, 0.9, 60_000)).toBeLessThanOrEqual(0.45);
+  });
+
+  it("keeps the silence baseline under a bar", () => {
+    expect(SILENCE_LEVEL).toBeGreaterThan(0);
+    expect(SILENCE_LEVEL).toBeLessThan(0.24);
+  });
+});
diff --git a/apps/mobile/lib/dictation-level.ts b/apps/mobile/lib/dictation-level.ts
new file mode 100644
index 000000000..a3a691146
--- /dev/null
+++ b/apps/mobile/lib/dictation-level.ts
@@ -0,0 +1,87 @@
+/**
+ * The reference app's spectrum chain, applied to the one number a phone recorder gives us.
+ *
+ * Its dictation waveform is drawn from a real analyser: a 280–6000 Hz speech band, a noise gate at
+ * 0.24, a gain of 2.2 and an attack/release envelope of 0.32/0.12. We have no FFT in the dictation
+ * path — the microphone is either `expo-audio`'s recorder (metering in dBFS) or the system
+ * recognizer (`volumechange` in dB) — so the same gate, gain and envelope run on that level, and
+ * the bars move with the voice instead of a sine wave standing in for it.
+ */
+
+/** Below this the input is treated as room noise. */
+export const SPECTRUM_NOISE_GATE = 0.24;
+/** What a level above the gate is multiplied by before it fills a bar. */
+export const SPECTRUM_LEVEL_GAIN = 2.2;
+/** How fast a rising bar follows (higher is quicker). */
+export const SPECTRUM_ATTACK = 0.32;
+/** How fast a falling bar lets go. */
+export const SPECTRUM_RELEASE = 0.12;
+/** The adaptive noise floor: gain above it, margin it keeps clear, and its own ceilings. */
+export const ADAPTIVE_LEVEL_GAIN = 3;
+export const ADAPTIVE_FLOOR_MARGIN = 0.03;
+export const ADAPTIVE_FLOOR_MAX = 0.45;
+export const ADAPTIVE_FLOOR_WARMUP_MS = 300;
+export const ADAPTIVE_FLOOR_RISE_PER_SECOND = 0.05;
+/** A reading older than this is stale, and the bars fall back to silence. */
+export const STALE_READING_MS = 120;
+/** What a silent microphone shows, so the row never goes flat. */
+export const SILENCE_LEVEL = 0.04;
+
+/**
+ * A recorder's dBFS reading as a 0–1 level.
+ *
+ * `expo-audio` reports iOS `averagePower` (about -160 dB in silence, 0 dB at full scale); anything
+ * at or under -60 dB is silence, and the 60 dB above it is the range a voice moves through.
+ */
+export function meteringToLevel(db: number | undefined): number {
+  if (db === undefined || !Number.isFinite(db)) return 0;
+  return Math.min(1, Math.max(0, (db + 60) / 60));
+}
+
+/**
+ * The system recognizer's `volumechange` value as a 0–1 level.
+ *
+ * Its own documentation: a float between -2 and 10, and anything below 0 is inaudible.
+ */
+export function volumeToLevel(value: number | undefined): number {
+  if (value === undefined || !Number.isFinite(value)) return 0;
+  return Math.min(1, Math.max(0, value / 10));
+}
+
+/**
+ * The adaptive noise floor: a room's own level, learned from the quietest reading so far and then
+ * allowed to creep up slowly, as the reference app does while it is warming up.
+ */
+export function nextAdaptiveFloor(
+  previous: number | null,
+  raw: number,
+  elapsedMs: number,
+  startedAt = 0,
+): number {
+  if (previous === null) return Math.min(raw, ADAPTIVE_FLOOR_MAX);
+  const warming = startedAt < ADAPTIVE_FLOOR_WARMUP_MS;
+  const rise = warming ? ADAPTIVE_FLOOR_MAX : ADAPTIVE_FLOOR_RISE_PER_SECOND * (elapsedMs / 1000);
+  return Math.min(raw, ADAPTIVE_FLOOR_MAX, previous + rise);
+}
+
+/**
+ * One bar's next height: the gate and gain, then the envelope (quick up, slow down).
+ *
+ * `floor` is the noise floor in use — the fixed 0.24 gate, or an adaptive one — so a hissing room
+ * does not fill the row.
+ */
+export function dictationLevelStep(
+  previous: number,
+  raw: number,
+  floor: number = SPECTRUM_NOISE_GATE,
+): number {
+  const gate = raw - floor;
+  const gated =
+    floor === SPECTRUM_NOISE_GATE
+      ? Math.min(1, Math.max(0, gate) * SPECTRUM_LEVEL_GAIN)
+      : Math.min(1, Math.max(0, gate - ADAPTIVE_FLOOR_MARGIN) * ADAPTIVE_LEVEL_GAIN);
+  // A level inside the gate is silence, and silence is where the fall should start from.
+  const target = gate <= 0 ? 0 : gated;
+  const alpha = target > previous ? SPECTRUM_ATTACK : SPECTRUM_RELEASE;
+  return previous * (1 - alpha) + target * alpha;
+}
