@@ -0,0 +1,95 @@
+import { useLingui } from "@lingui/react/macro";
+import type { Bot } from "@rakazo/contracts";
+import { useRouter } from "expo-router";
+import { useState } from "react";
+import { StyleSheet, Text, TextInput, View } from "react-native";
+import { rpc } from "../lib/api";
+import { useMobileTokens } from "../lib/native";
+import { openFromSettingsSheet } from "../lib/settings-sheet";
+import { errorText } from "../lib/user-error";
+import { NativeActionButton } from "./native-action-button";
+
+/**
+ * A Grok Bot share pasted in and made into a bot of one's own: the link is all the page publishes,
+ * so the server reads it, builds the instructions around it and gives the bot the same face.
+ */
+export function GrokBotLinkImport() {
+  const { t } = useLingui();
+  const router = useRouter();
+  const tokens = useMobileTokens();
+  const [link, setLink] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [problem, setProblem] = useState<string | null>(null);
+  const trimmed = link.trim();
+  const canImport = trimmed.length > 0 && !busy;
+
+  async function importBot() {
+    if (!canImport) return;
+    setBusy(true);
+    setProblem(null);
+    try {
+      const bot: Bot = await rpc("bots/importGrokLink", { url: trimmed });
+      openFromSettingsSheet(router, {
+        pathname: "/thread",
+        params: { botId: bot.id, name: bot.name },
+      });
+    } catch (cause) {
+      setProblem(errorText(cause, t`Could not import this bot. Check the link and try again.`));
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  return (
+    <View
+      style={[
+        styles.card,
+        { backgroundColor: tokens.card, borderColor: tokens.border },
+      ]}
+    >
+      <Text style={[styles.title, { color: tokens.foreground }]}>{t`Import from a Grok Bot link`}</Text>
+      <Text style={[styles.hint, { color: tokens.mutedForeground }]}>
+        {t`Paste a share link; the bot keeps its name, description and look.`}
+      </Text>
+      <View
+        style={[
+          styles.field,
+          { backgroundColor: tokens.background, borderColor: tokens.border },
+        ]}
+      >
+        <TextInput
+          accessibilityLabel={t`Grok Bot link`}
+          autoCapitalize="none"
+          autoCorrect={false}
+          keyboardType="url"
+          onChangeText={setLink}
+          onSubmitEditing={() => void importBot()}
+          placeholder={t`https://x.ai/bot/…`}
+          placeholderTextColor={tokens.mutedForeground}
+          returnKeyType="go"
+          style={[styles.input, { color: tokens.foreground }]}
+          value={link}
+        />
+      </View>
+      {problem ? <Text style={[styles.problem, { color: tokens.destructive }]}>{problem}</Text> : null}
+      <NativeActionButton
+        busy={busy}
+        disabled={!canImport}
+        fill
+        label={busy ? t`Importing…` : t`Import`}
+        prominence="primary"
+        onPress={() => void importBot()}
+      />
+    </View>
+  );
+}
+
+/** Shown above the ready-made templates, since a shared one is the same kind of thing. */
+const styles = StyleSheet.create({
+  card: { borderRadius: 14, borderWidth: StyleSheet.hairlineWidth, padding: 14, gap: 8 },
+  title: { fontSize: 16, fontWeight: "600" },
+  hint: { fontSize: 13, lineHeight: 18 },
+  field: { borderRadius: 10, borderWidth: StyleSheet.hairlineWidth, paddingHorizontal: 12 },
+  input: { fontSize: 15, paddingVertical: 10 },
+  problem: { fontSize: 13, lineHeight: 18 },
+});
