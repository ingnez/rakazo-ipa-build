+import { MAX_FONT_SCALE } from "@rakazo/ui-tokens";
+import * as SecureStore from "expo-secure-store";
+import type { ReactElement } from "react";
+import { createElement, useSyncExternalStore } from "react";
+import type * as ReactNative from "react-native";
+import type { TextInputProps, TextProps, TextStyle } from "react-native";
+
+/**
+ * The app's own typeface, as the reference art draws Latin letters and digits. Its files carry no
+ * Chinese glyphs, so Chinese falls back to the system face character by character — the pairing
+ * the interface is meant to have.
+ */
+export const APP_FONT_FAMILY = "XVF";
+
+/** The same face with fixed-width digits, for code, token counts and timestamps. */
+export const APP_MONO_FONT_FAMILY = "XVFMono";
+
+/** How heavy the app's own face is drawn, as Appearance offers it. */
+export type AppFontWeight = "light" | "regular" | "bold";
+
+export const APP_FONT_WEIGHT_STORAGE_KEY = "rakazo.font-weight";
+
+let memoryFontWeight: AppFontWeight = "regular";
+const weightListeners = new Set<() => void>();
+
+function normalizeFontWeight(stored: string | null | undefined): AppFontWeight {
+  return stored === "light" || stored === "bold" ? stored : "regular";
+}
+
+export function getAppFontWeight(): AppFontWeight {
+  return memoryFontWeight;
+}
+
+export function subscribeAppFontWeight(listener: () => void): () => void {
+  weightListeners.add(listener);
+  return () => {
+    weightListeners.delete(listener);
+  };
+}
+
+function notifyFontWeight() {
+  for (const listener of weightListeners) listener();
+}
+
+/** Reads the saved weight once, at startup; text drawn before it lands uses the default. */
+export async function loadAppFontWeight(): Promise<AppFontWeight> {
+  try {
+    memoryFontWeight = normalizeFontWeight(
+      await SecureStore.getItemAsync(APP_FONT_WEIGHT_STORAGE_KEY),
+    );
+  } catch {
+    memoryFontWeight = memoryFontWeight ?? "regular";
+  }
+  notifyFontWeight();
+  return memoryFontWeight;
+}
+
+export async function setAppFontWeight(weight: AppFontWeight): Promise<AppFontWeight> {
+  memoryFontWeight = normalizeFontWeight(weight);
+  notifyFontWeight();
+  try {
+    await SecureStore.setItemAsync(APP_FONT_WEIGHT_STORAGE_KEY, memoryFontWeight);
+  } catch {
+    // The change still stands for this run when the store is unavailable.
+  }
+  return memoryFontWeight;
+}
+
+/** The weight a text style carries; 标准 adds nothing, so the type scale's own weight stays. */
+function fontWeightStyle(weight: AppFontWeight): TextStyle | null {
+  if (weight === "light") return { fontWeight: "300" };
+  // A step above the headings the interface already sets, so 粗体 is not swallowed by them.
+  if (weight === "bold") return { fontWeight: "700" };
+  return null;
+}
+
+// Marks the reskinned Text. It lives on the react-native module, which outlasts a Fast Refresh of
+// this file, and the global symbol registry gives a reloaded file the same key.
+const FONTED = Symbol.for("rakazo.fontedText");
+// The marker `capTextScaling` leaves on the wrapper it installs, so this one adds only the face.
+const CAPPED = Symbol.for("rakazo.cappedText");
+
+/**
+ * Draws every Text and TextInput in the app's own face, unless it sets its own font — the few
+ * monospaced spots do. React Native has no app-wide font and React ignores defaultProps on
+ * function components, so this replaces the module's `Text` and `TextInput` (configurable
+ * getters) with reskinned versions; Expo compiles `import { Text } from "react-native"` to a read
+ * of the module at render time, so every import in the app gets them. The family is put in front
+ * of the caller's own style, so an explicit font family still wins.
+ *
+ * A `Text` already capped by `capTextScaling` keeps its cap: the new wrapper adds the face and
+ * gives nothing else up. It also keeps the scale cap here when nothing capped it, and the module
+ * property is defined once, configurable, so a second install can never fail on a frozen property.
+ */
+export function applyAppFont(reactNative: typeof ReactNative = require("react-native")) {
+  const { Text, TextInput } = reactNative;
+  if (FONTED in Text) return;
+  const capped = CAPPED in Text;
+  const reskin = <Props extends TextProps | TextInputProps>(component: unknown) => {
+    // React 19 passes a ref as an ordinary prop, and the props are spread through, so a ref still
+    // reaches the real component; statics (`Text.Context` and the like) are carried over too.
+    const Reskinned = (props: Props) => {
+      const weight = useSyncExternalStore(
+        subscribeAppFontWeight,
+        getAppFontWeight,
+        getAppFontWeight,
+      );
+      // The chosen weight goes after the caller's style: rows and titles set their own 400–600,
+      // and a weight in front of them never showed. 标准 adds nothing and lets them stand.
+      const chosenWeight = fontWeightStyle(weight);
+      return createElement(
+        component as (props: Props) => ReactElement,
+        {
+          ...props,
+          maxFontSizeMultiplier:
+            capped === true
+              ? (props as TextProps).maxFontSizeMultiplier
+              : ((props as TextProps).maxFontSizeMultiplier ?? MAX_FONT_SCALE),
+          style: [
+            { fontFamily: APP_FONT_FAMILY },
+            props.style,
+            ...(chosenWeight ? [chosenWeight] : []),
+          ] as TextStyle[],
+        } as Props,
+      );
+    };
