+// @vitest-environment jsdom
+import type { ReactNode } from "react";
+import { act } from "react";
+import type { Root } from "react-dom/client";
+import { createRoot } from "react-dom/client";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { BotSoulField } from "../components/bot-soul-field";
+import { botSoulPresets } from "./bot-soul";
+
+vi.mock("../lib/native", () => ({
+  useMobileTokens: () => ({
+    background: "#FFFFFF",
+    foreground: "#000000",
+    card: "#FFFFFF",
+    secondary: "#EEEEEE",
+    primary: "#0A84FF",
+    primaryForeground: "#FFFFFF",
+    mutedForeground: "#8E8E93",
+    destructive: "#FF3B30",
+  }),
+  native: { label: "#000000", fill: "#EEEEEE", groupedCell: "#FFFFFF", tertiaryLabel: "#8E8E93" },
+}));
+
+vi.mock("react-native", () => {
+  const Container = ({ children }: { children?: ReactNode }) => <div>{children}</div>;
+  return {
+    Platform: { OS: "ios" },
+    StyleSheet: { create: (value: object) => value },
+    View: Container,
+    ScrollView: Container,
+    Text: ({ children }: { children?: ReactNode }) => <span>{children}</span>,
+    TextInput: ({
+      accessibilityLabel,
+      value,
+      onChangeText,
+      placeholder,
+      editable,
+    }: {
+      accessibilityLabel?: string;
+      value?: string;
+      onChangeText?: (value: string) => void;
+      placeholder?: string;
+      editable?: boolean;
+    }) => (
+      <textarea
+        aria-label={accessibilityLabel}
+        value={value}
+        placeholder={placeholder}
+        readOnly={editable === false}
+        onChange={(event) => onChangeText?.(event.target.value)}
+      />
+    ),
+    Pressable: ({
+      children,
+      onPress,
+      accessibilityLabel,
+      accessibilityState,
+      disabled,
+    }: {
+      children?: ReactNode;
+      onPress?: () => void;
+      accessibilityLabel?: string;
+      accessibilityState?: { selected?: boolean };
+      disabled?: boolean;
+    }) => (
+      <button
+        type="button"
+        aria-label={accessibilityLabel}
+        aria-pressed={accessibilityState?.selected === true}
+        disabled={disabled}
+        onClick={onPress}
+      >
+        {children}
+      </button>
+    ),
+  };
+});
+
+const presets = botSoulPresets();
+
+let root: Root;
+let host: HTMLElement;
+
+function render(value: string, onChange = vi.fn()) {
+  act(() => {
+    root.render(<BotSoulField value={value} onChange={onChange} />);
+  });
+  return onChange;
+}
+
+function button(label: string): HTMLButtonElement {
+  const found = [...host.querySelectorAll("button")].find(
+    (element) => element.getAttribute("aria-label") === label,
+  );
+  if (!found) throw new Error(`no button named ${label}`);
+  return found as HTMLButtonElement;
+}
+
+function tap(label: string) {
+  act(() => {
+    button(label).click();
+  });
+}
+
+function field(): HTMLTextAreaElement {
+  const found = host.querySelector("textarea");
+  if (!found) throw new Error("no soul field");
+  return found;
+}
+
+beforeEach(() => {
+  host = document.createElement("div");
+  document.body.appendChild(host);
+  root = createRoot(host);
+});
+
+afterEach(() => {
+  act(() => root.unmount());
+  host.remove();
+});
+
+describe("BotSoulField", () => {
+  it("offers every preset as a tap, above the field it writes into", () => {
+    render("");
+    expect(
+      presets.map((preset) => preset.label).filter((label) => host.contains(button(label))),
+    ).toEqual(presets.map((preset) => preset.label));
+    expect(host.textContent).toContain("Tap one to start, then make it yours below.");
+    expect(field().value).toBe("");
+  });
+
+  it("writes a whole way of talking into the field on one tap", () => {
+    const onChange = render("");
+    tap("Brisk");
+    expect(onChange).toHaveBeenCalledWith(presets[0]!.soul);
+  });
+
+  it("marks the preset the field already holds, and a second tap clears it", () => {
+    const onChange = render(presets[1]!.soul);
+    expect(button("Gentle").getAttribute("aria-pressed")).toBe("true");
+    expect(button("Brisk").getAttribute("aria-pressed")).toBe("false");
+    tap("Gentle");
+    expect(onChange).toHaveBeenCalledWith("");
+  });
+
+  it("keeps a personality of one's own from looking like a preset", () => {
+    render("You are the night-shift colleague who never panics.");
+    expect(
+      presets.every((preset) => button(preset.label).getAttribute("aria-pressed") === "false"),
+    ).toBe(true);
+  });
+
+  it("hands every keystroke back, so the page can save it", () => {
+    const onChange = render("");
+    act(() => {
+      const input = field();
+      // React's controlled input reads the native value setter, not a plain assignment.
+      const setValue = Object.getOwnPropertyDescriptor(HTMLTextAreaElement.prototype, "value")?.set;
+      setValue?.call(input, "Speak in short sentences.");
+      input.dispatchEvent(new Event("input", { bubbles: true }));
+    });
+    expect(onChange).toHaveBeenCalledWith("Speak in short sentences.");
+  });
+
+  it("cannot be tapped or typed into while a save is running", () => {
+    act(() => {
+      const onChange = vi.fn();
+      root.render(<BotSoulField value="" onChange={onChange} editable={false} />);
+    });
+    expect(button("Gentle").disabled).toBe(true);
+    expect(field().readOnly).toBe(true);
+  });
+});
