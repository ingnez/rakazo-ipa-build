@@ -0,0 +1,65 @@
+import { mkdtempSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { pathToFileURL } from "node:url";
+import {
+  CLIENT_BUILD_HEADER,
+  CLIENT_UPDATE_REQUIRED,
+  SERVER_BUILD_HEADER,
+} from "@rakazo/contracts";
+import { Hono } from "hono";
+import { describe, expect, it } from "vitest";
+import { clientBuildMiddleware, readDeployedWebBuild } from "./client-build.js";
+
+function app(webBuild: string | undefined, minimums = {}) {
+  const hono = new Hono();
+  hono.use("/rpc/*", clientBuildMiddleware({ webBuild, minimums }));
+  hono.post("/rpc/me", (c) => c.json({ json: { ok: true } }));
+  return hono;
+}
+const call = (hono: Hono, build?: string) =>
+  hono.request("/rpc/me", {
+    method: "POST",
+    headers: build ? { [CLIENT_BUILD_HEADER]: build } : {},
+  });
+
+describe("client build handshake", () => {
+  it("names the deployed web build on every reply", async () => {
+    const response = await call(app("20261022093015"), "web/20261001000000");
+    expect(response.status).toBe(200);
+    expect(response.headers.get(SERVER_BUILD_HEADER)).toBe("20261022093015");
+  });
+
+  it("stays quiet without a known web build", async () => {
+    const response = await call(app(undefined));
+    expect(response.headers.get(SERVER_BUILD_HEADER)).toBeNull();
+  });
+
+  it("refuses a build older than its kind's minimum with a 426 RPC error", async () => {
+    const hono = app("20261022093015", { web: "20261022000000" });
+    const refused = await call(hono, "web/20261021235959");
+    expect(refused.status).toBe(426);
+    expect(refused.headers.get(SERVER_BUILD_HEADER)).toBe("20261022093015");
+    expect(await refused.json()).toEqual({
+      json: {
+        defined: false,
+        code: CLIENT_UPDATE_REQUIRED,
+        status: 426,
+        message: "Update required",
+      },
+    });
+    expect((await call(hono, "web/20261022000000")).status).toBe(200);
+    expect((await call(hono, "mobile/20200101000000")).status).toBe(200);
+    expect((await call(hono)).status).toBe(200);
+  });
+
+  it("reads the web build id written beside the web assets", () => {
+    const dir = mkdtempSync(path.join(tmpdir(), "rk-build-"));
+    const file = path.join(dir, "build-id");
+    writeFileSync(file, "20261022093015\n");
+    expect(readDeployedWebBuild(pathToFileURL(file))).toBe("20261022093015");
+    writeFileSync(file, "not-a-build");
+    expect(readDeployedWebBuild(pathToFileURL(file))).toBeUndefined();
+    expect(readDeployedWebBuild(pathToFileURL(path.join(dir, "missing")))).toBeUndefined();
+  });
+});
diff --git a/apps/api/src/http/client-build.ts b/apps/api/src/http/client-build.ts
new file mode 100644
index 000000000..1921e60fb
--- /dev/null
+++ b/apps/api/src/http/client-build.ts
@@ -0,0 +1,55 @@
+import { readFileSync } from "node:fs";
+import type { MinimumClientBuilds } from "@rakazo/contracts";
+import {
+  CLIENT_BUILD_HEADER,
+  CLIENT_UPDATE_REQUIRED,
+  CLIENT_UPDATE_REQUIRED_STATUS,
+  clientUpdateRequired,
+  isBuildId,
+  SERVER_BUILD_HEADER,
+} from "@rakazo/contracts";
+import type { MiddlewareHandler } from "hono";
+
+/**
+ * The web build ships in the same image as the API, so reading its id from its assets keeps one
+ * source of truth. Dev servers and images without a web build have none; the handshake stays quiet.
+ */
+export function readDeployedWebBuild(
+  file: URL = new URL("../../web/dist/build-id", import.meta.url),
+): string | undefined {
+  try {
+    const build = readFileSync(file, "utf8").trim();
+    return isBuildId(build) ? build : undefined;
+  } catch {
+    return undefined;
+  }
+}
+
+/** Names the deployed web build on every reply and refuses clients older than their minimum. */
+export function clientBuildMiddleware(options: {
+  webBuild: string | undefined;
+  minimums: MinimumClientBuilds;
+}): MiddlewareHandler {
+  return async (c, next) => {
+    if (clientUpdateRequired(c.req.header(CLIENT_BUILD_HEADER), options.minimums)) {
+      // The oRPC error shape, so web and mobile clients read it like any other RPC failure.
+      return c.json(
+        {
+          json: {
+            defined: false,
+            code: CLIENT_UPDATE_REQUIRED,
+            status: CLIENT_UPDATE_REQUIRED_STATUS,
+            message: "Update required",
+          },
+        },
+        CLIENT_UPDATE_REQUIRED_STATUS,
+        {
+          "cache-control": "no-store",
+          ...(options.webBuild ? { [SERVER_BUILD_HEADER]: options.webBuild } : {}),
+        },
+      );
+    }
+    await next();
+    if (options.webBuild) c.header(SERVER_BUILD_HEADER, options.webBuild);
+  };
+}
diff --git a/apps/api/src/http/drain.ts b/apps/api/src/http/drain.ts
new file mode 100644
index 000000000..53efbfed3
--- /dev/null
+++ b/apps/api/src/http/drain.ts
@@ -0,0 +1,58 @@
+import type { IncomingMessage, Server, ServerResponse } from "node:http";
+import type { Duplex } from "node:stream";
+
+/**
+ * Asks a replaced API to stop taking requests and let the chat turns it is running end, for up
+ * to RUN_DRAIN_MS, before it exits; SIGTERM hands them back at once. The image's
+ * `org.rakazo.run-drain-signal` label names it, so the deploy sends it only to an API that
+ * handles it.
+ */
+export const RUN_DRAIN_SIGNAL = "SIGUSR2";
+
+const isStream = (request: IncomingMessage) =>
+  request.headers.accept?.includes("text/event-stream") === true;
+
+/**
+ * Lets a replaced API finish its ordinary requests while streams and upgraded sockets close at
+ * once, so clients reconnect to the new release instead of seeing a cut-off response.
+ */
+export function trackConnections(server: Server) {
+  const sockets = new Set<Duplex>();
+  const streams = new Set<Duplex>();
+  const pending = new Set<ServerResponse>();
+  let draining = false;
+  const forget = (socket: Duplex) => {
+    sockets.delete(socket);
+    streams.delete(socket);
+  };
+  server.on("connection", (socket) => {
+    sockets.add(socket);
+    socket.once("close", () => forget(socket));
+  });
+  server.on("upgrade", (_request, socket: Duplex) => {
+    streams.add(socket);
+    if (draining) socket.destroy();
+  });
+  server.on("request", (request: IncomingMessage, response: ServerResponse) => {
+    if (isStream(request)) {
+      streams.add(request.socket);
+      if (draining) request.socket.destroy();
+      return;
+    }
+    if (draining) response.shouldKeepAlive = false;
+    pending.add(response);
+    response.once("close", () => pending.delete(response));
+  });
+
+  return async (graceMs: number) => {
+    draining = true;
+    const closed = new Promise<void>((resolve) => server.close(() => resolve()));
+    for (const socket of streams) socket.destroy();
+    for (const response of pending) if (!response.headersSent) response.shouldKeepAlive = false;
+    const grace = setTimeout(() => {
+      for (const socket of sockets) socket.destroy();
+    }, graceMs);
+    await closed;
+    clearTimeout(grace);
+  };
+}
