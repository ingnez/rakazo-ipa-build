+});
+
+describe("ImageViewerIndex and ImageSendPolicy", () => {
+  it("clamps the starting page and shows a strip only for two or more images", () => {
+    expect(ImageViewerIndex.clamp(5, 3)).toBe(2);
+    expect(ImageViewerIndex.clamp(-1, 3)).toBe(0);
+    expect(ImageViewerIndex.clamp(2, 0)).toBe(0);
+    expect(ImageViewerIndex.showsStrip(1)).toBe(false);
+    expect(ImageViewerIndex.showsStrip(2)).toBe(true);
