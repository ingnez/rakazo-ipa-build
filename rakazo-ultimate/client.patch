@@ -0,0 +1,51 @@
+import { describe, expect, it } from "vitest";
+import {
+  COMPUTER_POINTER_STATE_MESSAGE,
+  computerPointerStateMessage,
+  computerRecenterScript,
+  computerTrackpadScript,
+  isComputerPointerStateMessage,
+} from "./computer-trackpad";
+
+/** The page runs these as plain scripts, so they have to parse as one. */
+function parses(script: string) {
+  expect(() => new Function(script)).not.toThrow();
+}
+
+describe("computer trackpad scripts", () => {
+  it("switches the trackpad on and off in the desktop page", () => {
+    for (const script of [computerTrackpadScript(true), computerTrackpadScript(false)]) {
+      parses(script);
+      expect(script).toContain("window.__rakazoPointer");
+      expect(script.trimEnd().endsWith("true;")).toBe(true);
+    }
+    expect(computerTrackpadScript(true)).toContain("set(true)");
+    expect(computerTrackpadScript(false)).toContain("set(false)");
+  });
+
+  it("puts the pointer back in the middle", () => {
+    const script = computerRecenterScript();
+    parses(script);
+    expect(script).toContain("recenter()");
+  });
+
+  it("drives the page's own trackpad switch when the page has one", () => {
+    // The sandbox page may already carry a trackpad of its own; the script asks for it first so
+    // the two switches can never disagree about which pointer mode is on.
+    expect(computerTrackpadScript(true)).toContain('aria-label="Use trackpad"');
+  });
+
+  it("installs once, so switching repeatedly does not stack handlers", () => {
+    const script = computerTrackpadScript(true);
+    expect(script).toContain("if (window.__rakazoPointer) return true;");
+    expect(script.match(/addEventListener/g)?.length).toBe(1);
+  });
+
+  it("says what the page reports about its pointer mode", () => {
+    expect(computerPointerStateMessage(true)).toBe(`${COMPUTER_POINTER_STATE_MESSAGE}:1`);
+    expect(computerPointerStateMessage(false)).toBe(`${COMPUTER_POINTER_STATE_MESSAGE}:0`);
+    expect(isComputerPointerStateMessage(computerPointerStateMessage(true))).toBe(true);
+    expect(isComputerPointerStateMessage("something else")).toBe(false);
+    expect(isComputerPointerStateMessage(undefined)).toBe(false);
+  });
+});
diff --git a/apps/mobile/lib/computer-trackpad.ts b/apps/mobile/lib/computer-trackpad.ts
new file mode 100644
index 000000000..656f98b16
--- /dev/null
+++ b/apps/mobile/lib/computer-trackpad.ts
@@ -0,0 +1,122 @@
+/**
+ * The full-window computer's pointer controls, run inside the desktop page.
+ *
+ * noVNC already answers a mouse moved over its canvas, so a trackpad is a relative drag that
+ * nudges a virtual mouse position and sends it, and "recenter" is the same thing aimed at the
+ * middle. The sandbox page may also carry its own trackpad switch; when it does, this drives that
+ * switch instead of standing beside it, so the two can never disagree.
+ */
+const TRACKPAD_INSTALL = `(function(){
+  if (window.__rakazoPointer) return true;
+  var state = { on: false, local: false, x: null, y: null, touch: null, lastX: 0, lastY: 0, moved: false };
+  function canvas(){ return document.querySelector("canvas"); }
+  function box(){ var c = canvas(); return c ? c.getBoundingClientRect() : null; }
+  function pageSwitch(){ return document.querySelector('[aria-label="Use trackpad"],[aria-label="Use direct touch"]'); }
+  function fire(type, x, y, target){
+    var t = target || canvas();
+    if (!t) return false;
+    t.dispatchEvent(new MouseEvent(type, { bubbles: true, cancelable: true, view: window, clientX: x, clientY: y, button: 0, buttons: type === "mouseup" ? 0 : 1 }));
+    return true;
+  }
+  function center(){ var r = box(); return r ? { x: r.left + r.width / 2, y: r.top + r.height / 2 } : null; }
+  function clamp(p){ var r = box(); if (!r) return p; return { x: Math.max(r.left, Math.min(r.right - 1, p.x)), y: Math.max(r.top, Math.min(r.bottom - 1, p.y)) }; }
+  function isOn(){
+    var s = pageSwitch();
+    return s ? s.getAttribute("aria-pressed") === "true" : state.on;
+  }
+  function set(on){
+    var s = pageSwitch();
+    if (s) {
+      state.local = false;
+      if ((s.getAttribute("aria-pressed") === "true") !== on) s.click();
+      return isOn();
+    }
+    state.local = true;
+    state.on = on;
+    state.touch = null;
+    if (!on) { state.x = null; state.y = null; return false; }
+    var c = center();
+    if (c) { state.x = c.x; state.y = c.y; fire("mousemove", c.x, c.y); }
+    return true;
+  }
+  function recenter(){
+    var s = pageSwitch();
+    if (s) {
+      // The page puts its cursor back in the middle whenever the trackpad is switched on.
+      if (s.getAttribute("aria-pressed") === "true") { s.click(); s.click(); } else s.click();
+      return true;
+    }
+    var c = center();
+    if (!c) return false;
+    state.x = c.x; state.y = c.y;
+    fire("mousemove", c.x, c.y);
+    return true;
+  }
+  function overlay(){ var o = document.getElementById("noVNC_mouse_capture_elem"); return o && o.style && o.style.display !== "none" ? o : null; }
+  function consume(e){ e.preventDefault(); e.stopPropagation(); }
+  function onStart(e){
+    if (!state.local || !state.on || state.x === null) return;
+    var t = e.changedTouches && e.changedTouches[0];
+    if (!t || state.touch !== null) return;
+    state.touch = t.identifier;
+    state.lastX = t.clientX; state.lastY = t.clientY; state.moved = false;
+    consume(e);
+  }
+  function onMove(e){
+    if (!state.local || !state.on || state.touch === null || !e.changedTouches) return;
+    for (var i = 0; i < e.changedTouches.length; i++) {
+      var t = e.changedTouches[i];
+      if (t.identifier !== state.touch) continue;
+      var dx = (t.clientX - state.lastX) * 1.5;
+      var dy = (t.clientY - state.lastY) * 1.5;
+      state.lastX = t.clientX; state.lastY = t.clientY;
+      if (Math.abs(dx) + Math.abs(dy) < 0.5) return;
+      state.moved = true;
+      var next = clamp({ x: state.x + dx, y: state.y + dy });
+      state.x = next.x; state.y = next.y;
+      fire("mousemove", next.x, next.y);
+      consume(e);
+      return;
+    }
+  }
+  function onEnd(e){
+    if (!state.local || state.touch === null || !e.changedTouches) return;
+    for (var i = 0; i < e.changedTouches.length; i++) {
+      if (e.changedTouches[i].identifier !== state.touch) continue;
+      state.touch = null;
+      // A tap with no drag clicks where the pointer already is.
+      if (!state.moved && state.x !== null) {
+        fire("mousemove", state.x, state.y);
+        fire("mousedown", state.x, state.y);
+        fire("mouseup", state.x, state.y, overlay());
+      }
+      consume(e);
+      return;
+    }
+  }
+  var events = [["touchstart", onStart], ["touchmove", onMove], ["touchend", onEnd], ["touchcancel", onEnd]];
+  for (var i = 0; i < events.length; i++) document.addEventListener(events[i][0], events[i][1], { capture: true, passive: false });
+  window.__rakazoPointer = { set: set, recenter: recenter, isOn: isOn, local: function(){ return state.local; } };
+  return true;
+})();`;
+
+/** Installs the pointer helper once, then switches the trackpad on or off. */
+export function computerTrackpadScript(on: boolean): string {
+  return `${TRACKPAD_INSTALL}window.__rakazoPointer&&window.__rakazoPointer.set(${on ? "true" : "false"});true;`;
+}
+
+/** Puts the pointer back in the middle of the desktop. */
+export function computerRecenterScript(): string {
+  return `${TRACKPAD_INSTALL}window.__rakazoPointer&&window.__rakazoPointer.recenter();true;`;
+}
+
+/** What the page says back about the trackpad after a switch. */
+export const COMPUTER_POINTER_STATE_MESSAGE = "rakazo-computer-pointer";
+
+export function computerPointerStateMessage(on: boolean): string {
+  return `${COMPUTER_POINTER_STATE_MESSAGE}:${on ? "1" : "0"}`;
+}
+
+export function isComputerPointerStateMessage(data: unknown): boolean {
+  return typeof data === "string" && data.startsWith(`${COMPUTER_POINTER_STATE_MESSAGE}:`);
+}
