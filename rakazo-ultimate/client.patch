+
+/**
+ * How far a body's own outline is from its centre in a direction, in body units: the ring's radius
+ * there, interpolated between the two vertices that straddle it. The ring starts at the top and
+ * runs clockwise, so a direction is a quarter turn behind the first vertex.
+ */
+export function babygrokBodyReach(ring: readonly number[], angle: number): number {
+  "worklet";
+  const count = ring.length / 2;
+  let turn = angle / (Math.PI * 2) + 0.25;
+  turn -= Math.floor(turn);
+  const at = turn * count;
+  const index = Math.floor(at) % count;
+  const next = (index + 1) % count;
+  const share = at - Math.floor(at);
+  const from = Math.hypot(ring[index * 2]!, ring[index * 2 + 1]!);
+  const to = Math.hypot(ring[next * 2]!, ring[next * 2 + 1]!);
