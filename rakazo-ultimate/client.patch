+
+    await act(async () => {
+      button(view, "0~1").click();
+      await Promise.resolve();
+    });
+
+    // Nothing is sent while answering: the sheet goes to the bot once, at its end.
+    expect(rpc).not.toHaveBeenCalled();
+    expect(hapticSelection).toHaveBeenCalled();
+    expect(button(view, "0~1").getAttribute("aria-selected")).toBe("true");
+
+    await act(async () => {
+      button(view, "下一题").click();
+      await Promise.resolve();
+    });
+
+    expect(view.textContent).toContain("2 / 2");
+    expect(view.textContent).toContain("可多选");
+    // The last page offers the sheet's own submit, with how much of it is answered.
+    expect(view.textContent).toContain("提交答卷 1/2");
+  });
+
+  it("sends the whole sheet as one message when the last page submits", async () => {
+    rpc.mockResolvedValue({ taskId: "t", runId: "r", seq: 1 });
+    const view = render();
+
+    await act(async () => {
+      button(view, "0~1").click();
+      await Promise.resolve();
+    });
+    await act(async () => {
+      button(view, "下一题").click();
+      await Promise.resolve();
+    });
+    await act(async () => {
+      button(view, "气道保护").click();
+      await Promise.resolve();
+    });
+    await act(async () => {
+      button(view, "提交答卷").click();
+      await Promise.resolve();
+    });
+
+    expect(rpc).toHaveBeenCalledTimes(1);
+    const [procedure, input] = rpc.mock.calls[0] as [string, { botId: string; text: string }];
+    expect(procedure).toBe("threads/send");
+    expect(input.botId).toBe("bot-1");
+    expect(input.text).toContain("重症医学 2 题");
+    expect(input.text).toContain("1. 受体部分激动药的内在活性 α 等于");
+    expect(input.text).toContain("C");
+    expect(input.text).toContain("B");
+    expect(view.textContent).toContain("已提交给 Bot");
+  });
+
+  it("writes the sheet the way a bot can mark it", () => {
+    const text = answerSheetText(
+      "套卷",
+      quiz.questions ?? [],
+      [
+        { questionId: undefined, question: "q1", optionIds: ["c"] },
+        { questionId: "q2", question: "q2", optionIds: ["d", "e"] },
+      ],
+    );
+    expect(text).toBe(
+      "套卷\n1. 受体部分激动药的内在活性 α 等于\nC\n2. 下列哪些是机械通气的适应证\nAB",
+    );
+  });
+
+  it("takes several picks on a single question that asks for them", async () => {
+    rpc.mockResolvedValue({ taskId: "t", runId: "r", seq: 1 });
+    const view = render({
+      kind: "choice",
+      question: "要包含哪几块内容",
+      multiple: true,
+      options: [
+        { id: "x", letter: "A", label: "背景" },
+        { id: "y", letter: "B", label: "数据" },
+      ],
+    });
+
+    await act(async () => {
+      button(view, "背景").click();
+      await Promise.resolve();
+    });
+    await act(async () => {
+      button(view, "数据").click();
+      await Promise.resolve();
+    });
+
+    expect(button(view, "背景").getAttribute("aria-selected")).toBe("true");
+    expect(button(view, "数据").getAttribute("aria-selected")).toBe("true");
+
+    await act(async () => {
+      button(view, "提交答卷").click();
+      await Promise.resolve();
+    });
+
+    const [procedure, input] = rpc.mock.calls[0] as [string, { text: string }];
