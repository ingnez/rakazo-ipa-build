@@ -0,0 +1,200 @@
+import { typeScale } from "@rakazo/ui-tokens";
+import type { ReactNode } from "react";
+import { Platform, Pressable, StyleSheet, Text, View } from "react-native";
+import { mobileTokens } from "../../lib/appearance";
+import { native, useThemedStyles } from "../../lib/native";
+import { androidRipple } from "../../lib/ripple";
+import { ACTION_MIN_HEIGHT, CARD_HIT_SLOP, PRESS_SCALE, SAND_RADIUS, SHEET_CONTENT_PADDING } from "./metrics";
+import { PressScale } from "../press-scale";
+
+/** One thing a card can do, drawn along the card's bottom in the reference app's own rows. */
+export type CardChromeAction = {
+  label: string;
+  onPress: () => void;
+  /** Draws the label in the destructive colour. */
+  destructive?: boolean;
+  /** A value shown above the label, as a small stat does. */
+  hint?: string;
+};
+
+/**
+ * A card of its own: a 24-point continuous surface with room for a title, a body, and the actions
+ * that belong to it.
+ *
+ * The reference app's cards all share this shape. The actions sit on their own row at the card's
+ * foot, laid out right to left, so the last action added is the one nearest the thumb's resting
+ * place; the row is part of the card rather than a bar under it. A card that only shows content
+ * gets no action row at all.
+ */
+export function CardChrome({
+  title,
+  subtitle,
+  leading,
+  children,
+  actions = [],
+  footer,
+  tone = "card",
+  style,
+}: {
+  title?: string;
+  subtitle?: string;
+  /** A glyph, avatar or picture that sits beside the title. */
+  leading?: ReactNode;
+  children?: ReactNode;
+  actions?: readonly CardChromeAction[];
+  footer?: ReactNode;
+  /** A quiet card on the page's own paper, or a filled one that stands off it. */
+  tone?: "card" | "paper";
+  style?: object;
+}) {
+  const styles = useThemedStyles(createCardStyles);
+  const tokens = mobileTokens();
+  return (
+    <View
+      style={[
+        styles.card,
+        { backgroundColor: tone === "card" ? tokens.card : tokens.secondary },
+        style,
+      ]}
+    >
+      {title || leading ? (
+        <View style={styles.head}>
+          {leading ? <View style={styles.leading}>{leading}</View> : null}
+          <View style={styles.headText}>
+            {title ? (
+              <Text numberOfLines={2} style={styles.title}>
+                {title}
+              </Text>
+            ) : null}
+            {subtitle ? (
+              <Text numberOfLines={3} style={styles.subtitle}>
+                {subtitle}
+              </Text>
+            ) : null}
+          </View>
+        </View>
+      ) : null}
+      {children ? <View style={styles.body}>{children}</View> : null}
+      {footer}
+      {actions.length ? (
+        // Reversed, so the first action declared sits at the card's trailing edge.
+        <View style={styles.actions}>
+          {[...actions].reverse().map((action, index) => (
+            <PressScale
+              key={action.label}
+              accessibilityRole="button"
+              accessibilityLabel={action.label}
+              hitSlop={CARD_HIT_SLOP}
+              scaleTo={PRESS_SCALE}
+              onPress={action.onPress}
+              containerStyle={styles.action}
+            >
+              <View style={[styles.actionInner, index === 0 && styles.actionFirst]}>
+                {action.hint ? <Text style={styles.actionHint}>{action.hint}</Text> : null}
+                <Text
+                  numberOfLines={1}
+                  style={[styles.actionLabel, action.destructive && styles.destructive]}
+                >
+                  {action.label}
+                </Text>
+              </View>
+              {index === 0 ? null : <View style={styles.actionSeparator} />}
+            </PressScale>
+          ))}
+        </View>
+      ) : null}
+    </View>
+  );
+}
+
+/** A plain row of text inside a card: the same insets the card's own body keeps. */
+export function CardRow({ children }: { children: ReactNode }) {
+  const styles = useThemedStyles(createCardStyles);
+  return <View style={styles.row}>{children}</View>;
+}
+
+/** A small label above a value, as a card's stat draws one. */
+export function CardStat({
+  label,
+  value,
+  onPress,
+}: {
+  label: string;
+  value: string;
+  onPress?: () => void;
+}) {
+  const styles = useThemedStyles(createCardStyles);
+  const content = (
+    <>
+      <Text numberOfLines={1} style={styles.statValue}>
+        {value}
+      </Text>
+      <Text numberOfLines={1} style={styles.statLabel}>
+        {label}
+      </Text>
+    </>
+  );
+  if (!onPress) return <View style={styles.stat}>{content}</View>;
+  return (
+    <Pressable
+      accessibilityRole="button"
+      accessibilityLabel={`${label}, ${value}`}
+      android_ripple={androidRipple()}
+      hitSlop={CARD_HIT_SLOP}
+      onPress={onPress}
+      style={({ pressed }) => [styles.stat, pressed && Platform.OS !== "android" && styles.pressed]}
+    >
+      {content}
+    </Pressable>
+  );
+}
+
+function createCardStyles() {
+  const tokens = mobileTokens();
+  return StyleSheet.create({
+    card: {
+      borderRadius: SAND_RADIUS.card,
+      borderCurve: "continuous",
+      overflow: "hidden",
+      paddingTop: SHEET_CONTENT_PADDING,
+    },
+    head: { flexDirection: "row", alignItems: "center", gap: 12, paddingHorizontal: SHEET_CONTENT_PADDING },
+    leading: { alignItems: "center", justifyContent: "center" },
+    headText: { flex: 1, gap: 2 },
+    title: { color: native.label, ...typeScale.cardTitle },
+    subtitle: { color: native.secondaryLabel, ...typeScale.secondary },
+    body: { paddingTop: 10, paddingHorizontal: SHEET_CONTENT_PADDING, gap: 10 },
+    row: { flexDirection: "row", alignItems: "center", gap: 8 },
+    actions: {
+      flexDirection: "row",
+      alignItems: "stretch",
+      marginTop: 12,
+      borderTopWidth: StyleSheet.hairlineWidth * 2,
+      borderTopColor: native.separator,
+    },
+    action: { flex: 1 },
+    actionInner: {
+      minHeight: ACTION_MIN_HEIGHT,
+      paddingHorizontal: 10,
+      alignItems: "center",
+      justifyContent: "center",
+      gap: 2,
+    },
+    actionFirst: {},
+    actionSeparator: {
+      position: "absolute",
+      start: 0,
+      top: 12,
+      bottom: 12,
+      width: StyleSheet.hairlineWidth * 2,
+      backgroundColor: native.separator,
+    },
+    actionLabel: { color: tokens.link, fontSize: 15, fontWeight: "600" },
+    actionHint: { color: native.secondaryLabel, ...typeScale.caption },
+    destructive: { color: tokens.destructive },
+    stat: { flex: 1, gap: 2, paddingVertical: 6 },
+    statValue: { color: native.label, fontSize: 17, fontWeight: "600" },
+    statLabel: { color: native.secondaryLabel, ...typeScale.caption },
+    pressed: { opacity: 0.6 },
+  });
+}
