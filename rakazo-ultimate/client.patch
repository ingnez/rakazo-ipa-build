new file mode 100644
index 000000000..be90ee780
--- /dev/null
+++ b/packages/contracts/src/phone-connectors.ts
@@ -0,0 +1,205 @@
+import { z } from "zod";
+import { USER_DEVICE_PATH } from "./user-devices.js";
+
+/**
+ * The iPhone's own connectors: the five kinds of thing a phone holds that the server cannot reach
+ * by itself. The phone pairs as a user device (platform "ios"), keeps a socket open, and answers
+ * these requests by running the matching iOS framework: AlarmKit, EventKit, Contacts, CoreLocation.
+ *
+ * The switches live on the phone's settings screen (Settings → Integrations → this iPhone) and are
+ * stored here so a tool asked about alarms can say 「这一项没开」 even while the phone is away.
+ */
+
+/** Reading and writing these is `/api/devices/phone`; pairing is `/api/devices/pair`. */
+export const USER_DEVICE_PHONE_PATH = `${USER_DEVICE_PATH}/phone`;
+
+export const PHONE_CONNECTOR_KINDS = [
+  "alarms",
+  "calendar",
+  "reminders",
+  "contacts",
+  "location",
+] as const;
+export type PhoneConnectorKind = (typeof PHONE_CONNECTOR_KINDS)[number];
+
+/** What each switch is called on the phone, and what turning it on allows. */
+export const PHONE_CONNECTOR_INFO: Record<
+  PhoneConnectorKind,
+  { name: string; hint: string; permission: string }
+> = {
+  alarms: {
+    name: "闹钟",
+    hint: "读取、新建、开关和取消手机上的闹钟",
+    permission: "系统「闹钟」权限",
+  },
+  calendar: {
+    name: "日历",
+    hint: "查看日程，新建和修改日程",
+    permission: "系统「日历」权限",
+  },
+  reminders: {
+    name: "提醒事项",
+    hint: "查看待办，新建提醒并标记完成",
+    permission: "系统「提醒事项」权限",
+  },
+  contacts: {
+    name: "通讯录",
+    hint: "按姓名或号码查找联系人",
+    permission: "系统「通讯录」权限",
+  },
+  location: {
+    name: "位置",
+    hint: "获取手机当前所在的位置",
+    permission: "系统「定位」权限",
+  },
+};
+
+const switchMap = Object.fromEntries(
+  PHONE_CONNECTOR_KINDS.map((kind) => [kind, z.boolean()]),
+) as Record<PhoneConnectorKind, z.ZodBoolean>;
+
+/** Which connectors the person turned on for this iPhone. */
+export const PhoneConnectorStateSchema = z.object(switchMap);
+export type PhoneConnectorState = z.infer<typeof PhoneConnectorStateSchema>;
+
+export const PHONE_CONNECTORS_OFF: PhoneConnectorState = {
+  alarms: false,
+  calendar: false,
+  reminders: false,
+  contacts: false,
+  location: false,
+};
+
+/** A stored value as the five switches; anything missing or malformed counts as off. */
+export function phoneConnectorState(value: unknown): PhoneConnectorState {
+  const parsed = PhoneConnectorStateSchema.partial().safeParse(value);
+  if (!parsed.success) return { ...PHONE_CONNECTORS_OFF };
+  return {
+    alarms: parsed.data.alarms === true,
+    calendar: parsed.data.calendar === true,
+    reminders: parsed.data.reminders === true,
+    contacts: parsed.data.contacts === true,
+    location: parsed.data.location === true,
+  };
+}
+
+export function phoneConnectorOn(state: PhoneConnectorState, kind: PhoneConnectorKind): boolean {
+  return state[kind] === true;
+}
+
+/** What the phone's settings screen reads and writes. */
+export const PhoneConnectorsResponseSchema = z.object({
+  /** A paired iPhone that is talking to the server right now. */
+  connected: z.boolean(),
+  /** The paired iPhone's own name, when there is one. */
+  deviceName: z.string().nullable(),
+  connectors: PhoneConnectorStateSchema,
+});
+export type PhoneConnectorsResponse = z.infer<typeof PhoneConnectorsResponseSchema>;
+
+export const PhoneConnectorsUpdateSchema = z.object({
+  connectors: PhoneConnectorStateSchema.partial(),
+});
+export type PhoneConnectorsUpdate = z.infer<typeof PhoneConnectorsUpdateSchema>;
+
+/** Whether iOS lets the app use a framework right now, as the phone reports it. */
+export const PHONE_PERMISSIONS = ["granted", "denied", "undetermined", "unavailable"] as const;
+export const PhonePermissionSchema = z.enum(PHONE_PERMISSIONS);
+export type PhonePermission = z.infer<typeof PhonePermissionSchema>;
+
+// ---------------------------------------------------------------------------
+// The requests the server sends the phone over its device socket, and the values it answers with.
+// Client and server share these names so a connector is the same thing on both sides.
+// ---------------------------------------------------------------------------
+
+export const PHONE_DEVICE_METHODS = [
+  "phoneStatus",
+  "phoneAlarmList",
+  "phoneAlarmSet",
+  "phoneAlarmCancel",
+  "phoneCalendarList",
+  "phoneCalendarCreate",
+  "phoneCalendarUpdate",
+  "phoneReminderList",
+  "phoneReminderCreate",
+  "phoneReminderComplete",
+  "phoneContactSearch",
+  "phoneLocation",
+] as const;
+export type PhoneDeviceMethod = (typeof PHONE_DEVICE_METHODS)[number];
+
+/** Every phone request names the bot and run it answers, the same as the computer ones. */
+export const phoneDeviceBase = {
+  botId: z.string().min(1).max(256),
+  runId: z.string().min(1).max(256).optional(),
+};
+
+/** A weekday the alarm repeats on: 1 = Monday … 7 = Sunday, as iOS counts them. */
+export const PhoneWeekdaySchema = z.number().int().min(1).max(7);
+
+export const PhoneAlarmSchema = z.object({
+  id: z.string().max(256),
+  hour: z.number().int().min(0).max(23),
+  minute: z.number().int().min(0).max(59),
+  label: z.string().max(256).default(""),
+  enabled: z.boolean(),
+  /** Empty for a one-off alarm. */
+  repeatDays: z.array(PhoneWeekdaySchema).max(7).default([]),
+});
+export type PhoneAlarm = z.infer<typeof PhoneAlarmSchema>;
+
+export const PhoneEventSchema = z.object({
+  id: z.string().max(256),
+  title: z.string().max(1024),
+  /** ISO 8601 with the phone's own offset. */
+  start: z.string().max(64),
+  end: z.string().max(64),
+  allDay: z.boolean().default(false),
+  location: z.string().max(1024).default(""),
+  notes: z.string().max(4096).default(""),
+  calendar: z.string().max(256).default(""),
+});
+export type PhoneEvent = z.infer<typeof PhoneEventSchema>;
+
+export const PhoneReminderSchema = z.object({
+  id: z.string().max(256),
+  title: z.string().max(1024),
+  due: z.string().max(64).nullable().default(null),
+  completed: z.boolean(),
+  list: z.string().max(256).default(""),
+  notes: z.string().max(4096).default(""),
+});
+export type PhoneReminder = z.infer<typeof PhoneReminderSchema>;
+
+export const PhoneContactSchema = z.object({
+  id: z.string().max(256),
+  name: z.string().max(512),
+  phones: z.array(z.string().max(64)).max(10).default([]),
+  emails: z.array(z.string().max(320)).max(10).default([]),
+});
+export type PhoneContact = z.infer<typeof PhoneContactSchema>;
+
+export const PhonePlaceSchema = z.object({
+  name: z.string().max(512).default(""),
+  thoroughfare: z.string().max(512).default(""),
+  locality: z.string().max(512).default(""),
+  administrativeArea: z.string().max(512).default(""),
+  country: z.string().max(512).default(""),
+  postalCode: z.string().max(64).default(""),
+});
+export type PhonePlace = z.infer<typeof PhonePlaceSchema>;
+
+/** What the phone answers. A refusal is `{ error }` with one of PHONE_DEVICE_ERRORS. */
+export const PHONE_DEVICE_ERRORS = [
+  "switch_off",
+  "permission_denied",
+  "unavailable",
+  "not_found",
+  "invalid",
+] as const;
+export type PhoneDeviceError = (typeof PHONE_DEVICE_ERRORS)[number];
+
+export const PhonePermissionMapSchema = z.object(
+  Object.fromEntries(PHONE_CONNECTOR_KINDS.map((kind) => [kind, PhonePermissionSchema])),
+);
+export type PhonePermissionMap = z.infer<typeof PhonePermissionMapSchema>;
