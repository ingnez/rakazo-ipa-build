+  saveToPhotos: vi.fn(async () => true),
+  recognizeText: vi.fn(async () => "hello"),
+  printImage: vi.fn(async () => true),
+}));
+const clipboard = vi.hoisted(() => ({ setImageAsync: vi.fn(async () => undefined) }));
+const sharing = vi.hoisted(() => ({
+  isAvailableAsync: vi.fn(async () => true),
+  shareAsync: vi.fn(async () => undefined),
+}));
+
+vi.mock("expo-modules-core", () => ({
+  requireOptionalNativeModule: () => native,
+}));
+vi.mock("expo-clipboard", () => clipboard);
+vi.mock("expo-sharing", () => sharing);
+vi.mock("expo-file-system", () => ({
+  File: class {
+    constructor(private uri: string) {}
+    async base64() {
+      return "YmFzZTY0";
+    }
+  },
+}));
+
+describe("image actions", () => {
+  beforeEach(() => {
+    native.saveToPhotos.mockClear();
+    native.recognizeText.mockClear();
+    native.printImage.mockClear();
+    clipboard.setImageAsync.mockClear();
+  });
+
+  it("saves, recognizes, prints, and copies through the native module", async () => {
+    const actions = await import("./image-actions.js");
+    expect(actions.imageActionsAvailable()).toEqual({ save: true, recognize: true, print: true });
+    await expect(actions.saveImageToPhotos("file:///tmp/a.jpg")).resolves.toBe(true);
+    await expect(actions.recognizeImageText("file:///tmp/a.jpg")).resolves.toBe("hello");
+    await expect(actions.printImage("file:///tmp/a.jpg")).resolves.toBe(true);
+    await expect(actions.copyImage("file:///tmp/a.jpg")).resolves.toBe(true);
+    expect(clipboard.setImageAsync).toHaveBeenCalledWith("YmFzZTY0");
+  });
+});
