+import { useLingui } from "@lingui/react/macro";
+import type { ReactNode } from "react";
+import { Pressable, Text, View } from "react-native";
+import { useThemedStyles } from "../lib/native";
+import { createIntegrationsStyles } from "./integrations-styles";
+
+/**
+ * One line of 「连接应用」: the app's icon, its name and one grey line, and a grey pill that says
+ * whether it is connected yet. The whole line is the target — tapping it connects the app, or
+ * opens what is already connected — so the pill never has to be a second, smaller target.
+ */
+export function ConnectAppRow({
+  icon,
+  title,
+  subtitle,
+  connected,
+  connectLabel,
+  connectedLabel,
+  busy,
+  disabled,
+  onPress,
+  testID,
+}: {
+  icon: ReactNode;
+  title: string;
+  subtitle?: string;
+  connected: boolean;
+  /** What the pill says when the app can be connected; 「连接」unless a caller names it. */
+  connectLabel?: string;
+  connectedLabel?: string;
+  busy?: boolean;
+  disabled?: boolean;
+  onPress: () => void;
+  testID?: string;
+}) {
+  const styles = useThemedStyles(createIntegrationsStyles);
+  const { t } = useLingui();
+  const resting = connected ? (connectedLabel ?? t`Connected`) : (connectLabel ?? t`Connect`);
+  // A catalog that hands the title back as its account name ("Gmail" under "Gmail") gets one
+  // line, not the same word twice: the reference app's rows are one line of type each.
+  const detail =
+    subtitle?.trim() && subtitle.trim().toLowerCase() !== title.trim().toLowerCase()
+      ? subtitle
+      : undefined;
+  const label = busy ? t`Working…` : resting;
+  return (
+    <Pressable
+      accessibilityRole="button"
+      accessibilityLabel={`${title} ${label}`}
+      accessibilityState={{ disabled: Boolean(disabled) }}
+      disabled={disabled}
+      onPress={onPress}
+      style={({ pressed }) => [styles.appRow, pressed && styles.appPressed]}
+      testID={testID}
+    >
+      {icon}
+      <View style={styles.grow}>
+        <Text numberOfLines={1} style={styles.appTitle}>
+          {title}
+        </Text>
+        {detail ? (
+          <Text numberOfLines={1} style={styles.appSubtitle}>
+            {detail}
+          </Text>
+        ) : null}
+      </View>
+      <View style={[styles.pill, connected && styles.pillQuiet]}>
+        <Text style={[styles.pillLabel, connected && styles.pillQuietLabel]}>{label}</Text>
+      </View>
+    </Pressable>
+  );
+}
