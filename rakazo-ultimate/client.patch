@@ -0,0 +1,48 @@
+import { BOT_COLOR_LIST } from "@rakazo/contracts";
+import { contrastRatio } from "./bot-avatar-colors.js";
+
+const WHITE = BOT_COLOR_LIST.find((color) => color.id === "white")!;
+
+/**
+ * The palette as the app draws it in the dark appearance: each colour's own `darkHex`, reached
+ * from its current value and from every value an earlier build stored for it. The black body
+ * turns into the palette's white there, so it is still a face and not a hole (see
+ * `DARK_BODY_ON_DARK`). A colour the palette does not hold is drawn as stored.
+ */
+export const BOT_AVATAR_DARK_FILLS: Readonly<Record<string, string>> = Object.fromEntries(
+  BOT_COLOR_LIST.flatMap((color) => {
+    const dark = color.id === "black" ? WHITE.hex : (color.darkHex ?? color.hex);
+    return [color.hex, ...(color.legacyHexes ?? [])].map((hex) => [hex.toUpperCase(), dark]);
+  }),
+);
+
+/** The soft gray a body too pale for the light page is drawn in instead of vanishing. */
+export const PALE_BODY_LIGHT_FILL = "#E5E5EA";
+
+/** How close to the page a body may be before it needs that gray to be seen at all. */
+const PALE_BODY_ON_LIGHT = 1.2;
+
+/**
+ * How dark a body may be, on the dark page, before it is drawn white instead.
+ *
+ * Pure black is the case the reference app shows; the threshold is what catches the near-black
+ * colors a bot can also be given, which would otherwise be a face nobody can see.
+ */
+const DARK_BODY_ON_DARK = 1.25;
+/** The body a too-dark bot is drawn as, on the dark page. */
+export const FLIPPED_BODY_DARK_FILL = WHITE.hex;
+
+/**
+ * The color a bot body is filled with, in the appearance it is drawn in. A white or near-white
+ * body would vanish into a light page, so it is drawn as a soft gray there; dark eyes are what
+ * the ink puts on it. A black or near-black body would vanish into the dark page the same way, so
+ * it turns white there, and its eyes take the black ink instead.
+ */
+export function botAvatarFill(color: string, dark: boolean): string {
+  if (!dark) {
+    return contrastRatio(color, "#FFFFFF") < PALE_BODY_ON_LIGHT ? PALE_BODY_LIGHT_FILL : color;
+  }
+  if (contrastRatio(color, "#000000") < DARK_BODY_ON_DARK) return FLIPPED_BODY_DARK_FILL;
+  const fill = BOT_AVATAR_DARK_FILLS[color.toUpperCase()] ?? color;
+  return fill;
+}
