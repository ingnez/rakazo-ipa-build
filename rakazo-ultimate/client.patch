diff --git a/scripts/generate-babygrok-geometry.py b/scripts/generate-babygrok-geometry.py
new file mode 100644
index 0000000..3aaf36f
--- /dev/null
+++ b/scripts/generate-babygrok-geometry.py
@@ -0,0 +1,319 @@
+#!/usr/bin/env python3
+"""Builds packages/core/src/babygrok-geometry.ts from Grok Bot's own babygrok-geometry.json.
+
+    python3 scripts/generate-babygrok-geometry.py
+
+The reference app ships that file in its bundle; `packages/core/src/babygrok-geometry.json` is
+it, byte for byte.
+
+Grok Bot draws each bot body as a polygon ring whose vertex count differs per shape
+(27 for `crystal`, 135 for `star`), so the rings cannot be interpolated vertex-by-vertex as
+they are. This samples every ring on 64 evenly spaced directions from the head centre, which
+gives every shape the same 64 vertices in the same order: vertex k of one shape morphs into
+vertex k of another, and the bodies in between stay jelly instead of twisting.
+
+The eyes are measured off the same file: the two eye subpaths give each body's eye pair
+(midpoint, gap, capsule length and tilt). A pair that was authored running off the body edge
+is pulled back inside, and every shape gets `travel`: how far the pair may move from there
+during a gaze and stay whole.
+
+Everything is expressed relative to the head centre and scaled so each body's furthest point
+is 100 units out, so any body fills an avatar box the same way.
+"""
+
+import json
+import math
+import pathlib
+import re
+import sys
+
+VERTICES = 64
+UNITS = 100.0
+# Turned clockwise from the top, the direction a shape is drawn in.
+START_ANGLE = -math.pi / 2
+MARGIN = 3.0
+# The eye capsule's outline is sampled on this many directions per end cap.
+CAP_STEPS = 8
+# Eye thickness to length, measured off the bodies whose eyes sit whole on the body.
+EYE_RATIO = 0.405
+# A stadium's area for a given length and thickness, used to recover length from the art.
+AREA_RATIO = 0.37
+
+HERE = pathlib.Path(__file__).resolve().parent.parent
+GEOMETRY = HERE / "packages/core/src/babygrok-geometry.json"
+OUT = HERE / "packages/core/src/babygrok-geometry.ts"
+# The picker's own order, so a bot's stored shapeIndex keeps its body.
+ORDER = [
+    "hex", "wedge", "squircle", "tablet", "pebble", "blob", "teardrop", "cloud", "bean",
+    "egg", "capsule", "cylinder", "gem", "crystal", "shield", "dome", "arch", "leaf",
+    "square", "sparkle", "clover", "flower", "heart", "house", "star", "pumpkin",
+]
+
+
+def subpaths(path):
+    return [part for part in re.split(r"(?=M)", path) if part.strip()]
+
+
+def points(subpath):
+    numbers = [float(n) for n in re.findall(r"-?\d+\.?\d*", subpath)]
+    return list(zip(numbers[0::2], numbers[1::2]))
+
+
+def centroid(ring):
+    a = cx = cy = 0.0
+    for index, (x0, y0) in enumerate(ring):
+        x1, y1 = ring[(index + 1) % len(ring)]
+        cross = x0 * y1 - x1 * y0
+        a += cross
+        cx += (x0 + x1) * cross
+        cy += (y0 + y1) * cross
+    a *= 0.5
+    return cx / (6 * a), cy / (6 * a)
+
+
+def area(ring):
+    total = 0.0
+    for index, (x0, y0) in enumerate(ring):
+        x1, y1 = ring[(index + 1) % len(ring)]
+        total += x0 * y1 - x1 * y0
+    return abs(total) / 2
+
+
+def ray_hit(ring, origin, angle):
+    """How far from `origin` the polygon's edge is along `angle` (the farthest crossing)."""
+    dx, dy = math.cos(angle), math.sin(angle)
+    hits = []
+    for index, (x0, y0) in enumerate(ring):
+        x1, y1 = ring[(index + 1) % len(ring)]
+        ex, ey = x1 - x0, y1 - y0
+        denom = dx * ey - dy * ex
+        if abs(denom) < 1e-12:
+            continue
+        px, py = x0 - origin[0], y0 - origin[1]
+        t = (px * ey - py * ex) / denom
+        u = (px * dy - py * dx) / denom
+        if t > 0 and -1e-9 <= u <= 1 + 1e-9:
+            hits.append(t)
+    return max(hits) if hits else 0.0
+
+
+def inside(ring, point):
+    x, y = point
+    odd = False
+    for index, (x0, y0) in enumerate(ring):
+        x1, y1 = ring[(index + 1) % len(ring)]
+        if (y0 > y) != (y1 > y):
+            if x < x0 + (y - y0) * (x1 - x0) / (y1 - y0):
+                odd = not odd
+    return odd
+
+
+def capsule(center, angle, length, thickness):
+    """The eye's outline: a stadium on `angle`, both ends rounded."""
+    out = []
+    radius = thickness / 2
+    half = max(length / 2 - radius, 0)
+    ax, ay = math.cos(angle), math.sin(angle)
+    for end in (-1, 1):
+        ex = center[0] + ax * half * end
+        ey = center[1] + ay * half * end
+        base = angle + (0 if end > 0 else math.pi)
+        for step in range(CAP_STEPS + 1):
+            t = base - math.pi / 2 + math.pi * step / CAP_STEPS
+            out.append((ex + math.cos(t) * radius, ey + math.sin(t) * radius))
+    return out
+
+
+def eye_metrics(ring):
+    """The eye's centre and long axis, from its own outline."""
+    cx, cy = centroid(ring)
+    sxx = sum((x - cx) ** 2 for x, y in ring) / len(ring)
+    syy = sum((y - cy) ** 2 for x, y in ring) / len(ring)
+    sxy = sum((x - cx) * (y - cy) for x, y in ring) / len(ring)
+    angle = 0.5 * math.atan2(2 * sxy, sxx - syy)
+    return {"cx": cx, "cy": cy, "angle": angle, "area": area(ring)}
+
+
+def pair_fits(ring, mid, angle, gap, length, thickness):
+    half_ax, half_ay = math.cos(angle) * gap / 2, math.sin(angle) * gap / 2
+    for end in (-1, 1):
+        eye = (mid[0] + half_ax * end, mid[1] + half_ay * end)
+        for point in capsule(eye, angle, length, thickness):
+            if not inside(ring, point):
+                return False
+    return True
+
+
+def main():
+    shapes = json.load(open(GEOMETRY))["shapes"]
+    missing = [name for name in ORDER if name not in shapes]
+    if missing:
+        sys.exit(f"shapes missing from the reference: {missing}")
+    head = json.load(open(GEOMETRY))["headCenter"]
+
+    rows = []
+    for name in ORDER:
+        subs = subpaths(shapes[name]["path"])
+        outer = points(subs[0])
+        center = centroid(outer)
+        # Every vertex on its own direction from the head centre.
+        radii = []
+        for index in range(VERTICES):
+            angle = START_ANGLE + 2 * math.pi * index / VERTICES
+            radii.append(ray_hit(outer, center, angle))
+        # The body's own scale: its furthest point lands UNITS from the centre.
+        widest = max(radii)
+        grow = widest / UNITS
+
+        eyes = [eye_metrics(points(sub)) for sub in subs[1:]]
+        # Two angles: the line the pair sits on, and the way each eye's own capsule lies.
+        angle = math.atan2(eyes[1]["cy"] - eyes[0]["cy"], eyes[1]["cx"] - eyes[0]["cx"])
+        if angle < 0:
+            angle += math.pi
+        eye_angle = sum(
+            (eye["angle"] % math.pi) for eye in eyes
+        ) / 2
+        length = math.sqrt(max(eye["area"] for eye in eyes) / AREA_RATIO) / grow
+        thickness = length * EYE_RATIO
+        gap = math.hypot(eyes[1]["cx"] - eyes[0]["cx"], eyes[1]["cy"] - eyes[0]["cy"]) / grow
+        mid = [
+            ((eyes[0]["cx"] + eyes[1]["cx"]) / 2 - head) / grow,
+            ((eyes[0]["cy"] + eyes[1]["cy"]) / 2 - head) / grow,
+        ]
+        # In the body's own units: the ring around the head centre, one point every
+        # 360/64 degrees, `grow`-scaled.
+        ring = []
+        for index in range(VERTICES):
+            a = START_ANGLE + 2 * math.pi * index / VERTICES
+            ring.append((math.cos(a) * radii[index] / grow, math.sin(a) * radii[index] / grow))
+        flat = [value for point in ring for value in point]
+
+        def fits(m):
+            return pair_fits(ring, m, angle, gap, length, thickness)
+
+        # Pull the pair toward the centre until both eyes sit whole.
+        if not fits(mid):
+            for _ in range(400):
+                mid[0] *= 0.99
+                mid[1] *= 0.99
+                if fits(mid):
+                    break
+        # How far the pair can then travel in each direction and stay whole: a gaze spends
+        # this and no more, so the eyes never leave the body however they look about.
+        budget = []
+        for step in range(VERTICES):
+            theta = 2 * math.pi * step / VERTICES
+            distance = 0.0
+            while distance < UNITS:
+                probe = [mid[0] + math.cos(theta) * distance, mid[1] + math.sin(theta) * distance]
+                if not fits(probe):
+                    break
+                distance += 0.5
+            budget.append(max(0.0, distance - 0.5))
+        if max(budget) <= 0:
+            # A pair that cannot move at all would freeze the face; give it the room it has.
+            grow_back = 0.9
+            while max(budget) <= 0 and grow_back > 0.4:
+                length *= grow_back
+                thickness = length * EYE_RATIO
+                gap *= grow_back
+                budget = []
+                for step in range(VERTICES):
+                    theta = 2 * math.pi * step / VERTICES
+                    distance = 0.0
+                    while distance < UNITS:
+                        probe = [
+                            mid[0] + math.cos(theta) * distance,
+                            mid[1] + math.sin(theta) * distance,
+                        ]
+                        if not fits(probe):
+                            break
+                        distance += 0.5
+                    budget.append(max(0.0, distance - 0.5))
+                grow_back -= 0.1
+
+        rows.append(
+            {
+                "name": name,
+                "ring": flat,
+                "eyes": [
+                    mid[0],
+                    mid[1],
+                    gap,
+                    length,
+                    thickness,
+                    math.degrees(eye_angle),
+                    math.degrees(angle),
+                ],
+                "budget": budget,
+            }
+        )
+
+    def numbers(values, digits=1):
+        return ", ".join(f"{value:.{digits}f}" for value in values)
+
+    lines = [
+        "/**",
+        " * BabyGrok's own bot bodies, measured from the `babygrok-geometry.json` the reference",
+        " * app ships. Every shape's outer ring is resampled onto the same 64 directions from",
+        " * the head centre, so two shapes' vertices correspond one to one and a body can be",
+        " * interpolated into another vertex by vertex.",
+        " *",
+        " * Generated by `scripts/generate-babygrok-geometry.py` from",
+        " * `packages/core/src/babygrok-geometry.json`; do not edit by hand.",
+        " */",
+        "",
+        '/** The box every body is drawn in: 200 units around the head centre. */',
+        'export const BABYGROK_VIEWBOX = "-100 -100 200 200";',
+        "/** Every body's outer ring, as this many x,y pairs, clockwise from the top. */",
+        f"export const BABYGROK_VERTICES = {VERTICES};",
+        "",
+        "/** A body: its ring, and the face it wears. */",
+        "export interface BabygrokBody {",
+        "  /** The outer ring's x,y pairs, clockwise from the top. */",
+        "  readonly ring: readonly number[];",
+        "  /** The eye pair: its centre, the gap between the eyes, their length, their",
+        "   * thickness, the tilt of each eye in degrees, and the tilt of the pair. */",
+        "  readonly eyes: readonly [",
+        "    number,",
+        "    number,",
+        "    number,",
+        "    number,",
+        "    number,",
+        "    number,",
+        "    number,",
+        "  ];",
+        "  /** How far the eye pair may travel, one entry every 360/64 degrees from due right,",
+        "   * and still stay whole on the body. A gaze spends no more than its direction allows. */",
+        "  readonly budget: readonly number[];",
+        "}",
+        "",
+        "export const BABYGROK_BODIES: Record<string, BabygrokBody> = {",
+    ]
+    for row in rows:
+        lines.append(f"  {row['name']}: {{")
+        lines.append(f"    ring: [{numbers(row['ring'])}],")
+        lines.append(f"    eyes: [{numbers(row['eyes'])}],")
+        lines.append(f"    budget: [{numbers(row['budget'])}],")
+        lines.append("  },")
+    lines.append("};")
+    lines.append("")
+    lines.append("/** The bodies the picker offers, in the order a stored shape index counts. */")
+    lines.append("export const BABYGROK_BODY_KEYS = [")
+    for name in ORDER:
+        lines.append(f'  "{name}",')
+    lines.append("] as const;")
+    lines.append("")
+    open(OUT, "w").write("\n".join(lines) + "\n")
+    print(f"wrote {OUT}")
+    for row in rows:
+        e = row["eyes"]
+        print(
+            f"  {row['name']:9} {len(row['ring']) // 2} pts  "
+            f"eyes ({e[0]:+.0f},{e[1]:+.0f}) gap {e[2]:.0f} len {e[3]:.0f} "
+            f"thick {e[4]:.0f} eye {e[5]:.0f}° pair {e[6]:.0f}° travel {min(row['budget']):.0f}–{max(row['budget']):.0f}"
+        )
+
+
+if __name__ == "__main__":
+    main()
