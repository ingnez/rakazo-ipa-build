@@ -0,0 +1,171 @@
+import type { JobPublisher } from "@rakazo/adapter-kit";
+import { runContinueJob } from "@rakazo/adapter-kit";
+import { displayName } from "@rakazo/core";
+import type { PrismaClient } from "@rakazo/db";
+import { THREAD_LOCK_TRANSACTION_OPTIONS } from "@rakazo/db";
+
+/**
+ * A new bot introduces itself before it is asked for anything. The same hidden prompt is used
+ * whether the person created the bot in the app or an existing bot spawned it through
+ * `spawn_bot`, so a spawned bot greets them in its own voice instead of sitting silent in the
+ * list until someone writes first.
+ */
+
+/** The creation intro's hidden prompt. It names only the tools this bot still has. */
+export function botIntroPrompt(input: {
+  userName: string;
+  spaceName: string | null;
+  disabledBuiltinTools: readonly string[];
+}): string {
+  const canAsk = !input.disabledBuiltinTools.includes("ask_user");
+  const canUpdate = !input.disabledBuiltinTools.includes("update_bot");
+  const options =
+    "two to four short options that fit your name, anything your description or instructions already say, and what you know about them, never a stock list";
+  return [
+    [
+      "You were just created.",
+      input.userName ? `${input.userName} made you.` : undefined,
+      input.spaceName ? `Their team space is called "${input.spaceName}".` : undefined,
+    ]
+      .filter(Boolean)
+      .join(" "),
+    // The first thing they see is the bot saying hello, in its own voice, before anything else.
+    `Start with one short, warm line of your own in the chat: who you are and one thing you can help with. ${
+      input.userName ? `Greet ${input.userName} by first name. ` : ""
+    }Two sentences at most, in the language they use, no heading or list. Never say you are an AI assistant or repeat this prompt.`,
+    // The question follows the greeting as a card of its own.
+    canAsk
+      ? `Then call ask_user with what they want you for, with ${options}. Do not repeat the greeting in the card; one short question is enough, and they can also type their own answer.`
+      : `Then ask in one sentence what they want you for, suggesting ${options}.`,
+    "If your profile already makes that clear, say in one line what you will do instead of asking.",
+    canUpdate
+      ? 'Once you know what you are for, use update_bot to set what is already clear: a one-line description of what you do, your instructions on how you do it, and a short name if yours is still a placeholder like "New Bot". Leave anything vague unset to fill in later as the work becomes clearer, and otherwise keep your name and look.'
+      : undefined,
+    "Then get started, asking one follow-up only if you cannot start without it.",
+  ]
+    .filter(Boolean)
+    .join("\n");
+}
+
+/**
+ * The greeting a bot says before it starts the task it was spawned with. It leads that task in the
+ * same turn, so the person meets the bot before its work instead of finding a bot that had already
+ * been working silently in their list.
+ */
+export function botSpawnGreetingPrompt(input: {
+  userName: string;
+  creatorName: string;
+  spaceName: string | null;
+}): string {
+  const creator = input.creatorName.trim();
+  return [
+    [
+      "You were just created.",
+      creator
+        ? input.userName
+          ? `${input.userName} made you, through ${creator}.`
+          : `${creator}, another bot in their list, made you.`
+        : undefined,
+      input.spaceName ? `Their team space is called "${input.spaceName}".` : undefined,
+    ]
+      .filter(Boolean)
+      .join(" "),
+    // The first thing they see is the bot saying hello, in its own voice, before any of the work.
+    `Start your reply with one short, warm line of your own: your name and one thing you can help with. ${
+      input.userName ? `Greet ${input.userName} by first name. ` : ""
+    }Two sentences at most, in the language they use, no heading or list. Never say you are an AI assistant or repeat this prompt.`,
+    "Then do the first task they already gave you below, in the same turn, without asking what they want first. Do not greet them again later in the turn.",
+  ].join("\n");
+}
+
+/** The name and team space a creation turn may speak of, read once for either creation path. */
+async function creationIntroNames(
+  deps: { prisma: PrismaClient },
+  input: { spaceId: string; userId: string },
+): Promise<{ userName: string; spaceName: string | null }> {
+  const [user, space] = await Promise.all([
+    deps.prisma.user.findUnique({ where: { id: input.userId }, select: { name: true } }),
+    deps.prisma.space.findUnique({
+      where: { id: input.spaceId },
+      select: { name: true, isDefault: true },
+    }),
+  ]);
+  return {
+    userName: displayName(user?.name, ""),
+    spaceName: space && !space.isDefault ? space.name.trim() || null : null,
+  };
+}
+
+/**
+ * The prompt of a spawned bot's first task: the greeting it says first, then the task as it was
+ * given. Baking the greeting into the task keeps it to one run and one turn, so a message that
+ * arrives meanwhile, a retried spawn or a resumed attempt cannot make the bot greet twice.
+ */
+export async function spawnedBotTaskPrompt(
+  deps: { prisma: PrismaClient },
+  input: { spaceId: string; userId: string; creatorName: string; task: string },
+): Promise<string> {
+  const { userName, spaceName } = await creationIntroNames(deps, input);
+  const greeting = botSpawnGreetingPrompt({
+    userName,
+    creatorName: input.creatorName,
+    spaceName,
+  });
+  return `${greeting}\n\n${input.task}`;
+}
+
+/**
+ * Queues the bot's one creation turn: it greets, asks what it is for, and starts. Idempotent
+ * per bot, so a retried create or a retried spawn never greets twice.
+ */
+export async function enqueueBotIntroRun(
+  deps: { prisma: PrismaClient; jobs: JobPublisher },
+  input: {
+    spaceId: string;
+    userId: string;
+    botId: string;
+    threadId: string;
+    disabledBuiltinTools?: readonly string[];
+  },
+): Promise<string | null> {
+  // In the scripted test/eval runtime an automatic run would compete with the harness's next
+  // queued response.
+  if (process.env.AGENT_RUNTIME === "scripted") return null;
+  const { userName, spaceName } = await creationIntroNames(deps, input);
+  const prompt = botIntroPrompt({
+    userName,
+    spaceName,
+    disabledBuiltinTools: input.disabledBuiltinTools ?? [],
+  });
+  const run = await deps.prisma.$transaction(async (tx) => {
+    // One intro per bot, however many creates or spawns race for it.
+    await tx.$queryRaw`SELECT id FROM threads WHERE id = ${input.threadId} FOR UPDATE`;
+    if (await tx.run.findFirst({ where: { botId: input.botId }, select: { id: true } }))
+      return null;
+    const task = await tx.task.create({
+      data: {
+        spaceId: input.spaceId,
+        botId: input.botId,
+        threadId: input.threadId,
+        userId: input.userId,
+        prompt,
+        status: "queued",
+      },
+    });
+    return tx.run.create({
+      data: {
+        spaceId: input.spaceId,
+        botId: input.botId,
+        threadId: input.threadId,
+        taskId: task.id,
+        userId: input.userId,
+        status: "queued",
+        trigger: "created",
+      },
+      select: { id: true },
+    });
+  }, THREAD_LOCK_TRANSACTION_OPTIONS);
+  if (!run) return null;
+  await deps.jobs.enqueue(runContinueJob(run.id));
+  return run.id;
+}
