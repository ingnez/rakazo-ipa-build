+/**
+ * One stretch of this chat, as it was written up afterwards: the day and the messages it covers,
+ * what came of it, what it left open, and the one tap back to where it starts.
+ */
+function DiaryCard({
+  diary,
+  body,
+  opened,
+  onOpen,
+  onJump,
+}: {
+  diary: DiarySummary;
+  /** The full record, once the opened card has read it. */
+  body?: string;
+  opened: boolean;
+  onOpen: () => void;
+  onJump: () => void;
+}) {
+  const tokens = useMobileTokens();
+  const hooks = diary.openHooks;
+  // A long stretch says how many hooks are still open; the first two are worth reading at once.
+  const shownHooks = opened ? hooks : hooks.slice(0, 2);
+  return (
+    <View style={[styles.card, styles.stack, { backgroundColor: native.groupedCell }]}>
+      <Pressable
+        accessibilityRole="button"
+        accessibilityLabel={`${diary.title}，${diary.summary}`}
+        onPress={onOpen}
+        style={{ gap: 3 }}
+      >
+        <Text style={[styles.dayLabel, { color: native.tertiaryLabel }]}>{diarySpan(diary)}</Text>
+        <Text
+          numberOfLines={opened ? undefined : 2}
+          style={[styles.cardTitle, { color: native.label }]}
+        >
+          {diary.title}
+        </Text>
+        <Text
+          numberOfLines={opened ? undefined : 2}
+          style={[styles.learningText, { color: native.secondaryLabel }]}
+        >
+          {diary.summary}
+        </Text>
+      </Pressable>
+      {opened ? (
+        <Text style={[styles.learningText, { color: native.label }]}>
+          {body?.trim() || diary.summary}
+        </Text>
+      ) : null}
+      {shownHooks.length > 0 ? (
+        <View style={styles.hooks}>
+          {shownHooks.map((hook) => (
+            <View key={hook} style={[styles.hookChip, { backgroundColor: native.fill }]}>
+              <NativeSymbol
+                ios="circle.dashed"
+                android="ellipse-outline"
+                size={11}
+                color={tokens.warning}
+              />
+              <Text numberOfLines={1} style={[styles.hookText, { color: native.secondaryLabel }]}>
+                {hook}
+              </Text>
+            </View>
+          ))}
+          {!opened && hooks.length > shownHooks.length ? (
+            <Text style={[styles.hookText, { color: native.tertiaryLabel }]}>
+              +{hooks.length - shownHooks.length}
+            </Text>
+          ) : null}
+        </View>
+      ) : null}
+      {opened ? (
+        <Pressable
+          accessibilityRole="button"
+          accessibilityLabel="跳回原对话"
+          onPress={onJump}
+          style={({ pressed }) => [styles.jumpRow, { opacity: pressed ? 0.6 : 1 }]}
+        >
+          <NativeSymbol
+            ios="arrow.uturn.backward"
+            android="return-up-back-outline"
+            size={14}
+            color={tokens.accent}
+          />
+          <Text style={[styles.link, { color: tokens.accent }]}>跳回原对话</Text>
+        </Pressable>
+      ) : null}
+    </View>
+  );
+}
+
+/** "11月16日 23:41 · #120-#134 · 15 条消息": the day it happened and the stretch it covers. */
+function diarySpan(diary: DiarySummary): string {
+  const day = /^(\d{4})-(\d{2})-(\d{2})$/.exec(diary.day);
+  const date = day ? `${Number(day[2])}月${Number(day[3])}日` : diary.day;
+  const at = new Date(diary.createdAt);
+  const time = Number.isNaN(at.getTime())
+    ? ""
+    : at.toLocaleTimeString("zh-CN", { hour: "2-digit", minute: "2-digit" });
+  const range =
+    diary.endSeq > diary.startSeq ? `#${diary.startSeq}-#${diary.endSeq}` : `#${diary.startSeq}`;
+  return [date, time, range, diary.messageCount > 0 ? `${diary.messageCount} 条消息` : ""]
+    .filter(Boolean)
+    .join(" · ");
+}
+
+function firstLine(text: string | null | undefined): string {
+  return (text ?? "").split("\n")[0]?.trim() ?? "";
+}
+
+/** When the schedule runs next, in the shortest form that still reads as time. */
+export function nextRun(routine: Pick<Routine, "active" | "nextRunAt">, now = Date.now()): string {
+  if (!routine.active || !routine.nextRunAt) return "";
+  const at = new Date(routine.nextRunAt).getTime();
+  if (!Number.isFinite(at)) return "";
+  const minutes = Math.round((at - now) / 60_000);
+  if (minutes <= 0) return "马上跑";
+  if (minutes < 60) return `下次 ${minutes} 分钟后`;
+  const hours = Math.round(minutes / 60);
+  if (hours < 24) return `下次 ${hours} 小时后`;
+  return `下次 ${Math.round(hours / 24)} 天后`;
+}
