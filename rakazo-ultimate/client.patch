@@ -0,0 +1,15 @@
+/**
+ * The name as the reference app shows it: the stem as the title, the extension as the format.
+ *
+ * A dot in the middle of a name is only an extension when what follows could be one — letters, or
+ * digits after a leading letter (".7z" counts, "v1.2" does not) — so a file called "2026.11 计划"
+ * keeps its whole name instead of losing half of it to a made-up format.
+ */
+export function splitFileName(name: string): { title: string; extension?: string } {
+  const dot = name.lastIndexOf(".");
+  if (dot <= 0 || dot === name.length - 1) return { title: name };
+  const extension = name.slice(dot + 1);
+  if (!/^[A-Za-z0-9]{1,8}$/.test(extension) || !/[A-Za-z]/.test(extension)) return { title: name };
+  const title = name.slice(0, dot).trim();
+  return title ? { title, extension: extension.toUpperCase() } : { title: name };
+}
