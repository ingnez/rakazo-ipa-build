@@ -0,0 +1,255 @@
+import type { RealtimeCallPlan } from "@rakazo/contracts";
+import { describe, expect, it, vi } from "vitest";
+import type { RealtimeAudioPort } from "./realtime-audio";
+import type { OpenRealtimeSocket, RealtimeCallPhase, RealtimeSocketHandlers } from "./realtime-call";
+import { RealtimeCall } from "./realtime-call";
+
+const PLAN: RealtimeCallPlan = {
+  callId: "call-1",
+  botId: "bot-1",
+  threadId: "thread-1",
+  provider: "bailian-cn",
+  providerName: "阿里百炼 Realtime · 北京",
+  model: "qwen3.8-omni-flash-realtime",
+  voice: "Tina",
+  inputSampleRate: 16000,
+  outputSampleRate: 24000,
+  audioFormat: "binary",
+  path: "/api/voice/realtime?botId=bot-1&callId=call-1&format=binary",
+  maxDurationSeconds: 1800,
+};
+
+/** The socket, the audio and the call card, as a call would drive them. */
+function harness() {
+  const sent: Array<string | ArrayBuffer> = [];
+  const phases: RealtimeCallPhase[] = [];
+  const captions: string[] = [];
+  const userText: Array<[string, boolean]> = [];
+  const botText: Array<[string, boolean]> = [];
+  const closed: Array<Record<string, unknown>> = [];
+  let handlers: RealtimeSocketHandlers | null = null;
+  let url = "";
+  let headers: Record<string, string> = {};
+  const timers: Array<{ callback: () => void; ms: number }> = [];
+  let mic: ((pcm: Uint8Array) => void) | null = null;
+  const audioMocks = {
+    start: vi.fn(),
+    stop: vi.fn(),
+    setMuted: vi.fn(),
+    play: vi.fn(),
+    flush: vi.fn(),
+    listen: vi.fn((onFrame: (pcm: Uint8Array) => void) => {
+      mic = onFrame;
+      return () => {
+        mic = null;
+      };
+    }),
+    onInterruption: vi.fn(() => () => undefined),
+  };
+  const openSocket = vi.fn<OpenRealtimeSocket>((socketUrl, socketHeaders, socketHandlers) => {
+    url = socketUrl;
+    headers = socketHeaders;
+    handlers = socketHandlers;
+    return {
+      send: (data) => sent.push(data),
+      close: () => undefined,
+    };
+  });
+  const call = new RealtimeCall(
+    PLAN,
+    {
+      audio: audioMocks as unknown as RealtimeAudioPort,
+      openSocket,
+      setTimer: (callback, ms) => {
+        timers.push({ callback, ms });
+        return timers.length;
+      },
+      clearTimer: () => undefined,
+    },
+    {
+      onReady: vi.fn(),
+      onPhase: (phase) => phases.push(phase),
+      onUserText: (text, final) => userText.push([text, final]),
+      onAssistantText: (text, final) => botText.push([text, final]),
+      onCaption: (text) => captions.push(text),
+      onClosed: (result) => closed.push(result as unknown as Record<string, unknown>),
+    },
+  );
+  call.connect({ apiBase: "https://rakazo.163ll.com", headers: { authorization: "Bearer t" } });
+  return {
+    call,
+    audio: audioMocks,
+    sent,
+    phases,
+    captions,
+    userText,
+    botText,
+    closed,
+    timers,
+    mic: () => mic,
+    socket: () => handlers,
+    url: () => url,
+    headers: () => headers,
+  };
+}
+
+function frame(socket: RealtimeSocketHandlers | null, body: unknown) {
+  socket?.onMessage(JSON.stringify(body));
+}
+
+describe("RealtimeCall", () => {
+  it("opens the call's socket on the app's server with its own sign-in", () => {
+    const h = harness();
+    expect(h.url()).toBe(
+      "wss://rakazo.163ll.com/api/voice/realtime?botId=bot-1&callId=call-1&format=binary",
+    );
+    expect(h.headers()).toEqual({ authorization: "Bearer t" });
+    expect(h.phases).toEqual(["connecting"]);
+  });
+
+  it("streams the microphone only once the gateway is ready", () => {
+    const h = harness();
+    // Audio the phone produced before `ready` is worth nothing to the gateway.
+    expect(h.audio.listen).not.toHaveBeenCalled();
+    frame(h.socket(), { type: "ready", inputSampleRate: 16000, outputSampleRate: 24000 });
+    expect(h.audio.start).toHaveBeenCalledWith(16000, 24000);
+    expect(h.audio.listen).toHaveBeenCalledOnce();
+    expect(h.phases).toEqual(["connecting", "listening"]);
+    h.mic()?.(new Uint8Array([1, 2, 3, 4]));
+    expect(h.sent).toHaveLength(1);
+    expect([...new Uint8Array(h.sent[0] as ArrayBuffer)]).toEqual([1, 2, 3, 4]);
+  });
+
+  it("stops the reply the moment the model hears the caller", () => {
+    const h = harness();
+    frame(h.socket(), { type: "ready" });
+    frame(h.socket(), { type: "response.start" });
+    expect(h.phases).toEqual(["connecting", "listening", "speaking"]);
+    frame(h.socket(), { type: "speech.start" });
+    expect(h.audio.flush).toHaveBeenCalledOnce();
+    expect(h.phases.at(-1)).toBe("listening");
+  });
+
+  it("shows both sides' words as they arrive", () => {
+    const h = harness();
+    frame(h.socket(), { type: "ready" });
+    frame(h.socket(), { type: "user.text", text: "帮我看看", final: false });
+    frame(h.socket(), { type: "user.text", text: "帮我看看排班", final: true });
+    frame(h.socket(), { type: "assistant.text", text: "好", final: false });
+    frame(h.socket(), { type: "assistant.text", text: "好的，我看看。", final: true });
+    expect(h.userText).toEqual([
+      ["帮我看看", false],
+      ["帮我看看排班", true],
+    ]);
+    expect(h.botText).toEqual([
+      ["好", false],
+      ["好的，我看看。", true],
+    ]);
+  });
+
+  it("plays the model's audio from binary frames and from JSON ones", () => {
+    const h = harness();
+    frame(h.socket(), { type: "ready" });
+    // Binary frames carry raw PCM straight to the speaker.
+    h.socket()?.onMessage(new Uint8Array([9, 8, 7]).buffer);
+    expect(h.audio.play).toHaveBeenCalledWith(new Uint8Array([9, 8, 7]));
+    h.audio.play.mockClear();
+    // A JSON call carries the same PCM as base64.
+    frame(h.socket(), { type: "audio", audio: "CQgH" });
+    expect(h.audio.play).toHaveBeenCalledWith(new Uint8Array([9, 8, 7]));
+  });
+
+  it("reads a frame a build hands over as a view of its buffer", () => {
+    const h = harness();
+    frame(h.socket(), { type: "ready" });
+    // Only the view's own bytes reach the speaker, never the buffer around them.
+    const buffer = new Uint8Array([0, 0, 9, 8, 7, 0]);
+    h.socket()?.onMessage(buffer.subarray(2, 5));
+    expect(h.audio.play).toHaveBeenCalledWith(new Uint8Array([9, 8, 7]));
+    // Anything else is not audio: it must not reach the player at all.
+    h.audio.play.mockClear();
+    h.socket()?.onMessage({ odd: true });
+    expect(h.audio.play).not.toHaveBeenCalled();
+  });
+
+  it("hangs up by saying so, and keeps the socket open for the chat it writes", () => {
+    const h = harness();
+    frame(h.socket(), { type: "ready" });
+    h.sent.length = 0;
+    h.call.hangUp();
+    expect(h.sent.map((item) => String(item))).toEqual(['{"type":"hangup"}']);
+    expect(h.audio.stop).toHaveBeenCalled();
+    // The gateway writes the call into the chat before it answers: not ended yet.
+    expect(h.closed).toHaveLength(0);
+    frame(h.socket(), {
+      type: "closed",
+      reason: "hangup",
+      durationSeconds: 63,
+      turns: 4,
+      transcriptWritten: true,
+    });
+    expect(h.closed).toEqual([
+      { reason: "hangup", durationSeconds: 63, turns: 4, transcriptWritten: true },
+    ]);
+  });
+
+  it("ends the call on its own if the gateway never answers the hang-up", () => {
+    const h = harness();
+    frame(h.socket(), { type: "ready" });
+    h.call.hangUp();
+    expect(h.timers.at(-1)?.ms).toBe(8_000);
+    h.timers.at(-1)?.callback();
+    expect(h.closed).toEqual([
+      { reason: "hangup", durationSeconds: 0, turns: 0, transcriptWritten: false },
+    ]);
+  });
+
+  it("sends nothing while muted, and nothing once hung up", () => {
+    const h = harness();
+    frame(h.socket(), { type: "ready" });
+    h.call.setMuted(true);
+    expect(h.audio.setMuted).toHaveBeenCalledWith(true);
+    h.mic()?.(new Uint8Array([1, 2]));
+    expect(h.sent).toHaveLength(0);
+    h.call.setMuted(false);
+    h.mic()?.(new Uint8Array([1, 2]));
+    expect(h.sent).toHaveLength(1);
+  });
+
+  it("hangs up by itself at the gateway's own limit", () => {
+    const h = harness();
+    frame(h.socket(), { type: "ready" });
+    const limit = h.timers.find((timer) => timer.ms === 1_800_000);
+    expect(limit).toBeDefined();
+    h.sent.length = 0;
+    limit?.callback();
+    expect(h.sent.map((item) => String(item))).toEqual(['{"type":"hangup"}']);
+  });
+
+  it("says so when the socket never opened", () => {
+    const h = harness();
+    h.socket()?.onError();
+    expect(h.captions.at(-1)).toContain("Could not connect");
+    h.socket()?.onClose({ code: 1006 });
+    expect(h.closed.at(-1)).toMatchObject({ reason: "client-closed", transcriptWritten: false });
+  });
+
+  it("passes on the gateway's human-readable refusal", () => {
+    const h = harness();
+    frame(h.socket(), {
+      type: "error",
+      message: "还没有连接对应厂商的语音 Key",
+      code: "no_credential",
+    });
+    expect(h.captions.at(-1)).toBe("还没有连接对应厂商的语音 Key");
+  });
+
+  it("cancels the reply on a local interruption", () => {
+    const h = harness();
+    frame(h.socket(), { type: "ready" });
+    h.sent.length = 0;
+    h.call.interrupt();
+    expect(h.sent.map((item) => String(item))).toEqual(['{"type":"cancel"}']);
+    expect(h.audio.flush).toHaveBeenCalledOnce();
+  });
+});
diff --git a/apps/mobile/lib/realtime-call.ts b/apps/mobile/lib/realtime-call.ts
new file mode 100644
index 000000000..2eed58726
--- /dev/null
+++ b/apps/mobile/lib/realtime-call.ts
@@ -0,0 +1,313 @@
+import type { RealtimeCallPlan } from "@rakazo/contracts";
+import { t } from "@lingui/core/macro";
+import type { RealtimeAudioPort } from "./realtime-audio";
+import type { RealtimeServerEvent } from "./realtime-protocol";
+import { callRates, decodeBase64, parseRealtimeEvent, realtimeSocketUrl } from "./realtime-protocol";
+
+/**
+ * One full-duplex call, as the gateway's protocol defines it: open the socket, wait for `ready`,
+ * stream the microphone, play what comes back, and hang up by saying so.
+ *
+ * The gateway owns the turn-taking — it tells the phone when the model heard the caller
+ * (`speech.start`, which ends the reply being played), when the caller finished (`speech.stop`),
+ * and when the model starts and stops answering. The phone's part is to keep the audio flowing and
+ * to show those moments.
+ */
+
+export type RealtimeCallPhase = "connecting" | "listening" | "thinking" | "speaking";
+
+export type RealtimeCallClosed = {
+  reason: string;
+  durationSeconds: number;
+  turns: number;
+  transcriptWritten: boolean;
+  error?: string;
+};
+
+export type RealtimeCallHandlers = {
+  /** The gateway has the provider's session: the microphone is live from here. */
+  onReady: () => void;
+  onPhase: (phase: RealtimeCallPhase) => void;
+  /** What the caller said, as the model heard it: `final` is the whole sentence. */
+  onUserText: (text: string, final: boolean) => void;
+  /** What the bot said, as it is spoken: `final` is the whole sentence. */
+  onAssistantText: (text: string, final: boolean) => void;
+  /** A line to show under the call: an error the gateway explained, or its own reason for ending. */
+  onCaption: (text: string) => void;
+  onClosed: (closed: RealtimeCallClosed) => void;
+};
+
+export type RealtimeSocketHandlers = {
+  onOpen: () => void;
+  onMessage: (data: unknown) => void;
+  onClose: (event?: { code?: number; reason?: string }) => void;
+  onError: () => void;
+};
+
+export type RealtimeSocket = {
+  send: (data: string | ArrayBuffer) => void;
+  close: () => void;
+};
+
+export type OpenRealtimeSocket = (
+  url: string,
+  headers: Record<string, string>,
+  handlers: RealtimeSocketHandlers,
+) => RealtimeSocket;
+
+/** How long a hang-up waits for the gateway's own `closed` before the socket is dropped. */
+const CLOSE_GRACE_MS = 8_000;
+
+export type RealtimeCallDeps = {
+  audio: RealtimeAudioPort;
+  openSocket: OpenRealtimeSocket;
+  /** `setTimeout`, injected so tests can run the hang-up's clock themselves. */
+  setTimer?: (callback: () => void, ms: number) => unknown;
+  clearTimer?: (handle: unknown) => void;
+};
+
+export class RealtimeCall {
+  private socket: RealtimeSocket | null = null;
+  private stopListening: (() => void) | null = null;
+  private closed = false;
+  private ready = false;
+  private muted = false;
+  private hangingUp = false;
+  private lastError = "";
+  private closeTimer: unknown;
+  private durationTimer: unknown;
+  private readonly setTimer: (callback: () => void, ms: number) => unknown;
+  private readonly clearTimer: (handle: unknown) => void;
+
+  constructor(
+    readonly plan: RealtimeCallPlan,
+    private readonly deps: RealtimeCallDeps,
+    private readonly handlers: RealtimeCallHandlers,
+  ) {
+    this.setTimer = deps.setTimer ?? ((callback, ms) => setTimeout(callback, ms));
+    this.clearTimer = deps.clearTimer ?? ((handle) => clearTimeout(handle as number));
+  }
+
+  /** Opens the call's socket; the microphone starts only once the gateway says `ready`. */
+  connect(request: { apiBase: string; headers: Record<string, string> }): void {
+    const url = realtimeSocketUrl(request.apiBase, this.plan.path);
+    this.handlers.onPhase("connecting");
+    this.socket = this.deps.openSocket(url, request.headers, {
+      onOpen: () => undefined,
+      onMessage: (data) => this.receive(data),
+      onClose: () => this.onSocketClose(),
+      onError: () => {
+        // The gateway refuses a handshake with an HTTP status (401, 409 with a Chinese reason), and
+        // a socket that never opened reports only that it failed. Say something the caller can act
+        // on; the gateway's own reason, when it gets one across, replaces it.
+        if (!this.ready && !this.lastError) {
+          this.handlers.onCaption(t`Could not connect the call. Check the voice settings and try again.`);
+        }
+      },
+    });
+  }
+
+  get isReady(): boolean {
+    return this.ready;
+  }
+
+  /** The caller's own interruption: the reply stops now and what it queued is dropped. */
+  interrupt(): void {
+    if (this.closed) return;
+    this.send({ type: "cancel" });
+    this.deps.audio.flush();
+  }
+
+  setMuted(muted: boolean): void {
+    this.muted = muted;
+    this.deps.audio.setMuted(muted);
+  }
+
+  /** Types a sentence into the call, as if the caller had said it. */
+  say(text: string): void {
+    const trimmed = text.trim();
+    if (!trimmed) return;
+    this.send({ type: "text", text: trimmed });
+  }
+
+  /**
+   * Hangs up. The gateway writes the call into the chat before it answers with `closed`, so the
+   * microphone stops here at once and the socket is kept just long enough to hear back.
+   */
+  hangUp(): void {
+    if (this.closed || this.hangingUp) return;
+    this.hangingUp = true;
+    this.stopAudio();
+    this.send({ type: "hangup" });
+    this.closeTimer = this.setTimer(() => {
+      this.closeTimer = undefined;
+      // The gateway never answered the hang-up: the call is over all the same, and whatever it
+      // wrote into the chat has already been written.
+      this.finish({
+        reason: "hangup",
+        durationSeconds: 0,
+        turns: 0,
+        transcriptWritten: false,
+      });
+    }, CLOSE_GRACE_MS);
+  }
+
+  /** Ends the call here and now, without waiting for the gateway (a sign-out, a new call). */
+  dispose(): void {
+    if (this.closed) return;
+    this.closed = true;
+    this.clearTimers();
+    this.stopAudio();
+    this.socket?.close();
+    this.socket = null;
+  }
+
+  private send(frame: Record<string, unknown>): void {
+    if (this.closed || !this.socket) return;
+    this.socket.send(JSON.stringify(frame));
+  }
+
+  private sendAudio(pcm: Uint8Array): void {
+    if (this.closed || !this.ready || this.hangingUp || this.muted || !this.socket) return;
+    const whole = pcm.byteOffset === 0 && pcm.byteLength === pcm.buffer.byteLength;
+    this.socket.send(whole ? (pcm.buffer as ArrayBuffer) : (pcm.slice().buffer as ArrayBuffer));
+  }
+
+  private receive(data: unknown): void {
+    if (this.closed) return;
+    // The default format: the model's own PCM16, straight into the player.
+    if (data instanceof ArrayBuffer) {
+      this.deps.audio.play(new Uint8Array(data));
+      return;
+    }
+    // A build that hands the frame over as a view of the buffer gives the same bytes; reading only
+    // the view keeps a stray header out of the front of the reply.
+    if (ArrayBuffer.isView(data)) {
+      const view = data as ArrayBufferView;
+      this.deps.audio.play(new Uint8Array(view.buffer, view.byteOffset, view.byteLength));
+      return;
+    }
+    if (typeof data !== "string") return;
+    const event = parseRealtimeEvent(data);
+    if (event) this.handle(event);
+  }
+
+  private handle(event: RealtimeServerEvent): void {
+    switch (event.type) {
+      case "ready":
+        this.startStreaming(event);
+        return;
+      case "speech.start":
+        // The model heard the caller: whatever it was saying stops now.
+        this.deps.audio.flush();
+        this.handlers.onPhase("listening");
+        return;
+      case "speech.stop":
+        this.handlers.onPhase("thinking");
+        return;
+      case "response.start":
+        this.handlers.onPhase("speaking");
+        return;
+      case "response.done":
+        this.handlers.onPhase("listening");
+        return;
+      case "playback.flush":
+        this.deps.audio.flush();
+        return;
+      case "user.text":
+        this.handlers.onUserText(event.text, event.final);
+        return;
+      case "assistant.text":
+        this.handlers.onAssistantText(event.text, event.final);
+        return;
+      case "audio":
+        this.deps.audio.play(decodeBase64(event.audio));
+        return;
+      case "error":
+        this.lastError = event.message;
+        this.handlers.onCaption(event.message);
+        return;
+      case "closed":
+        this.finish({
+          reason: event.reason,
+          durationSeconds: event.durationSeconds ?? 0,
+          turns: event.turns ?? 0,
+          transcriptWritten: event.transcriptWritten ?? false,
+          ...(event.error ? { error: event.error } : {}),
+        });
+        return;
+      case "pong":
+        return;
+    }
+  }
+
+  private startStreaming(event: Extract<RealtimeServerEvent, { type: "ready" }>): void {
+    if (this.ready) return;
+    const rates = callRates(this.plan, event);
+    try {
+      this.deps.audio.start(rates.inputSampleRate, rates.outputSampleRate);
+    } catch {
+      this.handlers.onCaption(t`The microphone is not available for a call.`);
+      this.hangUp();
+      return;
+    }
+    this.ready = true;
+    // A mute set before the call was up is the caller's wish for the whole call.
+    this.deps.audio.setMuted(this.muted);
+    this.stopListening = this.deps.audio.listen((pcm) => this.sendAudio(pcm));
+    this.handlers.onReady();
+    this.handlers.onPhase("listening");
+    this.handlers.onCaption("");
+    this.durationTimer = this.setTimer(
+      () => {
+        this.durationTimer = undefined;
+        if (!this.closed) this.hangUp();
+      },
+      Math.max(1, this.plan.maxDurationSeconds) * 1000,
+    );
+  }
+
+  private onSocketClose(): void {
+    if (this.closed) return;
+    // A socket that ended without the gateway's own `closed`: the caller hung up and it is on its
+    // way, or the connection went away under the call.
+    const reason = this.hangingUp ? "hangup" : "client-closed";
+    if (!this.ready && !this.lastError) {
+      this.handlers.onCaption(t`Could not connect the call. Check the voice settings and try again.`);
+    }
+    this.finish({
+      reason,
+      durationSeconds: 0,
+      turns: 0,
+      transcriptWritten: false,
+      ...(this.lastError ? { error: this.lastError } : {}),
+    });
+  }
+
+  private finish(closed: RealtimeCallClosed): void {
+    if (this.closed) return;
+    this.closed = true;
+    this.clearTimers();
+    this.stopAudio();
+    this.socket?.close();
+    this.socket = null;
+    this.handlers.onClosed(closed);
+  }
+
+  private stopAudio(): void {
+    this.stopListening?.();
+    this.stopListening = null;
+    try {
+      this.deps.audio.stop();
+    } catch {
+      // The engine may already be down (an interruption, a route change); nothing to end.
+    }
+  }
+
+  private clearTimers(): void {
+    if (this.closeTimer !== undefined) this.clearTimer(this.closeTimer);
+    if (this.durationTimer !== undefined) this.clearTimer(this.durationTimer);
+    this.closeTimer = undefined;
+    this.durationTimer = undefined;
+  }
+}
diff --git a/apps/mobile/lib/realtime-protocol.test.ts b/apps/mobile/lib/realtime-protocol.test.ts
