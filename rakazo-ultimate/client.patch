diff --git a/apps/mobile/components/iphone-connector-group.tsx b/apps/mobile/components/iphone-connector-group.tsx
new file mode 100644
index 0000000..05a4aba
--- /dev/null
+++ b/apps/mobile/components/iphone-connector-group.tsx
@@ -0,0 +1,207 @@
+import type { PhoneConnectorKind, PhoneConnectorState, PhonePermission } from "@rakazo/contracts";
+import { PHONE_CONNECTORS_OFF } from "@rakazo/contracts";
+import { useCallback, useEffect, useMemo, useState } from "react";
+import { Alert, Linking, Pressable, StyleSheet, Text, View } from "react-native";
+import { mobileTokens } from "../lib/appearance";
+import { native, useThemedStyles } from "../lib/native";
+import { phoneConnectorSocket, resumePhoneConnectorSocket } from "../lib/phone-connector-socket";
+import {
+  loadPhoneConnectorState,
+  PHONE_CONNECTOR_ROWS,
+  pairPhoneDevice,
+  phoneConnectorsNative,
+  phoneConnectorToggled,
+  pushPhoneConnectorState,
+  savePhoneConnectorState,
+} from "../lib/phone-connectors";
+import { createIntegrationsStyles } from "./integrations-styles";
+import { NativeSwitch } from "./native-switch";
+import { NativeSymbol } from "./native-symbol";
+
+/**
+ * 「iPhone」: this handset's own five connectors, inside the integrations screen.
+ *
+ * Each row is a switch the person owns: turning one on asks iOS for that permission, saves the
+ * choice here, and tells the server so a bot can use it. The note under a switch is the honest
+ * state — permission refused, waiting for the system's question, or nothing to connect to yet.
+ */
+const ANDROID_SYMBOLS: Record<
+  PhoneConnectorKind,
+  | "alarm-outline"
+  | "calendar-outline"
+  | "checkbox-outline"
+  | "person-circle-outline"
+  | "location-outline"
+> = {
+  alarms: "alarm-outline",
+  calendar: "calendar-outline",
+  reminders: "checkbox-outline",
+  contacts: "person-circle-outline",
+  location: "location-outline",
+};
+
+export function IphoneConnectorGroup({ onChanged }: { onChanged?: () => void }) {
+  const styles = useThemedStyles(createStyles);
+  const rowStyles = useThemedStyles(createIntegrationsStyles);
+  const [state, setState] = useState<PhoneConnectorState>({ ...PHONE_CONNECTORS_OFF });
+  const [permissions, setPermissions] = useState<
+    Partial<Record<PhoneConnectorKind, PhonePermission>>
+  >({});
+  const [pending, setPending] = useState<PhoneConnectorKind | null>(null);
+  const [note, setNote] = useState<string | null>(null);
+
+  useEffect(() => {
+    let alive = true;
+    void (async () => {
+      const stored = await loadPhoneConnectorState();
+      const loaded = phoneConnectorsNative();
+      const permissions: Partial<Record<PhoneConnectorKind, PhonePermission>> = {};
+      if (loaded) {
+        for (const row of PHONE_CONNECTOR_ROWS) {
+          permissions[row.kind] = await loaded.permission(row.kind);
+        }
+      }
+      if (!alive) return;
+      setState(stored);
+      setPermissions(permissions);
+      // A switch stored as on with no binary behind it is not usable: say so instead of pretending.
+      if (!loaded && PHONE_CONNECTOR_ROWS.some((row) => stored[row.kind])) {
+        setNote("这个版本没有带手机连接器模块，开关无法生效。");
+      }
+    })();
+    return () => {
+      alive = false;
+    };
+  }, []);
+
+  const toggle = useCallback(
+    async (kind: PhoneConnectorKind, on: boolean) => {
+      setPending(kind);
+      setNote(null);
+      try {
+        if (!on) {
+          const next = phoneConnectorToggled(state, kind, false);
+          setState(next);
+          await savePhoneConnectorState(next);
+          void pushPhoneConnectorState(next);
+          await phoneConnectorSocket().refresh();
+          onChanged?.();
+          return;
+        }
+        const module = phoneConnectorsNative();
+        if (!module) {
+          setNote("这个版本没有带手机连接器模块，开关无法生效。");
+          return;
+        }
+        const permission =
+          permissions[kind] === "denied" ? "denied" : await module.requestPermission(kind);
+        setPermissions((current) => ({ ...current, [kind]: permission }));
+        if (permission !== "granted") {
+          setNote(
+            permission === "denied"
+              ? "系统没有允许 Bot 使用这项权限，请在 iPhone 设置里打开后回来再试。"
+              : permission === "unavailable"
+                ? "这台 iPhone 或系统版本不能提供这项能力。"
+                : "还没有拿到系统权限，稍后再试一次。",
+          );
+          if (permission === "denied") {
+            Alert.alert(
+              "需要系统权限",
+              "请到 iPhone 的 设置 → Bot 里打开这项权限，再回到这里开关。",
+              [
+                { text: "知道了", style: "cancel" },
+                { text: "去设置", onPress: () => void Linking.openSettings() },
+              ],
+            );
+          }
+          return;
+        }
+        const next = phoneConnectorToggled(state, kind, true);
+        setState(next);
+        await savePhoneConnectorState(next);
+        const paired = await pairPhoneDevice();
+        if (!paired.ok) setNote(paired.reason);
+        const pushed = await pushPhoneConnectorState(next);
+        if (!pushed) setNote((current) => current ?? "已经在本机打开，还没同步到服务端。");
+        await resumePhoneConnectorSocket();
+        onChanged?.();
+      } finally {
+        setPending(null);
+      }
+    },
+    [onChanged, permissions, state],
+  );
+
+  const rows = useMemo(() => PHONE_CONNECTOR_ROWS, []);
+
+  return (
+    <View style={rowStyles.catalogStack}>
+      <View style={styles.header}>
+        <Text style={rowStyles.section}>iPhone</Text>
+        <Text style={styles.status}>
+          {PHONE_CONNECTOR_ROWS.filter((row) => state[row.kind]).length} 项已开
+        </Text>
+      </View>
+      <Text style={rowStyles.secondary}>
+        这台 iPhone 上的闹钟、日历、提醒事项、通讯录和位置。打开一项后，Bot 才能替你查和改， iPhone
+        会先问你要对应的系统权限。
+      </Text>
+      {rows.map((row) => {
+        const permission = permissions[row.kind];
+        const broken = permission === "denied" || permission === "unavailable";
+        return (
+          <Pressable
+            key={row.kind}
+            accessibilityRole="switch"
+            accessibilityState={{ checked: state[row.kind], disabled: broken }}
+            accessibilityLabel={row.name}
+            onPress={() => void toggle(row.kind, !state[row.kind])}
+            style={({ pressed }) => [rowStyles.row, pressed && rowStyles.pressed]}
+          >
+            <View style={styles.symbol}>
+              <NativeSymbol ios={row.symbol} android={ANDROID_SYMBOLS[row.kind]} size={18} />
+            </View>
+            <View style={rowStyles.grow}>
+              <Text style={rowStyles.title}>{row.name}</Text>
+              <Text style={rowStyles.secondary}>
+                {broken && state[row.kind] ? `系统没有允许${row.permission}` : row.hint}
+              </Text>
+            </View>
+            {/* The row itself is the control: the switch only shows the state, so one tap
+                cannot count twice. */}
+            <View pointerEvents="none">
+              <NativeSwitch
+                accessibilityLabel={row.name}
+                disabled={pending === row.kind}
+                onValueChange={(on) => void toggle(row.kind, on)}
+                value={state[row.kind]}
+              />
+            </View>
+          </Pressable>
+        );
+      })}
+      {note ? <Text style={rowStyles.error}>{note}</Text> : null}
+    </View>
+  );
+}
+
+function createStyles() {
+  const tokens = mobileTokens();
+  return StyleSheet.create({
+    header: {
+      flexDirection: "row",
+      alignItems: "center",
+      justifyContent: "space-between",
+      marginTop: 2,
+    },
+    status: { color: tokens.success, fontSize: 13, fontWeight: "600" },
+    symbol: {
+      width: 32,
+      height: 32,
+      borderRadius: 10,
+      alignItems: "center",
+      justifyContent: "center",
+      backgroundColor: native.fillPressed,
+    },
+  });
+}
