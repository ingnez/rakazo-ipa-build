+  it("adds the glossy layers and starts Reanimated loops only after the first paint", () => {
+    act(() =>
+      root.render(<MochiBotAvatar color="#E8C4A8" identity="bot-1" size={50} motion="live" />),
+    );
+    expect(motion.repeats).toBe(0);
