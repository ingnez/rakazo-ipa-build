+
+/* ---------- colour helpers (worklet-safe: the same code runs on the UI thread) ---------- */
+
+function hexRgb(hex: string): [number, number, number] {
+  "worklet";
+  const h = hex.charAt(0) === "#" ? hex : `#${hex}`;
+  const full =
+    h.length === 4
+      ? `#${h.charAt(1)}${h.charAt(1)}${h.charAt(2)}${h.charAt(2)}${h.charAt(3)}${h.charAt(3)}`
+      : h;
+  return [
+    parseInt(full.slice(1, 3), 16) || 0,
+    parseInt(full.slice(3, 5), 16) || 0,
+    parseInt(full.slice(5, 7), 16) || 0,
+  ];
+}
+
+function toHex(value: number): string {
+  "worklet";
+  const v = Math.max(0, Math.min(255, Math.round(value)));
+  const s = v.toString(16);
+  return s.length === 1 ? `0${s}` : s;
+}
+
+export function lumenMix(a: string, b: string, t: number): string {
+  "worklet";
+  const k = Math.max(0, Math.min(1, t));
+  const A = hexRgb(a);
+  const B = hexRgb(b);
+  return `#${toHex(A[0] + (B[0] - A[0]) * k)}${toHex(A[1] + (B[1] - A[1]) * k)}${toHex(
+    A[2] + (B[2] - A[2]) * k,
+  )}`;
+}
+
+/* ---------- easing, copied from the design's engine ---------- */
+
+function clamp01(x: number): number {
+  "worklet";
+  return x < 0 ? 0 : x > 1 ? 1 : x;
+}
+function seg(u: number, a: number, b: number): number {
+  "worklet";
+  return clamp01((u - a) / (b - a));
+}
+function bell(u: number, a: number, b: number): number {
+  "worklet";
+  return Math.sin(seg(u, a, b) * Math.PI);
+}
+function easeOut(t: number): number {
+  "worklet";
+  return 1 - Math.pow(1 - t, 3);
+}
+function easeInOut(t: number): number {
+  "worklet";
+  return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
+}
+function springAt(x: number, f: number, d: number): number {
+  "worklet";
+  return x <= 0 ? 0 : 1 - Math.exp(-d * x) * Math.cos(f * Math.PI * 2 * x);
+}
+function wobAt(x: number, f: number, d: number): number {
+  "worklet";
+  return x <= 0 ? 0 : Math.exp(-d * x) * Math.sin(f * Math.PI * 2 * x);
+}
+const TAU = Math.PI * 2;
+
+/* ---------- the frame ---------- */
+
+export type LumenFrame = {
+  /** Body: translate, squash, tilt, and the light the whole body is lit with. */
+  x: number;
+  lift: number;
+  rot: number;
+  sx: number;
+  sy: number;
+  op: number;
+  scale: number;
+  I: number;
+  dim: number;
+  /** The accent colour this frame draws with: the bot's own, or a state's. */
+  c: string;
+  /** Eyes: a rounded bar pair per eye, or an arc, or the error slash. */
+  eyeW: number;
+  eyeH: number;
+  eyeCy: number;
+  eyeDx: number;
+  eyeDy: number;
+  eyeArc: number;
+  eyeSlash: number;
+  eyeOp: number;
+  /** Ring: tilt, opacity, the gap an error tears, 12-segment work dashes, a comet, rings. */
+  ringTilt: number;
+  ringOp: number;
+  ringGap: number;
+  ringSeg: number;
+  ringSpin: number;
+  comet: number;
+  cometOn: number;
+  glowArc: number;
+  glowOn: number;
+  /** Crown: the whole crown's pose, the five tips' brightness and their own colours. */
+  crownRot: number;
+  crownDx: number;
+  crownDy: number;
+  crownOp: number;
+  tips: number[];
+  tipColor: string;
+  gemColor: string;
+  /** Effects. */
+  waveOn: number;
+  waveE: number;
+  waveU: number;
+  sparksOn: number;
+  sparkK: number;
+  bangOn: number;
+  zzU: number;
+  zzOn: number;
+};
+
+const ONE_TIPS = [1, 1, 1, 1, 1];
+
+export function lumenBaseFrame(color: string): LumenFrame {
+  "worklet";
+  return {
+    x: 0,
+    lift: 0,
+    rot: 0,
+    sx: 1,
+    sy: 1,
+    op: 1,
+    scale: 1,
+    I: 1,
+    dim: 0,
+    c: color,
+    eyeW: 16,
+    eyeH: 42,
+    eyeCy: -17,
+    eyeDx: 0,
+    eyeDy: 0,
+    eyeArc: 0,
+    eyeSlash: 0,
+    eyeOp: 1,
+    ringTilt: -18,
+    ringOp: 1,
+    ringGap: 0,
+    ringSeg: 0,
+    ringSpin: 0,
+    comet: 0,
+    cometOn: 0,
+    glowArc: 0,
+    glowOn: 0,
+    crownRot: 0,
+    crownDx: 0,
+    crownDy: 0,
+    crownOp: 1,
+    tips: [1, 1, 1, 1, 1],
+    tipColor: LUMEN_BASE.tip,
+    gemColor: color,
+    waveOn: 0,
+    waveE: 0,
+    waveU: 0,
+    sparksOn: 0,
+    sparkK: 0,
+    bangOn: 0,
+    zzU: 0,
+    zzOn: 0,
+  };
+}
+
+/** Breathing: the 0–1 wave every state shares, applied to lift, squash and light. */
+function breathe(S: LumenFrame, T: number, period: number, amp: number): number {
+  "worklet";
+  const b = Math.sin((TAU * T) / period);
+  S.lift += -4 * amp * b;
+  S.sy *= 1 + 0.012 * amp * b;
+  S.sx *= 1 - 0.008 * amp * b;
+  S.I *= 1 + 0.12 * amp * b;
+  S.ringTilt += 1.5 * amp * Math.sin((TAU * T) / period + 1);
+  return b;
+}
+
+/** A blink: 70ms shut, 110ms open, the eyes pressed to a line. */
+function blinkAt(S: LumenFrame, T: number, at: number): void {
+  "worklet";
+  const d = T - at;
+  if (d < 0 || d > 0.18) return;
+  const k = d < 0.07 ? d / 0.07 : 1 - (d - 0.07) / 0.11;
+  S.eyeH += (4 - S.eyeH) * k;
+  S.eyeCy += k * 2;
+}
+
+/**
+ * One frame of one state, at `t` seconds since the state started. Looping states take `t` modulo
+ * their own length; single-shot ones hold their last pose until the caller settles them.
+ */
+export function lumenFrame(action: LumenAction, t: number, color: string): LumenFrame {
+  "worklet";
+  const S = lumenBaseFrame(color);
+  const dur =
+    action === "idle"
+      ? 3
+      : action === "think"
+        ? 2.4
+        : action === "talk"
+          ? 1.6
+          : action === "work"
+            ? 3
+            : action === "happy"
+              ? 2
+              : action === "error"
+                ? 2
+                : 6;
+  const loops = action !== "happy" && action !== "error";
+  const T = loops ? ((t % dur) + dur) % dur : Math.max(0, Math.min(t, dur));
+  const u = T / dur;
+  if (action === "think") {
+    breathe(S, T, 2.4, 0.6);
+    S.c = LUMEN_BASE.think;
+    S.I *= 1.05;
+    S.eyeW = 15;
+    S.eyeH = 28;
+    S.eyeDx = -6.5 + 2 * Math.sin(TAU * u);
+    S.eyeCy = -16;
+    S.eyeDy = -2;
+    S.rot = -3;
+    S.comet = TAU * u;
+    S.cometOn = 1;
+    S.tipColor = LUMEN_BASE.think;
+    for (let i = 0; i < 5; i += 1) S.tips[i] = 0.55 + 0.45 * Math.max(0, Math.cos(TAU * u - 1.1 * i));
+  } else if (action === "talk") {
+    breathe(S, T, 1.6, 0.5);
+    const syllables = [0, 0.11, 0.27, 0.38, 0.55, 0.68, 0.8, 0.9];
+    let e = 0;
+    for (let i = 0; i < syllables.length; i += 1) {
+      const d = (u - syllables[i]!) * 1.6;
+      if (d >= 0 && d < 0.16) {
+        e = Math.max(e, Math.sin((d / 0.16) * Math.PI) * (0.6 + (0.4 * ((i * 7) % 3)) / 2));
+      }
+    }
+    S.eyeH = 40 + 16 * e;
+    S.eyeCy = -17 - 2 * e;
+    S.I *= 1 + 0.25 * e;
+    S.sy *= 1 + 0.015 * e;
+    S.lift -= 2 * e;
+    S.waveOn = 1;
+    S.waveE = e;
+    S.waveU = u;
+    for (let i = 0; i < 5; i += 1) S.tips[i] = 0.85 + 0.15 * e;
+  } else if (action === "work") {
+    S.eyeW = 28;
+    S.eyeH = 10;
+    S.eyeCy = -11;
+    S.lift += -2 * Math.sin(TAU * T * 2.5);
+    S.ringSeg = 1;
+    S.ringSpin = u;
+    S.glowArc = u * 2;
+    S.glowOn = 1;
+    const p = u * 6.2;
+    const fade = u > 0.92 ? 1 - seg(u, 0.96, 1) : 1;
+    for (let i = 0; i < 5; i += 1) S.tips[i] = 0.22 + 0.78 * clamp01(p - i - 0.35) * fade;
+    if (u > 0.82 && u < 0.96) {
+      const flash = 0.25 * bell(u, 0.82, 0.96);
+      for (let i = 0; i < 5; i += 1) S.tips[i] = Math.min(1.25, S.tips[i]! + flash);
+    }
+  } else if (action === "happy") {
+    const pre = bell(T, 0, 0.22);
+    const jump = T < 0.2 ? 0 : T < 0.75 ? Math.sin(seg(T, 0.2, 0.75) * Math.PI) : 0;
+    const land = bell(T, 0.72, 0.95);
+    S.sy *= 1 - 0.07 * pre + 0.05 * jump - 0.06 * land;
+    S.sx *= 1 + 0.05 * pre - 0.03 * jump + 0.05 * land;
+    S.lift += -26 * jump + 2 * wobAt(seg(T, 0.95, 2), 1.5, 3);
+    const flash = T < 0.2 ? seg(T, 0.05, 0.2) : 1 - 0.55 * seg(T, 0.9, 1.6);
+    S.c = lumenMix(color, LUMEN_BASE.happy, flash);
+    S.I *= 1 + 0.35 * bell(T, 0.15, 0.9);
+    S.eyeArc = seg(T, 0.12, 0.28);
+    S.crownDy = -10 * Math.sin(seg(T, 0.26, 0.82) * Math.PI) + 3 * wobAt(seg(T, 0.82, 1.6), 2, 4);
+    S.tipColor = lumenMix(LUMEN_BASE.tip, LUMEN_BASE.happy, flash);
+    for (let i = 0; i < 5; i += 1) S.tips[i] = 1 + 0.3 * bell(T, 0.3 + i * 0.06, 0.8 + i * 0.06);
+    S.sparksOn = 1;
+    S.sparkK = seg(T, 0.15, 1.25);
+  } else if (action === "error") {
+    const fl = Math.max(bell(T, 0, 0.35), 0.85 * bell(T, 0.38, 0.72));
+    S.c = lumenMix(color, LUMEN_BASE.error, Math.max(fl, 0.55 * seg(T, 0.72, 1)));
+    S.I *= 1 + 0.4 * fl;
+    S.x = 7 * wobAt(seg(T, 0, 0.9), 4, 3.5);
+    S.eyeSlash = seg(T, 0.04, 0.14);
+    S.ringGap = easeOut(seg(T, 0.05, 0.5));
+    S.ringTilt = -18 + 4 * wobAt(seg(T, 0, 1), 2, 3);
+    S.bangOn = Math.min(1, bell(T, 0.05, 0.9) * 0.9 + 0.3 * seg(T, 0.9, 1.2));
+    S.lift += 3 * seg(T, 0.3, 1);
+    const k = springAt(seg(T, 0.08, 1.3), 1.4, 4.5);
+    S.crownRot = -9 * k;
+    S.crownDx = -4 * k;
+    S.crownDy = 4 * k;
+    const dim = seg(T, 0.1, 0.5);
+    for (let i = 0; i < 5; i += 1) S.tips[i] = i === 2 ? 1 + 0.3 * fl : 1 + (0.35 - 1) * dim;
+    S.gemColor = lumenMix(S.c, LUMEN_BASE.error, seg(T, 0.05, 0.2));
+  } else if (action === "sleep") {
+    S.dim = 1;
+    S.lift += 12;
+    const b = breathe(S, T, 6, 1.2);
+    S.eyeW = 28;
+    S.eyeH = 6;
+    S.eyeCy = -13;
+    S.eyeOp = 0.35 + 0.1 * b;
+    S.ringTilt = -8 + 1.5 * b;
+    S.ringOp = 0.55;
+    S.zzOn = 1;
+    S.zzU = u;
+    const nod = Math.sin(TAU * u);
+    S.crownRot = 11 + 2.2 * nod;
+    S.crownDx = 6 + 1.5 * nod;
+    S.crownDy = 8 + 1.5 * Math.max(0, nod);
+    S.tipColor = LUMEN_BASE.sleep;
+    for (let i = 0; i < 5; i += 1) S.tips[i] = 0.25 + 0.08 * b;
+    S.crownOp = 0.5;
+  } else {
+    const b = breathe(S, T, 3, 1);
+    blinkAt(S, T, 2.2);
+    for (let i = 0; i < 5; i += 1) S.tips[i] = 0.82 + 0.18 * Math.sin(TAU * u - i * 0.6);
+    S.crownDy = -1.5 * b;
+  }
+  return S;
+}
+
+/**
+ * Which of the seven states a set of signals means. A bot waiting on a person is not asleep, and a
+ * turn that has just finished holds its finished pose for a beat before it settles.
+ */
+export function lumenActionFor(input: {
+  status?: string | null;
+  activity?: string | null;
+  composing?: boolean;
+  settling?: boolean;
+}): LumenAction {
+  const activity = (input.activity ?? "").toLowerCase();
+  const status = (input.status ?? "").toLowerCase();
+  if (activity === "error" || status === "failed" || status === "error") return "error";
+  if (activity === "thinking" || status === "thinking") return "think";
+  if (activity === "speaking" || activity === "talk") return "talk";
+  if (
+    activity === "working" ||
+    activity === "reading" ||
+    activity === "writing" ||
+    activity === "computer" ||
+    status === "running" ||
+    status === "queued" ||
+    status === "working" ||
+    input.composing
+  )
+    return "work";
+  if (
+    activity === "done" ||
+    input.settling ||
+    status === "done" ||
+    status === "settled"
+  )
+    return "happy";
+  return "idle";
+}
+
+/* ---------- who a bot is ---------- */
+
+/**
+ * The ten bots the system was drawn for, with the emblem the designer chose for each. A bot is
+ * matched here first (by name), so the team keeps exactly the marks it was drawn with.
+ */
+export type LumenPreset = {
+  name: string;
+  color: string;
+  emblem: string | null;
+  role: LumenRole;
+};
+
+export const LUMEN_TEAM: readonly LumenPreset[] = [
+  { name: "小猪包", color: "#D8B878", emblem: null, role: "chief" },
