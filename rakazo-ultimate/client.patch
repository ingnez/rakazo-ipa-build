+  const documents = [...input].sort(
+    (left, right) =>
+      memoryTimestamp(right.updatedAt) - memoryTimestamp(left.updatedAt) ||
+      right.revision - left.revision ||
+      left.scope.localeCompare(right.scope) ||
+      left.path.localeCompare(right.path),
+  );
