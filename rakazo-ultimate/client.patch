new file mode 100644
index 000000000..2f0b17285
--- /dev/null
+++ b/apps/mobile/components/thread/reaction-pill.tsx
@@ -0,0 +1,98 @@
+import { useEffect, useRef } from "react";
+import { StyleSheet, View } from "react-native";
+import Animated, {
+  FadeIn,
+  useReducedMotion,
+  ZoomIn,
+  ZoomOut,
+} from "react-native-reanimated";
+import { mobileTokens } from "../../lib/appearance";
+import { useThemedStyles } from "../../lib/native";
+
+/** How a reaction travels in: a small spring from under the bubble, not a pop out of nothing. */
+const FLY_IN_MS = 160;
+const FLY_OUT_MS = 120;
+
+/**
+ * The reactions on a message, in one capsule under it.
+ *
+ * A reaction is one of the few things in a chat that is *added* rather than replaced, so it is the
+ * one that should be seen arriving: the pill grows from under the bubble over 160 ms while the
+ * emoji itself comes up into place. The capsule holds every reaction the message has, so three
+ * reactions read as one thought rather than three chips; a count only shows once it is above one.
+ */
+export function ReactionPill({
+  reactions,
+  align = "start",
+  onPress,
+}: {
+  reactions: ReadonlyMap<string, number>;
+  /** Which edge of the bubble the pill hangs from. */
+  align?: "start" | "end";
+  onPress?: (emoji: string) => void;
+}) {
+  const styles = useThemedStyles(createPillStyles);
+  const tokens = mobileTokens();
+  const reduceMotion = useReducedMotion();
+  const items = [...reactions];
+  // The reactions this message already had when it was drawn: only a reaction that arrives while
+  // the row is on screen plays the entrance.
+  const seen = useRef<ReadonlySet<string>>(new Set(reactions.keys()));
+  useEffect(() => {
+    seen.current = new Set(reactions.keys());
+  }, [reactions]);
+  if (items.length === 0) return null;
+  return (
+    <View
+      style={[styles.pill, { alignSelf: align === "end" ? "flex-end" : "flex-start" }]}
+      accessibilityRole="text"
+      accessibilityLabel={items
+        .map(([emoji, count]) => (count > 1 ? `${emoji} ${count}` : emoji))
+        .join(", ")}
+    >
+      {items.map(([emoji, count], index) => {
+        const arriving = !seen.current.has(emoji);
+        return (
+          <Animated.View
+            key={emoji}
+            entering={
+              arriving && !reduceMotion ? ZoomIn.duration(FLY_IN_MS) : undefined
+            }
+            exiting={reduceMotion ? undefined : ZoomOut.duration(FLY_OUT_MS)}
+            style={styles.item}
+            onTouchEnd={onPress ? () => onPress(emoji) : undefined}
+          >
+            <Animated.Text
+              entering={reduceMotion ? undefined : FadeIn.duration(FLY_IN_MS)}
+              style={[styles.emoji, index === 0 && styles.firstEmoji, { color: tokens.foreground }]}
+            >
+              {emoji}
+              {count > 1 ? <Animated.Text style={styles.count}>{` ${count}`}</Animated.Text> : null}
+            </Animated.Text>
+          </Animated.View>
+        );
+      })}
+    </View>
+  );
+}
+
+function createPillStyles() {
+  const tokens = mobileTokens();
+  return StyleSheet.create({
+    pill: {
+      flexDirection: "row",
+      alignItems: "center",
+      gap: 6,
+      marginTop: 4,
+      paddingHorizontal: 9,
+      paddingVertical: 3,
+      borderRadius: 999,
+      borderCurve: "continuous",
+      backgroundColor: tokens.muted,
+    },
+    item: { flexDirection: "row", alignItems: "center" },
+    emoji: { fontSize: 13 },
+    firstEmoji: {},
+    count: { fontSize: 12, fontWeight: "600", color: tokens.mutedForeground },
+  });
+}
