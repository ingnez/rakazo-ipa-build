+async function render() {
+  host = document.createElement("div");
+  document.body.appendChild(host);
+  root = createRoot(host);
+  await act(async () => {
+    root?.render(createElement(IphoneConnectorGroup));
+  });
+}
+
+function rows() {
+  return Array.from(host?.querySelectorAll("button[aria-label]") ?? []) as HTMLButtonElement[];
+}
+
+afterEach(() => {
+  act(() => root?.unmount());
+  host?.remove();
+  root = null;
+  host = null;
+});
+
+beforeEach(() => {
+  state.stored = { ...PHONE_CONNECTORS_OFF };
+  state.permission = "granted";
+  state.requested.length = 0;
+  state.saved.length = 0;
+  state.pushed.length = 0;
+  state.pairs = 0;
+  state.resume = 0;
+  state.refresh = 0;
+  state.alert.mockReset();
+  state.settings.mockReset();
+});
+
+it("lists the five connectors in Chinese, with their own switches", async () => {
+  await render();
+  const labels = rows().map((row) => row.getAttribute("aria-label"));
+  expect(labels).toEqual(["闹钟", "日历", "提醒事项", "通讯录", "位置"]);
+  expect(host?.textContent).toContain("这台 iPhone 上的闹钟、日历、提醒事项、通讯录和位置");
+  expect(
+    state.permission && rows().every((row) => row.getAttribute("aria-checked") === "false"),
+  ).toBe(true);
+});
+
+it("asks iOS for that permission, then saves the switch and tells the server", async () => {
+  await render();
+  await act(async () => {
+    rows()[0]!.click();
+  });
+  expect(state.requested).toEqual(["alarms"]);
+  expect(state.saved.at(-1)).toMatchObject({ alarms: true });
+  expect(state.pushed.at(-1)).toMatchObject({ alarms: true });
+  expect(state.pairs).toBe(1);
+  expect(state.resume).toBe(1);
+  expect(rows()[0]!.getAttribute("aria-checked")).toBe("true");
+});
+
+it("keeps the switch off and says why when iOS refuses", async () => {
+  state.permission = "denied";
+  await render();
+  await act(async () => {
+    rows()[0]!.click();
+  });
+  expect(rows()[0]!.getAttribute("aria-checked")).toBe("false");
+  expect(state.saved).toHaveLength(0);
+  expect(host?.textContent).toContain("系统没有允许 Bot 使用这项权限");
+  expect(state.alert).toHaveBeenCalledTimes(1);
+});
+
+it("turns a switch off without asking anything again", async () => {
+  state.stored = { ...PHONE_CONNECTORS_OFF, calendar: true };
+  await render();
+  await act(async () => {
+    rows()[1]!.click();
+  });
+  expect(state.requested).toEqual([]);
+  expect(state.saved.at(-1)).toMatchObject({ calendar: false });
+  expect(state.refresh).toBe(1);
+  expect(rows()[1]!.getAttribute("aria-checked")).toBe("false");
+});
+
+it("shows how many of the five are on", async () => {
+  state.stored = { ...PHONE_CONNECTORS_OFF, alarms: true, location: true };
+  await render();
+  expect(host?.textContent).toContain("2 项已开");
+});
diff --git a/apps/mobile/lib/keyboard-lift-points.ts b/apps/mobile/lib/keyboard-lift-points.ts
new file mode 100644
index 000000000..c8fd15b8c
--- /dev/null
+++ b/apps/mobile/lib/keyboard-lift-points.ts
@@ -0,0 +1,20 @@
+/**
+ * The lift a view takes from the keyboard, kept apart from React and from the keyboard itself so
+ * it can be read and tested on its own.
+ *
+ * The KeyboardController reports the keyboard's height as the distance the window rises: a
+ * negative number, more negative the taller the keyboard is. A view that already sits `offset`
+ * points above the window's bottom needs that much less room.
+ *
+ * `useKeyboardLift` reads this same arithmetic *inline* on the UI thread rather than calling it,
+ * so a captured JS function is never invoked from a worklet (that throws a native error there and
+ * takes the app down the moment the chat page mounts). Keep the two in step: the cases in
+ * `keyboard-lift.test.ts` are the numbers both must give.
+ */
+
+/** The room a keyboard takes from the bottom of a view, from the height the keyboard reports. */
+export function liftPoints(keyboardHeight: number, offset = 0): number {
+  "worklet";
+  if (!Number.isFinite(keyboardHeight)) return 0;
+  return Math.max(-keyboardHeight - offset, 0);
+}
diff --git a/apps/mobile/lib/keyboard-lift.test.ts b/apps/mobile/lib/keyboard-lift.test.ts
new file mode 100644
index 000000000..96806130c
--- /dev/null
+++ b/apps/mobile/lib/keyboard-lift.test.ts
@@ -0,0 +1,30 @@
+import { describe, expect, it } from "vitest";
+import { liftPoints } from "./keyboard-lift-points";
+
+/** The composer's lift, as the chat screen reads it: the keyboard's own frames, in points. */
+describe("liftPoints", () => {
+  it("rests with no keyboard", () => {
+    expect(liftPoints(0)).toBe(0);
+  });
+
+  it("rises by the height the keyboard reports", () => {
+    // The library reports the distance the window rises as a negative number.
+    expect(liftPoints(-336)).toBe(336);
+  });
+
+  it("takes a keyboard that grows taller, as 搜狗's toolbar makes it", () => {
+    expect(liftPoints(-380)).toBe(380);
+  });
+
+  it("leaves the room a view already covers under the keyboard out of the lift", () => {
+    expect(liftPoints(-336, 24)).toBe(312);
+    // A view that sits below the keyboard's edge does not sink into it.
+    expect(liftPoints(-10, 24)).toBe(0);
+  });
+
+  it("never lifts a view for a keyboard that is not there", () => {
+    expect(liftPoints(12)).toBe(0);
+    expect(liftPoints(Number.NaN)).toBe(0);
+    expect(liftPoints(Number.NEGATIVE_INFINITY)).toBe(0);
+  });
+});
diff --git a/apps/mobile/lib/keyboard-lift.ts b/apps/mobile/lib/keyboard-lift.ts
new file mode 100644
index 000000000..c6a942e8a
--- /dev/null
+++ b/apps/mobile/lib/keyboard-lift.ts
@@ -0,0 +1,64 @@
+import { useReanimatedKeyboardAnimation } from "react-native-keyboard-controller";
+import type { SharedValue } from "react-native-reanimated";
+import { useAnimatedReaction, useAnimatedStyle, useSharedValue } from "react-native-reanimated";
+
+/**
+ * A view's lift above the keyboard, read from the keyboard itself on the frame it moves.
+ *
+ * The keyboard's own animation is delivered by the native KeyboardController as a shared value:
+ * every frame it reports, the value already holds that frame's height, and the view is moved from
+ * the UI thread — not from a JS timer, and not by re-laying out what is on the screen. A third-party
+ * keyboard (搜狗, Gboard) that grows a candidate strip or swaps itself for a toolbar therefore
+ * carries the composer with it frame for frame, exactly as the system keyboard does.
+ *
+ * The lift is a translation, not padding: the composer and the messages travel together, and no
+ * list recalculates its layout while the keyboard is moving. What the movement uncovers at the
+ * bottom of the window is under the keyboard and never seen.
+ */
+export interface KeyboardLift {
+  /** The translation to apply, in points: 0 at rest, the keyboard's own height when it is up. */
+  readonly style: ReturnType<typeof useAnimatedStyle>;
+  /** The lift right now, in points: 0 at rest, the keyboard's own height when it is up. */
+  readonly height: SharedValue<number>;
+  /** The input took the focus. The keyboard's own frames decide the lift, so there is nothing to do. */
+  hold(): void;
+  /** The input lost the focus. The keyboard's own frames decide the lift, so there is nothing to do. */
+  release(): void;
+}
+
+export function useKeyboardLift({
+  active = true,
+  offset = 0,
+}: {
+  /** Whether this view may lift at all (a screen inside a call yields to the root). */
+  active?: boolean;
+  /** Space the keyboard already covers at this view's bottom, in points. */
+  offset?: number;
+} = {}): KeyboardLift {
+  const { height: keyboard } = useReanimatedKeyboardAnimation();
+  const height = useSharedValue(0);
+  // The shared value the dock and the composer read is the lifted height, in points, so both the
+  // translation and the composer's own padding come from the same frame.
+  // The lift is worked out here, in this worklet, from the keyboard's own frame value. It must
+  // not call a plain JS function: on the UI thread that throws a native error and the app goes
+  // down as soon as the chat page mounts. Only the shared value, `active` and `offset` are
+  // captured, and all three cross to the UI thread as data.
+  useAnimatedReaction(
+    () => {
+      if (!active) return 0;
+      const keyboardHeight = keyboard.value;
+      return Number.isFinite(keyboardHeight) ? Math.max(-keyboardHeight - offset, 0) : 0;
+    },
+    (next, previous) => {
+      if (next !== previous) height.value = next;
+    },
+    [active, offset],
+  );
+  const style = useAnimatedStyle(() => ({ transform: [{ translateY: -height.value }] }));
+  return {
+    style,
+    height,
+    hold: () => undefined,
+    release: () => undefined,
+  };
+}
diff --git a/apps/mobile/lib/ledger-store.ts b/apps/mobile/lib/ledger-store.ts
new file mode 100644
index 000000000..c5e089fe8
--- /dev/null
+++ b/apps/mobile/lib/ledger-store.ts
@@ -0,0 +1,110 @@
+import { useSyncExternalStore } from "react";
+import type { LedgerTask } from "./ledger-tasks";
+
+/**
+ * A chat's ledger, shared by the screen that fills it and the title capsule that opens it: the
+ * capsule lives in the native header, which the screen cannot pass props to.
+ */
+type LedgerState = { tasks: LedgerTask[]; open: boolean; signature: string };
+
+const NO_TASKS: LedgerTask[] = [];
+const states = new Map<string, LedgerState>();
+const listeners = new Set<() => void>();
+
+function notify() {
+  for (const listener of listeners) listener();
+}
+
+function subscribe(listener: () => void): () => void {
+  listeners.add(listener);
+  return () => {
+    listeners.delete(listener);
+  };
+}
+
+function read(routeKey: string): LedgerState | undefined {
+  return states.get(routeKey);
+}
+
+function write(routeKey: string, next: Omit<LedgerState, "signature">, signature: string) {
+  states.set(routeKey, { ...next, signature });
+  notify();
+}
+
+/** What makes two ledgers the same ledger: which work, at which step, on which model. */
+function ledgerSignature(tasks: LedgerTask[]): string {
+  return tasks
+    .map((task) =>
+      [
+        task.id,
+        task.title,
+        task.step ?? "",
+        task.model ?? "",
+        task.startedAt ?? "",
+        task.status ?? "",
+        task.finishedAt ?? "",
+      ].join("\u0000"),
+    )
+    .join("\u0001");
+}
+
+/**
+ * Publishes the chat's running work; a ledger whose work and steps are unchanged is left alone,
+ * so a re-render of the screen does not re-render the native header.
+ */
+export function publishLedgerTasks(routeKey: string, tasks: LedgerTask[]): void {
+  const signature = ledgerSignature(tasks);
+  const current = read(routeKey);
+  if (current?.signature === signature) return;
+  write(routeKey, { tasks, open: current?.open ?? false }, signature);
+}
+
+/** A chat's ledger in full, for the panel that draws it. */
+export function useLedger(routeKey: string): { tasks: LedgerTask[]; open: boolean } {
+  const tasks = useSyncExternalStore(
+    subscribe,
+    () => read(routeKey)?.tasks ?? NO_TASKS,
+    () => read(routeKey)?.tasks ?? NO_TASKS,
+  );
+  const open = useSyncExternalStore(
+    subscribe,
+    () => read(routeKey)?.open ?? false,
+    () => read(routeKey)?.open ?? false,
+  );
+  return { tasks, open };
+}
+
+export function useLedgerTasks(routeKey: string): LedgerTask[] {
+  return useSyncExternalStore(
+    subscribe,
+    () => read(routeKey)?.tasks ?? NO_TASKS,
+    () => read(routeKey)?.tasks ?? NO_TASKS,
+  );
+}
+
+export function useLedgerOpen(routeKey: string): boolean {
+  return useSyncExternalStore(
+    subscribe,
+    () => read(routeKey)?.open ?? false,
+    () => read(routeKey)?.open ?? false,
+  );
+}
+
+export function setLedgerOpen(routeKey: string, open: boolean): void {
+  const current = read(routeKey);
+  if (current?.open === open) return;
+  // A chat that has not published its work yet still owns the switch: the panel opens onto an
+  // empty ledger rather than the tap going nowhere.
+  states.set(routeKey, current ? { ...current, open } : { tasks: NO_TASKS, open, signature: "" });
+  notify();
+}
+
+export function toggleLedgerOpen(routeKey: string): void {
+  setLedgerOpen(routeKey, !(read(routeKey)?.open ?? false));
+}
+
+/** A chat that goes away takes its ledger with it: the next visit starts closed. */
+export function clearLedger(routeKey: string): void {
+  if (!states.delete(routeKey)) return;
+  notify();
+}
diff --git a/apps/mobile/lib/ledger-tasks.test.ts b/apps/mobile/lib/ledger-tasks.test.ts
