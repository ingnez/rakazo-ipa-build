+import type { FrontDeskTask, TaskStep } from "@rakazo/contracts";
+import { describe, expect, it } from "vitest";
+import {
+  groupTasksByDay,
+  mergeTaskPages,
+  taskClock,
+  taskDayLabel,
+  taskDurationLabel,
+  taskElapsedLabel,
+  taskIsOpen,
+  taskRowDetail,
+  taskRowMeta,
+  taskRowTrail,
+  taskRunningStep,
+  taskStatusLabel,
+  taskTimelineSteps,
+} from "./task-steps";
+
+function task(overrides: Partial<FrontDeskTask> = {}): FrontDeskTask {
+  return {
+    id: "task_1",
+    runId: "run_1",
+    title: "热修记忆页",
+    status: "running",
+    slot: "heavy",
+    modelProvider: "Workbudy",
+    modelId: "gpt-5",
+    progress: null,
+    steps: [],
+    currentStep: null,
+    elapsedMs: 584_000,
+    createdAt: "2026-11-17T08:57:00.000",
+    updatedAt: "2026-11-17T09:07:00.000",
+    completedAt: null,
+    ...overrides,
+  };
+}
+
+function step(overrides: Partial<TaskStep> = {}): TaskStep {
+  return {
+    id: "call:1",
+    kind: "tool",
+    label: "Shell",
+    status: "completed",
+    timestamp: "2026-11-17T08:58:00.000",
+    ...overrides,
+  };
+}
+
+describe("taskIsOpen", () => {
+  it("counts only the two states that mean the work is still in the back office", () => {
+    expect(taskIsOpen("queued")).toBe(true);
+    expect(taskIsOpen("running")).toBe(true);
+    expect(taskIsOpen("completed")).toBe(false);
+    expect(taskIsOpen("failed")).toBe(false);
+    expect(taskIsOpen("cancelled")).toBe(false);
+    expect(taskIsOpen(undefined)).toBe(false);
+  });
+});
+
+describe("taskStatusLabel", () => {
+  it("says each state in the app's own words", () => {
+    expect(taskStatusLabel("queued")).toBe("排队中");
+    expect(taskStatusLabel("running")).toBe("进行中");
+    expect(taskStatusLabel("completed")).toBe("已完成");
+    expect(taskStatusLabel("failed")).toBe("失败");
+    expect(taskStatusLabel("cancelled")).toBe("已取消");
+    expect(taskStatusLabel("waiting_input")).toBe("等你回答");
+    expect(taskStatusLabel("something_else")).toBe("something_else");
+  });
+});
+
+describe("taskElapsedLabel", () => {
+  it("shows minutes and seconds like the reference app's row", () => {
+    expect(taskElapsedLabel(584_000)).toBe("9:44");
+    expect(taskElapsedLabel(0)).toBe("0:00");
+    expect(taskElapsedLabel(7_000)).toBe("0:07");
+    expect(taskElapsedLabel(62_000)).toBe("1:02");
+  });
+
+  it("grows to hours rather than counting minutes forever", () => {
+    expect(taskElapsedLabel(3_723_000)).toBe("1:02:03");
+  });
+
+  it("shows nothing when the server sent no number", () => {
+    expect(taskElapsedLabel(undefined)).toBe("");
+    expect(taskElapsedLabel(null)).toBe("");
+    expect(taskElapsedLabel(Number.NaN)).toBe("");
+  });
+});
+
+describe("taskDurationLabel", () => {
+  it("keeps a call's own time short", () => {
+    expect(taskDurationLabel(320)).toBe("320ms");
+    expect(taskDurationLabel(4_240)).toBe("4.2s");
+    expect(taskDurationLabel(38_000)).toBe("38s");
+    expect(taskDurationLabel(68_000)).toBe("1m 08s");
+    expect(taskDurationLabel(undefined)).toBe("");
+  });
+});
+
+describe("taskClock", () => {
+  it("reads the moment in the phone's time zone", () => {
+    expect(taskClock(new Date(2026, 10, 17, 8, 57).toISOString())).toBe("8:57");
+    expect(taskClock(new Date(2026, 10, 17, 23, 5, 40).toISOString())).toBe("23:05");
+    expect(taskClock(undefined)).toBe("");
+    expect(taskClock("not a date")).toBe("");
+  });
+});
+
+describe("taskDayLabel", () => {
+  const now = new Date(2026, 10, 17, 11, 30).getTime();
+
+  it("names today and yesterday, then the date", () => {
+    expect(taskDayLabel(new Date(2026, 10, 17, 8, 57).toISOString(), now)).toBe("今天");
+    expect(taskDayLabel(new Date(2026, 10, 16, 22, 10).toISOString(), now)).toBe("昨天");
+    expect(taskDayLabel(new Date(2026, 10, 14, 3, 21).toISOString(), now)).toBe("11月14日");
+  });
+});
+
+describe("the rows the Tasks list draws", () => {
+  it("puts the work's own line under the title, and the elapsed time at the right", () => {
+    const running = task({ currentStep: "cd /workspace && python3 .tools/run.py" });
+    expect(taskRowDetail(running)).toBe("cd /workspace && python3 .tools/run.py");
+    expect(taskRowTrail(running)).toBe("9:44");
+    expect(taskRowMeta(running)).toBe("进行中 · 8:57 开始");
+  });
+
+  it("falls back to progress, then to a line that still says something", () => {
+    expect(taskRowDetail(task({ progress: "看看排班表" }))).toBe("看看排班表");
+    expect(taskRowDetail(task({}))).toBe("正在开始");
+    expect(taskRowDetail(task({ status: "completed" }))).toBe("已完成");
+  });
+
+  it("shows when a task settled rather than how long it ran", () => {
+    const done = task({
+      status: "completed",
+      currentStep: "结果：热修包已出",
+      completedAt: new Date(2026, 10, 17, 8, 24).toISOString(),
+    });
+    expect(taskRowTrail(done)).toBe("8:24");
+    expect(taskRowMeta(done)).toBe("已完成 · 8:57 开始");
+  });
+
+  it("groups rows under their day, newest day first, keeping the server's order inside a day", () => {
+    const today = new Date(2026, 10, 17, 9, 0).toISOString();
+    const earlier = new Date(2026, 10, 16, 23, 0).toISOString();
+    const groups = groupTasksByDay(
+      [
+        task({ id: "a", createdAt: today, updatedAt: today }),
+        task({ id: "b", createdAt: today, updatedAt: today }),
+        task({ id: "c", createdAt: earlier, updatedAt: earlier }),
+      ],
+      new Date(2026, 10, 17, 11, 30).getTime(),
+    );
+    expect(groups.map((group) => group.label)).toEqual(["今天", "昨天"]);
+    expect(groups[0]?.tasks.map((row) => row.id)).toEqual(["a", "b"]);
+  });
+
+  it("does not show a row twice when a page boundary moved under it", () => {
+    const one = task({ id: "a" });
+    const two = task({ id: "b" });
+    expect(
+      mergeTaskPages([
+        [one, two],
+        [two, task({ id: "c" })],
+      ]).map((row) => row.id),
+    ).toEqual(["a", "b", "c"]);
+  });
+});
+
+describe("the timeline", () => {
+  it("reads the steps in the order they happened, whatever order they came in", () => {
+    const steps = taskTimelineSteps({
+      steps: [
+        step({ id: "late", timestamp: "2026-11-17T09:00:00.000" }),
+        step({ id: "early", timestamp: "2026-11-17T08:58:00.000" }),
