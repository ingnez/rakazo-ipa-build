diff --git a/apps/mobile/modules/rakazo-document-scanner/ios/RakazoDocumentScannerModule.swift b/apps/mobile/modules/rakazo-document-scanner/ios/RakazoDocumentScannerModule.swift
new file mode 100644
index 000000000..be3ce37e2
--- /dev/null
+++ b/apps/mobile/modules/rakazo-document-scanner/ios/RakazoDocumentScannerModule.swift
@@ -0,0 +1,147 @@
+import ExpoModulesCore
+import UIKit
+import VisionKit
+
+/// Opens the system's document camera (VisionKit) and hands back one JPEG per scanned page: the
+/// paper is found, straightened and cropped by the system itself, so a photo of a form arrives
+/// readable instead of skewed. Pages land in the temporary directory and the caller reads and
+/// removes them, exactly as it does a photo the camera returns.
+public class RakazoDocumentScannerModule: Module {
+  private var scanning = false
+  /// Held while the camera is up: the scanner's delegate is weak, so the scan owns it here until
+  /// the person finishes or backs out.
+  private var delegate: ScannerDelegate?
+
+  public func definition() -> ModuleDefinition {
+    Name("RakazoDocumentScanner")
+
+    /// Whether this device can scan at all (a camera and a supported chip). False on a simulator.
+    Function("isAvailable") { () -> Bool in
+      VNDocumentCameraViewController.isSupported
+    }
+
+    AsyncFunction("scan") { (promise: Promise) in
+      // Everything below touches the camera and the module's own state, so it runs on the main
+      // queue; the caller's promise settles from the delegate callbacks.
+      DispatchQueue.main.async {
+        if self.scanning {
+          promise.reject("ERR_DOCUMENT_SCAN_BUSY", "The document camera is already open.")
+          return
+        }
+        guard VNDocumentCameraViewController.isSupported else {
+          promise.reject("ERR_DOCUMENT_SCAN_UNSUPPORTED", "This device cannot scan documents.")
+          return
+        }
+        guard let presenter = Self.presentingViewController() else {
+          promise.reject("ERR_DOCUMENT_SCAN_NO_SCREEN", "There is no screen to scan on.")
+          return
+        }
+        let delegate = ScannerDelegate(promise: promise) { [weak self] in
+          self?.scanning = false
+          self?.delegate = nil
+        }
+        self.delegate = delegate
+        self.scanning = true
+        let scanner = VNDocumentCameraViewController()
+        scanner.delegate = delegate
+        presenter.present(scanner, animated: true)
+      }
+    }
+  }
+
+  /// The controller a sheet can be presented from: the key window's, with any presented sheet
+  /// peeled off, so the camera never tries to present from a controller already presenting one.
+  private static func presentingViewController() -> UIViewController? {
+    let scene = UIApplication.shared.connectedScenes
+      .compactMap { $0 as? UIWindowScene }
+      .first { $0.activationState == .foregroundActive }
+      ?? UIApplication.shared.connectedScenes.compactMap { $0 as? UIWindowScene }.first
+    let root = scene?.windows.first { $0.isKeyWindow }?.rootViewController
+      ?? scene?.windows.first?.rootViewController
+    var top = root
+    while let presented = top?.presentedViewController, !presented.isBeingDismissed {
+      top = presented
+    }
+    return top
+  }
+}
+
+/// The document camera's delegate: it answers once, writes the scanned pages and settles the
+/// promise the module was called with. Swift only lets an `NSObject` conform to the delegate, so
+/// this stands beside the module rather than on it.
+private final class ScannerDelegate: NSObject, VNDocumentCameraViewControllerDelegate {
+  private let promise: Promise
+  private let onSettled: () -> Void
+
+  init(promise: Promise, onSettled: @escaping () -> Void) {
+    self.promise = promise
+    self.onSettled = onSettled
+  }
+
+  func documentCameraViewController(
+    _ controller: VNDocumentCameraViewController,
+    didFinishWith scan: VNDocumentCameraScan
+  ) {
+    let result = Self.pages(from: scan)
+    controller.dismiss(animated: true) { [weak self] in self?.settle(result) }
+  }
+
+  func documentCameraViewControllerDidCancel(_ controller: VNDocumentCameraViewController) {
+    controller.dismiss(animated: true) { [weak self] in self?.settle(.success([])) }
+  }
+
+  func documentCameraViewController(
+    _ controller: VNDocumentCameraViewController,
+    didFailWithError error: Error
+  ) {
+    controller.dismiss(animated: true) { [weak self] in
+      self?.settle(.failure(DocumentScanError.cameraFailed))
+    }
+  }
+
+  private func settle(_ result: Result<[String], Error>) {
+    switch result {
+    case .success(let pages): promise.resolve(pages)
+    case .failure(let error):
+      promise.reject("ERR_DOCUMENT_SCAN_FAILED", error.localizedDescription)
+    }
+    onSettled()
+  }
+
+  private static func pages(from scan: VNDocumentCameraScan) -> Result<[String], Error> {
+    let directory = FileManager.default.temporaryDirectory
+      .appendingPathComponent("rakazo-scan-\(UUID().uuidString)", isDirectory: true)
+    do {
+      try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+    } catch {
+      return .failure(DocumentScanError.writeFailed)
+    }
+    var uris: [String] = []
+    for index in 0..<scan.pageCount {
+      let image = scan.imageOfPage(at: index)
+      guard let data = image.jpegData(compressionQuality: 0.92) else { continue }
+      let file = directory.appendingPathComponent("scan-\(index + 1).jpg")
+      do {
+        try data.write(to: file)
+        uris.append(file.absoluteString)
+      } catch {
+        continue
+      }
+    }
+    return uris.isEmpty ? .failure(DocumentScanError.empty) : .success(uris)
+  }
+}
+
+internal enum DocumentScanError: Error, LocalizedError {
+  case writeFailed
+  case empty
+  case cameraFailed
+
+  var errorDescription: String? {
+    switch self {
+    case .writeFailed: return "The scanned pages could not be saved."
+    case .empty: return "The scan produced no pages."
+    case .cameraFailed: return "The document camera stopped unexpectedly."
+    }
+  }
+}
