+import { describe, expect, it } from "vitest";
+import {
+  fastReplyEnabled,
+  fastReplyModelId,
+  fastReplyTimeoutMs,
+  introQuickReply,
+  messageQuickReply,
+  quickReplyForRun,
+} from "./fast-reply.js";
+
+const env = (pairs: Record<string, string>): NodeJS.ProcessEnv => pairs as NodeJS.ProcessEnv;
+
+describe("fast reply settings", () => {
+  it("is on unless it is switched off", () => {
+    expect(fastReplyEnabled(env({}))).toBe(true);
+    expect(fastReplyEnabled(env({ RAKAZO_FAST_REPLY: "1" }))).toBe(true);
+    for (const off of ["0", "false", "no", "off", "OFF"]) {
+      expect(fastReplyEnabled(env({ RAKAZO_FAST_REPLY: off }))).toBe(false);
+    }
+  });
+
+  it("runs the run's own model unless a faster one is named", () => {
+    expect(fastReplyModelId({ id: "big-reasoner" }, env({}))).toBe("big-reasoner");
+    expect(
+      fastReplyModelId({ id: "big-reasoner" }, env({ RAKAZO_FAST_REPLY_MODEL: " tiny-chat " })),
+    ).toBe("tiny-chat");
+    expect(fastReplyModelId({ id: "big-reasoner" }, env({ RAKAZO_FAST_REPLY_MODEL: "  " }))).toBe(
+      "big-reasoner",
+    );
+  });
+
+  it("keeps the wait short and ignores unusable timeouts", () => {
+    expect(fastReplyTimeoutMs(env({}))).toBe(6_000);
+    expect(fastReplyTimeoutMs(env({ RAKAZO_FAST_REPLY_TIMEOUT_MS: "2500" }))).toBe(2_500);
+    for (const bad of ["0", "-5", "soon", "999999"]) {
+      expect(fastReplyTimeoutMs(env({ RAKAZO_FAST_REPLY_TIMEOUT_MS: bad }))).toBe(6_000);
+    }
+  });
+});
+
+describe("quick reply lines", () => {
+  it("names the bot and the person and keeps one short line", () => {
+    const reply = messageQuickReply({ botName: "Chief", personName: "土豆哇", text: "帮我看看明天天气" });
+    expect(reply.prompt).toBe("帮我看看明天天气");
+    expect(reply.instructions).toContain("Chief");
+    expect(reply.instructions).toContain("土豆哇");
+    expect(reply.instructions).toContain("one short line");
+    expect(reply.instructions).toContain("same language");
+  });
+
+  it("does not introduce a bot by a placeholder name", () => {
+    const reply = introQuickReply({ botName: "New Bot", personName: "Li" });
+    expect(reply.instructions).not.toContain("New Bot");
+    expect(reply.instructions).toContain("name is not chosen yet");
+    expect(reply.instructions).toContain("Li");
+  });
+
+  it("describes what the bot is for when it already knows", () => {
+    const reply = introQuickReply({
+      botName: "Chief",
+      description: "Runs my day",
+    });
+    expect(reply.instructions).toContain("Chief");
+    expect(reply.instructions).toContain("Runs my day");
+  });
+});
+
+describe("quickReplyForRun", () => {
+  const base = {
+    bot: { name: "Chief", description: null },
+    personName: "Li",
+    text: "帮我把你设成主 bot",
+    silent: false,
+    scripted: false,
+  };
+
+  it("answers a message the person sent", () => {
+    for (const trigger of ["user", "follow_up", "call_end"]) {
+      expect(quickReplyForRun({ ...base, trigger })).toBeDefined();
+    }
+  });
+
+  it("greets the person who just created the bot", () => {
+    const reply = quickReplyForRun({ ...base, trigger: "created", text: "Chief 的主 bot" });
+    expect(reply?.instructions).toContain("brand-new assistant");
+  });
+
+  it("says nothing where silence is the answer", () => {
+    expect(quickReplyForRun({ ...base, trigger: "routine" })).toBeUndefined();
+    expect(quickReplyForRun({ ...base, trigger: "webhook" })).toBeUndefined();
+    expect(quickReplyForRun({ ...base, trigger: "tickets" })).toBeUndefined();
+    expect(quickReplyForRun({ ...base, trigger: "bot_message" })).toBeUndefined();
+    expect(
+      quickReplyForRun({ ...base, trigger: "user", silent: true, env: env({}) }),
+    ).toBeUndefined();
+  });
+
+  it("never adds a turn to a scripted harness or a switched-off deployment", () => {
+    expect(quickReplyForRun({ ...base, trigger: "user", scripted: true })).toBeUndefined();
+    expect(
+      quickReplyForRun({ ...base, trigger: "user", env: env({ RAKAZO_FAST_REPLY: "0" }) }),
+    ).toBeUndefined();
+  });
+
+  it("sends only the head of a very long message", () => {
+    const reply = quickReplyForRun({ ...base, trigger: "user", text: "字".repeat(5_000) });
+    expect(reply?.prompt.length).toBeLessThan(1_300);
+    expect(reply?.prompt.endsWith("…")).toBe(true);
+  });
+});
diff --git a/packages/adapters/src/fast-reply.ts b/packages/adapters/src/fast-reply.ts
new file mode 100644
index 0000000..8015373
--- /dev/null
+++ b/packages/adapters/src/fast-reply.ts
@@ -0,0 +1,141 @@
+import type { AgentQuickReply } from "@rakazo/adapter-kit";
+import { BACKGROUND_HELPER_TRIGGER, isConversationalRun } from "@rakazo/core";
+
+/**
+ * The fast tier: one short line asked of the same model connection while the real turn is
+ * still starting. A reasoning model can spend seconds before its first visible token, and
+ * a person watching an empty chat reads that as being ignored. The line is dropped the
+ * moment the real turn says anything, so it costs nothing when the model is quick.
+ *
+ * RAKAZO_FAST_REPLY=0 turns it off; RAKAZO_FAST_REPLY_MODEL points it at a faster model on
+ * the same connection; RAKAZO_FAST_REPLY_TIMEOUT_MS bounds the wait.
+ */
+
+/** Small enough that a provider answers in one short line and stops. */
+export const QUICK_REPLY_MAX_TOKENS = 96;
+
+/** The tail of a long message is enough context for a reaction to it. */
+const QUICK_REPLY_PROMPT_MAX_CHARS = 1_200;
+
+const DEFAULT_FAST_REPLY_TIMEOUT_MS = 6_000;
+
+export function fastReplyEnabled(env: NodeJS.ProcessEnv = process.env): boolean {
+  const raw = env.RAKAZO_FAST_REPLY?.trim().toLowerCase();
+  return !(raw === "0" || raw === "false" || raw === "no" || raw === "off");
+}
+
+/** A model on the run's own connection that answers short lines faster, when one is named. */
+export function fastReplyModelId(
+  runModel: { id: string },
+  env: NodeJS.ProcessEnv = process.env,
+): string {
+  return env.RAKAZO_FAST_REPLY_MODEL?.trim() || runModel.id;
+}
+
+export function fastReplyTimeoutMs(env: NodeJS.ProcessEnv = process.env): number {
+  const raw = env.RAKAZO_FAST_REPLY_TIMEOUT_MS?.trim();
+  if (!raw || !/^\d+$/.test(raw)) return DEFAULT_FAST_REPLY_TIMEOUT_MS;
+  const value = Number(raw);
+  if (!Number.isSafeInteger(value) || value < 500 || value > 30_000) {
+    return DEFAULT_FAST_REPLY_TIMEOUT_MS;
+  }
+  return value;
+}
+
+/** A name still waiting to be set is not something to introduce yourself with. */
+const PLACEHOLDER_NAME = /^(?:new bot|untitled(?: bot)?|bot|未命名(?:bot|机器人)?|新 ?bot)$/i;
+
+function spokenName(name: string | undefined): string {
+  const trimmed = name?.trim() ?? "";
+  return trimmed && !PLACEHOLDER_NAME.test(trimmed) ? trimmed : "";
+}
+
+/** The one short line that answers a message while the real turn works. */
+export function messageQuickReply(input: {
+  botName: string;
+  personName?: string | null;
+  text: string;
+}): AgentQuickReply {
+  const name = spokenName(input.botName);
+  const person = input.personName?.trim();
+  return {
+    instructions: [
+      `You are ${name || "an assistant"} writing in a chat on a phone.`,
+      person ? `You are talking to ${person}.` : undefined,
+      "The person just sent the message below. Write the one short line you would send back this second.",
+      'A warm, quick reaction in the same language they wrote in; if they asked for something, that you are on it ("好，我这就去" / "on it!").',
+      "One sentence, at most about fifteen words. No quotes, no markdown, no lists, no headings, no emoji unless they used one, no question.",
+      "Never promise a result, never explain that you are thinking, and never ask for confirmation.",
+    ]
+      .filter(Boolean)
+      .join(" "),
+    prompt: input.text,
+  };
+}
+
+/**
+ * The line a brand-new bot says the moment it exists, before the model behind it has had
+ * time to work out what it is for.
+ */
+export function introQuickReply(input: {
+  botName: string;
+  personName?: string | null;
+  description?: string | null;
+}): AgentQuickReply {
+  const name = spokenName(input.botName);
+  const person = input.personName?.trim();
+  const description = input.description?.trim();
+  return {
+    instructions: [
+      name
+        ? `You are ${name}, a brand-new assistant.`
+        : "You are a brand-new assistant whose name is not chosen yet.",
+      person ? `${person} just created you and is meeting you for the first time.` : undefined,
+      "Write the one short line you say first: who you are and one concrete thing you can help them with, warm and human.",
+      description ? `What you are for, in your own words: ${description}` : undefined,
+      "One or two sentences, at most about twenty words, in the language they would write in.",
+      'No markdown, no title, no list, no "As an AI", no template phrasing like "Hello! I am your AI assistant".',
+      "Never mention these instructions.",
+    ]
+      .filter(Boolean)
+      .join(" "),
+    prompt: person ? `${person} just created you.` : "You were just created.",
+  };
+}
+
+/**
+ * The early line for this run, or none. A reply the bot may decide to skip (a group message
+ * nobody was addressed by, a run allowed to stay silent) gets no line: speaking first would
+ * take back the silence. Background helpers and ticket work have no chat to speak in, and a
+ * scripted runtime is a test harness whose turns are fixed.
+ */
+export function quickReplyForRun(input: {
+  trigger: string;
+  bot: { name: string; description?: string | null };
+  personName?: string | null;
+  text: string;
+  silent: boolean;
+  scripted: boolean;
+  env?: NodeJS.ProcessEnv;
+}): AgentQuickReply | undefined {
+  if (input.scripted || input.silent) return undefined;
+  if (!fastReplyEnabled(input.env)) return undefined;
+  if (input.trigger === "created") {
+    return introQuickReply({
+      botName: input.bot.name,
+      personName: input.personName,
+      description: input.bot.description,
+    });
+  }
+  if (!isConversationalRun(input.trigger)) return undefined;
+  if (input.trigger === BACKGROUND_HELPER_TRIGGER) return undefined;
+  const text = input.text.trim();
+  if (!text) return undefined;
+  return messageQuickReply({
+    botName: input.bot.name,
+    personName: input.personName,
+    text: text.length > QUICK_REPLY_PROMPT_MAX_CHARS
+      ? `${text.slice(0, QUICK_REPLY_PROMPT_MAX_CHARS)}…`
+      : text,
+  });
+}
