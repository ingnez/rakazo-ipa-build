+import { loadActivityMode } from "./activity-mode";
+import type { CollapsedSections } from "./collapsed-sections";
+import { loadCollapsedSections } from "./collapsed-sections";
+import { hasSignedInBefore } from "./returning-user";
+import type { SavedInbox } from "./saved-chats";
+import { loadSavedInbox } from "./saved-chats";
+import { currentSessionGeneration, loadSessionToken } from "./session";
+
+/**
+ * Everything the home screen needs before it can draw itself, read once per launch.
+ *
+ * These reads used to start only after the native splash was gone: the home screen mounted, drew an
+ * ActivityIndicator, and waited for the session token, the returning-user mark and the activity
+ * mode, and only then for the saved inbox — whose own read queued two Keychain entries before it
+ * could touch the disk. The person saw three waits in a row: the black logo, a spinner, and the
+ * chats (`IMG_2997`, and the report after `v31` that the home screen was no faster).
+ *
+ * The launch starts them beside the splash's own reads instead, one wave, so the splash waits for
+ * the slowest read rather than for the sum, and the first frame after it is the inbox itself. What
+ * one session read is never handed to another: a sign-in, a sign-out or a server switch during the
+ * read bumps the session generation, and `launchState` answers only for the generation it read.
+ */
+export type LaunchState = {
+  generation: number;
+  /** The saved session token; empty when signed out or when the store could not be read. */
+  token: string;
+  returningUser: boolean;
+  activityMode: boolean;
+  collapsed: CollapsedSections | null;
+  inbox: SavedInbox | null;
+};
+
+/** The launch's own server read; the Space it restores is what files the saved inbox. */
+let serverRead: Promise<unknown> = Promise.resolve();
+let warming: { generation: number; state: Promise<LaunchState> } | null = null;
+let settled: LaunchState | null = null;
+
+/**
+ * Starts this launch's read, or joins the one already running. `server` is the launch's server
+ * read (`loadApiBase`): it restores the Space this device was last on, and the saved inbox is filed
+ * under that Space, so the inbox waits for it rather than reading the wrong one or none.
+ */
+export function startLaunchWarmup(server?: Promise<unknown>): Promise<LaunchState> {
+  if (server) serverRead = server;
+  const generation = currentSessionGeneration();
+  if (warming?.generation === generation) return warming.state;
+  const token = loadSessionToken().catch(() => "");
+  const returningUser = hasSignedInBefore().catch(() => false);
+  const activityMode = loadActivityMode().catch(() => false);
+  const collapsed = loadCollapsedSections().catch(() => null);
+  const inbox = Promise.all([token, serverRead.catch(() => undefined)]).then(([value]) =>
+    value ? loadSavedInbox().catch(() => null) : null,
+  );
+  const state = Promise.all([token, returningUser, activityMode, collapsed, inbox]).then(
+    ([token, returningUser, activityMode, collapsed, inbox]) => {
+      const next: LaunchState = {
+        generation,
+        token,
+        returningUser,
+        activityMode,
+        collapsed,
+        inbox,
+      };
+      // A session change during the read owns what comes next; this seed belongs to the session
+      // that asked for it and must not be drawn for another.
+      if (generation === currentSessionGeneration()) settled = next;
+      return next;
+    },
+  );
+  warming = { generation, state };
+  return state;
+}
+
+/** What this launch already read, for a home screen drawing its first frame after the splash. */
+export function launchState(): LaunchState | null {
+  return settled?.generation === currentSessionGeneration() ? settled : null;
+}
