+++ b/apps/mobile/modules/rakazo-quick-look/ios/RakazoQuickLookModule.swift
@@ -0,0 +1,110 @@
+import ExpoModulesCore
+import QuickLook
+import UIKit
+
+/// Shows a file in the system's own document viewer (QuickLook), full screen, in place.
+///
+/// A message's document is something to read, not something to send somewhere else: the share
+/// sheet that used to open for every `.pdf`, `.docx` or `.pptx` asked the person to pick a
+/// destination before they could see a single line. QuickLook reads the file where it lies and
+/// brings the system's own close and share buttons, so viewing stays viewing.
+public class RakazoQuickLookModule: Module {
+  /// Held while the viewer is up: QuickLook's delegate is weak, so the module keeps it alive until
+  /// the person closes the document or the viewer is dismissed by a swipe.
+  private var delegate: PreviewDelegate?
+
+  public func definition() -> ModuleDefinition {
+    Name("RakazoQuickLook")
+
+    /// Opens the file full screen; resolves once the person closes the viewer.
+    AsyncFunction("open") { (url: URL, promise: Promise) in
+      // Presenting is a UIKit call and QuickLook's callbacks arrive on the main queue.
+      DispatchQueue.main.async {
+        guard FileManager.default.fileExists(atPath: url.path) else {
+          promise.reject("ERR_QUICK_LOOK_MISSING", "The file is no longer on disk.")
+          return
+        }
+        guard QLPreviewController.canPreview(url as NSURL) else {
+          // The caller keeps the share sheet as its fallback for what the system cannot read.
+          promise.reject("ERR_QUICK_LOOK_UNSUPPORTED", "The system cannot preview this file.")
+          return
+        }
+        guard let presenter = Self.presentingViewController() else {
+          promise.reject("ERR_QUICK_LOOK_NO_SCREEN", "There is no screen to open it on.")
+          return
+        }
+        // A second tap while the viewer is up must not stack another one on top of it.
+        if self.delegate != nil {
+          promise.resolve(nil)
+          return
+        }
+        let delegate = PreviewDelegate(url: url, promise: promise) { [weak self] in
+          self?.delegate = nil
+        }
+        self.delegate = delegate
+        let controller = QLPreviewController()
+        controller.dataSource = delegate
+        controller.delegate = delegate
+        controller.modalPresentationStyle = .fullScreen
+        presenter.present(controller, animated: true)
+      }
+    }
+  }
+
+  /// The controller a viewer can be presented from: the key window's, with any sheet already up
+  /// peeled off, so QuickLook never tries to present from a controller that is presenting.
+  private static func presentingViewController() -> UIViewController? {
+    let scene = UIApplication.shared.connectedScenes
+      .compactMap { $0 as? UIWindowScene }
+      .first { $0.activationState == .foregroundActive }
+      ?? UIApplication.shared.connectedScenes.compactMap { $0 as? UIWindowScene }.first
+    let root = scene?.windows.first { $0.isKeyWindow }?.rootViewController
+      ?? scene?.windows.first?.rootViewController
+    var top = root
+    while let presented = top?.presentedViewController, !presented.isBeingDismissed {
+      top = presented
+    }
+    // A controller that is itself being dismissed cannot present anything.
+    return top?.isBeingDismissed == true ? nil : top
+  }
+}
+
+/// QuickLook's data source and delegate for one file: it answers with that file, and settles the
+/// promise the module was called with when the viewer goes away.
+private final class PreviewDelegate: NSObject, QLPreviewControllerDataSource, QLPreviewControllerDelegate {
+  private let url: URL
+  private let promise: Promise
+  private let onClosed: () -> Void
+  private var settled = false
+
+  init(url: URL, promise: Promise, onClosed: @escaping () -> Void) {
+    self.url = url
+    self.promise = promise
+    self.onClosed = onClosed
+  }
+
+  func numberOfPreviewItems(in controller: QLPreviewController) -> Int {
+    1
+  }
+
+  func previewController(_ controller: QLPreviewController, previewItemAt index: Int) -> QLPreviewItem {
+    url as NSURL
+  }
+
+  func previewControllerDidDismiss(_ controller: QLPreviewController) {
+    settle()
+  }
+
+  func previewControllerWillDismiss(_ controller: QLPreviewController) {
+    // The viewer's own close button dismisses it too, and it can be swiped away; whichever comes
+    // first settles the call once.
+    settle()
+  }
+
+  private func settle() {
+    guard !settled else { return }
+    settled = true
+    promise.resolve(nil)
+    onClosed()
+  }
+}
