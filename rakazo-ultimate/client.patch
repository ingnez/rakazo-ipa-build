@@ -0,0 +1,84 @@
+/** The character that keeps a `**` from touching the punctuation beside it. */
+const ZWSP = "\u200B";
+
+/**
+ * CommonMark calls a character punctuation when it is ASCII punctuation or a Unicode `P*`.
+ * A symbol (`+`, `=`, `€`) is deliberately not one: it flanks like a letter.
+ */
+const PUNCTUATION = /[\p{P}]/u;
+const ASCII_PUNCTUATION = /[!-/:-@[-`{-~]/;
+
+function isPunctuation(character: string): boolean {
+  return ASCII_PUNCTUATION.test(character) || PUNCTUATION.test(character);
+}
+
+/**
+ * Opens up `**` that sits against punctuation, so the text it marks really is drawn bold.
+ *
+ * CommonMark only lets a `**` open when it is not followed by punctuation, and only lets it close
+ * when it is not preceded by one — unless the delimiter has white space or punctuation on its
+ * other side too. Chinese writes punctuation right against the words it follows, so a line like
+ * `是**"值"（…）**` has an opening run after a letter and before a quote: it can only close, and the
+ * two asterisks are drawn as asterisks. A zero-width space next to the run is not white space and
+ * not punctuation, so the run flanks like one that stands between words, and the text inside the
+ * stars is bold — invisible in the layout, which is the point.
+ *
+ * Fenced blocks and inline code spans are copied through untouched: a star there is a star.
+ */
+export function padTightEmphasis(source: string): string {
+  if (!source.includes("**")) return source;
+  let fence: "`" | "~" | null = null;
+  return source
+    .split("\n")
+    .map((line) => {
+      const opening = /^\s*(`{3,}|~{3,})/.exec(line)?.[1];
+      if (fence) {
+        // Inside a fence only the closing run of the same character ends it.
+        if (opening?.[0] === fence) fence = null;
+        return line;
+      }
+      if (opening) {
+        fence = opening[0] as "`" | "~";
+        return line;
+      }
+      return padLine(line);
+    })
+    .join("\n");
+}
+
+function padLine(line: string): string {
+  let result = "";
+  let index = 0;
+  while (index < line.length) {
+    const character = line[index]!;
+    if (character === "`") {
+      // An inline code span: a run of backticks up to the next run of the same length.
+      let length = 0;
+      while (line[index + length] === "`") length += 1;
+      const run = "`".repeat(length);
+      const close = line.indexOf(run, index + length);
+      if (close === -1) {
+        result += run;
+        index += length;
+        continue;
+      }
+      result += line.slice(index, close + length);
+      index = close + length;
+      continue;
+    }
+    if (character === "*" && line[index + 1] === "*") {
+      let length = 0;
+      while (line[index + length] === "*") length += 1;
+      const before = index > 0 ? line[index - 1]! : undefined;
+      const after = line[index + length];
+      if (before && isPunctuation(before)) result += ZWSP;
+      result += "*".repeat(length);
+      if (after && isPunctuation(after)) result += ZWSP;
+      index += length;
+      continue;
+    }
+    result += character;
+    index += 1;
+  }
+  return result;
+}
