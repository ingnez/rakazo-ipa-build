+        const dy = py / out;
+        const support = Math.hypot(lidAlong * (alongX * dx + alongY * dy), lidAcross * (acrossX * dx + acrossY * dy)) + radius;
+        // The eye's outermost ink, seen from the pair's own middle.
+        const ex = cx + dx * support;
+        const ey = cy + dy * support;
+        if (gazeSquared > 1e-9) {
+          const limit = edge(px + ex + gazeX * give, py + ey + gazeY * give);
+          const restX = pairX + ex;
+          const restY = pairY + ey;
+          const c = restX * restX + restY * restY - limit * limit;
+          const b = 2 * (restX * gazeX + restY * gazeY);
+          // Only an eye that starts on the body and would leave it as the face looks.
+          if (c <= 0 && b > 0) {
+            const root = b * b - 4 * gazeSquared * c;
+            if (root > 0)
+              next = Math.min(next, Math.max(0, (-b + Math.sqrt(root)) / (2 * gazeSquared)));
+          }
+        }
+        // A face drawn with a lid longer than its own (the reference's `surprised`, `calm`) can sit
+        // off the body before it looks anywhere: that is the only case where the pair itself moves,
+        // and then only as far in as it must to be back on the body.
+        const spoken = ex * ex + ey * ey - edge(px, py) ** 2;
+        if (spoken > 0) {
+          const near = 2 * (ex * pairX + ey * pairY);
+          const span = pairX * pairX + pairY * pairY;
+          const root = near * near - 4 * span * spoken;
+          if (span > 1e-9 && root > 0) {
+            // The nearer of the two places the pair has to shrink to: from outside it is the
+            // smaller root, the first one back on the body.
+            const solved = (-near - Math.sqrt(root)) / (2 * span);
+            if (solved > 0 && solved < 1) hold = Math.max(hold, solved);
+          }
+        }
+      }
+      if (next === give) break;
+      give = next;
+    }
+    if (hold > 0) {
+      originX = pairX * hold + (originX - pairX) * Math.min(give, hold);
+      originY = pairY * hold + (originY - pairY) * Math.min(give, hold);
+    } else if (give < 1) {
+      originX = pairX + (originX - pairX) * give;
+      originY = pairY + (originY - pairY) * give;
+    }
+  }
+  let d = "";
+  for (const side of [-1, 1]) {
+    const cx = originX + Math.cos(pairTilt) * half * side;
+    const cy = originY + Math.sin(pairTilt) * half * side;
+    d += babygrokEyeLoop(chosen, cx, cy, unit, tilt, opening * shorten, radius, squeeze);
+  }
+  return d;
+}
+
+/**
+ * One eye: a capsule at rest, bent into an arch as `mood` rises, as a path.
+ *
+ * It sits above `babygrokEyes`, the only thing that calls it, and that order is load-bearing:
+ * the worklet Babel plugin rewrites each `"worklet"` function declaration into a
+ * `var name = function nameFactory(...)(...)` call in the same place, which the plain function
+ * hoisting rule does not lift, so a helper declared below its caller is still `undefined` when
+ * the caller's closure array is built, and the first avatar drawn throws
+ * `TypeError: undefined is not a function`.
+ */
+function babygrokEyePath(
+  cx: number,
+  cy: number,
+  tilt: number,
+  length: number,
+  thickness: number,
+  mood: number,
+): string {
+  "worklet";
+  const bend = HAPPY_BEND * mood;
+  const ax = Math.cos(tilt);
+  const ay = Math.sin(tilt);
+  const point = (along: number, across: number) =>
+    `${round(cx + ax * along - ay * across)} ${round(cy + ay * along + ax * across)}`;
+  if (bend < 0.001) {
+    // A straight capsule: the stroke's own round caps finish it.
+    return `M${point(-length / 2, 0)}L${point(length / 2, 0)}`;
+  }
+  // An arc of the same length, its highest point where the eye's middle is, its ends
+  // hanging down: the arch of a pleased face. Two cubics draw it exactly enough.
+  const radius = length / bend;
+  const half = bend / 2;
+  const at = (angle: number) => ({
+    along: radius * Math.sin(angle),
+    across: radius * (1 - Math.cos(angle)),
+  });
+  // The tangent has to be the unit one: `control` below already carries the radius, so a tangent
+  // that carries it too scales the controls by `radius²`, and since the bend — and with it the
+  // radius — runs away as `mood` starts from nothing, the controls fly off the head entirely.
+  const tangent = (angle: number) => ({
+    along: Math.cos(angle),
+    across: Math.sin(angle),
+  });
+  // A circular arc is a cubic whose controls sit this far along its tangents.
+  const control = (4 / 3) * Math.tan(half / 4) * radius;
+  const start = at(-half);
+  const middle = at(0);
+  const end = at(half);
+  const startTangent = tangent(-half);
+  const middleTangent = tangent(0);
+  const endTangent = tangent(half);
+  // Each control point stands off its own end of the arc, along the way the stroke travels there:
+  // away from the start, and back from the middle and from the end.
+  const c1 = {
+    along: start.along + startTangent.along * control,
+    across: start.across + startTangent.across * control,
+  };
+  const c2 = {
+    along: middle.along - middleTangent.along * control,
+    across: middle.across - middleTangent.across * control,
+  };
+  const c3 = {
+    along: middle.along + middleTangent.along * control,
+    across: middle.across + middleTangent.across * control,
+  };
+  const c4 = {
+    along: end.along - endTangent.along * control,
+    across: end.across - endTangent.across * control,
+  };
+  return (
+    `M${point(start.along, start.across)}` +
+    `C${point(c1.along, c1.across)} ${point(c2.along, c2.across)} ${point(middle.along, middle.across)}` +
+    `C${point(c3.along, c3.across)} ${point(c4.along, c4.across)} ${point(end.along, end.across)}`
+  );
+}
+
+/** The two eyes' centre lines as one path, and the stroke that draws them. */
+export function babygrokEyes({
+  body,
+  morphFrom,
+  morphTo,
+  morph,
+  gazeX,
+  gazeY,
+  turn,
+  mood,
+  lid,
+}: {
+  /** The body whose eye pair is being worn (the one being morphed to). */
+  body: BabygrokBody;
+  /** The pair being left behind, or null when the body is settled. */
+  morphFrom: BabygrokBody | null;
+  morphTo: BabygrokBody;
+  /** How far the body has morphed, 0 (the old one) to 1 (the new one). */
+  morph: number;
+  /** Where the face is looking, in view units. */
+  gazeX: number;
+  gazeY: number;
+  /** How far the head is turned, -1 (left) to 1 (right). */
+  turn: number;
+  /** How pleased the face is, 0 (open eyes) to 1 (an arch). */
+  mood: number;
+  /** How open the eyes are, 1 open to 0 shut. */
+  lid: number;
+}): { d: string; width: number } {
+  "worklet";
+  const from = morphFrom?.eyes ?? morphTo.eyes;
+  const to = morphTo.eyes;
+  const eye = (index: number) =>
+    from[index]! + (to[index]! - from[index]!) * (morphFrom ? morph : 1);
+  const pairX = eye(0);
+  const pairY = eye(1);
+  const gap = eye(2) * (1 + HAPPY_WIDEN * mood) * (1 - TURN_CLOSE * Math.abs(turn));
+  const length = eye(3) * (1 - HAPPY_SHORTEN * mood);
+  // A pleased eye's stroke is thinner than the capsule it opens from: the arch has to keep a
+  // notch under it, or it reads as a dome (see `HAPPY_THIN`).
+  const thickness = eye(4) * (1 - HAPPY_THIN * mood);
+  // The open eye is a capsule standing nearly upright on the face; a pleased one is an arch lying
+  // level on it, hump up, as the reference draws it. Bent about the capsule's own axis the arch
+  // would stand on its side, so the shape swings out of that lean as `mood` rises, and arrives
+  // level at 1 without the straight eye ever jumping.
+  const archTilt = (eye(5) * (1 - mood) * Math.PI) / 180;
+  // The pair the body authored leans with the face, but a pleased pair sits level, as the
+  // reference's does; a turned head still leans it.
+  const pairTilt = ((eye(6) * (1 - mood) + TURN_LEAN * turn) * Math.PI) / 180;
+  // The pair moves where the face looks, but no further than its own body allows.
+  const reach = babygrokGazeReach(body.budget, gazeX, gazeY);
+  const distance = Math.hypot(gazeX, gazeY);
+  const scale = distance > reach && distance > 0 ? reach / distance : 1;
+  const originX = pairX + gazeX * scale;
+  const originY = pairY + gazeY * scale - length * HAPPY_LIFT * mood;
+  const half = gap / 2;
+  let d = "";
+  for (const side of [-1, 1]) {
+    const cx = originX + Math.cos(pairTilt) * half * side;
+    const cy = originY + Math.sin(pairTilt) * half * side;
+    d += babygrokEyePath(cx, cy, archTilt, length, thickness, mood);
+  }
+  return { d, width: Math.max(thickness * Math.max(lid, LID_KEEP), 0.4) };
+}
