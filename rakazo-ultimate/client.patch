diff --git a/apps/mobile/lib/ui-sounds.ts b/apps/mobile/lib/ui-sounds.ts
new file mode 100644
index 000000000..1122b9191
--- /dev/null
+++ b/apps/mobile/lib/ui-sounds.ts
@@ -0,0 +1,61 @@
+import type { AudioPlayer } from "expo-audio";
+import * as SecureStore from "expo-secure-store";
+
+/** The five short interface sounds, each bound to the moment it marks. */
+export const UI_SOUNDS = {
+  /** A pool opens: new chat, attach menu, a screen sliding in. */
+  open: require("../assets/sounds/grok/ping_1_open_blip.wav"),
+  /** A control is pressed. */
+  tap: require("../assets/sounds/grok/ping_2_tick.wav"),
+  /** Two ticks, for a choice that changes state (pin, mute, main bot). */
+  toggle: require("../assets/sounds/grok/ping_3_double_tick.wav"),
+  /** A message leaves the composer. */
+  sent: require("../assets/sounds/grok/ping_4_chime_a.wav"),
+  /** A reply arrives while the chat is open. */
+  arrive: require("../assets/sounds/grok/ping_5_chime_b.wav"),
+} as const;
+
+export type UiSound = keyof typeof UI_SOUNDS;
+
+export const UI_SOUNDS_KEY = "rakazo.ui-sounds";
+
+let enabled: boolean | null = null;
+let players: Map<UiSound, AudioPlayer> | null = null;
+
+export async function loadUiSoundsEnabled(): Promise<boolean> {
+  if (enabled !== null) return enabled;
+  enabled = (await SecureStore.getItemAsync(UI_SOUNDS_KEY).catch(() => null)) !== "0";
+  return enabled;
+}
+
+export async function saveUiSoundsEnabled(on: boolean): Promise<void> {
+  enabled = on;
+  if (on) await SecureStore.deleteItemAsync(UI_SOUNDS_KEY).catch(() => undefined);
+  else await SecureStore.setItemAsync(UI_SOUNDS_KEY, "0").catch(() => undefined);
+}
+
+/**
+ * Plays one of the interface sounds. It rides on the shared audio session without taking it, so a
+ * call or a dictation in progress keeps its microphone, and a sound that cannot play is silent
+ * rather than an error the caller has to handle.
+ */
+export function playUiSound(sound: UiSound): void {
+  void (async () => {
+    if (!(await loadUiSoundsEnabled())) return;
+    try {
+      players ??= new Map();
+      let player = players.get(sound);
+      if (!player) {
+        const { createAudioPlayer } = await import("expo-audio");
+        player = createAudioPlayer(UI_SOUNDS[sound], {
+          keepAudioSessionActive: false,
+        });
+        players.set(sound, player);
+      }
+      await player.seekTo(0);
+      player.play();
+    } catch {
+      // A sound is decoration: a missing player or a busy audio session stays quiet.
+    }
+  })();
+}
