@@ -0,0 +1,330 @@
+import { describe, expect, it } from "vitest";
+import {
+  babygrokBodyPath,
+  babygrokEyeLoops,
+  babygrokEyes,
+  babygrokGazeReach,
+  HAPPY_BEND,
+} from "./babygrok-face.js";
+import {
+  BABYGROK_BODIES,
+  BABYGROK_BODY_KEYS,
+  BABYGROK_VERTICES,
+  BABYGROK_VIEWBOX,
+} from "./babygrok-geometry.js";
+import { SHIPPED_BOT_AVATAR_SHAPE_KEYS } from "./bot-avatar-shapes.js";
+import { MOTION_FACES } from "./bot-motion-clips-data.js";
+
+const bodies = BABYGROK_BODY_KEYS.map((key) => BABYGROK_BODIES[key]!);
+const hex = BABYGROK_BODIES.hex!;
+const tablet = BABYGROK_BODIES.tablet!;
+
+/** Whether a point lies inside a body's ring. */
+function onBody(ring: readonly number[], [x, y]: [number, number]): boolean {
+  let odd = false;
+  for (let index = 0; index < ring.length; index += 2) {
+    const next = (index + 2) % ring.length;
+    const [x0, y0, x1, y1] = [ring[index]!, ring[index + 1]!, ring[next]!, ring[next + 1]!];
+    if (y0 > y !== y1 > y) {
+      if (x < x0 + ((y - y0) * (x1 - x0)) / (y1 - y0)) odd = !odd;
+    }
+  }
+  return odd;
+}
+
+/** Every x,y pair in a path body, as numbers. */
+function points(path: string): Array<[number, number]> {
+  return path
+    .slice(1, -1)
+    .split("L")
+    .map((pair) => pair.split(" ").map(Number) as [number, number]);
+}
+
+describe("BabyGrok's bodies", () => {
+  it("keeps a body for every shape the picker offers, in its own order", () => {
+    expect(BABYGROK_BODY_KEYS).toEqual([...SHIPPED_BOT_AVATAR_SHAPE_KEYS]);
+  });
+
+  it("gives every body the same 64 vertices, so any two can morph into each other", () => {
+    for (const [index, body] of bodies.entries()) {
+      expect(body.ring, BABYGROK_BODY_KEYS[index]).toHaveLength(BABYGROK_VERTICES * 2);
+      expect(body.ring.every(Number.isFinite)).toBe(true);
+      expect(body.budget, BABYGROK_BODY_KEYS[index]).toHaveLength(BABYGROK_VERTICES);
+    }
+  });
+
+  it("draws every body inside its own box, filling it", () => {
+    const [, , width, height] = BABYGROK_VIEWBOX.split(" ").map(Number) as [
+      number,
+      number,
+      number,
+      number,
+    ];
+    for (const [index, body] of bodies.entries()) {
+      const radii = Array.from({ length: BABYGROK_VERTICES }, (_, vertex) =>
+        Math.hypot(body.ring[vertex * 2]!, body.ring[vertex * 2 + 1]!),
+      );
+      expect(Math.max(...radii), BABYGROK_BODY_KEYS[index]).toBeLessThanOrEqual(width / 2 + 0.1);
+      // Every body reaches the box, which is what makes them read at the same weight.
+      expect(Math.max(...radii), BABYGROK_BODY_KEYS[index]).toBeGreaterThan(width / 2 - 1);
+      expect(Math.max(...radii), BABYGROK_BODY_KEYS[index]).toBeLessThanOrEqual(height / 1.99);
+    }
+  });
+
+  it("keeps its eyes on its own body, and leaves them somewhere to look", () => {
+    for (const [index, body] of bodies.entries()) {
+      const [cx, cy, gap, length, thickness] = body.eyes;
+      // Both eyes lie on the body itself, ends and all, as the reference art draws them.
+      const rest = babygrokEyes({
+        body,
+        morphFrom: null,
+        morphTo: body,
+        morph: 1,
+        gazeX: 0,
+        gazeY: 0,
+        turn: 0,
+        mood: 0,
+        lid: 1,
+      });
+      for (const eye of rest.d.slice(1).split("M")) {
+        for (const pair of eye.split("L")) {
+          const [x, y] = pair.split(" ").map(Number) as [number, number];
+          expect(onBody(body.ring, [x, y]), BABYGROK_BODY_KEYS[index]).toBe(true);
+        }
+      }
+      // The face is drawn toward the upper right of every body, as the reference art has it.
+      expect(cx, BABYGROK_BODY_KEYS[index]).toBeGreaterThan(0);
+      expect(cy, BABYGROK_BODY_KEYS[index]).toBeLessThanOrEqual(0);
+      expect(Math.max(...body.budget), BABYGROK_BODY_KEYS[index]).toBeGreaterThan(0);
+    }
+  });
+});
+
+describe("a body morphing into another", () => {
+  it("draws the old body at 0, the new one at 1, and a mix in between", () => {
+    expect(babygrokBodyPath(hex.ring, tablet.ring, 0)).toBe(babygrokBodyPath(hex.ring, hex.ring, 1));
+    const start = points(babygrokBodyPath(hex.ring, tablet.ring, 0));
+    const end = points(babygrokBodyPath(hex.ring, tablet.ring, 1));
+    const middle = points(babygrokBodyPath(hex.ring, tablet.ring, 0.5));
+    expect(middle).toHaveLength(BABYGROK_VERTICES);
+    start.forEach(([x, y], index) => {
+      const [midX, midY] = middle[index]!;
+      expect(midX).toBeCloseTo((x + end[index]![0]) / 2, 1);
+      expect(midY).toBeCloseTo((y + end[index]![1]) / 2, 1);
+    });
+  });
+
+  it("follows the spring past the new body, which is what makes it jelly", () => {
+    const overshoot = points(babygrokBodyPath(hex.ring, tablet.ring, 1.12));
+    const end = points(babygrokBodyPath(hex.ring, tablet.ring, 1));
+    expect(overshoot).toHaveLength(BABYGROK_VERTICES);
+    expect(overshoot.every(([x, y]) => Number.isFinite(x) && Number.isFinite(y))).toBe(true);
+    expect(overshoot).not.toEqual(end);
+  });
+});
+
+describe("the face", () => {
+  const face = (mood: number, gazeX = 0, gazeY = 0) =>
+    babygrokEyes({
+      body: hex,
+      morphFrom: null,
+      morphTo: hex,
+      morph: 1,
+      gazeX,
+      gazeY,
+      turn: 0,
+      mood,
+      lid: 1,
+    });
+
+  it("draws two eyes as one stroked line, as thick as the body's own", () => {
+    const eyes = face(0);
+    expect(eyes.d.match(/M/g)).toHaveLength(2);
+    expect(eyes.width).toBeCloseTo(hex.eyes[4], 1);
+  });
+
+  it("bends the eyes into an arch when the bot is pleased", () => {
+    const open = face(0);
+    const pleased = face(1);
+    // Open eyes are straight capsules; a pleased face bends both into curves.
+    expect(open.d).not.toContain("C");
+    expect(pleased.d.match(/C/g)).toHaveLength(4);
+    expect(pleased.d).not.toBe(open.d);
+  });
+
+  it("keeps every number it draws inside the body's box, at every mood", () => {
+    // The arch's controls were once scaled by the radius twice over, which threw them clear off
+    // the head as soon as `mood` left zero; a number outside the box is that bug come back.
+    for (const [index, body] of bodies.entries()) {
+      for (const mood of [0.001, 0.01, 0.05, 0.3, 0.6, 1]) {
+        const eyes = babygrokEyes({
+          body,
+          morphFrom: null,
+          morphTo: body,
+          morph: 1,
+          gazeX: 0,
+          gazeY: 0,
+          turn: 0,
+          mood,
+          lid: 1,
+        });
+        for (const value of eyes.d.match(/-?\d+\.?\d*/g) ?? []) {
+          expect(Math.abs(Number(value)), `${BABYGROK_BODY_KEYS[index]} at mood ${mood}`).toBeLessThan(
+            100,
+          );
+        }
+      }
+    }
+  });
+
+  it("draws a pleased eye as a level arch with its hump up, as the reference does", () => {
+    const arches = face(1).d.slice(1).split("M");
+    expect(arches).toHaveLength(2);
+    for (const arch of arches) {
+      const numbers = (arch.match(/-?\d+\.?\d*/g) ?? []).map(Number);
+      const [startX, startY] = [numbers[0]!, numbers[1]!];
+      const [middleX, middleY] = [numbers[6]!, numbers[7]!];
+      const [endX, endY] = [numbers[12]!, numbers[13]!];
+      // Both feet on one level and the hump above it, which is the reference's `︵`.
+      expect(startY).toBeCloseTo(endY, 1);
+      expect(middleY).toBeLessThan(startY - hex.eyes[4] / 4);
+      expect(middleX).toBeCloseTo((startX + endX) / 2, 1);
+      // An arc of the shortened eye's length: its chord is two radii across the bend.
+      const radius = (hex.eyes[3] * 0.7) / HAPPY_BEND;
+      expect(endX - startX).toBeCloseTo(2 * radius * Math.sin(HAPPY_BEND / 2), 0);
+    }
+    // The pair keeps a gap of skin between the two arches: with the full-length arcs the feet met
+    // in the middle and the face read as one `m`.
+    const [left, right] = arches.map((arch) => (arch.match(/-?\d+\.?\d*/g) ?? []).map(Number));
+    const leftEnd = left![12]!;
+    const rightStart = right![0]!;
+    expect(rightStart - leftEnd).toBeGreaterThan(hex.eyes[4] * 0.4);
+  });
+
+  it("thins a pleased eye's stroke into a crescent, instead of a bun with no notch under it", () => {
+    const pleased = face(1);
+    const radius = (hex.eyes[3] * 0.7) / HAPPY_BEND;
+    // The stroke is a shape, not the whole dome: an arch at the open eye's thickness left the
+    // inner radius at about a unit, and the eye read as a solid half-round bun.
+    expect(pleased.width / radius).toBeLessThan(1.1);
+    expect(radius - pleased.width / 2).toBeGreaterThan(radius * 0.4);
+    // It is still a stroke: the arch never thins to a hairline while the eye is open.
+    expect(pleased.width).toBeGreaterThan(hex.eyes[4] * 0.5);
+    // The bow is an arch, not a dome: no more than two thirds of a turn.
+    expect(HAPPY_BEND).toBeLessThan((Math.PI * 2) / 3);
+  });
+
+  it("closes the eyes with the lid, keeping a hairline", () => {
+    const shut = babygrokEyes({
+      body: hex,
+      morphFrom: null,
+      morphTo: hex,
+      morph: 1,
+      gazeX: 0,
+      gazeY: 0,
+      turn: 0,
+      mood: 0,
+      lid: 0,
+    });
+    expect(shut.width).toBeGreaterThan(0);
+    expect(shut.width).toBeLessThan(hex.eyes[4] / 4);
+  });
+
+  it("keeps the eyes on the body however far the face looks", () => {
+    for (const [index, body] of bodies.entries()) {
+      const reach = babygrokGazeReach(body.budget, 400, 400);
+      const eyes = babygrokEyes({
+        body,
+        morphFrom: null,
+        morphTo: body,
+        morph: 1,
+        // Far past anything a clip asks for.
+        gazeX: 400,
+        gazeY: 400,
+        turn: 1,
+        mood: 0,
+        lid: 1,
+      });
+      const [first] = eyes.d.slice(1).split("M");
+      const [x, y] = first!.split("L")[0]!.split(" ").map(Number) as [number, number];
+      expect(reach, BABYGROK_BODY_KEYS[index]).toBeLessThanOrEqual(100);
+      expect(Math.hypot(x, y), BABYGROK_BODY_KEYS[index]).toBeLessThan(110);
+    }
+  });
+});
+
+describe("the cut-out face", () => {
+  const spec = (face: string) => {
+    const raw = MOTION_FACES[face]!;
+    return {
+      p0: raw.p0 as [number, number],
+      p1: raw.p1 as [number, number],
+      p2: raw.p2 as [number, number],
+      isArc: raw.isArc,
+    };
+  };
+  const loops = (face: string, lid = 1, mood = 0) =>
+    babygrokEyeLoops({
+      body: hex,
+      morphFrom: null,
+      morphTo: hex,
+      morph: 1,
+      gazeX: 0,
+      gazeY: 0,
+      turn: 0,
+      lid,
+      spec: spec(face),
+      mood,
+    });
+
+  it("draws both eyes as two closed loops", () => {
+    const d = loops("neutral");
+    expect(d.match(/M/g)).toHaveLength(2);
+    expect(d.match(/Z/g)).toHaveLength(2);
+    // Each loop is four quadratics: two sides and two caps.
+    expect(d.match(/Q/g)).toHaveLength(8);
+  });
+
+  it("carries the reference's nine lid curves", () => {
+    const shapes = new Set(
+      Object.keys(MOTION_FACES).map((face) => loops(face).replace(/-?\d+\.?\d*/g, "#")),
+    );
+    // Nine canonical faces, and every one of them is a shape of its own.
+    expect(Object.keys(MOTION_FACES)).toHaveLength(9);
+    expect(shapes.size).toBe(9);
+  });
+
+  it("keeps every eye inside the body's box on every face", () => {
+    for (const face of Object.keys(MOTION_FACES)) {
+      for (const value of loops(face).match(/-?\d+\.?\d*/g) ?? []) {
+        expect(Math.abs(Number(value)), face).toBeLessThan(100);
+      }
+    }
+  });
+
+  it("shuts both eyes about their own middle as the lid closes", () => {
+    const open = loops("neutral");
+    const shut = loops("neutral", 0);
+    expect(shut).not.toBe(open);
+    // A shut eye is a thin slot: its numbers stay on the same pair of rows.
