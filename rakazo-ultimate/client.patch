+
+  it("calls a call that answered a finished call a voice call", () => {
+    expect(usageTags(call({ trigger: "call_end" }))).toEqual([{ key: "voice", tone: "neutral" }]);
+  });
+
+  it("names a compaction as one, whatever started it", () => {
