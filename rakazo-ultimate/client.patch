+  ScenarioSlotUpdate,
+  ScenarioSlotView,
+} from "@rakazo/contracts";
+import { rpc } from "./api";
+
+/**
+ * The six scenes and the model each one runs, as the server holds them: 日常帮助 is the server's
+ * `main` role and the other five are its own rows, so the app only reads and writes them here and
+ * the server picks a scene per message. Nothing is kept on the device: two phones signed in to the
+ * same account see the same six choices.
+ */
+let view: ScenarioModelsView | null = null;
+let inflight: Promise<ScenarioModelsView | null> | null = null;
+const listeners = new Set<() => void>();
+
+function publish(next: ScenarioModelsView | null): void {
+  view = next;
+  for (const listener of listeners) listener();
+}
+
+export function getScenarioView(): ScenarioModelsView | null {
+  return view;
+}
+
+export function subscribeScenarios(listener: () => void): () => void {
+  listeners.add(listener);
+  return () => {
+    listeners.delete(listener);
+  };
+}
+
+/** One scene out of a loaded view, or null before the first read. */
+export function scenarioSlotView(
+  current: ScenarioModelsView | null,
+  slot: ScenarioSlot,
+): ScenarioSlotView | null {
+  // A response without the slots list is no scenes rather than a crash.
+  return current?.slots?.find((entry) => entry.slot === slot) ?? null;
+}
+
+/** Reads the six scenes once; `force` reads them again after a save from elsewhere. */
+export async function loadScenarios(force = false): Promise<ScenarioModelsView | null> {
+  if (!force && view) return view;
+  if (!inflight) {
+    inflight = rpc("models/scenarios", {})
+      .then((next) => {
+        publish(next);
+        return view;
+      })
+      .catch(() => view)
+      .finally(() => {
+        inflight = null;
+      });
+  }
+  return inflight;
+}
+
+/** Writes one scene and keeps the loaded view in step with the answer. */
+export async function setScenario(update: ScenarioSlotUpdate): Promise<ScenarioSlotView> {
+  const saved = await rpc("models/setScenario", update);
+  if (view) {
+    publish({
+      slots: view.slots.map((entry) => (entry.slot === saved.slot ? saved : entry)),
+    });
+  }
+  return saved;
+}
+
+/** A scene worth an effort control: pictures and video have nothing to think about. */
+export function scenarioHasThinking(slot: ScenarioSlot): boolean {
+  return slot === "fast" || slot === "code" || slot === "heavy";
+}
+
+/** Signing out or switching server drops what the last session read. */
+export function clearScenarioView(): void {
+  publish(null);
+}
