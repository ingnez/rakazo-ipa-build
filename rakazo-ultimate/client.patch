+/**
+ * The four tiles every page of the app is built from, and the numbers they share.
+ *
+ * `SandPage` is the paper and its header row; `SandSheetPage` is the same page presented over
+ * another one; `InsetGroup` is the rounded card a settings page is a stack of; `CardChrome` is a
+ * card that carries content and the actions that belong to it. A new screen composes these
+ * instead of writing its own paddings, radius and press feel.
+ */
+export { CardChrome, CardRow, CardStat, type CardChromeAction } from "./card-chrome";
+export { InsetGroup, InsetGroupFooter, InsetGroupLabel, InsetRow } from "./inset-group";
+export {
+  ACTION_MIN_HEIGHT,
+  CARD_HIT_SLOP,
+  GRABBER_BOTTOM_INSET,
+  GRABBER_HEIGHT,
+  GRABBER_WIDTH,
+  GROUP_GAP,
+  PRESS_IN_MS,
+  PRESS_SCALE,
+  RELEASE_SPRING,
+  ROW_LEADING_INSET,
+  ROW_MIN_HEIGHT,
+  ROW_TRAILING_INSET,
+  SAND_RADIUS,
+  SHEET_CONTENT_PADDING,
+  SHEET_DETENT,
+  SHEET_FADE_MS,
+} from "./metrics";
+export { SandPage, type SandPageAction } from "./sand-page";
+export { SandSheetPage, SheetGrabber } from "./sand-sheet-page";
