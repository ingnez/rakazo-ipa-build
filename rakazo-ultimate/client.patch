+    state.remove.mockClear();
+    receiveIos(["b.png"]);
+    vi.advanceTimersByTime(5 * 60 * 1000);
+    expect(state.remove).toHaveBeenCalledWith(`${GROUP}b.png`);
+  });
+  it("deletes an expired share's copies when it is taken late", () => {
+    receiveIos(["a.png"]);
+    vi.setSystemTime(Date.now() + 5 * 60 * 1000);
