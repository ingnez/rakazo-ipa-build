+
+describe("settleStackWhenNeeded", () => {
+  it("asks only when This computer is first needed, once, and uses the answer", async () => {
+    let asked = 0;
+    const used: string[] = [];
+    const settle = settleStackWhenNeeded(
+      "ask",
+      async () => {
+        asked += 1;
+        return "native";
+      },
+      async (choice) => {
+        used.push(choice);
+      },
+    );
+    expect(asked).toBe(0);
