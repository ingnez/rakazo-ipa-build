+  message?: string | null;
+  avatar: ReactElement;
+};
+
+/** One line of a row's menu; a line with children opens them in a submenu of its own. */
+export type NativeRowMenuItem = {
+  id: string;
+  title: string;
+  image?: ButtonProps["systemImage"];
+  destructive?: boolean;
+  disabled?: boolean;
+  /** A rule above this line, so the lines around it read as separate groups. */
+  dividerBefore?: boolean;
+  /** The lines a hold on this one opens, with a chevron to say so. */
+  children?: NativeRowMenuItem[];
+};
 
 /** A row's long-press menu; titles are already translated. */
 export type NativeRowMenu = {
-  actions: Array<{
-    id: string;
-    title: string;
-    image?: ButtonProps["systemImage"];
-    destructive?: boolean;
-    disabled?: boolean;
-  }>;
+  actions: NativeRowMenuItem[];
   onAction: (id: string) => void;
+  /** What the hold lifts above the row, instead of the row's whole content. */
+  preview?: NativeRowPreview;
 };
 
 /** Native list rows are iOS only; elsewhere a row is its content. */
diff --git a/apps/mobile/components/native/glass-icon-button.tsx b/apps/mobile/components/native/glass-icon-button.tsx
new file mode 100644
index 000000000..a797e492d
--- /dev/null
+++ b/apps/mobile/components/native/glass-icon-button.tsx
@@ -0,0 +1,81 @@
+import type { ComponentProps } from "react";
+import type { ColorValue, StyleProp, ViewStyle } from "react-native";
+import { Platform, Pressable } from "react-native";
+import { androidRipple, withAlpha } from "../../lib/appearance/ripple";
+import { useMobileTokens } from "../../lib/native/native";
+import { iosAtLeast } from "../../lib/native/native-controls";
+import { GlassSurface } from "./glass-surface";
+import { NativeSymbol } from "./native-symbol";
+
+/**
+ * Round icon button on Liquid Glass (iOS 26); `fallbackStyle` draws it elsewhere. The icon
+ * defaults to full contrast on glass and muted on the flat fallback; a selected toggle fills
+ * with the primary token.
+ */
+export function GlassIconButton({
+  testID,
+  accessibilityLabel,
+  onPress,
+  ios,
+  android,
+  size = 40,
+  iconSize = 17,
+  color,
+  tint,
+  selected,
+  disabled,
+  fallbackStyle,
+}: {
+  testID?: string;
+  accessibilityLabel: string;
+  onPress: () => void;
+  ios: string;
+  android: ComponentProps<typeof NativeSymbol>["android"];
+  size?: number;
+  iconSize?: number;
+  color?: ColorValue;
+  tint?: string;
+  selected?: boolean;
+  disabled?: boolean;
+  fallbackStyle?: StyleProp<ViewStyle>;
+}) {
+  const tokens = useMobileTokens();
+  const iconColor = selected
+    ? tokens.primaryForeground
+    : (color ?? (iosAtLeast(26) ? tokens.foreground : tokens.mutedForeground));
+  return (
+    <GlassSurface
+      shape="circle"
+      tint={selected ? tokens.primary : tint}
+      style={{ width: size, height: size }}
+      fallbackStyle={[
+        { borderRadius: size / 2 },
+        fallbackStyle,
+        selected && { backgroundColor: tokens.primary },
+      ]}
+    >
+      <Pressable
+        testID={testID}
+        accessibilityRole="button"
+        accessibilityLabel={accessibilityLabel}
+        accessibilityState={
+          selected === undefined && disabled === undefined ? undefined : { selected, disabled }
+        }
+        disabled={disabled}
+        // A small button still gets the 44-point tap target platforms recommend.
+        hitSlop={Math.max(4, (44 - size) / 2)}
+        android_ripple={androidRipple(withAlpha(iconColor, 0.14))}
+        onPress={onPress}
+        style={({ pressed }) => ({
+          flex: 1,
+          alignItems: "center",
+          justifyContent: "center",
+          ...(Platform.OS === "android" ? { borderRadius: size / 2, overflow: "hidden" } : null),
+          opacity: disabled ? 0.45 : pressed && Platform.OS !== "android" ? 0.6 : 1,
+        })}
+      >
+        <NativeSymbol ios={ios} android={android} size={iconSize} color={iconColor} />
+      </Pressable>
+    </GlassSurface>
+  );
+}
