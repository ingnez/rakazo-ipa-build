+enum RakazoOfficeThumbnail {
+  /// One call, one answer: a thumbnail that arrives after its card gave up must not answer twice.
+  private final class Race {
+    private let lock = NSLock()
+    private var open = true
+
+    func claim() -> Bool {
+      lock.lock()
+      defer { lock.unlock() }
+      guard open else { return false }
+      open = false
+      return true
+    }
+  }
+
+  static func make(uri: String, maxWidth: Double, promise: Promise) {
+    guard let url = URL(string: uri), url.isFileURL else {
+      figure("not a local file", uri)
