@@ -0,0 +1,216 @@
+import type { FrontDeskTask } from "@rakazo/contracts";
+import { describe, expect, it } from "vitest";
+import { activityStep } from "./activity-label";
+import {
+  frontDeskActivity,
+  frontDeskStep,
+  ledgerElapsed,
+  ledgerModelLabel,
+  ledgerSummary,
+  ledgerTasks,
+} from "./ledger-tasks";
+import type { MobileMessage } from "./mobile-types";
+
+function deskTask(overrides: Partial<FrontDeskTask>): FrontDeskTask {
+  return {
+    id: "task-1",
+    runId: "run-1",
+    title: "整理积分表",
+    status: "running",
+    slot: "daily",
+    modelProvider: "magic",
+    modelId: "gemini-3-flash",
+    progress: null,
+    steps: [],
+    currentStep: null,
+    elapsedMs: 1_000,
+    createdAt: "2026-11-17T04:00:00.000Z",
+    updatedAt: "2026-11-17T04:00:10.000Z",
+    completedAt: null,
+    ...overrides,
+  };
+}
+
+function card(overrides: {
+  id?: string;
+  botId?: string;
+  createdAt?: string;
+  agentId?: string;
+  name?: string;
+  task?: string;
+  progress?: string;
+  status?: "running" | "completed" | "failed";
+}): MobileMessage {
+  return {
+    id: overrides.id ?? "m1",
+    role: "bot",
+    botId: overrides.botId ?? "bot-1",
+    createdAt: overrides.createdAt ?? "2026-11-16T12:00:00.000Z",
+    blocks: [
+      {
+        kind: "subagent",
+        agentId: overrides.agentId ?? "agent-1",
+        name: overrides.name ?? "读一下仓库",
+        task: overrides.task ?? "把仓库读完",
+        status: overrides.status ?? "running",
+        ...(overrides.progress ? { progress: overrides.progress } : {}),
+      },
+    ],
+  } as unknown as MobileMessage;
+}
+
+describe("ledgerTasks", () => {
+  it("lists only work still running, oldest card first", () => {
+    const tasks = ledgerTasks(
+      [
+        card({ id: "m1", agentId: "a1", name: "第一路" }),
+        card({ id: "m2", agentId: "a2", name: "第二路" }),
+        card({ id: "m3", agentId: "a3", name: "已经做完", status: "completed" }),
+      ],
+      undefined,
+    );
+    expect(tasks.map((task) => task.title)).toEqual(["第一路", "第二路"]);
+  });
+
+  it("names the step the card reports, and falls back to what it was asked to do", () => {
+    const withProgress = ledgerTasks([card({ progress: "using Shell" })], undefined);
+    expect(withProgress[0]?.step).toBe("using Shell");
+    const without = ledgerTasks([card({ agentId: "a9", task: "  整理排班表  " })], undefined);
+    expect(without[0]?.step).toBe("整理排班表");
+  });
+
+  it("carries the model of the run behind the card when this chat can see that run", () => {
+    const tasks = ledgerTasks([card({ agentId: "run-1" })], [
+      { id: "run-1", status: "running", modelProvider: "magic", modelId: "google/gemini-3-flash" },
+    ] as never);
+    expect(tasks[0]?.model).toBe("magic · gemini-3-flash");
+  });
+
+  it("leaves the model out rather than guessing when no run matches the card", () => {
+    const tasks = ledgerTasks([card({ agentId: "front-desk-task" })], [
+      { id: "run-1", status: "running", modelProvider: "magic", modelId: "x" },
+    ] as never);
+    expect(tasks[0]?.model).toBeUndefined();
+  });
+
+  it("offers Stop only where stopping the card is what the server expects", () => {
+    const saved = ledgerTasks([card({ id: "m1", botId: "bot-1" })], undefined);
+    expect(saved[0]?.stop).toEqual({ botId: "bot-1", messageId: "m1" });
+    // A live card belongs to the turn writing it; there is nothing to stop by message id.
+    const live = ledgerTasks([card({ id: "subagent:xyz" })], undefined);
+    expect(live[0]?.stop).toBeUndefined();
+  });
+
+  it("keeps one row per agent even when the live and saved cards briefly coexist", () => {
+    const tasks = ledgerTasks(
+      [card({ id: "subagent:xyz", agentId: "agent-1" }), card({ id: "m2", agentId: "agent-1" })],
+      undefined,
+    );
+    expect(tasks).toHaveLength(1);
+  });
+
+  it("has nothing to say for a chat with no messages", () => {
+    expect(ledgerTasks(undefined, undefined)).toEqual([]);
+    expect(ledgerTasks([], undefined)).toEqual([]);
+  });
+});
+
+describe("frontDeskActivity", () => {
+  it("keeps the chat's line alive on work the back office still has", () => {
+    const activity = frontDeskActivity([
+      deskTask({ id: "done", status: "completed", currentStep: "做好了。" }),
+      deskTask({ id: "live", currentStep: "Reading the schedule" }),
+    ]);
+    expect(activity).toEqual({ working: true, line: "Reading the schedule" });
+  });
+
+  it("takes the newest running task's step, so the line follows the work in hand", () => {
+    const activity = frontDeskActivity([
+      deskTask({ id: "older", currentStep: "Reading the schedule" }),
+      deskTask({ id: "newer", currentStep: "Running: npm test" }),
+    ]);
+    expect(activity.line).toBe("Running: npm test");
+  });
+
+  it("falls back to the task's own progress line, then to nothing", () => {
+    expect(frontDeskActivity([deskTask({ progress: "  使用 Web Search " })]).line).toBe(
+      "使用 Web Search",
+    );
+    // Work in hand that has not said what it is doing still keeps the line on screen.
+    expect(frontDeskActivity([deskTask({ currentStep: "   ", progress: null })])).toEqual({
+      working: true,
+      line: undefined,
+    });
+  });
+
+  it("says nothing when every task has settled or the server publishes none", () => {
+    expect(frontDeskActivity(undefined)).toEqual({ working: false, line: undefined });
+    expect(frontDeskActivity([])).toEqual({ working: false, line: undefined });
+    expect(
+      frontDeskActivity([
+        deskTask({ status: "queued", currentStep: "排队中" }),
+        deskTask({ status: "completed", currentStep: "做好了。" }),
+      ]),
+    ).toEqual({ working: false, line: undefined });
+  });
+
+  it("hands the line to the footer, which says the tool in Chinese", () => {
+    // The server writes the call it is making, so the desk's own step is English about a tool
+    // (`Read file magpie-ios-app/...`, or a bare command). The footer translates it.
+    const reading = frontDeskActivity([deskTask({ currentStep: "Read file a/b.swift" })]).line;
+    expect(activityStep(reading)?.label).toBe("正在读文件");
+    const running = frontDeskActivity([deskTask({ currentStep: "npx tsc --noEmit" })]).line;
+    expect(activityStep(running)?.label).toBe("正在执行几条命令");
+  });
+});
+
+describe("ledgerElapsed", () => {
+  const now = Date.parse("2026-11-16T12:10:00.000Z");
+
+  it("counts seconds, minutes and hours in the shortest form that reads as time", () => {
+    expect(ledgerElapsed("2026-11-16T12:09:30.000Z", now)).toBe("30 秒");
+    expect(ledgerElapsed("2026-11-16T12:07:20.000Z", now)).toBe("2 分 40 秒");
+    expect(ledgerElapsed("2026-11-16T10:35:00.000Z", now)).toBe("1 小时 35 分");
+  });
+
+  it("says nothing without a start, and never counts backwards", () => {
+    expect(ledgerElapsed(undefined, now)).toBeUndefined();
+    expect(ledgerElapsed("not a date", now)).toBeUndefined();
+    expect(ledgerElapsed("2026-11-16T12:11:00.000Z", now)).toBe("0 秒");
+  });
+});
+
+describe("ledgerModelLabel", () => {
+  it("names the vendor once", () => {
+    expect(ledgerModelLabel("openai", "openai/gpt-5.1")).toBe("openai · gpt-5.1");
+    expect(ledgerModelLabel(null, "gemini-3-flash")).toBe("gemini-3-flash");
+    expect(ledgerModelLabel("magic", "  ")).toBeUndefined();
+  });
+});
+
+describe("ledgerSummary", () => {
+  it("counts the work in Chinese, and says nothing at zero", () => {
+    expect(ledgerSummary(0)).toBeUndefined();
+    expect(ledgerSummary(3)).toBe("3 路在做");
+  });
+});
+
+/** This round: the row's own Chinese step wins over the command beside it. */
+describe("frontDeskStep", () => {
+  it("prefers the work's Chinese action over the bare command", () => {
+    expect(frontDeskStep("ls -la /workspace", "读取部署文档")).toBe("读取部署文档");
+    expect(frontDeskStep("读取 magpie 部署文档", "ls -la")).toBe("读取 magpie 部署文档");
+  });
+
+  it("keeps the row's own order when neither line is an action", () => {
+    expect(frontDeskStep("ls -la", "npm test")).toBe("ls -la");
+    expect(frontDeskStep(null, "  ")).toBeUndefined();
+  });
+
+  it("carries the Chinese step into the chat's line", () => {
+    const activity = frontDeskActivity([
+      deskTask({ currentStep: "ls -la /workspace", progress: "搜索历史报错" }),
+    ]);
+    expect(activity.line).toBe("搜索历史报错");
+  });
+});
diff --git a/apps/mobile/lib/ledger-tasks.ts b/apps/mobile/lib/ledger-tasks.ts
new file mode 100644
index 000000000..ff998cefa
--- /dev/null
+++ b/apps/mobile/lib/ledger-tasks.ts
@@ -0,0 +1,235 @@
+import type { FrontDeskTask } from "@rakazo/contracts";
+import type { LiveThreadRun } from "@rakazo/core";
+import { activityStep } from "./activity-label";
+import type { MobileMessage } from "./mobile-types";
+
+/**
+ * One line of the chat's background ledger: a piece of work running behind the conversation.
+ *
+ * The chat's own front desk is the source: the server keeps a row per handed-off piece of work
+ * (title, desk, model, the step it is on, when it started and when it settled), and the phone
+ * draws those rows. The older route — reading running cards out of the transcript — stays for a
+ * server that does not publish the ledger, where a saved card is the only thing that says work is
+ * running at all.
+ */
+export type LedgerTask = {
+  /** Stable across updates: the ledger row's id, or the card's agent id on the older route. */
+  id: string;
+  /** The ledger row's task id, which opens the steps it took; absent on the older route. */
+  taskId?: string;
+  title: string;
+  /** The step the work is on right now, in the work's own words. */
+  step?: string;
+  /** The model doing it, when the run behind the card is known. */
+  model?: string;
+  /** When the work started: what the ledger counts the elapsed time from. */
+  startedAt?: string;
+  /** Where the work stands; absent on the older route, where only running cards are listed. */
+  status?: LedgerStatus;
+  /** When it settled, for a row that has just finished. */
+  finishedAt?: string;
+  /**
+   * What Stop names. A ledger row names the row itself, which the server stops as a whole; a card
+   * names its message.
+   */
+  stop?: { botId: string; messageId?: string; taskId?: string };
+};
+
+/** The states a ledger row can be in, as the front desk records them. */
+export type LedgerStatus = "queued" | "running" | "completed" | "failed" | "cancelled";
+
+/** The states that mean the work is still in the back office. */
+export const LEDGER_OPEN_STATUSES: readonly LedgerStatus[] = ["queued", "running"];
+
+/**
+ * How long a settled row stays in the panel after it finishes, so a row is seen to settle instead
+ * of vanishing. The server keeps them for the same quarter of an hour.
+ */
+export const LEDGER_FINISHED_MS = 15 * 60 * 1000;
+
+export function ledgerIsOpen(task: LedgerTask): boolean {
+  return task.status === undefined || LEDGER_OPEN_STATUSES.includes(task.status);
+}
+
+/** The work still in the back office: what the pill's count and the panel's heading count. */
+export function ledgerOpenCount(tasks: readonly LedgerTask[]): number {
+  return tasks.filter(ledgerIsOpen).length;
+}
+
+/** A card row built from a message; the message id is what Stop names. */
+type CardBlock = Extract<MobileMessage["blocks"][number], { kind: "subagent" | "cloud_agent" }>;
+
+function isRunningCard(block: MobileMessage["blocks"][number]): block is CardBlock {
+  return (
+    (block.kind === "subagent" && block.status === "running") ||
+    (block.kind === "cloud_agent" && block.status === "running")
+  );
+}
+
+/** A saved running card is a background helper's; its message id is what Stop names. */
+function stoppable(message: MobileMessage): { botId: string; messageId: string } | undefined {
+  // A live card belongs to the turn writing it, and stopping it means something else entirely.
+  if (!message.botId || message.id.startsWith("subagent:")) return undefined;
+  return { botId: message.botId, messageId: message.id };
+}
+
+/** The provider-qualified model name, shortened the way a chip can hold it. */
+export function ledgerModelLabel(
+  provider: string | null | undefined,
+  modelId: string | null | undefined,
+): string | undefined {
+  const model = modelId?.trim();
+  if (!model) return undefined;
+  // Gateways repeat the vendor in the id; the chip says it once.
+  const short = model.includes("/") ? (model.split("/").pop() ?? model) : model;
+  return provider?.trim() ? `${provider.trim()} · ${short}` : short;
+}
+
+/**
+ * The chat's running work, oldest first: every card still running in the message list, with the
+ * model of the run behind it when this chat can see that run. Work that has already settled is
+ * not the ledger's business — its card says so in place.
+ */
+export function ledgerTasks(
+  messages: readonly MobileMessage[] | undefined,
+  runs: readonly LiveThreadRun[] | undefined,
+): LedgerTask[] {
+  if (!messages?.length) return [];
+  const modelOf = new Map<string, string | undefined>();
+  for (const run of runs ?? []) {
+    modelOf.set(run.id, ledgerModelLabel(run.modelProvider, run.modelId));
+  }
+  const tasks: LedgerTask[] = [];
+  const seen = new Set<string>();
+  for (const message of messages) {
+    for (const block of message.blocks) {
+      if (!isRunningCard(block)) continue;
+      const id = block.agentId;
+      // A live card and the saved one that replaces it can both be in the list for a moment.
+      if (seen.has(id)) continue;
+      seen.add(id);
+      const step =
+        block.kind === "subagent"
+          ? block.progress?.trim() || block.task.trim() || undefined
+          : block.branch?.trim() || undefined;
+      tasks.push({
+        id,
+        title: block.kind === "subagent" ? block.name : block.title,
+        ...(step ? { step } : {}),
+        ...(modelOf.get(id) ? { model: modelOf.get(id) } : {}),
+        ...(message.createdAt ? { startedAt: message.createdAt } : {}),
+        ...(stoppable(message) ? { stop: stoppable(message) } : {}),
+      });
+    }
+  }
+  return tasks;
+}
+
+/** How long the work has been going, in the shortest form that still reads as time. */
+export function ledgerElapsed(startedAt: string | undefined, now: number): string | undefined {
+  if (!startedAt) return undefined;
+  const started = new Date(startedAt).getTime();
+  if (!Number.isFinite(started)) return undefined;
+  const seconds = Math.max(0, Math.round((now - started) / 1000));
+  if (seconds < 60) return `${seconds} 秒`;
+  const minutes = Math.floor(seconds / 60);
+  if (minutes < 60) return `${minutes} 分 ${seconds % 60} 秒`;
+  const hours = Math.floor(minutes / 60);
+  return `${hours} 小时 ${minutes % 60} 分`;
+}
+
+/** What the pill's own line says about the ledger, so the count never reads as a number alone. */
+export function ledgerSummary(count: number): string | undefined {
+  return count > 0 ? `${count} 路在做` : undefined;
+}
+
+/**
+ * The chat's ledger as the server publishes it: every row still in the back office, plus the ones
+ * that settled a moment ago. Oldest first, which is the order the panel lists them in.
+ *
+ * A settled row is dropped once its grace window has passed, so a task that finished hours ago
+ * cannot keep a line in the panel — that was the whole complaint about reading the transcript's
+ * leftover cards instead of the ledger.
+ */
+export function frontDeskLedgerTasks(
+  tasks: readonly FrontDeskTask[] | undefined,
+  botId: string | undefined,
+  now = Date.now(),
+): LedgerTask[] {
+  if (!tasks?.length) return [];
+  const rows: LedgerTask[] = [];
+  for (const task of tasks) {
+    const status = task.status as LedgerStatus;
+    const open = LEDGER_OPEN_STATUSES.includes(status);
+    const finishedAt = task.completedAt ?? undefined;
+    if (!open) {
+      const settled = finishedAt ? new Date(finishedAt).getTime() : Number.NaN;
+      // A row with no usable finish time has nothing that says it is recent: leave it out.
+      if (!Number.isFinite(settled) || now - settled > LEDGER_FINISHED_MS) continue;
+    }
+    const step =
+      task.progress?.trim() || task.steps[task.steps.length - 1]?.line?.trim() || undefined;
+    rows.push({
+      id: task.id,
+      // A ledger row is what opens its steps: the same id the server lists.
+      taskId: task.id,
+      title: task.title.trim() || task.slot || "后台任务",
+      ...(step ? { step } : {}),
+      ...(ledgerModelLabel(task.modelProvider, task.modelId)
+        ? { model: ledgerModelLabel(task.modelProvider, task.modelId) }
+        : {}),
+      ...(task.createdAt ? { startedAt: task.createdAt } : {}),
+      status,
+      ...(finishedAt ? { finishedAt } : {}),
+      // Only work still in hand can be stopped; the ledger row is what the server stops.
+      ...(open && botId ? { stop: { botId, taskId: task.id } } : {}),
+    });
+  }
+  return rows;
+}
+
+/**
+ * What the back office is doing for this chat right now.
+ *
+ * The front desk answers in seconds and its run ends there, so the chat's own live line goes quiet
+ * while the work it handed over keeps running. These rows are that work: `working` keeps the
+ * chat's working line on screen, and `line` is the step the task says it is on, in its own words,
+ * which `activityStep` turns into the same short phrase the live line uses.
+ */
+export function frontDeskActivity(tasks: readonly FrontDeskTask[] | undefined): {
+  readonly working: boolean;
+  readonly line: string | undefined;
+} {
+  const running = (tasks ?? []).filter((task) => task.status === "running");
+  if (running.length === 0) return { working: false, line: undefined };
+  // The newest task is the one the reader is waiting on; older ones are usually further behind.
+  for (let index = running.length - 1; index >= 0; index -= 1) {
+    const task = running[index];
+    const step = frontDeskStep(task?.currentStep, task?.progress);
+    if (step) return { working: true, line: step };
+  }
+  // Work in hand that has not said what it is doing yet still keeps the line on screen.
+  return { working: true, line: undefined };
+}
+
+/**
+ * How often a chat on screen re-reads its snapshot while a back-office row is running, so the
+ * working line follows the step that row is on rather than waiting for a run to finish.
+ */
+export const FRONT_DESK_STEP_POLL_MS = 4_000;
+
+/**
+ * The step a row is on, picked the way the working line reads it: a clean Chinese action wins over
+ * the command or file name beside it, so 「读取 magpie 部署文档」 is shown rather than folded into
+ * 「正在执行几条命令」. When neither is an action, the row's own order stands.
+ */
+export function frontDeskStep(
+  currentStep: string | null | undefined,
+  progress: string | null | undefined,
+): string | undefined {
+  const step = currentStep?.trim() || undefined;
+  const written = progress?.trim() || undefined;
+  if (step && activityStep(step)?.specific) return step;
+  if (written && activityStep(written)?.specific) return written;
+  return step ?? written;
+}
