+              accessibilityState={{ disabled: locked || sending, selected: picked }}
+              disabled={locked || sending}
+              onPress={() => pick(option.id)}
+              style={({ pressed }) => [
+                styles.option,
+                {
+                  backgroundColor: pressed || picked ? native.fill : native.fillPressed,
+                  opacity: sending ? 0.6 : 1,
+                },
+              ]}
+            >
+              <View style={[styles.letter, { backgroundColor: native.fill }]}>
+                <Text style={[styles.letterText, { color: tokens.mutedForeground }]}>
+                  {option.letter}
+                </Text>
+              </View>
+              <Text
+                style={[
+                  styles.optionLabel,
+                  { color: picked ? tokens.mutedForeground : tokens.foreground },
+                ]}
+              >
+                {option.label}
+              </Text>
+              {picked ? (
+                <NativeSymbol
+                  ios="checkmark"
+                  android="checkmark"
+                  size={15}
+                  color={tokens.mutedForeground}
+                />
+              ) : null}
+            </Pressable>
+          );
+        })}
+      </View>
+      {failure ? (
+        <Text accessibilityRole="alert" style={[styles.prompt, { color: tokens.destructive }]}>
+          {failure}
+        </Text>
