diff --git a/packages/core/src/lumen-manifest.ts b/packages/core/src/lumen-manifest.ts
new file mode 100644
index 000000000..306470a15
--- /dev/null
+++ b/packages/core/src/lumen-manifest.ts
@@ -0,0 +1,270 @@
+/**
+ * The Lumen avatar manifest: a JSON file on the server that names, for every bot, the finished
+ * still and motion pictures to show. The app reads it on every launch, so a new bot only needs
+ * its pictures and one manifest row on the server — no new build.
+ *
+ * Everything here is pure: parse, match a bot, pick the picture for a surface. A bot the
+ * manifest does not know keeps the drawn Lumen body.
+ */
+
+export type LumenManifestTheme = "dark" | "light";
+export type LumenManifestKind = "static" | "list" | "header";
+export type LumenManifestSurface = "home-hero" | "home-list" | "chat" | "default";
+
+/** A row may name only some of the three pictures; the picker fills the gaps. */
+export type LumenManifestPictures = Partial<Record<LumenManifestKind, string>>;
+
+export type LumenManifestBot = {
+  botId: string;
+  name: string;
+  role: "chief" | "lead" | "member";
+  /** The chief's orange star is drawn inside its pictures: the app must not add a second one. */
+  starBaked: boolean;
+  /** The list row shows the full ignition too (the chief), not the short list loop. */
+  listVariant: "v3-full" | null;
+  /** The list row's own size, when the art was drawn for it (the chief's is 96 pt). */
+  listSizePt: number | null;
+  /**
+   * The home hero's own size, when the manifest fixes one (the chief's is 136 pt). A server that
+   * does not name it leaves the hero at {@link LUMEN_HERO_PT}, so a manifest edited for another
+   * reason never shrinks the main character.
+   */
+  heroSizePt: number | null;
+  themes: Partial<Record<LumenManifestTheme, LumenManifestPictures>>;
+};
+
+export type LumenManifest = {
+  version: string;
+  /** The manifest's own address: relative picture paths resolve against it. */
+  baseUrl: string;
+  headerMinPt: number;
+  reduceMotionStatic: boolean;
+  surfaces: Partial<Record<LumenManifestSurface, LumenManifestKind>>;
+  bots: LumenManifestBot[];
+  hashes: Record<string, string>;
+};
+
+/** Where the manifest lives on a server. */
+export const LUMEN_MANIFEST_PATH = "/lumen-avatars/manifest.json";
+
+/** The hero's, the list row's and the chief's row's sizes, in points. */
+export const LUMEN_HERO_PT = 136;
+export const LUMEN_LIST_PT = 56;
+/** The chief's list row shows the full ignition, drawn for a 96 pt row. */
+export const LUMEN_CHIEF_LIST_PT = 96;
+
+export function lumenManifestUrl(apiBase: string): string {
+  return new URL(LUMEN_MANIFEST_PATH, apiBase.endsWith("/") ? apiBase : `${apiBase}/`).toString();
+}
+
+const KINDS: readonly LumenManifestKind[] = ["static", "list", "header"];
+const SURFACES: readonly LumenManifestSurface[] = ["home-hero", "home-list", "chat", "default"];
+
+function str(value: unknown): string | null {
+  return typeof value === "string" && value.trim() ? value.trim() : null;
+}
+
+function kindOf(value: unknown): LumenManifestKind | null {
+  return value === "static" || value === "list" || value === "header" ? value : null;
+}
+
+/**
+ * One theme's pictures. A row is kept when it names at least one picture: the picker then falls
+ * back through the theme's other pictures instead of dropping the whole bot.
+ */
+function pictures(value: unknown): LumenManifestPictures | null {
+  if (!value || typeof value !== "object") return null;
+  const row = value as Record<string, unknown>;
+  const out: LumenManifestPictures = {};
+  for (const kind of KINDS) {
+    const path = str(row[kind]);
+    if (path) out[kind] = path;
+  }
+  return Object.keys(out).length > 0 ? out : null;
+}
+
+/** The surface → picture table the manifest declares, or the design's defaults. */
+function surfacesOf(playback: Record<string, unknown>): LumenManifest["surfaces"] {
+  const raw = playback.surfaces;
+  const out: LumenManifest["surfaces"] = {};
+  if (raw && typeof raw === "object") {
+    for (const surface of SURFACES) {
+      const kind = kindOf((raw as Record<string, unknown>)[surface]);
+      if (kind) out[surface] = kind;
+    }
+  }
+  return out;
+}
+
+/**
+ * A manifest from untrusted JSON. A broken row is skipped rather than failing the whole file;
+ * a file with no usable row at all is null, so the app keeps what it had.
+ */
+export function parseLumenManifest(raw: unknown, baseUrl: string): LumenManifest | null {
+  if (!raw || typeof raw !== "object") return null;
+  const doc = raw as Record<string, unknown>;
+  if (typeof doc.schemaVersion !== "number" || doc.schemaVersion < 2) return null;
+  if (!Array.isArray(doc.bots)) return null;
+  const bots: LumenManifestBot[] = [];
+  for (const item of doc.bots) {
+    if (!item || typeof item !== "object") continue;
+    const row = item as Record<string, unknown>;
+    const botId = str(row.botId);
+    const name = str(row.name);
+    if (!botId || !name) continue;
+    const themes = row.themes as Record<string, unknown> | undefined;
+    const dark = pictures(themes?.dark);
+    const light = pictures(themes?.light);
+    if (!dark && !light) continue;
+    const role = row.role === "chief" || row.role === "lead" ? row.role : "member";
+    const listSize = typeof row.listSizePt === "number" && row.listSizePt > 0 ? row.listSizePt : null;
+    const heroSize = typeof row.heroSizePt === "number" && row.heroSizePt > 0 ? row.heroSizePt : null;
+    bots.push({
+      botId,
+      name,
+      role,
+      starBaked: row.starBaked === true,
+      listVariant: row.listVariant === "v3-full" ? "v3-full" : null,
+      listSizePt: listSize,
+      heroSizePt: heroSize,
+      themes: {
+        ...(dark ? { dark } : {}),
+        ...(light ? { light } : {}),
+      },
+    });
+  }
+  if (bots.length === 0) return null;
+  const playback = (doc.playback ?? {}) as Record<string, unknown>;
+  const headerMinPt =
+    typeof playback.headerMinPt === "number" && playback.headerMinPt > 0 ? playback.headerMinPt : 72;
+  const hashes: Record<string, string> = {};
+  if (doc.hashes && typeof doc.hashes === "object") {
+    for (const [path, hash] of Object.entries(doc.hashes as Record<string, unknown>)) {
+      if (typeof hash === "string") hashes[path] = hash;
+    }
+  }
+  return {
+    version: str(doc.version) ?? "0",
+    baseUrl,
+    headerMinPt,
+    reduceMotionStatic: playback.reduceMotion !== "animate",
+    surfaces: surfacesOf(playback),
+    bots,
+    hashes,
+  };
+}
+
+/** A bot's row: its id first, its exact name second (a bot recreated under the same name). */
+export function lumenManifestBot(
+  manifest: LumenManifest | null,
+  bot: { identity?: string | null; name?: string | null },
+): LumenManifestBot | null {
+  if (!manifest) return null;
+  const id = (bot.identity ?? "").trim();
+  if (id) {
+    const byId = manifest.bots.find((row) => row.botId === id);
+    if (byId) return byId;
+  }
+  const name = (bot.name ?? "").trim();
+  if (!name) return null;
+  return manifest.bots.find((row) => row.name === name) ?? null;
+}
+
+/** Which picture a surface wants: the design's own table, then the size rule. */
+export function lumenManifestKind(input: {
+  surface: LumenManifestSurface;
+  size: number;
+  reducedMotion: boolean;
+  headerMinPt: number;
+  reduceMotionStatic: boolean;
+  surfaces?: LumenManifest["surfaces"];
+}): LumenManifestKind {
+  if (input.reducedMotion && input.reduceMotionStatic) return "static";
+  const declared = input.surfaces?.[input.surface];
+  if (declared && declared !== "static") return declared;
+  if (declared === "static") return "static";
+  if (input.surface === "home-hero" || input.surface === "chat") return "header";
+  if (input.surface === "home-list") return "list";
+  return input.size >= input.headerMinPt ? "header" : "list";
+}
+
+export type LumenManifestPicture = {
+  /**
+   * The pictures to try in order: the one wanted, the same theme's still, the other theme's
+   * picture of the same kind, the other theme's still. A picture that fails to load falls to
+   * the next, and an empty list means the drawn body.
+   */
+  uris: string[];
+  kind: LumenManifestKind;
+  /** The size the finished art was drawn for, in points, when it fixes one (list rows). */
+  size: number | null;
+  /** False when the art already carries the main-bot star. */
+  drawMainStar: boolean;
+};
+
+/** The address of one picture path, guarded so only web URLs are ever loaded. */
+function pictureUri(manifest: LumenManifest, path: string | undefined): string | null {
+  if (!path) return null;
+  try {
+    const url = new URL(path, manifest.baseUrl);
+    if (url.protocol !== "https:" && url.protocol !== "http:") return null;
+    // A changed picture gets a new address, so no cache can keep showing the old one.
+    const hash = manifest.hashes[path];
+    if (hash) url.searchParams.set("h", hash);
+    return url.toString();
+  } catch {
+    return null;
+  }
+}
+
+/**
+ * The pictures a bot shows on one surface, best first. A list row of the chief (or of any row
+ * marked `v3-full`) uses the full ignition; everything else uses the kind the surface asks for.
+ */
+export function lumenManifestPicture(
+  manifest: LumenManifest | null,
+  input: {
+    identity?: string | null;
+    name?: string | null;
+    surface?: LumenManifestSurface;
+    size: number;
+    dark: boolean;
+    reducedMotion: boolean;
+  },
+): LumenManifestPicture | null {
+  const bot = lumenManifestBot(manifest, input);
+  if (!manifest || !bot) return null;
+  const surface = input.surface ?? "default";
+  const wanted = lumenManifestKind({
+    surface,
+    size: input.size,
+    reducedMotion: input.reducedMotion,
+    headerMinPt: manifest.headerMinPt,
+    reduceMotionStatic: manifest.reduceMotionStatic,
+    surfaces: manifest.surfaces,
+  });
+  const kind: LumenManifestKind =
+    wanted === "list" && (bot.role === "chief" || bot.listVariant === "v3-full") ? "header" : wanted;
+  const dark = input.dark ? "dark" : "light";
+  const light = input.dark ? "light" : "dark";
+  const own = bot.themes[dark];
+  const other = bot.themes[light];
+  const order = [own?.[kind], own?.static, other?.[kind], other?.static];
+  const uris: string[] = [];
+  for (const path of order) {
+    const uri = pictureUri(manifest, path);
+    if (uri && !uris.includes(uri)) uris.push(uri);
+  }
+  if (uris.length === 0) return null;
+  // The finished art fixes three sizes: the hero (the manifest's `heroSizePt`, 136 pt for the
+  // chief), the list rows (the chief's own row is the wider full ignition), and nothing else.
+  // Every other surface keeps the size its caller asked for.
+  const chief = bot.role === "chief";
+  const size =
+    surface === "home-hero"
+      ? (bot.heroSizePt ?? (chief ? LUMEN_HERO_PT : LUMEN_LIST_PT))
+      : surface === "home-list"
+        ? (bot.listSizePt ?? (chief ? LUMEN_CHIEF_LIST_PT : LUMEN_LIST_PT))
+        : null;
+  return { uris, kind, size, drawMainStar: !bot.starBaked };
+}
