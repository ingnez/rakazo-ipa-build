+import { afterEach, describe, expect, it } from "vitest";
+import type { ImageArtifactPreviewTarget } from "../components/image-artifact-viewer";
+import {
+  clearImageGallerySession,
+  gallerySessionFor,
+  peekImageGallerySession,
+  setImageGallerySession,
+} from "./image-gallery-session.js";
+
+const items: ImageArtifactPreviewTarget[] = [
+  { artifactId: "a", name: "a.jpg", mimeType: "image/jpeg" },
+  { artifactId: "b", name: "b.jpg", mimeType: "image/jpeg" },
+  { artifactId: "c", name: "c.jpg", mimeType: "image/jpeg" },
+];
+
+afterEach(() => clearImageGallerySession());
+
+describe("image gallery session", () => {
+  it("clamps the start index and remembers the tapped sibling", () => {
+    const session = setImageGallerySession({
+      threadTarget: { botId: "bot" },
+      items,
+      startIndex: 99,
+    });
+    expect(session.startIndex).toBe(2);
+    expect(peekImageGallerySession()?.items).toHaveLength(3);
+  });
+
+  it("opens on the tapped image among its siblings", () => {
+    const session = gallerySessionFor(items, items[1]!, { botId: "bot" });
+    expect(session.startIndex).toBe(1);
+    expect(session.items.map((item) => item.artifactId)).toEqual(["a", "b", "c"]);
+  });
+
+  it("falls back to the tapped image when the sibling list is empty", () => {
+    const session = gallerySessionFor([], items[0]!, { groupId: "g" });
+    expect(session.items).toEqual([items[0]]);
+    expect(session.startIndex).toBe(0);
+  });
+});
