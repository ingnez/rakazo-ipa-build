+ */
+export function legibleOn(ink: string, background: string): string {
+  if (contrastRatio(ink, background) >= MIN_INK_CONTRAST) return ink;
+  // The ink cannot be read on this body: take whichever of white and black reads best on it.
+  return contrastRatio(BOT_EYE_INK_ON_DARK, background) >=
+    contrastRatio(BOT_EYE_INK_ON_WHITE, background)
+    ? BOT_EYE_INK_ON_DARK
+    : BOT_EYE_INK_ON_WHITE;
+}
+
+export function botEyeInk(
+  bodyColor: string,
+  /** Kept for callers that still pass the page; the ink no longer depends on it. */
+  _page?: { background: string; foreground: string },
+): string {
+  return legibleOn(BOT_EYE_INK, bodyColor);
+}
+
+/**
+ * Whether a body's eyes are cut out of it, so the page shows through, instead of painted on.
+ *
+ * The reference app cuts them (`carveEllipse` / `fill-rule="evenodd"`), and that is what makes a
+ * pale body read with dark eyes in a dark theme and white ones in a light theme. Cutting only
+ * works while the page behind the hole is legible against the body, so a body whose page cannot
+ * clear 3:1 keeps painted eyes in the ink `legibleOn` picks — a white page behind a yellow body
+ * would otherwise be a pair of invisible eyes.
+ */
+export function botEyeCutout(bodyColor: string, background = "#FFFFFF"): boolean {
+  return contrastRatio(bodyColor, background) >= MIN_INK_CONTRAST;
 }
 
 /** WCAG contrast ratio between two hex colors. */
