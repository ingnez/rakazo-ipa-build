@@ -0,0 +1,106 @@
+import { describe, expect, it } from "vitest";
+import {
+  ACTIVITY_ELAPSED_THRESHOLD_MS,
+  ACTIVITY_MIN_DWELL_MS,
+  ACTIVITY_SPECIFIC_DWELL_MS,
+  ActivityPacing,
+} from "./activity-pacing";
+
+const search = { key: "search", label: "四处查找" };
+const read = { key: "read", label: "读文件" };
+const shell = { key: "shell", label: "跑命令" };
+
+describe("ActivityPacing", () => {
+  it("shows the first step at once, and counts the dwell from there", () => {
+    const pacing = new ActivityPacing();
+    const first = pacing.pace(search, 0);
+    expect(first.shown).toEqual(search);
+    expect(first.changed).toBe(true);
+  });
+
+  it("holds a new step until the current one has had its 800 ms", () => {
+    const pacing = new ActivityPacing();
+    pacing.pace(search, 1000);
+    const early = pacing.pace(read, 1200);
+    expect(early.shown).toEqual(search);
+    expect(early.changed).toBe(false);
+    expect(early.dueAtMs).toBe(1000 + ACTIVITY_MIN_DWELL_MS);
+    // The wake at the due time takes the queued step.
+    const due = pacing.takeQueued(1000 + ACTIVITY_MIN_DWELL_MS);
+    expect(due.shown).toEqual(read);
+    expect(due.changed).toBe(true);
+  });
+
+  it("changes at once once the dwell is over", () => {
+    const pacing = new ActivityPacing();
+    pacing.pace(search, 1000);
+    const later = pacing.pace(shell, 1000 + ACTIVITY_MIN_DWELL_MS);
+    expect(later.shown).toEqual(shell);
+    expect(later.changed).toBe(true);
+  });
+
+  it("does not redraw the line for the same step again", () => {
+    const pacing = new ActivityPacing();
+    pacing.pace(search, 1000);
+    const again = pacing.pace({ key: "search", label: "四处查找" }, 3000);
+    expect(again.changed).toBe(false);
+    expect(again.dueAtMs).toBeUndefined();
+  });
+
+  it("drops a queued step the run has left behind", () => {
+    const pacing = new ActivityPacing();
+    pacing.pace(search, 1000);
+    pacing.pace(read, 1100);
+    pacing.pace(search, 1200);
+    const due = pacing.takeQueued(2000);
+    expect(due.shown).toEqual(search);
+    expect(due.changed).toBe(false);
+  });
+
+  it("clears the line when the work ends", () => {
+    const pacing = new ActivityPacing();
+    pacing.pace(search, 1000);
+    const done = pacing.pace(undefined, 2000);
+    expect(done.shown).toBeUndefined();
+    expect(done.changed).toBe(true);
+  });
+
+  it("counts seconds only past a minute of the same run", () => {
+    const pacing = new ActivityPacing();
+    pacing.pace(search, 1000);
+    expect(pacing.elapsedSeconds(1000 + ACTIVITY_ELAPSED_THRESHOLD_MS - 1)).toBeUndefined();
+    expect(pacing.elapsedSeconds(1000 + ACTIVITY_ELAPSED_THRESHOLD_MS)).toBe(60);
+    pacing.pace(read, 200_000);
+    // A new step inside the same run keeps counting from when the run's line began.
+    expect(pacing.elapsedSeconds(205_000)).toBe(204);
+  });
+});
+
+/** This round: a step in the work's own words takes the line over quickly. */
+describe("ActivityPacing with the work's own step", () => {
+  const stepA = { key: "step:读取部署文档", label: "读取部署文档", specific: true };
+  const stepB = { key: "step:搜索历史报错", label: "搜索历史报错", specific: true };
+
+  it("shows the next Chinese step after its own short dwell, not the phrase's 800 ms", () => {
+    const pacing = new ActivityPacing();
+    pacing.pace(shell, 1000);
+    const early = pacing.pace(stepA, 1000 + ACTIVITY_SPECIFIC_DWELL_MS);
+    expect(early.shown).toEqual(stepA);
+    expect(early.changed).toBe(true);
+  });
+
+  it("holds a Chinese step that arrives inside the short dwell, then takes it at its due time", () => {
+    const pacing = new ActivityPacing();
+    pacing.pace(shell, 1000);
+    const queued = pacing.pace(stepA, 1100);
+    expect(queued.shown).toEqual(shell);
+    expect(queued.dueAtMs).toBe(1000 + ACTIVITY_SPECIFIC_DWELL_MS);
+    expect(pacing.takeQueued(1000 + ACTIVITY_SPECIFIC_DWELL_MS).shown).toEqual(stepA);
+  });
+
+  it("moves on from one Chinese step to the next as each new step arrives", () => {
+    const pacing = new ActivityPacing();
+    pacing.pace(stepA, 1000);
+    expect(pacing.pace(stepB, 1000 + ACTIVITY_SPECIFIC_DWELL_MS).shown).toEqual(stepB);
+  });
+});
