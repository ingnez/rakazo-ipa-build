+import { readFileSync } from "node:fs";
+import { describe, expect, it } from "vitest";
+import {
+  botSoulPresets,
+  soulAfterPresetTap,
+  soulEdits,
+  soulIsDirty,
+  soulOf,
+  soulPresetFor,
+} from "./bot-soul";
+
+const presets = botSoulPresets();
+
+describe("bot soul", () => {
+  it("offers one-tap ways of talking, each a whole personality", () => {
+    expect(presets.map((preset) => preset.key)).toEqual([
+      "brisk",
+      "gentle",
+      "witty",
+      "composed",
+      "friend",
+    ]);
+    for (const preset of presets) {
+      expect(preset.label.length).toBeGreaterThan(0);
+      // A preset is worth tapping only if it says enough to change how the bot talks.
+      expect(preset.soul.length).toBeGreaterThan(80);
+      expect(preset.soul.trim()).toBe(preset.soul);
+    }
+    expect(new Set(presets.map((preset) => preset.soul)).size).toBe(presets.length);
+  });
+
+  it("reads a bot from before the field, and a cleared one, as no soul at all", () => {
+    expect(soulOf(null)).toBe("");
+    expect(soulOf(undefined)).toBe("");
+    expect(soulOf({})).toBe("");
+    expect(soulOf({ soul: null })).toBe("");
+    expect(soulOf({ soul: "   " })).toBe("   ");
+    expect(soulOf({ soul: "Calm and precise." })).toBe("Calm and precise.");
+  });
+
+  it("recognises the preset whose words the field holds", () => {
+    expect(soulPresetFor("")?.key).toBeUndefined();
+    expect(soulPresetFor("   ")?.key).toBeUndefined();
+    expect(soulPresetFor(`  ${presets[1]!.soul}\n`)?.key).toBe("gentle");
+    expect(soulPresetFor("You are a night-shift ICU colleague.")?.key).toBeUndefined();
+  });
+
+  it("fills the field on a tap, and empties it when that preset is already in it", () => {
+    expect(soulAfterPresetTap("", presets[0]!)).toBe(presets[0]!.soul);
+    expect(soulAfterPresetTap("Something of my own.", presets[2]!)).toBe(presets[2]!.soul);
+    expect(soulAfterPresetTap(presets[2]!.soul, presets[2]!)).toBe("");
+    // Whitespace the field picked up on the way in does not stop the second tap clearing it.
+    expect(soulAfterPresetTap(` ${presets[3]!.soul} `, presets[3]!)).toBe("");
+  });
+
+  it("sends the soul only when it differs from the saved one", () => {
+    expect(soulEdits({ soul: null }, "")).toEqual({});
+    expect(soulEdits({}, "  ")).toEqual({});
+    expect(soulEdits({ soul: "Calm." }, " Calm. ")).toEqual({});
+    expect(soulEdits({ soul: "Calm." }, presets[0]!.soul)).toEqual({ soul: presets[0]!.soul });
