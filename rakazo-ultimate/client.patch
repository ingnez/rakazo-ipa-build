+import { AVATAR_FACES } from "./avatar-spec.js";
+import type { BabygrokBody } from "./babygrok-geometry.js";
+
+/**
+ * The face BabyGrok's bodies wear, and how it moves.
+ *
+ * A body's ring is 64 x,y pairs; every body has them in the same order, so two bodies
+ * interpolate vertex by vertex. The eyes are one capsule each, drawn as a stroked line: the
+ * line is straight at rest and bends into an arch when the bot is pleased, and its width (the
+ * stroke) is what a blink closes. Everything here runs inside Reanimated worklets.
+ */
+
+/**
+ * Rounding for the path strings: two decimals is finer than a screen pixel at any size.
+ *
+ * Every worklet below calls this, so it has to be a worklet itself: a plain function captured
+ * by a worklet closure cannot be called on the UI thread, and the first avatar drawn would fail
+ * before the app paints.
+ */
+function round(value: number): number {
+  "worklet";
+  return Math.round(value * 100) / 100;
+}
+/**
+ * How far a pleased eye bends, in radians: about 117 degrees of arc.
+ *
+ * A pleased eye is a shallow crescent, not a half circle: a little more than a third of a turn
+ * each way. Bending the eye the full half turn made a dome with a hairline notch — a bun, not a
+ * `︵`.
+ */
+export const HAPPY_BEND = 2.05;
+/**
+ * How far an arch lifts off the open eye's place, as a share of its length.
+ *
+ * An arch rises `radius · (1 - cos(bend / 2))` above the level of its own feet, with
+ * `radius = length / bend`; lifting it by half of that keeps the arch centred on the eye it
+ * replaces instead of hanging below it. With the bend above that is 0.117 of the length.
+ */
+const HAPPY_LIFT = 0.117;
+/**
+ * How much of its thickness a pleased eye gives up, so the arch is a stroke and not a dome.
+ *
+ * The open eye is a fat capsule — a stroke about 0.4 of its length — and an arch drawn that thick
+ * has almost no notch left under it: at this body's proportions the inner radius fell to about a
+ * unit and the eye read as a solid bun. The reference's arch is 17 units thick over a 19-unit
+ * radius, so the stroke thins to 0.78 of the open eye's.
+ */
+const HAPPY_THIN = 0.22;
+/**
+ * How much of an eye's length the arch gives up, so the two arches keep a clear gap of skin
+ * between them.
+ *
+ * The reference's arch is shorter than the eye it opens from — its centre line runs about 0.7 of
+ * the capsule — and at the authored gap a pair of full-length arcs met in the middle and read as
+ * one `m`. Shortening the arc is what separates them; widening the gap alone would have moved the
+ * face off its own body.
+ */
+const HAPPY_SHORTEN = 0.3;
+/** How much the pair opens up while pleased, as a share of its gap. */
+const HAPPY_WIDEN = 0.16;
+/** How much a quarter turn to the side leans the pair, in degrees. */
+const TURN_LEAN = 22;
