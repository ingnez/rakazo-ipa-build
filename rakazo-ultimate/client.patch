diff --git a/packages/contracts/src/scenario-models.test.ts b/packages/contracts/src/scenario-models.test.ts
new file mode 100644
index 000000000..2a49a7044
--- /dev/null
+++ b/packages/contracts/src/scenario-models.test.ts
@@ -0,0 +1,64 @@
+import { describe, expect, it } from "vitest";
+import {
+  isScenarioRoleKey,
+  modelSupportsScenarioSlot,
+  SCENARIO_DEFAULT_THINKING,
+  SCENARIO_SLOTS,
+  ScenarioSlotIdSchema,
+  ScenarioSlotSchema,
+  ScenarioSlotUpdateSchema,
+  scenarioRoleKey,
+  scenarioThinkingLevel,
+} from "./scenario-models.js";
+
+describe("scenario slots", () => {
+  it("keeps 日常帮助 as one of the six scenes beside the server roles", () => {
+    expect(SCENARIO_SLOTS).toEqual(["daily", "fast", "code", "heavy", "image", "video"]);
+    expect(ScenarioSlotSchema.options).toEqual([...SCENARIO_SLOTS]);
+    // The five scenes without a role are the ones that store their own choice.
+    expect(ScenarioSlotIdSchema.options).toEqual(["fast", "code", "heavy", "image", "video"]);
+  });
+
+  it("runs each scene at its own effort until the person picks another", () => {
+    expect(SCENARIO_DEFAULT_THINKING).toEqual({
+      fast: "minimal",
+      code: "medium",
+      heavy: "high",
+      image: null,
+      video: null,
+    });
+    expect(scenarioThinkingLevel("fast", undefined)).toBe("minimal");
+    expect(scenarioThinkingLevel("code", null)).toBe("medium");
+    expect(scenarioThinkingLevel("heavy", "low")).toBe("low");
+    expect(scenarioThinkingLevel("image", "high")).toBe("high");
+    expect(scenarioThinkingLevel("video", undefined)).toBeNull();
+  });
+
+  it("stores a scene's choice under a name no role uses", () => {
+    expect(scenarioRoleKey("fast")).toBe("scenario:fast");
+    expect(isScenarioRoleKey("scenario:heavy")).toBe(true);
+    for (const role of ["main", "approval", "computer", "scenario:", "scenario:chat"]) {
+      expect(isScenarioRoleKey(role)).toBe(false);
+    }
+  });
+
+  it("refuses a scene it does not have and reads 日常帮助 as a scene", () => {
+    expect(ScenarioSlotUpdateSchema.safeParse({ slot: "daily" }).success).toBe(true);
+    expect(ScenarioSlotUpdateSchema.safeParse({ slot: "fast", primary: null }).success).toBe(true);
+    expect(ScenarioSlotUpdateSchema.safeParse({ slot: "video" }).success).toBe(true);
+    expect(ScenarioSlotUpdateSchema.safeParse({ slot: "approval" }).success).toBe(false);
+    expect(ScenarioSlotUpdateSchema.safeParse({ slot: "computer" }).success).toBe(false);
+    expect(
+      ScenarioSlotUpdateSchema.safeParse({
+        slot: "code",
+        primary: { provider: "openai", modelId: "gpt-5", thinkingLevel: "high" },
+      }).success,
+    ).toBe(true);
+  });
+
+  it("offers a scene every chat model but never a decision model", () => {
+    expect(modelSupportsScenarioSlot({})).toBe(true);
+    expect(modelSupportsScenarioSlot({ protocol: "chat" })).toBe(true);
+    expect(modelSupportsScenarioSlot({ protocol: "decisions" })).toBe(false);
+  });
+});
diff --git a/packages/contracts/src/scenario-models.ts b/packages/contracts/src/scenario-models.ts
new file mode 100644
index 000000000..9b62734bc
--- /dev/null
+++ b/packages/contracts/src/scenario-models.ts
@@ -0,0 +1,128 @@
+import { z } from "zod";
+import type { ThinkingLevel } from "./ids.js";
+import { ThinkingLevelSchema } from "./ids.js";
+import { modelChoiceListSchema } from "./model-connections.js";
+import { ModelRoleChoiceSchema } from "./model-roles.js";
+import { SettingsScopeSchema } from "./settings-scope.js";
+
+/**
+ * The six scenes a person configures a model for. 日常帮助 (`daily`) is the server's own `main`
+ * role, so runs, backups and deployment defaults keep working unchanged; the other five are
+ * scenes the server did not have before and they are stored beside the roles, never in
+ * `approval` or `computer`.
+ */
+export const SCENARIO_SLOT_IDS = ["fast", "code", "heavy", "image", "video"] as const;
+export const ScenarioSlotIdSchema = z.enum(SCENARIO_SLOT_IDS);
+export type ScenarioSlotId = z.infer<typeof ScenarioSlotIdSchema>;
+
+/** Every scene a person can point at a model, 日常帮助 included. */
+export const SCENARIO_SLOTS = ["daily", ...SCENARIO_SLOT_IDS] as const;
+export const ScenarioSlotSchema = z.enum(SCENARIO_SLOTS);
+export type ScenarioSlot = z.infer<typeof ScenarioSlotSchema>;
+
+/**
+ * The effort a scene runs at until the person picks another one: a quick answer must not wait
+ * for reasoning, an analysis or a long job should spend it, and a picture or a video has
+ * nothing to think about.
+ */
+export const SCENARIO_DEFAULT_THINKING: Record<ScenarioSlotId, ThinkingLevel | null> = {
+  fast: "minimal",
+  code: "medium",
+  heavy: "high",
+  image: null,
+  video: null,
+};
+
+/** How a slot's choice is stored: the same `role` column, under a name no role uses. */
+export const SCENARIO_ROLE_PREFIX = "scenario:";
+export type ScenarioRoleKey = `${typeof SCENARIO_ROLE_PREFIX}${ScenarioSlotId}`;
+
+export function scenarioRoleKey(slot: ScenarioSlotId): ScenarioRoleKey {
+  return `${SCENARIO_ROLE_PREFIX}${slot}`;
+}
+
+/** True for a stored `role` value that belongs to a scene rather than to a role. */
+export function isScenarioRoleKey(role: string): role is ScenarioRoleKey {
+  return (
+    role.startsWith(SCENARIO_ROLE_PREFIX) &&
+    ScenarioSlotIdSchema.safeParse(role.slice(SCENARIO_ROLE_PREFIX.length)).success
+  );
+}
+
+/** A role name or a scene's stored name: what the role tables hold in their `role` column. */
+export type ModelRoleKey = "main" | "approval" | "computer" | ScenarioRoleKey;
+
+export const ScenarioSlotSettingsSchema = z.object({
+  primary: ModelRoleChoiceSchema.nullable(),
+  backups: modelChoiceListSchema(ModelRoleChoiceSchema),
+});
+export type ScenarioSlotSettings = z.infer<typeof ScenarioSlotSettingsSchema>;
+
+/** Where a scene's model comes from when its own choice is empty. */
+export const ScenarioSlotSourceSchema = z.enum(["slot", "daily", "deployment", "none"]);
+export type ScenarioSlotSource = z.infer<typeof ScenarioSlotSourceSchema>;
+
+export const ScenarioSlotViewSchema = ScenarioSlotSettingsSchema.extend({
+  slot: ScenarioSlotSchema,
+  /** The scene's own choice; empty means it follows what `source` names. */
+  source: ScenarioSlotSourceSchema,
+  /** The effort a run of this scene uses: the choice's, else the scene's default. */
+  thinkingLevel: ThinkingLevelSchema.nullable(),
+  /** The model a run of this scene would actually start on, as far as this account can see. */
+  resolved: z
+    .object({
+      provider: z.string(),
+      modelId: z.string(),
+      credentialId: z.string().optional(),
+    })
+    .nullable(),
+});
+export type ScenarioSlotView = z.infer<typeof ScenarioSlotViewSchema>;
+
+export const ScenarioModelsViewSchema = z.object({
+  slots: z.array(ScenarioSlotViewSchema),
+});
+export type ScenarioModelsView = z.infer<typeof ScenarioModelsViewSchema>;
+
+/**
+ * Writing one scene. `primary: null` clears it, which makes the scene follow 日常帮助 again;
+ * omitting both lists keeps what is there. 日常帮助 writes the `main` role.
+ */
+export const ScenarioSlotUpdateSchema = z.object({
+  slot: ScenarioSlotSchema,
+  primary: ModelRoleChoiceSchema.nullable().optional(),
+  backups: modelChoiceListSchema(ModelRoleChoiceSchema).optional(),
+  scope: SettingsScopeSchema.optional(),
+});
+export type ScenarioSlotUpdate = z.infer<typeof ScenarioSlotUpdateSchema>;
+
+/**
+ * What may be picked for a scene: everything a chat model can be, which is the `main` role's
+ * own catalog. Decision models answer approvals only, and computer mode keeps its own role.
+ */
+export function modelSupportsScenarioSlot(entry: { protocol?: string | null | undefined }): boolean {
+  return entry.protocol !== "decisions";
+}
+
+/**
+ * The scene a message belongs to, as the intent router reads it. `daily` means no scene was
+ * recognised and the 日常帮助 model answers.
+ */
+export type ScenarioIntent = ScenarioSlot;
+
+/** A named scene with the label the app shows for it. */export const SCENARIO_LABELS: Record<ScenarioSlot, string> = {
+  daily: "日常帮助",
+  fast: "快速解答",
+  code: "代码与分析",
+  heavy: "高难任务",
+  image: "生图模型",
+  video: "生视频模型",
+};
+
+/** The effort a scene runs at: its own choice, else the scene's default. */
+export function scenarioThinkingLevel(
+  slot: ScenarioSlotId,
+  chosen: ThinkingLevel | null | undefined,
+): ThinkingLevel | null {
+  return chosen ?? SCENARIO_DEFAULT_THINKING[slot];
+}
