+  const sections: string[] = [];
+  let remainingBytes = maxBytes - fixedBytes;
+  let ranOut = false;
+  for (const document of documents) {
+    if (ranOut) {
+      plan.omitted.push(leaveOut(document));
+      continue;
+    }
+    // The bot sees how full its memory is, so it tidies before a save is refused.
+    const usage =
