@@ -0,0 +1,248 @@
+import { typeScale } from "@rakazo/ui-tokens";
+import type { ReactNode } from "react";
+import { Children, Fragment, isValidElement } from "react";
+import type { PressableProps, ViewStyle } from "react-native";
+import {
+  Platform,
+  Pressable,
+  StyleSheet,
+  Text,
+  useWindowDimensions,
+  View,
+} from "react-native";
+import { mobileTokens } from "../../lib/appearance";
+import { native, useThemedStyles } from "../../lib/native";
+import { androidRipple } from "../../lib/ripple";
+import { stacksAtTextScale } from "../../lib/text-scale";
+import { Chevron } from "../row-accessories";
+import {
+  GROUP_GAP,
+  ROW_LEADING_INSET,
+  ROW_MIN_HEIGHT,
+  ROW_TRAILING_INSET,
+  SAND_RADIUS,
+  SHEET_CONTENT_PADDING,
+} from "./metrics";
+
+/** Whether the page has to stack its rows: a large type size leaves no room for a value beside a title. */
+export function useStackedInsetGroup(): boolean {
+  return stacksAtTextScale(useWindowDimensions().fontScale);
+}
+
+/**
+ * One grouped card: an optional label above it, the rows inside one rounded surface, and an
+ * optional footer under it.
+ *
+ * This is the tile most of the app's second-level pages are made of. The card's radius, the row
+ * dividers' leading inset and the gap between one group and the next come from the sand metrics,
+ * so every page that uses it lands on the same numbers. A large type size stacks the rows rather
+ * than letting a value squeeze a title to two letters.
+ */
+export function InsetGroup({
+  label,
+  accessibilityLabel,
+  footer,
+  radius = "md",
+  children,
+  style,
+}: {
+  label?: string;
+  accessibilityLabel?: string;
+  footer?: string;
+  /** The card's corner: a settings group is 16, a wide group 20. */
+  radius?: "md" | "lg";
+  children: ReactNode;
+  style?: ViewStyle;
+}) {
+  const styles = useThemedStyles(createInsetStyles);
+  const stacked = useStackedInsetGroup();
+  const rows = Children.toArray(children).filter(isValidElement);
+  if (rows.length === 0) return null;
+  return (
+    <View accessibilityLabel={accessibilityLabel} style={[styles.group, style]}>
+      {label ? <InsetGroupLabel>{label}</InsetGroupLabel> : null}
+      <View style={[styles.card, { borderRadius: SAND_RADIUS[radius] }]}>
+        {rows.map((row, index) => (
+          <Fragment key={row.key}>
+            {index > 0 ? (
+              <View style={[styles.separator, stacked && styles.compactSeparator]} />
+            ) : null}
+            {row}
+          </Fragment>
+        ))}
+      </View>
+      {footer ? <InsetGroupFooter>{footer}</InsetGroupFooter> : null}
+    </View>
+  );
+}
+
+export function InsetGroupLabel({ children }: { children: string }) {
+  const styles = useThemedStyles(createInsetStyles);
+  const stacked = useStackedInsetGroup();
+  return (
+    <Text accessibilityRole="header" style={[styles.groupLabel, stacked && styles.compactLabel]}>
+      {children}
+    </Text>
+  );
+}
+
+export function InsetGroupFooter({ children }: { children: string }) {
+  const styles = useThemedStyles(createInsetStyles);
+  const stacked = useStackedInsetGroup();
+  return <Text style={[styles.footer, stacked && styles.compactLabel]}>{children}</Text>;
+}
+
+type InsetRowProps = Omit<PressableProps, "children" | "style"> & {
+  title: string;
+  detail?: string;
+  /** The value at the row's trailing edge, in the secondary colour. */
+  value?: string;
+  chevron?: "right" | "down";
+  prominent?: boolean;
+  destructive?: boolean;
+  tinted?: boolean;
+  dimmed?: boolean;
+  leading?: ReactNode;
+  trailing?: ReactNode;
+};
+
+/** One row inside an `InsetGroup`: a leading glyph, a title with an optional detail, a value. */
+export function InsetRow({
+  title,
+  detail,
+  value,
+  chevron,
+  prominent,
+  destructive,
+  tinted,
+  dimmed,
+  leading,
+  trailing,
+  ...props
+}: InsetRowProps) {
+  const styles = useThemedStyles(createInsetStyles);
+  const stacked = useStackedInsetGroup();
+  const end = (
+    <>
+      {value ? (
+        <Text
+          numberOfLines={stacked ? undefined : 1}
+          style={[styles.value, !stacked && styles.inlineValue]}
+        >
+          {value}
+        </Text>
+      ) : null}
+      {trailing}
+    </>
+  );
+  const content = (
+    <>
+      {leading}
+      <View style={styles.titleColumn}>
+        <Text
+          style={[
+            styles.title,
+            prominent && styles.prominent,
+            tinted && styles.tinted,
+            destructive && styles.destructive,
+          ]}
+        >
+          {title}
+        </Text>
+        {detail ? <Text style={styles.detail}>{detail}</Text> : null}
+        {stacked ? end : null}
+      </View>
+      {stacked ? null : end}
+      {chevron ? (
+        <View accessibilityElementsHidden importantForAccessibility="no-hide-descendants">
+          <Chevron expanded={chevron === "down"} />
+        </View>
+      ) : null}
+    </>
+  );
+  if (!props.onPress) {
+    return (
+      <View
+        accessible={props.accessible}
+        accessibilityActions={props.accessibilityActions}
+        accessibilityHint={props.accessibilityHint}
+        accessibilityLabel={props.accessibilityLabel}
+        accessibilityRole={props.accessibilityRole}
+        accessibilityState={props.accessibilityState}
+        accessibilityValue={props.accessibilityValue}
+        onAccessibilityAction={props.onAccessibilityAction}
+        style={[styles.row, stacked && styles.compactRow, dimmed && styles.dimmed]}
+      >
+        {content}
+      </View>
+    );
+  }
+  return (
+    <Pressable
+      {...props}
+      android_ripple={androidRipple()}
+      style={({ pressed }) => [
+        styles.row,
+        stacked && styles.compactRow,
+        pressed && Platform.OS !== "android" && styles.pressed,
+        dimmed && styles.dimmed,
+      ]}
+    >
+      {content}
+    </Pressable>
+  );
+}
+
+function createInsetStyles() {
+  const tokens = mobileTokens();
+  return StyleSheet.create({
+    // One group 8 clear of the next, as the reference's sheet lays them out.
+    group: { gap: GROUP_GAP },
+    groupLabel: {
+      color: native.secondaryLabel,
+      ...typeScale.caption,
+      paddingStart: SHEET_CONTENT_PADDING,
+    },
+    footer: {
+      color: native.secondaryLabel,
+      ...typeScale.caption,
+      paddingHorizontal: SHEET_CONTENT_PADDING,
+    },
+    card: {
+      borderCurve: "continuous",
+      overflow: "hidden",
+      backgroundColor: native.groupedCell,
+    },
+    separator: {
+      // iOS draws sheets scaled down slightly, which makes a one-pixel line fall between
+      // pixels and vanish at some offsets. Two pixels always leave at least one visible.
+      height: StyleSheet.hairlineWidth * 2,
+      marginStart: ROW_LEADING_INSET,
+      backgroundColor: native.separator,
+    },
+    row: {
+      minHeight: ROW_MIN_HEIGHT,
+      paddingStart: ROW_LEADING_INSET,
+      paddingEnd: ROW_TRAILING_INSET,
+      paddingVertical: 12,
+      flexDirection: "row",
+      alignItems: "center",
+      gap: 12,
+    },
+    compactLabel: { paddingStart: 12 },
+    compactSeparator: { marginStart: 12 },
+    compactRow: { paddingStart: 12, paddingEnd: 12, gap: 8 },
+    titleColumn: { flex: 1, flexShrink: 1, gap: 2 },
+    title: { color: native.label, fontSize: 17 },
+    prominent: { fontSize: 20, fontWeight: "600" },
+    detail: { color: native.secondaryLabel, ...typeScale.caption },
+    destructive: { color: tokens.destructive },
+    tinted: { color: tokens.link },
+    value: { flexShrink: 1, color: native.secondaryLabel, fontSize: 17 },
+    // A long value truncates instead of pushing the title out of the row.
+    inlineValue: { maxWidth: "60%" },
+    pressed: { backgroundColor: native.fillPressed },
+    dimmed: { opacity: 0.45 },
+  });
+}
+
