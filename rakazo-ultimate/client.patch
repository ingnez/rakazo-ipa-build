+      {sent ? (
+        <View style={styles.sentRow}>
+          <NativeSymbol ios="checkmark.circle.fill" android="checkmark-circle" size={16} color={tokens.mutedForeground} />
+          <Text style={[styles.sentText, { color: tokens.mutedForeground }]}>已提交给 Bot</Text>
+        </View>
+      ) : (
+        <View style={styles.footer}>
+          {page > 0 ? (
+            <Pressable
+              accessibilityRole="button"
+              accessibilityLabel="上一题"
+              disabled={sending}
+              onPress={() => setPage((current) => Math.max(0, current - 1))}
+              style={({ pressed }) => [
+                styles.pageButton,
+                { backgroundColor: pressed ? native.fill : native.fillPressed },
+              ]}
+            >
+              <NativeSymbol ios="chevron.left" android="chevron-back" size={13} color={tokens.mutedForeground} />
+              <Text style={[styles.pageButtonText, { color: tokens.foreground }]}>上一题</Text>
+            </Pressable>
+          ) : null}
+          {last ? (
+            <Pressable
+              accessibilityRole="button"
+              accessibilityLabel="提交答卷"
+              accessibilityState={{ disabled: locked || sending || readOnly }}
+              disabled={locked || sending || readOnly}
+              onPress={() => void send()}
+              style={({ pressed }) => [
+                styles.submit,
+                {
+                  backgroundColor: pressed ? native.fillPressed : native.fill,
+                  opacity: sending ? 0.7 : 1,
+                },
+              ]}
+            >
+              {sending ? (
+                <ActivityIndicator size="small" color={tokens.mutedForeground} />
+              ) : (
+                <NativeSymbol ios="paperplane.fill" android="send" size={14} color={tokens.foreground} />
+              )}
+              <Text style={[styles.submitText, { color: tokens.foreground }]}>
+                {`提交答卷 ${answered}/${questions.length}`}
+              </Text>
+            </Pressable>
+          ) : (
+            <Pressable
+              accessibilityRole="button"
+              accessibilityLabel="下一题"
+              disabled={sending}
+              onPress={() => setPage((current) => Math.min(questions.length - 1, current + 1))}
+              style={({ pressed }) => [
+                styles.submit,
+                { backgroundColor: pressed ? native.fillPressed : native.fill },
+              ]}
+            >
+              <Text style={[styles.submitText, { color: tokens.foreground }]}>下一题</Text>
+              <NativeSymbol ios="chevron.right" android="chevron-forward" size={13} color={tokens.mutedForeground} />
+            </Pressable>
+          )}
+        </View>
+      )}
+    </View>
+  );
+}
+
+/** The card's own starting state: what the server saved when the sheet was sent. */
+function picksFromAnswers(
+  questions: ChoiceQuestion[],
+  answers: ChoiceAnswer[] | undefined,
+): Record<number, string[]> {
+  const picks: Record<number, string[]> = {};
+  if (!answers?.length) return picks;
+  questions.forEach((question, index) => {
+    const saved =
+      answers.find((answer) => (question.id ? answer.questionId === question.id : false)) ??
+      answers[index];
+    if (saved?.optionIds.length) picks[index] = [...saved.optionIds];
+  });
+  return picks;
+}
+
+/**
+ * The message the bot receives: the card's name, then each question with the letters picked. It
+ * reads as an answer sheet, so a bot that marks a quiz can find every question and choice.
+ */
+export function answerSheetText(
+  title: string,
+  questions: ChoiceQuestion[],
+  answers: ChoiceAnswer[],
+): string {
+  const lines = questions.map((question, index) => {
+    const picked = answers[index]?.optionIds ?? [];
+    const letters = question.options
+      .filter((option) => picked.includes(option.id))
+      .map((option) => option.letter);
+    const body = letters.length ? letters.join("") : "未作答";
+    return `${index + 1}. ${question.question}\n${body}`;
+  });
+  return [title, ...lines].filter((line) => line.trim().length > 0).join("\n");
+}
