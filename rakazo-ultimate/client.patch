+/**
+ * The composer's own dictation path, which is not the call path.
+ *
+ * A message dictated into the box is text, not a voice, so it goes to the phone's free on-device
+ * recognizer first — whether or not the user turned local voice off in Settings to get a hosted
+ * voice for calls. Only when the phone cannot recognize speech itself (or was never allowed to)
+ * does it fall back to the connected provider's transcription.
+ */
+export async function resolveComposerDictationPlan(deps: {
+  deviceDictation: () => Promise<boolean>;
+  loadVoiceStatus: () => Promise<VoiceCallStatus>;
+}): Promise<VoiceCallPlan> {
+  try {
+    if (await deps.deviceDictation()) return { kind: "device", transcribe: false };
+  } catch {
+    // A recognizer that cannot be asked is not one to use.
+  }
+  const status = await deps.loadVoiceStatus().catch(() => ({ ready: false, transcribe: false }));
+  if (status.ready && status.transcribe) return { kind: "provider", transcribe: true };
+  return { kind: "dictation" };
+}
