+  // Files.
+  { match: /^(Reading|Turning to) /i, key: "read-file", label: () => t`正在读文件` },
+  { match: /^(Writing|Saving the file) /i, key: "write-file", label: () => t`正在写文件` },
+  { match: /^(Listing|Looking through) /i, key: "list-files", label: () => t`正在翻看目录` },
+  { match: /^(Attaching|Opening) /i, key: "attach-file", label: () => t`正在整理文件` },
+  { match: /^Moving files over\b/i, key: "attach-file", label: () => t`正在整理文件` },
