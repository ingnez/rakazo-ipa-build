+/**
+ * Runs `resume` when the app comes back from the background, which is when a connection the
+ * system put to sleep has to be picked up again.
+ */
+export function useAppResume(resume: () => unknown): void {
+  const latest = useRef(resume);
+  latest.current = resume;
