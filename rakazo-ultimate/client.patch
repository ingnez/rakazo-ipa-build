diff --git a/apps/mobile/modules/rakazo-connectors/ios/RakazoConnectorsModule.swift b/apps/mobile/modules/rakazo-connectors/ios/RakazoConnectorsModule.swift
new file mode 100644
index 000000000..1616ee91e
--- /dev/null
+++ b/apps/mobile/modules/rakazo-connectors/ios/RakazoConnectorsModule.swift
@@ -0,0 +1,35 @@
+import ExpoModulesCore
+import Foundation
+
+/// The iPhone's own connectors, as one module: Expo's bridge in front, one file per framework.
+///
+/// The JavaScript side asks three things — how a permission stands, for that permission to be
+/// asked, and for one of the twelve phone methods to run. Every answer travels as JSON text so a
+/// dictionary shape can never be half-bridged, and a refusal is one of the server's own words:
+/// `switch_off`, `permission_denied`, `unavailable`, `not_found`, `invalid`.
+public class RakazoConnectorsModule: Module {
+  public func definition() -> ModuleDefinition {
+    Name("RakazoConnectors")
+
+    /// What iOS answers right now, without asking the person anything.
+    AsyncFunction("permission") { (kind: String, promise: Promise) in
+      Task { @MainActor in
+        promise.resolve(PhonePermissions.state(kind))
+      }
+    }
+
+    /// The system's own question, shown once per permission.
+    AsyncFunction("requestPermission") { (kind: String, promise: Promise) in
+      Task { @MainActor in
+        promise.resolve(await PhonePermissions.request(kind))
+      }
+    }
+
+    /// One of the twelve methods the server sends the phone.
+    AsyncFunction("run") { (method: String, argsJson: String, promise: Promise) in
+      Task { @MainActor in
+        promise.resolve(await PhoneConnectorRunner.run(method: method, argsJson: argsJson))
+      }
+    }
+  }
+}
