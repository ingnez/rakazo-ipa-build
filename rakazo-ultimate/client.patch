new file mode 100644
index 0000000..ff2f376
--- /dev/null
+++ b/scripts/generate-bot-motion-clips.py
@@ -0,0 +1,292 @@
+#!/usr/bin/env python3
+"""Turn the extracted Grok Bot 1.25.0 clip data into the TypeScript the app plays.
+
+Input  : rakazo-study/hbc-constants/clips-full.json (28 clips / 350 keyframes / 53 states)
+Output : packages/core/src/bot-motion-clips-data.ts
+
+The official clips are stored in *body width* units for position, degrees for rotation and a
+uniform scale whose resting value is 0.6; the app's player speaks radius-relative position and a
+zoom of 1 at rest, so the conversion happens here once instead of at runtime.
+"""
+
+import json
+import pathlib
+
+ROOT = pathlib.Path(__file__).resolve().parent.parent
+STUDY = ROOT.parent.parent / "rakazo-study" / "hbc-constants"
+SOURCE = STUDY / "clips-full.json"
+TARGET = ROOT / "packages" / "core" / "src" / "bot-motion-clips-data.ts"
+
+# The scale every idle clip holds; dividing by it makes the resting body exactly 1.0.
+REST_SCALE = 0.6
+
+
+def unwrap_rotation(values):
+    """Angles may be stored beyond a full turn (and as unsigned 32-bit): make them continuous."""
+    out = []
+    for value in values:
+        if value > 1_000_000_000:
+            value -= 2**32
+        if out:
+            previous = out[-1]
+            value += 360 * round((previous - value) / 360)
+        out.append(round(value, 4))
+    return out
+
+
+def ease_points(key):
+    ease = key.get("ease") or [0.42, 0, 0.58, 1]
+    return "[" + ",".join(f"{v:.6g}" for v in ease) + "]"
+
+
+def values(values):
+    return "[" + ",".join(f"{v:.6g}" for v in values) + "]"
+
+
+def keyframes(track, transform=None):
+    if not track:
+        return None
+    lines = []
+    for key in track:
+        raw = key["v"]
+        raw = raw if isinstance(raw, list) else [raw]
+        if transform:
+            raw = transform(raw)
+        lines.append(f"[{key['t']:.6g},{values(raw)},{ease_points(key)}]")
+    return "[" + ",".join(lines) + "]"
+
+
+def number_list(track, transform=None):
+    if not track:
+        return None
+    out = []
+    for key in track:
+        raw = key["v"]
+        if transform:
+            raw = transform(raw)
+        out.append(round(raw[0], 6))
+    return "[" + ",".join(f"{v:.6g}" for v in out) + "]"
+
+
+def unwrap_track(track):
+    """Rotation keys unwrap against the previous value, so a spin stays a spin."""
+    if not track:
+        return None
+    lines = []
+    previous = None
+    for key in track:
+        raw = []
+        for value in key["v"]:
+            if value > 1_000_000_000:
+                value -= 2**32
+            if previous is not None:
+                # Compare with the same axis of the previous key.
+                index = len(raw)
+                if index < len(previous):
+                    value += 360 * round((previous[index] - value) / 360)
+            raw.append(round(value, 4))
+        previous = raw
+        lines.append(f"[{key['t']:.6g},{values(raw)},{ease_points(key)}]")
+    return "[" + ",".join(lines) + "]"
+
+
+def main():
+    data = json.loads(SOURCE.read_text())
+    clips = {clip["name"]: clip for clip in data["clips"]}
+
+    out = []
+    out.append("// Generated by scripts/generate-bot-motion-clips.py from")
+    out.append("// rakazo-study/hbc-constants/clips-full.json (Grok Bot 1.25.0, main.jsbundle).")
+    out.append("// Do not edit by hand: rerun the script.")
+    out.append("")
+    out.append('import type { AvatarKey, AvatarClip } from "./avatar-clips.js";')
+    out.append("")
+    out.append("export interface MotionClipData {")
+    out.append("  duration: number;")
+    out.append("  /** The body the clip was authored on (official alias, e.g. `sphere`). */")
+    out.append("  body: string;")
+    out.append("  /** Where a squash is anchored along the body, or -1 for none. */")
+    out.append("  squashAnchor: number;")
+    out.append("  /** Seconds of the clip that actually play, stretched over the whole duration. */")
+    out.append("  workArea: readonly [number, number] | null;")
+    out.append("  position?: readonly AvatarKey[];")
