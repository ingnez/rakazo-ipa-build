+      vi.useFakeTimers();
+      const loaded = vi.fn();
+      void lastBot.loadLastBotId().then(loaded);
+      await vi.advanceTimersByTimeAsync(1_000);
+      expect(loaded).toHaveBeenCalledExactlyOnceWith("");
+      vi.useRealTimers();
+      await restart();
+      expect(await lastBot.loadLastBotId()).toBe("");
+    },
+  );
+});
