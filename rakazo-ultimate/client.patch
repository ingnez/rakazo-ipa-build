+      expect(contrastRatio(color.hex, "#FFFFFF"), color.id).toBeGreaterThanOrEqual(1.5);
+      expect(contrastRatio(color.darkHex!, "#121214"), color.id).toBeGreaterThanOrEqual(2);
+    }
