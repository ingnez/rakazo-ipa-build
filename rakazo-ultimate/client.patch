+          role: "bot",
+          blocks: [{ kind: "text", text: "from the discarded snapshot" }],
+        },
+      },
+      {
+        type: "thread.message.created",
+        seq: 5,
+        payload: {
+          messageId: "also-missed",
+          role: "bot",
+          blocks: [{ kind: "text", text: "also only in that snapshot" }],
+        },
+      },
+    ];
+    return events.reduce<MobileSnapshot>(
+      (view, event) => (event.seq > cursor ? (reduceThreadSnapshot(view, event) ?? view) : view),
+      onScreen,
+    );
+  }
+
+  it("shows events only a discarded refresh had seen when a newer refresh fails", () => {
+    for (const discard of [{ currentGeneration: 2 }, { currentEpoch: 2 }]) {
+      const result = mobileThreadRefreshResult({ ...gate, ...discard });
+      const shown = shownAfter(result.snapshot?.cursor ?? -1);
+      expect(result.commit).toBe(false);
+      expect(shown.messages.map((message) => message.id)).toEqual([
+        "shown",
+        "missed",
+        "also-missed",
+      ]);
+    }
+  });
+
+  it("keeps a live message applied while a refresh snapshot was in flight", () => {
+    const live = reduceThreadSnapshot(fetched, {
+      type: "thread.message.created",
+      seq: 6,
+      payload: {
+        messageId: "new-live-message",
+        role: "user",
+        blocks: [{ kind: "text", text: "New message" }],
+      },
+    })!;
+    const result = mobileThreadRefreshResult({ ...gate, onScreen: live });
+    expect(result.commit).toBe(false);
+    expect(result.snapshot).toBe(live);
+    expect(result.snapshot?.messages.at(-1)?.id).toBe("new-live-message");
+    expect(result.snapshot?.cursor).toBe(6);
+    expect(mobileThreadRefreshResult({ ...gate, onScreen: fetched }).commit).toBe(true);
+  });
+
+  it("starts the subscription at a snapshot the refresh committed", () => {
+    const result = mobileThreadRefreshResult(gate);
+    expect(result.commit).toBe(true);
+    expect(result.snapshot?.cursor).toBe(fetched.cursor);
+  });
+});
+
+describe("mobile thread event reduction", () => {
+  it("prepends ordered history pages without duplicating the boundary message", () => {
+    const initial = snapshot([mobileMessage("m-2", [], 2), mobileMessage("m-3", [], 3)], 2);
+
+    const next = prependMobileMessagePage(initial, {
+      threadId: "thread-1",
+      messages: [
+        mobileMessage("m-0", [], 0),
+        mobileMessage("m-1", [], 1),
+        mobileMessage("m-2", [], 2),
+      ],
+      olderCursor: null,
+    });
+
+    expect(next?.messages.map((item) => item.id)).toEqual(["m-0", "m-1", "m-2", "m-3"]);
+    expect(next?.olderCursor).toBeNull();
+  });
+
+  it("retains loaded history across refresh while dropping stale progress", () => {
+    const initial = snapshot(
+      [
+        mobileMessage("m-0", [], 0),
+        mobileMessage("m-1", [], 1),
+        mobileMessage("progress:run-1", [{ kind: "progress", text: "draft" }], 8),
+      ],
+      null,
+    );
+    const refreshed = snapshot([mobileMessage("m-1", [], 1), mobileMessage("m-2", [], 2)], 1);
+
+    const next = mergeThreadSnapshot(initial, refreshed, true);
+
+    expect(next.messages.map((item) => item.id)).toEqual(["m-0", "m-1", "m-2"]);
+    expect(next.olderCursor).toBeNull();
+  });
+
+  it("holds live tool steps until mobile narration reaches a sentence boundary", () => {
+    const narration = reduceThreadSnapshot(snapshot(), {
+      type: "thread.progress",
+      runId: "run-1",
+      payload: { text: "Let me check " },
+    });
+    const pending = reduceThreadSnapshot(narration, {
+      type: "agent.tool.called",
+      runId: "run-1",
+      payload: { name: "SLACK_FIND_CHANNELS" },
+    });
+    const completed = reduceThreadSnapshot(pending, {
+      type: "thread.progress",
+      runId: "run-1",
+      payload: { delta: "now." },
+    });
+
+    expect(pending?.messages[0]?.blocks).toEqual([
+      {
+        kind: "progress",
+        text: "Let me check ",
+        pendingToolNames: ["SLACK_FIND_CHANNELS"],
+      },
+    ]);
+    expect(completed?.messages[0]?.blocks).toEqual([
+      { kind: "text", text: "Let me check now." },
+      { kind: "steps", steps: [{ label: "Slack find channels", count: 1 }] },
+    ]);
+    expect(blockText(completed?.messages[0] as MobileMessage)).toBe(
+      "Let me check now.\nSlack find channels",
+    );
+  });
+
+  it("formats channel messages with their platform attribution", () => {
+    expect(
+      blockText(
+        mobileMessage("channel-1", [
+          {
+            kind: "channel_message",
+            provider: "sendblue",
+            transport: "SMS",
+            channelId: "ch-1",
+            fromAddress: "+15551234567",
+            fromLabel: "Alex",
+            text: "Hello from the group",
+          },
+        ]),
+      ),
+    ).toBe("Alex (SMS): Hello from the group");
+    expect(
+      blockText(
+        mobileMessage("channel-2", [
+          {
+            kind: "channel_message",
+            provider: "slack",
+            channelId: "ch-2",
+            fromAddress: "U123456",
+            fromLabel: "Alex",
+            text: "Hello from the group",
+          },
+        ]),
+      ),
+    ).toBe("Alex (Slack): Hello from the group");
+  });
+
+  it("lets a newer refresh replace waiting_takeover with queued", () => {
+    const waiting: MobileSnapshot = {
+      ...snapshot(),
+      cursor: 10,
+      run: { id: "run-1", status: "waiting_takeover" },
+      activeRuns: [{ id: "run-1", status: "waiting_takeover" }],
+    };
+    const refreshed: MobileSnapshot = {
+      ...snapshot(),
+      cursor: 12,
+      run: { id: "run-1", status: "queued" },
+      activeRuns: [{ id: "run-1", status: "queued" }],
+    };
+
+    const next = mergeThreadSnapshot(waiting, refreshed);
+
+    expect(next.cursor).toBe(12);
+    expect(next.run?.status).toBe("queued");
+    expect(next.activeRuns?.[0]?.status).toBe("queued");
+  });
+
+  it("starts an idle run from live events and selects the active safety cadence", () => {
+    const initial: MobileSnapshot = { ...snapshot(), run: null, activeRuns: [] };
+    expect(threadRefreshDelayMs(initial.run?.status, { liveSubscribed: true })).toBe(60_000);
+    const started = reduceThreadSnapshot(initial, {
+      type: "run.started",
+      runId: "run-remote",
+      botId: "bot-1",
+      seq: 12,
+      payload: { trigger: "routine" },
+    });
+    expect(started?.cursor).toBe(12);
+    expect(started?.run).toMatchObject({
+      id: "run-remote",
+      botId: "bot-1",
+      status: "running",
+      trigger: "routine",
+      error: null,
+    });
+    expect(started?.activeRuns).toEqual([started?.run]);
+    expect(threadRefreshDelayMs(started?.run?.status, { liveSubscribed: true })).toBe(30_000);
+    const finished = reduceThreadSnapshot(started, {
+      type: "run.completed",
+      runId: "run-remote",
+      seq: 13,
+    });
+    expect(finished?.run).toBeNull();
+    expect(finished?.activeRuns).toEqual([]);
+  });
+});
diff --git a/apps/mobile/lib/api/mobile-types.ts b/apps/mobile/lib/api/mobile-types.ts
new file mode 100644
index 000000000..10535ee43
--- /dev/null
+++ b/apps/mobile/lib/api/mobile-types.ts
@@ -0,0 +1,175 @@
+import type {
+  Bot,
+  BotSection,
+  ComputerStatus,
+  Group,
+  Me,
+  ModelCatalogEntry,
+  ModelCredential,
+  Space,
+  SpaceNavigation,
+  ThreadSnapshot,
+} from "@rakazo/contracts";
+import type { LiveThreadMessage, LiveThreadRun, ThreadHistory } from "@rakazo/core";
+import { channelMessageLine, prependThreadHistoryPage } from "@rakazo/core";
+
+export type MobileBot = Pick<
+  Bot,
+  | "id"
+  | "name"
+  | "preview"
+  | "color"
+  | "avatarSet"
+  | "instructionHistory"
+  | "notifyOnFinish"
+  | "threadId"
+  | "pinned"
+  | "status"
+  | "threadStatus"
+  | "sectionId"
+  | "archivedAt"
+  | "unread"
+  | "updatedAt"
+  | "computerMode"
+  | "modelProvider"
+  | "modelId"
+  | "thinkingLevel"
+  | "autoSpeak"
+  | "fleetManagement"
+  | "crossSpaceCommunication"
+  | "dailyCheckIns"
+  | "meetingsEnabled"
+> &
+  Partial<Pick<Bot, "parentBotId" | "spaceId" | "instructions" | "snoozedUntil">>;
+export type MobileBotSection = BotSection;
+export type MobileMe = Pick<
+  Me,
+  | "userId"
+  | "name"
+  | "email"
+  | "spaceId"
+  | "defaultProvider"
+  | "defaultModel"
+  | "hostCredentialProvider"
+  | "hostCredentialSource"
+  | "needsModel"
+  | "isDeploymentOwner"
+  | "needsSignupSurvey"
+  | "billingEnabled"
+  | "paymentWalletProvider"
+  | "labs"
+  | "labsAvailable"
+  | "botAvatarSet"
+>;
+export type MobileModel = ModelCatalogEntry;
+/** Shared DTO includes headerNames only; header values remain in the server secret. */
+export type MobileModelCredential = ModelCredential;
+/** Live progress and streaming rows are shown before they have a seq, thread, or time. */
+export type MobileMessage = LiveThreadMessage;
+export type MobileGroup = Pick<
+  Group,
+  | "id"
+  | "name"
+  | "preview"
+  | "pinned"
+  | "sectionId"
+  | "archivedAt"
+  | "unread"
+  | "updatedAt"
+  | "members"
+> &
+  Partial<Pick<Group, "spaceId" | "snoozedUntil">>;
+export type MobileSpace = Space;
+export type MobileSpaceNavigation = SpaceNavigation;
+/**
+ * A thread as the screen holds it: live events patch it between refreshes, and a saved chat
+ * reopens without its cursor, runs, or computer.
+ */
+export type MobileSnapshot = Omit<
+  ThreadSnapshot,
+  "cursor" | "messages" | "run" | "activeRuns" | "computer"
+> & {
+  cursor?: ThreadSnapshot["cursor"];
+  messages: MobileMessage[];
+  run: LiveThreadRun | null;
+  activeRuns?: LiveThreadRun[];
+  computer?: Pick<
+    ComputerStatus,
+    "state" | "controlHolder" | "screenAvailable" | "mode" | "busyBotName"
+  >;
+};
+export function shouldApplyMobileThreadRefresh(input: {
+  requestEpoch: number;
+  currentEpoch: number;
+  targetBotId: string | undefined;
+  targetGroupId: string | undefined;
+  activeBotId: string | undefined;
+  activeGroupId: string | undefined;
+}) {
+  return (
+    input.requestEpoch === input.currentEpoch &&
+    input.targetBotId === input.activeBotId &&
+    input.targetGroupId === input.activeGroupId
+  );
+}
+/**
+ * What a refresh may hand the live subscription. The server replays events
+ * after this snapshot's cursor, so an uncommitted fetch must not supply it.
+ */
+export function mobileThreadRefreshResult(input: {
+  fetched: MobileSnapshot;
+  onScreen: MobileSnapshot | null;
+  requestGeneration: number;
+  currentGeneration: number;
+  requestEpoch: number;
+  currentEpoch: number;
+  targetBotId: string | undefined;
+  targetGroupId: string | undefined;
+  activeBotId: string | undefined;
+  activeGroupId: string | undefined;
+}): { commit: boolean; snapshot: MobileSnapshot | null } {
+  // Live events may advance the screen while this snapshot is in flight.
+  const commit =
+    input.requestGeneration === input.currentGeneration &&
+    shouldApplyMobileThreadRefresh(input) &&
+    (input.onScreen?.threadId !== input.fetched.threadId ||
+      (input.fetched.cursor ?? -1) >= (input.onScreen.cursor ?? -1));
+  return { commit, snapshot: commit ? input.fetched : input.onScreen };
+}
+export type MobileMessagePage = ThreadHistory<MobileMessage>;
+export function prependMobileMessagePage(
+  prev: MobileSnapshot | null,
+  page: MobileMessagePage,
+): MobileSnapshot | null {
+  return prependThreadHistoryPage(prev, page);
+}
+export function blockText(message: MobileMessage) {
+  return message.blocks
+    .map((block) => {
+      if (block.kind === "channel_message") return channelMessageLine(block);
+      if (block.kind === "cloud_agent")
+        return `${block.title}: ${block.status}${block.prUrl ? ` ${block.prUrl}` : ""}`;
+      if (block.kind === "subagent") {
+        return `${block.name ?? "subagent"}: ${block.result || block.progress || block.task || ""}`;
+      }
+      if (block.kind === "child_bot") {
+        return `${block.status === "archived" ? "Archived" : block.status === "deleted" ? "Deleted" : "Bot"} ${block.name ?? ""}`;
+      }
+      if (block.kind === "chart") return `[chart: ${block.name ?? "chart"}]`;
+      if (block.kind === "app") return `[app: ${block.server}]`;
+      if (block.kind === "tool_question") return `[question: ${block.question.source}]`;
+      if (block.kind === "page") return `[page: ${block.title}]`;
+      if (block.kind === "image") return `[image: ${block.name ?? "attachment"}]`;
+      if (block.kind === "file") {
+        return `[file: ${block.name ?? "attachment"}${block.size ? ` (${block.size} bytes)` : ""}]`;
+      }
+      if (block.kind === "steps") {
+        return (block.steps ?? [])
+          .map((step) => `${step.label}${step.count > 1 ? ` ×${step.count}` : ""}`)
+          .join(", ");
+      }
+      return ("text" in block ? block.text : "state" in block ? block.state : "") ?? "";
+    })
+    .filter(Boolean)
+    .join("\n");
+}
diff --git a/apps/mobile/lib/api/saved-servers.test.ts b/apps/mobile/lib/api/saved-servers.test.ts
new file mode 100644
index 000000000..cd975b714
--- /dev/null
+++ b/apps/mobile/lib/api/saved-servers.test.ts
@@ -0,0 +1,212 @@
+import { deferred, flush } from "@rakazo/core/test-async";
+import * as SecureStore from "expo-secure-store";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { defaultApiBase } from "./endpoint";
+import {
+  loadSavedServers,
+  MAX_SAVED_SERVERS,
+  recordSavedServer,
+  removeSavedServer,
+  savedServers,
+} from "./saved-servers";
+
+vi.mock("expo-secure-store", () => ({
+  getItemAsync: vi.fn(),
+  setItemAsync: vi.fn(),
+  deleteItemAsync: vi.fn(),
+}));
+
+const KEY = "rakazo.saved_servers";
+const ONE = "https://one.example.test";
+const TWO = "https://two.example.test";
+const ACCESS = { "CF-Access-Client-Id": "id.access", "CF-Access-Client-Secret": "secret" };
+
+let store: Map<string, string>;
+
+beforeEach(async () => {
+  vi.resetAllMocks();
+  store = new Map();
+  vi.mocked(SecureStore.getItemAsync).mockImplementation(async (key) => store.get(key) ?? null);
+  vi.mocked(SecureStore.setItemAsync).mockImplementation(async (key, value) => {
+    store.set(key, value);
+  });
+  vi.mocked(SecureStore.deleteItemAsync).mockImplementation(async (key) => {
+    store.delete(key);
+  });
+  await loadSavedServers();
+});
+
+describe("saved servers", () => {
+  it("lists the most recent server first and keeps one entry per address", async () => {
+    await recordSavedServer(ONE, {});
+    await recordSavedServer(TWO, ACCESS);
+    await recordSavedServer(ONE, ACCESS);
+    expect(savedServers()).toEqual([
+      { apiBase: ONE, headers: ACCESS },
+      { apiBase: TWO, headers: ACCESS },
+    ]);
+    await loadSavedServers();
+    expect(savedServers().map((entry) => entry.apiBase)).toEqual([ONE, TWO]);
+  });
+
+  it("never lists the default server", async () => {
+    expect(await recordSavedServer(defaultApiBase(), {})).toBe(false);
+    expect(savedServers()).toEqual([]);
+    expect(store.has(KEY)).toBe(false);
+  });
+
+  it("drops the oldest entry past the limit", async () => {
+    for (let index = 0; index <= MAX_SAVED_SERVERS; index++) {
+      await recordSavedServer(`https://s${index}.example.test`, {});
+    }
+    const hosts = savedServers().map((entry) => entry.apiBase);
+    expect(hosts).toHaveLength(MAX_SAVED_SERVERS);
+    expect(hosts).not.toContain("https://s0.example.test");
+    expect(hosts[0]).toBe(`https://s${MAX_SAVED_SERVERS}.example.test`);
+  });
+
+  it("removes one server together with its headers and nothing else", async () => {
+    await recordSavedServer(ONE, ACCESS);
+    await recordSavedServer(TWO, ACCESS);
+    expect(await removeSavedServer(ONE)).toBe(true);
+    expect(savedServers()).toEqual([{ apiBase: TWO, headers: ACCESS }]);
+    expect(store.get(KEY)).not.toContain(ONE);
+    await removeSavedServer(TWO);
+    expect(store.has(KEY)).toBe(false);
+  });
+
+  it("matches the exact address, not a prefix or another port", async () => {
+    await recordSavedServer("https://a.example", {});
+    await recordSavedServer("https://a.example.evil", {});
+    await recordSavedServer("https://a.example:8443", {});
+    await removeSavedServer("https://a.example");
+    expect(savedServers().map((entry) => entry.apiBase)).toEqual([
+      "https://a.example:8443",
+      "https://a.example.evil",
+    ]);
+  });
+
+  it("starts empty when nothing is stored, the value is damaged, or the read throws", async () => {
+    store.set(KEY, "not json");
+    await loadSavedServers();
+    expect(savedServers()).toEqual([]);
+    store.set(KEY, JSON.stringify({ apiBase: ONE }));
+    await loadSavedServers();
+    expect(savedServers()).toEqual([]);
+    vi.mocked(SecureStore.getItemAsync).mockRejectedValueOnce(new Error("locked"));
+    await loadSavedServers();
+    expect(savedServers()).toEqual([]);
+  });
+
+  it("drops an entry it could not switch to as it was saved", async () => {
+    store.set(
+      KEY,
+      JSON.stringify([
+        { apiBase: ONE, headers: { "bad header": "x" } },
+        { apiBase: `${TWO}/path`, headers: {} },
+        { apiBase: "http://public.example.test", headers: {} },
+        { apiBase: defaultApiBase(), headers: {} },
+        { apiBase: 5, headers: {} },
+        null,
+        { apiBase: TWO },
+        { apiBase: "https://ok.example.test", headers: ACCESS },
+        { apiBase: "https://ok.example.test", headers: {} },
+      ]),
+    );
+    await loadSavedServers();
+    expect(savedServers()).toEqual([{ apiBase: "https://ok.example.test", headers: ACCESS }]);
+  });
+
+  it("keeps the list as it was when the write fails", async () => {
+    await recordSavedServer(ONE, {});
+    vi.mocked(SecureStore.setItemAsync).mockRejectedValueOnce(new Error("locked"));
+    expect(await recordSavedServer(TWO, {})).toBe(false);
+    expect(savedServers().map((entry) => entry.apiBase)).toEqual([ONE]);
+    // The last entry goes by deleting the key, which can fail on its own.
+    vi.mocked(SecureStore.deleteItemAsync).mockRejectedValueOnce(new Error("locked"));
+    expect(await removeSavedServer(ONE)).toBe(false);
+    expect(savedServers().map((entry) => entry.apiBase)).toEqual([ONE]);
+  });
+
+  it("applies overlapping changes one after another", async () => {
+    await Promise.all([recordSavedServer(ONE, {}), recordSavedServer(TWO, {})]);
+    expect(savedServers().map((entry) => entry.apiBase)).toEqual([TWO, ONE]);
+    await loadSavedServers();
+    expect(savedServers().map((entry) => entry.apiBase)).toEqual([TWO, ONE]);
+  });
+
+  it("does not let a read that started before a write replace the list that write saved", async () => {
+    const stale = deferred<string | null>();
+    vi.mocked(SecureStore.getItemAsync).mockReturnValueOnce(stale.promise);
+    const reading = loadSavedServers();
+    const recording = recordSavedServer(ONE, ACCESS);
+    await flush();
+    stale.resolve(null);
+    await Promise.all([reading, recording]);
+    expect(savedServers()).toEqual([{ apiBase: ONE, headers: ACCESS }]);
+    await recordSavedServer(TWO, {});
+    expect(savedServers().map((entry) => entry.apiBase)).toEqual([TWO, ONE]);
+    expect(store.get(KEY)).toContain(ONE);
+  });
+
+  it("reads the stored list before its first change, so a change before any load keeps it", async () => {
+    store.set(KEY, JSON.stringify([{ apiBase: ONE, headers: {} }]));
+    vi.resetModules();
+    const fresh = await import("./saved-servers");
+    expect(await fresh.recordSavedServer(TWO, {})).toBe(true);
+    expect(fresh.savedServers().map((entry) => entry.apiBase)).toEqual([TWO, ONE]);
+    expect(store.get(KEY)).toContain(ONE);
+  });
+
+  it("writes nothing over a list it could not read, and recovers once it can", async () => {
+    await recordSavedServer(ONE, ACCESS);
+    await recordSavedServer(TWO, ACCESS);
+    vi.mocked(SecureStore.getItemAsync).mockRejectedValue(new Error("locked"));
+    await loadSavedServers();
+    expect(savedServers()).toEqual([]);
+    const before = store.get(KEY);
+    expect(await recordSavedServer("https://three.example.test", {})).toBe(false);
+    expect(await removeSavedServer(ONE)).toBe(false);
+    expect(store.get(KEY)).toBe(before);
+    vi.mocked(SecureStore.getItemAsync).mockImplementation(async (key) => store.get(key) ?? null);
+    expect(await recordSavedServer("https://three.example.test", {})).toBe(true);
+    expect(savedServers().map((entry) => entry.apiBase)).toEqual([
+      "https://three.example.test",
+      TWO,
+      ONE,
+    ]);
+  });
+
+  it("keeps the headers a listed server was saved with when it is left with none", async () => {
+    await recordSavedServer(ONE, ACCESS);
+    await recordSavedServer(TWO, {});
+    await recordSavedServer(ONE, {}, { keepHeaders: true });
+    expect(savedServers()).toEqual([
+      { apiBase: ONE, headers: ACCESS },
+      { apiBase: TWO, headers: {} },
+    ]);
+    await recordSavedServer("https://new.example.test", ACCESS, { keepHeaders: true });
+    expect(savedServers()[0]).toEqual({ apiBase: "https://new.example.test", headers: ACCESS });
+  });
+
+  it("reports a failed read and a failed write instead of dropping them silently", async () => {
+    const warn = vi.spyOn(console, "warn").mockImplementation(() => undefined);
+    try {
+      vi.mocked(SecureStore.getItemAsync).mockRejectedValueOnce(new Error("locked read"));
+      await loadSavedServers();
+      expect(warn).toHaveBeenCalledWith("Saved servers could not be read", expect.any(Error));
+      vi.mocked(SecureStore.setItemAsync).mockRejectedValueOnce(new Error("locked write"));
+      expect(await recordSavedServer(ONE, {})).toBe(false);
+      expect(warn).toHaveBeenCalledWith("Saved servers could not be written", expect.any(Error));
+    } finally {
+      warn.mockRestore();
+    }
+  });
+
+  it("keeps applying changes after one write failed", async () => {
+    vi.mocked(SecureStore.setItemAsync).mockRejectedValueOnce(new Error("locked"));
+    expect(await recordSavedServer(ONE, {})).toBe(false);
+    expect(await recordSavedServer(TWO, {})).toBe(true);
+    expect(savedServers().map((entry) => entry.apiBase)).toEqual([TWO]);
+  });
+});
diff --git a/apps/mobile/lib/api/saved-servers.ts b/apps/mobile/lib/api/saved-servers.ts
