+import UIKit
 
 /** The system PDF viewer, so a PDF reads in the app with zoom and search like Files. */
 public final class RakazoPdfViewModule: Module {
   public func definition() -> ModuleDefinition {
     Name("RakazoPdfView")
 
+    /**
+     * The first page, drawn small enough to sit on a chat card. The page is rendered by PDFKit and
+     * written into the app's cache under a name derived from the file and the width asked for, so
+     * a thread that scrolls past the same PDF twice renders it once.
+     */
+    AsyncFunction("pdfThumbnail") { (uri: String, maxWidth: Double, promise: Promise) in
