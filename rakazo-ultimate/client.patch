+  it("leaves emphasis that already flanks like a word alone", () => {
+    for (const source of ["**粗体**文字", "文字**粗体**", "文字 **粗体** 文字", "**粗体**"]) {
+      expect(padTightEmphasis(source)).toBe(source);
+    }
+  });
+
+  it("keeps a star inside code exactly where it was", () => {
+    // A span that would need padding outside code is copied through untouched inside it.
+    const code = "`是**“值”**`";
+    expect(padTightEmphasis(code)).toBe(code);
+    const inline = "用 `a**b` 表示，**重点**。";
+    expect(padTightEmphasis(inline)).toContain("`a**b`");
+    const fenced = ["说明：", "```md", '是**"值"**', "```", "结束"].join("\n");
+    expect(padTightEmphasis(fenced)).toBe(fenced);
+    const tildes = ["~~~", "**a**", "~~~"].join("\n");
+    expect(padTightEmphasis(tildes)).toBe(tildes);
+  });
+
+  it("leaves a run alone when nothing touches it", () => {
+    expect(padTightEmphasis("2 * 3 = 6")).toBe("2 * 3 = 6");
+    expect(padTightEmphasis("a ** b")).toBe("a ** b");
+    expect(padTightEmphasis("***粗斜体***")).toBe("***粗斜体***");
+  });
+});
