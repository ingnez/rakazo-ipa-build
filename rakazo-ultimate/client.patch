index 000000000..794eb76f1
--- /dev/null
+++ b/apps/mobile/lib/lumen/lumen-manifest-store.ts
@@ -0,0 +1,68 @@
+import { useSyncExternalStore } from "react";
+import { AccessibilityInfo } from "react-native";
+import type { LumenManifest } from "./lumen-manifest";
+
+/**
+ * Reduce-motion for avatars, and a leftover manifest hook that now always returns null.
+ *
+ * Avatars are drawn in the client (OpenMinis shapes and colours). The server
+ * /lumen-avatars manifest is no longer read, fetched, or cached, so a launch never
+ * waits on the network for a face.
+ */
+
+let reducedMotion = false;
+let started = false;
+const listeners = new Set<() => void>();
+
+function emit() {
+  for (const listener of listeners) listener();
+}
+
+function watchReducedMotion() {
+  try {
+    void AccessibilityInfo?.isReduceMotionEnabled?.().then((on) => {
+      if (on !== reducedMotion) {
+        reducedMotion = on;
+        emit();
+      }
+    });
+    AccessibilityInfo?.addEventListener?.("reduceMotionChanged", (on: boolean) => {
+      reducedMotion = on;
+      emit();
+    });
+  } catch {
+    // No accessibility bridge: keep the motion on.
+  }
+}
+
+function start() {
+  if (started) return;
+  started = true;
+  watchReducedMotion();
+}
+
+function subscribe(listener: () => void) {
+  start();
+  listeners.add(listener);
+  return () => {
+    listeners.delete(listener);
+  };
+}
+
+function snapshot(): LumenManifest | null {
+  return null;
+}
+
+function reducedSnapshot() {
+  return reducedMotion;
+}
+
+/** Always null: the client no longer draws from a Lumen picture manifest. */
+export function useLumenManifest(): LumenManifest | null {
+  return useSyncExternalStore(subscribe, snapshot, () => null);
+}
+
+/** iOS "Reduce Motion": the OpenMinis eyes stay open instead of blinking. */
+export function useLumenReducedMotion(): boolean {
+  return useSyncExternalStore(subscribe, reducedSnapshot, () => false);
+}
