+import { readFileSync } from "node:fs";
+import { describe, expect, it } from "vitest";
+import {
+  ComposerAttachLayout,
+  ImageSendPolicy,
+  ImageStackLayout,
+  ImageViewerIndex,
+  galleryNeighbourOrder,
+  imageStackCaption,
+  imageStackCardSize,
+  imageStackCards,
+  imageStackFocusedIndex,
+  imageStackHeight,
+  imageStackHitIndex,
+  imageStackScale,
+  imageStackShouldOpenOnRelease,
+  imageStackSize,
+} from "./image-stack-layout.js";
+
+describe("ImageStackLayout", () => {
+  it("draws nothing for 0 images and one unrotated card for 1", () => {
+    expect(ImageStackLayout.cards(0)).toEqual([]);
+    const one = ImageStackLayout.cards(1);
+    expect(one).toHaveLength(1);
+    expect(one[0]).toMatchObject({ rotation: 0, offset: { width: 0, height: 0 } });
+    expect(ImageStackLayout.caption(1)).toBeNull();
+    expect(ImageStackLayout.isStack(1)).toBe(false);
+  });
+
+  it("stacks two cards and captions them, and caps nine at 3 visible cards", () => {
+    expect(ImageStackLayout.cards(2)).toHaveLength(2);
+    expect(ImageStackLayout.caption(2)).toBe("2 张图片");
+    const nine = ImageStackLayout.cards(9);
+    expect(nine).toHaveLength(3);
+    expect(ImageStackLayout.caption(9)).toBe("9 张图片");
+    expect(nine.at(-1)).toMatchObject({ index: 0, rotation: 0 });
+    expect(nine.map((card) => card.index)).toEqual([2, 1, 0]);
+    expect(new Set(nine.map((card) => card.zIndex)).size).toBe(3);
+    expect(nine.at(-1)!.zIndex).toBeGreaterThan(nine[0]!.zIndex);
+    expect(nine.slice(0, -1).every((card) => card.rotation !== 0)).toBe(true);
+  });
+
+  it("fans at most 5 cards, left to right, symmetric", () => {
+    const fan = ImageStackLayout.cards(9, true);
+    expect(fan).toHaveLength(ImageStackLayout.maxFanned);
+    const xs = fan
+      .slice()
+      .sort((a, b) => a.index - b.index)
+      .map((card) => card.offset.width);
+    expect(xs.every((x, i) => i === 0 || xs[i - 1]! < x)).toBe(true);
+    expect(Math.abs(xs[0]! + xs.at(-1)!)).toBeLessThan(0.001);
+    expect(ImageStackLayout.cards(1, true)).toHaveLength(1);
+  });
+
