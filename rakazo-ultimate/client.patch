+import type { FrontDeskTask, TaskStep, TaskSteps } from "@rakazo/contracts";
+import { dateLocaleForUi } from "./i18n";
+
+/**
+ * The work the front desk handed to the back office, as the Bot's own page lists it and as one
+ * piece of it opens up: the steps it actually took, in order, from the hand-off to where it is now.
+ *
+ * The server is the source of both reads (`bots/tasks` and `threads/taskSteps`); nothing here keeps
+ * its own copy of the work. This module only turns those answers into the lines the phone draws.
+ */
+
+/** The states a piece of work can be in, as the front desk records them. */
+export const TASK_OPEN_STATUSES: readonly string[] = ["queued", "running"];
+
+/** Queued work has not started; a `waiting_input` row is a work still in hand that asked a question. */
+export const TASK_WAITING_STATUS = "waiting_input";
+
+/** How often an open task's timeline is read again: a step lands while a person watches it. */
+export const TASK_STEPS_POLL_MS = 2_000;
+
+/** How often the profile's Tasks list is read again while it is on screen. */
+export const TASK_LIST_POLL_MS = 5_000;
+
+/** A row that is still in the back office, in either of the states that mean it is unfinished. */
+export function taskIsOpen(status: string | null | undefined): boolean {
+  return status !== null && status !== undefined && TASK_OPEN_STATUSES.includes(status);
+}
+
+/** The status in the app's own words: what the row's line says the work is doing. */
+export function taskStatusLabel(status: string | null | undefined): string {
+  switch (status) {
+    case "queued":
+      return "排队中";
+    case "running":
+      return "进行中";
+    case TASK_WAITING_STATUS:
+      return "等你回答";
+    case "completed":
+      return "已完成";
+    case "failed":
+      return "失败";
+    case "cancelled":
+      return "已取消";
+    default:
+      return status?.trim() || "任务";
+  }
+}
+
+/**
+ * How long the work has been going, in the shortest form that still reads as time: `9:44` while it
+ * is under an hour, `1:02:03` once it is longer. The server counts the milliseconds; the row only
+ * needs to show them.
+ */
+export function taskElapsedLabel(ms: number | null | undefined): string {
+  if (ms === null || ms === undefined || !Number.isFinite(ms)) return "";
+  const seconds = Math.max(0, Math.round(ms / 1000));
+  const minutes = Math.floor(seconds / 60);
+  const rest = seconds % 60;
+  if (minutes < 60) return `${minutes}:${String(rest).padStart(2, "0")}`;
+  const hours = Math.floor(minutes / 60);
+  return `${hours}:${String(minutes % 60).padStart(2, "0")}:${String(rest).padStart(2, "0")}`;
+}
+
+/** How long one step took: `320ms`, `4.2s`, `1m 08s` — a call's own small number. */
+export function taskDurationLabel(ms: number | null | undefined): string {
+  if (ms === null || ms === undefined || !Number.isFinite(ms)) return "";
+  if (ms < 1000) return `${Math.max(0, Math.round(ms))}ms`;
+  const seconds = ms / 1000;
+  if (seconds < 60) return `${seconds.toFixed(seconds < 10 ? 1 : 0)}s`;
+  const minutes = Math.floor(seconds / 60);
+  return `${minutes}m ${String(Math.round(seconds % 60)).padStart(2, "0")}s`;
+}
+
+/** The clock a row shows: `8:57`, from the moment in the phone's own time zone. */
+export function taskClock(iso: string | null | undefined, locale = dateLocaleForUi()): string {
+  if (!iso) return "";
+  const at = new Date(iso);
+  if (Number.isNaN(at.getTime())) return "";
+  return at.toLocaleTimeString(locale, { hour: "numeric", minute: "2-digit" });
+}
+
+/** The day a row belongs under, as the phone counts days. */
+export function taskDayKey(iso: string | null | undefined): string {
+  if (!iso) return "";
+  const at = new Date(iso);
+  if (Number.isNaN(at.getTime())) return "";
+  return `${at.getFullYear()}-${String(at.getMonth() + 1).padStart(2, "0")}-${String(at.getDate()).padStart(2, "0")}`;
+}
+
+/** A day's heading: 今天 / 昨天, then the date, so the list reads as the reference app's. */
+export function taskDayLabel(iso: string | null | undefined, now = Date.now()): string {
+  const key = taskDayKey(iso);
+  if (!key) return "";
+  const today = taskDayKey(new Date(now).toISOString());
+  if (key === today) return "今天";
+  const yesterday = taskDayKey(new Date(now - 24 * 60 * 60 * 1000).toISOString());
+  if (key === yesterday) return "昨天";
+  const [, month, day] = key.split("-");
+  return `${Number(month)}月${Number(day)}日`;
+}
+
+/**
+ * The row's second line: what the work is on right now in its own words, and once it settled, what
+ * came back. A row the server left blank still says something rather than showing an empty line.
+ */
+export function taskRowDetail(task: FrontDeskTask): string {
+  const said = (task.currentStep ?? "").trim() || (task.progress ?? "").trim();
+  if (said) return said;
+  return taskIsOpen(task.status) ? "正在开始" : taskStatusLabel(task.status);
+}
+
+/** The number at the row's right: how long a running task has gone, or when it settled. */
+export function taskRowTrail(task: FrontDeskTask): string {
+  return taskIsOpen(task.status)
+    ? taskElapsedLabel(task.elapsedMs)
+    : taskClock(task.completedAt ?? task.updatedAt);
+}
+
+/** The row's third line: where the work stands, and when it was handed over. */
+export function taskRowMeta(task: FrontDeskTask): string {
+  const started = taskClock(task.createdAt);
+  return [taskStatusLabel(task.status), started ? `${started} 开始` : ""]
+    .filter(Boolean)
+    .join(" · ");
+}
+
+/** The rows under their day headings, newest day first, each day newest row first. */
+export function groupTasksByDay(
+  tasks: readonly FrontDeskTask[],
+  now = Date.now(),
+): { key: string; label: string; tasks: FrontDeskTask[] }[] {
+  const groups: { key: string; label: string; tasks: FrontDeskTask[] }[] = [];
+  for (const task of tasks) {
+    const key = taskDayKey(task.createdAt);
+    const last = groups[groups.length - 1];
+    if (last && last.key === key) {
+      last.tasks.push(task);
+      continue;
+    }
+    groups.push({ key, label: taskDayLabel(task.createdAt, now), tasks: [task] });
+  }
+  return groups;
+}
+
+/**
+ * The pages a `bots/tasks` read came back in, as one list: the server pages by `before`, and a row
+ * that moved between two reads (a task that just finished) must not show twice.
+ */
+export function mergeTaskPages(pages: readonly (readonly FrontDeskTask[])[]): FrontDeskTask[] {
+  const seen = new Set<string>();
+  const rows: FrontDeskTask[] = [];
+  for (const page of pages) {
+    for (const task of page) {
+      if (seen.has(task.id)) continue;
+      seen.add(task.id);
+      rows.push(task);
+    }
+  }
+  return rows;
+}
+
+/** The steps that carry the work's own timeline, oldest first, as the server answered them. */
+export function taskTimelineSteps(task: Pick<TaskSteps, "steps"> | undefined): TaskStep[] {
+  if (!task?.steps?.length) return [];
+  return [...task.steps].sort(
+    (a, b) => (Date.parse(a.timestamp) || 0) - (Date.parse(b.timestamp) || 0),
+  );
+}
+
+/** The one step still running, which the header's line and the row's spinner follow. */
+export function taskRunningStep(steps: readonly TaskStep[]): TaskStep | undefined {
+  return [...steps].reverse().find((step) => step.status === "running");
+}
