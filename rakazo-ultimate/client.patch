+      this.deps.nodeBinary,
+      [path.join(server.dir, server.manifest.entrypoints.migrate)],
+      {
+        cwd: server.dir,
+        env: {
+          ...this.nodeEnv(),
+          DATABASE_URL: databaseUrl,
