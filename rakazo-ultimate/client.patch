@@ -0,0 +1,65 @@
+import { describe, expect, it } from "vitest";
+import { takeSpeakablePiece } from "./stream-speech";
+
+/**
+ * The rule that lets a call start speaking a reply while it is still being written: only whole
+ * sentences go out, nothing is said twice, and a finished reply says whatever is left.
+ */
+describe("takeSpeakablePiece", () => {
+  it("says the first finished sentence and leaves the rest", () => {
+    const text = "好的，我在。你想先查哪个网段？后面再说。";
+    const first = takeSpeakablePiece(text, 0);
+    expect(first.piece).toBe("好的，我在。");
+    const second = takeSpeakablePiece(text, first.taken);
+    expect(second.piece).toBe("你想先查哪个网段？");
+    const third = takeSpeakablePiece(text, second.taken);
+    expect(third.piece).toBe("后面再说。");
+    expect(takeSpeakablePiece(text, third.taken).piece).toBe("");
+  });
+
+  it("holds half a sentence rather than cutting a word", () => {
+    const text = "正在重新登录，出结果告";
+    expect(takeSpeakablePiece(text, 0).piece).toBe("");
+  });
+
+  it("waits for a piece worth opening the voice for", () => {
+    // A stray "。" right at the start is punctuation, not a sentence to say.
+    expect(takeSpeakablePiece("。它是。", 0).piece).toBe("。它是。");
+    expect(takeSpeakablePiece("，。", 0).piece).toBe("");
+  });
+
+  it("speaks what is left once the reply is complete", () => {
+    const text = "查到了。所属网段是 104.28.192.0/24";
+    const first = takeSpeakablePiece(text, 0);
+    expect(first.piece).toBe("查到了。");
+    const rest = takeSpeakablePiece(text, first.taken, { final: true });
+    expect(rest.piece).toBe("所属网段是 104.28.192.0/24");
+    expect(rest.taken).toBe(text.length);
+  });
+
+  it("breaks a long sentence at a clause instead of holding the voice", () => {
+    // No full stop anywhere: without a clause break the voice would wait for the whole run.
+    const text = "这是一段很长的说明，".repeat(20);
+    const piece = takeSpeakablePiece(text, 0);
+    expect(piece.piece.length).toBeGreaterThan(20);
+    expect(piece.piece.length).toBeLessThanOrEqual(120);
+    expect(piece.piece.endsWith("，")).toBe(true);
+  });
+
+  it("keeps a decimal number together", () => {
+    const text = "版本是 1.25。";
+    expect(takeSpeakablePiece(text, 0).piece).toBe("版本是 1.25。");
+  });
+
+  it("never hands over more than the text it was given", () => {
+    expect(takeSpeakablePiece("短", 99).piece).toBe("");
+    expect(takeSpeakablePiece("短", 99, { final: true }).taken).toBe(1);
+  });
+
+  it("says an English sentence at its own full stop", () => {
+    const text = "The login page is open. Enter the code.";
+    const first = takeSpeakablePiece(text, 0);
+    expect(first.piece).toBe("The login page is open.");
+    expect(takeSpeakablePiece(text, first.taken).piece).toBe("Enter the code.");
+  });
+});
diff --git a/apps/mobile/lib/stream-speech.ts b/apps/mobile/lib/stream-speech.ts
new file mode 100644
index 000000000..8c747a610
--- /dev/null
+++ b/apps/mobile/lib/stream-speech.ts
@@ -0,0 +1,78 @@
+/**
+ * Cutting a reply that is still being written into pieces that can be spoken now.
+ *
+ * The call used to wait for the bot's run to settle before it said anything, so the first sound
+ * arrived only after the last word was written. This is the rule that lets it start on the first
+ * finished sentence instead: a piece ends where a sentence ends, so the voice never stops on half
+ * a clause, and the rest of the reply joins the queue as it arrives.
+ */
+
+/** A character that ends a sentence in either language the app is read in. */
+const SENTENCE_END = new Set(["。", "！", "？", "!", "?", "…", "\n", "；", ";"]);
+/** A place a long sentence may be broken without losing the sense of it. */
+const CLAUSE_END = new Set(["，", ",", "、", "：", ":", " "]);
+/** A piece shorter than this is not worth opening the voice for; it waits for the next one. */
+const MIN_PIECE = 4;
+/** A sentence still unfinished by this many characters is broken at its last clause instead. */
+const MAX_HOLD = 120;
+/** A trailing "." ends a sentence only when a space or the end follows: `1.5` is one number. */
+function endsWithStop(text: string, index: number): boolean {
+  if (text[index] !== ".") return false;
+  const next = text[index + 1];
+  return next === undefined || next === " " || next === "\n" || next === "）";
+}
+
+export type SpeakablePiece = {
+  /** What to speak now: a whole sentence, trimmed. Empty when nothing is ready yet. */
+  piece: string;
+  /** How much of the text has been handed over, for the next call. */
+  taken: number;
+};
+
+/**
+ * The next piece of `text` after `taken` characters that is safe to speak.
+ *
+ * With `final`, everything left is the piece — the reply is done being written, so half a
+ * sentence is all there will ever be. Otherwise only text up to a sentence end is taken; a reply
+ * still typing out its first sentence yields nothing, and the caller waits for its next update.
+ */
+export function takeSpeakablePiece(
+  text: string,
+  taken: number,
+  { final = false }: { final?: boolean } = {},
+): SpeakablePiece {
+  const from = Math.max(0, Math.min(taken, text.length));
+  const rest = text.slice(from);
+  if (!rest.trim()) return { piece: "", taken: from };
+  if (final) {
+    const trimmed = rest.trim();
+    return { piece: trimmed.length >= 1 ? trimmed : "", taken: text.length };
+  }
+  let end = -1;
+  for (let index = 0; index < rest.length; index += 1) {
+    if (SENTENCE_END.has(rest[index]!) || endsWithStop(rest, index)) {
+      // Include the mark itself and any punctuation right after it, so "。！" stay together.
+      let stop = index + 1;
+      while (stop < rest.length && SENTENCE_END.has(rest[stop]!)) stop += 1;
+      if (rest.slice(0, stop).trim().length >= MIN_PIECE) {
+        end = stop;
+        break;
+      }
+      index = stop - 1;
+    }
+  }
+  if (end < 0) {
+    // A long run with no sentence end: break it where a clause ends rather than hold the voice.
+    if (rest.trim().length >= MAX_HOLD) {
+      for (let index = Math.min(MAX_HOLD, rest.length) - 1; index >= MIN_PIECE; index -= 1) {
+        if (CLAUSE_END.has(rest[index]!)) {
+          end = index + 1;
+          break;
+        }
+      }
+    }
+    if (end < 0) return { piece: "", taken: from };
+  }
+  const piece = rest.slice(0, end).trim();
+  return { piece, taken: from + end };
+}
