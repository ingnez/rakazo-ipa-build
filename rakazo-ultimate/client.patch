+const GENERATED_SECRETS: Record<string, number> = {
+  POSTGRES_PASSWORD: 16,
+  POSTGRES_APP_PASSWORD: 16,
+  BETTER_AUTH_SECRET: 32,
+  ENCRYPTION_KEY: 32,
+  SCREEN_PROXY_SECRET: 32,
+  SANDBOX_SUPERVISOR_TOKEN: 32,
