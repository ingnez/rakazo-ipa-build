+// @vitest-environment jsdom
+import type { ReactNode } from "react";
+import { createElement } from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { expect, it, vi } from "vitest";
+
+vi.mock("react-native", () => ({
+  Pressable: ({
+    children,
+    accessibilityLabel,
+  }: {
+    children: ReactNode;
+    accessibilityLabel: string;
+  }) => (
+    <button type="button" aria-label={accessibilityLabel}>
+      {children}
+    </button>
+  ),
+  Text: ({ children }: { children: ReactNode }) => <span>{children}</span>,
+  View: ({ children }: { children: ReactNode }) => <div>{children}</div>,
+}));
+vi.mock("../../lib/native/native", () => ({ useThemedStyles: () => ({}) }));
+vi.mock("../../lib/inbox/activity", () => ({
+  activityPreview: () => "",
+  activityStatusLabel: (status: string) => status,
+  formatActivityRelativeTime: () => "",
+}));
+vi.mock("./inbox-styles", () => ({ createInboxStyles: () => ({}) }));
+vi.mock("../bots/bot-avatar", () => ({ BotAvatar: () => <i /> }));
+vi.mock("../bots/group-avatar", () => ({ GroupAvatar: () => <i /> }));
+vi.mock("./inbox-rows", () => ({
+  FALLBACK_COLOR: "orange",
+  SectionToggle: ({ title, collapsed }: { title: string; collapsed: boolean }) => (
+    <button type="button" aria-label={`${collapsed ? "Expand" : "Collapse"} ${title}`} />
+  ),
+  ConversationRow: ({ title, actions }: { title: string; actions?: string[] }) => (
+    <p data-actions={actions?.join(" ")}>{title}</p>
+  ),
+  ChatSwipe: ({ rowKey, children }: { rowKey: string; children: ReactNode }) => (
+    <section data-swipe={rowKey}>{children}</section>
+  ),
+}));
+
+import { ActivitySection } from "./inbox-activity";
+
+it("opens Needs attention and folds Working and Unread until the user opens them", () => {
+  const markup = renderToStaticMarkup(
+    createElement(ActivitySection, {
+      activity: {
+        active: [
+          { runId: "ask", botId: "marketing", botName: "Marketing", status: "waiting_input" },
+          { runId: "work", botId: "research", botName: "Research", status: "running" },
+        ] as never,
+        recent: [],
+      },
+      status: "loaded",
+      bots: [
+        { id: "marketing", name: "Marketing", status: "waiting_input" },
+        { id: "research", name: "Research", status: "running" },
+        { id: "writer", name: "Writer", status: "idle", unread: true },
+      ] as never,
+      groups: [],
+      toggledSections: new Set(["activity:unread"]),
+      onToggleSection: () => undefined,
+      openChat: () => undefined,
+    }),
+  );
+  expect(markup).toContain('aria-label="Collapse Needs attention"');
+  expect(markup).toContain('aria-label="Expand Working"');
+  expect(markup).toContain('aria-label="Collapse Unread"');
+  expect(markup).toContain("Marketing");
+  expect(markup).not.toContain("Research");
+  expect(markup).toContain("Writer");
+});
+
+it("offers the inbox swipe actions on activity rows and leaves out archived chats", () => {
+  const markup = renderToStaticMarkup(
+    createElement(ActivitySection, {
+      activity: {
+        active: [],
+        recent: [
+          { runId: "a", botId: "marketing", botName: "Marketing", status: "completed" },
+          { runId: "b", botId: "archived", botName: "Archived", status: "completed" },
+        ] as never,
+      },
+      status: "loaded",
+      bots: [{ id: "marketing", name: "Marketing", status: "idle" }] as never,
+      groups: [],
+      toggledSections: new Set<string>(),
+      onToggleSection: () => undefined,
+      openChat: () => undefined,
+      swipe: {
+        botAction: () => undefined,
+        groupAction: () => undefined,
+        sections: [],
+        onOrganize: () => undefined,
+        onEditSection: () => undefined,
+      },
+    }),
+  );
+  expect(markup).toContain(
+    '<section data-swipe="activity:bot:marketing"><p data-actions="unread archive pin">Marketing</p></section>',
+  );
+  expect(markup).not.toContain("Archived");
+});
+
+it.each([
+  ["loading", ""],
+  ["loaded", "No runs yet"],
+  ["failed", "Could not load activity"],
+] as const)("says why nothing is listed once the inbox is gone (%s)", (status, text) => {
+  const markup = renderToStaticMarkup(
+    createElement(ActivitySection, {
+      activity: { active: [], recent: [] },
+      status,
+      bots: [],
+      groups: [],
+      toggledSections: new Set<string>(),
+      onToggleSection: () => undefined,
+      openChat: () => undefined,
+    }),
+  );
+  expect(markup.replace(/<[^>]+>/g, "")).toBe(text);
+});
diff --git a/apps/mobile/components/inbox/inbox-activity.tsx b/apps/mobile/components/inbox/inbox-activity.tsx
new file mode 100644
index 000000000..490652b93
--- /dev/null
+++ b/apps/mobile/components/inbox/inbox-activity.tsx
@@ -0,0 +1,267 @@
+import { useLingui } from "@lingui/react/macro";
+import type { RunActivityRow } from "@rakazo/contracts";
+import { activitySections } from "@rakazo/core";
+import type { Href } from "expo-router";
+import type { ReactElement, ReactNode } from "react";
+import { useMemo } from "react";
+import { Text, View } from "react-native";
+import type { MobileBot, MobileGroup } from "../../lib/api/mobile-types";
+import {
+  activityPreview,
+  activityStatusLabel,
+  formatActivityRelativeTime,
+} from "../../lib/inbox/activity";
+import type { InboxRowAction } from "../../lib/inbox/inbox-swipe";
+import { inboxRowActionList } from "../../lib/inbox/inbox-swipe";
+import type { SpaceActivityStatus } from "../../lib/inbox/use-space-activity";
+import { useThemedStyles } from "../../lib/native/native";
+import { BotAvatar } from "../bots/bot-avatar";
+import { GroupAvatar } from "../bots/group-avatar";
+import type { RowMenuProps } from "./inbox-rows";
+import { ChatSwipe, ConversationRow, FALLBACK_COLOR, SectionToggle } from "./inbox-rows";
+import { createInboxStyles } from "./inbox-styles";
+
+type SwipeTarget = { kind: "bot"; chat: MobileBot } | { kind: "group"; chat: MobileGroup };
+type RowActions = { actions: InboxRowAction[]; onAction: (action: InboxRowAction) => void };
+
+export type ActivitySwipe = RowMenuProps & {
+  botAction: (action: InboxRowAction, bot: MobileBot) => void;
+  groupAction: (action: InboxRowAction, group: MobileGroup) => void;
+};
+
+export function ActivitySection({
+  activity,
+  status,
+  bots,
+  groups,
+  toggledSections,
+  onToggleSection,
+  openChat,
+  swipe,
+}: {
+  activity: { active: RunActivityRow[]; recent: RunActivityRow[] };
+  status: SpaceActivityStatus;
+  bots: MobileBot[];
+  groups: MobileGroup[];
+  /** Section keys flipped from their default fold, stored with the inbox's collapsed sections. */
+  toggledSections: ReadonlySet<string>;
+  onToggleSection: (key: string) => void;
+  openChat: (href: Href) => void;
+  swipe?: ActivitySwipe;
+}) {
+  const styles = useThemedStyles(createInboxStyles);
+  const { t } = useLingui();
+  const botsById = useMemo(() => new Map(bots.map((bot) => [bot.id, bot])), [bots]);
+  const groupsById = useMemo(() => new Map(groups.map((group) => [group.id, group])), [groups]);
+  // Only chats in the inbox, so a chat archived from here leaves at once, like its inbox row.
+  const inInbox = (run: RunActivityRow) =>
+    run.groupId ? groupsById.has(run.groupId) : botsById.has(run.botId);
+  const sections = activitySections({
+    active: activity.active.filter(inInbox),
+    recent: activity.recent.filter(inInbox),
+    bots,
+    groups,
+  });
+  // The inbox's swipe actions and menu.
+  const swipeable = (target: SwipeTarget, row: (actions?: RowActions) => ReactElement) => {
+    if (!swipe) return row();
+    const onAction = (action: InboxRowAction) =>
+      target.kind === "bot"
+        ? swipe.botAction(action, target.chat)
+        : swipe.groupAction(action, target.chat);
+    return (
+      <ChatSwipe
+        key={`${target.kind}:${target.chat.id}`}
+        target={target}
+        rowKey={`activity:${target.kind}:${target.chat.id}`}
+        onAction={onAction}
+        sections={swipe.sections}
+        onOrganize={swipe.onOrganize}
+        onEditSection={swipe.onEditSection}
+        onSnooze={swipe.onSnooze && ((until) => swipe.onSnooze?.(target.kind, target.chat, until))}
+      >
+        {row({ actions: inboxRowActionList(target.chat), onAction })}
+      </ChatSwipe>
+    );
+  };
+  const runTarget = (run: RunActivityRow): SwipeTarget => {
+    const group = run.groupId ? groupsById.get(run.groupId) : undefined;
+    return group
+      ? { kind: "group", chat: group }
+      : { kind: "bot", chat: botsById.get(run.botId) as MobileBot };
+  };
+  const openRun = (run: RunActivityRow) => {
+    if (run.groupId) {
+      openChat({
+        pathname: "/group-thread",
+        params: { groupId: run.groupId, name: run.groupName ?? t`Group` },
+      });
+      return;
+    }
+    openChat({ pathname: "/thread", params: { botId: run.botId, name: run.botName } });
+  };
+  const runRows = (runs: RunActivityRow[], detailed = false) =>
+    runs.map((run) =>
+      swipeable(runTarget(run), (actions) => (
+        <ActivityRow
+          key={run.runId}
+          run={run}
+          bot={botsById.get(run.botId)}
+          detailed={detailed}
+          onPress={() => openRun(run)}
+          {...actions}
+        />
+      )),
+    );
+  const fold = (key: string, title: string, count: number, defaultOpen: boolean) => ({
+    title,
+    count,
+    open: defaultOpen !== toggledSections.has(`activity:${key}`),
+    onToggle: () => onToggleSection(`activity:${key}`),
+  });
+  const unreadCount = sections.unreadGroups.length + sections.unreadBots.length;
+
+  if (
+    sections.attention.length + sections.working.length + unreadCount + sections.recent.length ===
+    0
+  ) {
+    if (status === "loading") return null;
+    return (
+      <Text style={styles.empty}>
+        {status === "failed" ? t`Could not load activity` : t`No runs yet`}
+      </Text>
+    );
+  }
+  return (
+    <View style={styles.activitySection}>
+      {sections.attention.length > 0 ? (
+        <Fold {...fold("attention", t`Needs attention`, sections.attention.length, true)}>
+          {runRows(sections.attention)}
+        </Fold>
+      ) : null}
+      {sections.working.length > 0 ? (
+        <Fold {...fold("working", t`Working`, sections.working.length, false)}>
+          {runRows(sections.working)}
+        </Fold>
+      ) : null}
+      {unreadCount > 0 ? (
+        <Fold {...fold("unread", t`Unread`, unreadCount, false)}>
+          {sections.unreadGroups.map((group) =>
+            swipeable({ kind: "group", chat: group }, (actions) => (
+              <ConversationRow
+                key={group.id}
+                title={group.name}
+                preview={group.preview}
+                time={formatActivityRelativeTime(group.updatedAt)}
+                accessibilityLabel={group.name}
+                onPress={() =>
+                  openChat({
+                    pathname: "/group-thread",
+                    params: { groupId: group.id, name: group.name },
+                  })
+                }
+                avatar={<GroupAvatar members={group.members} />}
+                {...actions}
+              />
+            )),
+          )}
+          {sections.unreadBots.map((bot) =>
+            swipeable({ kind: "bot", chat: bot }, (actions) => (
+              <ConversationRow
+                key={bot.id}
+                title={bot.name}
+                preview={bot.preview}
+                time={formatActivityRelativeTime(bot.updatedAt)}
+                accessibilityLabel={bot.name}
+                onPress={() =>
+                  openChat({ pathname: "/thread", params: { botId: bot.id, name: bot.name } })
+                }
+                avatar={
+                  <BotAvatar
+                    name={bot.name}
+                    identity={bot.id}
+                    color={bot.color}
+                    avatarSet={bot.avatarSet}
+                    motion="lazy"
+                  />
+                }
+                {...actions}
+              />
+            )),
+          )}
+        </Fold>
+      ) : null}
+      {sections.recent.length > 0 ? (
+        <Fold {...fold("recent", t`Recent`, sections.recent.length, true)}>
+          {runRows(sections.recent, true)}
+        </Fold>
+      ) : null}
+    </View>
+  );
+}
+
+function Fold({
+  title,
+  count,
+  open,
+  onToggle,
+  children,
+}: {
+  title: string;
+  count: number;
+  open: boolean;
+  onToggle: () => void;
+  children: ReactNode;
+}) {
+  const styles = useThemedStyles(createInboxStyles);
+  return (
+    <View>
+      <View style={styles.sectionHeadingRow}>
+        <SectionToggle title={title} count={count} collapsed={!open} onPress={onToggle} />
+      </View>
+      {open ? children : null}
+    </View>
+  );
+}
+
+function ActivityRow({
+  run,
+  bot,
+  detailed,
+  onPress,
+  actions,
+  onAction,
+}: Partial<RowActions> & {
+  run: RunActivityRow;
+  bot?: MobileBot;
+  /** Recent mixes outcomes, so its rows say how each run ended and when. */
+  detailed: boolean;
+  onPress: () => void;
+}) {
+  const status = activityStatusLabel(run.status);
+  const snippet = activityPreview(run);
+  const preview = detailed ? (snippet ? `${status}: ${snippet}` : status) : snippet;
+  // Compact rows hide tags, so the group stays in the title.
+  const title = [run.botName, run.groupName].filter(Boolean).join(", ");
+  return (
+    <ConversationRow
+      title={title}
+      preview={preview}
+      time={detailed ? formatActivityRelativeTime(run.updatedAt) : ""}
+      accessibilityLabel={`${title}, ${status}`}
+      onPress={onPress}
+      actions={actions}
+      onAction={onAction}
+      avatar={
+        <BotAvatar
+          name={bot?.name ?? run.botName}
+          identity={run.botId}
+          color={bot?.color ?? FALLBACK_COLOR}
+          avatarSet={bot?.avatarSet}
+          status={run.status}
+          motion="lazy"
+        />
+      }
+    />
+  );
+}
diff --git a/apps/mobile/components/inbox/inbox-header.tsx b/apps/mobile/components/inbox/inbox-header.tsx
new file mode 100644
index 000000000..e957c64ea
--- /dev/null
+++ b/apps/mobile/components/inbox/inbox-header.tsx
@@ -0,0 +1,166 @@
+import { MenuView } from "@expo/ui/community/menu";
+import { useLingui } from "@lingui/react/macro";
+import { useRouter } from "expo-router";
+import type { ReactNode } from "react";
+import { Platform, Pressable, Text, View } from "react-native";
+import { useSafeAreaInsets } from "react-native-safe-area-context";
+import { mobileTokens, resolveMobileAppearance } from "../../lib/appearance/appearance";
+import type { CreateAction } from "../../lib/inbox/create-chooser";
+import { createMenuActions, isCreateAction } from "../../lib/inbox/create-chooser";
+import { setInboxHidden, useSplitView } from "../../lib/layout/split-view";
+import { useThemedStyles } from "../../lib/native/native";
+import { GlassSurface } from "../native/glass-surface";
+import { NativeSymbol } from "../native/native-symbol";
+import { CREATE_MENU_GAP, createInboxStyles } from "./inbox-styles";
+
+const STATUS_BAR_HEIGHT = 24;
+
+/**
+ * The inbox's own header where it has no native bar: beside a chat in split view, and before
+ * iOS 26. Its controls sit on Liquid Glass wherever that exists.
+ */
+export function InboxHeader({
+  initials,
+  activityMode,
+  toggleActivityMode,
+  runCreateAction,
+  columnInsets,
+  title,
+  embedded = false,
+}: {
+  initials: string;
+  activityMode: boolean;
+  toggleActivityMode: () => void;
+  runCreateAction: (action: CreateAction) => void;
+  columnInsets: { left: number; right: number };
+  title?: ReactNode;
+  embedded?: boolean;
+}) {
+  const tokens = mobileTokens();
+  const appearance = resolveMobileAppearance();
+  const styles = useThemedStyles(createInboxStyles);
+  const { t } = useLingui();
+  const router = useRouter();
+  const insets = useSafeAreaInsets();
+  const { foldActive } = useSplitView();
+  return (
+    <View
+      style={[
+        styles.header,
+        {
+          // The window's expanded status area can extend over the chat without occupying the
+          // sidebar, so beside a chat the inset counts no more than the status bar's height.
+          paddingTop:
+            embedded && Platform.OS === "ios"
+              ? Math.min(insets.top, STATUS_BAR_HEIGHT) + 8
+              : Math.max(insets.top, 20) + 8,
+          paddingLeft: 16 + columnInsets.left,
+          paddingRight: 16 + columnInsets.right,
+        },
+      ]}
+    >
+      {/* Beside a chat the account sits at the foot of the list, and this corner hides the list
+          unless a fold keeps it in place. */}
+      {embedded ? (
+        foldActive ? null : (
+          <GlassSurface
+            shape="circle"
+            style={styles.headerCircle}
+            fallbackStyle={styles.headerFill}
+          >
+            <HeaderButton accessibilityLabel={t`Hide chats`} onPress={() => setInboxHidden(true)}>
+              <NativeSymbol ios="sidebar.left" android="expand-outline" size={19} />
+            </HeaderButton>
+          </GlassSurface>
+        )
+      ) : (
+        <GlassSurface shape="circle" style={styles.headerCircle} fallbackStyle={styles.headerFill}>
+          <HeaderButton accessibilityLabel={t`Account`} onPress={() => router.push("/account")}>
+            <Text style={styles.profileInitials}>{initials}</Text>
+          </HeaderButton>
+        </GlassSurface>
+      )}
+      {/* The title gives way to the buttons when the column is narrow. */}
+      {title ? <View style={styles.headerTitle}>{title}</View> : null}
+      <View style={styles.headerActions}>
+        <GlassSurface style={styles.headerGroup} fallbackStyle={styles.headerFill}>
+          <HeaderButton
+            accessibilityLabel={t`Activity`}
+            active={activityMode}
+            accent
+            onPress={toggleActivityMode}
+          >
+            <NativeSymbol
+              ios={activityMode ? "bell.fill" : "bell"}
+              android={activityMode ? "notifications" : "notifications-outline"}
+              size={17}
+              color={activityMode ? tokens.primaryForeground : tokens.foreground}
+            />
+          </HeaderButton>
+          <HeaderButton
+            testID="home-search-button"
+            accessibilityLabel={t`Search`}
+            onPress={() => router.push("/search")}
+          >
+            <NativeSymbol ios="magnifyingglass" android="search" size={17} />
+          </HeaderButton>
+        </GlassSurface>
+        {/* Creating is a different kind of action from the ways of looking at chats beside it. */}
+        <GlassSurface shape="circle" style={styles.headerCircle} fallbackStyle={styles.headerFill}>
+          <MenuView
+            actions={createMenuActions(Platform.OS)}
+            {...(Platform.OS === "android" ? { style: { marginBottom: -CREATE_MENU_GAP } } : {})}
+            colorScheme={appearance}
+            onPressAction={({ nativeEvent }) => {
+              if (isCreateAction(nativeEvent.event)) runCreateAction(nativeEvent.event);
+            }}
+          >
+            <View
+              accessibilityLabel={t`Create`}
+              accessibilityRole="button"
+              style={[styles.headerButton, Platform.OS === "android" && styles.createMenuAnchor]}
+            >
+              <NativeSymbol ios="plus" android="add" size={18} />
+            </View>
+          </MenuView>
+        </GlassSurface>
+      </View>
+    </View>
+  );
+}
+
+function HeaderButton({
+  testID,
+  children,
+  onPress,
+  accessibilityLabel,
+  active = false,
+  accent = false,
+}: {
+  children: ReactNode;
+  onPress: () => void;
+  accessibilityLabel: string;
+  testID?: string;
+  active?: boolean;
+  accent?: boolean;
+}) {
+  const styles = useThemedStyles(createInboxStyles);
+  return (
+    <Pressable
+      testID={testID}
+      accessibilityRole="button"
+      accessibilityLabel={accessibilityLabel}
+      accessibilityState={{ selected: active }}
+      onPress={onPress}
+      hitSlop={4}
+      style={({ pressed }) => [
+        styles.headerButton,
+        accent && active
+          ? styles.headerButtonAccent
+          : (active || pressed) && styles.headerButtonActive,
+      ]}
+    >
+      {children}
+    </Pressable>
+  );
+}
