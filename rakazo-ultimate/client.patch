new file mode 100644
index 000000000..8d1f36f29
--- /dev/null
+++ b/apps/mobile/lib/model-capability-line.ts
@@ -0,0 +1,30 @@
+import { ph } from "@lingui/core/macro";
+import { useLingui } from "@lingui/react/macro";
+import type { ConnectionModel } from "@rakazo/core";
+
+/**
+ * A short, honest line about what is known of a model: its context size and whether it reads
+ * images. A value nobody knows reads as unknown. The wording matches the web app's model rows.
+ */
+export function useModelCapabilityLine() {
+  const { t } = useLingui();
+  return (model: ConnectionModel): string => {
+    const settings = model.settings;
+    const context = settings?.contextWindow;
+    const millions = context === undefined ? 0 : Math.round(context / 104_857.6) / 10;
+    const thousands = context === undefined ? 0 : Math.round(context / 1000);
+    const size =
+      context === undefined
+        ? t`Context unknown`
+        : context >= 1_000_000
+          ? t`${ph({ millions })}M context`
+          : t`${ph({ thousands })}K context`;
+    const images =
+      settings?.images === true
+        ? t`Reads images`
+        : settings?.images === false
+          ? t`Text only`
+          : t`Image support unknown`;
+    return `${size} · ${images}`;
+  };
+}
