+
+/**
+ * A thumb held on something: heavier than a tap, and shorter than a failure's double thump. It
+ * marks the moment a menu is about to open, which is the one thing a long press announces.
+ */
+export function hapticLongPress(): void {
+  perform(() =>
+    Platform.OS === "android"
+      ? Haptics.performAndroidHapticsAsync(Haptics.AndroidHaptics.Long_Press)
