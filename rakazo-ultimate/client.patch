+/**
+ * Adds one more piece to the voice that is already speaking, instead of replacing it: the rest of
+ * a reply that is still being written. A piece that arrives while nothing is playing opens the
+ * playback by itself, exactly as `speakText` would.
+ */
+export function appendSpeech(item: SpeechQueueItem): void {
+  const mine = item.owner === undefined || activeSpeechOwner === item.owner;
+  if (!mine || playback.status === "idle") {
+    void speakQueue([item]).catch(() => undefined);
+    return;
+  }
+  speechQueue.push(item);
+}
+
+/**
+ * Resolves once nothing is left to say for this owner — the last queued piece played, or the
+ * playback was replaced by someone else's. A reply written in pieces listens again only then.
+ */
+export async function waitForSpeechEnd(
+  owner?: SpeechOwner,
+  { pollMs = 120, limitMs = 120_000 }: { pollMs?: number; limitMs?: number } = {},
+): Promise<void> {
+  const started = Date.now();
+  while (Date.now() - started < limitMs) {
+    if (owner !== undefined && activeSpeechOwner !== owner) return;
+    if (playback.status === "idle" && speechQueue.length === 0) return;
+    await new Promise((resolve) => setTimeout(resolve, pollMs));
+  }
+}
