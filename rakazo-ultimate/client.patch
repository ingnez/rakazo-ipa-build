diff --git a/apps/mobile/modules/photo-picker/ios/PhotoPickerModule.swift b/apps/mobile/modules/photo-picker/ios/PhotoPickerModule.swift
new file mode 100644
index 000000000..43c2bab4d
--- /dev/null
+++ b/apps/mobile/modules/photo-picker/ios/PhotoPickerModule.swift
@@ -0,0 +1,874 @@
+import ExpoModulesCore
+import Foundation
+import ImageIO
+import Photos
+import PhotosUI
+import UIKit
+import UniformTypeIdentifiers
+
+/// The photo picker behind the composer's "Photo library" menu entry.
+///
+/// The sheet reports two things of its own: the chosen photos and its dismissal. A current iOS
+/// closes the sheet for the app as soon as the person is done, so the dismissal can be reported
+/// before the selection arrives. Read at face value that is a cancel, and every chosen photo is
+/// thrown away with nothing on screen to say why — which is how the album looked dead. So a
+/// dismissal counts as a cancel here only when no selection arrived, and only once the run loop
+/// has had its turn to deliver one.
+///
+/// The sheet is a process of its own, and the photos come over XPC from it. Dismissing the sheet
+/// takes that process down — v28 dismissed it first thing in `didFinishPicking`, and every read of
+/// that selection then timed out on a real phone — so the sheet stays up while the photos are read
+/// and goes away only when the pick settles.
+///
+/// A picked photo is read the way expo-image-picker's `MediaHandler` reads one, one route at a
+/// time and never several at once: the file the provider holds for the photo's own type, then the
+/// photo library by the asset the picker named, then the same type's bytes. Asking one provider
+/// four things at once is the other half of what stalled the read. Nothing is transcoded across
+/// processes either (`preferredAssetRepresentationMode = .current`): a HEIC photo is turned into a
+/// JPEG here on the phone, after it has arrived.
+///
+/// A photo that is only in iCloud is the case the six-second rule was wrong for. Its file does not
+/// exist on this phone, so the provider can neither hand it over nor say how long the download will
+/// take, and every read of it timed out at once on a real phone (`IMG_2986`). So the file route
+/// keeps its two-second bound, and the photo that outlives it is read from the photo library
+/// instead — the app's own `Photos` framework, not the sheet's process — at 2048 pixels on the
+/// longest side rather than as the original 48 megapixels, with twenty-five seconds to download
+/// and progress of its own in the trace. That size is still larger than the 1600 the chat keeps.
+///
+/// Every wait here ends, and soon. A local photo is handed over in a fraction of a second; each
+/// route has its own bound, and the whole pick has a deadline of its own — thirty seconds for the
+/// first photo and each further one on top, because a selection of five photos from iCloud is five
+/// downloads and not one. A failure names every step it tried with how long each took. A promise
+/// that is never resolved, or resolved twice, is what made v26 look dead, so this module resolves
+/// exactly once on every path.
+public class PhotoPickerModule: Module {
+  /// One sheet at a time, set and cleared on whichever thread the previous ran out on.
+  private let lock = NSLock()
+  private var active: PickerSession?
+
+  public func definition() -> ModuleDefinition {
+    Name("PhotoPicker")
+
+    AsyncFunction("pickImages") { (limit: Int, promise: Promise) in
+      self.start(limit: limit, promise: promise)
+    }
+    .runOnQueue(DispatchQueue.main)
+  }
+
+  private func takeSlot() -> Bool {
+    lock.lock()
+    defer { lock.unlock() }
+    guard active == nil else { return false }
+    return true
+  }
+
+  private func setActive(_ session: PickerSession?) {
+    lock.lock()
+    active = session
+    lock.unlock()
+  }
+
+  private func start(limit: Int, promise: Promise) {
+    guard takeSlot() else {
+      // One sheet at a time: a tap while the first one is up has nothing left to choose.
+      promise.resolve(PickerSession.canceled(error: "a photo picker is already open"))
+      return
+    }
+    guard let root = appContext?.utilities?.currentViewController() else {
+      promise.resolve(PickerSession.canceled(error: "no screen to present the picker on"))
+      return
+    }
+
+    var configuration = PHPickerConfiguration(photoLibrary: PHPhotoLibrary.shared())
+    configuration.filter = .images
+    // 0 is the most the system allows; the caller sends the room its draft has left.
+    configuration.selectionLimit = limit > 0 ? limit : 0
+    configuration.selection = .ordered
+    // The photo as it is on the phone. `.compatible` made iOS transcode the whole selection in the
+    // picker's process before handing anything over, and that transcode is what never finished.
+    configuration.preferredAssetRepresentationMode = .current
+
+    let picker = PHPickerViewController(configuration: configuration)
+    let session = PickerSession(promise: promise) { [weak self] in self?.setActive(nil) }
+    session.activePicker = picker
+    setActive(session)
+    picker.delegate = session
+    picker.presentationController?.delegate = session
+    Self.presentOnTopScreen(picker, from: root) { [weak session] presented in
+      guard let session else { return }
+      guard presented else {
+        // The sheet never reached the screen, so nothing will ever dismiss or finish it. Answer
+        // now instead of leaving the composer on "reading photos"; settling takes it away too.
+        session.settle(PickerSession.canceled(error: "failed to present photo picker"))
+        return
+      }
+      // The menu that opened the sheet can hand over a fresh presentation controller; the
+      // swipe-down still has to be heard.
+      picker.presentationController?.delegate = session
+    }
+  }
+
+  /// Presents the sheet on the screen that is actually on top, waiting out one that is still
+  /// being dismissed or presented (the `+` menu closing is exactly that moment). Calls back with
+  /// `false` when UIKit never put the sheet on screen, which it does silently when the screen it
+  /// was handed is mid-transition.
+  private static func presentOnTopScreen(
+    _ picker: PHPickerViewController,
+    from root: UIViewController,
+    completion: @escaping (Bool) -> Void
+  ) {
+    var finished = false
+    func finish(_ presented: Bool) {
+      guard !finished else { return }
+      finished = true
+      completion(presented)
+    }
+    func attempt(_ attemptsLeft: Int) {
+      DispatchQueue.main.async {
+        if isOnScreen(picker) {
+          finish(true)
+          return
+        }
+        let host = topmost(root)
+        let busy = host.isBeingDismissed || host.isBeingPresented
+          || host.presentedViewController != nil || host.view.window == nil
+        guard !busy else {
+          guard attemptsLeft > 1 else {
+            finish(false)
+            return
+          }
+          // A tenth of a second is enough for the menu to finish closing.
+          DispatchQueue.main.asyncAfter(deadline: .now() + 0.15) { attempt(attemptsLeft - 1) }
+          return
+        }
+        host.present(picker, animated: true) {
+          finish(picker.presentingViewController != nil)
+        }
+        // UIKit can drop a present without calling its completion back at all; the sheet is
+        // either on screen within a second or it never will be.
+        DispatchQueue.main.asyncAfter(deadline: .now() + 1.2) {
+          guard !isOnScreen(picker) else { return }
+          finish(false)
+        }
+      }
+    }
+    // Eight attempts of a tenth of a second: a menu that is slow to close still gets its sheet.
+    attempt(8)
+  }
+
+  /// Whether the sheet is on screen, without loading a view that was never shown.
+  private static func isOnScreen(_ picker: PHPickerViewController) -> Bool {
+    if picker.presentingViewController != nil { return true }
+    return picker.isViewLoaded && picker.view.window != nil
+  }
+
+  /// The screen in front of the person: the topmost presentation, through a navigation stack or
+  /// a tab bar, skipping anything already on its way out.
+  private static func topmost(_ controller: UIViewController) -> UIViewController {
+    var current = controller
+    var steps = 0
+    while steps < 16 {
+      steps += 1
+      if let presented = current.presentedViewController, !presented.isBeingDismissed {
+        current = presented
+      } else if let navigation = current as? UINavigationController,
+        let visible = navigation.visibleViewController, visible !== current
+      {
+        current = visible
+      } else if let tab = current as? UITabBarController, let selected = tab.selectedViewController,
+        selected !== current
+      {
+        current = selected
+      } else {
+        return current
+      }
+    }
+    return current
+  }
+}
+
+final class PickerSession: NSObject, PHPickerViewControllerDelegate,
+  UIAdaptivePresentationControllerDelegate {
+  /// How long the provider may take to hand over the photo's own file. A local photo answers in a
+  /// fraction of a second; this is only ever reached by a file that is not on this phone.
+  private static let fileTimeout: TimeInterval = 2
+  /// How long the provider may take to hand over that type's bytes when there is no library asset
+  /// to read instead: long enough for an iCloud download to finish over a phone connection.
+  private static let dataTimeout: TimeInterval = 15
+  /// How long the photo library may take to hand over the photo, download from iCloud included.
+  /// This is the route an iCloud photo takes, so it is the one wait that is allowed to be long.
+  private static let libraryTimeout: TimeInterval = 25
+  /// How long a photo library permission prompt may take to be answered.
+  private static let permissionTimeout: TimeInterval = 2
+  /// The size the library hands the photo over at: 2048 on the longest side. The chat keeps
+  /// nothing wider than 1600, and a picture this size is a fraction of a 48-megapixel original —
+  /// which is what has to come down from iCloud before it can be drawn at all.
+  private static let libraryTarget = CGSize(width: 2048, height: 2048)
+  /// The whole read of one photo: past this the person is told, whatever any callback is doing.
+  /// Further photos in the same selection each get their own, since each is its own download.
+  static let totalDeadline: TimeInterval = 30
+  /// What each further photo in one selection adds to that deadline: its library read, and the
+  /// step before it, with a second to spare.
+  private static let deadlinePerExtraPhoto: TimeInterval = 26
+
+  private let promise: Promise
+  private let release: () -> Void
+  private let lock = NSLock()
+  private var delivered = false
+  private var settled = false
+  /// The sheet the selection came from. Its process is what serves the photos, so it is kept up
+  /// while they are read and dismissed only in `settle`.
+  weak var activePicker: PHPickerViewController?
+  /// What each read step answered and how long it took, so a failure says which system call
+  /// refused or timed out instead of asking for another guess.
+  private let trace = ReadTrace()
+
+  init(promise: Promise, release: @escaping () -> Void) {
+    self.promise = promise
+    self.release = release
+  }
+
+  static func canceled(error: String? = nil) -> [String: Any] {
+    var body: [String: Any] = ["canceled": true, "assets": [[String: Any]]()]
+    if let error {
+      body["error"] = error
+    }
+    return body
+  }
+
+  /// Resolves the promise exactly once, whichever path and whichever thread gets here first. The
+  /// sheet goes away here and nowhere earlier: by now every route that needed it has answered.
+  func settle(_ body: [String: Any]) {
+    lock.lock()
+    guard !settled else {
+      lock.unlock()
+      return
+    }
+    settled = true
+    let sheet = activePicker
+    lock.unlock()
+    release()
+    Self.dismiss(sheet)
+    promise.resolve(body)
+  }
+
+  /// Takes the sheet away, once, on the main thread — and only when it is still up: a swipe-down
+  /// has already taken it, and one that never appeared has nothing to take away.
+  private static func dismiss(_ picker: PHPickerViewController?) {
+    guard let picker else { return }
+    let take = {
+      guard picker.presentingViewController != nil
+        || (picker.isViewLoaded && picker.view.window != nil)
+      else {
+        return
+      }
+      picker.dismiss(animated: true)
+    }
+    if Thread.isMainThread {
+      take()
+    } else {
+      DispatchQueue.main.async(execute: take)
+    }
+  }
+
+  private func markDelivered() {
+    lock.lock()
+    delivered = true
+    lock.unlock()
+  }
+
+  private var hasDelivered: Bool {
+    lock.lock()
+    defer { lock.unlock() }
+    return delivered
+  }
+
+  // MARK: - PHPickerViewControllerDelegate
+
+  func picker(_ picker: PHPickerViewController, didFinishPicking results: [PHPickerResult]) {
+    // The selection is here before anything is decided, so a dismissal that follows can never be
+    // mistaken for a cancel. The sheet itself stays exactly where it is: it is taken away once the
+    // photos have been read, in `settle`.
+    markDelivered()
+    guard !results.isEmpty else {
+      // The sheet's own cancel button: nothing was chosen, so there is nothing to read.
+      settle(Self.canceled())
+      return
+    }
+    // The deadline that does not depend on any callback: a photo whose bytes never arrive, a
+    // download that stops answering — all of it ends here. Each photo in the selection is its own
+    // read and its own iCloud download, so the selection gets one deadline per photo.
+    let deadline = Self.totalDeadline
+      + Double(results.count - 1) * Self.deadlinePerExtraPhoto
+    DispatchQueue.global().asyncAfter(deadline: .now() + deadline) { [weak self] in
+      guard let self else { return }
+      self.settle(
+        Self.canceled(
+          error: "读图超过 \(Int(deadline)) 秒（\(self.trace.text)）"
+        )
+      )
+    }
+    // Read off the main thread below, so the sheet is taken now while it is certain. It is the
+    // one that is dismissed when the photos are read from the library instead of from it.
+    let sheet = activePicker
+    Task {
+      var assets: [[String: Any]] = []
+      var failure: String?
+      for result in results {
+        do {
+          assets.append(try await Self.copy(result, sheet: sheet, trace: trace))
+        } catch {
+          // One photo that cannot be read costs that photo, not the whole selection.
+          failure = error.localizedDescription
+        }
+      }
+      var body: [String: Any] = ["canceled": false, "assets": assets]
+      if let failure, assets.isEmpty {
+        body["error"] = failure
+      }
+      self.settle(body)
+    }
+  }
+
+  // MARK: - UIAdaptivePresentationControllerDelegate
+
+  func presentationControllerDidDismiss(_ presentationController: UIPresentationController) {
+    // A swipe-down reaches here at once, while a selection is still on its way. Give the
+    // selection the rest of this run loop before deciding that nothing was chosen.
+    DispatchQueue.main.async { [weak self] in
+      guard let self, !self.hasDelivered else {
+        return
+      }
+      self.settle(Self.canceled())
+    }
+  }
+
+  // MARK: - Reading a chosen photo
+
+  /// The photo as a file the chat can upload, from the first route that has it.
+  ///
+  /// One route at a time, the way expo-image-picker reads a picked photo: the file the provider
+  /// holds for the photo's own type, then the photo library by the asset the picker named, then
+  /// that type's bytes. A route starts only after the one before it has answered or run out of
+  /// time, so one `NSItemProvider` never carries several loads at once.
+  ///
+  /// The library comes before the bytes because a photo that lives only in iCloud has no file to
+  /// hand over: the provider would have to pull the whole original through the sheet's process
+  /// first, and on a phone connection that is the wait that never finished. The library is asked
+  /// for a 2048-pixel copy instead — less to download, and ready to write out at once. The bytes
+  /// stay for the case the library knows nothing of the photo, which is also the case the sheet is
+  /// still up for.
+  private static func copy(
+    _ result: PHPickerResult,
+    sheet: PHPickerViewController?,
+    trace: ReadTrace
+  ) async throws -> [String: Any] {
+    let provider = result.itemProvider
+    let directory = FileManager.default.temporaryDirectory
+      .appendingPathComponent("picked-photos", isDirectory: true)
+    try? FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+    let type = preferredType(of: provider)
+
+    if let file = await readFile(provider, type: type, trace: trace, into: directory) {
+      return describe(file)
+    }
+    if result.assetIdentifier != nil, await canReadPhotoLibrary(trace: trace) {
+      switch await fromPhotoLibrary(result, sheet: sheet, trace: trace, into: directory) {
+      case .read(let file):
+        return describe(file)
+      case .noAsset:
+        // The library knows nothing of this photo, so the sheet is still up and its bytes are the
+        // only route left.
+        break
+      case .failed:
+        throw libraryFailure(trace)
+      }
+    }
+    if let file = await readData(provider, type: type, trace: trace, into: directory) {
+      return describe(file)
+    }
+    throw libraryFailure(trace)
+  }
+
+  /// What a library read came to: the file, a library that has never heard of the photo, or a
+  /// library that was asked and could not deliver.
+  private enum LibraryRead {
+    case read(URL)
+    /// A selection made under limited access, in practice: the picker named an asset the app's own
+    /// library is not allowed to see.
+    case noAsset
+    case failed
+  }
+
+  /// The failure line for a read that ended without a photo: a download that ran out of time is
+  /// named as one, since that is the one the person can do something about.
+  private static func libraryFailure(_ trace: ReadTrace) -> Error {
+    if trace.cloudTimedOutBeforeArriving {
+      return PhotoPickError.cloudTimeout(trace.text)
+    }
+    return PhotoPickError.unreadable(trace.text)
+  }
+
+  /// The one type every route asks for: the first type the provider registers that is an image (a
+  /// HEIC photo answers to its own), and the general image type when it registers none — the same
+  /// choice expo-image-picker makes before it loads a representation.
+  private static func preferredType(of provider: NSItemProvider) -> String {
+    for registered in provider.registeredTypeIdentifiers {
+      if let type = UTType(registered), type.conforms(to: .image) {
+        return registered
+      }
+    }
+    return UTType.image.identifier
+  }
+
+  /// `loadFileRepresentation` lends the photo's file only until its callback returns, so the file
+  /// is taken inside it: copied as it is when it is already a JPEG or a PNG, and turned into a
+  /// JPEG here when it is not (a HEIC photo, in practice). A provider that refuses, or a file that
+  /// never arrives, is recorded with how long it took and the next route carries on.
+  private static func readFile(
+    _ provider: NSItemProvider,
+    type: String,
+    trace: ReadTrace,
+    into directory: URL
+  ) async -> URL? {
+    let label = "file:\(UTType(type)?.preferredFilenameExtension ?? type)"
+    return await withCheckedContinuation { (continuation: CheckedContinuation<URL?, Never>) in
+      let step = Step<URL?>(label, trace: trace) { continuation.resume(returning: $0) }
+      let progress = provider.loadFileRepresentation(forTypeIdentifier: type) { url, error in
+        guard let url else {
+          step.answer(nil, note: errorNote(error))
+          return
+        }
+        guard let file = land(url, name: provider.suggestedName, into: directory) else {
+          step.answer(nil, note: "unwritable")
+          return
+        }
+        step.answer(file, note: "ok")
+      }
+      // The route's own bound, in case its callback never comes back at all. The load itself is
+      // cancelled with it: a photo that is still coming is about to be read from the library, and
+      // two downloads of one photo would only fight over the connection.
+      DispatchQueue.global().asyncAfter(deadline: .now() + fileTimeout) {
+        progress.cancel()
+        step.answer(nil, note: "timeout")
+      }
+    }
+  }
+
+  /// The same type's bytes, when its file did not come: the route expo-image-picker falls back to,
+  /// and the one a HEIC the provider keeps only as data answers.
+  private static func readData(
+    _ provider: NSItemProvider,
+    type: String,
+    trace: ReadTrace,
+    into directory: URL
+  ) async -> URL? {
+    let label = "data:\(UTType(type)?.preferredFilenameExtension ?? type)"
+    return await withCheckedContinuation { (continuation: CheckedContinuation<URL?, Never>) in
+      let step = Step<URL?>(label, trace: trace) { continuation.resume(returning: $0) }
+      DispatchQueue.global().asyncAfter(deadline: .now() + dataTimeout) {
+        step.answer(nil, note: "timeout")
+      }
+      _ = provider.loadDataRepresentation(forTypeIdentifier: type) { data, error in
+        guard let data, !data.isEmpty else {
+          step.answer(nil, note: errorNote(error))
+          return
+        }
+        guard let file = writeImage(data, name: provider.suggestedName, into: directory) else {
+          step.answer(nil, note: "unwritable")
+          return
+        }
+        step.answer(file, note: "ok")
+      }
+    }
+  }
+
+  /// The provider's file as the chat's own file: JPEG and PNG are copied as they are, anything
+  /// else is turned into a JPEG on this phone. Converting here is the point of taking the photo as
+  /// it is on the device — the system's own cross-process transcode is what never finished.
+  private static func land(_ source: URL, name: String?, into directory: URL) -> URL? {
+    let stem = name ?? source.deletingPathExtension().lastPathComponent
+    if let type = imageType(at: source), type.conforms(to: .jpeg) {
+      return copyInto(source, directory, name: stem, fileExtension: "jpg")
+    }
+    if let type = imageType(at: source), type.conforms(to: .png) {
+      return copyInto(source, directory, name: stem, fileExtension: "png")
+    }
+    guard let data = try? Data(contentsOf: source) else { return nil }
+    return writeImage(data, name: stem, into: directory)
+  }
+
+  /// The photo the provider would not give up, read from the photo library by the asset the picker
+  /// named — the route a photo that lives only in iCloud has to take.
+  ///
+  /// It is asked for at 2048 pixels rather than as the original: the original has to be downloaded
+  /// whole before it can be decoded, and at 48 megapixels that is tens of megabytes of a phone
+  /// connection for a photo the chat will shrink to 1600 anyway. The wait is the download, so it
+  /// gets twenty-five seconds and reports its progress into the trace.
+  private static func fromPhotoLibrary(
+    _ result: PHPickerResult,
+    sheet: PHPickerViewController?,
+    trace: ReadTrace,
+    into directory: URL
+  ) async -> LibraryRead {
+    guard let identifier = result.assetIdentifier else {
+      trace.add("lib=no-id")
+      return .noAsset
+    }
+    let assets = PHAsset.fetchAssets(withLocalIdentifiers: [identifier], options: nil)
+    guard let asset = assets.firstObject else {
+      trace.add("lib=no-asset")
+      return .noAsset
+    }
+
+    // The photo comes from the app's own photo library from here, not from the sheet's process, so
+    // the sheet can go: the person sees the composer's reading line while the photo arrives
+    // instead of a sheet that sits there for the length of a download.
+    dismiss(sheet)
+
+    let options = PHImageRequestOptions()
+    // A photo that lives only in iCloud is still the person's photo, and this is the call that
+    // fetches it.
+    options.isNetworkAccessAllowed = true
+    options.deliveryMode = .highQualityFormat
+    options.version = .current
+    options.resizeMode = .fast
+    // What the download is doing: a slow read then says it is a download, not a mystery.
+    options.progressHandler = { progress, error, _, _ in
+      if let error {
+        trace.add("icloud=err(\((error as NSError).code))")
+        return
+      }
+      if progress < 1 {
+        trace.sawICloud()
+        trace.addOnce("icloud=downloading")
+      }
+    }
+
+    let name = PHAssetResource.assetResources(for: asset).first?.originalFilename
+    let request = RequestBox()
+    let image: UIImage? = await withCheckedContinuation {
+      (continuation: CheckedContinuation<UIImage?, Never>) in
+      let step = Step<UIImage?>("lib", trace: trace) { continuation.resume(returning: $0) }
+      DispatchQueue.global().asyncAfter(deadline: .now() + libraryTimeout) {
+        // A download that ran out of time is stopped rather than left running: the connection is
+        // what the person's next attempt needs.
+        request.cancel()
+        trace.cloudRanOutIfWaiting()
+        step.answer(nil, note: trace.waitedOnICloud ? "icloud-timeout" : "timeout")
+      }
+      request.start(
+        PHImageManager.default().requestImage(
+          for: asset,
+          targetSize: libraryTarget,
+          contentMode: .aspectFit,
+          options: options
+        ) { image, info in
+          // A first, rougher copy can arrive before the photo itself while the full one is still
+          // being prepared — from iCloud, almost always. Only the last answer is the photo.
+          if (info?[PHImageResultIsDegradedKey] as? Bool) == true {
+            trace.addOnce("lib=preview")
+            return
+          }
+          if (info?[PHImageCancelledKey] as? Bool) == true {
+            step.answer(nil, note: "canceled")
+            return
+          }
+          if let error = info?[PHImageErrorKey] as? Error {
+            step.answer(nil, note: errorNote(error))
+            return
+          }
+          guard let image else {
+            step.answer(nil, note: "no")
+            return
+          }
+          step.answer(image, note: "ok")
+        }
+      )
+    }
+    guard let image else { return .failed }
+    guard let file = writeImage(image, into: directory, name: name) else {
+      trace.add("lib=unwritable")
+      return .failed
+    }
+    return .read(file)
+  }
+
+  /// Photo library access, asked for the first time only when a photo actually needs it: the
+  /// picker itself never does, so most people never see the prompt.
+  private static func canReadPhotoLibrary(trace: ReadTrace) async -> Bool {
+    switch PHPhotoLibrary.authorizationStatus(for: .readWrite) {
+    case .authorized, .limited:
+      return true
+    case .notDetermined:
+      return await withCheckedContinuation { (continuation: CheckedContinuation<Bool, Never>) in
+        let step = Step<Bool>("perm", trace: trace) { continuation.resume(returning: $0) }
+        DispatchQueue.global().asyncAfter(deadline: .now() + permissionTimeout) {
+          step.answer(false, note: "timeout")
+        }
+        _ = PHPhotoLibrary.requestAuthorization(for: .readWrite) { status in
+          step.answer(status == .authorized || status == .limited, note: "answered")
+        }
+      }
+    default:
+      trace.add("perm=denied")
+      return false
+    }
+  }
+
+  /// How a failed system call is named in the failure line: its own error code, or that it
+  /// answered with nothing.
+  private static func errorNote(_ error: Error?) -> String {
+    guard let error else { return "no" }
+    return "err(\((error as NSError).code))"
+  }
+
+  /// A decoded image as a JPEG on disk, the one representation every model reads.
+  private static func writeImage(_ image: UIImage, into directory: URL, name: String?) -> URL? {
+    guard let jpeg = uprightJpegData(image) else { return nil }
+    let stem = name.map { ($0 as NSString).deletingPathExtension } ?? "photo"
+    return write(jpeg, into: directory, name: stem, fileExtension: "jpg")
+  }
+
+  /// JPEG and PNG are written as they arrived; anything else is re-encoded as a JPEG, the one
+  /// representation every model reads.
+  private static func writeImage(_ data: Data, name: String?, into directory: URL) -> URL? {
+    let stem = name.map { ($0 as NSString).deletingPathExtension } ?? "photo"
+    if let type = imageType(of: data), type.conforms(to: .jpeg) {
+      return write(data, into: directory, name: stem, fileExtension: "jpg")
+    }
+    if let type = imageType(of: data), type.conforms(to: .png) {
+      return write(data, into: directory, name: stem, fileExtension: "png")
+    }
+    guard let image = UIImage(data: data), let jpeg = uprightJpegData(image) else { return nil }
+    return write(jpeg, into: directory, name: stem, fileExtension: "jpg")
+  }
+
+  private static func write(_ data: Data, into directory: URL, name: String, fileExtension: String)
+    -> URL?
+  {
+    let target = destination(in: directory, name: name, fileExtension: fileExtension)
+    do {
+      try data.write(to: target, options: .atomic)
+      return target
+    } catch {
+      return nil
+    }
+  }
+
+  private static func copyInto(
+    _ source: URL,
+    _ directory: URL,
+    name: String,
+    fileExtension: String
+  ) -> URL? {
+    let target = destination(in: directory, name: name, fileExtension: fileExtension)
+    do {
+      try FileManager.default.copyItem(at: source, to: target)
+      return target
+    } catch {
+      return nil
+    }
+  }
+
+  private static func imageType(at url: URL) -> UTType? {
+    guard let source = CGImageSourceCreateWithURL(url as CFURL, nil),
+      let identifier = CGImageSourceGetType(source)
+    else {
+      return nil
+    }
+    return UTType(identifier as String)
+  }
+
+  private static func imageType(of data: Data) -> UTType? {
+    guard let source = CGImageSourceCreateWithData(data as CFData, nil),
+      let identifier = CGImageSourceGetType(source)
+    else {
+      return nil
+    }
+    return UTType(identifier as String)
+  }
+
+  /// The pixels turned the way the photo was taken: re-encoding drops EXIF orientation, so a
+  /// portrait photo would otherwise arrive on its side.
+  private static func uprightJpegData(_ image: UIImage) -> Data? {
+    if image.imageOrientation == .up {
+      return image.jpegData(compressionQuality: 0.9)
+    }
+    let format = UIGraphicsImageRendererFormat.default()
+    format.scale = 1
+    let size = image.size
+    return UIGraphicsImageRenderer(size: size, format: format)
+      .image { _ in image.draw(in: CGRect(origin: .zero, size: size)) }
+      .jpegData(compressionQuality: 0.9)
+  }
+
+  /// The name the chat shows, made unique so two photos of the same name keep both bytes.
+  private static func destination(in directory: URL, name: String, fileExtension: String) -> URL {
+    let base = sanitized(name)
+    let suffix = fileExtension.isEmpty ? "" : ".\(fileExtension)"
+    var candidate = directory.appendingPathComponent(base + suffix)
+    var index = 2
+    while FileManager.default.fileExists(atPath: candidate.path) {
+      candidate = directory.appendingPathComponent("\(base)-\(index)\(suffix)")
+      index += 1
+    }
+    return candidate
+  }
+
+  private static func sanitized(_ name: String) -> String {
+    let trimmed = name.replacingOccurrences(of: "/", with: "-")
+      .trimmingCharacters(in: .whitespacesAndNewlines)
+    return trimmed.isEmpty ? UUID().uuidString : trimmed
+  }
+
+  private static func describe(_ url: URL) -> [String: Any] {
+    let image = UIImage(contentsOfFile: url.path)
+    var body: [String: Any] = [
+      "uri": url.absoluteString,
+      "name": url.lastPathComponent,
+      "width": Double(image?.size.width ?? 0),
+      "height": Double(image?.size.height ?? 0),
+    ]
+    if let mimeType = UTType(filenameExtension: url.pathExtension)?.preferredMIMEType {
+      body["mimeType"] = mimeType
+    }
+    return body
+  }
+}
+
+/// What every step of a read said, in the order it was tried, with how long it took. It is what the
+/// person sees in the failure line — `file:heic=timeout 1.50s; data:heic=no 0.02s; lib=no-id` — so a
+/// photo that still will not read on a real phone names the system call that refused instead of
+/// asking for another guess.
+final class ReadTrace: @unchecked Sendable {
+  private let lock = NSLock()
+  private var steps: [String] = []
+  private var cloud = false
+  private var cloudRanOut = false
+
+  func add(_ step: String) {
+    lock.lock()
+    steps.append(step)
+    lock.unlock()
+  }
+
+  /// Records a step only the first time it is said: a download reports its progress many times
+  /// over, and the failure line needs one word for it.
+  func addOnce(_ step: String) {
+    lock.lock()
+    defer { lock.unlock() }
+    guard !steps.contains(step) else { return }
+    steps.append(step)
+  }
+
+  /// The photo had to come down from iCloud: it was not on this phone.
+  func sawICloud() {
+    lock.lock()
+    cloud = true
+    lock.unlock()
+  }
+
+  var waitedOnICloud: Bool {
+    lock.lock()
+    defer { lock.unlock() }
+    return cloud
+  }
+
+  /// The download outlived its bound without the photo arriving.
+  func cloudRanOutIfWaiting() {
+    lock.lock()
+    cloudRanOut = cloud
+    lock.unlock()
+  }
+
+  var cloudTimedOutBeforeArriving: Bool {
+    lock.lock()
+    defer { lock.unlock() }
+    return cloudRanOut
+  }
+
+  var text: String {
+    lock.lock()
+    defer { lock.unlock() }
+    return steps.isEmpty ? "no step answered" : steps.joined(separator: "; ")
+  }
+}
+
+/// One system call's answer, recorded once with how long it took and handed on once: a callback
+/// that never arrives, or one that arrives after the route's deadline, must not leave the read
+/// waiting or resolve it twice.
+final class Step<Value>: @unchecked Sendable {
+  private let lock = NSLock()
+  private var answered = false
+  private let label: String
+  private let trace: ReadTrace
+  private let started = Date()
+  private let finish: (Value) -> Void
+
+  init(_ label: String, trace: ReadTrace, finish: @escaping (Value) -> Void) {
+    self.label = label
+    self.trace = trace
+    self.finish = finish
+  }
+
+  /// `note` is what the step said — `ok`, `timeout`, `no`, or the error's own code — or `nil` when
+  /// the caller records the outcome itself.
+  func answer(_ value: Value, note: String?) {
+    lock.lock()
+    guard !answered else {
+      lock.unlock()
+      return
+    }
+    answered = true
+    lock.unlock()
+    if let note {
+      trace.add("\(label)=\(note) \(String(format: "%.2fs", Date().timeIntervalSince(started)))")
+    }
+    finish(value)
+  }
+}
+
+/// The photo library request's own id, so a read that ran out of time can stop the download it
+/// started instead of leaving it to run on with the radio awake.
+final class RequestBox: @unchecked Sendable {
+  private let lock = NSLock()
+  private var id: PHImageRequestID = PHInvalidImageRequestID
+  private var cancelled = false
+
+  func start(_ request: PHImageRequestID) {
+    lock.lock()
+    id = request
+    let alreadyCancelled = cancelled
+    lock.unlock()
+    guard alreadyCancelled else { return }
+    PHImageManager.default().cancelImageRequest(request)
+  }
+
+  func cancel() {
+    lock.lock()
+    cancelled = true
+    let request = id
+    lock.unlock()
+    guard request != PHInvalidImageRequestID else { return }
+    PHImageManager.default().cancelImageRequest(request)
+  }
+}
+
+enum PhotoPickError: LocalizedError {
+  /// The read that failed, with the steps it tried: `file:heic=timeout 2.00s; data:heic=err(-1002)
+  /// 0.20s; lib=no-id`.
+  case unreadable(String)
+  /// The photo is in iCloud and did not finish downloading: the one failure with something to do
+  /// about, so it says so instead of naming system calls.
+  case cloudTimeout(String)
+
+  var errorDescription: String? {
+    switch self {
+    case .unreadable(let steps):
+      return "the photo could not be read (\(steps))"
+    case .cloudTimeout(let steps):
+      return "iCloud 照片下载超时，联网后再试一次或改用「文件」（\(steps)）"
+    }
+  }
+}
