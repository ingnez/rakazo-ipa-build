+    out.append("export const MOTION_SHAPE_SCALE_OVERRIDE: Readonly<Record<string, number>> = {")
+    for name, scale in data["shapeScaleOverride"].items():
+        out.append(f'  {name}: {scale:.6g},')
+    out.append("};")
+    out.append("")
+
+    palette = json.loads((STUDY / "palette.json").read_text())
+    out.append("/** The four stops of a body's 135° gradient, per official color. */")
+    out.append("export const MOTION_BODY_GRADIENTS: Readonly<")
+    out.append("  Record<string, { lightFrom: string; lightTo: string; darkFrom: string; darkTo: string }>")
+    out.append("> = {")
+    for name, value in palette["gradient"].items():
+        out.append(
+            f'  {name}: {{ lightFrom: "{value["lightFrom"]}", lightTo: "{value["lightTo"]}", '
+            f'darkFrom: "{value["darkFrom"]}", darkTo: "{value["darkTo"]}" }},'
+        )
+    out.append("};")
+    out.append("")
+    out.append("/** The single fill each body keeps for small sizes and flat surfaces. */")
+    out.append("export const MOTION_BODY_SOLIDS: Readonly<Record<string, { light: string; dark: string }>> = {")
+    for name, value in palette["solid"].items():
+        out.append(f'  {name}: {{ light: "{value["light"]}", dark: "{value["dark"]}" }},')
+    out.append("};")
+    out.append("")
+    out.append(f"export const MOTION_GRADIENT_ANGLE = {palette['angle']};")
+    out.append("")
+
+    shapes = {}
+    for line in (STUDY / "shapes.tsv").read_text().splitlines()[1:]:
+        index, label, scale, _chars = line.split("\t")
+        shapes[label.lower()] = float(scale)
+    out.append("/** Every body's own zoom, from the official shape table. */")
+    out.append("export const MOTION_SHAPE_SCALES: Readonly<Record<string, number>> = {")
+    for name, scale in shapes.items():
+        out.append(f"  {name}: {scale!r},")
+    out.append("};")
+    out.append("")
+
+    TARGET.write_text("\n".join(out) + "\n")
+    print(f"wrote {TARGET} ({TARGET.stat().st_size} bytes)")
