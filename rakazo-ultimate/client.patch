+import { t } from "@lingui/core/macro";
+
+/**
+ * What the working line says, in the reference app's words: one short phrase for what a bot is
+ * doing, rather than the tool's own name and its arguments.
+ *
+ * Two kinds of line reach it. One is the bot's own note about what it is up to, and the bot writes
+ * that in the reader's own words, so it is shown as written. The other is the server's record of
+ * the call being made, which is a tool's name and what it was given — `Read file
+ * magpie-ios-app/Magpie/Views/Server.swift`, `Web search 院外心脏骤停` — or, for a shell, the bare
+ * command. Those say what a tool was handed, not what the bot is telling the reader, so the line
+ * says 正在读文件 rather than a path: every name the server can write has its phrase below, and a
+ * line that is plainly a command is said as one. A line with no Chinese in it is never one of the
+ * bot's own notes, so it is never shown as written either.
+ */
+export type ActivityStep = {
+  /** What is being done, so a second call of the same kind does not redraw the line. */
+  key: string;
+  label: string;
+  /**
+   * True when the step is the work's own words rather than one of the phrases folded over a tool's
+   * name. Such a step may replace the one on screen as soon as the next arrives.
+   */
+  specific?: boolean;
+};
+
+type Rule = { readonly match: RegExp; readonly key: string; readonly label: () => string };
+
+/** One phrase of the working line, and the tool names whose call reads as it. */
+type ToolPhrase = {
+  /** The call's own name, lower-cased: what the server writes before the detail. */
+  readonly names: readonly string[];
+  readonly key: string;
+  readonly label: () => string;
+};
+
+/**
+ * Every tool the server can name, under the phrase its call reads as. The names are the tool's own
+ * name with its underscores turned into spaces (`read_file` → `read file`), which is what
+ * `humanizeToolName` writes at the head of the line.
+ */
+const TOOL_PHRASES: readonly ToolPhrase[] = [
