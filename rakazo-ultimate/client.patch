+export const BABYGROK_HAPPY_SPEC: BabygrokEyeSpec = {
+  p0: [AVATAR_FACES.happy!.p0[0], AVATAR_FACES.happy!.p0[1]],
+  p1: [AVATAR_FACES.happy!.p1[0], AVATAR_FACES.happy!.p1[1]],
+  p2: [AVATAR_FACES.happy!.p2[0], AVATAR_FACES.happy!.p2[1]],
