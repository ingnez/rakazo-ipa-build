+import { useLingui } from "@lingui/react/macro";
+import { BOT_SOUL_MAX_LENGTH } from "@rakazo/contracts";
+import { Pressable, ScrollView, StyleSheet, Text, View } from "react-native";
+import { botSoulPresets, soulAfterPresetTap, soulPresetFor } from "../lib/bot-soul";
+import { native, useMobileTokens } from "../lib/native";
+import { GrowingTextInput } from "./growing-text-input";
+
+/**
+ * How the bot talks: a row of ready ways of speaking and the field they write into. The presets are
+ * only text — tapping one fills the field, tapping it again empties it — so a person can start from
+ * one and keep editing, or write their own from nothing.
+ */
+export function BotSoulField({
+  value,
+  onChange,
+  editable = true,
+}: {
+  value: string;
+  onChange: (value: string) => void;
+  editable?: boolean;
+}) {
+  const { t } = useLingui();
+  const tokens = useMobileTokens();
+  const presets = botSoulPresets();
+  const active = soulPresetFor(value, presets);
+
+  return (
+    <View style={{ gap: 10 }}>
+      <ScrollView
+        horizontal
+        showsHorizontalScrollIndicator={false}
+        keyboardShouldPersistTaps="handled"
+        contentContainerStyle={styles.chips}
+      >
+        {presets.map((preset) => {
+          const selected = preset.key === active?.key;
+          return (
+            <Pressable
+              key={preset.key}
+              accessibilityRole="button"
+              accessibilityLabel={preset.label}
+              accessibilityHint={
+                selected ? t`Tap again to clear it` : t`Tap to use this way of talking`
+              }
+              accessibilityState={{ selected }}
+              disabled={!editable}
+              onPress={() => onChange(soulAfterPresetTap(value, preset))}
+              style={({ pressed }) => [
+                styles.chip,
+                { backgroundColor: selected ? tokens.primary : native.fill },
+                pressed && { opacity: 0.6 },
+              ]}
+            >
+              <Text
+                numberOfLines={1}
+                style={[
+                  styles.chipLabel,
+                  { color: selected ? tokens.primaryForeground : native.label },
+                ]}
+              >
+                {preset.label}
+              </Text>
+            </Pressable>
+          );
+        })}
+      </ScrollView>
+      <Text style={[styles.hint, { color: tokens.mutedForeground }]}>
+        {t`Tap one to start, then make it yours below.`}
+      </Text>
+      <GrowingTextInput
+        label={t`Soul`}
+        maxLength={BOT_SOUL_MAX_LENGTH}
+        value={value}
+        editable={editable}
+        onChangeText={onChange}
+        placeholder={t`Its temper, its pace, the words it likes — how it talks to you.`}
+        backgroundColor={native.groupedCell}
+        fontSize={17}
+      />
+    </View>
+  );
+}
+
+const styles = StyleSheet.create({
+  // The row starts under the group's own label, so it is not inset a second time.
+  chips: { flexDirection: "row", alignItems: "center", gap: 8, paddingEnd: 16 },
+  chip: {
+    flexGrow: 0,
+    flexShrink: 0,
+    paddingVertical: 6,
+    paddingHorizontal: 12,
+    borderRadius: 999,
+  },
+  chipLabel: { fontSize: 13, fontWeight: "600" },
+  hint: { fontSize: 13, paddingStart: 16, paddingEnd: 16 },
+});
