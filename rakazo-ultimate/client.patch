+/**
+ * The client no longer ships or fetches Lumen pictures. This module stays only so older
+ * imports of the picture table keep compiling; every lookup is empty.
+ */
+
+import type { LumenManifest } from "./lumen-manifest";
+
+export const LUMEN_BUILTIN_BASE_URL = "https://builtin.rakazo.app/lumen-avatars/manifest.json";
+export const LUMEN_BUILTIN_MANIFEST: LumenManifest | null = null;
+export const LUMEN_BUILTIN_VERSION = "";
+
+export function lumenBuiltinAssets(): Record<string, number> {
+  return {};
+}
+
+export function lumenBuiltinPath(uri: string): string | null {
+  let path: string;
+  try {
+    path = new URL(uri).pathname;
+  } catch {
+    return null;
+  }
+  return path.startsWith("/lumen-avatars/") ? path.slice("/lumen-avatars/".length) : null;
+}
+
+export function lumenBuiltinAssetFor(_uri: string): number | null {
+  return null;
+}
+
+export function lumenBuiltinVersion(_version: string | null | undefined): boolean {
+  return false;
+}
