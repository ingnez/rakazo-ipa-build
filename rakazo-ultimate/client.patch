@@ -0,0 +1,49 @@
+import type { ColorValue } from "react-native";
+import Svg, { Path } from "react-native-svg";
+
+/** How many points the icon is drawn in; the bar asks for this size. */
+export const GRID_PLUS_SIZE = 20;
+
+/**
+ * The home bar's connections button: three rounded squares and a plus where the fourth would be,
+ * as the reference app draws it. No SF Symbol carries this shape (the grid symbols have four
+ * cells), so it is drawn here.
+ */
+export function GridPlusIcon({
+  size = GRID_PLUS_SIZE,
+  color,
+}: {
+  size?: number;
+  color: ColorValue;
+}) {
+  return (
+    <Svg width={size} height={size} viewBox="0 0 20 20" fill="none">
+      {/* The three cells: outlined, with the corner rounding of the reference's glyph. */}
+      <Path
+        d="M1.9 3.1a1.2 1.2 0 0 1 1.2-1.2h4.1a1.2 1.2 0 0 1 1.2 1.2v4.1a1.2 1.2 0 0 1-1.2 1.2H3.1a1.2 1.2 0 0 1-1.2-1.2z"
+        stroke={color}
+        strokeWidth={1.7}
+        strokeLinejoin="round"
+      />
+      <Path
+        d="M11.6 3.1a1.2 1.2 0 0 1 1.2-1.2h4.1a1.2 1.2 0 0 1 1.2 1.2v4.1a1.2 1.2 0 0 1-1.2 1.2h-4.1a1.2 1.2 0 0 1-1.2-1.2z"
+        stroke={color}
+        strokeWidth={1.7}
+        strokeLinejoin="round"
+      />
+      <Path
+        d="M1.9 12.8a1.2 1.2 0 0 1 1.2-1.2h4.1a1.2 1.2 0 0 1 1.2 1.2v4.1a1.2 1.2 0 0 1-1.2 1.2H3.1a1.2 1.2 0 0 1-1.2-1.2z"
+        stroke={color}
+        strokeWidth={1.7}
+        strokeLinejoin="round"
+      />
+      {/* The plus in the fourth cell: shorter than a cell, so it reads as a mark, not a box. */}
+      <Path
+        d="M14.7 12.3v5.2M12.1 14.9h5.2"
+        stroke={color}
+        strokeWidth={1.7}
+        strokeLinecap="round"
+      />
+    </Svg>
+  );
+}
diff --git a/apps/mobile/components/grok-bot-link-import.tsx b/apps/mobile/components/grok-bot-link-import.tsx
