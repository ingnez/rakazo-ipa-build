+/**
+ * OpenMinis-style bot avatars: 13 shapes × 12 colours, capsule eyes, blink and moods.
+ * The main bot uses the official black/white face (white in dark mode, near-black in light).
+ *
+ * Geometry, palette and default mapping follow the OpenMinis CloudBotAvatar drawing
+ * (ingnez/OpenMinis, GPLv3). The owner chose this look after being told about that licence.
+ * This module is a TypeScript reimplementation of the drawing, used by the mobile client
+ * and by the review renderer; it has no network and no picture assets.
+ */
+
+export const OPENMINIS_SHAPE_COUNT = 13;
+export const OPENMINIS_COLOR_COUNT = 12;
+export const OPENMINIS_OUTLINE_SAMPLES = 720;
+export const OPENMINIS_DOZE_AFTER_SECONDS = 2 * 86_400;
+
+export type OpenMinisRgb = readonly [r: number, g: number, b: number];
+
+/** Palette in 0…1 RGB. Index 0 is black in the light theme and graphite in the dark theme. */
+export const OPENMINIS_PALETTE: readonly OpenMinisRgb[] = [
+  [0, 0, 0],
+  [0.55, 0.38, 0.24],
+  [0.93, 0.26, 0.27],
+  [0.95, 0.45, 0.16],
+  [0.92, 0.58, 0.14],
+  [0.36, 0.78, 0.45],
+  [0.33, 0.73, 0.65],
+  [0.24, 0.52, 0.96],
+  [0.55, 0.36, 0.96],
+  [0.92, 0.29, 0.6],
+  [0.39, 0.4, 0.95],
+  [0.47, 0.47, 0.49],
+];
+
+export const OPENMINIS_DARK_INK: OpenMinisRgb = [0.42, 0.42, 0.44];
+
+export const OPENMINIS_SHAPE_NAMES = [
+  "circle",
+  "clover",
+  "tilt-round-square",
+  "four-star",
+  "cloud",
+  "bean",
+  "flower",
+  "teardrop",
+  "capsule",
+  "triangle",
+  "hexagon",
+  "eight-star",
+  "pentagon",
+] as const;
+
+export const OPENMINIS_COLOR_NAMES = [
+  "black",
+  "brown",
+  "red",
+  "orange",
+  "amber",
+  "green",
+  "cyan",
+  "blue",
+  "purple",
+  "pink",
+  "indigo",
+  "gray",
+] as const;
+
+export type OpenMinisRole =
+  | "chief"
+  | "dev"
+  | "novel"
+  | "ppt"
+  | "oracle"
+  | "life"
+  | "quiz"
+  | "memo"
+  | "ops"
+  | "cook"
+  | "lotto"
+  | "mail";
+
+export type OpenMinisMood = "calm" | "focused" | "curious" | "happy" | "frown" | "dozing" | "shy";
+
+export type OpenMinisSpec = {
+  shape: number;
+  color: number;
+  role: OpenMinisRole | "custom";
+  /**
+   * When true, BotAvatar must not add the yellow star (the body already has one).
+   * The OpenMinis chief has no baked star, so this is false: the home-hero overlay
+   * shows exactly one yellow star, matching the official screenshot.
+   */
+  suppressMainStar: boolean;
+};
+
+export type OpenMinisRoleRow = {
+  role: OpenMinisRole;
+  name: string;
+  shape: number;
+  color: number;
+  /** Stable ids of the shipped roster, so this account's bots keep their look if renamed. */
+  botIds: readonly string[];
+};
+
+/**
+ * Twelve roles: OpenMinis template defaults where a counterpart exists (chief, coder, writer,
+ * life, quiz); the rest are distinct leftover shape+colour pairs.
+ */
+export const OPENMINIS_ROLE_ROWS: readonly OpenMinisRoleRow[] = [
+  { role: "chief", name: "小猪包", shape: 0, color: 10, botIds: ["cmwgm49boyweiboib5meju5x7"] },
+  { role: "dev", name: "开发助理", shape: 7, color: 6, botIds: ["cmwgouca0nk6rwbhk1swaxbi4"] },
+  { role: "novel", name: "小说写手", shape: 8, color: 6, botIds: ["cmwgqczzcl435o5ih2kowbtgo"] },
+  { role: "ppt", name: "PPT大师", shape: 10, color: 3, botIds: ["cmwgqgor7lb6mlie0sni0t8qw"] },
+  { role: "oracle", name: "占卜师", shape: 11, color: 8, botIds: ["cmwgrqwqvki33sqnq1ydesq94"] },
+  { role: "life", name: "生活助理", shape: 8, color: 7, botIds: ["cmwh5ty5irjaij7vyiivaobb0"] },
+  { role: "quiz", name: "刷题教练", shape: 0, color: 5, botIds: ["cmwhl6d8i7u3v9znq3dgvo9ge"] },
+  { role: "memo", name: "备忘录", shape: 2, color: 1, botIds: ["cmwizss1ym6kxs4lvztbczi57"] },
+  { role: "ops", name: "运维助理", shape: 12, color: 11, botIds: ["cmwkhxq51fbif1b6u7spzp8fs"] },
+  { role: "cook", name: "做饭教练", shape: 1, color: 2, botIds: ["cmwlu1xlmblhb6cek3rpl5e3d"] },
+  { role: "lotto", name: "中奖大师", shape: 3, color: 9, botIds: ["cmwqkb91i3yxl196nxgp38e4k"] },
+  { role: "mail", name: "邮件大师", shape: 4, color: 4, botIds: ["cmwrnr77lkwsei4mj6zweunbj"] },
+];
+
+const ROLE_BY_KEY = new Map<string, OpenMinisRoleRow>(
+  OPENMINIS_ROLE_ROWS.flatMap((row) => {
+    const keys = [row.role, row.name, ...row.botIds];
+    return keys.map((key) => [key, row] as const);
+  }),
+);
+
+export function openminisClampShape(shape: number): number {
+  if (!Number.isFinite(shape)) return 0;
+  const n = Math.trunc(shape);
+  return ((n % OPENMINIS_SHAPE_COUNT) + OPENMINIS_SHAPE_COUNT) % OPENMINIS_SHAPE_COUNT;
+}
+
+export function openminisClampColor(color: number): number {
+  if (!Number.isFinite(color)) return 0;
+  const n = Math.trunc(color);
+  return ((n % OPENMINIS_COLOR_COUNT) + OPENMINIS_COLOR_COUNT) % OPENMINIS_COLOR_COUNT;
+}
+
+export function openminisRgb(color: number, dark: boolean): OpenMinisRgb {
+  const i = openminisClampColor(color);
+  return dark && i === 0 ? OPENMINIS_DARK_INK : OPENMINIS_PALETTE[i]!;
+}
+
+export function openminisHex(color: number, dark: boolean): string {
+  const [r, g, b] = openminisRgb(color, dark);
+  const ch = (v: number) => Math.round(v * 255).toString(16).padStart(2, "0");
+  return `#${ch(r)}${ch(g)}${ch(b)}`;
+}
+
+/** Near-black body in the light theme: a white body would vanish on the cream home screen. */
+export const OPENMINIS_CHIEF_BODY_LIGHT = "#111111";
+/** White body in the dark theme, matching the owner's home-hero screenshot. */
+export const OPENMINIS_CHIEF_BODY_DARK = "#ffffff";
+export const OPENMINIS_CHIEF_EYE_LIGHT = "#ffffff";
+export const OPENMINIS_CHIEF_EYE_DARK = "#000000";
+
+export function openminisIsChief(spec: { role?: string | null }): boolean {
+  return spec.role === "chief";
+}
+
+/**
+ * Fill for the body. The main bot is the official black/white face, not palette indigo:
+ * near-black in light mode, white in dark mode. Every other bot uses the 12-colour palette.
+ */
+export function openminisBodyHex(spec: { color: number; role?: string | null }, dark: boolean): string {
+  if (openminisIsChief(spec)) return dark ? OPENMINIS_CHIEF_BODY_DARK : OPENMINIS_CHIEF_BODY_LIGHT;
+  return openminisHex(spec.color, dark);
+}
+
+/** Eye (and dozing-z) ink. Only the chief in dark mode uses black eyes, for contrast on white. */
+export function openminisEyeHex(spec: { role?: string | null }, dark: boolean): string {
+  if (openminisIsChief(spec) && dark) return OPENMINIS_CHIEF_EYE_DARK;
+  return "#ffffff";
+}
+
+/**
+ * The main-bot expression measured from the owner's dark-mode home screenshot:
+ * two capsules tilted like a backslash (top leans left), looking up-right, the right
+ * eye a bit thinner and higher. Unit square = the body diameter. Other bots keep the
+ * OpenMinis defaults in {@link openminisFaceTransform} (−14°, offset 0.06, −0.08).
+ */
+export const OPENMINIS_CHIEF_LOOK = {
+  rotate: -33.4,
+  eyes: [
+    { x: 0.5555, y: 0.3363, width: 0.123, height: 0.271 },
+    { x: 0.791, y: 0.2317, width: 0.082, height: 0.274 },
+  ],
+} as const;
+
+/** djb2 as in OpenMinis CloudBotAvatarSpec.default: 32-bit, times 33 plus each UTF-8 byte. */
+export function openminisDjb2(text: string): number {
+  let h = 5381;
+  for (const byte of new TextEncoder().encode(text)) {
+    h = (Math.imul(h, 33) + byte) >>> 0;
+  }
+  return h;
+}
+
+/** OpenMinis default for a bot with no saved avatar: primary is indigo circle; others are hashed. */
+export function openminisHashedSpec(id: string, primary: boolean): { shape: number; color: number } {
+  if (primary) return { shape: 0, color: 10 };
+  const h = openminisDjb2(id);
+  return { shape: h % 13, color: 1 + Math.floor(h / 13) % 11 };
+}
+
+export function openminisSpecFor(input: {
+  identity?: string | null;
+  name?: string | null;
+  chief?: boolean;
+}): OpenMinisSpec {
+  if (input.chief) {
+    const chief = ROLE_BY_KEY.get("chief")!;
+    return { shape: chief.shape, color: chief.color, role: "chief", suppressMainStar: false };
+  }
+  const id = (input.identity ?? "").trim();
+  const name = (input.name ?? "").trim();
+  const row = (id && ROLE_BY_KEY.get(id)) || (name && ROLE_BY_KEY.get(name)) || null;
+  if (row) {
+    return {
+      shape: row.shape,
+      color: row.color,
+      role: row.role,
+      suppressMainStar: false,
+    };
+  }
+  const hashed = openminisHashedSpec(id || name || "bot", false);
+  return { ...hashed, role: "custom", suppressMainStar: false };
+}
+
+export function openminisMoodFor(input: {
+  status?: string | null;
+  activity?: string | null;
+  composing?: boolean;
+  unread?: boolean;
+  failed?: boolean;
+  idleSeconds?: number;
+  shy?: boolean;
+}): OpenMinisMood {
+  if (input.shy) return "shy";
+  const status = input.status ?? "";
+  const activity = input.activity ?? "";
+  if (activity === "error" || status === "failed" || status === "error" || input.failed) return "frown";
+  if (status === "waiting" || activity === "waiting") return "curious";
+  if (
+    input.composing ||
+    activity === "thinking" ||
+    activity === "working" ||
+    activity === "computer" ||
+    activity === "writing" ||
+    activity === "reading" ||
+    activity === "talk" ||
+    activity === "speaking" ||
+    status === "thinking" ||
+    status === "running" ||
+    status === "queued" ||
+    status === "working" ||
+    status === "in_progress"
+  ) {
+    return "focused";
+  }
+  if (activity === "done" || activity === "happy" || input.unread) return "happy";
+  if (activity === "sleep" || (input.idleSeconds ?? 0) >= OPENMINIS_DOZE_AFTER_SECONDS) return "dozing";
+  return "calm";
+}
+
+type Pt = { x: number; y: number };
+
+function fmt(n: number): string {
+  const v = Math.round(n * 1e5) / 1e5;
+  return Object.is(v, -0) ? "0" : String(v);
+}
+
+class PathWriter {
+  private readonly parts: string[] = [];
+  private x = 0;
+  private y = 0;
+  private started = false;
+
+  move(x: number, y: number): this {
+    this.parts.push(`M${fmt(x)} ${fmt(y)}`);
+    this.x = x;
+    this.y = y;
+    this.started = true;
+    return this;
+  }
+
+  line(x: number, y: number): this {
+    this.parts.push(`L${fmt(x)} ${fmt(y)}`);
+    this.x = x;
+    this.y = y;
+    return this;
+  }
+
+  cubic(c1x: number, c1y: number, c2x: number, c2y: number, x: number, y: number): this {
+    this.parts.push(`C${fmt(c1x)} ${fmt(c1y)} ${fmt(c2x)} ${fmt(c2y)} ${fmt(x)} ${fmt(y)}`);
+    this.x = x;
+    this.y = y;
+    return this;
+  }
+
+  quad(cx: number, cy: number, x: number, y: number): this {
+    this.parts.push(`Q${fmt(cx)} ${fmt(cy)} ${fmt(x)} ${fmt(y)}`);
+    this.x = x;
+    this.y = y;
+    return this;
+  }
+
+  /** Circular arc. sweep=1 is clockwise (SVG, y-down). */
+  arc(rx: number, ry: number, rot: number, large: 0 | 1, sweep: 0 | 1, x: number, y: number): this {
+    this.parts.push(
+      `A${fmt(rx)} ${fmt(ry)} ${fmt(rot)} ${large} ${sweep} ${fmt(x)} ${fmt(y)}`,
+    );
+    this.x = x;
+    this.y = y;
+    return this;
+  }
+
+  /**
+   * Canvas/CoreGraphics arcTo: from the current point, approach corner A, then head toward B,
+   * with a circular corner of radius r.
+   */
+  arcTo(ax: number, ay: number, bx: number, by: number, r: number): this {
+    if (!this.started) this.move(ax, ay);
+    const px = this.x;
+    const py = this.y;
+    const v1x = px - ax;
+    const v1y = py - ay;
+    const v2x = bx - ax;
+    const v2y = by - ay;
+    const l1 = Math.hypot(v1x, v1y);
+    const l2 = Math.hypot(v2x, v2y);
+    if (r <= 0 || l1 < 1e-9 || l2 < 1e-9) {
+      this.line(ax, ay);
+      return this;
+    }
+    const u1x = v1x / l1;
+    const u1y = v1y / l1;
+    const u2x = v2x / l2;
+    const u2y = v2y / l2;
+    const dot = Math.max(-1, Math.min(1, u1x * u2x + u1y * u2y));
+    const angle = Math.acos(dot);
+    if (angle < 1e-6 || Math.abs(Math.PI - angle) < 1e-6) {
+      this.line(ax, ay);
+      return this;
+    }
+    const dist = r / Math.tan(angle / 2);
+    const d = Math.min(dist, l1, l2);
+    const usedR = d === dist ? r : d * Math.tan(angle / 2);
+    const t1x = ax + u1x * d;
+    const t1y = ay + u1y * d;
+    const t2x = ax + u2x * d;
+    const t2y = ay + u2y * d;
+    this.line(t1x, t1y);
+    // Perpendicular to incoming (from t1 toward A is -u1); choose the inward normal.
+    const cross = u1x * u2y - u1y * u2x;
+    const sweep: 0 | 1 = cross < 0 ? 1 : 0;
+    this.arc(usedR, usedR, 0, 0, sweep, t2x, t2y);
+    return this;
+  }
+
+  close(): this {
+    this.parts.push("Z");
+    return this;
+  }
+
+  toString(): string {
+    return this.parts.join("");
+  }
+}
+
+function mid(a: Pt, b: Pt): Pt {
+  return { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 };
+}
+
+function roundedPolygon(points: Pt[], radius: number): string {
+  const n = points.length;
+  const path = new PathWriter();
+  const first = mid(points[n - 1]!, points[0]!);
+  path.move(first.x, first.y);
+  for (let i = 0; i < n; i += 1) {
+    const corner = points[i]!;
+    const next = points[(i + 1) % n]!;
+    path.arcTo(corner.x, corner.y, next.x, next.y, radius);
+  }
+  path.close();
+  return path.toString();
+}
+
+function polygon(count: number, rotation: number, radius = 0.48): Pt[] {
+  return Array.from({ length: count }, (_, i) => {
+    const a = rotation + (i * 2 * Math.PI) / count;
+    return { x: 0.5 + radius * Math.cos(a), y: 0.5 + radius * Math.sin(a) };
+  });
+}
+
+function starVertices(points: number, inner: number, rotation: number): Pt[] {
+  const verts: Pt[] = [];
+  for (let i = 0; i < points * 2; i += 1) {
+    const r = i % 2 === 0 ? 0.5 : inner;
+    const a = rotation + (i * Math.PI) / points;
+    verts.push({ x: 0.5 + r * Math.cos(a), y: 0.5 + r * Math.sin(a) });
+  }
+  return verts;
+}
+
+type Disc = { x: number; y: number; r: number };
+
+export const OPENMINIS_CLOVER: readonly Disc[] = [
+  { x: 0.32, y: 0.36, r: 0.24 },
+  { x: 0.68, y: 0.36, r: 0.24 },
+  { x: 0.36, y: 0.66, r: 0.24 },
+  { x: 0.66, y: 0.66, r: 0.24 },
+  { x: 0.5, y: 0.5, r: 0.2 },
+];
+
+export const OPENMINIS_CLOUD: readonly Disc[] = [
+  { x: 0.5, y: 0.3, r: 0.22 },
+  { x: 0.28, y: 0.45, r: 0.22 },
+  { x: 0.72, y: 0.45, r: 0.22 },
+  { x: 0.38, y: 0.7, r: 0.22 },
+  { x: 0.64, y: 0.7, r: 0.22 },
+  { x: 0.5, y: 0.5, r: 0.22 },
+];
+
+export const OPENMINIS_FLOWER: readonly Disc[] = [
+  { x: 0.5, y: 0.5, r: 0.26 },
+  ...Array.from({ length: 6 }, (_, i) => {
+    const a = (i * Math.PI) / 3;
+    return { x: 0.5 + 0.24 * Math.cos(a), y: 0.5 + 0.24 * Math.sin(a), r: 0.17 };
+  }),
+];
+
+function unionExit(discs: readonly Disc[], cx: number, cy: number, dx: number, dy: number): number | null {
+  let best: number | null = null;
+  for (const d of discs) {
+    const ox = cx - d.x;
+    const oy = cy - d.y;
+    const b = dx * ox + dy * oy;
+    const c = ox * ox + oy * oy - d.r * d.r;
+    const disc = b * b - c;
+    if (disc < 0) continue;
+    const t = -b + Math.sqrt(disc);
+    if (t > 0 && t > (best ?? -1)) best = t;
+  }
+  return best;
+}
+
+export function openminisUnion(
+  discs: readonly Disc[],
+  samples = OPENMINIS_OUTLINE_SAMPLES,
+): Pt[] {
+  const pts: Pt[] = [];
+  for (let i = 0; i < samples; i += 1) {
+    const a = (i / samples) * 2 * Math.PI;
+    const dx = Math.cos(a);
+    const dy = Math.sin(a);
+    const t = unionExit(discs, 0.5, 0.5, dx, dy);
+    if (t == null) continue;
+    pts.push({ x: 0.5 + t * dx, y: 0.5 + t * dy });
+  }
+  return pts;
+}
+
+export function openminisContains(discs: readonly Disc[], x: number, y: number, slack = 0): boolean {
+  return discs.some((d) => Math.hypot(x - d.x, y - d.y) <= d.r + slack);
+}
+
+function outline(discs: readonly Disc[], samples = OPENMINIS_OUTLINE_SAMPLES): string {
+  const pts = openminisUnion(discs, samples);
+  if (pts.length === 0) return "";
+  const path = new PathWriter();
+  path.move(pts[0]!.x, pts[0]!.y);
+  for (let i = 1; i < pts.length; i += 1) path.line(pts[i]!.x, pts[i]!.y);
+  path.close();
+  return path.toString();
+}
+
+function rotatePt(p: Pt, angle: number, cx = 0.5, cy = 0.5): Pt {
+  const dx = p.x - cx;
+  const dy = p.y - cy;
+  const c = Math.cos(angle);
+  const s = Math.sin(angle);
+  return { x: cx + dx * c - dy * s, y: cy + dx * s + dy * c };
+}
+
+function roundedRectPath(x: number, y: number, w: number, h: number, r: number): PathWriter {
+  const rr = Math.min(r, w / 2, h / 2);
+  const path = new PathWriter();
+  path.move(x + rr, y);
+  path.line(x + w - rr, y);
+  path.arc(rr, rr, 0, 0, 1, x + w, y + rr);
+  path.line(x + w, y + h - rr);
+  path.arc(rr, rr, 0, 0, 1, x + w - rr, y + h);
+  path.line(x + rr, y + h);
+  path.arc(rr, rr, 0, 0, 1, x, y + h - rr);
+  path.line(x, y + rr);
+  path.arc(rr, rr, 0, 0, 1, x + rr, y);
+  path.close();
+  return path;
+}
+
+function transformPath(d: string, map: (x: number, y: number) => Pt): string {
+  return d.replace(/(-?\d*\.?\d+)(?:e[-+]?\d+)?\s+(-?\d*\.?\d+)(?:e[-+]?\d+)?/gi, (all, xs: string, ys: string, offset: number) => {
+    // Only transform coordinate pairs that follow a command, not the flags of an arc.
+    // Simpler: parse the path properly.
+    void all;
+    void offset;
+    void xs;
+    void ys;
+    return all;
+  });
+}
+
+function parseAndTransform(d: string, map: (x: number, y: number) => Pt): string {
+  const out: string[] = [];
+  const re = /([MLCQAZ])|(-?\d*\.?\d+(?:e[-+]?\d+)?)/gi;
+  let command = "";
+  const nums: number[] = [];
+
+  const flush = () => {
+    if (!command || (command !== "Z" && nums.length === 0 && command !== "z")) {
+      /* skip */
+    }
+    const emit = (ch: string, pts: number[], pairStart = 0) => {
+      const bits = [ch];
+      for (let i = 0; i < pts.length; i += 1) {
+        if (i >= pairStart && (i - pairStart) % 2 === 0 && i + 1 < pts.length) {
+          const p = map(pts[i]!, pts[i + 1]!);
+          bits.push(fmt(p.x), fmt(p.y));
+          i += 1;
+        } else if (i >= pairStart && (i - pairStart) % 2 === 0) {
+          bits.push(fmt(pts[i]!));
+        } else if (i < pairStart) {
+          bits.push(fmt(pts[i]!));
+        }
+      }
+      out.push(bits.join(" "));
+    };
+    switch (command) {
+      case "M":
+      case "L":
+      case "C":
+      case "Q":
+        emit(command, nums, 0);
+        break;
+      case "A": {
+        // A rx ry rot large sweep x y  — only the endpoint is a mapped point; rot stays, rx/ry stay for circles.
+        for (let i = 0; i + 6 < nums.length; i += 7) {
+          const p = map(nums[i + 5]!, nums[i + 6]!);
+          out.push(
+            `A${fmt(nums[i]!)} ${fmt(nums[i + 1]!)} ${fmt(nums[i + 2]!)} ${nums[i + 3]} ${nums[i + 4]} ${fmt(p.x)} ${fmt(p.y)}`,
+          );
+        }
+        break;
+      }
+      case "Z":
+        out.push("Z");
+        break;
+      default:
+        break;
+    }
+    nums.length = 0;
+  };
+
+  let match: RegExpExecArray | null;
+  while ((match = re.exec(d))) {
+    if (match[1]) {
+      if (command) flush();
+      command = match[1].toUpperCase();
+      if (command === "Z") flush();
+    } else if (match[2]) {
+      nums.push(Number(match[2]));
+    }
+  }
+  if (command && command !== "Z") flush();
+  return out.join("");
+}
+
+void transformPath;
+
+function tiltedRoundedSquare(): string {
+  const d = roundedRectPath(0.14, 0.14, 0.72, 0.72, 0.2).toString();
+  const angle = Math.PI / 9;
+  return parseAndTransform(d, (x, y) => rotatePt({ x, y }, angle));
+}
+
+function bean(): string {
+  // Ellipse (0.08, 0.2, 0.84, 0.6) rotated −π/10 about the centre of the unit square.
+  const path = new PathWriter();
+  const cx = 0.5;
+  const cy = 0.5;
+  const rx = 0.42;
+  const ry = 0.3;
+  path.move(cx + rx, cy);
+  path.arc(rx, ry, 0, 0, 1, cx - rx, cy);
+  path.arc(rx, ry, 0, 0, 1, cx + rx, cy);
+  path.close();
+  const angle = -Math.PI / 10;
+  // Axis-aligned ellipse rotated: keep rx/ry, set x-axis-rotation, rotate endpoints.
+  const rotDeg = (angle * 180) / Math.PI;
+  const start = rotatePt({ x: cx + rx, y: cy }, angle);
+  const midPt = rotatePt({ x: cx - rx, y: cy }, angle);
+  const end = start;
+  return `M${fmt(start.x)} ${fmt(start.y)}A${fmt(rx)} ${fmt(ry)} ${fmt(rotDeg)} 0 1 ${fmt(midPt.x)} ${fmt(midPt.y)}A${fmt(rx)} ${fmt(ry)} ${fmt(rotDeg)} 0 1 ${fmt(end.x)} ${fmt(end.y)}Z`;
+}
+
+function teardrop(): string {
+  const path = new PathWriter();
+  path.move(0.5, 0.04);
+  path.cubic(0.62, 0.22, 0.9, 0.38, 0.9, 0.62);
+  // Bulb at the bottom: from the right of the circle to the left, clockwise (y-down).
+  path.arc(0.4, 0.4, 0, 0, 1, 0.1, 0.62);
+  path.cubic(0.1, 0.38, 0.38, 0.22, 0.5, 0.04);
+  path.close();
+  return path.toString();
+}
+
+function capsule(): string {
+  return roundedRectPath(0.04, 0.22, 0.92, 0.56, 0.28).toString();
+}
+
+function circle(): string {
+  const path = new PathWriter();
+  path.move(1, 0.5);
+  path.arc(0.5, 0.5, 0, 1, 1, 0, 0.5);
+  path.arc(0.5, 0.5, 0, 1, 1, 1, 0.5);
+  path.close();
+  return path.toString();
+}
+
+/** Body outline in the unit square (0…1). Some shapes (the teardrop) reach slightly outside. */
+export function openminisBodyPath(shape: number, samples = OPENMINIS_OUTLINE_SAMPLES): string {
+  switch (openminisClampShape(shape)) {
+    case 1:
+      return outline(OPENMINIS_CLOVER, samples);
+    case 2:
+      return tiltedRoundedSquare();
+    case 3:
+      return roundedPolygon(starVertices(4, 0.24, -Math.PI / 2), 0.06);
+    case 4:
+      return outline(OPENMINIS_CLOUD, samples);
+    case 5:
+      return bean();
+    case 6:
+      return outline(OPENMINIS_FLOWER, samples);
+    case 7:
+      return teardrop();
+    case 8:
+      return capsule();
+    case 9:
+      return roundedPolygon(
+        [
+          { x: 0.12, y: 0.12 },
+          { x: 0.95, y: 0.5 },
+          { x: 0.12, y: 0.88 },
+        ],
+        0.14,
+      );
+    case 10:
+      return roundedPolygon(polygon(6, Math.PI / 6), 0.12);
+    case 11:
+      return roundedPolygon(starVertices(8, 0.34, 0), 0.06);
+    case 12:
+      return roundedPolygon(polygon(5, -Math.PI / 2), 0.12);
+    default:
+      return circle();
+  }
+}
+
+export type OpenMinisEye = {
+  kind: "capsule" | "happy" | "frown" | "line";
+  width: number;
+  height: number;
+  stroke?: number;
+};
+
+export function openminisEyeMetrics(mood: OpenMinisMood, eyeOpen: number, size: number): OpenMinisEye {
+  const open = Math.max(eyeOpen, 0.12);
+  switch (mood) {
+    case "happy":
+      if (eyeOpen > 0.5) return { kind: "happy", width: 0.14, height: 0.09, stroke: 0.07 };
+      break;
+    case "focused":
+      return { kind: "capsule", width: 0.11, height: 0.12 * open };
+    case "curious":
+      return { kind: "capsule", width: 0.12, height: 0.27 * open };
+    case "frown":
+      return { kind: "frown", width: 0.14, height: 0.07, stroke: 0.07 };
+    case "shy":
+      return { kind: "frown", width: 0.13, height: 0.06, stroke: 0.06 };
+    case "dozing":
+      return { kind: "line", width: 0.13, height: Math.max(1.5 / Math.max(size, 1), 0.035) };
+    default:
+      break;
+  }
+  return { kind: "capsule", width: 0.1, height: 0.22 * open };
+}
+
+export function openminisFaceTransform(mood: OpenMinisMood, gaze: { x: number; y: number } = { x: 0, y: 0 }): {
+  x: number;
+  y: number;
+  rotate: number;
+  spacing: number;
+} {
+  return {
+    x: 0.06 + 0.08 * gaze.x,
+    y: -0.08 + 0.07 * gaze.y,
+    rotate: mood === "curious" ? -4 : -14,
+    spacing: 0.13,
+  };
+}
+
+function happyEyePath(width: number, height: number, flip: boolean): string {
+  const minX = -width / 2;
+  const maxX = width / 2;
+  const minY = -height / 2;
+  const maxY = height / 2;
+  const path = new PathWriter();
+  if (!flip) {
+    path.move(minX, maxY);
+    path.quad(0, minY - height * 0.6, maxX, maxY);
+  } else {
+    path.move(minX, minY);
+    path.quad(0, maxY + height * 0.6, maxX, minY);
+  }
+  return path.toString();
+}
+
+export type OpenMinisDrawOptions = {
+  size: number;
+  dark: boolean;
+  eyeOpen?: number;
+  mood?: OpenMinisMood;
+  gaze?: { x: number; y: number };
+  showsFace?: boolean;
+};
+
+/** A complete SVG (unit viewBox) for one avatar: the review sheet and SvgXml both use this. */
+export function openminisSvg(
+  spec: { shape: number; color: number; role?: OpenMinisRole | "custom" | null },
+  options: OpenMinisDrawOptions,
+): string {
+  const size = options.size;
+  const dark = options.dark;
+  const eyeOpen = options.eyeOpen ?? 1;
+  const mood = options.mood ?? "calm";
+  const gaze = options.gaze ?? { x: 0, y: 0 };
+  const showsFace = options.showsFace !== false;
+  const fill = openminisBodyHex(spec, dark);
+  const ink = openminisEyeHex(spec, dark);
+  const body = openminisBodyPath(spec.shape);
+  const chief = openminisIsChief(spec);
+  // A white body already reads on black; skip the pale glow that would halo it.
+  const glow = dark && !chief
+    ? `<g filter="url(#omGlow)" opacity="0.28"><path d="${body}" fill="#ffffff"/></g>`
+    : "";
+  const blur = Math.max(0.5, size * 0.02) / size;
+  const defs = dark && !chief
+    ? `<defs><filter id="omGlow" x="-0.2" y="-0.2" width="1.4" height="1.4"><feGaussianBlur stdDeviation="${fmt(blur)}"/></filter></defs>`
+    : "";
+  let face = "";
+  if (showsFace) {
+    const eye = openminisEyeMetrics(mood, eyeOpen, size);
+    const glyph = (cx: number, cy: number, width: number, height: number, rotate: number) => {
+      if (eye.kind === "happy" || eye.kind === "frown") {
+        const d = happyEyePath(width, height, eye.kind === "frown");
+        const sw = eye.stroke ?? 0.07;
+        return `<path d="${d}" transform="translate(${fmt(cx)} ${fmt(cy)}) rotate(${fmt(rotate)})" fill="none" stroke="${ink}" stroke-width="${fmt(sw)}" stroke-linecap="round"/>`;
+      }
+      const x = -width / 2;
+      const y = -height / 2;
+      const rr = Math.min(width, height) / 2;
+      return `<rect x="${fmt(x)}" y="${fmt(y)}" width="${fmt(width)}" height="${fmt(height)}" rx="${fmt(rr)}" fill="${ink}" transform="translate(${fmt(cx)} ${fmt(cy)}) rotate(${fmt(rotate)})"/>`;
+    };
+    if (chief) {
+      const open = Math.max(eyeOpen, 0.12);
+      face = OPENMINIS_CHIEF_LOOK.eyes
+        .map((slot) => {
+          const width = eye.kind === "capsule" ? slot.width : eye.width;
+          const height = eye.kind === "capsule" ? slot.height * open : eye.height;
+          return glyph(slot.x, slot.y, width, height, OPENMINIS_CHIEF_LOOK.rotate);
+        })
+        .join("");
+    } else {
+      const tr = openminisFaceTransform(mood, gaze);
+      const gap = tr.spacing + eye.width;
+      const left = -gap / 2;
+      const right = gap / 2;
+      face = `<g transform="translate(${fmt(0.5 + tr.x)} ${fmt(0.5 + tr.y)}) rotate(${fmt(tr.rotate)})">${glyph(left, 0, eye.width, eye.height, 0)}${glyph(right, 0, eye.width, eye.height, 0)}</g>`;
+    }
+    if (mood === "shy") {
+      face += `<g transform="translate(${fmt(0.5 + 0.06)} ${fmt(0.5 + 0.08)})" opacity="0.75">
+        <ellipse cx="${fmt(-0.15)}" cy="0" rx="${fmt(0.55 / 4)}" ry="${fmt(0.04)}" fill="#ff69b4" filter="url(#omBlush)"/>
+        <ellipse cx="${fmt(0.15)}" cy="0" rx="${fmt(0.55 / 4)}" ry="${fmt(0.04)}" fill="#ff69b4" filter="url(#omBlush)"/>
+      </g>`;
+    }
+    if (mood === "dozing") {
+      face += `<text x="${fmt(0.5 + 0.3)}" y="${fmt(0.5 - 0.3)}" fill="${ink}" fill-opacity="0.9" font-size="0.22" font-weight="700" font-family="system-ui, sans-serif" text-anchor="middle" dominant-baseline="central">z</text>`;
+    }
+  }
+  const blushDef =
+    showsFace && mood === "shy"
+      ? `<filter id="omBlush"><feGaussianBlur stdDeviation="0.015"/></filter>`
+      : "";
+  return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="-0.08 -0.08 1.16 1.16" width="${size}" height="${size}" overflow="visible">${defs}${blushDef ? `<defs>${blushDef}</defs>` : ""}${glow}<path d="${body}" fill="${fill}"/>${face}</svg>`;
+}
+
+/** Wait between blinks, in seconds: shorter while the bot is working. */
+export function openminisBlinkWait(working: boolean): { min: number; max: number } {
+  return working ? { min: 0.45, max: 1.1 } : { min: 1.2, max: 3.2 };
+}
